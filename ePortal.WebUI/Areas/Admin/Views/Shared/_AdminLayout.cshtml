
@using Microsoft.AspNetCore.Http

@{
    var userName = Context.Session.GetString("userName");
    var idleTimeoutMinutes = Context.Session.GetString("IdleTimeoutMinutes");
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title</title>

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css">

    <link rel="stylesheet" href="~/css/index.css" />
    <link rel="stylesheet" href="~/css/ModalDialogs.css" />
    <link rel="stylesheet" href="~/css/GridView.css" />
    <link rel="stylesheet" href="~/css/IGridView.css" />
    <link rel="stylesheet" href="~/css/AnimatedCollapsiblePanel.css" />

    <link rel="stylesheet" href="~/css/jqueryslidemenu.css" />
    <link rel="stylesheet" href="~/css/jqueryslidemenuSetting.css" />

    <link rel="stylesheet" href="~/css/jquery-ui.css" />

    <link rel="stylesheet" href="~/css/font-awesome.css" />
    <link rel="stylesheet" href="~/fancybox/jquery.fancybox.css" />

    <link rel="stylesheet" href="~/css/loading_spinner.css" />
    <link href="~/css/sweetalert.css" rel="stylesheet" />

    <style nonce="@Context.Items["StyleNonce_0"]">
        .table-fixed {
            background-color: #fbfbfb;
            width: 100%;
        }

            .table-fixed tbody {
                height: 200px;
                overflow-y: auto;
                width: 100%;
            }

            .table-fixed thead, .table-fixed tbody, .table-fixed tr, .table-fixed td, .table-fixed th {
                display: block;
            }

                .table-fixed tbody td {
                    float: left;
                }

                .table-fixed thead tr th {
                    background-color: #159bd0;
                    border-color: #0881b1;
                    float: left;
                    color: #fff;
                    text-align: center;
                }

        .read_article {
            text-align: center;
        }

        .textcenter {
            text-align: center !important;
        }

        .textright {
            text-align: right;
        }

        .padding5 {
            padding: 5px !important;
        }

        a {
            cursor: pointer !important;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <center>
        <table cellpadding="0" cellspacing="0" class="tborder" border="0" style="width:99%; background-color:#FFFFFF;">
            <tr>
                <td align="center">
                    <div id="master_header">
                        <table cellspacing="0" cellpadding="0" width="100%" border="0" style="background-color: White">
                            <tbody>
                                <tr style="height: 52px;">
                                    <td valign="center" align="left" width="30%" rowspan="2" style="padding-left: 8px;">
                                        <a href="#">
                                            <img src="~/images/hondalogo5.gif" border="0" style="width: 160px !important;height: 45px !important;">
                                        </a>
                                    </td>
                                    <td valign="top" align="right">
                                        <span class="smalltext"></span>&nbsp;
                                    </td>
                                </tr>
                                <tr>
                                    <td valign="bottom" align="right" style="padding-bottom: 2px;">
                                        <span class="smalltext" style="padding-right: 8px;">
                                            <font color="#333333">Welcome, @userName</font>
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        <table style="width: 100%" cellspacing="0">
                                            <tr>
                                                <td style="width: 95%;background-color:#757575">
                                                    <div id="myslidemenu" class="jqueryslidemenu" style="z-index:99999;">
                                                        @Html.Raw(ViewBag.MenuHtml)
                                                    </div>
                                                </td>
                                                <td style="width: 5%;">
                                                    <div id="myslidemenu1" class="jqueryslidemenuSetting">
                                                        <ul>
                                                            <li>
                                                                <a href="~/ASPXView/Admin/Home.aspx">
                                                                    <img src="~/images/Setting-icon.png" alt="Account" style="text-align: center" />
                                                                </a>
                                                                <ul style="top: 22px; display: none; visibility: visible;">
                                                                    <li><a href="~/Admin/Home/ChangePassword">Change Password</a></li>
                                                                    <li><a id="logout">Logout</a></li>
                                                                </ul>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div id="master_page" style="width: 98%;">
                        <div id="master_content" style="width: 99%;">
                            @RenderBody()
                        </div>
                    </div>
                </td>
            </tr>
        </table>

        <div id="master_footer">
            <table width="99%" cellpadding="0" cellspacing="0">
                <tr>
                    <td>
                        <table cellspacing="0" cellpadding="0" width="100%" border="0">
                            <tbody>
                                <tr>
                                    <td>
                                        <img height="3" src="~/images/space.gif" width="1">
                                    </td>
                                </tr>
                                <tr>
                                    <td bgcolor="#707070" style="height: 4px">
                                        <table cellspacing="0" cellpadding="2" height="25" width="100%" border="0">
                                            <tbody>
                                                <tr>
                                                    <td align="center" valign="center">
                                                        <span class="smalltext">
                                                            <font color="#efefef">
                                                                &nbsp;<a id="footerlink" href="~/ASPXView/Admin/Home.aspx">Home</a>|
                                                                <a id="footerlink" href="~/ASPXView/Help.aspx">Help</a>
                                                            </font>
                                                        </span>
                                                    </td>
                                                    <td align="right" width="1"></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td bgcolor="#4e4e4e" height="2">
                                        <img height="3" src="~/images/space.gif" width="1">
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="center" height="25">
                        <span class="newsdate">
                            <a href="#" target="_blank">
                                Copyright
                                © 2024 Honda Motorcycle & Scooter India Pvt. Ltd.
                            </a>
                        </span>
                    </td>
                </tr>
            </table>
        </div>
    </center>

    <div id="loader_new" class="loading hidden overlayer">
        <div class="loading-text">
            <span class="loading-text-words">L</span>
            <span class="loading-text-words">O</span>
            <span class="loading-text-words">A</span>
            <span class="loading-text-words">D</span>
            <span class="loading-text-words">I</span>
            <span class="loading-text-words">N</span>
            <span class="loading-text-words">G</span>
        </div>
    </div>

    <script src="~/js/jquery.3.6.3.min.js"></script>
    <script src="~/js/jquery.dataTables.js"></script>
    <script src="~/js/jquery-ui.min.js"></script>

    <script src="~/fancybox/jquery.fancybox.js"></script>
    <script src="~/js/sweetalert.js"></script>

    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">

         $(document).ready(function () {
            $('#logout').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $.ajax({
                    type: "GET",
                    url: "/Home/logout",
                    success: function (data) {

                        //Changed By TTL against CR6695 as on 29 - 07 - 2025
                        if(data!=null)
                        {
                           window.location='/TokenBridge/OldLogin';
                        }
                        else
                        {
                        window.location = '/Login';
                        }
                    },
                    error: function (xhr, status, error) {
                        bootbox.alert("Error! Please try again.");
                    }
                })
            });
            });

        var arrowimages = {
            down: ['downarrowclass', '@Url.Content("~/images/AdminMenu/down.gif")', 23],
            right: ['rightarrowclass', '@Url.Content("~/images/AdminMenu/right.gif")']
        };

        var sessionTimeoutWarning = "5";
        var sessionTimeout = @idleTimeoutMinutes;
        var timeOnPageLoad = new Date();
        var sessionWarningTimer = null;
        var redirectToWelcomePageTimer = null;

        //For warning
        var sessionWarningTimer = setTimeout('SessionWarning()', (parseInt(sessionTimeout) - parseInt(sessionTimeoutWarning))* 60 * 1000);

        //Session Warning
        function SessionWarning() {
            //minutes left for expiry
            var cTime = new Date();
            var minutesForExpiry =  (parseInt(sessionTimeout) - parseInt(sessionTimeoutWarning));
            var message = "Your session will expire in another " + sessionTimeoutWarning + " min(s) from now ie. "+ cTime.toLocaleString() +" . Do you want to extend the session?";
            answer = confirm(message);
            if(answer)
            {
                var currentTime = new Date();
                var timeForExpiry = timeOnPageLoad.setMinutes(timeOnPageLoad.getMinutes() + parseInt(sessionTimeout));
                if(Date.parse(currentTime) > timeForExpiry)
                {
                    //swal({
                    //    title: "",
                    //    text: "Session expired",
                    //    type: "warning",
                    //});

                    sweetAlert("", "Session expired", "warning");
                }
                else
                {
                    var img = new Image(1, 1);
                    img.src = '@Url.Content("~/aspxview/KeepSessionAlive.aspx")' + '?date='+ escape(new Date());
                    timeOnPageLoad =  new Date();
                    sessionWarningTimer = setTimeout('SessionWarning()', (parseInt(sessionTimeout) - parseInt(sessionTimeoutWarning))* 60 * 1000);
                }
            }
            else
            {
                //if the session time is over. Then exit the session.
                var currentTime = new Date();
                var timeForExpiry = timeOnPageLoad.setMinutes(timeOnPageLoad.getMinutes() + parseInt(sessionTimeout));
                if(Date.parse(currentTime) > timeForExpiry)
                {
                    swal({
                        title: "",
                        text: "Session expired",
                        type: "warning",
                    });
                }
            }
        }

        $(function () {
            $.ajaxPrefilter(function (options, originalOptions, jqXHR) {
                let error = options.error;
                options.error = function (jqXHR, textStatus, errorThrown) {
                    // global error handling first
                    if(jqXHR.status == 401){
                        swal({ title: "", text: "Sorry, Your session has expired. Please login again", type: "warning", },
                        function (isConfirm) {
                            if (isConfirm) { window.location = '/Login'; }
                        });
                    }
                    else{
                        // override local error handling if exists
                        if ($.isFunction(error)) {
                            return $.proxy(error, this)(jqXHR, textStatus, errorThrown);
                        }
                    }
                };
            });
        });
    </script>

    <script src="~/Includes/Js/AdminMenu/jqueryslidemenu.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
