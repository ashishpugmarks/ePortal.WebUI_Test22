@model ePortal.ViewModels.HomeViewModel
@{    
    ViewBag.Title = "Employee Portal - Home :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@* <link rel="stylesheet" href="~/ASPXview/Styles/jquery.alerts.css" /> *@

@* <h4>Home</h4>

@if (Model.ShowError)
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
} *@

<link rel="stylesheet" type="text/css" href="~/ASPXview/Styles/jquery.alerts.css" />

<div class="container">
    <table width="100%" cellspacing="0" cellpadding="0">
        <tr align="left" valign="middle">
            <td width="10" valign="bottom"><img src="~/images/box_top_l.gif" width="10" height="26" /></td>
            <td width="99%" valign="middle" style="background-image: url('@Url.Content("~/images/box_top_m.gif")');" class="bluetablink">
                <span>&nbsp;Home</span>
            </td>
            <td valign="bottom" style="width: 12px"><img src="~/images/box_top_r.gif" width="10" height="26" /></td>
        </tr>

        <tr align="center" valign="middle">
            <td colspan="3" style="border-right: 1px solid #C0C0C0; border-left: 1px solid #C0C0C0;">
                <table cellspacing="0" cellpadding="0" width="80%" border="0" style="margin-left: 5px; margin-top: 12px;">
                    @if (Model.ShowError)
                    {
                        <tr>
                            <td>
                                <div style="width:100%;">
                                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td align="left" valign="top">
                                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="tborder">
                                                    <tr class="errorbox">
                                                        <td>
                                                            <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                                <tr>
                                                                    <td width="16" align="left" valign="middle">
                                                                        <img src="~/images/icon_error.gif" border="0" alt="" />
                                                                    </td>
                                                                    <td align="left" class="errorbox">
                                                                        <span class="smalltext">&nbsp;@Model.ErrorMessage</span>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                </table>
                                                <img src="~/images/space.gif" width="5" height="1" alt="" />
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    }
                </table>
            </td>
        </tr>

        <tr align="left" valign="bottom">
            <td height="20"><img src="~/images/box_bottom_l.gif" width="10" height="20" /></td>
            <td style="background-image: url('@Url.Content("~/images/box_bottom_m.gif")');"></td>
            <td style="width: 12px"><img src="~/images/box_bottom_r.gif" width="10" height="20" /></td>
        </tr>
    </table>
</div>

