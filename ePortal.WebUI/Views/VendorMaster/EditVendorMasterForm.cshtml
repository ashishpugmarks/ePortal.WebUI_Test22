        <span style="padding-left: 10px;">Vendor Registration : Edit Request</span>
    </div>
    <div id="vendorheading" class="vendorheading" style="display: none;">Vendor Registration</div>
    @*----------------------------------------------Heading End-----------------------------------------------*@

