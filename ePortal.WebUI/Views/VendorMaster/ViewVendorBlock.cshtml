@model ePortal.ViewModels.APPX.VendorMaster.VendorBlockRequestViewModel

@{
    Layout = null;
}
<html>
<head>
    <title>Employee Portal - Vendor Master :: Honda Motorcycle & Scooter India Pvt. Ltd.</title>
    @*<link href="~/Styles/index.css" rel="stylesheet" type="text/css" />
    <link href="~/Styles/VendorMaster.css" rel="stylesheet" type="text/css" />*@
    <link href="~/css/jquery-ui.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/VendorMaster.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/css/vendormaster/vendormasterform.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/bundle/jquery.min.js" asp-append-version=true></script>
    <script src="~/app/js/vendormaster/viewvendormaster.js" asp-append-version="true"></script>
</head>
<body>
    <form id="frmviewvendormaster">
        <div class="maincontainer">
            <div style="border: 0px solid #6393DF; margin-bottom: 20px; clear: both;">
                <div class="Viewpg_heading">&nbsp;Vendor Block Details</div>

                <!-- Hidden field for requestor email -->
                <input type="hidden" id="HDREQEMAILID" name="HDREQEMAILID" value="@Model?.RequestorEmail" />

                <table class="tableView tablepadding" width="98%" cellpadding="0" cellspacing="0">
                    <tr><td class="HeaderStyle12" colspan="4">&nbsp;Requestor Information</td></tr>
                    <tr class="row1">
                        <td width="20%" class="collvlstyle">Employee :-</td>
                        <td width="30%"><span id="lblemployee" class="lblcss">@Model?.RequestorName</span></td>
                        <td width="20%" class="collvlstyle">Request Date:-</td>
                        <td width="30%"><span id="lblrequestdate" class="lblcss">@Model?.RequestDate</span></td>
                    </tr>
                    <tr class="row2">
                        <td width="20%" class="collvlstyle">Mobile Number :-</td>
                        <td width="30%"><span id="lblmobileno" class="lblcss">@Model?.MobileNo</span></td>
                        <td width="20%" class="collvlstyle">Site:-</td>
                        <td width="30%"><span id="lblsite" class="lblcss">@Model?.Site</span></td>
                    </tr>
                    <tr class="row1">
                        <td width="20%" class="collvlstyle">Operation :-</td>
                        <td width="30%"><span id="lbloperation" class="lblcss">@Model?.Operation</span></td>
                        <td width="20%" class="collvlstyle">Division:-</td>
                        <td width="30%"><span id="lbldivision" class="lblcss">@Model?.Division</span></td>
                    </tr>
                    <tr class="row2">
                        <td width="20%" class="collvlstyle">Department :-</td>
                        <td width="30%"><span id="lbldepartment" class="lblcss">@Model?.Department</span></td>
                        <td width="20%" class="collvlstyle">Section:-</td>
                        <td width="30%"><span id="lblsection" class="lblcss">@Model?.Section</span></td>
                    </tr>
                </table>

                <div class="separation">&nbsp;</div>

                <table class="tableView tablepadding tabmarg" width="98%" cellpadding="0" cellspacing="0" id="Table2">
                    <tr>
                        <td class="HeaderStyle12" colspan="4">
                            <span style="float:left;">&nbsp;Request Details</span>
                        </td>
                    </tr>

                    <tr class="row1">
                        <td width="20%" class="collvlstyle">Request Type  :-</td>
                        <td style="width:30%;" colspan="3">&nbsp;<span id="lblrequesttype" class="lblcss">@Model?.RequestTypeDesc</span></td>
                    </tr>

                    <tr class="row2">
                        <td width="20%" class="collvlstyle">Purchasing Data  :-</td>
                        <td style="width:35%;">&nbsp;<span id="lblpurchasing" class="lblcss">@Model?.PurchasingStatus</span></td>
                        <td width="20%" class="collvlstyle">Posting Data  :-</td>
                        <td style="width:35%;">&nbsp;<span id="lblposting" class="lblcss">@Model?.PostingStatus</span></td>
                    </tr>
                </table>

                <table class="tableView tablepadding tabmarg" width="98%" cellpadding="0" cellspacing="0" id="Table1">
                    <tr>
                        <td class="HeaderStyle12" colspan="2">
                            <span style="float:left;">&nbsp;Vendor Details</span>
                        </td>
                    </tr>
                    <tr class="vendortablebg">
                        <td colspan="2">
                            <div class="tableView tablepadding">

                                <div class="tableView tablepadding" id="divvname">
                                    <table class="vendortable" cellpadding="0" cellspacing="0" width="99%" style="border:1px solid black;">
                                        <tr class="header_1">
                                            <td align="left" class="header_3" width="15%">VENDORCODE</td>
                                            <td align="left" class="header_3" width="35%">VENDOR NAME</td>
                                            <td align="left" class="header_3" width="25%">CITY</td>
                                            <td align="left" class="header_3" width="25%">REGION</td>
                                        </tr>

                                        @if (Model?.Vendors != null && Model.Vendors.Any())
                                        {
                                            foreach (var v in Model.Vendors)
                                            {
                                                <tr class="row2 prochist">
                                                    <td align="left">@v.VendorCode</td>
                                                    <td align="left">@v.VendorName</td>
                                                    <td align="left">@v.City</td>
                                                    <td align="left">@v.Region</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr class="row2 prochist">
                                                <td colspan="4" style="text-align:center;">No Vendor Details Found</td>
                                            </tr>
                                        }

                                    </table>
                                </div>

                            </div>
                        </td>
                    </tr>
                </table>

                <table class="tableView tablepadding" width="98%" cellpadding="0" cellspacing="0">
                    <tr><td class="HeaderStyle12" colspan="4">&nbsp;Request Remarks</td></tr>
                    <tr class="row2">
                        <td style="width:25%;" class="collvlstyle">Remarks :-</td>
                        <td style="width:75%;" colspan="3"><span id="lblremark" class="lblcss">@Model?.Remarks</span></td>
                    </tr>

                    <tr><td class="HeaderStyle12" colspan="4">&nbsp;Process History</td></tr>
                    <tr class="row2">
                        <td colspan="4">
                            @if (Model?.ProcessHistory != null && Model.ProcessHistory.Any())
                            {
                                <div id="processhisttbl">
                                    <table class="vendortable" cellpadding="0" cellspacing="0" width="99.3%">
                                        <tr class="header_1">
                                            <td width="12%" class="header_3">Date</td>
                                            <td width="24%" class="header_3">Employee</td>
                                            <td width="21%" class="header_3">Status</td>
                                            <td width="40%" class="header_3">Remarks</td>
                                        </tr>

                                        @foreach (var p in Model.ProcessHistory)
                                        {
                                            <tr class="prochist">
                                                <td>@p.AppDate</td>
                                                <td>@p.Employee</td>
                                                <td>@p.StatusDescription</td>
                                                <td align="left" style="word-break:break-all;">@p.Remarks</td>
                                            </tr>
                                        }
                                    </table>
                                </div>

                                <div class="nodata" id="nodata" style="display:none;">No Process History Found</div>
                            }
                            else
                            {
                                <div class="nodata" id="nodata">No Process History Found</div>
                                <div id="processhisttbl" style="display:none;"></div>
                            }
                        </td>
                    </tr>
                </table>

            </div>
        </div>
    </form>
</body>
</html>




