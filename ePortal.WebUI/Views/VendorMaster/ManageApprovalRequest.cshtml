@{
    ViewBag.Title = "Manage Approval Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/VendorMaster.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/css/vendormaster/vendormasterform.css" rel="stylesheet" asp-append-version="true" />
}

<form class="row">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Vendor Registration : Manage Approval</span>
    </div>
    <div class="headmain" style="margin:10px;">
        <!-- Search Criteria -->
        <table class="table table-bordered table-condensed" width="100%">
            <tr>
                <td class="HeaderStyle12" colspan="4">Search Criteria</td>
            </tr>
            <tr class="row1">
                <td class="collvlstyle">Request Type:-</td>
                <td>
                    <select id="ddlrequesttype" class="form-control" style="width:150px;">
                        <option value="">-Select-</option>
                        <option value="1">Create Vendor</option>
                        <option value="2">Update Vendor</option>
                    </select>
                </td>
                <td class="collvlstyle">Vendor Account Group:-</td>
                <td>
                    <select id="ddlvendoraccgrp" class="form-control" style="width:150px;">
                        <option value="">-Select-</option>
                        <option value="5AG1">General Purchase</option>
                        <option value="5AG3">Group Companies</option>
                        <option value="5AG2">GP Import</option>
                        <option value="5AGB">BOP Vendor</option>
                        <option value="5AGA">Contractual Employee</option>
                    </select>
                </td>
            </tr>
            <tr class="row1">
                <td class="collvlstyle">Vendor Name:-</td>
                <td><input type="text" id="txtvendorname" class="form-control" /></td>
                <td class="collvlstyle">Status:-</td>
                <td>
                    <select id="ddlstatus" class="form-control" style="width:150px;">
                        <option value="0">Pending</option>
                        <option value="3">Rejected</option>
                        <option value="4">Send Back</option>
                        <option value="5">Approved</option>
                    </select>
                </td>
            </tr>
            <tr class="active">
                <td colspan="4" align="center">
                    <button type="button" id="btnSearch" class="btn btn-sm btn-primary">Search</button>
                    <button type="button" id="btnCancel" class="btn btn-sm btn-default">Cancel</button>
                </td>
            </tr>
        </table>
        <!-- Results Table -->
        <table id="employeeRequestList" class="table table-striped table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th class="text-center" style="width:3%"></th>
                    <th style="width:20%">Employee</th>
                    <th style="width:12%">Request Type</th>
                    <th style="width:12%">Request Date</th>
                    <th style="width:13%">Account Group</th>
                    <th style="width:22%">Vendor Name</th>
                    <th style="width:15%">Status</th>
                    <th style="width:3%"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div style="margin-left: 0.8em; margin-right: 0.8em;" class="well well-sm">
        <table border="0" style="width: 100%;">
            <tr>
                <td style="height: 20px;">
                    <table style="width: 100%;">
                        <tbody>
                            <tr>
                                <td style="width: 20px; vertical-align: middle; text-align: center;">
                                    <a id="btnbackimg" title="Back">
                                        <img src="~/images/icon_back.gif" border="0" alt="" />
                                    </a>
                                </td>
                                <td style="vertical-align: middle; font-size: 15px;">
                                    <span><a id="btnbackspan" title="Back">Back</a></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</form>

@section Scripts{
    <script src="~/app/js/vendormaster/manageapprovalrequest.js" asp-append-version="true"></script>
}