                            }

                            <table class="tableView tablepadding" style="width:100%;" cellpadding="0" cellspacing="0">
                                <tr><td class="HeaderStyle12" colspan="4">&nbsp;New Information</td></tr>
                                <tr class="row1">
                                    <td style="width:20%" class="collvlstyle">PAN No. :-</td>
                                    <td style="width:30%"><span class="lblcss">@m2?.PanNo</span></td>
                                    <td style="width:20%" class="collvlstyle">Pan No. :-</td>
                                    <td style="width:30%">
                                        @if (!string.IsNullOrEmpty(m2?.PanCardUrl))
                                        {
                                            <a id="anchpancard" href="@m2?.PanCardUrl" class="attachmentstyle docpreview">Preview</a>
                                        }
                                        else
                                        {
                                            <span class="attachmentstyle docpreview">NA</span>
                                        }
                                    </td>
                                </tr>

                                <tr><td class="HeaderStyle12" colspan="4">&nbsp;GST Details</td></tr>
                                <tr class="row1">
                                    <td class="collvlstyle">GSTIN No. :-</td>
                                    <td><span class="newlblcss">@m2?.Gstin</span></td>
                                    <td class="collvlstyle">GST Classification :-</td>
                                    <td><span class="newlblcss">@m2?.GstClassification</span></td>
                                </tr>

                                <tr class="row2">
                                    <td class="collvlstyle">GSTIN Certificate :-</td>
                                    <td colspan="3">
                                        @if (!string.IsNullOrEmpty(m2?.GstRegistrationUrl))
                                        {
                                            <a id="anchgstregn" href="@m2?.GstRegistrationUrl" class="attachmentstyle docpreview">Preview</a>
                                        }
                                        else
                                        {
                                            <span class="attachmentstyle docpreview">NA</span>
                                        }
                                    </td>
                                </tr>

                                <tr class="row1">
                                    <td class="collvlstyle">E-Invoice Applicable :-</td>
                                    <td><span class="newlblcss">@m2?.IsEinvoiceApplicable</span></td>
                                    <td class="collvlstyle">E-Invoice :-</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(m2?.EinvoiceUrl))
                                        {
                                            <a id="anchEinvoice" href="@m2?.EinvoiceUrl" class="attachmentstyle docpreview">Preview</a>
                                        }
                                        else
                                        {
                                            <span class="attachmentstyle docpreview">NA</span>
                                        }
                                    </td>
                                </tr>

                                <tr class="newrow1">
                                    <td class="collvlstyle">LEI Applicable :-</td>
                                    <td><span class="newlblcss">@m2?.LeiApplicable</span></td>
                                    <td class="collvlstyle">LEI No :-</td>
                                    <td><span class="newlblcss">@m2?.LeiNo</span></td>
                                </tr>

                                <tr>
                                    <td class="collvlstyle">LEI Certificate :-</td>
                                    <td colspan="3">
                                        @if (!string.IsNullOrEmpty(m2?.LeiAttachmentUrl))
                                        {
                                            <a id="anchLEIC" href="@m2?.LeiAttachmentUrl" class="attachmentstyle docpreview">Preview</a>
                                        }
                                        else
                                        {
                                            <span class="attachmentstyle docpreview">NA</span>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <!-- HOLDING TAX DATA -->
                        <div id="HOLDINGDIV" style="display:none;">
                            <table class="tableView tablepadding" style="width:100%;" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td class="HeaderStyle12" colspan="4">&nbsp;With Holding Tax detail</td>
                                </tr>

                                <tr>
                                    <td class="bg-info" colspan="4" style="font-weight: bold;">
                                        @if (m4 != null && m4.Any())
                                        {
                                            <table class="tableGridView" style="width:100%;" cellpadding="0" cellspacing="1">
                                                <thead class="grdHeader">
                                                    <tr>
                                                        <th>Slr. No.</th>
                                                        <th>With holding tax type</th>
                                                        <th>With holding tax code</th>
                                                        <th>Liable</th>
                                                        <th>Recipient Type</th>
                                                        <th>Withholding tax id no</th>
                                                        <th>Exemption Certi no</th>
                                                        <th>Exemption rate</th>
                                                        <th>Date on which exemption begins</th>
                                                        <th>Date on which exemption ends</th>
                                                        <th>Reason for exemption</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="grdrow">
                                                    @for (int i = 0; i < m4.Count; i++)
                                                    {
                                                        var row = m4[i];
                                                        <tr>
                                                            <td>@(i + 1)</td>
                                                            <td>@(row.ContainsKey("WITHHOLDING_TAX_TYPE") ? row["WITHHOLDING_TAX_TYPE"] : "")</td>
                                                            <td>@(row.ContainsKey("WITHHOLDING_TAX_CODE") ? row["WITHHOLDING_TAX_CODE"] : "")</td>
                                                            <td>@(row.ContainsKey("LIABLE") ? row["LIABLE"] : "")</td>
                                                            <td>@(row.ContainsKey("RECIPIENT_TYPE") ? row["RECIPIENT_TYPE"] : "")</td>
                                                            <td>@(row.ContainsKey("WITHHOLDING_TAX_ID_NO") ? row["WITHHOLDING_TAX_ID_NO"] : "")</td>
                                                            <td>@(row.ContainsKey("EXEMPTION_CERTI_NO") ? row["EXEMPTION_CERTI_NO"] : "")</td>
                                                            <td>@(row.ContainsKey("EXEMPTION_RATE") ? row["EXEMPTION_RATE"] : "")</td>
                                                            <td>@(row.ContainsKey("DATE_ON_WHICH_EXEMPTION_BEGINS") ? row["DATE_ON_WHICH_EXEMPTION_BEGINS"] : "")</td>
                                                            <td>@(row.ContainsKey("Date_On_Which_Exemption_Ends") ? row["Date_On_Which_Exemption_Ends"] : "")</td>
                                                            <td>@(row.ContainsKey("REASON_FOR_EXEMPTION") ? row["REASON_FOR_EXEMPTION"] : "")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        else
                                        {
                                            <div style="text-align:center; background-color:#ffffff;">No Data Found</div>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <!-- HOLDING TAX DATA -->
                    </div>
                </div>
                <table class="tableView tablepadding" style="width:98%;" cellpadding="0" cellspacing="0">
                    <tr>
                        <td class="HeaderStyle12" colspan="4">&nbsp;Request Remarks</td>
                    </tr>

                    <tr class="row2">
                        <td style="width:25%;" class="collvlstyle">Remarks :-</td>
                        <td style="width:75%;" colspan="3"><span class="lblcss">@m2?.Remarks</span></td>
                    </tr>

                    <tr>
                        <td class="HeaderStyle12" colspan="4">&nbsp;Process History</td>
                    </tr>

                    <tr class="row2">
                        <td colspan="4">
                            @if (Model.ShowProcessHistory != null && Model.ShowProcessHistory)
                            {
                                <div id="processhisttbl">
                                    <table class="vendortable" cellpadding="0" cellspacing="0" style="width:99.3%;">
                                        <tr class="header_1">
                                            <td width="12%" class="header_3">Date</td>
                                            <td width="24%" class="header_3">Employee</td>
                                            <td width="21%" class="header_3">Status</td>
                                            <td width="40%" class="header_3">Remarks</td>
                                            <td width="3%" class="header_3"><img src="~/ASPXView/images/attachment.gif" alt="Attachment" /></td>
                                        </tr>

                                        @foreach (var row in m5)
                                        {
                                            <tr class="prochist">
                                                <td>@(row.ContainsKey("APPDATE") ? row["APPDATE"] : "")</td>
                                                <td>@(row.ContainsKey("EMPLOYEE") ? row["EMPLOYEE"] : "")</td>
                                                <td>@(row.ContainsKey("STATUSDESCRIPTION") ? row["STATUSDESCRIPTION"] : "")</td>
                                                <td align="left" style="word-break:break-all;">@(row.ContainsKey("Remarks") ? row["Remarks"] : "")</td>
                                                <td>
                                                    @{
                                                        var attachment = row.ContainsKey("ATTACHMENT") ? row["ATTACHMENT"] : null;
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(attachment))
                                                    {
                                                        var href = uploadBase.TrimEnd('/') + "/" + attachment;
                                                        <a target="_blank" href="@href"
                                                           onclick="open(this.href, this.target, 'width=800, height=550, top=90, left=200'); return false;">
                                                            &nbsp;&nbsp;<img alt="Doc" width="15" src="../../assets/images/icon_document.gif" />
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </table>
                                </div>

                                <div class="nodata" id="nodata" style="display:none;">No Process History Found</div>
                            }
                            else
                            {
                                <div class="nodata" id="nodata">No Process History Found</div>
                                <div id="processhisttbl" style="display:none;"></div>
                            }
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </form>
</body>
</html>





