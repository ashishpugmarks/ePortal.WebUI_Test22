@{
    ViewData["Title"] = "Employee Portal - Vendor Block :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    var payloadJson = ViewData["VendorPayload"] as string ?? "{}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/css/jquery-ui.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/VendorMaster.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />

    <link href="~/app/css/vendormaster/vendorblockform.css" rel="stylesheet" asp-append-version="true" />
}

<form id="vendorForm" enctype="multipart/form-data" class="row">
    <div id="vendorPayload" data-payload='@Html.Raw(payloadJson)' style="display:none"></div>
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Vendor Block/Unblock : Edit Request Form</span>
    </div>

    <div style="margin-left:5px; margin-right:10px; margin-top:10px;">
        <div class="headmain">
            <div id="ERRMSGDIV" class="errorbox_1" style="display:none"></div>
            <div class="sendbackdiv" id="sendback_div">
                <div class="SENDBACKHEAD">SEND BACK REMARK</div>
                <div class="sendbackremark" id="sendbackremark"></div>
            </div>
            <!-- Request Category -->
            <table class="tableView tablepadding tabmarg" style="width:100%;" cellpadding="0" cellspacing="0" id="TableVendorfrm2">
                <tr class="HeaderStyle12">
                    <td id="trAccgrp" class="HeaderStyle12">&nbsp;Request Category</td>
                </tr>
                <tr id="trAccgrpList" class="vendortablebg">
                    <td>
                        <div class="rdodiv">
                            <input type="radio" id="rdoblock" name="Categorytype" value="Block" checked />
                            <label for="rdoblock">Block&nbsp;</label>
                        </div>
                        <div class="rdodiv">
                            <input type="radio" id="rdounblock" name="Categorytype" value="Unblock" />
                            <label for="rdounblock">Unblock&nbsp;</label>
                        </div>
                    </td>
                </tr>
                <tr id="trblock" style="height:30px;" class="vendortablebg">
                    <td>
                        &nbsp;&nbsp;
                        <input type="checkbox" id="chkpurchblock" name="PurchasingData" value="true" />
                        <label for="chkpurchblock">&nbsp;Purchasing Data</label>
                        &nbsp;&nbsp;&nbsp;&nbsp;
                        <input type="checkbox" id="chkpostingblock" name="PostingData" value="true" />
                        <label for="chkpostingblock">&nbsp;Posting Data</label>
                    </td>
                </tr>
            </table>

            <!-- Request Type -->
            <table class="tableView tablepadding tabmarg" style="width:100%;" cellpadding="0" cellspacing="0" id="TableVendorfrm1">
                <tr>
                    <td class="HeaderStyle12" colspan="2">
                        <span style="float:left;">&nbsp;Request Type</span>
                    </td>
                </tr>
                <tr class="vendortablebg">
                    <td colspan="2">
                        <div class="rdodiv">
                            <input type="radio" id="rdosinglevendor" name="RequestType" value="SingleVendor" checked />
                            <label for="rdosinglevendor">Single Vendor&nbsp;</label>
                        </div>
                        <div class="rdodiv">
                            <input type="radio" id="rdomassvendor" name="RequestType" value="MassVendor" />
                            <label for="rdomassvendor">Mass Vendor&nbsp;</label>
                        </div>
                        <div class="infobtn">
                            <a href="VendorBlockTemplate.xls" title="Download Template">Download Template</a>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- Vendor Code / Upload -->
            <table class="tableView tablepadding" style="width:100%;" cellpadding="0" cellspacing="0" id="TableVendorfrm3">
                <tr class="vendortablebg" id="tr_vendorcode" data-visible="true">
                    <td class="collvlstyle" style="width:20%;">Vendor Code:-</td>
                    <td style="width:80%;">
                        <input type="text" id="txtvendorcode" name="VendorCode" class="form-control" maxlength="11" style="width:150px;margin-left:2px;" />
                    </td>
                </tr>
                <tr class="vendortablebg" id="tr_upload" data-visible="false" style="display:none;">
                    <td class="collvlstyle" style="width:20%;">Upload Template:-</td>
                    <td style="width:80%;">
                        <input type="file" id="UploadFile" name="UploadFile" class="btn btn-sm btn-primary" style="width:300px;" />
                        @* <input type="hidden" id="hdnFile" name="HiddenFile" value="@Model.HiddenFile" /> *@
                    </td>
                </tr>
                <tr class="buttontrbg">
                    <td colspan="2" align="center">
                        <button type="submit" id="btncontinuetonext" class="btn btn-sm btn-primary">Continue to Next</button>
                        &nbsp;&nbsp;
                        <button type="button" id="btncancel" class="btn btn-sm btn-default">Cancel</button>
                    </td>
                </tr>
            </table>

            <!-- Details section (initially hidden) -->
            <div id="TableVendorfrmdetails" style="display:none">
                <table class="tableView tablepadding tabmarg" style="width:100%;" cellpadding="0" cellspacing="0" id="Table2">
                    <tr>
                        <td class="HeaderStyle12" colspan="4">
                            <span style="float:left;">&nbsp;Request Details</span>
                        </td>
                    </tr>

                    <tr class="row1">
                        <td class="collvlstyle" style="width:20%;">Request Type  :-</td>
                        <td style="width:30%;" colspan="3">
                            &nbsp;<span id="lblrequesttype"></span>
                        </td>
                    </tr>

                    <tr class="row2">
                        <td class="collvlstyle" style="width:20%;">Purchasing Data  :-</td>
                        <td style="width:30%;">&nbsp;<span id="lblpurchasing"></span></td>
                        <td class="collvlstyle" style="width:20%;">Posting Data  :-</td>
                        <td style="width:30%;">&nbsp;<span id="lblposting"></span></td>
                    </tr>
                </table>

                <!-- Vendor details -->
                <table class="tableView tablepadding tabmarg" style="width:100%;" cellpadding="0" cellspacing="0" id="Table1">
                    <tr>
                        <td class="HeaderStyle12" colspan="2">
                            <span style="float:left;">&nbsp;Vendor details</span>
                        </td>
                    </tr>
                    <tr class="vendortablebg">
                        <td colspan="2">
                            <table id="REPVENDORNAME" class="vendortable" cellpadding="0" cellspacing="0" style="width:99.8%; border:1px solid black;">
                                <thead>
                                    <tr class="header_1">
                                        <td class="header_3" style="width:15%;">VENDOR CODE</td>
                                        <td class="header_3" style="width:35%;">VENDOR NAME</td>
                                        <td class="header_3" style="width:25%;">CITY</td>
                                        <td class="header_3" style="width:25%;">REGION</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- rows will be appended here -->
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Remarks and Forward To -->
                <table class="tableView tablepadding" style="width:100%;" cellpadding="0" cellspacing="0">
                    <tr>
                        <td class="HeaderStyle12" colspan="4">&nbsp;Request Remarks</td>
                    </tr>
                    <tr class="row2">
                        <td class="collvlstyle"><b>Remarks <span class="mandatory">*</span> :-</b></td>
                        <td colspan="3">
                            <textarea id="txtvendorremarks" class="form-control" name="VendorRemarks" style="width:400px;resize:none" rows="4"></textarea>
                        </td>
                    </tr>
                    <tr class="row1">
                        <td class="collvlstyle"><b>Forward To<span class="mandatory">*</span> :-</b></td>
                        <td colspan="3">
                            @* @Html.DropDownListFor(model => model.ForwardTo,
                                Model.ForwardToList,
                                     new { @id = "ddlforward", @style = "width:400px;", @class = "form-control" }) *@
                            <select id="ddlforward" class="form-control" name="ddlforward" style="width:400px;">
                                <!-- options go here -->
                            </select>
                        </td>
                    </tr>
                    <tr class="buttontrbg">
                        <td colspan="4" align="center">
                            <input type="hidden" id="HDVENDORCODELIST" name="VendorCodeList" />
                            <input type="hidden" id="HDVENDORBLOCKHID" name="VendorBlockId" />
                            <button type="button" id="btnsubmit" class="btn btn-sm btn-primary">Submit</button>
                            &nbsp;&nbsp;
                            <button type="button" id="btncancelfrm" class="btn btn-sm btn-default">Cancel</button>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    <div class="well well-sm">
        <table border="0" style="width: 100%;">
            <tr>
                <td style="height: 20px;">
                    <table style="width: 100%;">
                        <tbody>
                            <tr>
                                <td style="width: 20px; vertical-align: middle; text-align: center;">
                                    <a id="btnbackimg" title="Back">
                                        <img src="~/images/icon_back.gif" border="0" alt="" />
                                    </a>
                                </td>
                                <td style="vertical-align: middle; font-size: 15px;">
                                    <span><a id="btnbackspan" title="Back">Back</a></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </table>
    </div>
    <div id="ajaxLoader"></div>
</form>

@section Scripts{
    <script src="~/app/js/vendormaster/editvendorblockform.js" asp-append-version="true"></script>
}
