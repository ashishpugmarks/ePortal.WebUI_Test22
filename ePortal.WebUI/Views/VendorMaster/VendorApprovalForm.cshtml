            </tr>
            <tr>
                <td class="collvlstyle" width="20%">Status :-</td>
                <td width="80%">
                    @Html.DropDownListFor(
                                m => m.SelectedStatus,
                                new List<SelectListItem>
                    {
                    new SelectListItem { Text = "-Select-", Value = "" },
                    new SelectListItem { Text = "Approve", Value = "1" },
                    new SelectListItem { Text = "Reject", Value = "2" },
                    new SelectListItem { Text = "Send Back", Value = "3" }
                    },
                             new { @class = "form-control", id = "ddlstatus", style = "width:600px; resize:none", }
                                )
                </td>

            </tr>

            <tr>
                <td class="collvlstyle">Remarks :-</td>
                <td>
                    @Html.TextAreaFor(
                                m => m.ApprovalRemarks,
                                4, 60, // rows, cols (cols ignored by CSS but required overload)
                                new
                                {
                                    @class = "form-control", 
                                    style="width:600px; resize:none",
                                    id = "txt_Remarks",
                                    maxlength = "499",
                                    onkeypress = "return (this.value.length < 499);",
                                    onpaste = "return false",
                                }
                                )
                </td>
            </tr>

            <tr>
                <td class="HeaderStyle12" colspan="2">Disclaimer</td>
            </tr>
            <tr>
                <td colspan="2" class="disclaimer">
                    <label>
                        @Html.CheckBoxFor(m => m.IsDeclarationChecked, new { id = "chkdeclaration", @class = "chkdeclaration" })
                        I agree below terms &amp; conditions:
                    </label>
                    <ul class="TERMSCONDITION">
                        <li>I here by declare that the details furnished above are true and correct to the best of my knowledge and belief and undertake to inform you of any changes therein, immediately.</li>
                        <li>All Vendor details including Registration, Tax- Pan, Excise, Service, Tin/CST, Bank details, are crossed checked with attached certificates.</li>
                    </ul>
                </td>
            </tr>
            @if (m2.ShowTrFin)
            {
                <tr id="trfin">
                    <td class="collvlstyle">Next Approval :-</td>
                <td>
                    <span id="lblnextapproval" class="lblcss" style="font-weight:bold;">Finance Department</span>
                </td>
            </tr>
            }

            @if (m2.ShowTrSP)
            {
                <tr id="trSP">
                    <td class="fieldname" style="width:209px; text-align:right">Forward To(For Special Approval):</td>
                    <td>
                        @Html.DropDownListFor(
                                 m => m.SelectedSPAuthority,
                                 Model.SPAppAuthorityList,
                                 new { @class = "form-control", id = "cboSPAppAuthority", style = "width:600px;", }
                                 )
                        &nbsp;
                        @* <span id="lblsplmag" style="color:#FF3300; width:200px;">@Html.Raw(Model.SPSpecialMessage ?? "")</span> *@
                    </td>
                </tr>
            }

            <tr class="active">
                <td colspan="2" align="center">
                    <input type="button" id="btnsubmit" name="submit" value="Submit" class="btn btn-sm btn-primary" />
                    &nbsp;&nbsp;
                    <input type="button" id="btncancelfrm" name="submit" value="Cancel" class="btn btn-sm btn-default" />
                </td>
            </tr>
        </table>
    </div>
    <div class="well well-sm">
        <table border="0" style="width: 100%;">
            <tr>
                <td style="height: 20px;">
                    <table style="width: 100%;">
                        <tbody>
                            <tr>
                                <td style="width: 20px; vertical-align: middle; text-align: center;">
                                    <a id="btnbackimg" title="Back">
                                        <img src="~/images/icon_back.gif" border="0" alt="" />
                                    </a>
                                </td>
                                <td style="vertical-align: middle; font-size: 15px;">
                                    <span><a id="btnbackspan" title="Back">Back</a></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</form>

@section Scripts{
    <script src="~/app/js/vendormaster/vendorapprovalform.js" asp-append-version="true"></script>
}