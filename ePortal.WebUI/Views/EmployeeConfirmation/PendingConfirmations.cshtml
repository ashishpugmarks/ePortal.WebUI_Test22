@using ePortal.ViewModels.APPX.EmployeeConfirmation
@model List<ConfirmationRowViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Styles {
    <link href="~/css/index.css" rel="stylesheet" type="text/css" />

    <link href="~/app/css/EmployeeConfirmation/PendingConfirmations.css" rel="stylesheet" type="text/css" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/app/js/EmployeeConfirmation/PendingConfirmations.js" type="text/javascript" asp-append-version="true"></script>

}

<div class="row">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Pending Employee(s) Confirmations</span>
    </div>

    <div class="body-content" style="overflow:auto!important">
        <table width=100%>
            <tr>
                <td class="smalltext" style="padding: 2px; height: 18px;" align="left">
                    <b>
                        <font color="#707070">
                            <img alt="" src="/images/blueblockarrow.gif" />
                            &nbsp;List of Confirmation Form(s)
                        </font>
                    </b>
                </td>
                <td>
                    <p style="text-align: right; padding-right: 8px;">
                        <a asp-controller="EmployeeConfirmation" asp-action="ConfirmationsHistory">
                            <img src="~/images/mimeico_script.gif" alt="History" style="vertical-align: middle; padding-right: 2px;" />
                        </a>
                        <a asp-controller="EmployeeConfirmation" asp-action="ConfirmationsHistory" class="BlueBigLink">
                            <span style="color: #0000ff;">History</span>
                        </a>
                    </p>
                </td>
            </tr>
        </table>

        <table id="PendingTable" class="table table-bordered table-hover table-responsive" cellpadding="0" cellspacing="0" style="width: 100%;">
            <thead class="grdHeader">
                <tr>
                    <th class="text-center">E.Code</th>
                    <th>Employee Name</th>
                    <th>Confirmation Dt.</th>
                    <th class="text-center">Reviewer 1</th>
                    <th class="text-center">Reviewer 2</th>
                    <th class="text-center">Reviewer 3</th>
                    <th class="text-center">HR</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.IsHoldByHR ? "row-hold" : "")"
                        title="@(item.IsHoldByHR ? item.HoldTooltip : string.Empty)">
                        <td>
                            @* <label id="lblECode" onmouseover="ShowTooltip('@item.EName','@item.OpName','@item.DivName','@item.DeptName','@item.SecName','@item.PhotoUrl')" onmouseout="HideTooltip();" style="cursor: move; text-decoration: underline;">
                                @item.ADEmpCode
                            </label> *@
                            <label class = "emp-tooltip"
                                   data-name="@item.EName"
                                   data-op="@item.OpName"
                                   data-div="@item.DivName"
                                   data-dept="@item.DeptName"
                                   data-sec="@item.SecName"
                                   data-img="@item.PhotoUrl">
                                @item.ADEmpCode
                            </label>
                        </td>
                        <td>@item.EName</td>
                        <td>@item.ConfirmationDate</td>
                        <td class="text-center">
                            <a href="@item.Reviewer1Link" title="Review Confirmation Form">
                                <img src="@Url.Content(item.Reviewer1ImageUrl)" alt="Reviewer 1" />
                            </a>
                            <label>@item.DeptStatus</label>
                        </td>
                        <td class="text-center">
                            <a href="@item.Reviewer2Link" title="Review Confirmation Form">
                                <img src="@Url.Content(item.Reviewer2ImageUrl)" alt="Reviewer 2" />
                            </a>
                            <label>@item.DivStatus</label>
                        </td>
                        <td class="text-center">
                            <a href="@item.Reviewer3Link" title="Review Confirmation Form">
                                <img src="@Url.Content(item.Reviewer3ImageUrl)" alt="Reviewer 3" />
                            </a>
                            <label>@item.OpStatus</label>
                        </td>
                        <td class="text-center">
                            <a href="@item.HRLink" title="Review Confirmation Form">
                                <img src="@Url.Content(item.HRImageUrl)" alt="HR" />
                            </a>
                            @* <label>@item.HRApprovalStatus</label> *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        
    </div>

    @* <div class="well well-sm">
        <a asp-controller="Home" asp-action="Home" title="Back">
            <img src="~/images/icon_back.gif" alt="Back" />
            <span>Back</span>
        </a>
    </div> *@
</div>



