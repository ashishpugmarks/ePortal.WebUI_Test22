@using ePortal.ViewModels.APPX.EmployeeConfirmation
@model ReviewFormViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var active = (Model.ActiveTab ?? "DEPT").ToString(); // "DEPT","DIV","OPH","HR"
}

@section Styles {
    <link media="all" href="~/css/index.css" type="text/css" rel="stylesheet" asp-append-version="true" />

    <link media="all" href="~/app/css/EmployeeConfirmation/ReviewForm.css" type="text/css" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script src="~/app/js/EmployeeConfirmation/ReviewForm.js" type="text/javascript" asp-append-version="true"></script>
}

<div class="row">

    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Employee Confirmation Form</span>
    </div>


    @using (Html.BeginForm("ReviewForm", "EmployeeConfirmation", FormMethod.Post, new { id = "frmReviewForm" }))
    {
        @Html.AntiForgeryToken()

        <div style="margin-left: 10px; margin-right: 10px; margin-top: 5px; margin-bottom: 5px; vertical-align: middle;">
            <table cellspacing="0" cellpadding="1" width="100%" border="0">
                <tbody>
                    @* Error panel *@
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <tr>
                            <td>
                                <div style="width:100%;">
                                    <table width="98%" style="margin-left: 9px;" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td align="left" valign="top">
                                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder" style="border-width: 2px;">
                                                    <tbody>
                                                        <tr class="errorbox">
                                                            <td>
                                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                                    <tr>
                                                                        <td width="16" align="left" valign="middle">
                                                                            <img src="~/images/icon_error.gif" border="0" alt="" />
                                                                        </td>
                                                                        <td align="left" class="errorbox">
                                                                            <span class="smalltext">
                                                                                <b>@Model.ErrorMessage</b>
                                                                            </span>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    }

                    <tr>
                        <td>
                            @* Associate Details *@
                            <table style="border-color: #CCDCE0; border-width: 1px; border-style: solid; margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;"
                                   cellpadding="0" cellspacing="0" width="100%">
                                <thead>
                                    <tr>
                                        <td class="HeaderStyle12" colspan="4">
                                            Associate Detail&#39;s
                                        </td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="row1" style="line-height: 25px;">
                                        <td style="width: 25%; text-align: right; font-weight: bold; vertical-align: top;" class="font12">
                                            &nbsp;Name&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="width: 25%; color: #6299c5; vertical-align: top; text-align: left;">
                                            &nbsp;@Model.Name
                                        </td>
                                        <td style="width: 25%; text-align: right; font-weight: bold; vertical-align: top;" class="font12">
                                            &nbsp;Designation&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="width: 25%; color: #6299c5; vertical-align: top; text-align: left;">
                                            &nbsp;@Model.Designation
                                        </td>
                                    </tr>
                                    <tr class="row1" style="line-height: 25px;">
                                        <td style="text-align: right; font-weight: bold; vertical-align: top;" class="font12">
                                            &nbsp;E Code&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                            &nbsp;@Model.EmpCode
                                        </td>
                                        <td style="text-align: right; font-weight: bold; vertical-align: top;" class="font12">
                                            &nbsp;Division&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                            &nbsp;@Model.Division
                                        </td>
                                    </tr>
                                    <tr class="row1" style="line-height: 25px;">
                                        <td style="text-align: right; font-weight: bold; vertical-align: top;" class="font12">
                                            &nbsp;Date Of Joining&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                            &nbsp;@Model.JoiningDate
                                        </td>
                                        <td style="text-align: right; font-weight: bold; vertical-align: top;" class="font12">
                                            &nbsp;Department&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                            &nbsp;@Model.Department
                                        </td>
                                    </tr>
                                    <tr class="row1" style="line-height: 25px;">
                                        <td style="text-align: right; font-weight: bold; vertical-align: top;" class="font12">
                                            &nbsp;Date Of Review&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                            &nbsp;@Model.ReviewDate
                                        </td>
                                        <td style="text-align: right; font-weight: bold; vertical-align: top;" class="font12">
                                            &nbsp;Section&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                            &nbsp;@Model.Section
                                        </td>
                                    </tr>
                                    <tr class="row1" style="line-height: 25px;">
                                        <td style="text-align: right; font-weight: bold; vertical-align: top;" class="font12">
                                            &nbsp;Induction Prog. Status&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                            &nbsp;@Model.InductionStatus
                                        </td>
                                        <td style="text-align: right; font-weight: bold; vertical-align: top;" class="font12">
                                            &nbsp;Date Of Induction Prog.&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                            &nbsp;@Model.InductionDate
                                        </td>
                                    </tr>
                                    <tr class="row1" style="line-height: 25px;">
                                        <td style="text-align: right; font-weight: bold; vertical-align: top;" class="font12">
                                            &nbsp;Extension Periods&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                            &nbsp;@Model.PreviousExtensionPeriod
                                        </td>
                                        <td style="text-align: right; font-weight: bold; vertical-align: top;" class="font12">
                                            &nbsp;&nbsp;&nbsp;
                                        </td>
                                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                            &nbsp;
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            @* Reviewer Names *@
                            <table style="background-color: #B4B4B4; margin: 0px;" class="table table-bordered table-condensed">
                                <tr valign="top">
                                    <td align="center">
                                        <table class="someCss" width="100%" style="border: solid 1px #FFD152;">
                                            <tr>
                                                <td style="width: 33%;">
                                                    <b>Reviewer 1</b> :- @Model.Reviewer1Name
                                                </td>
                                                <td style="padding-left: 5px; width: 33%;">
                                                    <b>Reviewer 2</b> :- @Model.Reviewer2Name
                                                </td>
                                                <td style="padding-left: 5px; width: 33%;">
                                                    <b>Reviewer 3</b> :- @Model.Reviewer3Name
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            @* Rating Scale *@
                            <table class="table table-bordered table-condensed" style="margin: 0px;">
                                <tr valign="top">
                                    <td align="center">
                                        <table class="someCss" width="100%" style="border: solid 1px #FFD152;">
                                            <tr>
                                                <td colspan="5" style="color: #C48210; height: 15px; vertical-align: middle;">
                                                    Rating on the scale of 1 to 5 :-
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="width:10%;"><b>1</b> :- Poor</td>
                                                <td style="padding-left: 5px; width:15%;"><b>2</b> :- Needs Improvement</td>
                                                <td style="padding-left: 5px; width:10%;"><b>3</b> :- Good</td>
                                                <td style="padding-left: 5px; width:12%;"><b>4</b> :- Very Good</td>
                                                <td style="padding-left: 5px;"><b>5</b> :- Outstanding</td>
                                            </tr>
                                            <tr>
                                                <td colspan="5" style="height: 4px;">&nbsp;</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            @* Traits + Ratings *@
                            <table style="margin: 0px;" class="table table-bordered table-condensed">
                                <tr valign="top">
                                    <td align="center" style="width: 100%;">
                                        @Html.HiddenFor(m => m.TotalScore, new { id = "Hdn_TotalScore" })

                                        <table style="border-color: #CCDCE0; border-width: 1px; border-style: solid; margin-bottom: 6px; margin-left: 6px; margin-right: 6px; margin-top: 6px; width: 99%;">
                                            <thead>
                                                <tr>
                                                    <td class="HeaderStyle12" colspan="2">Traits</td>
                                                </tr>
                                            </thead>

                                            @if (Model.Traits != null)
                                            {
                                                for (int i = 0; i < Model.Traits.Count; i++)
                                                {
                                                    var trait = Model.Traits[i];
                                                    <tbody>
                                                        <tr>
                                                            <td align="center">
                                                                <table style="border-color: #CCDCE0; border-width: 1px; border-style: solid; width: 99%; margin-bottom: 3px; margin-top: 3px;"
                                                                       cellpadding="0" cellspacing="1">
                                                                    <thead>
                                                                        <tr>
                                                                            <td class="HeaderStyle123" style="padding-left: 5px;" colspan="3">
                                                                                <div class="smalltext">
                                                                                    @(i + 1). @trait.TraitName
                                                                                    @Html.HiddenFor(m => m.Traits[i].TraitID)
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                    </thead>

                                                                    @if (trait.Attributes != null)
                                                                    {
                                                                        <tbody>
                                                                            @for (int j = 0; j < trait.Attributes.Count; j++)
                                                                            {
                                                                                var attr = trait.Attributes[j];
                                                                                <tr style="background-color: #e2eaf3;">
                                                                                    <td class="font12" style="color: #4863A0; font-weight: bold; padding-left: 10px; width: 25%; padding-top: 2px; vertical-align: top;">
                                                                                        @(j + 1). @attr.AttributeName
                                                                                        @Html.HiddenFor(m => m.Traits[i].Attributes[j].TraitAttributeID)
                                                                                        @Html.HiddenFor(m => m.Traits[i].Attributes[j].RatingID)
                                                                                    </td>
                                                                                    <td class="font12" style="color: #4863A0; font-weight: bold; padding-left: 2px; padding-top: 2px; padding-bottom: 2px; vertical-align: top;">
                                                                                        <table cellpadding="2" cellspacing="0" border="0" style="padding: 2px">
                                                                                            <tr>
                                                                                                <td style="padding: 2px; color: #4863A0; font-weight: bold;" class="font12">
                                                                                                    Rating<span style="color: Red;">*</span>
                                                                                                </td>
                                                                                                <td style="padding: 2px">
                                                                                                    @Html.DropDownListFor(
                                                                                                    m => m.Traits[i].Attributes[j].Rating,
                                                                                                                                                                new List<SelectListItem>
                                                                                                                                                                {
                                                                                                                                                                new SelectListItem { Text = "-Select-", Value = "-1", Selected = string.IsNullOrEmpty(attr.Rating) || attr.Rating == "-1" },
                                                                                                                                                                new SelectListItem { Text = "1", Value = "1", Selected = attr.Rating == "1" },
                                                                                                                                                                new SelectListItem { Text = "2", Value = "2", Selected = attr.Rating == "2" },
                                                                                                                                                                new SelectListItem { Text = "3", Value = "3", Selected = attr.Rating == "3" },
                                                                                                                                                                new SelectListItem { Text = "4", Value = "4", Selected = attr.Rating == "4" },
                                                                                                                                                                new SelectListItem { Text = "5", Value = "5", Selected = attr.Rating == "5" }
                                                                                                                                                                },
                                                                                                                                                                new
                                                                                                                                                                {
                                                                                                                                                                    @class = "someCss",
                                                                                                                                                                    data_rating = "true",
                                                                                                                                                                    onchange = "getRating();",
                                                                                                                                                                    disabled = Model.IsTraitsEditable ? (string)null : "disabled"
                                                                                                                                                                })
                                                                            </td>
                                                                        </tr>
                                                                    </table>
                                                                </td>
                                                                <td class="smalltext" style="padding-top: 2px; padding-left: 5px;">
                                                                    <span style="color: Red;">*</span>
                                                                    @Html.TextAreaFor(
                                                                                                                                        m => m.Traits[i].Attributes[j].Comment,
                                                                                                                                        new
                                                                                                                                        {
                                                                                                                                            @class = "swifttextarea",
                                                                                                                                            rows = "4",
                                                                                                                                            style = "height:40px; width:400px;",
                                                                                                                                            maxlength = "1000",
                                                                                                                                            //disabled = Model.IsTraitsEditable ? "" : "disabled"
                                                                                                                                            @readonly = Model.IsTraitsEditable ? (string)null : "readonly"
                                                                                                                                        })
                                                                </td>
                                                            </tr>
                                                                                                                        }
                                                            </tbody>
                                                        }
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                                                                }
                                                                                }

                                        <tr>
                                            <td align="right" style="color: #003399; background-color: #FFE6A0; border: solid 1px #FFD152; height: 15px;">
                                                <table width="100%">
                                                    <tr>
                                                        <td align="right" style="font-weight: bold">Total Score:</td>
                                                        <td align="left" style="padding-right: 5px; width: 40px; padding-left: 4px; font-weight: bold;">
                                                            <span id="lblTotalScore">@Model.TotalScore</span>
                                                        </td>
                                                        <td align="right" style="font-weight: bold">Total %:</td>
                                                        <td align="left" style="padding-right: 5px; width: 40px; padding-left: 4px; font-weight: bold;">
                                                            <span id="lblTotalPer">@Model.TotalPercentage</span>
                                                        </td>
                                                        <td align="right" style="font-weight: bold">Average Rating:</td>
                                                        <td align="left" style="padding-right: 5px; width: 40px; padding-left: 4px; font-weight: bold;">
                                                            <span id="lblAverageRating">@Model.AverageRating</span>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                            @* Tabs for Reviewer 1, 2, 3, HR *@
                            
                            <tr valign="top">
                                <td align="center">
                                    <table style="width:100%;" class="table table-bordered table-condensed">
                                        <tr valign="top">
                                            <td align="center" style="padding:10px;">
                                                <div class="yuiTab">

                                                    <!-- Centered tab headers wrapper for Bootstrap 3 -->
                                                    <div class="centered-tabs-wrapper">
                                                        <ul class="nav nav-tabs" role="tablist">
                                                            <li role="presentation" class="@(active == "DEPT" ? "active" : "")">
                                                                <a href="#tab1" aria-controls="tab1" role="tab" data-toggle="tab">Reviewer 1</a>
                                                            </li>
                                                            <li role="presentation" class="@(active == "DIV" ? "active" : "")">
                                                                <a href="#tab2" aria-controls="tab2" role="tab" data-toggle="tab">Reviewer 2</a>
                                                            </li>
                                                            <li role="presentation" class="@(active == "OPH" ? "active" : "")">
                                                                <a href="#tab3" aria-controls="tab3" role="tab" data-toggle="tab">Reviewer 3</a>
                                                            </li>
                                                            <li role="presentation" class="@(active == "HR" ? "active" : "")">
                                                                <a href="#tab4" aria-controls="tab4" role="tab" data-toggle="tab">HR Status</a>
                                                            </li>
                                                        </ul>
                                                    </div>

                                                    <div class="tab-content ajax__tab_body" style="margin-top:5px;">

                                                        <!-- Reviewer 1 -->
                                                        <div role="tabpanel" class="tab-pane @(active == "DEPT" ? "active" : "")" id="tab1">
                                                            <table style="border-color:#CCDCE0; border-width:1px; border-style:solid; width:99%; margin:3px 0;">
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; text-align:right; vertical-align:middle;">
                                                                        Status&nbsp;:&nbsp;
                                                                    </td>
                                                                    <td class="font12" style="color:#4863A0; width:75%; vertical-align:middle">
                                                                        <div class="RadioButtonList">
                                                                            @{
                                                                                var items = new[]
                                                                                {
                                                                                                                                                        new SelectListItem { Text = "To be confirmed", Value = "1" },
                                                                                                                                                        new SelectListItem { Text = "To be extended for 3 Months", Value = "2" },
                                                                                                                                                        new SelectListItem { Text = "To be terminated", Value = "3" }
                                                                                                                                                        };
                                                                            }
                                                                            @foreach (var item in items)
                                                                            {
                                                                            var disabledAttr = Model.IsDeptEditable ? null : new { disabled = "disabled" };
                                                                            <label style="margin-right:12px;">
                                                                                @* @Html.RadioButtonFor(m => m.DeptApprovalStatus, item.Value, disabledAttr) *@
                                                                                    @Html.RadioButtonFor(m => m.DeptApprovalStatus, item.Value, new { disabled = Model.IsDeptEditable ? (string)null : "disabled" })
                                                                                @item.Text
                                                                            </label>
                                                                            }

                                                                            @* If controls are disabled (readonly scenario), include a hidden input so value posts back *@
                                                                            @if (!Model.IsDeptEditable) {
                                                                                    Html.HiddenFor(m => m.DeptApprovalStatus);
                                                                                }
                                                                        </div>
                                                                    </td>
                                                                </tr>

                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; vertical-align:top; text-align:right;">
                                                                        Comments&nbsp;:&nbsp;
                                                                    </td>
                                                                    <td class="font12" style="color:#4863A0; vertical-align:top;">
                                                                        @Html.TextAreaFor(m => m.DeptRemarks, new {
                                                                        style = "width:65%;height:40px;",
                                                                                                                                                @class = "form-control",
                                                                                                                                                @readonly = Model.IsDeptEditable ? (string)null : "readonly"
                                                                                                                                                })
                                                                    </td>
                                                                </tr>

                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td colspan="2" align="center" style="padding:5px 0 8px 0;">
                                                                        <button type="submit" name="command" value="SaveDraft" class="buttonshover1" @(Model.IsDeptEditable ? "" : "disabled=\"disabled\"")>Save As Draft</button>
                                                                        <button type="submit" name="command" value="SaveDept" class="buttonshover1" @(Model.IsTraitsEditable ? "" : "disabled=\"disabled\"")>Send</button>
                                                                        <button type="submit" name="command" value="CancelDept" class="buttonshover1" disabled="disabled">Cancel</button>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </div>

                                                        <!-- Reviewer 2 -->
                                                        <div role="tabpanel" class="tab-pane @(active == "DIV" ? "active" : "")" id="tab2">
                                                            <table style="border-color:#CCDCE0; border-width:1px; border-style:solid; width:99%; margin:3px 0;">
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; width:15%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Reviewer 1:
                                                                    </td>
                                                                    <td class="font12" style="color:#000000; font-weight:bold; width:75%; padding-top:2px; vertical-align:top;">
                                                                        @Model.DVDeptStatus
                                                                    </td>
                                                                </tr>

                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; width:15%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Reviewer 1 Comment:
                                                                    </td>
                                                                    <td class="font12" style="color:#000000; font-weight:bold; width:75%; padding-top:2px; vertical-align:top;">
                                                                        @Model.DVDeptHeadComment
                                                                    </td>
                                                                </tr>

                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; width:15%; vertical-align:middle; text-align:right; padding-right:10px;">
                                                                        Status&nbsp;:&nbsp;
                                                                    </td>
                                                                    <td class="font12" style="color:#4863A0; width:75%; vertical-align:middle;">
                                                                        <div class="RadioButtonList">
                                                                            @{
                                                                                var items2 = new[]
                                                                                {
                                                                                                                                                        new SelectListItem { Text = "To be confirmed", Value = "1" },
                                                                                                                                                        new SelectListItem { Text = "To be extended for 3 Months", Value = "2" },
                                                                                                                                                        new SelectListItem { Text = "To be terminated", Value = "3" }
                                                                                                                                                        };
                                                                            }
                                                                            @foreach (var it in items2)
                                                                            {
                                                                            @* var disabled = Model.IsDivEditable ? null : new { disabled = "disabled" }; *@
                                                                            <label style="margin-right:12px;">
                                                                                @* @Html.RadioButtonFor(m => m.DivApprovalStatus, it.Value, disabled) *@
                                                                                    @Html.RadioButtonFor(m => m.DivApprovalStatus, it.Value, new { disabled = Model.IsDivEditable ? (string)null : "disabled" })
                                                                                @it.Text
                                                                            </label>
                                                                            }

                                                                            @if (!Model.IsDivEditable) {
                                                                                    Html.HiddenFor(m => m.DivApprovalStatus);
                                                                                }
                                                                        </div>
                                                                    </td>
                                                                </tr>

                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; width:25%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Comments:&nbsp;
                                                                    </td>
                                                                    <td class="font12" style="color:#4863A0; padding-top:2px; padding-bottom:2px; vertical-align:top;">
                                                                        @Html.TextAreaFor(m => m.DivRemarks, new { style = "width:65%;height:40px;", @class = "form-control", @readonly = Model.IsDivEditable ? (string)null : "readonly" })
                                                                    </td>
                                                                </tr>

                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td colspan="2" align="center" style="padding:5px 0 8px 0;">
                                                                        <button type="submit" name="command" value="SaveDiv" class="buttonshover1" @(Model.IsTraitsEditable ? "" : "disabled=\"disabled\"")>Send</button>
                                                                        <button type="submit" name="command" value="CancelDiv" class="buttonshover1" disabled="disabled">Cancel</button>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </div>

                                                        <!-- Reviewer 3 -->
                                                        <div role="tabpanel" class="tab-pane @(active == "OPH" ? "active" : "")" id="tab3">
                                                            <table style="border-color:#CCDCE0; border-width:1px; border-style:solid; width:99%; margin:3px 0;">
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; width:15%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Reviewer 1:
                                                                    </td>
                                                                    <td class="font12" style="color:#000000; font-weight:bold; width:75%; padding-top:2px; vertical-align:top;">
                                                                        @Model.OPDeptHeadStatus
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; width:15%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Reviewer 1 Comment:
                                                                    </td>
                                                                    <td class="font12" style="color:#000000; font-weight:bold; width:75%; padding-top:2px; vertical-align:top;">
                                                                        @Model.OPDeptHeadComment
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; width:15%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Reviewer 2:
                                                                    </td>
                                                                    <td class="font12" style="color:#000000; font-weight:bold; width:75%; padding-top:2px; vertical-align:top;">
                                                                        @Model.OPDivHeadStatus
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; width:15%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Reviewer 2 Comment:
                                                                    </td>
                                                                    <td class="font12" style="color:#000000; font-weight:bold; width:75%; padding-top:2px; vertical-align:top;">
                                                                        @Model.OPDivHeadComment
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; vertical-align:middle; text-align:right;">
                                                                        Status&nbsp;:&nbsp;
                                                                    </td>
                                                                    <td class="font12" style="color:#4863A0; width:75%; vertical-align:middle;">
                                                                        <div class="RadioButtonList">
                                                                            @{
                                                                                var items3 = new[]
                                                                                {
                                                                                                                                                        new SelectListItem { Text = "To be confirmed", Value = "1" },
                                                                                                                                                        new SelectListItem { Text = "To be extended for 3 Months", Value = "2" },
                                                                                                                                                        new SelectListItem { Text = "To be terminated", Value = "3" }
                                                                                                                                                        };
                                                                            }
                                                                            @foreach (var it3 in items3)
                                                                            {
                                                                            //var disabled3 = Model.IsOpEditable ? null : new { disabled = "disabled" };
                                                                            <label style="margin-right:12px;">
                                                                                @* @Html.RadioButtonFor(m => m.OpApprovalStatus, it3.Value, disabled3) *@
                                                                                    @Html.RadioButtonFor(m => m.OpApprovalStatus, it3.Value, new { disabled = Model.IsOpEditable ? (string)null : "disabled" })
                                                                                @it3.Text
                                                                            </label>
                                                                            }

                                                                            @if (!Model.IsOpEditable) {
                                                                                    Html.HiddenFor(m => m.OpApprovalStatus);
                                                                                }
                                                                        </div>
                                                                    </td>
                                                                </tr>

                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; width:25%; padding-top:2px; vertical-align:top; text-align:right;">
                                                                        Reviewer 3 Comments:&nbsp;
                                                                    </td>
                                                                    <td class="font12" style="color:#4863A0; padding-left:2px; padding-top:2px; padding-bottom:2px; vertical-align:top;">
                                                                        @Html.TextAreaFor(m => m.OpRemarks, new { style = "width:65%;height:40px;", @class = "form-control", @readonly = Model.IsOpEditable ? (string)null : "readonly" })
                                                                    </td>
                                                                </tr>

                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td colspan="2" align="center" style="padding:5px 0 8px 0;">
                                                                        <button type="submit" name="command" value="SaveOp" class="buttonshover1" @(Model.IsTraitsEditable ? "" : "disabled=\"disabled\"")>Send</button>
                                                                        @* <button type="submit" name="command" value="SaveOp" class="buttonshover1" disabled="disabled">Send</button> *@
                                                                        <button type="submit" name="command" value="CancelOPH" class="buttonshover1" disabled="disabled">Cancel</button>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </div>

                                                        <!-- HR Status -->
                                                        <div role="tabpanel" class="tab-pane @(active == "HR" ? "active" : "")" id="tab4">
                                                            <table style="border-color:#CCDCE0; border-width:1px; border-style:solid; width:99%; margin:3px 0;">
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; width:15%; padding-top:2px; vertical-align:top;">
                                                                        &nbsp;
                                                                    </td>
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; width:75%; padding-top:2px; vertical-align:top;">
                                                                        <div class="RadioButtonList">
                                                                            @{
                                                                                var hrItems = new[]
                                                                                {
                                                                                                                                                        new SelectListItem { Text = "To be confirmed", Value = "1" },
                                                                                                                                                        new SelectListItem { Text = "To be extended for 3 Months", Value = "2" },
                                                                                                                                                        new SelectListItem { Text = "To be terminated", Value = "3" }
                                                                                                                                                        };
                                                                            }
                                                                            @foreach (var h in hrItems)
                                                                            {
                                                                            <label style="margin-right:12px;">
                                                                                @Html.RadioButtonFor(m => m.HRApprovalStatus, h.Value, new { disabled = "disabled" })
                                                                                @h.Text
                                                                            </label>
                                                                            }
                                                                        </div>
                                                                    </td>
                                                                </tr>

                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; width:15%; padding-top:2px; vertical-align:top;">
                                                                        &nbsp;Status:&nbsp;
                                                                    </td>
                                                                    <td class="font12" style="color:#4863A0; padding-top:2px; padding-bottom:2px; vertical-align:top;">
                                                                        @Html.DropDownListFor(m => m.HRStatus, new List<SelectListItem> {
                                                                        new SelectListItem { Text = "--Select--", Value = "-1" },
                                                                                                                                                new SelectListItem { Text = "Pending", Value = "1" },
                                                                                                                                                new SelectListItem { Text = "Ok", Value = "2" },
                                                                                                                                                new SelectListItem { Text = "Hold", Value = "3" }
                                                                                                                                                }, new { disabled = "disabled" })
                                                                        @* also post hidden to retain value if needed *@
                                                                        @Html.HiddenFor(m => m.HRStatus)
                                                                    </td>
                                                                </tr>

                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12" style="color:#4863A0; font-weight:bold; width:25%; padding-top:2px; vertical-align:top;">
                                                                        &nbsp;HR Comments:&nbsp;
                                                                    </td>
                                                                    <td class="font12" style="color:#4863A0; padding-top:2px; padding-bottom:2px; vertical-align:top;">
                                                                        @Html.TextAreaFor(m => m.HRRemarks, new { style = "width:65%;height:40px;", @class = "form-control", @readonly = "readonly" })
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </div>

                                                    </div> <!-- .tab-content -->
                                                </div> <!-- .yuiTab -->
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            @*New*@
                        </table>
                    </td>
                </tr>

            </tbody>
        </table>
    </div>

    @* Back link *@
    <div style="margin-left: 10px; margin-right: 10px; padding:4px;" class="well well-sm">
        <table border="0" style="width: 100%;">
            <tr>
                <td style="height: 20px;">
                    <table style="width: 100%;">
                        <tbody>
                            <tr>
                                <td style="width: 20px; vertical-align: middle; text-align: center;" align="left">
                                    <a title="Back" href="@Url.Action("PendingConfirmations", "EmployeeConfirmation")">
                                        <img src="~/images/icon_back.gif" border="0" alt="" />
                                    </a>
                                </td>
                                <td style="vertical-align: middle; font-size: 15px;">
                                    <span>
                                        <a title="Back" href="@Url.Action("PendingConfirmations", "EmployeeConfirmation")">
                                            Back
                                        </a>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </table>
    </div>
        }


</div>
