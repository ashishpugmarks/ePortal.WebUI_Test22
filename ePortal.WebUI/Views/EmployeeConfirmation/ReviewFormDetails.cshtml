@using ePortal.ViewModels.APPX.EmployeeConfirmation
@model ReviewFormDetailsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts {
    <script src="~/app/js/EmployeeConfirmation/ReviewFormDetails.js" type="text/javascript" asp-append-version="true"></script>
}

@section Styles {
    <link media="all" href="~/app/css/EmployeeConfirmation/ReviewFormDetails.css" type="text/css" rel="stylesheet" asp-append-version="true" />
}

<div class="row" style="font-size: 13px">
    <form asp-action="ReviewFormDetails" method="post">
    @Html.AntiForgeryToken()

    <!-- Active tab (mirrors ViewState[vs_ActiveTab]) -->
    <input type="hidden" id="ActiveTab" name="ActiveTab" value="@Model.ActiveTab" />

    <table cellspacing="0" cellpadding="1" width="100%" border="0">
        <tbody>
        <!-- ========== ERROR PANEL ========== -->
        @*if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <tr>
                <td style="padding-bottom:5px; padding-top:5px;" colspan="5">
                    <div id="errorpanel" style="width:100%;">
                        <table width="98%" style="margin-left:9px;" border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td align="left" valign="top">
                                    <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder" style="border-width:2px;">
                                        <tbody>
                                        <tr class="errorbox">
                                            <td>
                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                    <tr>
                                                        <td width="16" align="left" valign="middle">
                                                            <img src="~/images/icon_error.gif" alt="" />
                                                        </td>
                                                        <td align="left" class="errorbox">
                                                            <span class="smalltext">
                                                                <b><span style="color:red;">@Model.ErrorMessage</span></b>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>
        }*@
        <tr>
            <td style="padding-bottom:5px; padding-top:5px;" colspan="5">
        </tr>
        <!-- ========== ASSOCIATE DETAILS PANEL ========== -->
        <tr>
            <td colspan="5" style="padding-left:9px; padding-right:9px; padding-top:10px;">
                <div id="Panel7" class="roundedPanel" style="background-color:#B4B4B4; width:100%;">
                    <table style="background-color:#B4B4B4;" cellpadding="0" cellspacing="0" width="100%">
                        <tr valign="top">
                            <td align="center" style="padding:5px 10px;">
                                <table style="border-color:#CCDCE0; border-width:1px; border-style:solid; margin:2px 2px 2px 0;" 
                                       cellpadding="0" cellspacing="0" width="100%">
                                    <thead>
                                    <tr>
                                        <td class="HeaderStyle12" colspan="4">
                                            Associate Detail&#39;s
                                        </td>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr class="row1" style="line-height:25px;">
                                        <td style="width:25%; text-align:right; font-weight:bold; vertical-align:top;" class="font12">
                                            &nbsp;Name&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="width:25%; color:#6299c5; vertical-align:top; text-align:left;">
                                            &nbsp;@Model.Name
                                        </td>
                                        <td style="width:25%; text-align:right; font-weight:bold; vertical-align:top;" class="font12">
                                            &nbsp;Designation&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="width:25%; color:#6299c5; vertical-align:top; text-align:left;">
                                            &nbsp;@Model.Designation
                                        </td>
                                    </tr>
                                    <tr class="row1" style="line-height:25px;">
                                        <td style="text-align:right; font-weight:bold; vertical-align:top;" class="font12">
                                            &nbsp;E Code&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color:#6299c5; vertical-align:top; text-align:left;">
                                            &nbsp;@Model.EmpCode
                                        </td>
                                        <td style="text-align:right; font-weight:bold; vertical-align:top;" class="font12">
                                            &nbsp;Division&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color:#6299c5; vertical-align:top; text-align:left;">
                                            &nbsp;@Model.Division
                                        </td>
                                    </tr>
                                    <tr class="row1" style="line-height:25px;">
                                        <td style="text-align:right; font-weight:bold; vertical-align:top;" class="font12">
                                            &nbsp;Date Of Joining&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color:#6299c5; vertical-align:top; text-align:left;">
                                            &nbsp;@Model.JoiningDate
                                        </td>
                                        <td style="text-align:right; font-weight:bold; vertical-align:top;" class="font12">
                                            &nbsp;Department&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color:#6299c5; vertical-align:top; text-align:left;">
                                            &nbsp;@Model.Department
                                        </td>
                                    </tr>
                                    <tr class="row1" style="line-height:25px;">
                                        <td style="text-align:right; font-weight:bold; vertical-align:top;" class="font12">
                                            &nbsp;Date Of Review&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color:#6299c5; vertical-align:top; text-align:left;">
                                            &nbsp;@Model.ReviewDate
                                        </td>
                                        <td style="text-align:right; font-weight:bold; vertical-align:top;" class="font12">
                                            &nbsp;Section&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color:#6299c5; vertical-align:top; text-align:left;">
                                            &nbsp;@Model.Section
                                        </td>
                                    </tr>
                                    <tr class="row1" style="line-height:25px;">
                                        <td style="text-align:right; font-weight:bold; vertical-align:top;" class="font12">
                                            &nbsp;Induction Prog. Status&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color:#6299c5; vertical-align:top; text-align:left;">
                                            &nbsp;@Model.InductionStatus
                                        </td>
                                        <td style="text-align:right; font-weight:bold; vertical-align:top;" class="font12">
                                            &nbsp;Date Of Induction Prog.&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color:#6299c5; vertical-align:top; text-align:left;">
                                            &nbsp;@Model.InductionDate
                                        </td>
                                    </tr>
                                    <tr class="row1" style="line-height:25px;">
                                        <td style="text-align:right; font-weight:bold; vertical-align:top;" class="font12">
                                            &nbsp;Extension Periods&nbsp;:&nbsp;
                                        </td>
                                        <td class="smalltext" style="color:#6299c5; vertical-align:top; text-align:left;">
                                            &nbsp;@Model.PreviousExtensionPeriod
                                        </td>
                                        <td style="text-align:right; font-weight:bold; vertical-align:top;" class="font12">
                                            &nbsp;&nbsp;&nbsp;
                                        </td>
                                        <td class="smalltext" style="color:#6299c5; vertical-align:top; text-align:left;">
                                            &nbsp;
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- ========== RATING SCALE PANEL ========== -->
                <div id="Panel2" class="roundedPanel" style="background-color:#B4B4B4; width:100%; margin-top:5px;">
                    <table style="background-color:#B4B4B4;" cellpadding="0" cellspacing="0" width="100%">
                        <tr valign="top">
                            <td align="center" style="padding:5px 10px;">
                                <table class="someCss" width="100%" style="border:solid 1px #FFD152;">
                                    <tr>
                                        <td colspan="5" style="color:#C48210; height:15px; vertical-align:middle;">
                                            Rating on the scale of 1 to 5 :-
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:55px;">
                                            <b>1</b> :- Poor.
                                        </td>
                                        <td style="padding-left:5px; width:125px;">
                                            <b>2</b> :- Needs Improvement.
                                        </td>
                                        <td style="padding-left:5px; width:55px;">
                                            <b>3</b> :- Good.
                                        </td>
                                        <td style="padding-left:5px; width:80px;">
                                            <b>4</b> :- Very Good.
                                        </td>
                                        <td style="padding-left:5px;">
                                            <b>5</b> :- Outstanding.
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="5" style="height:4px;">&nbsp;</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- ========== TRAITS PANEL ========== -->
                <div id="Panel1" class="roundedPanel" style="background-color:#B4B4B4; width:100%; margin-top:5px;">
                    <table style="background-color:#B4B4B4;" cellpadding="0" cellspacing="0" width="100%">
                        <tr valign="top">
                            <td align="center" style="padding:5px 10px;">
                                <div id="Panel4" class="roundedPanel" style="background-color:#ffffff; width:100%;">
                                    @if (Model.Traits != null && Model.Traits.Any())
                                    {
                                        <table style="border-color:#CCDCE0; border-width:1px; border-style:solid; margin:6px;" 
                                               cellpadding="0" cellspacing="0" width="97%">
                                            <thead>
                                            <tr>
                                                <td class="HeaderStyle12" colspan="2">
                                                    Traits
                                                </td>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            @for (var i = 0; i < Model.Traits.Count; i++)
                                            {
                                                var trait = Model.Traits[i];
                                                <tr>
                                                    <td align="center">
                                                        <table style="border-color:#CCDCE0; border-width:1px; border-style:solid; width:99%; margin:3px 0;"
                                                               cellpadding="0" cellspacing="1">
                                                            <thead>
                                                            <tr>
                                                                <td class="HeaderStyle123" style="padding-left:5px;" colspan="3">
                                                                    <div class="smalltext">
                                                                        @(i + 1). @trait.TraitName
                                                                        <input type="hidden"
                                                                               name="Traits[@i].TraitID"
                                                                               value="@trait.TraitID" />
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            </thead>
                                                            <tbody>
                                                            @if (trait.Attributes != null && trait.Attributes.Any())
                                                            {
                                                                @for (var j = 0; j < trait.Attributes.Count; j++)
                                                                {
                                                                    var attr = trait.Attributes[j];
                                                                    <tr style="background-color:#e2eaf3;">
                                                                        <td class="font12"
                                                                            style="color:#4863A0; font-weight:bold; padding-left:10px; width:25%; padding-top:2px; vertical-align:top;">
                                                                            @(j + 1). @attr.AttributeName
                                                                            <input type="hidden"
                                                                                   name="Traits[@i].Attributes[@j].TraitAttributeID"
                                                                                   value="@attr.TraitAttributeID" />
                                                                        </td>
                                                                        <td class="font12"
                                                                            style="color:#4863A0; font-weight:bold; padding:2px; vertical-align:top;">
                                                                            <table cellpadding="2" cellspacing="0" border="0" style="padding:2px;">
                                                                                <tr>
                                                                                    <td class="font12"
                                                                                        style="padding:2px; color:#4863A0; font-weight:bold;">
                                                                                        Rating
                                                                                    </td>
                                                                                    <td style="padding:2px;">
                                                                                        <input type="hidden"
                                                                                               name="Traits[@i].Attributes[@j].RatingID"
                                                                                               value="@attr.RatingID" />
                                                                                        <select class="someCss"
                                                                                                name="Traits[@i].Attributes[@j].Rating"
                                                                                                disabled="disabled">
                                                                                            <option value="-1" selected="@(string.IsNullOrEmpty(attr.Rating) || attr.Rating == "-1")">
                                                                                                -Select-
                                                                                            </option>
                                                                                            <option value="1" selected = "@(attr.Rating == "1")">1</option>
                                                                                            <option value="2" selected = "@(attr.Rating == "2")">2</option>
                                                                                            <option value="3" selected = "@(attr.Rating == "3")">3</option>
                                                                                            <option value="4" selected = "@(attr.Rating == "4")">4</option>
                                                                                            <option value="5" selected = "@(attr.Rating == "5")">5</option>
                                                                                        </select>
                                                                                    </td>
                                                                                </tr>
                                                                            </table>
                                                                        </td>
                                                                        <td class="smalltext" style="padding-top:2px; padding-left:5px;">
                                                                            <textarea
                                                                                name="Traits[@i].Attributes[@j].Comment"
                                                                                class="swifttextarea"
                                                                                rows="4"
                                                                                style="height:40px; width:400px;"
                                                                                maxlength="4000"
                                                                                disabled="disabled">@attr.Comment</textarea>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            }
                                                            </tbody>
                                                        </table>
                                                    </td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            </td>
                        </tr>

                        <!-- ========== TABS (REVIEWER 1/2/3 + HR) ========== -->
                        <tr valign="top">
                            <td align="center" style="padding:5px 10px;">
                                <div id="Panel14" class="roundedPanel" style="background-color:#ffffff; width:100%;">
                                    <table style="background-color:#B4B4B4;" cellpadding="0" cellspacing="0" width="100%">
                                        <tr valign="top">
                                            <td align="center" style="padding:10px;">

                                                <!-- Tab headers -->
                                                        <ul class="yuiTab tab-headers" style="list-style:none; padding-left:0; display:flex; gap:4px; justify-content: center;">
                                                    @if (Model.ShowDeptTab)
                                                    {
                                                        <li>
                                                            <button type="button"
                                                                    class="tab-header-btn @(Model.ActiveTab == "DEPT" ? "active" : "")"
                                                                    data-tab="DEPT">
                                                                Reviewer 1
                                                            </button>
                                                        </li>
                                                    }
                                                    @if (Model.ShowDivTab)
                                                    {
                                                        <li>
                                                            <button type="button"
                                                                    class="tab-header-btn @(Model.ActiveTab == "DIV" ? "active" : "")"
                                                                    data-tab="DIV">
                                                                Reviewer 2
                                                            </button>
                                                        </li>
                                                    }
                                                    @if (Model.ShowOpTab)
                                                    {
                                                        <li>
                                                            <button type="button"
                                                                    class="tab-header-btn @(Model.ActiveTab == "OPH" ? "active" : "")"
                                                                    data-tab="OPH">
                                                                Reviewer 3
                                                            </button>
                                                        </li>
                                                    }
                                                    <li>
                                                        <button type="button"
                                                                class="tab-header-btn @(Model.ActiveTab == "HR" ? "active" : "")"
                                                                data-tab="HR">
                                                            HR Status
                                                        </button>
                                                    </li>
                                                </ul>

                                                <!-- Tab panels -->
                                                <div class="tab-panels" style="margin-top:5px;">
                                                    <!-- Reviewer 1 -->
                                                    @if (Model.ShowDeptTab)
                                                    {
                                                        <div class="tab-panel @(Model.ActiveTab == "DEPT" ? "active" : "")"
                                                             data-tab-panel="DEPT">
                                                            <table style="border-color:#CCDCE0; border-width:1px; border-style:solid; width:99%; margin:3px 0;"
                                                                   cellpadding="0" cellspacing="1">
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:15%; padding-top:2px; vertical-align:top;">
                                                                        Status
                                                                    </td>
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:75%; padding-top:2px; vertical-align:top;">
                                                                        <label class="me-3">
                                                                            <input type="radio"
                                                                                   name="DeptApprovalStatus"
                                                                                   value="1"
                                                                                   @(Model.DeptApprovalStatus == "1" ? "checked" : "")
                                                                                   @(Model.IsDeptReadOnly ? "disabled=\"disabled\"" : "") />
                                                                            To be confirmed
                                                                        </label>
                                                                        <label class="me-3">
                                                                            <input type="radio"
                                                                                   name="DeptApprovalStatus"
                                                                                   value="2"
                                                                                   @(Model.DeptApprovalStatus == "2" ? "checked" : "")
                                                                                   @(Model.IsDeptReadOnly ? "disabled=\"disabled\"" : "") />
                                                                            To be extended for 3 Months
                                                                        </label>
                                                                        <label class="me-3">
                                                                            <input type="radio"
                                                                                   name="DeptApprovalStatus"
                                                                                   value="3"
                                                                                   @(Model.DeptApprovalStatus == "3" ? "checked" : "")
                                                                                   @(Model.IsDeptReadOnly ? "disabled=\"disabled\"" : "") />
                                                                            To be terminated
                                                                        </label>
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:25%; padding-top:2px; vertical-align:top;">
                                                                        Comments:&nbsp;
                                                                    </td>
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding:2px; vertical-align:top;">
                                                                        &nbsp;
                                                                        <textarea name="DeptRemarks"
                                                                                  style="width:65%; height:40px;"
                                                                                  class="swifttextarea"
                                                                                  rows="4"
                                                                                  @(Model.IsDeptReadOnly ? "readonly=\"readonly\"" : "")>@Model.DeptRemarks</textarea>
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td colspan="2" align="center" style="padding-top:5px; padding-bottom:8px;">
                                                                        <button type="submit"
                                                                                name="action"
                                                                                value="SaveDept"
                                                                                class="buttonshover1"
                                                                                @(Model.IsDeptReadOnly ? "disabled=\"disabled\"" : "")>
                                                                            Save
                                                                        </button>
                                                                        <button type="button"
                                                                                class="buttonshover1">
                                                                                @*onclick="window.location='@Url.Action("PendingConfirmations","EmployeeConfirmation")'"*@
                                                                            Cancel
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                    }

                                                    <!-- Reviewer 2 -->
                                                    @if (Model.ShowDivTab)
                                                    {
                                                        <div class="tab-panel @(Model.ActiveTab == "DIV" ? "active" : "")"
                                                             data-tab-panel="DIV">
                                                            <table style="border-color:#CCDCE0; border-width:1px; border-style:solid; width:99%; margin:3px 0;"
                                                                   cellpadding="0" cellspacing="1">
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:15%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Reviewer 1:
                                                                    </td>
                                                                    <td class="font12"
                                                                        style="color:#000000; font-weight:bold; padding-left:10px; width:75%; padding-top:2px; vertical-align:top;">
                                                                        @Model.DVDeptStatus
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:15%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Reviewer 1 Comment:
                                                                    </td>
                                                                    <td class="font12"
                                                                        style="color:#000000; font-weight:bold; padding-left:10px; width:75%; padding-top:2px; vertical-align:top;">
                                                                        @* @Model.DVDeptHeadComment *@
                                                                        @Model.DeptRemarks
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:15%; padding-top:2px; vertical-align:middle; text-align:right; padding-right:10px;">
                                                                        Status:
                                                                    </td>
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:75%; padding-top:2px; vertical-align:top;">
                                                                        <label class="me-3">
                                                                            <input type="radio"
                                                                                   name="DivApprovalStatus"
                                                                                   value="1"
                                                                                   @(Model.DivApprovalStatus == "1" ? "checked" : "")
                                                                                   @(Model.IsDivReadOnly ? "disabled=\"disabled\"" : "") />
                                                                            To be confirmed
                                                                        </label>
                                                                        <label class="me-3">
                                                                            <input type="radio"
                                                                                   name="DivApprovalStatus"
                                                                                   value="2"
                                                                                   @(Model.DivApprovalStatus == "2" ? "checked" : "")
                                                                                   @(Model.IsDivReadOnly ? "disabled=\"disabled\"" : "") />
                                                                            To be extended for 3 Months
                                                                        </label>
                                                                        <label class="me-3">
                                                                            <input type="radio"
                                                                                   name="DivApprovalStatus"
                                                                                   value="3"
                                                                                   @(Model.DivApprovalStatus == "3" ? "checked" : "")
                                                                                   @(Model.IsDivReadOnly ? "disabled=\"disabled\"" : "") />
                                                                            To be terminated
                                                                        </label>
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:25%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Comments:&nbsp;
                                                                    </td>
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding:2px; vertical-align:top;">
                                                                        &nbsp;
                                                                        <textarea name="DivRemarks"
                                                                                  style="width:65%; height:40px;"
                                                                                  class="swifttextarea"
                                                                                  rows="4"
                                                                                  @(Model.IsDivReadOnly ? "readonly=\"readonly\"" : "")>@Model.DivRemarks</textarea>
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td colspan="2" align="center" style="padding-top:5px; padding-bottom:8px;">
                                                                        <button type="submit"
                                                                                name="action"
                                                                                value="SaveDiv"
                                                                                class="buttonshover1"
                                                                                @(Model.IsDivReadOnly ? "disabled=\"disabled\"" : "")>
                                                                            Save
                                                                        </button>
                                                                        <button type="button"
                                                                                class="buttonshover1">
                                                                                @* onclick="window.location='@Url.Action("PendingConfirmations","EmployeeConfirmation")'"> *@
                                                                            Cancel
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                    }

                                                    <!-- Reviewer 3 -->
                                                    @if (Model.ShowOpTab)
                                                    {
                                                        <div class="tab-panel @(Model.ActiveTab == "OPH" ? "active" : "")"
                                                             data-tab-panel="OPH">
                                                            <table style="border-color:#CCDCE0; border-width:1px; border-style:solid; width:99%; margin:3px 0;"
                                                                   cellpadding="0" cellspacing="1">
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:15%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Reviewer 1:
                                                                    </td>
                                                                    <td class="font12"
                                                                        style="color:#000000; font-weight:bold; padding-left:10px; width:75%; padding-top:2px; vertical-align:top;">
                                                                        @* @Model.OPDeptHeadStatus *@
                                                                        @Model.DVDeptStatus
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:15%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Reviewer 1 Comment:
                                                                    </td>
                                                                    <td class="font12"
                                                                        style="color:#000000; font-weight:bold; padding-left:10px; width:75%; padding-top:2px; vertical-align:top;">
                                                                        @* @Model.OPDeptHeadComment *@
                                                                        @Model.DeptRemarks
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:15%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Reviewer 2:
                                                                    </td>
                                                                    <td class="font12"
                                                                        style="color:#000000; font-weight:bold; padding-left:10px; width:75%; padding-top:2px; vertical-align:top;">
                                                                        @Model.OPDivHeadStatus
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:15%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Reviewer 2 Comment:
                                                                    </td>
                                                                    <td class="font12"
                                                                        style="color:#000000; font-weight:bold; padding-left:10px; width:75%; padding-top:2px; vertical-align:top;">
                                                                        @* @Model.OPDivHeadComment *@
                                                                        @Model.DivRemarks
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:15%; padding-top:2px; vertical-align:top; text-align:right; padding-right:10px;">
                                                                        Status:
                                                                    </td>
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:75%; padding-top:2px; vertical-align:top;">
                                                                        <label class="me-3">
                                                                            <input type="radio"
                                                                                   name="OpApprovalStatus"
                                                                                   value="1"
                                                                                   @(Model.OpApprovalStatus == "1" ? "checked" : "")
                                                                                   @(Model.IsOpReadOnly ? "disabled=\"disabled\"" : "") />
                                                                            To be confirmed
                                                                        </label>
                                                                        <label class="me-3">
                                                                            <input type="radio"
                                                                                   name="OpApprovalStatus"
                                                                                   value="2"
                                                                                   @(Model.OpApprovalStatus == "2" ? "checked" : "")
                                                                                   @(Model.IsOpReadOnly ? "disabled=\"disabled\"" : "") />
                                                                            To be extended for 3 Months
                                                                        </label>
                                                                        <label class="me-3">
                                                                            <input type="radio"
                                                                                   name="OpApprovalStatus"
                                                                                   value="3"
                                                                                   @(Model.OpApprovalStatus == "3" ? "checked" : "")
                                                                                   @(Model.IsOpReadOnly ? "disabled=\"disabled\"" : "") />
                                                                            To be terminated
                                                                        </label>
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding-left:10px; width:25%; padding-top:2px; vertical-align:top; text-align:right;">
                                                                        Reviewer 3 Comments:&nbsp;
                                                                    </td>
                                                                    <td class="font12"
                                                                        style="color:#4863A0; font-weight:bold; padding:2px; vertical-align:top;">
                                                                        &nbsp;
                                                                        <textarea name="OpRemarks"
                                                                                  style="width:65%; height:40px;"
                                                                                  class="swifttextarea"
                                                                                  rows="4"
                                                                                  @(Model.IsOpReadOnly ? "readonly=\"readonly\"" : "")>@Model.OpRemarks</textarea>
                                                                    </td>
                                                                </tr>
                                                                <tr style="background-color:#e2eaf3;">
                                                                    <td colspan="2" align="center" style="padding-top:5px; padding-bottom:8px;">
                                                                        <button type="submit"
                                                                                name="action"
                                                                                value="SaveOp"
                                                                                class="buttonshover1"
                                                                                @(Model.IsOpReadOnly ? "disabled=\"disabled\"" : "")>
                                                                            Save
                                                                        </button>
                                                                        <button type="button"
                                                                                class="buttonshover1">
                                                                                @* onclick="window.location='@Url.Action("PendingConfirmations","EmployeeConfirmation")'"> *@
                                                                            Cancel
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                    }

                                                    <!-- HR Status -->
                                                    <div class="tab-panel @(Model.ActiveTab == "HR" ? "active" : "")"
                                                         data-tab-panel="HR">
                                                        <table style="border-color:#CCDCE0; border-width:1px; border-style:solid; width:99%; margin:3px 0;"
                                                               cellpadding="0" cellspacing="1">
                                                            <tr style="background-color:#e2eaf3;">
                                                                <td class="font12"
                                                                    style="color:#4863A0; font-weight:bold; padding-left:10px; width:15%; padding-top:2px; vertical-align:top;">
                                                                    &nbsp;
                                                                </td>
                                                                <td class="font12"
                                                                    style="color:#4863A0; font-weight:bold; padding-left:10px; width:75%; padding-top:2px; vertical-align:top;">
                                                                    <label class="me-3">
                                                                        <input type="radio"
                                                                               name="HRApprovalStatus"
                                                                               value="1"
                                                                               @(Model.HRApprovalStatus == "1" ? "checked" : "")
                                                                               disabled="disabled" />
                                                                        To be confirmed
                                                                    </label>
                                                                    <label class="me-3">
                                                                        <input type="radio"
                                                                               name="HRApprovalStatus"
                                                                               value="2"
                                                                               @(Model.HRApprovalStatus == "2" ? "checked" : "")
                                                                               disabled="disabled" />
                                                                        To be extended for 3 Months
                                                                    </label>
                                                                    <label class="me-3">
                                                                        <input type="radio"
                                                                               name="HRApprovalStatus"
                                                                               value="3"
                                                                               @(Model.HRApprovalStatus == "3" ? "checked" : "")
                                                                               disabled="disabled" />
                                                                        To be terminated
                                                                    </label>
                                                                </td>
                                                            </tr>
                                                            <tr style="background-color:#e2eaf3;">
                                                                <td class="font12"
                                                                    style="color:#4863A0; font-weight:bold; padding-left:10px; width:15%; padding-top:2px; vertical-align:top;">
                                                                    &nbsp;Status:&nbsp;
                                                                </td>
                                                                <td class="font12"
                                                                    style="color:#4863A0; font-weight:bold; padding:2px; vertical-align:top;">
                                                                    &nbsp;
                                                                    <select name="HRStatus" disabled="disabled">
                                                                        <option value="-1" selected = "@(string.IsNullOrEmpty(Model.HRStatus) || Model.HRStatus == "-1")">--Select--</option>
                                                                        <option value="1" selected = "@(Model.HRStatus == "1")">Pending</option>
                                                                        <option value="2" selected = "@(Model.HRStatus == "2")">Ok</option>
                                                                        <option value="3" selected = "@(Model.HRStatus == "3")">Hold</option>
                                                                    </select>
                                                                </td>
                                                            </tr>
                                                            <tr style="background-color:#e2eaf3;">
                                                                <td class="font12"
                                                                    style="color:#4863A0; font-weight:bold; padding-left:10px; width:25%; padding-top:2px; vertical-align:top;">
                                                                    &nbsp;HR Comments:&nbsp;
                                                                </td>
                                                                <td class="font12"
                                                                    style="color:#4863A0; font-weight:bold; padding:2px; vertical-align:top;">
                                                                    &nbsp;
                                                                    <textarea name="HRRemarks"
                                                                              style="width:65%; height:40px;"
                                                                              class="swifttextarea"
                                                                              rows="4"
                                                                              readonly="readonly">@Model.HRRemarks</textarea>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </div>

                                                </div>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>

                    </table>
                </div>
            </td>
        </tr>

        <!-- ========== BACK LINK ========== -->
        <tr>
            <td colspan="5">
                <table cellspacing="0" cellpadding="2" width="100%" border="0" style="text-align:left; line-height:23px;" class="smalltext">
                    <tbody>
                    <tr>
                        <td>
                            <table cellpadding="0" cellspacing="0" border="0"
                                   style="margin-left:9px; margin-top:15px; margin-right:10px; margin-bottom:5px;">
                                <tr>
                                    <td align="left" valign="top" style="height:24px;" class="tborder">
                                        <table cellspacing="0" cellpadding="0" width="100%" border="0" class="row1">
                                            <tbody>
                                            <tr>
                                                <td style="height:24px; width:23px;" valign="middle" align="left">
                                                    <a title="Back" href="@Url.Action("PendingConfirmations", "EmployeeConfirmation")">
                                                        <img src="~/images/icon_back.gif" alt="Back" />
                                                    </a>
                                                </td>
                                                <td style="height:24px;" align="left">
                                                    <span class="smalltext">
                                                        <a title="Back" href="@Url.Action("PendingConfirmations", "EmployeeConfirmation")">Back</a>
                                                    </span>
                                                </td>
                                            </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        </tbody>
    </table>
</form>
</div>










