@using ePortal.ViewModels.APPX.EmployeeConfirmation
@model List<ConfirmationHistoryViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link media="all" href="~/css/index.css" rel="stylesheet" type="text/css" /> 
    <link href="~/app/css/EmployeeConfirmation/ConfirmationsHistory.css" rel="stylesheet" type="text/css" asp-append-version="true">
}

@section Scripts {    
	<script src="~/app/js/employeeconfirmation/confirmationshistory.js" asp-append-version="true"></script>
}


<div class="row">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Employee(s) Confirmations History</span>
    </div>


    <div class="body-content" style="overflow:auto; width:100%;">

        <table style="width:100%;">
            <tr>
                <td class="smalltext" style="padding: 2px; height: 18px;" align="left">
                    <b>
                        <img alt="" src="/images/blueblockarrow.gif" />
                        &nbsp;<span style="color:#707070;">List of Confirmation Form(s)</span>
                    </b>
                </td>
            </tr>
        </table>

        <table id="ConfirmationsTable" class="table table-bordered table-hover table-responsive" cellpadding="0" cellspacing="0" style="width: 100%;">
            <thead class="grdHeader">
                <tr>
                    <th></th>
                    <th class="text-center">E.Code</th>
                    <th class="text-center">Employee Name</th>
                    <th class="text-center">Confirmation Dt.</th>
                    <th class="text-center">Dept. Head</th>
                    <th class="text-center">Div. Head</th>
                    <th class="text-center">Op. Head</th>
                    <th class="text-center">HR</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a href="@Url.Action("ReviewFormDetails", "EmployeeConfirmation", new { id = item.HRConfirmationReviewId })" tabindex="0"
                               class="emp-tooltip"
                               data-name="@item.Name"
                               data-op="@item.OpName"
                               data-div="@item.DivName"
                               data-dept="@item.DeptName"
                               data-sec="@item.SecName"
                               data-img="@item.PhotoUrl">
                                <img src="~/images/icon_edit.gif" alt="Reviewer 1" />
                            </a>
                        </td>
                        <td>@item.EmpCode</td>
                        <td class="text-center">
                            @item.Name
                        </td>
                        <td>@item.ConfirmationDate</td>
                        <td class="text-center">
                            @item.DeptStatus
                        </td>
                        <td class="text-center">
                            @item.DivStatus
                        </td>
                        <td class="text-center">
                            @item.OpStatus
                        </td>
                        <td class="text-center">
                            @item.HRApprovalStatus
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Back Buttons -->
    <div class="well well-sm">
        <a asp-controller="EmployeeConfirmation" asp-action="PendingConfirmations" title="Back">
            <img src="~/images/icon_back.gif" alt="Back" />
            <span>Back</span>
        </a>
    </div>
</div>

<div id="Popup" class="tooltip-card" style="display:none;">
    <div class="tooltip-content">
        <div class="tooltip-text">
            <div class="tooltip-row">
                <span class="tooltip-label">Name:</span>
                <span id="td0" class="tooltip-value"></span>
            </div>
            <div class="tooltip-row">
                <span class="tooltip-label">Operation:</span>
                <span id="td1" class="tooltip-value"></span>
            </div>
            <div class="tooltip-row">
                <span class="tooltip-label">Division:</span>
                <span id="td2" class="tooltip-value"></span>
            </div>
            <div class="tooltip-row">
                <span class="tooltip-label">Department:</span>
                <span id="td3" class="tooltip-value"></span>
            </div>
            <div class="tooltip-row">
                <span class="tooltip-label">Section:</span>
                <span id="td4" class="tooltip-value"></span>
            </div>
        </div>
        <div class="tooltip-image">
            <img id="uImage" alt="Employee photo" />
        </div>
    </div>
</div>



