                            }
                            else {
                                $("#append_Data_History").append('<tr><td class="text-center">' + (i + 1) + '</td><td class="text-center" hidden>' + r.TRAN_NO + '</td><td class="text-center">' + r.EMP_CODE + '</td><td class="text-center">' + r.EMP_NAME + '</td><td class="text-center">' + r.DESIGNATION + '</td><td class="text-center">' + r.DEPARTMENT + '</td><td class="text-center">' + r.APPROVAL_STATUS + '</td><td class="text-center">' + parseJsonDatehi(r.UPDATEDON) + '</td><td class="text-center">' + r.REMARKS + '</td></tr>');
                            }

                        });
                    }
                    else {
                        $("#append_Data").empty();
                        $("#append_Data").append("<tr><td colspan='25' class='text-center'>No record found.</td></tr>")
                    }
                },
                complete: function () {
                },
                error: function () {
                    swal("Oops...", "Something went wrong!", 'error');
                }
            });

        }

        function UpdateApproval(current) {
            var AssetType = "@Model.ASSET_TYPE";
            var _Status = ($(current).attr('data-status') == "" ? "" : $(current).attr('data-status'));
            if (AssetType === "Capitalized Asset") {
                var dt = tableToJson($("#DtData"));
            }
            else {
                var dt = tableToJson($("#DtData_non"));
            }
            var _Tranno = ($('#TransactionNo').val());
            var _remarks = ($('#Remarks').val());

            if ((_Status == "Sent Back" || _Status == "Rejected") && _remarks == "") {
                swal('','Please Enter Remarks...', 'info');
                return $('#Remarks').focus();
            }
            var URL = '/AssetTransfer/UpdateApproval';
            $(".action-btn").attr("disabled", true);
            $.ajax({
                type: "POST",
                url: URL,
                data: { Remarks: _remarks, TranNo: _Tranno, Status: _Status, Details: dt },
                datatype: "json",
                //contentType: "application/json; charset=utf-8",
                //processData: false,
                success: function (data) {
                    $(".action-btn").attr("disabled", false);
                    // Access processed data if needed
                    var processedData = data.processedData;
                    // Close fancybox or handle the success response accordingly
                    parent.jQuery.fancybox.close();
                    swal('','This Record has been ' + _Status, 'success');
                    document.location = '/AssetTransfer/approval';
                },
                complete: function () {
                    $(".action-btn").attr("disabled", false);
                },
                error: function () {
                    $(".action-btn").attr("disabled", false);
                    swal("Oops...", "Something went wrong!", 'error');
                }
            });

        }

        function Cancel() {
            document.location = '/AssetTransfer/approval';
        }

        function GetPDF(current) {
            var filename = $(current).attr('data-id');
            var _path = "../../../Uploads/AT/DetailUpload/";

            $.ajax({
                type: 'POST',
                url: '/AssetTransfer/OpenPdfdt', // Replace 'Home' with your controller name
                data: { pdfPath: filename },
                success: function (data) {
                    if (data.FILEPATH != "") {
                        //document.getElementById("append_pdf").innerHTML = data.FILEPATH;
                        var fullFilePath = _path + filename;

                        var width = screen.width - 100;
                        var height = screen.height - 100;
                        var winTop = 50;
                        var winLeft = 50;
                        var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
                        windowFeatures = windowFeatures + ",left = " + winLeft + ",";
                        windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
                        window.open(fullFilePath, "_blank", windowFeatures);
                    }
                },
                error: function (error) {
                    console.error('Error opening PDF:', error);
                }
            });
        }


    </script>

