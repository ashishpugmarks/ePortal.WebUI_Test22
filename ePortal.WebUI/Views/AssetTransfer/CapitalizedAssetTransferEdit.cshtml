        function mapHeaderToProperty(header) {

            var headerMappings = {
                'Attachment': 'ASSET_ATTACH',
                'SrNo': 'SRNO',
                'Tran. No.': 'TRAN_NO',
                'Asset Code': 'ASSET_CODE',
                'Description': 'DESCRIPTION',
                'Po.No.': 'PO_NO',
                'Po.Date': 'PO_DATE',
                'Fully/partial': 'FULLY_PARTIAL',
                'Qty': 'QTY',
                'Current Location': 'CURRENT_LOCATION',
                'New Location': 'NEW_LOCATION',
                'Original Cost': 'ORIGINAL_COST',
                'Depreciation': 'DEPRECIATION',
                'Net Block': 'NET_BLOCK',
                'Inv.No.': 'INV_NO',
                'Inv.Date': 'INV_DATE',
                'Asset Serial No.': 'ASSET_SERIAL_NO',
                'Asset Class': 'ASSET_CLASS',
                'Capitalized Date': 'CAPITALIZED_DATE',
                'Vendor Name': 'VENDER_NAME',
                'Vendor Code': 'VENDOR_CODE',
                'AssetMain No.Text': 'ASSETMAIN_NO_TEXT',
                'License No.': 'LICENSE_NO',
                'License Date': 'LICENSE_DATE',
                'HSN Code': 'HSN_CODE',
                'Basic Price': 'BASIC_PRICE',
                'Invoice Value': 'INVOICE_VALUE',
                'New Asset Code': 'NEW_ASSET_CODE',
                'EODC Cleareanse': 'EODC_CLEAREANSE'


            };


            return headerMappings[header] || header;
        }

        function tableToJson(table) {
            var data = [];

            var headers = $(table).find('thead th').map(function () {
                return $(this).text().trim();
            }).get();


            $(table).find('tbody tr').each(function () {
                var rowData = {};


                $(this).find('td').each(function (cellIndex) {

                    var header = headers[cellIndex];
                    var value = $(this).text().trim();

                    var propertyName = mapHeaderToProperty(header);


                    if (propertyName === 'PO_DATE' || propertyName === 'INV_DATE' || propertyName === 'CAPITALIZED_DATE' || propertyName === 'LICENSE_DATE') {

                        rowData[propertyName] = new Date(value);
                    } else if (propertyName === 'QTY' || propertyName === 'BASIC_PRICE' || propertyName === 'INVOICE_VALUE' || propertyName === 'ORIGINAL_COST' || propertyName === 'DEPRECIATION' || propertyName === 'NET_BLOCK' || propertyName === 'VENDOR_CODE' || propertyName === 'LICENSE_NO' || propertyName === 'HSN_CODE') {

                        rowData[propertyName] = parseInt(value);
                    } else {

                        rowData[propertyName] = value;
                    }
                });

                data.push(rowData);
            });

            return data;
        }

        function History() {
            var TRANNO = $('#TransactionNo').val();
            var URL = '/AssetTransfer/History/?TranNo=' + TRANNO;
            $.ajax({
                type: "GET",
