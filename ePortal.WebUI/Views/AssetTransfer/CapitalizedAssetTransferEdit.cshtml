@model ePortal.DomainClasses.AT_ASSSET_TRANSFER_HEADER
@{
    ViewBag.Title = "CapitalizedAssetTransferEdit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Styles {
    <style nonce="@Context.Items["StyleNonce_0"]">
        .validationError {
            border: 1px solid #a94442 !important;
        }

        .validationBackground {
            background-color: #a94442 !important;
            color: white;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            /*background-image: url('../../assets/images/loading_double.gif');*/
            opacity: .7;
        }
    </style>
}
<link rel="stylesheet" href="~/css/new-aproval-page.css" asp-append-version="true" />
@* Header and Breadcrumb *@
<div class="app-header">
    <div>Asset Transfer Approval</div>
    <div class="pull-right"><span style="color:#e6dede91"> <i class="fa fa-home"></i> <i class="fa fa-angle-right"></i> Asset Transfer <i class="fa fa-angle-right"></i> </span>Approval</div>
</div>
@* Request Details *@
<div class="panel panel-shadow">
    <div class="panel-heading" data-toggle="collapse" data-target="#reqDetails">
        <span class="panel-title">
            <i class="fa fa-caret-down caret-color"></i>Request Details
        </span>
    </div>
    <div id="reqDetails" class="panel-body panel-collapse collapse in">
        <table class="table table-responsive approval-table table-curved">
            <tbody>
                <tr>
                    <th width="15%">
                        <label>Request No:</label>
                    </th>
                    <td width="35%">
                        <input id="TransactionNo" name="TransactionNo" type="text" class="form-control" disabled value="@Model.TRAN_NO" autocomplete="off" />
                    </td>
                    <th width="15%">
                        <label>Request Date</label>
                    </th>
                    <td width="35%">
                        <input id="TransactionDate" name="Transactiondate" type="date" class="form-control" disabled value="@Model.TRAN_DATE" autocomplete="off" />
                    </td>
                </tr>
                <tr>
                    <th>
                        <label>Transferor</label>
                    </th>
                    <td>
                        <input id="Transferor" name="Transferor" type="text" class="form-control" disabled value="@Model.TRANSFEROR" autocomplete="off" />
                    </td>
                    <th>
                        <label>Approval Type</label>
                    </th>
                    <td>
                        <select id="ddlApprovalType" name="ddlApprovalType" disabled class="form-control">
                            <option value="EBQ">EBQ</option>
                            <option value="NON EBQ">NON EBQ</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <th>
                        <label>Transferee User</label>
                    </th>
                    <td>
                        <input id="Transfree" name="Transfree" type="text" class="form-control mb-3" disabled value="@Model.TRANSFREE" autocomplete="off" />
                    </td>
                    <th>
                        <label>Duration</label>
                    </th>
                    <td>
                        <input id="Duration" name="Duration" type="text" class="form-control mb-2" disabled value="@Model.DURATION" autocomplete="off" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

