@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            var vldfrm = GetDate('@Model.TRAN_DATE');
            $("#TransactionDate").val(vldfrm);
            $('#ddlApprovalType').val('@Model.APPROVAL_TYPE');
            Detailedit();
            History();


        });

        function parseJsonDatehi(jsonDateString) {
            const dateString = jsonDateString;
            const dateNumber = dateString.match(/\d+/)[0];
            //const date = new Date(+dateNumber);
            const date = new Date(jsonDateString);
            const options = {
                hour: 'numeric',
                minute: 'numeric',
                second: '2-digit',
                month: 'numeric',
                day: 'numeric',
                year: 'numeric'
            };
            const formattedDate = date.toLocaleDateString('en-IN', options);
            return formattedDate;
        }

        function GetDate(dateStr) {
            var components = dateStr.split(' ');
            var delimeter = components[0].includes("/") ? "/" : "-";
            var dateComponents = components[0].split(delimeter);
            if(delimeter=="/"){
                var month = dateComponents[0].length == 1 ? "0" + dateComponents[0] : dateComponents[0];
                var day = dateComponents[1].length == 1 ? "0" + dateComponents[1] : dateComponents[1];
                var year = dateComponents[2];
                var formattedDate = year + '-' + month + '-' + day;
                return formattedDate;
            }
            else{
                    var day = dateComponents[0].length == 1 ? "0" + dateComponents[0] : dateComponents[0];
                    var month = dateComponents[1].length == 1 ? "0" + dateComponents[1] : dateComponents[1];
                    var year = dateComponents[2];
                    var formattedDate = year + '-' + month + '-' + day;
                    return formattedDate;
            }
        }

        $(function () {
            $("#btnExportexcel").click(function () {
                // Clone the Grid content to avoid manipulating the original content

                var assettype = '@Model.ASSET_TYPE';

                if (assettype == "Non-Capitalized Asset") {
                    var gridHtml = $("#Non_capitalized").clone();
                    gridHtml.find("tr:last").remove();
                    gridHtml.find("th:nth-child(20), td:nth-child(20)").remove();
                    gridHtml.find("th:nth-child(15), td:nth-child(15)").remove();
                    gridHtml.find("th:nth-child(7), td:nth-child(7)").remove();
                    gridHtml.find("th:nth-child(3), td:nth-child(3)").remove();
                    gridHtml.find("th:nth-child(1), td:nth-child(1)").remove();

                    gridHtml.find("th").css("background-color", "#B8DBFD");

                    gridHtml.find("th, td").css("border", "1px solid #ccc");
                    // Set the modified HTML as the value of the input field

                    gridHtml.find("td input").each(function () {
                        var value = $(this).val(); // Get the value of the input
                        $(this).parent().text(value); // Replace the input with its value
                    });
                    gridHtml.find("td select").each(function () {
                        var select = $(this).val(); // Get the value of the input
                        $(this).parent().text(select); // Replace the input with its value
                    });
                    $("input[name='GridHtml']").val(gridHtml.html());
                }

                else {
                    var gridHtml = $("#capitalized").clone();
                    gridHtml.find("tr:last").remove();

                    gridHtml.find("th:nth-child(26), td:nth-child(26)").remove();
                    gridHtml.find("th:nth-child(25), td:nth-child(25)").remove();
                    gridHtml.find("th:nth-child(24), td:nth-child(24)").remove();
                    gridHtml.find("th:nth-child(23), td:nth-child(23)").remove();
                    gridHtml.find("th:nth-child(22), td:nth-child(22)").remove();
                    gridHtml.find("th:nth-child(21), td:nth-child(21)").remove();
                    gridHtml.find("th:nth-child(3), td:nth-child(3)").remove();
                    gridHtml.find("th:nth-child(1), td:nth-child(1)").remove();

                    gridHtml.find("th").css("background-color", "#B8DBFD");

                    gridHtml.find("th, td").css("border", "1px solid #ccc");
                    // Set the modified HTML as the value of the input field

                    gridHtml.find("td input").each(function () {
                        var value = $(this).val(); // Get the value of the input
                        $(this).parent().text(value); // Replace the input with its value
                    });
                    gridHtml.find("td select").each(function () {
                        var select = $(this).val(); // Get the value of the input
                        $(this).parent().text(select); // Replace the input with its value
                    });
                    $("input[name='GridHtml']").val(gridHtml.html());
                }

            });
        });

        function parseJsonDate(jsonDateString) {

            const dateString = jsonDateString;
            const dateNumber = dateString.match(/\d+/)[0];
            //const date = new Date(+dateNumber);
            const date = new Date(jsonDateString);
            const options = {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
            };
            const formattedDate = date.toLocaleDateString('en-IN', options);
            return formattedDate;
        }

        function Detailedit() {
            var APPAUTHSRNO = @ViewBag.APPAUTHSRNO;
            var _TranNo = ($('#TransactionNo').val());
            var URL = '/AssetTransfer/CapitalizedDetail/?id=' + _TranNo + '&APPAUTHSRNO=' + APPAUTHSRNO;

            $.ajax({
                type: "GET",
                url: URL,
                datatype: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (JSON.parse(data).length != 0) {

                        var Data = JSON.parse(data);
                        var Data1 = Data.DtData;
                        var AssetType = "@Model.ASSET_TYPE";
                        var Status = Data.Status;
                        if (Status != "Pending") {
                            $(".action-btn").attr('disabled', true);
                            $("#Remarks, .action-btn").attr('disabled', true);

                        }
                        else {
                            $(".action-btn").attr('disabled', false);
                            $("#Remarks").attr('disabled', false);
                        }
                        var TOTAL_ORIGINAL_COST = 0;
                        var TOTAL_DEPRECIATION = 0;
                        var TOTAL_NET_BLOCK = 0;
                        var TOTAL_BASIC_PRICE = 0;
                        var TOTAL_INVOICE_VALUE = 0;
                        $("#append_Data_Non_capitalized").empty();
                        $("#append_Data").empty();
                        $.each(Data1, function (i, r) {


                            if (AssetType === "Capitalized Asset") {
                                $('#capitalized').removeClass('hidden');

                                TOTAL_ORIGINAL_COST = TOTAL_ORIGINAL_COST + Number(r.ORIGINAL_COST);
                                TOTAL_DEPRECIATION = TOTAL_DEPRECIATION + Number(r.DEPRECIATION);
                                TOTAL_NET_BLOCK = TOTAL_NET_BLOCK + Number(r.NET_BLOCK);

                                $("#append_Data").append('<tr><td class="text-center">' +
                                    (r.ASSET_ATTACH !== null ? '<a title="Asset Attachment" data-id="' + r.ASSET_ATTACH + '" data-ctrl="anc-click-getpdf" class="btn btn-primary btn-xs"><i class="ace-icon fa fa-eye fa-lg" id="document"></i></a>' : '') +
                                    '</td>' +
                                    '<td class="text-center">' + (i + 1) + '</td><td class="text-center" hidden>' + r.TRAN_NO + '</td>' +
                                    '<td class="text-center">' + r.ASSET_CODE + '</td><td class="text-center">' + (r.ASSET_CLS_DESC == null ? "" : r.ASSET_CLS_DESC) + '</td><td class="text-center">' + r.DESCRIPTION + '</td>' +
                                    '<td class="text-center" >' + r.ASSETMAIN_NO_TEXT + '</td><td class="text-right">' + (r.VENDOR_CODE == null ? "" : r.VENDOR_CODE) + '</td>' +
                                    '<td class="text-center">' + r.VENDER_NAME + '</td>' +
                                    '<td class="text-right">' + r.PO_NO + '</td><td class="text-center">' + (r.PO_DATE == null ? "" : parseJsonDate(r.PO_DATE)) + '</td>' +
                                    '<td class="text-right">' + (r.INV_NO == null ? "" : r.INV_NO) + '</td><td class="text-center">' + (r.INV_DATE == null ? "" : parseJsonDate(r.INV_DATE)) + ' </td>' +
                                    '<td class="text-center">' + r.FULLY_PARTIAL + '</td><td class="text-right">' + r.QTY + '</td>' +
                                    '<td class="text-center">' + r.CURRENT_LOCATION + '</td><td class="text-center">' + r.NEW_LOCATION + '</td>' +
                                    '<td class="text-right">' + r.ORIGINAL_COST.toLocaleString() + '</td><td class="text-right">' + r.DEPRECIATION.toLocaleString() + '</td>' +
                                    '<td class="text-right">' + r.NET_BLOCK.toLocaleString() + '</td><td class="text-center" hidden>' + r.LICENSE_NO + '</td>' +
                                    '<td class="text-center" hidden>' + r.ASSET_SERIAL_NO + '</td>' +
                                    '<td class="text-center" hidden>' + r.ASSET_CLASS + '</td>' +
                                    '<td class="text-center" hidden>' + (r.CAPITALIZED_DATE == null ? "" : parseJsonDate(r.CAPITALIZED_DATE)) + '</td>' +
                                    '<td class="text-center" hidden>' + (r.LICENSE_DATE == null ? "" : parseJsonDate(r.LICENSE_DATE)) + '</td>' +
                                    '<td class="text-center" hidden>' + r.HSN_CODE + '</td><td class="text-center">' + (r.NEW_ASSET_CODE == null ? "" : r.NEW_ASSET_CODE) + '</td><td class="text-center">' + (r.EODC_CLEAREANSE == null ? "" : r.EODC_CLEAREANSE) + '</td></tr>');
                            }
                            else {
