@section Scripts {
    <script nonce="@Context.Items["ScriptNonce_3"]">
        var current_fs, next_fs, previous_fs; //fieldsets
        var left, opacity, scale; //fieldset properties which we will animate
        var animating; //flag to prevent quick multi-click glitches
        var arrayList = new Array, savedArrayList = new Array, TotalRowCount = 0, _type = 0, IsUploadAttachment = false;
        $('.homeContent').removeClass('homeContent');

        window.onpaint = preloadFunc();
        function preloadFunc() {
             $("#ajaxLoader2").addClass('loader');
        }

        $(document).ready(function () {


            $("#ajaxLoader2").removeClass('loader');

            $('#span_count').text(0);

            $("#tbSapAssetDetail").dataTable({
                "scrollY": 200,
                "scrollX": true,
                "lengthMenu": [[100, 300, 500, -1, ], [100, 300, 500, "All"]],
            });

            $('input[type=number]').keyup(function () {
                this.value = this.value.replace(/[^0-9\.]/g, '');
            });

            $(".previous").click(function () {
                if (animating) return false;
                animating = true;

                current_fs = $(this).parent();
                previous_fs = $(this).parent().prev();

                //de-activate current step on progressbar
                $("#progressbar li").eq($("fieldset").index(current_fs)).removeClass("active");

                //show the previous fieldset
                previous_fs.show();
                //hide the current fieldset with style
                current_fs.animate({ opacity: 0 }, {
                    step: function (now, mx) {
                        //as the opacity of current_fs reduces to 0 - stored in "now"
                        //1. scale previous_fs from 80% to 100%
                        scale = 0.8 + (1 - now) * 0.2;
                        //2. take current_fs to the right(50%) - from 0%
                        left = ((1 - now) * 50) + "%";
                        //3. increase opacity of previous_fs to 1 as it moves in
                        opacity = 1 - now;
                        current_fs.css({ 'left': left });
                        previous_fs.css({ 'transform': 'scale(' + scale + ')', 'position': 'relative', 'opacity': opacity });
                    },
                    duration: 300,
                    complete: function () {
                        current_fs.hide();
                        animating = false;
                    },
                    //this comes from the custom easing plugin
                    ////easing: 'easeInOutBack'
                });
            });

        });

        function nextevntFire(crnt) {
            debugger;
            $("#span-errorMsg").text("");
            $("#assetType_error").removeClass('validationError validationBackground');
            $("#div-table").removeClass('validationBackground');
            if ($("input#rbSale")[0].checked == false && $("input#rbScrap")[0].checked == false) {
                $("#assetType_error").addClass('validationError validationBackground');
                $("#span-errorMsg").text("Please select asset type. ");
                return;
            }
            else if (TotalRowCount == 0) {
                $("#div-table").addClass('validationBackground');
                $("#span-errorMsg").text("Please select asset items. ");
                return;
            }
            if (_type == 2) {
                $('#td_sale_price').addClass('hidden');
                //change done by aumento 20042023====================================
                //$('#td_Partial_Full').removeClass('hidden');
                //===================================================================
                $('#td_condition').removeClass('hidden');
                $('#td_tentative').removeClass('hidden');
            }
            else {
                $('#td_sale_price').removeClass('hidden');
                //change done by aumento 20042023====================================
               // $('#td_Partial_Full').addClass('hidden');
               //====================================================================
                $('#td_condition').addClass('hidden');
                $('#td_tentative').addClass('hidden');
            }
            BindData(arrayList);

            if (animating) return false;
            animating = true;

            current_fs = $(crnt).parent();
            next_fs = $(crnt).parent().next();

            //activate next step on progressbar using the index of next_fs
            $("#progressbar li").eq($("fieldset").index(next_fs)).addClass("active");

            //show the next fieldset
            next_fs.show();
            //hide the current fieldset with style
            current_fs.animate({ opacity: 0 }, {
                step: function (now, mx) {
                    //as the opacity of current_fs reduces to 0 - stored in "now"
                    //1. scale current_fs down to 80%
                    scale = 1 - (1 - now) * 0.2;
                    //2. bring next_fs from the right(50%)
                    left = (now * 50) + "%";
                    //3. increase opacity of next_fs to 1 as it moves in
                    opacity = 1 - now;
                    current_fs.css({
                        'transform': 'scale(' + scale + ')',
                        'position': 'absolute'
                    });
                    next_fs.css({ 'left': left, 'opacity': opacity });
                },
                duration: 300,
                complete: function () {
                    current_fs.hide();
                    animating = false;
                },
                //this comes from the custom easing plugin
                ////easing: 'easeInOutBack'
            });
        }

        function nextBtnClick() {
            $("#span-errorMsg").text("");
            $("#assetType_error").removeClass('validationError validationBackground');
            $("#div-table").removeClass('validationBackground');
            if ($("input#rbSale")[0].checked == false && $("input#rbScrap")[0].checked == false) {
                $("#assetType_error").addClass('validationError validationBackground');
                $("#span-errorMsg").text("Please select asset type. ");
                return;
            }
            else if (TotalRowCount == 0) {
                $("#div-table").addClass('validationBackground');
                $("#span-errorMsg").text("Please select asset items. ");
                return;
            }

            var data = {
                DISPOSALHEADERID: $("#hfHeaderId").val(),
                ASSETTYPEID: $("input:radio:checked").val(),
                DisposalDetailList: arrayList,
            }
            $.ajax({
                type: "POST",
                url: "/AssetDisposal/SaveAssetDetail",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.res == 1 && data.headerId > 0) {
                        $("#hfHeaderId").val(data.headerId);
                        $(".next").click();
                    }
                    else if (data.res == 0 || data.res == -1) {
                        sweetAlert("", "Asset item not saved.", "warning");
                    }
                    else if (data.res == -2) {
                       sweetAlert("", "Asset item already processed.", "warning");
                    }
                    else if (data.res == -4) {
                        sweetAlert("", "Selected items should be of same location.", "warning");
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function GetCustomerDetail(crnt) {
            debugger;
            var data = {
                CUSTOMERCODE: $('#txtCustomerCode').val()
            }

            $.ajax({
                type: "POST",
                url: "/AssetDisposal/SAPCustomerDetailByCode",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.CUSTOMERCODE != "") {
                        $('#txtCustomerName').val(data.CUSTOMERNAME == null ? "" : data.CUSTOMERNAME);
                        $("#txtCustomerAddress").val(data.CUSTADDRESS == null ? "" : data.CUSTADDRESS);
                        $("#txtCustomerGSTIN").val(data.CUSTGSTIN == null ? "" : data.CUSTGSTIN);
                        $("#txtGST").val(data.GSTRATE == null ? "" : data.GSTRATE);
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function ChkClick(crnt) {
            debugger;

            if (crnt.checked) {
                $(crnt).closest("tr")[0].style.backgroundColor = "#f5deb3"; // $(this).closest("tr")[0].bgColor = "#f5deb3";
                AddRecord($(crnt).closest("tr")[0]);
            }
            else {
                if (TotalRowCount > 0) {
                    $(crnt).closest("tr")[0].style.backgroundColor = "";
                    DeleteItem(crnt);
                }
            }
            $('#span_count').text(TotalRowCount);
        }

        function AddRecord(row) {
            //console.log(row);

            $("#span-errorMsg").text("");
            if (arrayList == null || arrayList.length == 0) {
                arrayList = new Array;
            }

            var data = {
                //Change by aumento as on 02082023 for SR51823==================================================
                DISPOSALDETAILID: 0,
                DISPOSALHEADERID :0,
                ASSETCODE: row.cells[1].innerHTML.trim(),
                ASSETDESCRIPTION: row.cells[3].innerHTML.trim(),
                ASSETDETAIL: row.cells[4].innerHTML.trim(),
                VENDORNAME: row.cells[5].innerHTML.trim(),
                VENDORCODE: row.cells[6].innerHTML.trim(),
                INVOICENO: row.cells[7].innerHTML.trim(),
                INVOICEDATE: row.cells[8].innerHTML.trim(),
                SERIALNUMBER: row.cells[9].innerHTML.trim(),
                PONUMBER: row.cells[10].innerHTML.trim(),
                PLANTID: row.cells[12].children.hfPlantId.value,
                PLANTNAME: row.cells[12].innerText.trim(),
                CAPTALIZED_DATE: row.cells[13].innerHTML.trim(),
                ORIGINALCOST: row.cells[14].innerHTML.trim(),
                DEPRECIATIONCOST: row.cells[15].innerHTML.trim(),
                WDV: row.cells[16].innerHTML.trim(),
                SALESPRICE: 0,
                VIBRATION_SENSOR: null,
                PARTIAL_FULL: null,
                CONDITIONID: null,


                //DISPOSALDETAILID: 0,
                //DISPOSALHEADERID :0,
                //ASSETCODE: row.cells[1].innerHTML.trim(),
                //ASSETDESCRIPTION: row.cells[2].innerHTML.trim(),
                //ASSETDETAIL: row.cells[3].innerHTML.trim(),
                //VENDORNAME: row.cells[4].innerHTML.trim(),
                //VENDORCODE: row.cells[5].innerHTML.trim(),
                //INVOICENO: row.cells[6].innerHTML.trim(),
                //INVOICEDATE: row.cells[7].innerHTML.trim(),
                //SERIALNUMBER: row.cells[8].innerHTML.trim(),
                //PONUMBER: row.cells[9].innerHTML.trim(),
                //PLANTID: row.cells[10].children.hfPlantId.value,
                //PLANTNAME: row.cells[10].innerText.trim(),
                //CAPTALIZED_DATE: row.cells[11].innerHTML.trim(),
                //ORIGINALCOST: row.cells[12].innerHTML.trim(),
                //DEPRECIATIONCOST: row.cells[13].innerHTML.trim(),
                //WDV: row.cells[14].innerHTML.trim(),
                //SALESPRICE: 0,
                //VIBRATION_SENSOR: null,
                //PARTIAL_FULL: null,
                //CONDITIONID: null,
                //==================================================

            }
            TotalRowCount += 1;
            arrayList.push(data);
        }

        function DeleteItem(current) {
            arrayList = $.grep(arrayList, function (e) {
                return e.ASSETCODE != current.id;
            });
            TotalRowCount = TotalRowCount - 1;
        }

        function BindData(arrayList) {
            debugger;
            var rows = "", rowId = 0, profit_loss = 0;
            profit_loss = parseFloat(0).toFixed(2);
            if (arrayList != null) {
                if (arrayList.length > 0) {
                    $.each(arrayList, function (i, item) {
                        debugger;
                        rowId = i + 1;
                        rows += "<tr><td class='text-center'>" + item.ASSETCODE + "</td><td class='text-left'>" + item.ASSETDESCRIPTION + "</td><td class='text-left'>" + item.ASSETDETAIL + "</td><td class='text-left'>" + item.VENDORCODE + "</td>"
                        rows += "<td class='text-left'>" + item.VENDORNAME + "</td><td class='text-center'>" + item.INVOICENO + "</td><td class='text-center'>" + item.INVOICEDATE + "</td>"
                        rows += "<td class='text-center'>" + item.SERIALNUMBER + "</td><td class='text-center'>" + item.PONUMBER + "</td><td class='text-center' data-plantid='" + item.PLANTID + "'>" + item.PLANTNAME + "</td><td class='text-center'>" + item.CAPTALIZED_DATE + "</td>"
                        if (_type == 1) { /// In Case of Sale
                            //Below Added by aumento on 20042023===================================================================================================================================================
