        function UpdateSalePrice() {
            debugger;
            var rows = $('#tbSelectedAsset tbody tr')
            for (var i = 0; i < rows.length; i += 1) {
                var row = rows[i];
                if (row != undefined) {
                    var assetCode = row.cells[0].innerHTML.trim()
                    var objIndex = -1;
                    arrayList.some(function (el, i) {
                        if (el.ASSETCODE == assetCode) {
                            objIndex = i;
                            return true;
                        }
                    });
                    if (objIndex > -1) {
                        if (_type == 1) { // InCase of Sale
                            //below condition added by aumento on 22042023=====================================================================
                            arrayList[objIndex].PARTIAL_FULL = row.cells[11].firstChild.value == "" ? null : row.cells[11].firstChild.value;
                            arrayList[objIndex].ORIGINALCOST = row.cells[12].firstChild.value == "" ? null : row.cells[12].firstChild.value;
                            arrayList[objIndex].DEPRECIATIONCOST = row.cells[13].firstChild.value == "" ? null : row.cells[13].firstChild.value;
                            arrayList[objIndex].SALESPRICE = row.cells[15].firstChild.value == "" ? 0 : row.cells[15].firstChild.value;
                            //==================================================================================================================
                            //arrayList[objIndex].SALESPRICE = row.cells[14].firstChild.value == "" ? 0 : row.cells[14].firstChild.value;
                        }
                        else { // InCase of Scrap

                            arrayList[objIndex].PARTIAL_FULL = row.cells[11].firstChild.value == "" ? null : row.cells[11].firstChild.value;
                            arrayList[objIndex].ORIGINALCOST = row.cells[12].firstChild.value == "" ? null : row.cells[12].firstChild.value;
                            arrayList[objIndex].DEPRECIATIONCOST = row.cells[13].firstChild.value == "" ? null : row.cells[13].firstChild.value;
                            arrayList[objIndex].WDV = row.cells[14].innerHTML.trim() == "" ? null : row.cells[14].innerHTML.trim();
                            arrayList[objIndex].TENTATIVE = row.cells[17].firstChild.value == "" ? null : row.cells[17].firstChild.value;
                            arrayList[objIndex].CONDITIONID = row.cells[18].firstChild.value == "" ? null : row.cells[18].firstChild.value;
                        }
                        arrayList[objIndex].VIBRATION_SENSOR = row.cells[16].firstChild.value == "" ? null : row.cells[16].firstChild.value;
                        arrayList[objIndex].DISPOSALHEADERID = $("#hfHeaderId").val() == "" ? 0 : $("#hfHeaderId").val();
                    }
                }
            }
            return arrayList;
