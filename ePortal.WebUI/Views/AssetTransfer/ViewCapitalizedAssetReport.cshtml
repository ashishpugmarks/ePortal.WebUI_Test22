        function ExportToExcel() {
            if (TotalRowCount == 0) {
                $("#div-table").addClass('validationBackground');
                $("#span-errorMsg").text("Please select asset items. ");
                return;
            }
            DisposalHeader = {
                DisposalDetailList: arrayList,
            }
            $.ajax({
                type: "POST",
                url: "/AssetDisposal/ExportToExcel",
                data: JSON.stringify(DisposalHeader),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "AssetDisposal", Action = "DownloadExcel" })";
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function ExportAll() {
            window.location.href = "@Url.RouteUrl(new { Controller = "AssetDisposal", Action = "ExportAllAssetItems" })";

        }
