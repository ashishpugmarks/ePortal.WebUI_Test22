        function CalculateTotalSummary() {
            debugger;
            //alert('CalculateTotalSummary');
            var _oSum = 0.00, _dSum = 0.00, _wSum = 0.00, _sSum = 0.00, _pSum = 0.00, _tSum = 0.00;
            var _rows = $('#tbSelectedAsset tbody tr');
            //alert('_type' + _type);
            if (_type == 1) {
                //$.each(_rows, function (index, element) {
                //    _oSum += parseFloat($(element).find('td')[11].innerText);
                //    _dSum += parseFloat($(element).find('td')[12].innerText);
                //    _wSum += parseFloat($(element).find('td')[13].innerText);
                //    //change done by aumento on 20042023====================================================
                //    _sSum += parseFloat($(element).find('td')[14].innerText);
                //   // _sSum += isNaN(parseFloat($(element).find('td')[14].firstElementChild.value)) ? parseFloat(0) : parseFloat($(element).find('td')[14].firstElementChild.value);
                //    //==============================================================================================
                //    _pSum += parseFloat($(element).find('td')[15].innerText);
                //    _tSum += parseFloat(0);
                //})

                $.each(_rows, function (index, element) {
                    debugger;
                        _oSum += isNaN(parseFloat($(element).find('td')[12].firstElementChild.value)) ? parseFloat(0) : parseFloat($(element).find('td')[12].firstElementChild.value);
                        _dSum += isNaN(parseFloat($(element).find('td')[13].firstElementChild.value)) ? parseFloat(0) : parseFloat($(element).find('td')[13].firstElementChild.value);
                        // _oSum += parseFloat($(element).find('td')[12].firstElementChild.value);
                        //_dSum += parseFloat($(element).find('td')[13].firstElementChild.value);
                        _wSum += parseFloat($(element).find('td')[14].innerText);
                        //change done by aumento on 20042023====================================================
                        //_sSum += parseFloat(0);
                        _sSum += isNaN(parseFloat($(element).find('td')[15].firstElementChild.value)) ? parseFloat(0) : parseFloat($(element).find('td')[15].firstElementChild.value);
                        //_sSum += parseFloat($(element).find('td')[15].innerText);
                        // _sSum += isNaN(parseFloat($(element).find('td')[14].firstElementChild.value)) ? parseFloat(0) : parseFloat($(element).find('td')[14].firstElementChild.value);
                        //==============================================================================================
                        _pSum += parseFloat($(element).find('td')[16].innerText);
                        _tSum += parseFloat(0);

                })
            }
            else {
                $.each(_rows, function (index, element) {
                    _oSum += isNaN(parseFloat($(element).find('td')[12].firstElementChild.value)) ? parseFloat(0) : parseFloat($(element).find('td')[12].firstElementChild.value);
                    _dSum += isNaN(parseFloat($(element).find('td')[13].firstElementChild.value)) ? parseFloat(0) : parseFloat($(element).find('td')[13].firstElementChild.value);
                    _wSum += parseFloat($(element).find('td')[14].innerText);
                    _sSum += parseFloat(0); //--- In case of scrap sale value is 0;
                    _pSum += parseFloat($(element).find('td')[15].innerText);
                    _tSum += isNaN(parseFloat($(element).find('td')[17].firstElementChild.value)) ? parseFloat(0) : parseFloat($(element).find('td')[17].firstElementChild.value);
                })
            }
            var _total_row = $('#tbTotalSummary tr#row_total');
            if (_total_row.length > 0) {
                $(_total_row).find('td')[0].innerText = _oSum.toFixed(2);
                $(_total_row).find('td')[1].innerText = _dSum.toFixed(2);
                $(_total_row).find('td')[2].innerText = _wSum.toFixed(2);
                $(_total_row).find('td')[3].innerText = _sSum.toFixed(2);
                $(_total_row).find('td')[4].innerText = _pSum.toFixed(2);
                $(_total_row).find('td')[5].innerText = _tSum.toFixed(2);
                $("#txtTotalSaleValue").val(_sSum.toFixed(2));
            }
            return;
        }

