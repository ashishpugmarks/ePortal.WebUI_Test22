
@{
    ViewBag.Title = "ATOMAdd";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";
}

@section Styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <style nonce="@Context.Items["StyleNonce_0"]">
        /*table Css*/
        .table > thead > tr > th {
            padding: 6px 10px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            /*padding: 10px;*/
            padding: 5px;
            /*line-height: 1.2;*/
            line-height: 0.7;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
            border: 1px solid #8ac2de;
            align-content: center;
            font-size: 70% !important;
            /*font-size:83% !important;*/
        }

        .table-bordered {
            border: 1px solid #8ac2de;
        }

        .table > tbody > tr > td {
            /*padding: 4px 3px;*/
            /*padding: 0px 3px !important;*/
            padding: 8px 3px !important;
        }

        .table > tbody > tr:nth-of-type(even) {
            background: #e9e9e9;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .validationBackground {
            background-color: #a94442 !important;
            color: white;
        }

        .highlightBackground {
            background-color: #8bb55a !important;
            color: white;
        }
        /*basic reset*/
        * {
            margin: 0;
            padding: 0;
        }

        html {
            height: 100%;
            background: white; /* fallback for old browsers */
            background: -webkit-linear-gradient(to left, #6441A5, #2a0845); /* Chrome 10-25, Safari 5.1-6 */
        }

        body {
            font-family: montserrat, arial, verdana;
            background: transparent;
        }

        /*form styles*/
        #msform {
            text-align: center;
            position: relative;
        }

            #msform fieldset {
                background: white;
                border: 0 none;
                border-radius: 0px;
                box-shadow: 0 0 15px 1px rgba(0, 0, 0, 0.4);
                padding: 8px 0px;
                box-sizing: border-box;
                width: 100%;
                position: relative;
            }

                /*Hide all except first fieldset*/
                #msform fieldset:not(:first-of-type) {
                    display: none;
                }

        /*headings*/
        .fs-title {
            font-size: 18px;
            text-transform: uppercase;
            color: #2C3E50;
            margin-bottom: 10px;
            letter-spacing: 2px;
            font-weight: bold;
        }

        .fs-subtitle {
            font-weight: normal;
            font-size: 13px;
            color: #666;
            margin-bottom: 20px;
        }

        /*progressbar*/
        #progressbar {
            margin-bottom: 20px;
            overflow: hidden;
            /*CSS counters to number the steps*/
            counter-reset: step;
        }

            #progressbar li {
                list-style-type: none;
                color: #6080dc;
                text-transform: uppercase;
                font-size: 9px;
                font-weight: 800;
                /*width: 33.33%;*/
                width: 50%;
                float: left;
                position: relative;
                letter-spacing: 1px;
            }

                #progressbar li:before {
                    content: counter(step);
                    counter-increment: step;
                    width: 40px;
                    height: 24px;
                    line-height: 26px;
                    display: block;
                    font-size: 12px;
                    color: #333;
                    background: #ccc;
                    border-radius: 25px;
                    margin: 0 auto 6px auto;
                }

                /*progressbar connectors*/
                #progressbar li:after {
                    content: '';
                    width: 100%;
                    height: 8px;
                    background: #ccc;
                    position: absolute;
                    left: -50%;
                    top: 8px;
                    z-index: -1; /*put it behind the numbers*/
                }

                #progressbar li:first-child:after {
                    /*connector not needed before the first step*/
                    content: none;
                }

                /*marking active/completed steps green*/
                /*The number of the step and the connector before it = green*/
                #progressbar li.active:before, #progressbar li.active:after {
                    background: #6080dc;
                    color: white;
                }


        /* Not relevant to this form */
        .dme_link {
            margin-top: 30px;
            text-align: center;
        }

            .dme_link a {
                background: #FFF;
                font-weight: bold;
                color: #6080dc;
                border: 0 none;
                border-radius: 25px;
                cursor: pointer;
                padding: 5px 25px;
                font-size: 12px;
            }

                .dme_link a:hover, .dme_link a:focus {
                    background: #C5C5F1;
                    text-decoration: none;
                }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            /*background-image: url('../../assets/images/loading_double.gif');*/
            opacity: .7;
        }

        .panel-heading {
            padding: 8px 15px;
        }

        #pr_div {
            border: 1px solid #ccc;
            padding: 8px; /*15px 0px 15px 0px;*/
            margin-left: 10px;
            border-radius: 5px;
            background-color: #eee;
            overflow: auto;
            min-height: 35px;
            max-height: 92px;
            width: 73.30%;
        }

        .alert-error {
            background-color: antiquewhite;
            margin-left: 15px;
            margin-right: 15px;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .required::after {
            content: "*";
            font-weight: 800;
            color: red;
            margin-left: 5px;
        }

        .ui-widget {
            font-family: Verdana,Arial,sans-serif;
            font-size: 0.6em !important;
            overflow: auto;
            max-height: 150px;
        }
    </style>
}





<div class="panel-group" style="padding: 0px 8px 0px 8px;">
    @*<div style="height: 2.4em; width:100em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Approval Note Request Form</div>
        </div>*@
    <div class="panel panel-primary" style="height:375px;">
        <div class="panel-heading">
            <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Approval Type Operation Mapping Add</h2>
        </div>

        <div class="panel-body">
            <div style="margin-top:25px;">
                <div class="col-md-3" style="margin-left: 17px; display:flex; flex-direction:row; padding-bottom:15px">

                    <label style="padding-bottom:5px;">Approval Type</label>
                    <div class="col-md-5" style="margin-left:10px; width:190px;">
                        <select id="ddlApprovalType" class="form-control">
                            <option value="EBQ">EBQ</option>
                            <option value="NON EBQ">NON EBQ</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-3" style="display:flex; flex-direction:row; padding-bottom:15px; margin-left:17px;">
                    <label style="padding-bottom:5px">SYKI</label>
                    <div class="col-md-5" style="margin-left:80px; width:190px;">
                        <select id="SYKI" class="form-control"></select>
                        @*<input id="SYKI" name="SYKI" type="text" class="form-control mb-3" value="" autocomplete="off" />*@
                    </div>
                </div>

                <div class="col-md-3" style="display:flex; flex-direction:row; padding-bottom:15px; margin-left:17px;">
                    <label style="padding-bottom:5px">Operation ID</label>
                    <div class="col-md-5" style="margin-left:23px; width:190px;">
                        <select id="ddlOperation" class="form-control"></select>
                        @*<input id="DeignationId" name="DeignationId" type="text" class="form-control mb-3" value="" autocomplete="off" />*@
                    </div>
                </div>

                <div class="col-md-3" style="display:flex; flex-direction:row; padding-bottom:15px; margin-left:17px;">
                    <label style="padding-bottom:5px">Division ID</label>
                    <div class="col-md-5" style="margin-left:38px; width:190px;">
                        <select id="ddlDivision" class="form-control"></select>
                        @*<input id="DeignationId" name="DeignationId" type="text" class="form-control mb-3" value="" autocomplete="off" />*@
                    </div>
                </div>

                <div class="col-md-3" style="display:flex; flex-direction:row; padding-bottom:15px; margin-left:17px;">
                    <label style="padding-bottom:5px">EVP Authority</label>
                    <div class="col-md-5" style="margin-left:13px; width:190px;">
                        <input id="EVP" name="EVP" type="text" class="form-control mb-3" value="" autocomplete="off" />
                        <span id="searchTerm"></span>
                    </div>
                </div>


                <div class="col-lg-2" style="margin:10px;">
                    <button type="submit" id="btnsubmit" class="btn btn-block btn-success"><i class="menu-icon fa fa-save"></i> &nbsp; Save</button>
                </div>

            </div>
        </div>
    </div>
</div>

