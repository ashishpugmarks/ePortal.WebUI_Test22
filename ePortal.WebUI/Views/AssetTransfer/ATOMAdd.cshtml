            $('#ddlApprovalType').on('change', function () {
                var APP = $('option:selected', this).val();
                if (APP == "NON EBQ") {
                    $("#EVP").attr('disabled', true);
                }
                else {
                    $("#EVP").attr('disabled', false);
                }

            });
        });

        function Save() {
            debugger;
            var ApprovalType = $('#ddlApprovalType').val();
            var Operation = $('#ddlOperation').val() == "" ? 0 : $('#ddlOperation').val();
            var Division = $('#ddlDivision').val() == "" ? 0 : $('#ddlDivision').val();
            var EvpAuth = $('#EVP').val() == "" ? 0 : $('#EVP').val();
            var SYKIID = $('#SYKI').val() == "" ? 0 : Number($('#SYKI').val());

            if (EvpAuth != 0) {
                EvpAuth = parseInt($('#EVP').val().split("-")[0].trim())
            }


            if (ApprovalType == "") {

                return alert("Please Select Approval Type ...");
            }

            debugger;
            // var URL = '/AssetTransfer/ATOMSave/?ApproveType=' + ApprovalType + '&Operation=' + Operation + '&SYKIID=' + SYKIID + '&Division=' + Division + '&EvpAuth=' + EvpAuth;


            var Mdata = { ApproveType: ApprovalType, Operation: Operation, SYKIID: SYKIID, Division: Division, EvpAuth: EvpAuth };

            $.ajax({
                async: false,
                type: "POST",
                url: "/AssetTransfer/ATOMSave",
                // contentType: "application/json; charset=utf-8",
                contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                datatype: "json",
                //processData: false,
                // data: JSON.stringify(Mdata),
                data: Mdata,
                //data: { ApproveType: ApprovalType, Operation: Operation, SYKIID: SYKIID, Division: Division, EvpAuth: EvpAuth },
                success: function (data) {
                    debugger;

                    alert(JSON.parse(data).errorMessage);
                    parent.jQuery.fancybox.close();


                },
                error: function () {
                    debugger;
                    $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                    $("#btnUpload").attr("disabled", false);
                }
            });


        }

        $(function () {
            debugger;

            var Term = $("#EVP").val();

            $("input#EVP").autocomplete({
                // var Term = $("#txtEmpcode").val(),
                source: "/AssetTransfer/AutocompleteSuggestions",
                minLength: 2,
