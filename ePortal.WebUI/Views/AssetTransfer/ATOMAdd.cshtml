        function BindOperation() {
            debugger;
            $.ajax({
                async: false,
                type: "GET",
                url: "/AssetTransfer/GetOperationlist",

                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    debugger;
                    if (data != "[]") {

                        var Data1 = JSON.parse(data);
                        var ddlDesi = $('#ddlOperation');
                        var Data2 = Data1.resultObject.sort();
                        ddlDesi.empty();

                        $.each(Data2, function (i, r) {
                            ddlDesi.append($('<option>', {
                                value: r.Value,
                                text: r.Text
                            }));
                        });

                        ddlDesi.append($('<option>', {
                            value: 0,
                            text: "- Please select Operation -"
                        }));

                        ddlDesi.val(0);
                    }
                },
                complete: function () {
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });

        }

