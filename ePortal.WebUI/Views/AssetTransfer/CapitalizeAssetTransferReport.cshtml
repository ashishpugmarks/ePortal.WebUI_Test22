    #progressbar {
        margin-bottom: 20px;
        overflow: hidden;
        counter-reset: step;
    }

        #progressbar li {
            list-style-type: none;
            color: #6080dc;
            text-transform: uppercase;
            font-size: 9px;
            font-weight: 800;
            /*width: 33.33%;*/
            width: 50%;
            float: left;
            position: relative;
            letter-spacing: 1px;
        }

            #progressbar li:before {
                content: counter(step);
                counter-increment: step;
                width: 40px;
                height: 24px;
                line-height: 26px;
                display: block;
                font-size: 12px;
                color: #333;
                background: #ccc;
                border-radius: 25px;
                margin: 0 auto 6px auto;
            }

            #progressbar li:after {
                content: '';
                width: 100%;
                height: 8px;
                background: #ccc;
                position: absolute;
                left: -50%;
                top: 8px;
                z-index: -1; 
            }

            #progressbar li:first-child:after {
                content: none;
            }

            #progressbar li.active:before, #progressbar li.active:after {
                background: #6080dc;
                color: white;
            }


  
    .dme_link {
        margin-top: 30px;
