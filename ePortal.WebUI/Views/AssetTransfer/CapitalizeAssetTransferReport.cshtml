        padding: 8px; /*15px 0px 15px 0px;*/
        margin-left: 10px;
        border-radius: 5px;
        background-color: #eee;
        overflow: auto;
        min-height: 35px;
        max-height: 92px;
        width: 73.30%;
    }

    .alert-error {
        background-color: antiquewhite;
