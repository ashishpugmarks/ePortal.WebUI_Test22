</style>

<div class="panel-group">

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Capitalized Asset Transfer Report </h2>

        </div>

        <div class="panel-body" style="font-size:17px; padding-left:15px; padding-right:15px;">
            <div class="row" style="margin-top:25px; ">
                <div class="col-md-2" style="margin-left:15px; ">
                    <label style="padding-bottom:5px;">Transaction Type :</label>
                    <select id="ddlTranjectionType" class="form-control">
                        <option value="All"> All </option>
                        <option value="Permanent Transfer">Permanent Transfer</option>
                        <option value="Returnable Transfer">Returnable Transfer</option>
                    </select>
                </div>


                <div class="col-md-1 " style="margin-left:15px; ">
                    <label style="padding-bottom:5px; width:125px;">Request No :</label>
                    <input id="TranjactionNo" name="TranjactionNo" type="text" class="form-control mb-1" value="" autocomplete="off" />
                </div>

                <div class="col-md-2" style="margin-left:15px; ">
                    <label style="padding-bottom:5px; width:140px ">Transferee User :</label>
                    <input id="TransfereeUser" name="TransfereeUser" type="text" class="form-control" value="" autocomplete="off" />
                </div>

                <div class="col-md-2" style="margin-left:15px; ">
                    <label style="padding-bottom:5px;">Status</label>
                    <select id="ddlStatus" class="form-control">
                        <option value="Initiate" selected>Pending</option>
                        <option value="WIP">WIP</option>
                        <option value="Completed">Completed</option>
                        <option value="Rejected">Rejected</option>
                        <option value="Cancelled by User">Cancelled by User</option>
                        <option value="Cancelled by Admin">Cancelled by Admin</option>

                    </select>
                </div>

                <div class="col-md-3" style="margin-left:15px; margin-top: 20px">
                    <a title="Search" id="btnGetdata" class="btn btn-success" data-ctrl="anc-click-search"><i class="fa fa-search" aria-hidden="true"></i>&nbsp;GetData</a>
                </div>

            </div>
        </div><br />

        <div class="panel-body">
            <div id="pagination-container" class="text-center">
                <div class="form-group" style="margin-bottom: 0px;">
                    <form id="myform">
                        <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                            <thead>
                                <tr class="bg-info">
                                    <th class="text-center">Sr.No. <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Request No. <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Request Date <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Transaction Type <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Asset Type <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Transferor <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Transferee user <i class="fa fa-sort"></i></th>
                                    <th class="text-center" hidden>Total <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Status <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Action <i class="fa fa-sort"></i></th>
                                </tr>
                            </thead>
                            <tbody id="append_Data">
                                <tr><th colspan="10" class="text-center">No record found.</th></tr>
                            </tbody>
                        </table>

                    </form>

                </div>
                <ul class="pagination"></ul>
            </div>
        </div>
    </div>
</div>

<script nonce="@Context.Items["ScriptNonce_3"]">
    var preload = "";
    $(document).ready(function () {

        $("#ddlStatus").change(function () {
            var _Status = $(this).val();
            handleStatusChange(_Status, 1);
        });
        PreLoadData(1);

    });

    function handleStatusChange(_Status, currentPage) {
        _flag = "Capitalized Asset";

        preload = "handleStatusChange";

        var recordsPerPage = 50;
        var testModel = {
            Status: _Status.trim(),
            flag: _flag,

        };
        $.ajax({
            type: "POST",
            url: "/AssetTransfer/CapitalizeAssetTransferReportStatusSearch",
            // contentType: "application/json; charset=utf-8",
               contentType: "application/x-www-form-urlencoded; charset=UTF-8",
            dataType: "json",
            // data: JSON.stringify(testModel),
            data: testModel,
            success: function (data) {
                if (JSON.parse(data).length !== 0) {
                    var Data1 = JSON.parse(data);

                    var startIndex = (currentPage - 1) * recordsPerPage;
                    var endIndex = startIndex + recordsPerPage;

                    var currentPageData = Data1.slice(startIndex, endIndex);
                    $("#append_Data").empty();
                    $.each(currentPageData, function (i, r) {
                        var idAssetType = r.TRAN_NO + "_type";
                        $("#append_Data").append('<tr><td><center>' + r.SRNO + '</center></td><td><center>' + r.TRAN_NO + '</center></td><td><center>' + parseJsonDate(r.TRAN_DATE) + '</center></td><td><center>' + r.TRAN_TYPE + '</center></td><td id=' + idAssetType + '><center>' + r.ASSET_TYPE + '</center></td><td><center>' + r.TRANSFEROR + '</center></td><td><center>' + r.TRANSFREE + '</center></td><td hidden><center>' + r.TOTAL + '</center></td><td><center>' + r.STATUS + '</center></td><td><center>' + EditorFormatter( r.TRAN_NO) + '</td></tr>');

                    });
                    updatePagination(currentPage, Math.ceil(Data1.length / recordsPerPage), preload, _Status);
                } else {
                    $("#append_Data").empty();
                    $("#append_Data").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>");
                }
            },
            error: function (xhr, textStatus, errorThrown) {
                console.error("Error:", errorThrown);
                alert("Oops... Something went wrong!");
            }
        });
    }

    function PreLoadData(currentPage) {
        _flag = "Capitalized Asset";
        preload = "PreLoadData";
        var recordsPerPage = 50;
        $.ajax({
            async: false,
            type: "GET",
            url: "/AssetTransfer/GetCapitalizeAssetTransferReportList",
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            data: { flag: _flag },
            success: function (data) {

                if (JSON.parse(data).length != 0) {

                    var Data1 = JSON.parse(data);
                    var startIndex = (currentPage - 1) * recordsPerPage;
                    var endIndex = startIndex + recordsPerPage;

                    var currentPageData = Data1.slice(startIndex, endIndex);

                    $("#append_Data").empty();
                    $.each(currentPageData, function (i, r) {
                        $("#append_Data").append('<tr><td><center>' + r.SRNO + '</center></td><td><center>' + r.TRAN_NO + '</center></td><td><center>' + parseJsonDate(r.TRAN_DATE) + '</center></td><td><center>' + r.TRAN_TYPE + '</center></td><td><center>' + r.ASSET_TYPE + '</center></td><td><center>' + r.TRANSFEROR + '</center></td><td><center>' + r.TRANSFREE + '</center></td><td hidden><center>' + r.TOTAL + '</center></td><td><center>' + r.STATUS + '</center></td><td><center>' + EditorFormatter(r.TRAN_NO) + '</td></tr>');

                    });

                    updatePagination(currentPage, Math.ceil(Data1.length / recordsPerPage), preload);
                }
                else {
                    $("#append_Data").empty();
                    $("#append_Data").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>")
                }
            },
            complete: function () {
            },
            error: function () {
                alert("Oops...", "Something went wrong!");
            }
        });

    }

    function updatePagination(currentPage, totalPages, preload, _Status) {
        var container = $('#pagination-container .pagination');

        container.empty();

        for (var i = 1; i <= totalPages; i++) {
            var listItem = $('<li></li>').addClass('page-item').append(
                $('<a></a>').addClass('page-link').attr({
                    href: 'javascript:void(0);',
                    'data-page': i
                }).text(i)
            );

            if (i === currentPage) {
                listItem.addClass('active');
            }

            listItem.on('click', function () {
                var page = parseInt($(this).find('a').attr('data-page'));
                if (preload == "PreLoadData") {
                    PreLoadData(page);
                }
                else if (preload == "handleStatusChange") {
                    handleStatusChange(_Status, page);
                }
                else {
                    SearchData(page, _Status)
                }

            });

            container.append(listItem);
        }
    }

    function SearchData(currentPage) {
        var recordsPerPage = 50;

        preload = "SearchData";
        _flag = "Capitalized Asset";
        var _Transaction_type = ($('#ddlTranjectionType').val() == "" ?
            "" : $("#ddlTranjectionType option:selected").text());

        var _TransactionNo = ($('#TranjactionNo').val() == 0 ?
            0 : $("#TranjactionNo").val());

        var _TransfereeUser = ($('#TransfereeUser').val() == "" ?
            "0" : $("#TransfereeUser").val());

        var _Status = ($('#ddlStatus').val() == "" ?
            "" : $("#ddlStatus option:selected").val());

        var testModel = {

            TranjectionType: _Transaction_type.trim(),
            // AssetType: _Asset_Type.trim(),
            TranjectionNo: _TransactionNo,
            TransfereeUser: _TransfereeUser,
            Status: _Status.trim(),
            flag: _flag
        };


        $.ajax({
            async: false,
            type: "Post",
            url: "/AssetTransfer/CapitalizeAssetTransferReportListSearch",
              contentType: "application/x-www-form-urlencoded; charset=UTF-8",
            datatype: "json",
            data: testModel,
            success: function (data) {

                if (JSON.parse(data).length != 0) {

                    var Data1 = JSON.parse(data);
                    var startIndex = (currentPage - 1) * recordsPerPage;
                    var endIndex = startIndex + recordsPerPage;

                    // Slice the data array to get only the records for the current page
                    var currentPageData = Data1.slice(startIndex, endIndex);

                    $("#append_Data").empty();
                    $.each(currentPageData, function (i, r) {
                        var idAssetType = r.TRAN_NO + "_type";

                        $("#append_Data").append('<tr><td><center>' + (i + 1) + '</center></td><td><center>' + r.TRAN_NO + '</center></td><td><center>' + parseJsonDate(r.TRAN_DATE) + '</center></td><td><center>' + r.TRAN_TYPE + '</center></td><td id=' + idAssetType + '><center>' + r.ASSET_TYPE + '</center></td><td><center>' + r.TRANSFEROR + '</center></td><td><center>' + r.TRANSFREE + '</center></td><td hidden><center>' + r.TOTAL + '</center></td><td><center>' + r.STATUS + '</center></td><td><center>' + EditorFormatter(r.TRAN_NO) + '</td></tr>');

                    });
                    updatePagination(currentPage, Math.ceil(Data1.length / recordsPerPage), preload, _Status);
                }
                else {
                    $("#append_Data").empty();
                    $("#append_Data").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>")
                }
            },
            complete: function () {
            },
            error: function () {
                alert("Oops...", "Something went wrong!");
            }
        });
    }

    function parseJsonDate(jsonDateString) {
        const dateString = jsonDateString;
        const dateNumber = dateString.match(/\d+/)[0];
        const date = new Date(jsonDateString);
        const options = {
            month: 'short',
            day: 'numeric',
            year: 'numeric'
        };
        const formattedDate = date.toLocaleDateString('en-IN', options);
        return formattedDate;
    }


    function EditorFormatter(TRANNO) {
        return '<center> <a title="History" class="btn btn-primary btn-xs" data-ctrl="anc-click-history" data-tranno="' + TRANNO + '"><i class="fa fa-history"></i></a> </center>';
    }


    function History(TRANNO) {
        var URL = '/AssetTransfer/GetAppAuthLogHistory/?TranNo=' + TRANNO;
        $.fancybox.open({

            href: URL,
            type: 'iframe',
            padding: 2,
            maxWidth: 1200,
            maxHeight: 1200,
            fitToView: false,
            width: '1200px',
            height: '1200px',
            autoSize: true,
            closeClick: true,
            openEffect: 'elastic',
            openSpeed: 120,
            closeEffect: 'elastic',
            closeSpeed: 100,
            helpers:
            {
                overlay: { closeClick: false }
            },
            afterClose: function () {

                window.location.reload();
            }

        });
    }

    
</script>

@* CSP 3.0 Compliant changes *@
<script nonce="@Context.Items["ScriptNonce_4"]">
    $(document).ready(function () {
        $(document).off("click", "[data-ctrl='anc-click-search']");
        $(document).on('click', '[data-ctrl="anc-click-search"]', function () {
            return SearchData(1);
        });

        $(document).off("click", "[data-ctrl='anc-click-add']");
        $(document).on('click', '[data-ctrl="anc-click-add"]', function () {
            return ADD();
        });


        $(document).off("click", "[data-ctrl='anc-click-edit']");
        $(document).on('click', '[data-ctrl="anc-click-edit"]', function () {
            var srno = $(this).data('srno');
            var appauthsrno = $(this).data('appauthsrno');
            Edit(srno, appauthsrno);
        });


        $(document).off("click", "[data-ctrl='anc-click-history']");
        $(document).on('click', '[data-ctrl="anc-click-history"]', function () {
            var tranno = $(this).data('tranno');
            History(tranno);
        });
    });
</script>
