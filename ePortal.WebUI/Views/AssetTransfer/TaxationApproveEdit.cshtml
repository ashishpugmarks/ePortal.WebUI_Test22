@section Styles{
    <style nonce="@Context.Items["StyleNonce_0"]">
        .container {
            width: 100% !important;
            overflow: auto !important;
        }

        /*table Css*/
        .table > thead > tr > th {
            padding: 6px 10px;
        }

        .inline-form {
            display: inline;
            margin-left: 1245px;
        }


        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            padding: 10px;
