                    }
                });
                //propertyName === 'QTY'||propertyName==='BASIC_PRICE'||propertyName==='INVOICE_VALUE'||
                data.push(rowData);
            });

            return data;
        }

        function UpdateApproval() {
            debugger;
            var AssetType ="@Model.ASSET_TYPE";
            var _Status = ($('#ddlstatus').val() == "" ?
           "" : $("#ddlstatus option:selected").text());
            if(_Status=="- Select -")
            {
                alert("Please Select  Approval Status...");
                return $('#ddlstatus').focus();
            }
            var dt="";
            if(AssetType==="Capitalized Asset"){
                dt = tableToJson($("#DtData"));
            }
            else{
                dt = tableToJson_Non($("#DtData_non"));
            }

            debugger;
            var columnCount = Object.keys(dt[0]).length;
            var assetcode;

            for (var i = 0; i < dt.length; i++) {
                debugger;
                for (var j = 0; j < columnCount; j++) {
                    var columnName = Object.keys(dt[i])[j];
                    debugger;
                    if(columnName === "ASSET_CODE"){
                        assetcode = dt[i][columnName];
                    }

                    if (columnName === "EODC_CLEAREANSE") {
                        debugger;
                        if (dt[i][columnName] == "" || dt[i][columnName] === null) {
                            if(AssetType==="Capitalized Asset"){
                                alert(" EODCCleareance is blank against this Asset Code : "+" - "+assetcode);
                            }
                            else{
                                alert("EODC Cleareance is blank against this Auc Code : "+" - "+assetcode);
                            }
                            // $('#DtData input[name="LICENSE_NO."]').eq(i).focus();
                            return;
                        }
                    }
                }
            }


            var _Tranno = ($('#TransactionNo').val());
            var _remarks = ($('#Remarks').val());

            if((_Status=="Sent Back" || _Status=="Rejected") && _remarks == "")
            {
                alert("Please Enter Remarks...");
                return $('#Remarks').focus();
            }
            var URL = '/AssetTransfer/UpdateApproval';
            $("#btnsubmit").attr("disabled", true);
            debugger;
            $.ajax({
                type: "POST",
                url: URL,
                data: { Remarks: _remarks, TranNo: _Tranno, Status: _Status,Details: dt },
                datatype: "json",
                // contentType: "application/json; charset=utf-8",
                // processData: false,
                success: function (data) {
                    $("#btnsubmit").attr("disabled", false);
                    debugger;
                    var processedData = data.processedData;
                    parent.jQuery.fancybox.close();
                    alert("This Record has been "+_Status);

                    document.location = '/AssetTransfer/Taxationapprove';
                },
                complete: function () {
                    $("#btnsubmit").attr("disabled", false);
                },
                error: function () {
                    $("#btnsubmit").attr("disabled", false);
                    alert("Oops...", "Something went wrong!");
                }
            });

        }

        function Cancel() {
            debugger;
            document.location = '/AssetTransfer/Taxationapprove';
        }


</script>

