@model ePortal.DomainClasses.AT_APPROVAL_AUTHORITY
@{
    ViewBag.Title = "AuthorityUpdate";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";
}
@section Styles{
<link href="~/css/jquery-ui.css" rel="stylesheet" />
<style nonce="@Context.Items["StyleNonce_0"]">
    /*table Css*/
    .table > thead > tr > th {
        padding: 6px 10px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        /*padding: 10px;*/
        padding: 5px;
        /*line-height: 1.2;*/
        line-height: 0.7;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
        border: 1px solid #8ac2de;
        align-content: center;
        font-size: 70% !important;
        /*font-size:83% !important;*/
    }

    .table-bordered {
        border: 1px solid #8ac2de;
    }

    .table > tbody > tr > td {
        /*padding: 4px 3px;*/
        /*padding: 0px 3px !important;*/
        padding: 8px 3px !important;
    }

    .table > tbody > tr:nth-of-type(even) {
        background: #e9e9e9;
    }

    .validationError {
        border: 1px solid #a94442 !important;
    }

    .validationBackground {
        background-color: #a94442 !important;
        color: white;
    }

    .highlightBackground {
        background-color: #8bb55a !important;
        color: white;
    }
    /*basic reset*/
    * {
        margin: 0;
        padding: 0;
    }

    html {
        height: 100%;
        background: white; /* fallback for old browsers */
        background: -webkit-linear-gradient(to left, #6441A5, #2a0845); /* Chrome 10-25, Safari 5.1-6 */
    }

    body {
        font-family: montserrat, arial, verdana;
        background: transparent;
    }

    /*form styles*/
    #msform {
        text-align: center;
        position: relative;
    }

        #msform fieldset {
            background: white;
            border: 0 none;
            border-radius: 0px;
            box-shadow: 0 0 15px 1px rgba(0, 0, 0, 0.4);
            padding: 8px 0px;
            box-sizing: border-box;
            width: 100%;
            position: relative;
        }

            /*Hide all except first fieldset*/
            #msform fieldset:not(:first-of-type) {
                display: none;
            }

    /*headings*/
    .fs-title {
        font-size: 18px;
        text-transform: uppercase;
        color: #2C3E50;
        margin-bottom: 10px;
        letter-spacing: 2px;
        font-weight: bold;
    }

    .fs-subtitle {
        font-weight: normal;
        font-size: 13px;
        color: #666;
        margin-bottom: 20px;
    }

    /*progressbar*/
    #progressbar {
        margin-bottom: 20px;
        overflow: hidden;
        /*CSS counters to number the steps*/
        counter-reset: step;
    }

        #progressbar li {
            list-style-type: none;
            color: #6080dc;
            text-transform: uppercase;
            font-size: 9px;
            font-weight: 800;
            /*width: 33.33%;*/
            width: 50%;
            float: left;
            position: relative;
            letter-spacing: 1px;
        }

            #progressbar li:before {
                content: counter(step);
                counter-increment: step;
                width: 40px;
                height: 24px;
                line-height: 26px;
                display: block;
                font-size: 12px;
                color: #333;
                background: #ccc;
                border-radius: 25px;
                margin: 0 auto 6px auto;
            }

            /*progressbar connectors*/
            #progressbar li:after {
                content: '';
                width: 100%;
                height: 8px;
                background: #ccc;
                position: absolute;
                left: -50%;
                top: 8px;
                z-index: -1; /*put it behind the numbers*/
            }

            #progressbar li:first-child:after {
                /*connector not needed before the first step*/
                content: none;
            }

            /*marking active/completed steps green*/
            /*The number of the step and the connector before it = green*/
            #progressbar li.active:before, #progressbar li.active:after {
                background: #6080dc;
                color: white;
            }


    /* Not relevant to this form */
    .dme_link {
        margin-top: 30px;
        text-align: center;
    }

        .dme_link a {
            background: #FFF;
            font-weight: bold;
            color: #6080dc;
            border: 0 none;
            border-radius: 25px;
            cursor: pointer;
            padding: 5px 25px;
            font-size: 12px;
        }

            .dme_link a:hover, .dme_link a:focus {
                background: #C5C5F1;
                text-decoration: none;
            }

    .loader {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
        /*background-image: url('../../assets/images/loading_double.gif');*/
        opacity: .7;
    }

    .panel-heading {
        padding: 8px 15px;
    }

    #pr_div {
        border: 1px solid #ccc;
        padding: 8px; /*15px 0px 15px 0px;*/
        margin-left: 10px;
        border-radius: 5px;
        background-color: #eee;
        overflow: auto;
        min-height: 35px;
        max-height: 92px;
        width: 73.30%;
    }

    .alert-error {
        background-color: antiquewhite;
        margin-left: 15px;
        margin-right: 15px;
    }

    .div_disable {
        pointer-events: none;
        opacity: 0.9;
        background: #eee;
        color: black;
    }

    .required::after {
        content: "*";
        font-weight: 800;
        color: red;
        margin-left: 5px;
    }

    .ui-widget {
        font-family: Verdana,Arial,sans-serif;
        font-size: 0.6em !important;
        overflow: auto;
        max-height: 150px;
    }
</style>
}





<div class="panel-group" style="padding: 0px 8px 0px 8px;">
    @*<div style="height: 2.4em; width:100em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">Approval Note Request Form</div>
    </div>*@
    <div class="panel panel-primary" style="height:220px;">
        <div class="panel-heading">
            <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Authority Edit</h2>
        </div>

        <div class="panel-body">
            <div style="margin-top:25px;">

                <div class="col-md-3" style="display:flex; flex-direction:row; padding-bottom:15px; margin-left:17px;">
                    <label style="padding-bottom:5px">Emp Code</label>
                    <div class="col-md-5" style="margin-left:13px;">
                        <input id="EmpCode" name="EmpCode" type="text" class="form-control mb-3" value="@Model.EMP_CODE" autocomplete="off" />
                        <span id="searchTerm"></span>
                    </div>
                </div>

                <div class="col-md-3" style="display:flex; flex-direction:row; padding-bottom:15px; margin-left:17px;">
                    <label style="padding-bottom:5px">Emp Name</label>
                    <div class="col-md-5" style="margin-left:8px;">
                        <input id="EmpName" name="EmpName" type="text" disabled class="form-control mb-3" value="@Model.EMP_NAME" autocomplete="off" />

                    </div>
                </div>


                <div class="col-lg-2" style="margin:10px;">
                    <button type="submit" id="btnsubmit" class="btn btn-block btn-success"><i class="menu-icon fa fa-save"></i> &nbsp; Update</button>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts{
@*
<script src="~/Scripts/jquery-1.10.2.min.js"></script>*@
<script src="~/js/jquery-ui.js"></script>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

    $(document).ready(function () {


    });

    function Save() {
        debugger;
        var Empcode = $('#EmpCode').val();
        var EmpName = $('#EmpName').val();
        var srno = @Model.SRNO;
        var Department = "@Model.DEPARTMENT";

        debugger;
        // var URL = '/AssetTransfer/ATOMSave/?ApproveType=' + ApprovalType + '&Operation=' + Operation + '&SYKIID=' + SYKIID + '&Division=' + Division + '&EvpAuth=' + EvpAuth;


        var Mdata = { Empcode: Empcode, EmpName: EmpName, srno: srno, Department: Department };

        $.ajax({
            async: false,
            type: "POST",
            url: "/AssetTransfer/AuthoritySave",
            //contentType: "application/json; charset=utf-8",
            datatype: "json",
            //processData: false,
            //data: JSON.stringify(Mdata),
            data: Mdata,
            //data: { ApproveType: ApprovalType, Operation: Operation, SYKIID: SYKIID, Division: Division, EvpAuth: EvpAuth },
            success: function (data) {
                debugger;

                alert(JSON.parse(data).errorMessage);
                parent.jQuery.fancybox.close();


            },
            error: function () {
                debugger;
                $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                $("#btnUpload").attr("disabled", false);
            }
        });


    }

    $(function () {
        debugger;

        var Term = $("#EmpCode").val();
        var empcode;
        var empname;

        $("input#EmpCode").autocomplete({
            // var Term = $("#txtEmpcode").val(),
            source: "/AssetTransfer/AutocompleteSuggestions",
            minLength: 2,
            select: function (event, ui) {
                debugger;
                if (ui.item) {
                    //$("#searchTerm").val(ui.item.value);
                    var emp = ui.item.value.split("-");
                    debugger;
                    empcode = parseInt(emp[0]);
                    empname = (emp[1]);
                    $('#EmpCode').val(empcode);
                    $('#EmpName').val(empname);
                }
                return false;
            }
        });
    });
</script>

@* CSP 3.0 Compliant changes *@
<script nonce="@Context.Items["ScriptNonce_4"]">
    $(document).ready(function () {
        $('#btnsubmit').on('click', function () {
            Save();
        });
    });
</script>
}


