    function Upload()
    {
        $("#btnUpload").attr("disabled", true);

        var fileUpload = $("#File").get(0);
        var files = fileUpload.files;
        var _TranNo = ($('#TransactionNo').val());

        if (files.length !== 0) {
            if (window.FormData !== undefined) {
                var fileData = new FormData();

                var Type = "AT_GETOUT_DOC";
                var URL = '/AssetTransfer/UploadFiles/?Type=' + Type + '&TranNo=' + _TranNo;

                for (var i = 0; i < files.length; i++) {
                    fileData.append(files[i].name, files[i]);
                }

                $.ajax({
                    url: URL,
                    type: "POST",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    contentType: false,
                    processData: false,
                    data: fileData,
                    success: function (result) {

                        fileName = result;
                        $("#File").val("");
                        fileName = "";
                        alert("Document uploaded successfully, Request forwarded to next level authority");
                        document.location = '/AssetTransfer/CapitalizeList';
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function (err) {
                        alert(err.statusText);
                    }
                });
            }
        }
    }

    function FormateDate(value)
    {

        var date_ = parseJsonDate(value);
        return setDatepickerValue(date_);

    }

    function setDatepickerValue(dateString) {

        var parts = dateString.split(' ');
        var day = parseInt(parts[0]);
        var month = parts[1];
        var year = parseInt(parts[2]);
        var monthIndex = {
            'Jan': 0,
            'Feb': 1,
            'Mar': 2,
            'Apr': 3,
            'May': 4,
            'Jun': 5,
            'Jul': 6,
            'Aug': 7,
            'Sept': 8,
            'Oct': 9,
            'Nov': 10,
            'Dec': 11
        }[month];
        var date = new Date(year, monthIndex, day + 1);

        var formattedDate = date.toISOString().split('T')[0]; // Extracting yyyy-mm-dd from ISO string
        return formattedDate.toString();
    }

