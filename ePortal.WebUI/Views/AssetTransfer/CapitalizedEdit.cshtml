    function tableToJsonview(table) {
        var data = [];

        var headers = $(table).find('thead th').map(function () {
            return $(this).text().trim();
        }).get();
        $(table).find('tbody tr').each(function () {
            var rowData = {};
            $(this).find('td').each(function (cellIndex) {

                var header = headers[cellIndex];
                var value = $(this).text().trim();

                var propertyName = mapHeaderToProperty(header);

                if (propertyName === 'PO_DATE' || propertyName === 'INV_DATE' || propertyName === 'CAPITALIZED_DATE' || propertyName === 'LICENSE_DATE') {

                    rowData[propertyName] = new Date(value);
                } else if (propertyName === 'SRNO' || propertyName === 'LICENSE_NO' || propertyName === 'HSN_CODE') {
                    //propertyName === 'QTY' || propertyName === 'ORIGINAL_COST' || propertyName === 'DEPRECIATION' || propertyName === 'NET_BLOCK' ||
                    rowData[propertyName] = parseInt(value);
                }


                else {
                    rowData[propertyName] = value;
                }
            });

            data.push(rowData);
        });

        return data;
    }

