    function GetDate(dateStr) {
    //Exception handled by TTL on 19-Apr-2025 against SR96951 > CR6120, due to this, further data was not binding on document ready event
    try {
        var components = dateStr.split(' ');
        var delimeter = components[0].includes("/") ? "/" : "-";
        var dateComponents = components[0].split(delimeter);
        if(delimeter=="/"){
                var month = dateComponents[0].length == 1 ? "0" + dateComponents[0] : dateComponents[0];
                var day = dateComponents[1].length == 1 ? "0" + dateComponents[1] : dateComponents[1];
                var year = dateComponents[2];
                var formattedDate = year + '-' + month + '-' + day;
                return formattedDate;
        }else{
                var day = dateComponents[0].length == 1 ? "0" + dateComponents[0] : dateComponents[0];
                var month = dateComponents[1].length == 1 ? "0" + dateComponents[1] : dateComponents[1];
                var year = dateComponents[2];
                var formattedDate = year + '-' + month + '-' + day;
                return formattedDate;
        }
        
    }
    catch (e) {
        try {
            return moment(dateStr, 'DD-MMM-YY hh:mm:ss A').format('YYYY-MM-DD');
        }
        catch (f) {
            return "";
        }
