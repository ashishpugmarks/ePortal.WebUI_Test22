<div id="ajaxLoader"></div>
@section Scripts{
    <script nonce="@Context.Items["ScriptNonce_3"]">
        var preload = "";
        $(document).ready(function () {

            const currentDate = new Date();
            const firstDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
            const lastDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);

            $("#FromDate").val(formatDateForSeach(firstDayOfMonth));
            $("#ToDate").val(formatDateForSeach(lastDayOfMonth));
            GetPlant();
        });


        function Exporttoexcel() {

            var _Transaction_type = ($('#ddlTranjectionType').val() == "" ?
                "" : $("#ddlTranjectionType option:selected").val());

            var _AssetType = ($('#ddlAssetType').val() == "" ?
                "" : $("#ddlAssetType option:selected").val());

            var _Plant = ($('#ddlPlantCode').val() == "" ?
                "" : $("#ddlPlantCode option:selected").text());

            var _FromDate = $('#FromDate').val();

            var _ToDate = $('#ToDate').val();

            var testModel = {

                TransectionType: _Transaction_type.trim(),
                AssetType: _AssetType,
                FromDate: _FromDate,
                ToDate: _ToDate,
                Plant: _Plant
            };



            //   window.location.href = "/AssetTransfer/ReportMISExcel/?TransectionType=" + _Transaction_type.trim() + "&AssetType=" + _AssetType + "&FromDate=" + _FromDate + "&ToDate=" + _ToDate + "&Plant=" + _Plant;
            $.ajax({
                url: '/AssetTransfer/ReportMISExcel',
                method: 'GET',
                 beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: {
                    TransectionType: _Transaction_type.trim(),
                    AssetType: _AssetType,
                    FromDate: _FromDate,
                    ToDate: _ToDate,
                    Plant: _Plant
                },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (response) {
                    debugger;
                    //var fullFilePath = "../../Uploads/AT/MISReport/" + response;

                    var fullFilePath = "../../Uploads/AT/MISReport/MISReport.xlsx";

                    var link = document.createElement("a");
                    link.href = fullFilePath;
                    link.download = response;
                    link.click();

                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },

                error: function (xhr, status, error) {
                    // Handle errors
                    console.error('AJAX error:', status, error);
                    $("#ajaxLoader").removeClass('loader');
                }
            });
        }


        function updatePagination(currentPage, totalPages) {
            debugger;
            var container = $('#pagination-container .pagination');

            container.empty();

            for (var i = 1; i <= totalPages; i++) {
                var listItem = $('<li></li>').addClass('page-item').append(
                    $('<a></a>').addClass('page-link').attr({
                        href: 'javascript:void(0);',
                        'data-page': i
                    }).text(i)
                );

                if (i === currentPage) {
                    listItem.addClass('active');
                }

                listItem.on('click', function () {
                    var page = parseInt($(this).find('a').attr('data-page'));

                    SearchData(page)

                });

                container.append(listItem);
            }
        }

        function formatDateForSeach(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            //return `${month}-${day}-${year}`;
            return `${year}-${month}-${day}`;
        }

        function formatDate(inputDateString) {
            const inputDate = new Date(inputDateString);

            const day = inputDate.getDate();
            const month = inputDate.toLocaleString('default', { month: 'short' });
            const year = inputDate.getFullYear();

            return `${day}-${month}-${year}`;
        }

        function SearchData(currentPage) {
            debugger;
            var recordsPerPage = 150;

            preload = "SearchData";
            //_flag = "Capitalized Asset";

            var _Transaction_type = ($('#ddlTranjectionType').val() == "" ?
                "" : $("#ddlTranjectionType option:selected").val());

            var _AssetType = ($('#ddlAssetType').val() == "" ?
                "" : $("#ddlAssetType option:selected").val());

            var _Plant = ($('#ddlPlantCode').val() == "" ?
                "" : $("#ddlPlantCode option:selected").text());

            var _FromDate = $('#FromDate').val();

            var _ToDate = $('#ToDate').val();

            var testModel = {

                TransectionType: _Transaction_type.trim(),
                AssetType: _AssetType,
                FromDate: _FromDate,
                ToDate: _ToDate,
                Plant: _Plant
            };

            debugger;

            $.ajax({
                async: false,
                type: "GET",
                url: "/AssetTransfer/MISReportSearch",
                // url :url,
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                //data: JSON.stringify(testModel),
                data: { TransectionType: _Transaction_type, AssetType: _AssetType, FromDate: _FromDate, ToDate: _ToDate, Plant: _Plant, page: currentPage },
                success: function (data) {

                    $("#append_Data").empty();
                    $("#append_Data").append('<tr><th colspan="34" class="text-center">No record found.</th></tr>');

                    if (data.error == "No data found") {
                        alert("Record is not found..");
                        return;
                    }
                    //page:currentPage, pageSize:recordsPerPage
                    if (JSON.parse(data).length != 0) {
                        debugger;
                        var Data1 = JSON.parse(data);
                        //var startIndex = (currentPage - 1) * recordsPerPage;
                        //var endIndex = startIndex + recordsPerPage;

                        //Slice the data array to get only the records for the current page
                        //var currentPageData = Data1.slice(startIndex, endIndex);

                        var pagedata = Data1.Pagedata;
                        var Total = Data1.TotalPages;
                        $("#append_Data").empty();
                        debugger;
                        $.each(pagedata, function (i, r) {
                            debugger;
                            $("#append_Data").append('<tr><td><center>' + (i + 1) + '</center></td><td><center>' + r.Plant + '</center></td>' +
                                '<td class="text-center">' + r.TRAN_NO + '</center></td><td><center>' + parseJsonDate(r.TRAN_DATE) + '</center></td>' +
                                '<td><center>' + r.TRAN_TYPE + '</center></td><td><center>' + r.ASSET_TYPE + '</center></td>' +
                                '<td><center>' + r.TRANSFREE_TYPE + '</center></td><td><center>' + r.TRANSFEROR + '</center></td>' +
                                '<td><center>' + (r.OPERATION == null ? "" : r.OPERATION) + '</center></td><td><center>' + (r.DIVISION == null ? "" : r.DIVISION) + '</center></td>' +
                                '<td><center>' + (r.DEPARTMENT == null ? "" : r.DEPARTMENT) + '</center></td><td><center>' + (r.TRANSFREE == null ? "" : r.TRANSFREE) + '</center></td>' +
                                '<td><center>' + (r.ASSET_CODE == null ? "" : r.ASSET_CODE) + '</center></td><td><center>' + (r.ASSET_CLS_DESC == null ? "" : r.ASSET_CLS_DESC) + '</center></td>' +
                                '<td><center>' + (r.DESCRIPTION == null ? "" : r.DESCRIPTION) + '</center></td><td><center>' + (r.ASSETMAIN_NO_TEXT == null ? "" : r.ASSETMAIN_NO_TEXT) + '</center></td>' +
                                '<td><center>' + (r.VENDOR_CODE == null ? "" : r.VENDOR_CODE) + '</center></td><td><center>' + (r.VENDER_NAME == null ? "" : r.VENDER_NAME) + '</center></td>' +
                                '<td><center>' + (r.PO_NO == null ? "" : r.PO_NO) + '</center></td><td><center>' + (r.PO_DATE == null ? "" : parseJsonDate(r.PO_DATE)) + '</center></td>' +
                                '<td><center>' + (r.INV_NO == null ? "" : r.INV_NO) + '</center></td><td><center>' + (r.INV_DATE == null ? "" : parseJsonDate(r.INV_DATE)) + '</center></td>' +
                                '<td><center>' + (r.FULLY_PARTIAL == null ? "" : r.FULLY_PARTIAL) + '</center></td><td class="text-right">' + r.QTY + '</td>' +
                                '<td><center>' + (r.CURRENT_LOCATION == null ? "" : r.CURRENT_LOCATION) + '</center></td><td><center>' + (r.NEW_LOCATION == null ? "" : r.NEW_LOCATION) + '</center></td>' +
                                '<td class="text-right">' + r.ORIGINAL_COST + '</td><td class="text-right">' + (r.DEPRECIATION == null ? "" : r.DEPRECIATION) + '</td>' +
                                '<td class="text-right">' + r.NET_BLOCK + '</td><td class="text-right">' + r.BASIC_PRICE + '</td>' +
                                '<td class="text-right">' + r.INVOICE_VALUE + '</td><td><center>' + (r.NEW_ASSET_CODE == null ? "" : r.NEW_ASSET_CODE) + '</center></td><td><center>' + (r.EODC_CLEAREANSE == null ? "" : r.EODC_CLEAREANSE) + '</center></td>' +
                                '<td class="text-center">' + r.STATUS + '</td></tr>');

                        });
                        //updatePagination(currentPage, Math.ceil(Data1.length / recordsPerPage));
                        updatePagination(currentPage, Total);
                    }
                    else {
                        $("#append_Data").empty();
                        $("#append_Data").append("<tr><td colspan='34' class='text-center'>No record found.</td></tr>")
                    }
                },
                complete: function () {
                },
                error: function () {
                    alert("Oops...", "Something went wrong!");
                }
            });
        }

        function FormateDate(value) {

            var date_ = parseJsonDate(value);

            return setDatepickerValue(date_);

        }

        function setDatepickerValue(dateString) {

            var parts = dateString.split(' ');
            var day = parseInt(parts[0]);
            var month = parts[1];
            var year = parseInt(parts[2]);
            var monthIndex = {
                'Jan': 0,
                'Feb': 1,
                'Mar': 2,
                'Apr': 3,
                'May': 4,
                'Jun': 5,
                'Jul': 6,
                'Aug': 7,
                'Sept': 8,
                'Oct': 9,
                'Nov': 10,
                'Dec': 11
            }[month];
            var date = new Date(year, monthIndex, day + 1);

            var formattedDate = date.toISOString().split('T')[0]; // Extracting yyyy-mm-dd from ISO string
            return formattedDate.toString();
        }

        function parseJsonDate(jsonDateString) {
            debugger;
            const dateString = jsonDateString;
            const dateNumber = dateString.match(/\d+/)[0];
            // const date = new Date(+dateNumber);
            const date = new Date(jsonDateString);
            const options = {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
            };
            const formattedDate = date.toLocaleDateString('en-IN', options);
            return formattedDate;
        }


        function GetPlant() {
            debugger;
            $.ajax({
                async: false,
                type: "GET",
                url: "/AssetTransfer/GetPlanForMISReport",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    debugger;
                    if (data != "[]") {

                        var Data1 = JSON.parse(data);
                        var ddlDesi = $('#ddlPlantCode');
                        var Data2 = Data1.resultObject.sort();
                        ddlDesi.empty();

                        $.each(Data2, function (i, r) {
                            ddlDesi.append($('<option>', {
                                value: r.Value,
                                text: r.Text
                            }));
                        });

                        ddlDesi.append($('<option>', {
                            value: 0,
                            text: "- Please select Plant Name -"
                        }));

                        ddlDesi.val(0);
                    }
                },
                complete: function () {
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });

        }


    </script>

