                        var VendorList = MainData.VendorList;
                        var LocationList = MainData.LocationList;


                        if (TransfreeType == "HMSI" && LocationList != "") {
                            LocationList_ = LocationList;

                        }


                        if ((TransfreeType == "HMSI" || TransfreeType == "Other") && USERLIST != "" && LocationList != "") {
                            const suggestions = USERLIST.map(function (suggestion) {
                                return {
                                    label: suggestion.value + "-" + suggestion.text,
                                    value: suggestion.value + "-" + suggestion.text,


                                };

                            });
                            response(suggestions);

                        }

                        else if (TransfreeType == "Vendor" && VendorList != "") {

                            const suggestions = VendorList.map(function (suggestion) {
                                return {
                                    label: suggestion.VENDORCODE + "-" + suggestion.NAME1,
                                    value: suggestion.VENDORCODE + "-" + suggestion.NAME1,
                                    street: (suggestion.VENDORCODE == null ? "" : suggestion.VENDORCODE) + " - " + (suggestion.NAME1 == null ? "" : suggestion.NAME1 + ",") + (suggestion.NAME2 == null ? "" : suggestion.NAME2 + ",") + (suggestion.NAME3 == null ? "" : suggestion.NAME3 + ",") + (suggestion.STREET1 == null ? "" : suggestion.STREET1 + ",") + (suggestion.STREET2 == null ? "" : suggestion.STREET2 + ",") + (suggestion.STREET3 == null ? "" : suggestion.STREET3 + ",") + (suggestion.STREET4 == null ? "" : suggestion.STREET4 + ",") + (suggestion.CITY == null ? "" : suggestion.CITY + ",") + (suggestion.GSTIN == null ? "" : " \n GSTIN : " + suggestion.GSTIN + ",") + (suggestion.PANNO == null ? "" : " \n PANNO : " + suggestion.PANNO)

                                };
                            });

                            response(suggestions);

                        } else {
                            response([]);
                        }
                    },
                    error: function (error) {
                        console.error("Error fetching autocomplete suggestions:", error);
                        response([]);
                    },
                });
            },
