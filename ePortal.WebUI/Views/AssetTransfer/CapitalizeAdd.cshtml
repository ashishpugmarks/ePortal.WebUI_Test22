    function AutoSuggestLocation(ID, Value, TID_) {


        ID.autocomplete({
            source: function (request, response) {
                var TransfreeType = TID_.val() || "0";
                var searval = request.term;


                var filteredData = LocationList_.filter(function (item) {


                    var valueLowerCase = searval ? searval.toString().toLowerCase() : "";

                    return ((item.text && item.text.toString().toLowerCase().includes(valueLowerCase)) ||
                        (item.value && item.value.toString().toLowerCase().includes(valueLowerCase))
                    );
                });


                if (TransfreeType == "HMSI" && filteredData != "") {
                    const suggestions = filteredData.map(function (suggestion) {
                        return {
                            label: suggestion.value,
                            value: suggestion.value,
                            site: suggestion.value1,

                        };

                    });
                    response(suggestions);

                }
                else {
                    response([]);
                }

            },
            select: function (event, ui) {
                Value.val(ui.item.value);
                TransfreeType = TID_.val();

                if (TransfreeType == "HMSI") {
                    var Data = ui.item.site
                    $("#SiteAddress").val(Data);
                }
            },

        });
    }

    function formatDateForSeach(date) {
