    function tableToJsondataNew(table) {
        var data = [];
        var rows = table.find('tr');

        rows.each(function (index, row) {
            // Skip empty rows
            if ($(row).find('td').length > 0) {
                var rowData = {};
                $(row).find('td').each(function (index, column) {
                    rowData['column_' + index] = $(column).text();
                });
                data.push(rowData);
            }
        });

        return data;
    }

    function validateRecordOrder(data, TranType, ApprovalType) {

        var OrderList;
        if (TranType == "Returnable Transfer") {
            OrderList = ['Taxation', 'Finance', 'User Approval', 'Finance Approval', 'GateOutStamp', 'Security', 'Update Asset Code'];
        }
        else {
            OrderList = ['Taxation', 'Finance', 'User Approval', 'Finance Approval', 'GateOutStamp', 'Security', 'Update Asset Code', 'GateInStamp'];
        }
        var currentOrderIndex = 0;
        var currentRecord = OrderList[currentOrderIndex];
        var valid = false;

        if (data.length > OrderList.length) {
            valid = true;
            for (var i = 0; i < data.length; i++) {

                var columnValue = data[i].column_5.trim();
                var columnValuecpo = data[i].column_6.trim();
                if (columnValue === currentRecord) {

                    if (currentRecord === 'Taxation' || currentRecord === 'Finance Approval' || currentRecord === 'User Approval') {
                        while (i + 1 < data.length && data[i + 1].column_5.trim() === currentRecord) {
                            i++;
                        }

                    }



                    currentOrderIndex++;
                    if (currentOrderIndex < OrderList.length) {

                        currentRecord = OrderList[currentOrderIndex];
                    }
                } else {
                    valid = false;
                    break;
                }
            }

        }


        return valid;
    }

    function validateRecordOrderCPO(data, ApprovalType) {


        var currentOrderIndex = 0;
        var valid = false;

        for (var i = 0; i < data.length; i++) {

            var columnValue = data[i].column_5.trim();
            var columnValuecpo = data[i].column_6.trim();
            if (ApprovalType == "EBQ") {

                if (columnValue === 'User Approval' && columnValuecpo == "Chief Production Officer & Director") {
                    valid = true;
                    break;
                }

            }
            else {
                if (columnValue === 'User Approval' && columnValuecpo == "Operating Head") {
                    valid = true;
                    break;
                }
            }
        }
        return valid;
    }

