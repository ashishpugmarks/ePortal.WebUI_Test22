    function FormateDate(value) {

        var date_ = parseJsonDate(value);

        return setDatepickerValue(date_);

    }

    function setDatepickerValue(dateString) {

        var parts = dateString.split(' ');
        var day = parseInt(parts[0]);
        var month = parts[1];
        var year = parseInt(parts[2]);
        var monthIndex = {
            'Jan': 0,
            'Feb': 1,
            'Mar': 2,
            'Apr': 3,
            'May': 4,
            'Jun': 5,
            'Jul': 6,
            'Aug': 7,
            'Sept': 8,
            'Oct': 9,
            'Nov': 10,
            'Dec': 11
        }[month];
        var date = new Date(year, monthIndex, day + 1);

        var formattedDate = date.toISOString().split('T')[0]; // Extracting yyyy-mm-dd from ISO string
        return formattedDate.toString();
    }

    function parseJsonDate(jsonDateString) {

        const dateString = jsonDateString;
        const dateNumber = dateString.match(/\d+/)[0];
        // const date = new Date(+dateNumber);
            const date = new Date(jsonDateString);
        const options = {
            month: 'short',
            day: 'numeric',
            year: 'numeric'
        };
        const formattedDate = date.toLocaleDateString('en-IN', options);
        return formattedDate;
    }

