            $('#FixedApproval').removeClass('hidden').addClass('Show');
            $('#CrossApproval').addClass('hidden').removeClass('Show');
            $('#mytable th#deletecolumn, #mytable td:nth-child(8)').addClass('hidden');
            $('#mytable td#delete, #mytable td:nth-child(8)').addClass('hidden');

            Gethead();

        } else {
            $('#FixedApproval').addClass('Show').removeClass('hidden');
            $('#CrossApproval').removeClass('hidden').addClass('Show');
            $('#mytable th#deletecolumn, #mytable td:nth-child(8)').removeClass('hidden');
            $('#mytable td#delete, #mytable td:nth-child(8)').removeClass('hidden');
            $('#append_row').empty();
            //$('#delete').removeClass('hidden');
        }
    };

    function Edit(but) {

        var $row = $(but).parents('tr');
        var $cols = $row.find('td');
        if (ModoEdicion($row)) return;

        IterarCamposEdit($cols, function ($td) {

            var cont = $td.html();
            if (cont == "FULLY") {

                var div = '<div style="display: none;">' + cont + '</div>';
                var dr = '<select class="form-control select-sm"><option value="FULLY" selected>FULLY</option><option value="PARTIAL">PARTIAL </option>';
                $td.html(div + dr);
            }
            else if (cont == "PARTIAL") {
                var div = '<div style="display: none;">' + cont + '</div>';
                var dr = '<select class="form-control select-sm"><option value="FULLY">FULLY</option><option value="PARTIAL" selected>PARTIAL </option>';
                $td.html(div + dr);
            }

            else {

                var div = '<div style="display: none;">' + cont + '</div>';
                var input = '<input class="form-control input-sm"  value="' + cont + '">';

                $td.html(div + input);
            }
        });
        FijModoEdit(but);
    }

    function Cancel() {

        document.location = '/AssetTransfer/CapitalizeList';
    }

    function Summary() {

        var dt = tableToJson($("#DtData"));

        var jsonData = JSON.stringify({
            Detail: dt,

        });

        var URL = '/AssetTransfer/Summary';

        $.ajax({
            type: "POST",
            url: URL,
            // data: JSON.stringify({ Detail: dt }),
            data: { Detail: dt },
            dataType: "json",
            // contentType: "application/json; charset=utf-8",
            contentType: "application/x-www-form-urlencoded; charset=UTF-8",
            success: function (data) {

                if (JSON.parse(data).length != 0) {


                    var Data1 = JSON.parse(data);
                    $("#Summary_Data").empty();
                    //$.each(Data1, function (i, r) {
                    //

                    //var rowCount = $("#append_Data tr").length + 1;
                    $("#Summary_Data").append('<tr><td class="text-right">' + Data1.ORIGINAL_COST.toLocaleString() + '</td><td class="text-right">' + Data1.DEPRECIATION.toLocaleString() + '</td><td class="text-right">' + Data1.NET_BLOCK.toLocaleString() + '</td></tr>');

                    //});
                }
            },
            error: function () {
                $("#span-attachmentMsg").text('Oops... Something went wrong!').css('color', '#a94442').show().delay(5000).fadeOut();
                $("#btnUpload").attr("disabled", false);
            }
        });
    }

</script>

