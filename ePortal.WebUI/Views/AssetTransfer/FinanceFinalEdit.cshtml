            if (files.length !== 0) {
                if (window.FormData !== undefined) {
                    var fileData = new FormData();

                    var Type = "AT_GETIN_DOC";
                    var URL = '/AssetTransfer/GetinstampUpload/?Type=' + Type + '&TranNo=' + _TranNo;

                    for (var i = 0; i < files.length; i++) {
                        fileData.append(files[i].name, files[i]);
                    }

                    $.ajax({
                        url: URL,
                        type: "POST",
                        contentType: false,
