            var _Status = ($('#ddlstatus').val() == "" ?
           "" : $("#ddlstatus option:selected").text());

            if(_Status=="- Select -")
            {
                alert("Please Select  Approval Status...");
                return $('#ddlstatus').focus();
            }

            var dt="";
            if(AssetType==="Capitalized Asset"){
                dt = tableToJson($("#DtData"));
            }
            else{
                dt = tableToJson_Non($("#DtData_non"));
            }


            debugger;

            if (HeaderStatusglobal != "Pending At GateInStamp") {
                var columnCount = Object.keys(dt[0]).length;
                var assetcode;

                debugger;
                for (var i = 0; i < dt.length; i++) {
                    for (var j = 0; j < columnCount; j++) {
                        var columnName = Object.keys(dt[i])[j];
                        if(columnName === "ASSET_CODE"){
                            assetcode = dt[i][columnName];
                        }

                        if (columnName === "NEW_ASSET_CODE") {
                            var a = dt[i][columnName];

                            if (dt[i][columnName] == "" || dt[i][columnName] == null) {
                                if(AssetType==="Capitalized Asset"){
                                    alert("New Asset Code is blank against this asset code : "+" - "+assetcode);
                                }
                                else{
                                    alert("New Asset Code is blank against this Auc code : "+" - "+assetcode);
                                }
                                //$('#DtData input[name="LICENSE_NO."]').eq(i).focus();
                                return;
                            }
                        }
                    }
                }
            }

            var _Tranno = ($('#TransactionNo').val());
            var _remarks = ($('#Remarks').val());
            var gatein="@Model.GETIN_DOC_PATH";
            if((_Status=="Sent Back" || _Status=="Rejected") && _remarks == "")
            {
                alert("Please Enter Remarks...");
                return $('#Remarks').focus();
            }
            if(HeaderStatusglobal=="Pending At GateInStamp" && status=="Pending" && gatein=="Test")
            {
                alert("Please Upload GateInstamp...");
                return $('#File').focus();
            }
            var URL = '/AssetTransfer/UpdateApproval';
            debugger;
            $("#btnsubmit").attr("disabled", true);
            $.ajax({
                type: "POST",
                url: URL,
                // data: JSON.stringify({ Remarks: _remarks, TranNo: _Tranno, Status: _Status,Details: dt }),
                data:  { Remarks: _remarks, TranNo: _Tranno, Status: _Status,Details: dt },
                datatype: "json",
                // contentType: "application/json; charset=utf-8",
               contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                success: function (data) {

                    $("#btnsubmit").attr("disabled", false);
                    debugger;
                    var processedData = data.processedData;
                    parent.jQuery.fancybox.close();


                    alert("This Record has been "+_Status);
                    debugger;
                    if(HeaderStatusglobal=="Completed" && status=="Approved")
                    {
                        document.location = '/AssetTransfer/GateInStampList';
                    }
                    if(HeaderStatusglobal=="Pending At GateInStamp" && status=="Pending")
                    {
                        document.location = '/AssetTransfer/GateInStampList';
                    }
                    else{
                        document.location = '/AssetTransfer/FinanceFinalList';
                    }

                },
                complete: function () {
                    $("#btnsubmit").attr("disabled", false);
                },
                error: function () {
                    $("#btnsubmit").attr("disabled", false);
                    alert("Oops...", "Something went wrong!");
                }
            });

        }


        function Cancel() {
            debugger;
            TranType='@Model.TRAN_TYPE';

            if(TranType=="Returnable Transfer" && HeaderStatusglobal=="Completed")
            {
                document.location = '/AssetTransfer/FinanceFinalList';
            }
            else if(TranType=="Returnable Transfer" && HeaderStatusglobal=="Completed" && status=="Approved")
            {
                document.location = '/AssetTransfer/GateInStampList';
            }
            else if(TranType=="Permanent Transfer" && HeaderStatusglobal=="Completed" && status=="Approved")
            {
                document.location = '/AssetTransfer/FinanceFinalList';
            }

            else if(TranType=="Permanent Transfer" && HeaderStatusglobal=="Pending At GateInStamp" && status=="Pending")
            {
                document.location = '/AssetTransfer/GateInStampList';
            }

            else{
                document.location = '/AssetTransfer/FinanceFinalList';
            }
        }

    </script>

    @* CSP 3.0 Compliant changes *@
    <script nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#btnUpload').on('click', function (event) {
                event.preventDefault();
                Upload();
            });

            $('#btnsubmit').on('click', function (event) {
                event.preventDefault();
                UpdateApproval();
            });

            $('#btnCancel').on('click', function () {
                Cancel();
            });

            $(document).off('click', '[data-ctrl="ctrl-get-pdf"]');
            $(document).on('click', '[data-ctrl="ctrl-get-pdf"]', function (event) {
                event.preventDefault();
                GetPDF(this);
            });

            $(document).off('click', '[data-ctrl="ctrl-edit"]');
            $(document).on('click', '[data-ctrl="ctrl-edit"]', function (event) {
                event.preventDefault();
                var srno = $(this).data('srno');
                Edit(srno);
            });

            $(document).off('click', '[data-ctrl="ctrl-accept"]');
            $(document).on('click', '[data-ctrl="ctrl-accept"]', function (event) {
                event.preventDefault();
                var srno = $(this).data('srno');
                Edit(srno);
            });
        });
    </script>
