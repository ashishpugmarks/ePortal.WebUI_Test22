    </style>
}



<div class="panel-group">

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Finance Approval List</h2>
        </div>

        <div class="panel-body">
            <div style="margin-top:15px; font-size:15px;">

                <div class="col-md-2" style="margin:8px;">
                    <label style="padding-bottom:5px;">Transaction Type:</label>
                    <select id="ddlTranjectionType" class="form-control">
                        <option selected>All</option>
                        <option value="Permanent Transfer">Permanent Transfer</option>
                        <option value="Returnable Transfer">Returnable Transfer</option>
                    </select>

                </div>

                <div class="col-md-2" style="margin:8px;">

                    <label style="padding-bottom:5px;">Asset Type:</label>
                    <select id="ddlAssetType" class="form-control">
                        <option selected>All</option>
                        <option value="Capitalized Asset">Capitalized Asset</option>
                        <option value="Non-Capitalized Asset">Non-Capitalized Asset</option>
                    </select>
                </div>

                <div class="col-md-2" style="margin:8px;">
                    <label style="padding-bottom:5px;">Request No:</label>
                    <input id="TranjactionNo" name="TranjactionNo" type="text" class="form-control mb-1" value="" autocomplete="off" />
                </div>

                <div class="col-md-1" style="margin:8px; ">
                    <label style="padding-bottom:5px;">Status</label>
                    <select id="ddlStatus" class="form-control">
                        @*<option value="All"> All </option>*@
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                        @*<option value="Submited">Submited</option>
                            <option value="Completed">Completed</option>*@
                    </select>
                </div>

                <div class="col-md-1" style="margin-Top:27px;">
                    <a title="Search" id="btnGetdata" class="btn btn-success" data-ctrl="ctrl-search-data">&nbsp;GetData</a>
                </div>
            </div>
        </div>

        <div class="panel-body">
            <div id="pagination-container" class="text-center">
                <div class="form-group" style="margin-Top: 10px;">
                    <form id="myform">
                        <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                            <thead>
                                <tr class="bg-info">
                                    <th class="text-center">SrNo. <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Request No. <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Request Date <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Transaction Type <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Asset Type <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Transferor <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Transferee User <i class="fa fa-sort"></i></th>
                                    <th class="text-center" hidden>Total <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Status <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Action <i class="fa fa-sort"></i></th>
                                </tr>
                            </thead>
                            <tbody id="append_Data">
                                <tr><th colspan="13" class="text-center">No record found.</th></tr>
                            </tbody>
                        </table>
                    </form>
                </div>
                <ul class="pagination"></ul>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script nonce="@Context.Items["ScriptNonce_3"]">
        var preload = "";
        $(document).ready(function () {
            $("#ddlStatus").change(function () {
                debugger;
                var _Status = $(this).val();
                handleStatusChange(_Status, 1);
            });
            PreLoadData(1);
        });
        function SearchData(currentPage) {
            debugger;
            var recordsPerPage = 50;

            preload = "SearchData";

            var _TransactionType = ($('#ddlTranjectionType').val() == "" ?
                "" : $("#ddlTranjectionType option:selected").val());

            var _AssetType = ($('#ddlAssetType').val() == "" ?
                "" : $("#ddlAssetType option:selected").val());

            var _Status = ($('#ddlStatus').val() == "" ?
                "" : $("#ddlStatus option:selected").val());

            var _TransactionNo = ($('#TranjactionNo').val() == 0 ?
                0 : $("#TranjactionNo").val());


            var testModel = {

                TranjectionType: _TransactionType,
                AssetType: _AssetType,
                TranjectionNo: _TransactionNo,
                Status: _Status,
                flag: "Finance Approval"
            };


            debugger;

            $.ajax({
                async: false,
                type: "Post",
                url: "/AssetTransfer/ApprovalListSearchData",
                // url :url,
                // contentType: "application/json; charset=utf-8",
                datatype: "json",
                // data: JSON.stringify(testModel),
                data: testModel,
                // data:{  },
                success: function (data) {


                    if (JSON.parse(data).length != 0) {
                        debugger;
                        var Data1 = JSON.parse(data);
                        var startIndex = (currentPage - 1) * recordsPerPage;
                        var endIndex = startIndex + recordsPerPage;

                        // Slice the data array to get only the records for the current page
                        var currentPageData = Data1.slice(startIndex, endIndex);
                        $("#append_Data").empty();
                        $.each(currentPageData, function (i, r) {

                            $("#append_Data").append('<tr><td><center>' + (i + 1) + '</center></td><td class=text-center>' + r.TRAN_NO + '</td><td class=text-center>' + parseJsonDate(r.TRAN_DATE) + '</td><td class=text-center>' + r.TRAN_TYPE + '</td><td id="' + r.TRANNO + '_type" class=text-center>' + r.ASSET_TYPE + '</td><td class=text-center>' + r.TRANSFEROR + '</td><td class=text-center>' + r.TRANSFREE + '</td><td class=text-center hidden>' + r.TOTAL + '</td><td class=text-center>' + r.APPROVAL_STATUS + '</td><td><center>' + EditorFormatter(r.SRNO, r.APPROVAL_STATUS, r.APPAUTHSRNO, r.TRAN_NO, r.HEADERSTATUS, r.PDFPATH, r.GETOUT_DOC_PATH, r.GETIN_DOC_PATH, r.ASSET_TYPE) + '</td></tr>');

                        });
                        updatePagination(currentPage, Math.ceil(Data1.length / recordsPerPage), preload, _Status);
                    }
                    else {
                        $("#append_Data").empty();
                        $("#append_Data").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>")
                    }
                },
                complete: function () {
                },
                error: function () {
                    alert("Oops...", "Something went wrong!");
                }
            });
        }

        function handleStatusChange(_Status, currentPage) {
            debugger;
            preload = "handleStatusChange";
            var recordsPerPage = 50;
            var testModel = {
                Status: _Status.trim(),
                flag: "Finance Approval"
            };
            $.ajax({
                type: "POST",
                url: "/AssetTransfer/ApprovalListSearchDataStatus",
                // contentType: "application/json; charset=utf-8",
                dataType: "json",
                // data: JSON.stringify(testModel),
                data: testModel,
                success: function (data) {
                    if (JSON.parse(data).length !== 0) {
                        var Data1 = JSON.parse(data);

                        var startIndex = (currentPage - 1) * recordsPerPage;
                        var endIndex = startIndex + recordsPerPage;

                        // Slice the data array to get only the records for the current page
                        var currentPageData = Data1.slice(startIndex, endIndex);
                        $("#append_Data").empty();

                        $.each(currentPageData, function (i, r) {
                            var idAssetType = r.TRAN_NO + "_type";
                            debugger;
                            $("#append_Data").append('<tr><td><center>' + (i + 1) + '</center></td><td class=text-center>' + r.TRAN_NO + '</td><td class=text-center>' + parseJsonDate(r.TRAN_DATE) + '</td><td class=text-center>' + r.TRAN_TYPE + '</td><td id=' + idAssetType + ' class=text-center >' + r.ASSET_TYPE + '</td><td class=text-center>' + r.TRANSFEROR + '</td><td class=text-center>' + r.TRANSFREE + '</td><td class=text-center hidden>' + r.TOTAL + '</td><td class=text-center>' + r.APPROVAL_STATUS + '</td><td><center>' + EditorFormatter(r.SRNO, r.APPROVAL_STATUS, r.APPAUTHSRNO, r.TRAN_NO, r.HEADERSTATUS, r.PDFPATH, r.GETOUT_DOC_PATH, r.GETIN_DOC_PATH, r.ASSET_TYPE) + '</center></td></tr>');

                        });
                        updatePagination(currentPage, Math.ceil(Data1.length / recordsPerPage), preload, _Status);
                    } else {
                        $("#append_Data").empty();
                        $("#append_Data").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>");
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                    console.error("Error:", errorThrown);
                    alert("Oops... Something went wrong!");
                }
            });
        }

        function PreLoadData(currentPage) {
            debugger;
            preload = "PreLoadData";
            var recordsPerPage = 50;
            var URL = '/AssetTransfer/GetFinanceApproveList';
            $.ajax({
                async: false,
                type: "GET",
                url: URL,
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    debugger;

                    if (JSON.parse(data).length != 0) {

                        var Data1 = JSON.parse(data);
                        var startIndex = (currentPage - 1) * recordsPerPage;
                        var endIndex = startIndex + recordsPerPage;

                        // Slice the data array to get only the records for the current page
                        var currentPageData = Data1.slice(startIndex, endIndex);
                        $("#append_Data").empty();
                        $.each(currentPageData, function (i, r) {
                            debugger;
                            $("#append_Data").append('<tr><td><center>' + (i + 1) + '</center></td><td class=text-center>' + r.TRAN_NO + '</td><td class=text-center>' + parseJsonDate(r.TRAN_DATE) + '</td><td class=text-center>' + r.TRAN_TYPE + '</td><td id="' + r.TRANNO + '_type" class=text-center>' + r.ASSET_TYPE + '</td><td class=text-center>' + r.TRANSFEROR + '</td><td class=text-center>' + r.TRANSFREE + '</td><td class=text-center hidden>' + r.TOTAL + '</td><td class=text-center>' + r.APPROVAL_STATUS + '</td><td><center>' + EditorFormatter(r.SRNO, r.APPROVAL_STATUS, r.APPAUTHSRNO, r.TRAN_NO, r.HEADERSTATUS, r.PDFPATH, r.GETOUT_DOC_PATH, r.GETIN_DOC_PATH, r.ASSET_TYPE) + '</td></tr>');

                        });
                        updatePagination(currentPage, Math.ceil(Data1.length / recordsPerPage), preload);
                    }
                    else {
                        $("#append_Data").empty();
                        $("#append_Data").append("<tr><td colspan='13' class='text-center'>No record found.</td></tr>")
                    }
                },
                complete: function () {
                },
                error: function () {
                    alert("Oops...", "Something went wrong!");
                }
            });

        }

        function updatePagination(currentPage, totalPages, preload, _Status) {
            debugger;
            var container = $('#pagination-container .pagination');

            container.empty();

            for (var i = 1; i <= totalPages; i++) {
                var listItem = $('<li></li>').addClass('page-item').append(
                    $('<a></a>').addClass('page-link').attr({
                        href: 'javascript:void(0);',
                        'data-page': i
                    }).text(i)
                );

                if (i === currentPage) {
                    listItem.addClass('active');
                }

                listItem.on('click', function () {
                    var page = parseInt($(this).find('a').attr('data-page'));
                    debugger;
                    if (preload == "PreLoadData") {
                        PreLoadData(page);
                    }
                    else if (preload == "handleStatusChange") {
                        handleStatusChange(_Status, page);
                    }
                    else {
                        SearchData(page, _Status)
                    }

                });

                container.append(listItem);
            }
        }

        function EditorFormatter(SRNO, Status, APPAUTHSRNO, TRANNO, HEADERSTATUS, PDFPATH, GETOUT_DOC_PATH, GETIN_DOC_PATH, ASSET_TYPE) {
            debugger;
            if (Status == "Pending") {
                return '<center>'
                    + '<a title="Edit" class="btn btn-primary btn-xs" data-ctrl="ctrl-edit" data-srno="' + SRNO + '" data-appauthsrno="' + APPAUTHSRNO + '"><i class="ace-icon fa fa-edit"></i></a>'
                    + ' <a title="History" class="btn btn-primary btn-xs" data-ctrl="ctrl-history" data-tranno="' + TRANNO + '"><i class="fa fa-history"></i></a>'
                    + '</center>';
            }
            else if ((HEADERSTATUS == "UpdateNewAssetCode" || HEADERSTATUS == "Pending At Security") && Status == "Approved") {
                return '<center>'
                    + '<a title="View" class="btn btn-default btn-xs" data-ctrl="ctrl-view" data-srno="' + SRNO + '" data-appauthsrno="' + APPAUTHSRNO + '"><i class="ace-icon fa fa-eye"></i></a>'
                    + ' <a title="Asset Transfer Form" class="btn btn-success btn-xs" data-ctrl="ctrl-get-pdf" data-tranno="' + TRANNO + '" data-id="' + PDFPATH + '"><i class="ace-icon fa fa-paperclip"></i></a>'
                    + ' <a title="GateOut Stamp Document" class="btn btn-primary btn-xs" data-ctrl="ctrl-open-pdf-getout" data-id="' + GETOUT_DOC_PATH + '"><i class="ace-icon fa fa-paperclip"></i></a>'
                    + ' <a title="History" class="btn btn-primary btn-xs" data-ctrl="ctrl-history" data-tranno="' + TRANNO + '"><i class="fa fa-history"></i></a>'
                    + '</center>';
            }
            else if (HEADERSTATUS == "Pending At GateOutStamp" && Status == "Approved") {
                return '<center>'
                    + '<a title="View" class="btn btn-default btn-xs" data-ctrl="ctrl-view" data-srno="' + SRNO + '" data-appauthsrno="' + APPAUTHSRNO + '"><i class="ace-icon fa fa-eye"></i></a>'
                    + ' <a title="Asset Transfer Form" class="btn btn-success btn-xs" data-ctrl="ctrl-get-pdf" data-tranno="' + TRANNO + '" data-id="' + PDFPATH + '"><i class="ace-icon fa fa-paperclip"></i></a>'
                    + ' <a title="History" class="btn btn-primary btn-xs" data-ctrl="ctrl-history" data-tranno="' + TRANNO + '"><i class="fa fa-history"></i></a>'
                    + '</center>';
            }
            else if (HEADERSTATUS == "Completed" && GETIN_DOC_PATH == "Test") {

                return '<center>'
                    + '<a title="View" class="btn btn-default btn-xs" data-ctrl="ctrl-view" data-srno="' + SRNO + '" data-appauthsrno="' + APPAUTHSRNO + '"><i class="ace-icon fa fa-eye"></i></a>'
                    + ' <a title="History" class="btn btn-primary btn-xs" data-ctrl="ctrl-history" data-tranno="' + TRANNO + '"><i class="fa fa-history"></i></a>'
                    + ' <a title="Asset Transfer Form" class="btn btn-success btn-xs" data-ctrl="ctrl-get-pdf" data-tranno="' + TRANNO + '" data-id="' + PDFPATH + '"><i class="ace-icon fa fa-paperclip"></i></a>'
                    + ' <a title="GateOut Stamp Document" class="btn btn-primary btn-xs" data-ctrl="ctrl-open-pdf-getout" data-id="' + GETOUT_DOC_PATH + '"><i class="ace-icon fa fa-paperclip"></i></a>'
                    + '</center>';
            }
            else if (HEADERSTATUS == "Completed") {
                return '<center>'
                    + '<a title="View" class="btn btn-default btn-xs" data-ctrl="ctrl-view" data-srno="' + SRNO + '" data-appauthsrno="' + APPAUTHSRNO + '"><i class="ace-icon fa fa-eye"></i></a>'
                    + ' <a title="Asset Transfer Form" class="btn btn-success btn-xs" data-ctrl="ctrl-get-pdf" data-tranno="' + TRANNO + '" data-id="' + PDFPATH + '"><i class="ace-icon fa fa-paperclip"></i></a>'
                    + ' <a title="GateOut Stamp Document" class="btn btn-primary btn-xs" data-ctrl="ctrl-open-pdf-getout" data-id="' + GETOUT_DOC_PATH + '"><i class="ace-icon fa fa-paperclip"></i></a>'
                    + ' <a title="History" class="btn btn-primary btn-xs" data-ctrl="ctrl-history" data-tranno="' + TRANNO + '"><i class="fa fa-history"></i></a>'
                    + ' <a title="GateIn Stamp Document" class="btn btn-danger btn-xs" data-ctrl="ctrl-getin-doc" data-id="' + GETIN_DOC_PATH + '"><i class="ace-icon fa fa-paperclip"></i></a>'
                    + '</center>';
            }
            else {
                return '<center>'
                    + '<a title="View" class="btn btn-default btn-xs" data-ctrl="ctrl-view" data-srno="' + SRNO + '" data-appauthsrno="' + APPAUTHSRNO + '"><i class="ace-icon fa fa-eye"></i></a>'
                    + ' <a title="History" class="btn btn-primary btn-xs" data-ctrl="ctrl-history" data-tranno="' + TRANNO + '"><i class="fa fa-history"></i></a>'
                    + '</center>';
            }
        }

        function Edit(SRNO, APPAUTHSRNO) {
            debugger;
            document.location = '/AssetTransfer/FinancenApproveEdit/?id=' + SRNO + '&APPAUTHSRNO=' + APPAUTHSRNO;
        }

        function parseJsonDate(jsonDateString) {

            const dateString = jsonDateString;
            const dateNumber = dateString.match(/\d+/)[0];
            // const date = new Date(+dateNumber);
            const date = new Date(jsonDateString);
            const options = {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
            };
            const formattedDate = date.toLocaleDateString('en-IN', options);
            return formattedDate;
        }

