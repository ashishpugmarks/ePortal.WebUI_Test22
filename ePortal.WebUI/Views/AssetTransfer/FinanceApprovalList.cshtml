        function GetPDF(current) {

            debugger;
            var filename = $(current).attr('data-id');
            var TranNo = $(current).attr('data-tranno');
            /*var AssetType = $(current).attr('data-assettype');*/
            var id_Asset = "#" + TranNo + "_type";
            var AssetType = $(id_Asset).text();
            var _path = "../../../Uploads/AT/AT PDF/";

            $.ajax({
                type: 'POST',
                url: '/AssetTransfer/OpenPdfNew', // Replace 'Home' with your controller name
                data: { pdfPath: filename, TranNo: TranNo, AssetType: AssetType },
                success: function (data) {
                    if (data.FILEPATH != "") {
                        //document.getElementById("append_pdf").innerHTML = data.FILEPATH;
                        var fullFilePath = _path + filename;
                        debugger;

                        var width = screen.width - 100;
                        var height = screen.height - 100;
                        var winTop = 50;
                        var winLeft = 50;
                        var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
                        windowFeatures = windowFeatures + ",left = " + winLeft + ",";
                        windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
                        window.open(fullFilePath, "_blank", windowFeatures);
                    }
                },
                error: function (error) {
                    console.error('Error opening PDF:', error);
                }
            });
        }

