                    background: #C5C5F1;
                    text-decoration: none;
                }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            /*background-image: url('../../assets/images/loading_double.gif');*/
            opacity: .7;
        }

        .panel-heading {
            padding: 8px 15px;
        }

        #pr_div {
            border: 1px solid #ccc;
            padding: 8px; /*15px 0px 15px 0px;*/
            margin-left: 10px;
            border-radius: 5px;
            background-color: #eee;
            overflow: auto;
            min-height: 35px;
            max-height: 92px;
            width: 73.30%;
        }

        .alert-error {
            background-color: antiquewhite;
            margin-left: 15px;
            margin-right: 15px;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .required::after {
            content: "*";
            font-weight: 800;
            color: red;
            margin-left: 5px;
        }

        .ui-widget {
            font-family: Verdana,Arial,sans-serif;
            font-size: 0.6em !important;
            overflow: auto;
            max-height: 150px;
        }

        .pagination {
            display: inline-block;
            padding-left: 0;
            margin: 20px 0;
            border-radius: 0.25rem;
        }

            .pagination li {
                display: inline;
            }

            .pagination a, .pagination span {
                position: relative;
                float: left;
                padding: 0.5rem 0.75rem;
                margin-left: -1px;
                line-height: 1.25;
                color: #007bff;
                text-decoration: none;
                background-color: #fff;
                border: 1px solid #ddd;
            }

            .pagination .page-item.disabled span, .pagination .page-item.disabled a {
                color: #6c757d;
                pointer-events: none;
                cursor: auto;
                background-color: #fff;
                border-color: #ddd;
            }

            .pagination .page-item.active span, .pagination .page-item.active a {
                z-index: 2;
                color: #fff;
                background-color: #007bff;
                border-color: #007bff;
            }

            .pagination .page-link {
                display: block;
                padding: 0.5rem -0.25rem;
                margin-bottom: 0;
                font-size: 13px;
                line-height: 1.25;
                color: #007bff;
                background-color: #fff;
                border: 1px solid #ddd;
            }

                .pagination .page-link:hover {
                    z-index: 2;
                    color: #0056b3;
                    text-decoration: none;
                    background-color: #e9ecef;
                    border-color: #ddd;
