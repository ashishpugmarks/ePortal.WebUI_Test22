<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>
    <div class="col-md-12" style="margin-left:1%;padding-top: 1%;">
        <div class="col-md-3">
            <table>
                <tr><td style="border:1px solid #333;background-color:orangered;color:white;padding-top: 4%;">&nbsp; S &nbsp;</td><td style="border:1px solid  #333;text-align:center;background-color:#F5CBA7;color:black;height: 32px;font-size:18px;">&nbsp; Top Secret &nbsp;</td><td style="border:1px solid  #333;font-size:18px;width: 75px;">&nbsp;  @ViewBag.TopSecret &nbsp;</td></tr>
            </table>
        </div>
        <div class="col-md-3" style="margin-left: -6%;">
            <table>
                <tr><td style="border:1px solid  #333;background-color:orangered;color:white;padding-top: 4%;">&nbsp; A &nbsp;</td><td style="border:1px solid  #333;text-align:center;background-color:#F5B7B1;color:black;height: 32px;font-size:18px;">&nbsp;&nbsp; Secret &nbsp;&nbsp;</td><td style="border:1px solid  #333;font-size:18px;width: 75px;">&nbsp;  @ViewBag.Secret &nbsp;</td></tr>
            </table>
        </div>
        <div class="col-md-4" style="margin-left: -7.5%;">
            <table>
                <tr><td style="border:1px solid  #333;background-color:orangered;color:white;padding-top: 4%;">&nbsp; B &nbsp;</td><td style="border:1px solid  #333;text-align:center;background-color:#D4E6F1 ;color:black;height: 32px;font-size:18px;">&nbsp;&nbsp; Internal &nbsp;&nbsp;</td><td style="border:1px solid  #333;font-size:18px;width: 75px;">&nbsp;  @ViewBag.Internal &nbsp;</td></tr>
            </table>
        </div>
    </div>
    <div class="col-md-2"  style="margin-left:1%;">
        <button class="bttn btn-success btn_disable" id="btn-export" style="background-color: #ccc; border-color: #4e4e4e;color: #232121; font-weight : bold ;">Export to Excel</button>
    </div>
    <table class="table" style="font-size:13px;border:1px solid;width:96%;" id="LastKi">
        <thead>
            <tr>
            <tr style="background-color: lightblue;">
                <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">S.No.</th>
                <th style="border:1px solid;text-align:center; width:15%;font-weight:bold;">@Html.DisplayName("Primary Asset")</th>
                <th style="border:1px solid;text-align:center; width:15%;font-weight:bold;">@Html.DisplayName("Secondary Asset")</th>
                <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("Asset Type")</th>
                <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset Location")</th>
                <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset Owner")</th>
                <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset Custodian")</th>
                <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset User")</th>
                <th style="border:1px solid;text-align:center; width:5%;font-weight:bold;">@Html.DisplayName("Asset Classification")</th>
                <th style="border:1px solid;text-align:center; width:5%;font-weight:bold;">@Html.DisplayName("Retention Period")</th>
                <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Remarks</th>
                <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Applicability</th>
                <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Reason for NA")</th>
            </tr>
        </thead>
        <tbody>
            @{
                int indexq = 1;
                foreach (var item in ViewBag.Assetdetails)
                {
                    var s = item.Retention_Period;
                    var as_type = item.AssetsID;
                    var cls_type = item.ClassificationID;
                    <tr>
                        <td style="border:1px solid;text-align:center;">@indexq</td>
                        <td style="border:1px solid;text-align:center;">@item.Primary</td>
                        <td style="border:1px solid;text-align:center;">@item.Secondary</td>
                        <td style="border:1px solid;text-align:center;">
                            @if (as_type == 1)
                            {
                                <p>Information Hard</p>
                            }
                            @if (as_type == 2)
                            {
                                <p>Information Soft</p>
                            }
                            @if (as_type == 3)
                            {
                                <p>Physical</p>
                            }
                            @if (as_type == 4)
                            {
                                <p>Software</p>
                            } @if (as_type == 5)
                            {
                                <p>Service</p>
                            }
                            @if (as_type == 6)
                            {
                                <p>People</p>
                            }
                        </td>
                        <td style="border:1px solid;text-align:center;">@item.Assetlocation</td>
                        <td style="border:1px solid;text-align:center;">@item.AssetOwner</td>
                        <td style="border:1px solid;text-align:center;">@item.Custodian</td>
                        <td style="border:1px solid;text-align:center;">@item.AssetUser</td>
                        @if (cls_type == 1)
                        {
                            <td style="border:1px solid;text-align:center;background-color:#F5CBA7;color:black;">  Top secret  </td>
                        }
                        @if (cls_type == 2)
                        {
                            <td style="border:1px solid;text-align:center;background-color:#F5B7B1;color:black;">  Secret  </td>
                        }
                        @if (cls_type == 3)
                        {
                            <td style="border:1px solid;text-align:center;background-color:#D4E6F1;color:black;">  Internal  </td>
                        }

                        <td style="border:1px solid;text-align:center;">
                            @if (s != null && s != "_")
                            {
                                string[] result = s.Split('_');
                                var mth = result[0];
                                var year = result[1];
                                var yr = ""; var mth_ = "";
                                if (year == "1" || year == "0")
                                {
                                    yr = "Year";
                                }
                                else
                                {
                                    yr = "Years";
                                }
                                if (mth == "1" || mth == "0")
                                {
                                    mth_ = "Month";
                                }
                                else
                                {
                                    mth_ = "Months";
                                }
                                <p>
                                    @(year + yr + " " + mth + mth_)
                                </p>

                            }
                            else
                            {
                                <p>NA</p>
                            }
                        </td>
                        <td style="border:1px solid;text-align:center;">@item.Retention_Remarks</td>
                        <td style="border:1px solid;text-align:center;">
                            @if (item.ActionType == 1)
                            {
                                if (item.Reason_NA == null)
                                {
                                    <p>Yes</p>
                                }
                                else
                                {
                                    <p> No </p>
                                }
                            }
                            else
                            {
                                <p> - </p>
                            }
                        </td>



                        <td style="border:1px solid;text-align:center;">
                            @item.Reason_NA
                        </td>
                    </tr>
                    indexq++;
                }
                if (ViewBag.Assetdetails.Count == 0)
                {
                    <tr>
                        <td colspan="12" style="border:1px solid;text-align:center;">No record found.</td>
                        <td style="display: none"></td>
                        <td style="display: none"></td>
                        <td style="display: none"></td>
                        <td style="display: none"></td>
                        <td style="display: none"></td>
                        <td style="display: none"></td>
                        <td style="display: none"></td>
                        <td style="display: none"></td>
                        <td style="display: none"></td>
                        <td style="display: none"></td>
                        <td style="display: none"></td>
                    </tr>
                }
            }
        </tbody>
    </table>   
   <h7 style="margin-left:1%;">Remarks </h7>
     <table class="table" style="font-size:13px;border:1px solid;width:98%;margin-left:1%;">
         <thead>
             <tr style="background-color: lightblue;">
                 <td  style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Division Head Remarks</td>
                 <td  style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Operating Head Remarks</td>
             </tr>
             </thead>
             <tr>
                 @foreach (var item in ViewBag.Remarks)
            {
                     <td  style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.Divison_Remarks</td>
                     <td  style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.Operating_Remarks</td>
                     break;
                 }
             </tr>
</table>
</div>

