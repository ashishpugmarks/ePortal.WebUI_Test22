@section Scripts{
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $(document).ready(function () {
        $('#LastKi').DataTable({
            pageLength: 1000,
        });
    });
</script>
@* @Scripts.Render("~/bundles/jqueryval") *@
@* <script src="~/Scripts/table2excel.js"></script> *@
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    $(document).ready(function () {
        // $("#Ki").val(@ViewBag.curki);
        var table = $('#LastKi').DataTable();
        $('#btn-export').on('click', function () {
            var btn = $(this).button('loading');
            $('<table>')
                .append($(table.table().header()).clone())
                .append(table.$('tr').clone()).table2excel({
                    exclude: ".noExl",
                    name: "NominationList",
                    filename: "Assert List_" + new Date().toISOString().replace(/[\-\:\.]/g, "_"),
                    fileext: ".xls",
                    exclude_img: true,
                    exclude_links: true,
                    exclude_inputs: true,
                    columns: [0, 1, 2, 3]
                });
            setTimeout(function () {
                btn.button('reset');
            }, 2000);
        });
    }) </script>
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
    function goBack() {
        window.history.back();
    }
    $(document).ready(function () {
        if ($("#End_date_Check").val() == 0) {
            $("#btnsendback").show();
            $("#btnFinalSubmit").show();

            if ($("#Final_Submit_Check").val() == 0) {
                $("#btnsendback").show();
                $("#btnFinalSubmit").show();

            }
            else {
                $("#btnsendback").hide();
                $("#btnFinalSubmit").hide();
            }
        }
        else {
            $("#btnsendback").hide();
            $("#btnFinalSubmit").hide();

        }
    });

    $("#btnFinalSubmit,#btnsendback").click(function () {
        if ($("#DivisionHead_Remarks").val() == "") {
            alert("Please enter review remarks.");
            return false;
        }
        if ($("#chk_TC").prop('checked') == true) {
        }
        else {
            alert("Please click on guidelines for asset register.");
            return false;
        }

    });
</script>
}