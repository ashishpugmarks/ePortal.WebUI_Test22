                        <tr>
                            <td class="text-right">
                                <b>Previous Division</b> <span class="mandatory" style="color:red;">*</span>
                            </td>
                            <td>
                                @Html.DropDownListFor(model => model.PreviousDevisionID, (IEnumerable<SelectListItem>
