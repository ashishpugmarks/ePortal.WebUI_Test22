<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $("form[name='SaveEditOrgMapping']").validate({
        // Specify validation rules
        rules: {
            CurrentSYKIID: "required",
            CurrentOperationID: "required",
            CurrentDevisionID: "required",
            PreviousSYKIID: "required",
            PreviousOperationID: "required",
            PreviousDevisionID: "required",
        },
        // Specify validation error messages
        messages: {
            CurrentSYKIID: "Please select Current KI",
            CurrentOperationID: "Please select current Operation",
            CurrentDevisionID: "Please select Current Devision",
            PreviousSYKIID: "Please select last KI",
            PreviousOperationID: "Please select Previous Operation",
            PreviousDevisionID: "Please select Previous Devision",
        },
        // Make sure the form is submitted to the destination defined
        // in the "action" attribute of the form when valid
        submitHandler: function (form) {
            debugger;
            form.submit();
        }
    });

</script>

<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        var msg = '@ViewBag.Msg';
        if (msg.length) {
            alert(msg);
        }
</script>
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
 ////======== Bind Operation on document ready========////
        function BindOperationBySykiId(crnt, call) {
            var kiID = $(crnt).val();
            var select_ddlOp = $("#ddlOp");
            var select_ddlDiv = $("#ddlDiv");
            var select_ddlLastSYKI = $("#PreviousSYKIID");
            var select_ddlLastOp = $("#ddlLastOp");
            var select_ddlLastDiv = $("#ddlLastDiv");
            select_ddlOp.empty(); select_ddlDiv.empty(); select_ddlLastSYKI.empty();
            select_ddlLastOp.empty(); select_ddlLastDiv.empty();

            select_ddlOp.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlDiv.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlLastSYKI.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlLastOp.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlLastDiv.append($('<option />', { value: "0", text: "--Please wait--" }));
            if (kiID != "" && kiID != "0") {
                $.getJSON("/AssetRegistration/BindOperationByUserIDandCurrentSykiId", { SYKIID: kiID },
                          function (data) {
                              select_ddlOp.empty(); select_ddlDiv.empty(); select_ddlLastSYKI.empty();
                              select_ddlLastOp.empty(); select_ddlLastDiv.empty();
                              if (data.length > 0) {
                                  $.each(data, function (index, itemData) {
                                      if (itemData.OPERATIONID > 0)
                                          select_ddlOp.append($('<option />', { value: itemData.OPERATIONID, text: itemData.OPERATION }));
                                      else
                                          select_ddlOp.append($('<option />', { value: "0", text: "--No record--" }));

                                      if (itemData.DIVISIONID > 0)
                                          select_ddlDiv.append($('<option />', { value: itemData.DIVISIONID, text: itemData.DIVISION }));
                                      else
                                          BindDivision("#ddlOp", 0);
                                      if (itemData.LastSKID > 0)
                                          select_ddlLastSYKI.append($('<option />', { value: itemData.LastSKID, text: itemData.LastSYKI }));
                                      else
                                          select_ddlLastSYKI.append($('<option />', { value: "0", text: "--No record--" }));
                                      if (itemData.LastOPERATIONID > 0)
                                          select_ddlLastOp.append($('<option />', { value: itemData.LastOPERATIONID, text: itemData.LastOPERATION }));
                                      else
                                          select_ddlLastOp.append($('<option />', { value: "0", text: "--No record--" }));

                                      if (itemData.LastDIVISIONID > 0)
                                          select_ddlLastDiv.append($('<option />', { value: itemData.LastDIVISIONID, text: itemData.LastDIVISION }));
                                      else
                                          BindLastDivision("#ddlLastOp", 0);
                                  });
                              }
                              else {
                                  select_ddlOp.append($('<option />', { value: "0", text: "--No record--" }));
                                  select_ddlDiv.append($('<option />', { value: "0", text: "--No record--" }));
                                  select_ddlLastSYKI.append($('<option />', { value: "0", text: "--No record--" }));
                                  select_ddlLastDiv.append($('<option />', { value: "0", text: "--No record--" }));
                                  select_ddlLastOp.append($('<option />', { value: "0", text: "--No record--" }));
                              }
                          });
            }
            else {
                select_ddlOp.empty(); select_ddlDiv.empty(); select_ddlLastSYKI.empty();
                select_ddlOp.append($('<option />', { value: "0", text: "--Select Ki First--" }));
                select_ddlDiv.append($('<option />', { value: "0", text: "--Select--" }));
                select_ddlLastSYKI.append($('<option />', { value: "0", text: "--Select--" }));
            }
        };
        ////======== Bind Division on document ready========////
        function BindDivision(crnt, call) {
            var oID = $(crnt).val();
            var SYKIID = $("#SearchParams_SYKI").val();
            var select = $("#ddlDiv");
            if (select.val() == "" || select.val() == "0" || select.val() == null) {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Please wait--"
                }));
                if (oID != "") {
                    $.getJSON("/AssetRegistration/BindDivisionByOperationId", { id: oID, SYKIID: SYKIID },
                              function (data) {
                                  select.empty();
                                  if (data.length > 0) {
                                      select.append($('<option />', {
                                          value: "",
                                          text: "--Select--"
                                      }));
                                      $.each(data, function (index, itemData) {
                                          select.append($('<option />', {
                                              value: itemData.DIVISIONID,
                                              text: itemData.DIVISION
                                          }));
                                      });
                                      @*if('@Model.CurrentDevisionID' != 0)
                                          select.val('@Model.CurrentDevisionID');*@
                                  }
                                  else {
                                      select.append($('<option />', {
                                          value: "",
                                          text: "--No record--"
                                      }));
                                  }
                              });
                }
                else {
                    select.empty();
                    select.append($('<option />', {
                        value: "",
                        text: "--Select--"
                    }));
                }
            }
        };
    function BindLastDivision(crnt, call) {
        var oID = $(crnt).val();
        var SYKIID = $("#PreviousSYKIID").val();
        var select = $("#ddlLastDiv");
        if (select.val() == "" || select.val() == "0" || select.val() == null) {
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Please wait--"
            }));
            if (oID != "") {
                $.getJSON("/AssetRegistration/BindDivisionByOperationId", { id: oID, SYKIID: SYKIID },
                          function (data) {
                              select.empty();
                              if (data.length > 0) {
                                  select.append($('<option />', {
                                      value: "",
                                      text: "--Select--"
                                  }));
                                  $.each(data, function (index, itemData) {
                                      select.append($('<option />', {
                                          value: itemData.DIVISIONID,
                                          text: itemData.DIVISION
                                      }));
                                  });
                                  @*if('@Model.CurrentDevisionID' != 0)
                                  select.val('@Model.CurrentDevisionID');*@
                                  }
                              else {
                                  select.append($('<option />', {
                                      value: "",
                                      text: "--No record--"
                                  }));
                              }
                          });
            }
            else {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Select--"
                }));
            }
        }
    };
        ////======== Bind Division on change of Operation========////
        function BindDivisionOnChange(crnt, call) {
            var oID = $(crnt).val();
            var SYKIID = $("#CurrentSYKI").val();
            var select = $("#ddlDiv");
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Please wait--"
            }));
            if (oID != "") {
                $.getJSON("/AssetRegistration/BindDivisionByOperationId", { id: oID, SYKIID: SYKIID },
                          function (data) {
                              select.empty();
                              if (data.length > 0) {
                                  select.append($('<option />', {
                                      value: "",
                                      text: "--Select--"
                                  }));
                                  $.each(data, function (index, itemData) {
                                      select.append($('<option />', {
                                          value: itemData.DIVISIONID,
                                          text: itemData.DIVISION
                                      }));
                                  });
                              }
                              else {
                                  select.append($('<option />', {
                                      value: "",
                                      text: "--No record--"
                                  }));
                              }
                          });
            }
            else {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Select--"
                }));
            }
        };
        function BindLastDivisionOnChange(crnt, call) {
            var oID = $(crnt).val();
            var SYKIID = $("#PreviousSYKIID").val();
            var select = $("#ddlLastDiv");
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Please wait--"
            }));
            if (oID != "") {
                $.getJSON("/AssetRegistration/BindDivisionByOperationId", { id: oID, SYKIID: SYKIID },
                          function (data) {
                              select.empty();
                              if (data.length > 0) {
                                  select.append($('<option />', {
                                      value: "",
                                      text: "--Select--"
                                  }));
                                  $.each(data, function (index, itemData) {
                                      select.append($('<option />', {
                                          value: itemData.DIVISIONID,
                                          text: itemData.DIVISION
                                      }));
                                  });
                              }
                              else {
                                  select.append($('<option />', {
                                      value: "",
                                      text: "--No record--"
                                  }));
                              }
                          });
            }
            else {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Select--"
                }));
            }
        };
</script>
@if (TempData["result"] != null)
{
    if (Convert.ToInt16(TempData["result"]) == 0)
    {
     <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
         alert("Organization mapping has been saved successfully.");
     </script>
    }

}


<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
    $(document).ready(function () {
        $('#btnReset').on('click', function () {
            this.form.reset();
        });

        $('#btnBack').on('click', function () {
            window.location = document.referrer;
        });

        $('#CurrentSYKI').on('change', function () {
            BindOperationBySykiId($(this)[0], 0);
        });

        $('#ddlOp').on('change', function () {
            BindDivision($(this)[0], 0);
        });
        $('#ddlLastOp').on('change', function () {
            BindLastDivisionOnChange($(this)[0], 0);
        });

    });
</script>}