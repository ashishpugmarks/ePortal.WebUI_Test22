@section Scripts{
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

	function BindOperation(crnt, call) {
		var dID = $(crnt).val();
		var select = $("#ddlOp");
		if (dID != "") {
			$.getJSON("/AssetRegistration/BindOperationId", { SYKIID: dID },
				function (data) {
					select.empty();
					if (data.length > 0) {
						select.append($('<option />', {
							value: "",
							text: "--Select--"
						}));
						$.each(data, function (index, itemData) {
							select.append($('<option />', {
								value: itemData.ADORGLEVELID,
								text: itemData.LEVELDESCRIP
							}));
						});
					}
					else {
						select.append($('<option />', {
							value: "",
							text: "--No record--"
						}));
					}
				});
		}
		else {
			select.empty();
			select.append($('<option />', {
				value: "",
				text: "--Select--"
			}));

		}
	};

	function BindDivision(crnt, call) {
		var dID = $(crnt).val();
		var select = $("#DIVISIONID");
		if (dID != "") {
			$.getJSON("/AssetRegistration/BindDivisionByOperationId", { id: dID },
				function (data) {
					select.empty();
					if (data.length > 0) {
						//debugger;
						//if (localStorage.getItem("divval") !== "" && localStorage.getItem("divval") !== "0" && localStorage.getItem("divval") !== null) {
						//    select.append($('<option />', {
						//        value: localStorage.getItem("divval"),
						//        text: localStorage.getItem("divtext")
						//    }));
						//} else {
						//    select.append($('<option />', {
						//        value: "",
						//        text: "--Select--"
						//    }));
						//}
						select.append($('<option />', {
							value: "",
							text: "--Select--"
						}));

						$.each(data, function (index, itemData) {
							select.append($('<option />', {
								value: itemData.DIVISIONID,
								text: itemData.DIVISION
							}));
						});
						debugger;
						BindDepartment($("#DIVISIONID"), "0");
						BindSection($("#ddlDep"), "0");
						//localStorage.setItem("callDepartment", "1");
						//localStorage.removeItem("divval");
						//localStorage.removeItem("divtext");
					}
					else {
						select.append($('<option />', {
							value: "",
							text: "--No record--"
						}));
					}
				});
		}
		else {
			select.empty();
			select.append($('<option />', {
				value: "",
				text: "--Select--"
			}));
			BindDepartment($("#DIVISIONID"), "0");
			BindSection($("#ddlDep"), "0");

		}
	};

</script>
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
	function exportToExcel() {
		$("#GetData").table2excel({
			exportOptions: {
				pageLength: 5,
				columns: [0, 1, 2, 3, 4]
			},
			filename: "NominationList.xls"
		});
	}
</script>

<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
	$(document).ready(function () {
		$('#GetData').DataTable({
			dom: 'Bfrtip',
			buttons: [
				'copy', 'csv', 'excel', 'pdf', 'print'
			]
		});
	});
</script>
@* @Scripts.Render("~/bundles/jqueryval") *@
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
    function BtnBack(ths, event) {
        window.location.href = "Search";

    }
</script>
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
    $("#BtnCancel").click(function () {
        $("#SYKIDatanew").val("");
        location.reload(true);

    });
</script>

<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
    $('#btnSubmitt').on('click', function () {
        $('form').validate();
        if ($('form').valid())
            $(this).button('loading'); // button text will be "Submitting!"
    });
    $("#btnSubmitt1").click(function () {
        $.ajax({
            type: 'POST',
            url: '/AssetRegistration/ViewITGRCTeam',
            dataType: 'json',
            data: { key: $('#Ki').val(), division: $("#ddlOp").val(), operation: $("#DIVISIONID").val() },
            success: function (response) {
                $('#GetData').empty();
                $('#OrderDate').append('<option value="0">---Select Order Date---</option>')
                $.each(response, function (i, item) {
                    var res = '';
                    if (item.OrderDate != '') {
                        res = item.OrderDate.substring(0, 10);
                    }

                    $('#OrderDate').append('<option value="' + item.OrderId + '">' + res + '</option>')
                });
            },
            error: function (ex) {
                alert(ex.val);
            },
        });
    });
</script>

<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
    $(document).ready(function () {
        // $("#Ki").val(@ViewBag.curki);
        var table = $('#GetData').DataTable();
        $('#btn-export').on('click', function () {
            var btn = $(this).button('loading');
            $('<table>')
                .append($(table.table().header()).clone())
                .append(table.$('tr').clone()).table2excel({
                    exclude: ".noExl",
                    name: "NominationList",
                    filename: "NominationList" + new Date().toISOString().replace(/[\-\:\.]/g, "_"),
                    fileext: ".xls",
                    exclude_img: true,
                    exclude_links: true,
                    exclude_inputs: true,
                    columns: [0, 1, 2, 3]
                });
            setTimeout(function () {
                btn.button('reset');
            }, 2000);
        });
    }) </script>

