@model ePortal.ViewModels.DifiencyReport
@{
    ViewBag.Title = "Deficiency Asset Register";
    Layout = "~/Views/Shared/_LayoutAsset.cshtml";
    var List = ViewBag.PeriodSettingList as List<ePortal.ViewModels.CommonAAssetsRegListVM>;
}
@section Styles{
<link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />

<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">

    .btn {
        background-color: #e3e3e3;
        color: #333;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
        font-size: 16px;
        width: 329px !important;
    }

    .bttn {
        background-color: #e3e3e3;
        color: #333;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
        font-size: 16px;
    }

    .dropdownt {
        width: 326px !important;
    }

    .resr {
        font-weight: bold;
        background-color: #C3E214;
        border-radius: 5px;
        border: 2px solid #ccc;
        text-align: center;
        padding: 5px 15px;
        width: 120px;
        font-size: 12px;
    }

    .CS {
        background-color: #abcdef;
        color: Yellow;
        border: 1px solid #AB00CC;
        font: Verdana 10px;
        padding: 1px 4px;
        font-family: Roboto-Regular;
    }

    * {
        box-sizing: border-box;
    }

    .dropdown-check-list {
        display: inline-block;
    }

        .dropdown-check-list .anchor {
            position: relative;
            cursor: pointer;
            display: inline-block;
            padding: 5px 50px 5px 10px;
            border: 1px solid #ccc;
        }

            .dropdown-check-list .anchor:after {
                position: absolute;
                content: "";
                border-left: 2px solid black;
                border-top: 2px solid black;
                padding: 5px;
                right: 10px;
                top: 20%;
                -moz-transform: rotate(-135deg);
                -ms-transform: rotate(-135deg);
                -o-transform: rotate(-135deg);
                -webkit-transform: rotate(-135deg);
                transform: rotate(-135deg);
            }

            .dropdown-check-list .anchor:active:after {
                right: 8px;
                top: 21%;
            }

    dropdown-check-list ul.items {
        padding: 2px;
        display: none;
        margin: 0;
        border: 1px solid #ccc;
        border-top: none;
        width: 370px !important;
    }

    .dropdown-check-list ul.items li {
        list-style: none;
    }

    .dropdown-check-list.visible .anchor {
        color: #0094ff;
    }

    .dropdown-check-list.visible .items {
        display: block;
    }

    .cellpadding {
        padding: 5px 5px;
    }

    .form-wrapper {
        margin-top: 20px;
    }

    .spret {
        border: 1px solid #ccc;
    }

    .form-label {
        color: #000;
        font-size: 10px;
    }

    .form-input {
        font-size: 13px;
        padding: 2px 5px;
        border: 1px solid #ccc;
        // width:220px !important;
    }

    .field-indicator {
        color: #F00;
        vertical-align: middle;
    }

    .multiselect-container > li > a {
        padding: 0px;
        width: 320px !important;
    }

    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    .bttn {
        background-color: #e3e3e3;
        color: #333;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
        font-size: 16px;
    }

    .ui-widget-header, .ui-state-default, ui-button {
        font-weight: bold;
        font-size: 16px;
    }

    .ui-dialog .ui-dialog-content {
        font-size: 14px;
    }

    .ui-dialog-buttonset {
        font-size: 16px;
    }

    .btn1 {
        width: 190px !important;
        font-size: 14px !important;
        background-color: #e3e3e3;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
    }

    .ui-dialog-titlebar-close:before {
        content: "x";
    }
</style>
}
<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>
    @if (TempData["msg"] != null)
    {
        <span class="error">
            @TempData["msg"].ToString()
        </span>
    }
    @using (Html.BeginForm("DeficiencyAssetRegister", "AssetRegistration", FormMethod.Post, new { encType = "multipart/form-data", id = "CommonAssetsRegister" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="body-content" style="overflow-x:hidden">
            <div id="msform">
                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <tr>
                            <td class="text-right">
                                <b>Select Operation<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                <div class="col-md-12">
                                    @Html.DropDownList("operationId", (IEnumerable<SelectListItem>)ViewBag.OpList, "- Select -", new { @id = "ddlOp", @class = "form-control" })
                                </div>
                            </td>
                            <td class="text-right">
                                <b>Select Division<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                @Html.DropDownList("DivisionId", (IEnumerable<SelectListItem>)ViewBag.DivisionList, "- Select -", new { @id = "DIVISIONID", @class = "form-control" })
                            </td>
                            <td class="text-right">
                                <b>Primary Asset<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                @Html.DropDownList("PrimaryAssetId", (IEnumerable<SelectListItem>)ViewBag.PassetList, "- Select -", new { @id = "ddlPAsset", @class = "form-control", })
                            </td>

                            <td class="text-right">
                                <b>Secondary Asset<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                @Html.DropDownList("SecondaryAsset", (IEnumerable<SelectListItem>)ViewBag.SassetList, "- Select -",
                                new { @id = "ddlSAsset", @class = "form-control" })
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right">
                                <b>Feedback<span style="color: #ff0000">*</span></b>
                            </td>
                            <td colspan="3">
                                @Html.TextAreaFor(m => m.FeedBack, new { @class = "form-control", @maxlength = "150" })
                            </td>
                            <td colspan="5"></td>
                        </tr>

                        <tr>
                            <td colspan="10" style="text-align:center;">
                                <div class="col-md-12" style="align-items: center;">
                                    <input type="submit" class="bttn btn-success btn_disable" value="Submit" id="btnSubmit"
                                           name="btnSubmit" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />


                                    <input type="button" value="Back" class="bttn btn-success btn_disable" name="BtnCancel" id="BtnCancel" style="background-color: #ccc; border-color: #4e4e4e; align-items: center;width: 10%;color: #232121;font-weight : bold ;" />

                                </div>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>}
</div>

@*<script src="~/Scripts/jquery-1.10.2.min.js"></script>*@
@*@Scripts.Render("~/bundles/jqueryval")*@
@section Scripts{
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    function BindDivision(crnt, call) {
        var dID = $(crnt).val();
        var select = $("#DIVISIONID");
        if (dID != "") {
            $.getJSON("/AssetRegistration/BindDivisionByOperationId", { id: dID },
                function (data) {
                    select.empty();
                    if (data.length > 0) {
                        select.append($('<option />', {
                            value: "",
                            text: "--Select--"
                        }));

                        $.each(data, function (index, itemData) {
                            select.append($('<option />', {
                                value: itemData.DIVISIONID,
                                text: itemData.DIVISION
                            }));
                        });
                        // BindDepartment($("#DivisionId"), "0");
                        // BindSection($("#DIVISIONID"), "0");
                    }
                    else {
                        select.append($('<option />', {
                            value: "",
                            text: "--No record--"
                        }));
                    }
                });
        }
        else {
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Select--"
            }));
            //  BindDepartment($("#DivisionId"), "0");
            // BindSection($("#DIVISIONID"), "0");

        }
    };

    function BindPrimary(crnt, call) {
        var dID = $(crnt).val();
        var select = $("#ddlPAsset");
        if (dID != "") {
            $.getJSON("/AssetRegistration/BindDivisionByPrimaryAsset", { id: dID },
                function (data) {
                    select.empty();
                    if (data.length > 0) {
                        select.append($('<option />', {
                            value: "",
                            text: "--Select--"
                        }));

                        $.each(data, function (index, itemData) {
                            select.append($('<option />', {
                                value: itemData,
                                text: itemData
                            }));
                        });
                        //BindDepartment($("#PrimaryAssetId"), "0");
                        //BindSection($("#ddlPAsset"), "0");
                    }
                    else {
                        select.append($('<option />', {
                            value: "",
                            text: "--No record--"
                        }));
                    }
                });
        }
        else {
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Select--"
            }));
            // BindDepartment($("#PrimaryAssetId"), "0");
            // BindSection($("#ddlPAsset"), "0");

        }
    };

    function BindSecondary(crnt, call) {
        var pID = $(crnt).val();
        var divID = $("#DIVISIONID").val();
        var select = $("#ddlSAsset");
        if (pID != "") {
            $.getJSON("/AssetRegistration/BindDivisionBySecondaryAsset", { primaryid: pID, div_id: divID },
                function (data) {
                    select.empty();
                    if (data.length > 0) {
                        select.append($('<option />', {
                            value: "",
                            text: "--Select--"
                        }));

                        $.each(data, function (index, itemData) {
                            select.append($('<option />', {
                                value: itemData.PrimaryAssetId,
                                text: itemData.PrimaryAssetText
                            }));
                        });
                    }
                    else {
                        select.append($('<option />', {
                            value: "",
                            text: "--No record--"
                        }));
                    }
                });
        }
        else {
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Select--"
            }));

        }
    };
</script>

<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    function goBack() {
        window.history.back();
    }
</script>
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
    $(document).ready(function () {
        $("#btnSubmit").click(function () {
            var Primary = $('#ddlOp').val();
            var Secondary = $('#DIVISIONID').val();
            if (Primary == "") {
                alert('Please select operation!');
                return false;
            }
            else if (Secondary == "") {
                alert("Please select division!");
                return false;
            }
            else if ($("#ddlPAsset").val() == "") {
                alert("Please select primary asset!");
                return false;
            }
            else if ($("#ddlSAsset").val() == "") {
                alert("Please select secondary asset!");
                return false;
            }
            else if ($("#FeedBack").val() == "") {
                alert("Please enter feedback!");
                return false;
            }

        });
    });
</script>

<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">

    $(document).ready(function () {
        $('#BtnCancel').on('click', function () {
            goBack();
        });
        $('#ddlOp').on('change', function () {
            BindDivision($(this)[0], 0);
        });
        $('#DIVISIONID').on('change', function () {
            BindPrimary($(this)[0], 0);
        });
        $('#ddlPAsset').on('change', function () {
            BindSecondary($(this)[0], 0);
        });
    });

</script>

}


