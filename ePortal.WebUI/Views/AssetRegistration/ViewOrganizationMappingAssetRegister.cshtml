	$(document).ready(function () {
		$('#LastKi').DataTable({
		});
	});
</script>
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        var msg = '@ViewBag.Msg';
        if (msg.length) {
            alert(msg);
        };
        $(document).ready(function () {
            $("#CancelBtnClick").click(function () {
                location.reload(true);
            });
            BindDivision("#ddlOp", 0);
        });

        $('#btnSearch').on('click', function () {
            $('form').validate();
            if ($('form').valid())
                $(this).button('loading') // button text will be "finished!"
        });
</script>

<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        ////======== Bind Operation on document ready========////
        function BindOperationBySykiId(crnt, call) {
            var kiID = $(crnt).val();
            var select_ddlOp = $("#ddlOp");
            var select_ddlDiv = $("#ddlDiv");
            select_ddlOp.empty(); select_ddlDiv.empty();

            select_ddlOp.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlDiv.append($('<option />', { value: "0", text: "--Please wait--" }));
            if (kiID != "" && kiID != "0") {
                $.getJSON("/AssetRegistration/BindOperationBySykiId", { SYKIID: kiID },
                          function (data) {
                              select_ddlOp.empty(); select_ddlDiv.empty();
                              if (data.length > 0) {
                                      select_ddlOp.append($('<option />', { value: "0", text: "--Select--" }));
                                      $.each(data, function (index, itemData) {
                                          select_ddlOp.append($('<option />', { value: itemData.ADORGLEVELID != null ? itemData.ADORGLEVELID : 0, text: itemData.LEVELDESCRIP }));
                                      });
                                      select_ddlDiv.append($('<option />', { value: "0", text: "--Select--" }));
                              }
                              else {
                                  select_ddlOp.append($('<option />', { value: "0", text: "--No record--" }));
                                  select_ddlDiv.append($('<option />', { value: "0", text: "--No record--" }));
                              }
                          });
            }
            else {
                select_ddlOp.empty(); select_ddlDiv.empty();
                select_ddlOp.append($('<option />', { value: "0", text: "--Select Ki First--" }));
                select_ddlDiv.append($('<option />', { value: "0", text: "--Select--" }));
            }
        };
        ////======== Bind Division on document ready========////
        function BindDivision(crnt, call) {
            var oID = $(crnt).val();
            var SYKIID = $("#SearchParams_SYKI").val();
            var select = $("#ddlDiv");
            if (select.val() == "" || select.val() == "0" || select.val() == null) {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Please wait--"
                }));
                if (oID != "") {
                    $.getJSON("/AssetRegistration/BindDivisionByOperationId", { id: oID, SYKIID: SYKIID },
                              function (data) {
                                  select.empty();
                                  if (data.length > 0) {
                                      select.append($('<option />', {
                                          value: "",
                                          text: "--Select--"
                                      }));
                                      $.each(data, function (index, itemData) {
                                          select.append($('<option />', {
                                              value: itemData.DIVISIONID,
                                              text: itemData.DIVISION
                                          }));
                                      });
                                      if('@Model.SearchParams.DIVISIONID' != 0)
                                          select.val('@Model.SearchParams.DIVISIONID');
                                  }
                                  else {
                                      select.append($('<option />', {
                                          value: "",
                                          text: "--No record--"
                                      }));
                                  }
                              });
                }
                else {
                    select.empty();
                    select.append($('<option />', {
                        value: "",
                        text: "--Select--"
                    }));
                }
            }
        };

        ////======== Bind Division on change of Operation========////
        function BindDivisionOnChange(crnt, call) {
            var oID = $(crnt).val();
            var SYKIID = $("#SearchParams_SYKI").val();
            var select = $("#ddlDiv");
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Please wait--"
            }));
            if (oID != "") {
                $.getJSON("/AssetRegistration/BindDivisionByOperationId", { id: oID, SYKIID: SYKIID },
                          function (data) {
                              select.empty();
                              if (data.length > 0) {
                                  select.append($('<option />', {
                                      value: "",
                                      text: "--Select--"
                                  }));
                                  $.each(data, function (index, itemData) {
                                      select.append($('<option />', {
                                          value: itemData.DIVISIONID,
                                          text: itemData.DIVISION
                                      }));
                                  });
                              }
                              else {
                                  select.append($('<option />', {
                                      value: "",
                                      text: "--No record--"
                                  }));
                              }
                          });
            }
            else {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Select--"
                }));
            }
        };

</script>


<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
    $(document).ready(function () {
        var table = $('#LastKi').DataTable();
        $('#btn-export').on('click', function () {
                 $('<table>')
                    .append($(table.table().header()).clone())
                    .append(table.$('tr').clone()).table2excel({
                        exclude: ".noExl",
                        name: "NominationList",
                             filename: "Organization Mapping List_" + new Date().toISOString().replace(/[\-\:\.]/g, "_"),
                        fileext: ".xls",
                        exclude_img: true,
                        exclude_links: true,
                        exclude_inputs: true,
                        columns: [0, 1, 2, 3]
                    });
                
           
        });
    })
</script>

@if (TempData["result"] != null)
{
    if (Convert.ToInt16(TempData["result"]) == 1)
    {
        <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
            alert("Organization Mapping has been saved successfully.");
        </script>
    }
    else if (Convert.ToInt16(TempData["result"]) == 2)
    {
        <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
            alert("Organization Mapping has been updated successfully.");
        </script>
    }
}


<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
    $(document).ready(function () {

        $('[data-ctrl="edit-btn"]').on('click', function () {
             location.href = '@Url.Action("AddEditOrgMapping","AssetRegistration")';
        });

        $('#CancelBtnClick').on('click', function () {
            CancelBtnClickEvent();
        });

        $('[data-ctrl="ddl-ki"]').on('click', function () {
              BindOperationBySykiId($(this)[0], 0);
        });

        $('#ddlOp').on('change', function () {
            BindDivisionOnChange($(this)[0], 0);
        });

    });
</script>
}