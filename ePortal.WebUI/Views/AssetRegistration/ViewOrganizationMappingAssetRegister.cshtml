<div class="row">
    <div class="col-md-12" style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div class="col-md-10 col-sm-10 col-lg-10" style="padding:8px;">@TempData["PageHead"]</div>
        <div class="col-md-1 col-sm-1 col-lg-1">

            <button type="button" class="btn btn-success" data-ctrl="edit-btn" title="Click here to Add New Organization Mapping"
                    style="background-color: #dddddd; border-color: #dddddd; color: #232121; font-weight: bold">
                Add ORG Mapping
            </button>

        </div>

    </div>
</div>
<div class="row">
    <input type="hidden" id="hdnva" value="0" />
    <input type="hidden" id="hdnopval" value="0" />
    <input type="hidden" id="hdnoptext" value="" />
    @using (Html.BeginForm("ViewOrganizationMappingAssetRegister", "AssetRegistration", FormMethod.Post))
    {
    
        <div class="form-group">
            <table class="table table-bordered table-hover table-responsive">
                <tr>
                    <td class="tbl_cls1"><label for="Ki" class="font-size">Ki </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownList("SearchParams.SYKI", ViewBag.SYKIData as SelectList, new { @class = "form-control", @data_ctrl="ddl-ki"})
                    
                    </td>
                    <td class="tbl_cls1"><label for="Operation" class="font-size">Operation </label></td>
                    <td class="tbl_cls2">

                        @Html.DropDownListFor(model => model.SearchParams.OPERATIONID, (IEnumerable<SelectListItem>)ViewBag.OpList, "- Select -", new { @id = "ddlOp", @class = "form-control" })


                    </td>
                </tr>
                <tr>
                    <td class="tbl_cls1"><label for="Division" class="font-size">Division </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownListFor(model => model.SearchParams.DIVISIONID, (IEnumerable<SelectListItem>
                        )ViewBag.DivList, "- Select -",
                        new { @id = "ddlDiv", @class = "form-control" })

                    </td>
                </tr>
                <tr>
                    <td style="height:45px; text-align:center; padding-top:07px;" colspan="4">
                        <button type="submit" id="btnSearch" data-loading-text="Submitting..." autocomplete="off" class="btn-xs btn-primary clickcls" style="width:90px; height:30px; background-color: #ccc; border-color: #4e4e4e; color: #0c0c0c;" name="value">
                            Search
                        </button>
                        &nbsp; &nbsp; &nbsp;

                        <button type="button" class="btn-xs btn-primary" id="CancelBtnClick" style="width:90px; height:30px; background-color: #ccc; border-color: #4e4e4e; color: #0c0c0c;">
                            Cancel
                        </button>

                        @Html.Hidden("hdnIsITDivisionHead", (object)Convert.ToString(ViewBag.List[0].isITDivisionHead))
                    </td>
                </tr>


            </table>
        </div>
    }

    <button class="bttn btn-success btn_disable" id="btn-export" style="background-color: #ccc; border-color: #4e4e4e;color: #232121;float:right;font-size: 15px;margin-bottom:0.5%;">Export to Excel</button>
    @if (Model != null)
    {
        <div id="searchResults">
            <table class="table" style="font-size:13px;border:1px solid;width:98%;" id="LastKi">
                <thead>
                    <tr class="tcat">
                        <th style="border: 1px solid #dddddd; text-align:center; width:3%;">S.No</th>
                        <th style="border: 1px solid #dddddd; text-align:center; width:5%;">@Html.DisplayName("Previous ki")</th>
                        <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Previous Operation")</th>
                        <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Previous Division")</th>
                        <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Current Ki")</th>
                        <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Current Operation")</th>
                        <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Current Division")</th>
                        <th style="border: 1px solid #dddddd; width:6%;text-align:center" class="noExl">@Html.DisplayName("Action")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.orgMappingVM.Count > 0)
                    {
                        int i = 1;
                        foreach (var item in Model.orgMappingVM)
                        {
                            <tr>
                                <td style="border: 1px solid #dddddd;text-align:center;">@i</td>
                                <td style="border: 1px solid #dddddd;text-align:center;"> @item.Previouski</td>
                                <td style="border: 1px solid #dddddd;text-align:center;"> @item.PreviousOperation</td>
                                <td style="border: 1px solid #dddddd;text-align:center;">@item.PreviousDivision</td>
                                <td style="border: 1px solid #dddddd;text-align:center;">@item.CurrentKi</td>
                                <td style="border: 1px solid #dddddd;text-align:center;">@item.CurrentOperation</td>
                                <td style="border: 1px solid #dddddd;text-align:center;">@item.CurrentDivision</td>
                                <td style="border: 1px solid #dddddd;text-align:center;">
                                    <a href='@Url.Action("AddEditOrgMapping", "AssetRegistration", new { item.OrgMappingId })' class="glyphicon glyphicon-pencil"></a>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10"> No record found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        //}
    }
    else
    {
        <div id="searchResults">
            <table class="table" style="font-size:13px;border:1px solid;width:98%;" id="LastKi">
                <thead>
                    <tr style="background-color: #fdf59a;">
                        <th style="border: 1px solid #dddddd; text-align:center; width:3%;">@Html.DisplayName("S.No")</th>
                        <th style="border: 1px solid #dddddd; text-align:center; width:5%;">@Html.DisplayName("Previous ki")</th>
                        <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Previous Operation")</th>
                        <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Previous Division")</th>
                        <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Current Ki")</th>
                        <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Current Operation")</th>
                        <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Current Division")</th>
                        <th style="border: 1px solid #dddddd; width:6%;text-align:center">@Html.DisplayName("Action")</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="10"> No record found.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    <table class="table table-bordered table-hover table-responsive">
        <tr style="background-color:#f3f3f3">
            <td style="height: 20px;font-size: 14px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td colspan="4">
                                <a title="Back" href="/home/home">
                                    <img src="~/images/icon_back.gif" border="0" alt="">
                                    Back
                                </a>
                            </td>

                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>

