@model ePortal.ViewModels.A00ViewModel
@{
    ViewBag.Title = "Last Year Information Asset Registers";
    Layout = "~/Views/Shared/_LayoutAsset.cshtml";
}
@section Styles{
@*<script type="text/javascript" language="Javascript" src="~/js/jquery-ui.js"></script>
    <link rel="stylesheet" href="~/css/jquery-ui.css">
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap-multiselect.css">
