    <link href="~/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet" />*@
<link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />
<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    #LastKi_filter, #LastKi_length {
        display: none;
    }

    #LastKi_info {
        font-size: 12px !important;
    }

    #LastKi_length select {
        width: 32% !important;
        padding-top: 0px;
    }

    .pagination {
        font-size: 12px !important;
    }

    .btn {
        background-color: #e3e3e3;
        color: #333;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
        font-size: 16px;
        width: 329px !important;
    }

    .bttn {
        background-color: #e3e3e3;
        color: #333;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
        font-size: 16px;
    }

    .dropdownt {
        width: 326px !important;
    }

    .resr {
        font-weight: bold;
        background-color: #C3E214;
        border-radius: 5px;
        border: 2px solid #ccc;
        text-align: center;
        padding: 5px 15px;
        width: 120px;
        font-size: 12px;
    }

    .CS {
        background-color: #abcdef;
        color: Yellow;
        border: 1px solid #AB00CC;
        font: Verdana 10px;
        padding: 1px 4px;
        font-family: Roboto-Regular;
    }

    * {
        box-sizing: border-box;
    }

    .dropdown-check-list {
        display: inline-block;
    }

        .dropdown-check-list .anchor {
            position: relative;
            cursor: pointer;
            display: inline-block;
            padding: 5px 50px 5px 10px;
            border: 1px solid #ccc;
        }

            .dropdown-check-list .anchor:after {
                position: absolute;
                content: "";
                border-left: 2px solid black;
                border-top: 2px solid black;
                padding: 5px;
                right: 10px;
                top: 20%;
                -moz-transform: rotate(-135deg);
                -ms-transform: rotate(-135deg);
                -o-transform: rotate(-135deg);
                -webkit-transform: rotate(-135deg);
                transform: rotate(-135deg);
            }

            .dropdown-check-list .anchor:active:after {
                right: 8px;
                top: 21%;
            }

    dropdown-check-list ul.items {
        padding: 2px;
        display: none;
        margin: 0;
        border: 1px solid #ccc;
        border-top: none;
        width: 370px !important;
    }

    .dropdown-check-list ul.items li {
        list-style: none;
    }

    .dropdown-check-list.visible .anchor {
        color: #0094ff;
    }

    .dropdown-check-list.visible .items {
        display: block;
    }

    .cellpadding {
        padding: 5px 5px;
    }

    .form-wrapper {
        margin-top: 20px;
    }

    .spret {
        border: 1px solid #ccc;
    }

    .form-label {
        color: #000;
        font-size: 10px;
    }

    .form-input {
        font-size: 13px;
        padding: 2px 5px;
        border: 1px solid #ccc;
        // width:220px !important;
    }

    .field-indicator {
        color: #F00;
        vertical-align: middle;
    }

    .multiselect-container > li > a {
        padding: 0px;
        width: 320px !important;
    }

    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    .bttn {
        background-color: #e3e3e3;
        color: #333;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
        font-size: 16px;
    }

    .ui-widget-header, .ui-state-default, ui-button {
        font-weight: bold;
        font-size: 16px;
    }

    .ui-dialog .ui-dialog-content {
        font-size: 14px;
    }

    .ui-dialog-buttonset {
        font-size: 16px;
    }

    .btn1 {
        width: 190px !important;
        font-size: 14px !important;
        background-color: #e3e3e3;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
    }

    .ui-dialog-titlebar-close:before {
        content: "x";
    }
</style>
}

<div class="row" id="Grid">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>
    <div style="padding: 1% !important;">
        <table class="table" style="font-size:13px;border:1px solid;width:98%;" id="LastKi">
            <thead>
                <tr>
                <tr style="background-color: lightblue;">
                    <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">S.No.</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Primary Asset")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Secondary Asset")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset Type")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset Location")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset Owner")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset Custodian")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset User")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Classification")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Retention Period")</th>
                    <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Remarks</th>
                    <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Applicability</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Reason for NA")</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int indexq = 1;
                    foreach (var item in ViewBag.Last_Ki_Asset_details_List)
                    {
                        var s = item.Retention_Period;
                        var as_type = item.AssetsID;
                        var cls_type = item.ClassificationID;
                        <tr>
                            <td style="border:1px solid;text-align:center;">@indexq</td>
                            <td style="border:1px solid;text-align:center;">@item.Primary</td>
                            <td style="border:1px solid;text-align:center;">@item.Secondary</td>
                            <td style="border:1px solid;text-align:center;">
                                @if (as_type == 1)
                                {
                                    <p>Information Hard</p>
                                }
                                @if (as_type == 2)
                                {
                                    <p>Information Soft</p>
                                }
                                @if (as_type == 3)
                                {
                                    <p>Physical</p>
                                }
                                @if (as_type == 4)
                                {
                                    <p>Software</p>
                                } @if (as_type == 5)
                                {
                                    <p>Service</p>
                                }
                                @if (as_type == 6)
                                {
                                    <p>People</p>
                                }
                            </td>
                            <td style="border:1px solid;text-align:center;">@item.Assetlocation</td>
                            <td style="border:1px solid;text-align:center;">@item.AssetOwner</td>
                            <td style="border:1px solid;text-align:center;">@item.Custodian</td>
                            <td style="border:1px solid;text-align:center;">@item.AssetUser</td>
                            <td style="border:1px solid;text-align:center;">
                                @if (cls_type == 1)
                                {
                                    <p>Top secret </p>
                                }
                                @if (cls_type == 2)
                                {
                                    <p>Secret </p>
                                }
                                @if (cls_type == 3)
                                {
                                    <p>Internal</p>
                                }
                            </td>
                            <td style="border:1px solid;text-align:center;">
                                @if (s != null && s != "_")
                                {
                                    string[] result = s.Split('_');
                                    var mth = result[0];
                                    var year = result[1];
                                    var yr = ""; var mth_ = "";
                                    if (year == "1" || year == "0")
                                    {
                                        yr = "Year";
                                    }
                                    else
                                    {
                                        yr = "Years";
                                    }
                                    if (mth == "1" || mth == "0")
                                    {
                                        mth_ = "Month";
                                    }
                                    else
                                    {
                                        mth_ = "Months";
                                    }
                                    <p>
                                        @(year + yr + " " + mth + mth_)
                                    </p>

                                }
                                else
                                {
                                    <p>NA</p>
                                }
                            </td>
                            <td style="border:1px solid;text-align:center;">@item.Retention_Remarks</td>
                            <td style="border:1px solid;text-align:center;">
                                @if (item.ActionType == 1)
                                {
                                    if (item.Reason_NA == null)
                                    {
                                        <p>Yes</p>
                                    }
                                    else
                                    {
                                        <p> No </p>
                                    }
                                }
                                else
                                {
                                    <p> - </p>
                                }
                            </td>
                            <td style="border:1px solid;text-align:center;">
                                @item.Reason_NA
                            </td>
                        </tr>
                        indexq++;
                    }
                    if (ViewBag.Last_Ki_Asset_details_List.Count == 0)
                    {
                        @*<tr>
                                <td colspan="13" style="border:1px solid;text-align:center;">No record found.</td>
                            </tr>*@
                        <tr>
                            <td colspan="13" style="border:1px solid;text-align:center;">No record found.</td>
                            <td style="display: none"></td>
                            <td style="display: none"></td>
                            <td style="display: none"></td>
                            <td style="display: none"></td>
                            <td style="display: none"></td>
                            <td style="display: none"></td>
                            <td style="display: none"></td>
                            <td style="display: none"></td>
                            <td style="display: none"></td>
                            <td style="display: none"></td>
                            <td style="display: none"></td>
                            <td style="display: none"></td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <br />
        <table class="table table-bordered table-hover table-responsive">
            <tr style="background-color:#f3f3f3">
                <td style="height: 20px;font-size: 14px;">
                    <table style="width: 100%;">
                        <tbody>
                            <tr>
                                <td colspan="4">


                                    <a title="Back" href="#" data-ctrl="btnBack">
                                        <img src="~/images/icon_back.gif" border="0" alt="">
                                        Back
                                    </a>

                                </td>

                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </table>
    </div>

</div>
@section Scripts{
@*<script src="https://cdn.datatables.net/1.10.23/js/jquery.dataTables.min.js"></script>*@
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $(document).ready(function () {
        $('#LastKi').DataTable({
            pageLength: 1000,
        });
    });
</script>

<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    function goBack() {
        window.history.back();
    }
</script>

<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
    $(document).ready(function () {
        $('[data-ctrl="btnback"]').on('click', function (e) {
            e.preventDefault();
            goBack();
        });
    });
</script>
}