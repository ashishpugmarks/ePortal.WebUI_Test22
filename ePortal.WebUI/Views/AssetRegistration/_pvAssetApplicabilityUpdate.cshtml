

@model ePortal.ViewModels.AssetApplicabilityUpdateVM

@{
    Layout = null;
}


<div class="row">
    <div class="col-md-12 with-icon-panel pad-l-r-30">
        <div class="row form-group">
            <div class="col-md-12">
                <input class="col-md-12 col-xs-12 borderblueall wholepadding bluecolor req_field" name="user_id" value="104" type="hidden">
            </div>
        </div>
        @using (Html.BeginForm("BulkUpdateAssetApplicability", "AssetRegistration", FormMethod.Post, new { encType = "multipart/form-data" }))
        {
            <input type="hidden" name="GridHtml" id="gridexcel" />
            <div class="body-content">
                <div id="form-group">
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                @*@Html.HiddenFor(m => m.SelectedIds)*@

                                <td class="text-right" style="width:20%">
                                    <input id="SelectedIds" name="SelectedIds" type="hidden">
                                    <b>Asset Applicability<span style="color: #ff0000">*</span></b>
                                </td>
                                <td class="col-md-3">
                                    @Html.DropDownList("ApplicabilityID", new List<SelectListItem>
                                    {
                                       new SelectListItem{Text="No",Value="-2"},
                                    }, new { @id = "ddlApplicabilityID_1", @class = "form-control" })
                                </td>

                                <td class="text-right">
                                    <b>Remarks<span style="color: #ff0000">*</span></b>
                                </td>
                                <td class="col-md-6">
                                    @Html.TextBoxFor(x => x.Remarks, new { @class = "form-control", @placeholder = "Please enter remarks", @required = "required" })
                                    @Html.ValidationMessageFor(m => m.Remarks, "", new { @class = "text-danger" })
                                </td>

                            </tr>
                            <tr>
                                <td colspan="12" style="text-align:center;">
                                    <div class="col-md-12" style="align-items: center;">
                                        <input type="submit" class="bttn btn-success btn_disable" value="Update" id="btnSubmitt"
                                               name="btnSubmit" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />

                                        <input type="button" class="bttn btn-success btn_disable" value="Cancel" data-dismiss="modal"
                                               name="btnCancel" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
        <div class="col-md-12">
            <span style="margin-left:14px">Selected Asset Top Secret Records for Asset Applicability List</span>
        </div>
        <div class="col-md-12" style="padding-top: 12px; margin-left: 14px;">
            <table class="table1 table-bordered table-condensed table-hover table-striped table-responsive">
                <thead>
                    <tr>
                        <th style="font-size: 15px;">S.No.</th>
                        <th style="font-size: 15px;">Primary Asset</th>
                        <th style="font-size: 15px;">Secondary Asset</th>
                        <th style="font-size: 15px;">Asset Type</th>
                        <th style="font-size: 15px;">Asset Location</th>
                        <th style="font-size: 15px;">Asset Owner</th>
                        <th style="font-size: 15px;">Asset Custodian</th>
                        <th style="font-size: 15px;">Asset User</th>
                        <th style="font-size: 15px;">Classification</th>
                        <th style="font-size: 15px;">Remarks</th>
                        <th style="font-size: 15px;">Applicability</th>
                        <th style="font-size: 15px;">Reasion For NA</th>
                    </tr>
                </thead>
                <tbody id="table1"></tbody>
            </table>
        </div>

        <div class="clearfix"></div>
    </div>
</div>
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
    $(document).ready(function () {
        $('#Schedulersss').val(" ");

    });

    function closedialog() {
        document.location.reload(true);

    }
</script>








