@{
    var resultMsg = TempData["ResultMsg"] as int?;
    TempData.Remove("ResultMsg");
}
@section Scripts{
   
@if (resultMsg != null)
{
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        document.addEventListener("DOMContentLoaded", function() {
            var resultMsg = @resultMsg;
            if (resultMsg == 1) {
                alert("Asset register approval request has been approved successfully.");
            } else if (resultMsg == 2) {
                alert("There is some problem, please try again later.");
            } else if (resultMsg == 3) {
                alert("You have successfully sent back the Asset register approval request.");
            }
        });
    </script>
}}
