<div class="row">
    <table class="table-responsive table table-bordered"  style="width:100%;font-size:10px;height: 40px;">  @* Updated by TTL ::  SR103777 > CR6964 *@
        <thead style=" background: #e9e9e9;">    @* Updated by TTL ::  SR103777 > CR6964 *@
            <tr> @* Updated by TTL ::  SR103777 > CR6964 *@
                <th style="width:60px;font-size:18px;text-align:center;border:1px solid;">Operation</th>
                <th style="width:50px;font-size:18px;text-align:center;border:1px solid;height: 40px;padding-top: 13px;">Division Name</th>
                <th style="width:50px;font-size:18px;text-align:center;border:1px solid;">ISSC Member</th>
                <th style="width:50px;font-size:18px;text-align:center;border:1px solid;">Asset Updation (self)</th>
                @if (ViewBag.IS_ITOPRATION)
                {
                <th style="width:50px;font-size:18px;text-align:center;border:1px solid;">ITGRC Head Approval</th> }@*Added by Aumento for SR91196*@@* Added By Aumento :: SR102194 *@
                <th style="width:50px;font-size:18px;text-align:center;border:1px solid;">Division Head Approval</th>
                <th style="width:50px;font-size:18px;text-align:center;border:1px solid;">Operating Head Approval</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in ViewBag.ISSC_MemberData)
            {
                <tr>
                    <td style="width:50px;font-size:18px;text-align:center;border:1px solid;">@item.OperationName</td>
                    <td style="width:50px;font-size:18px;text-align:center;border:1px solid;">@item.DivisionName</td>
                    <td style="width:50px;font-size:18px;text-align:center;border:1px solid;">@item.ISSCMember</td>
                    <td style="text-align:center;border:1px solid;">   @* Updated by TTL ::  SR103777 > CR6964 *@
                        @if (item.ISSC_Member_Submit_Status == 1)
                        {
                            <i style="color: green;font-size: 20px;" class="glyphicon glyphicon-check"></i> // Added By Aumento :: SR102194

                            <span style="font-size: 14px;">@Convert.ToDateTime(item.ISSC_Member_Submit_Date).ToString("dd/MM/yyyy")</span> @* Updated by TTL ::  SR103777 > CR6964 *@
                        }
                        else
                        {
                            <i style="color: orangered;font-size: 20px;" class="glyphicon glyphicon-exclamation-sign"></i> // Added By Aumento :: SR102194
                        }
                    </td>
                    @*Added by Aumento for SR91196*@
                   @* START :: Added By Aumento :: SR102194  *@ 
                    @if (ViewBag.IS_ITOPRATION)
                    {
                        <td style="text-align:center;border:1px solid;">  @* Updated by TTL ::  SR103777 > CR6964 *@
                            @if (item.ISSC_Member_Submit_Status == 1)
                            {
                                if (item.ITGRCHead_Submit_Status == 1)
                                {
                                    <i style="color: green;font-size: 20px;" class="glyphicon glyphicon-check"></i>

                                    <span style="font-size: 14px;">@Convert.ToDateTime(item.ISSC_Member_Submit_Date).ToString("dd/MM/yyyy")</span>  @* Updated by TTL ::  SR103777 > CR6964 *@
                                }
                                else if (item.ITGRCHead_Submit_Status == null)
                                {
                                    <i style="color: orangered;font-size: 20px;" class="glyphicon glyphicon-exclamation-sign"></i>
                                }
                                else
                                {
                                    <i style="color: blue; font-size: 20px;" class="glyphicon glyphicon-unchecked"></i>
                                }
                            }
                            else
                            {
                                <i style="color: blue; font-size: 20px;" class="glyphicon glyphicon-unchecked"></i>
                            }
                        </td>
                    }
                  @* END :: Added By Aumento :: SR102194  *@ 
                    @*Added by Aumento for SR91196*@
                    <td style="text-align:center;border:1px solid;">  @* Updated by TTL ::  SR103777 > CR6964 *@
                        @* START :: Added By Aumento :: SR102194  *@
                        @if (item.ISSC_Member_Submit_Status == 1)
                        {
                            if (item.DivisionHead_Submit_Status == 1)
                            {
                                <i style="color: green;font-size: 20px;" class="glyphicon glyphicon-check"></i>
                                <span style="font-size: 14px;"> @Convert.ToDateTime(item.DivisionHead_Submit_Date).ToString("dd/MM/yyyy")</span>  @* Updated by TTL ::  SR103777 > CR6964 *@
                            }
                            @*Added by aumento as on 17062024 for SR71836---------------------------------------------*@
                        else if ((ViewBag.IS_ITOPRATION == true) && item.ITGRCHead_Submit_Status == null)
                        {
                            <i style="color: blue; font-size: 20px;" class="glyphicon glyphicon-unchecked"></i>
                        }
                        else if (((ViewBag.IS_ITOPRATION == false) || ((ViewBag.IS_ITOPRATION == true && item.ITGRCHead_Submit_Status == 1))) && item.DivisionHead_Submit_Status == null)
                        {

                            <i style="color:orangered; font-size: 20px;" class="glyphicon glyphicon-exclamation-sign"></i>

                        }
                        else
                        {
                            <i style="color: blue; font-size: 20px;" class="glyphicon glyphicon-unchecked"></i>
                        }
                        @*--------------------------------------------------------------------------------------------*@
                        }
                        else
                        {
                            <i style="color: blue; font-size: 20px;" class="glyphicon glyphicon-unchecked"></i>
                        }
                    </td>

                    <td style="text-align:center;border:1px solid;">  @* Updated by TTL ::  SR103777 > CR6964 *@
                        @if (item.ISSC_Member_Submit_Status == 1)
                        {
                            if (item.OperatingHead_Submit_Status == 1)
                            {

                                <i style="color: green; font-size: 20px;" class="glyphicon glyphicon-check"></i>
                                <span style="font-size: 14px;"> @Convert.ToDateTime(item.OperatingHead__Submit_Date).ToString("dd/MM/yyyy")</span>  @* Updated by TTL ::  SR103777 > CR6964 *@
                            }
                            else if (item.DivisionHead_Submit_Status == 1 && item.OperatingHead_Submit_Status == null)
                            {
                                <a href="@Url.Action("AssetDetailsApproveByOperatingHead", "AssetRegistration", new { ISSC_Code = item.ISSCMember_EmpCode })">
                                    <i style="color:orangered; font-size: 20px;" class="glyphicon glyphicon-exclamation-sign"></i>
                                </a>
                            }
                            else
                            {
                                <i style="color: blue; font-size: 20px;" class="glyphicon glyphicon-unchecked"></i>
                            }
                        }
                        else
                        {
                            <i style="color: blue; font-size: 20px;" class="glyphicon glyphicon-unchecked"></i>
                        }
                        @* END :: Added By Aumento :: SR102194  *@
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>
<div class="row">
    <p style="font-size:18px;font-weight: bold;text-align: center;padding-top: 1%;padding-bottom: 1%;">Last Year Information Asset Registers</p>
    <table class="table-responsive table table-bordered" style="width:100%;font-size:10px;height: 40px;">  @* Updated by TTL ::  SR103777 > CR6964 *@
        <thead style=" background: #e9e9e9;">  @* Updated by TTL ::  SR103777 > CR6964 *@
            <tr>  @* Updated by TTL ::  SR103777 > CR6964 *@
            @*<tr style="background-color:rgba(44, 169, 226, 1);">*@
                <th style="width:32%;font-size:18px;text-align:center;border:1px solid;">Operation</th>
                <th style="width:50px;font-size:18px;text-align:center;border:1px solid;height: 40px;padding-top: 13px;">Division Name</th>
                <th style="width:10%;font-size:18px;text-align:center;border:1px solid;">ki</th>
                <th style="width:10%;font-size:18px;text-align:center;border:1px solid;">Details</th>
            </tr>
        </thead>
        <tbody>
            @if (ViewBag.Lastki_details.Count > 0 && ViewBag.Lastki_details != null)
            {
                foreach (var item in ViewBag.Lastki_details)
                {
                    <tr style="text-align:center;">
                        <td style="width:50px;font-size:18px;text-align:center;border:1px solid;">@item.OperationName</td>
                        <td style="width:50px;font-size:18px;text-align:center;border:1px solid;">@item.DIVISIONNAMEN</td>
                        <td style="width:2px;font-size:18px;text-align:center;border:1px solid;">@item.KICODE</td>
                        <td style="width:2px;font-size:18px;text-align:center;border:1px solid;"><a style="font-size: 25px;" href="@Url.Action("Get_Last_Ki_Asset_Details_OH", "AssetRegistration", new { SkyiId = @item.SYKIID, OPID=item.OPID })" class="glyphicon glyphicon-list-alt"></a></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" style="font-size:14px;border:1px solid;text-align:center;">No Record Found.</td>
                    <td style="display: none"></td>
                </tr>
            }
        <tbody>
    </table>
</div>
