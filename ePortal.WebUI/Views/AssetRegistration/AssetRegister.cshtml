<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>
    @if (TempData["msg"] != null)
    {
        <div style="vertical-align: middle;width:98%;margin-left:.5%;">
            <div style="padding:8px; font-size:12px;font-weight:normal;" class="error">@TempData["msg"]</div>
        </div>
    }

    @using (Html.BeginForm("AssetRegister", "AssetRegistration", FormMethod.Post, new { encType = "multipart/form-data", id = "AssetRegister" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(m => m.ID)
        @Html.HiddenFor(m => m.Primary)

        @Html.Hidden("Asset_Count", (object)ViewBag.Asset_details_List.Count)
        @Html.Hidden("End_date_Check", (object)ViewBag.EnddateCheck)
        @Html.Hidden("Final_Submit_Check", (object)ViewBag.Final_Submit_Check)

        @Html.Hidden("Primary_Asset_Value", (object)ViewBag.Primary_Asset_Value)
        @Html.Hidden("Retention_Year_value", (object)ViewBag.Retention_Year_value)
        @Html.Hidden("Action_Value", (object)ViewBag.Action_Value)
        @Html.HiddenFor(m => m.Classification_Edit_ID)
        @Html.Hidden("OrgnizationMapping_check", (object)ViewBag.OrgnizationMapping_check)
        @Html.HiddenFor(m => m.SYKIID)

        <div class="body-content" style="overflow-x:hidden">
            <div id="msform">
                @Html.DropDownList("SYKIID", ViewBag.SYKIData as SelectList, new { @class = "form-control", name = "Ki", id = "Ki", @style = "display:none;" })
                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <tr>
                            <td class="text-right">
                                <b>Primary Asset<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                <div class="col-md-12">
                                    @Html.DropDownListFor(x => x.PrimaryId, ViewBag.PrimaryId as SelectList, "- Select -", new { @class = "form-control" })
                                </div>
                            </td>
                            <td class="text-right">
                                <b>Other<span style="color: #ff0000"></span></b>
                            </td>
                            <td class="text-right">
                                @Html.TextBoxFor(m => m.Primarytxt, new { @class = "form-control", @placeholder = "Please enter primary asset", @maxlength = "250" })
                            </td>
                            <td class="text-right">
                                <b id="txt_appli">Asset Applicability<span style="color: #ff0000"></span></b>
                            </td>
                            <td class="text-right">
                                @Html.DropDownList("ApplicabilityID", new List<SelectListItem>
                        {
                        new SelectListItem{Text="Yes",Value="1"},
                         new SelectListItem{Text="No",Value="-2"},
                        }, new { @id = "ddlApplicabilityID", @class = "form-control" }
                                )
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right">
                                <b>Secondary<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2" colspan="5">
                                <div class="col-md-12">
                                    @Html.TextBoxFor(x => x.Secondary, new { @class = "form-control", @placeholder = "Please enter secondary asset", @maxlength = "250" })
                                </div>
                            </td>

                        </tr>
                        <tr>
                            <td class="text-right"><b>Asset Type <span style="color: #ff0000">*</span></b></td>
                            <td class="col-md-2">
                                @Html.DropDownList("AssetsID", new List<SelectListItem>
                        {
                        new SelectListItem{Text="Select",Value=""},
                        new SelectListItem{Text="Information Hard",Value="1"},
                         new SelectListItem{Text="Information Soft",Value="2"},
                          new SelectListItem{Text="Physical",Value="3"},
                           new SelectListItem{Text="People",Value="6"},
                           new SelectListItem{Text="Software",Value="4"},
                            new SelectListItem{Text="Service",Value="5"},
                        }, htmlAttributes: new { @id = "ddlAssetTypeID", @class = "form-control" })
                            </td>
                            <td class="text-right"><b>Asset Location<span style="color: #ff0000">*</span></b></td>
                            <td class="text-right">
                                @Html.TextBoxFor(m => m.Assetlocation, new { @class = "form-control", @placeholder = "Please enter asset location", @maxlength = "250" })
                            </td>
                            <td class="text-right">
                                <b>Classification<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                @Html.DropDownList("ClassificationID", new List<SelectListItem>
                        {
                        new SelectListItem{Text="Select",Value=" "},
                        new SelectListItem{Text="Top secret",Value="1"},
                         new SelectListItem{Text="Secret",Value="2"},
                          new SelectListItem{Text="Internal",Value="3"},
                        }, new { @id = "ddlAssetClassificationID", @class = "form-control" })
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right"><b>Asset Owner<span style="color: #ff0000">*</span></b></td>
                            <td class="text-right">
                                @Html.TextBoxFor(m => m.AssetOwner, new { @class = "form-control", @placeholder = "Please enter asset owner", @maxlength = "250" })
                            </td>
                            <td class="text-right"><b>Asset Custodian<span style="color: #ff0000">*</span></b></td>
                            <td class="text-right">
                                @Html.TextBoxFor(m => m.Custodian, new { @class = "form-control", @placeholder = "Please enter asset custodian", @maxlength = "250" })
                            </td>
                            <td class="text-right"><b>Asset User<span style="color: #ff0000">*</span></b> </td>
                            <td class="text-right">
                                @Html.TextBoxFor(m => m.AssetUser, new { @class = "form-control", @placeholder = "Please enter asset user", @maxlength = "250" })
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right">
                                <b>Retention Period<span style="color: #ff0000">*</span></b>
                            </td>
                            <td>
                                @Html.DropDownListFor(x => x.Retention_Year, ViewBag.Retention_Year as SelectList, "- Select Year -", new { @class = "form-control" })</td>
                            <td class="col-md-2">
                                 @Html.DropDownList("Retention_Month", new List<SelectListItem>
                        {
                        new SelectListItem{Text="- Select Month -",Value=""},
                        new SelectListItem{Text="0",Value="0"},
                        new SelectListItem{Text="1",Value="1"},
                         new SelectListItem{Text="2",Value="2"},
                          new SelectListItem{Text="3",Value="3"},
                            new SelectListItem{Text="4",Value="4"},
                              new SelectListItem{Text="5",Value="5"},
                                new SelectListItem{Text="6",Value="6"},
                                  new SelectListItem{Text="7",Value="7"},
                                    new SelectListItem{Text="8",Value="8"},
                                      new SelectListItem{Text="9",Value="9"},
                                        new SelectListItem{Text="10",Value="10"},
                                          new SelectListItem{Text="11",Value="11"},
                                            new SelectListItem{Text="12",Value="12"},
                        }, new { @id = "Retention_Month", @class = "form-control" }) 
                            </td>
                            <td class="text-right">
                                <b>Remarks<span style="color: #ff0000"></span></b>
                            </td>
                            <td class="text-right" colspan="2">
                                @Html.TextBoxFor(m => m.Retention_Remarks, new { @class = "form-control", @placeholder = "Please enter remarks", @maxlength = "250" })
                            </td>

                        </tr>
                        <tr id="txt_reason" style="display:none;">
                            <td class="text-right">
                                <b>Reason for NA<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="text-right" colspan="6">
                                @Html.TextBoxFor(m => m.ISSC_Member_Reason, new { @class = "form-control", @placeholder = "Please enter reason for asset non-applicability ", @maxlength = "250" })
                            </td>
                        </tr>
                        <tr>
                            <td colspan="10" style="text-align:center;">
                                <div class="col-md-12" style="align-items: center;">
                                    <input type="submit" class="bttn btn-success" value="Submit" id="btnSubmit" data-loading-text="Submitting..." autocomplete="off"
                                           name="btnSubmit" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            @* Added by TTL ::  SR103777 > CR6964  *@ 
           @if (ViewBag.IsEdit == "Y" || ViewBag.ISSCMEMBERDATETIME == null)
           {
            <div style="color: black;padding: 4px;display:flex;">
                <span style=" color: red; font-size: 22px; font-weight: bold;  display: block; margin-bottom: 10px; ">
                    Note :
                </span>
                &nbsp;<p style=" font-size: 18px; line-height: 1.5; margin: 0; ">   If you will Add/ Edit/ Delete any Asset then after the updation, you must submit the request. Approval workflow will be re-initiated. </p>
            </div>
           }
           @* Added by TTL ::  SR103777 > CR6964  *@ 
        </div>
    }
    <div style="padding: 1% !important;">
             @* START :: Added By Aumento :: SR102194  *@ 
        <div class="hidden" style="border-bottom:0px solid;padding: 6px; color: red;" id="DivwindowExpired">
            <strong style="color: black;"> Note:- </strong>Your window has expired! Kindly contact the ITGRC team
        </div>
    @* END :: Added By Aumento :: SR102194  *@ 
        <a id="btn_lastKi_data" href="@Url.Action("LastYear_Ki_AssetDetails", "AssetRegistration")" class="btn" style="background-color:darkblue;color:white;">Import Last Ki Asset Register</a>
        @if (ViewBag.OldISSC_MemberCode != null && ViewBag.OldISSC_MemberCode != 0)
        {
            <a id="btn_OldAssetRegisterData" href="@Url.Action("OldAssetRegisterData", "AssetRegistration")" class="btn" style="background-color:darkblue;color:white;">View Current Ki Asset Register</a>
        }

        <button class="bttn btn-success btn_disable" id="btn-export" style="background-color: #ccc; border-color: #4e4e4e;color: #232121; font-weight : bold ;float:right;">Export to Excel</button>
        <a id="btnExportPDF" href="@Url.Action("GeneratePdfReport", "AssetRegistration")" class="bttn btn-success btn_disable" style="background-color: #ccc; border-color: #4e4e4e;color: #232121; font-weight : bold ;float:right;margin-right:5px;">Export to PDF</a> @*Added By Aumento *@


        <div style="padding-left: 15px !important;">
            <table class="table table-responsive" style="font-size:13px;border:1px solid; overflow-x:scroll;" id="GetData">
                <thead>
                    <tr style="background-color: lightblue;">
                        <th style="border:1px solid;text-align:center; width:5px;font-weight:bold;">S.No.</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Primary Asset")</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Secondary Asset")</th>
                        <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("Asset Type")</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset Location")</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset Owner")</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset Custodian")</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset User")</th>
                        <th style="border:1px solid;text-align:center; width:5%;font-weight:bold;">@Html.DisplayName("Classification")</th>
                        <th style="border:1px solid;text-align:center; width:5%;font-weight:bold;">@Html.DisplayName("Retention Period")</th>
                        <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Remarks</th>
                        <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Applicability</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Reason for NA")</th>
                        <th style="border:1px solid;text-align:center; width:1%;font-weight:bold;" class="noExl">Edit</th>
                        <th style="border:1px solid;text-align:center; width:1%;font-weight:bold;" class="noExl">Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        foreach (var item in ViewBag.Asset_details_List)
                        {
                            var s = item.Retention_Period;
                            var as_type = item.AssetsID;
                            var cls_type = item.ClassificationID;

                            <tr>
                                <td style="border:1px solid;text-align:center;">@index</td>
                                <td style="border:1px solid;text-align:center;">@item.Primary</td>
                                <td style="border:1px solid;text-align:center;">@item.Secondary</td>
                                <td style="border:1px solid;text-align:center;">
                                    @if (as_type == 1)
                                    {
                                        <p>Information Hard</p>
                                    }
                                    @if (as_type == 2)
                                    {
                                        <p>Information Soft</p>
                                    }
                                    @if (as_type == 3)
                                    {
                                        <p>Physical</p>
                                    }
                                    @if (as_type == 4)
                                    {
                                        <p>Software</p>
                                    } @if (as_type == 5)
                                    {
                                        <p>Service</p>
                                    }
                                    @if (as_type == 6)
                                    {
                                        <p>People</p>
                                    }
                                </td>
                                <td style="border:1px solid;text-align:center;">@item.Assetlocation</td>
                                <td style="border:1px solid;text-align:center;">@item.AssetOwner</td>
                                <td style="border:1px solid;text-align:center;">@item.Custodian</td>
                                <td style="border:1px solid;text-align:center;">@item.AssetUser</td>
                                <td style="border:1px solid;text-align:center;">
                                    @if (cls_type == 1)
                                    {
                                        <p>Top secret </p>
                                    }
                                    @if (cls_type == 2)
                                    {
                                        <p>Secret </p>
                                    }
                                    @if (cls_type == 3)
                                    {
                                        <p>Internal</p>
                                    }
                                </td>
                                <td style="border:1px solid;text-align:center;">
                                    @if (s != null && s != "_")
                                    {
                                        string[] reslt = s.Split('_');
                                        var mth = reslt[0];
                                        var year = reslt[1];
                                        var yr = ""; var mth_ = "";
                                        if (year == "1" || year == "0")
                                        {
                                            yr = "Year";
                                        }
                                        else
                                        {
                                            yr = "Years";
                                        }
                                        if (mth == "1" || mth == "0")
                                        {
                                            mth_ = "Month";
                                        }
                                        else
                                        {
                                            mth_ = "Months";
                                        }
                                        <p>
                                            @(year + yr + " " + mth + mth_)
                                        </p>

                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }
                                </td>
                                <td style="border:1px solid;text-align:center;">@item.Retention_Remarks</td>
                                <td style="border:1px solid;text-align:center;">
                                    @if (item.ActionType == 1)
                                    {
                                        if (item.Reason_NA == null)
                                        {
                                            <p>Yes</p>
                                        }
                                        else
                                        {
                                            <p> No </p>
                                        }
                                    }
                                    else
                                    {
                                        <p> - </p>
                                    }
                                </td>
                                <td style="border:1px solid;text-align:center;">
                                    @item.Reason_NA
                                </td>
                                <td style="border:1px solid;text-align:center;" class="noExl">                                    
                                     @*@if (ViewBag.Final_Submit_Check == 0 && ViewBag.EnddateCheck == 0)*@  @*added by aumneto for SR71836*@ 
                                        @* START :: Added By Aumento :: SR102194  *@  
                                    @if (ViewBag.Final_Submit_Check == 0 || ViewBag.IsEdit == "Y")
                                    {  
                                         <a title="Edit" onclick="return Edit(@item.ID)" href="@Url.Action("AssetRegister", "AssetRegistration", new { id = @item.ID,IsEdit = "Y" })"><i class="glyphicon glyphicon-pencil"></i></a> // ,IsEdit = "Y" :: Added by TTL ::  SR103777 > CR6964
                                        if (cls_type == 1)
                                        {   
                                           
                                            <input type="checkbox" name="ID" value="@item.ID" class="custom-checkbox" />
                                        }
                                    }
                                        @* END :: Added By Aumento :: SR102194  *@ 


                                </td>
                                <td style="border:1px solid;text-align:center;" class="noExl">
                                    <input type="hidden" value="@item.ActionType" id="tbl_act_type" />                                  
                                    @*@if (item.ActionType == 0 && ViewBag.Final_Submit_Check == 0 && ViewBag.EnddateCheck == 0)*@    @*added by aumneto for SR71836*@ 
                                   @if ((item.ActionType == 0 && ViewBag.Final_Submit_Check == 0 ) || (item.ActionType == 0 && ViewBag.IsEdit == "Y")) // || (item.ActionType == 0 && ViewBag.IsEdit == "Y") :: Added by TTL ::  SR103777 > CR6964
                                    {
                                        <a title="Delete" href="@Url.Action("DeleteAssetRegister", "AssetRegistration", new { id = @item.ID ,IsEdit = "Y"})"><i class="glyphicon glyphicon-trash"></i></a> // ,IsEdit = "Y" :: Added by TTL ::  SR103777 > CR6964
                                    }
                                    else
                                    {
                                        <p>-</p>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                        if (ViewBag.Asset_details_List.Count == 0)
                        {
                            <tr>
                                <td colspan="13" style="border:1px solid;text-align:center;">No record found.</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="13"><input type="checkbox" id="chk_TC" /><b> I have mentioned all division’s information assets & I will ensure to adhere/Implement asset handling guidelines as per their asset classifications.</b> </td>
                    </tr>
                </tfoot>
            </table>
