                        window.location.href = data.url + '?IsEdit=' +  '@ViewBag.IsEdit'; //  Added by TTL ::  SR103777 > CR6964 
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                    // Display alert for general error
                    alert('An error occurred while processing your request.');
                }
            });

        });

        @*Added By Aumento End *@


        @*// $("#Ki").val(@ViewBag.curki);*@
        var table = $('#GetData').DataTable({
            pageLength: 1000,
        });



        $('#btn-export').on('click', function () {
            var btn = $(this).button('loading');
            $('<table>')
                .append($(table.table().header()).clone())
                .append(table.$('tr').clone()).table2excel({
                    exclude: ".noExl",
                    name: "NominationList",
                    filename: "Asset List_" + new Date().toISOString().replace(/[\-\:\.]/g, "_"),
                    fileext: ".xls",
                    exclude_img: true,
                    exclude_links: true,
                    exclude_inputs: true,
                    columns: [0, 1, 2, 3]
                });
            setTimeout(function () {
                btn.button('reset');
            }, 2000);
        });
    })
</script>

