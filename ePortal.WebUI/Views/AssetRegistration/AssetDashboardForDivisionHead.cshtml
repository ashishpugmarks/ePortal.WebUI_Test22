<div class="row">
    @*  Start - text-align: center and table , thead 's style and classs  Updated by TTL ::  SR103777 > CR6964 *@ 
    @*<div class="col-lg-3 col-md-3">
        <a href="~/assets/Asset Register/ISSC Nomination File/Information Asset Register Guideline updated.pdf" target="_blank">
            <img style="padding-right: 1%;" src="~/assets/Asset Register/ISSC Nomination File/Guideline.jpg" class="img-responsive" />
        </a>
    </div>*@
    @*<div class="col-lg-9 col-md-9">*@
    <div class="col-lg-12 col-md-12">
        <p style="font-size:18px;font-weight: bold;text-align: center;padding-bottom: 2%;">Current Year Information Asset Register(s)</p>
        <table class="table-responsive table table-bordered" style="font-size:13px;border:1px solid;font-weight: bold;">
            <thead style=" background: #e9e9e9;">
                <tr>
                    <th style="border:1px solid;text-align: center;">Division Name</th>
                    <th style="border:1px solid;text-align: center;">ISSC Member</th>
                    <th style="border:1px solid;text-align: center;">Asset Updation (self)</th>
                    @if (ViewBag.IS_ITOPRATION)
                    {
                        <th style="border:1px solid;text-align: center;">ITGRC Head Approval</th>
                    }
@*Added by Aumento for SR91196*@ @* Added By Aumento :: SR102194 *@
                    <th style="border:1px solid;text-align: center;">Division Head Approval</th>
                    <th style="border:1px solid;text-align: center;">Operating Head Approval</th>
                    <th style="border:1px solid;text-align: center;">Target Date</th>
                    <th style="border:1px solid;text-align: center;">Days Left</th>
                    @*  End - text-align: center and table , thead 's style and classs  Updated by TTL ::  SR103777 > CR6964 *@

                </tr>
            </thead>
            <tbody>
                @foreach (var item in ViewBag.AssetsDetailList)
                {
                    <tr>
                        <td style="border:1px solid;">@item.DivisionName</td>
                        <td style="border:1px solid;">@item.ISSCMember</td>
                        <td style="text-align:center;border:1px solid;">
                            @if (item.ISSC_Member_Submit_Status == 1)
                            {
                                <i style="color: green; font-size: 18px;" class="glyphicon glyphicon-check"></i>   @*  <br /> Removed by TTL ::  SR103777 > CR6964 *@ 
                                            <span style="font-size: 14px;"> @Convert.ToDateTime(item.ISSC_Member_Submit_Date).ToString("dd/MM/yyyy")</span>
                            }
                            else
                            {
                                <i style="color: orangered; font-size: 18px;" class="glyphicon glyphicon-exclamation-sign"></i>
                            }
                        </td>
                        @*Added by Aumento for SR91196*@
                        @* START :: Added By Aumento :: SR102194  *@
                        @if (ViewBag.IS_ITOPRATION)
                        {
                            <td style="text-align:center; border:1px solid;">
                                @if (item.ITGRCHead_Submit_Status == 1)
                                {

                                    <i style="color: green; font-size: 18px;" class="glyphicon glyphicon-check"></i>  @*  <br /> Removed by TTL ::  SR103777 > CR6964 *@
                                    <span style="font-size: 14px;"> @Convert.ToDateTime(item.ITGRCHead_Submit_Date).ToString("dd/MM/yyyy")</span>
                                }
                                else if (item.ISSC_Member_Submit_Status == 1 && item.ITGRCHead_Submit_Status == null)

                                {
                                    <i style="color:orangered; font-size: 18px;" class="glyphicon glyphicon-exclamation-sign"></i>
                                }
                                else
                                {
                                    <i style="color: blue; font-size: 18px;" class="glyphicon glyphicon-unchecked"></i>
                                }
                            </td>
                        }
                        @* END :: Added By Aumento :: SR102194  *@
                        @*Added by Aumento for SR91196*@
                        <td style="text-align:center;border:1px solid;">
                            @if (item.ISSC_Member_Submit_Status == 1)
                            {
                                if (item.DivisionHead_Submit_Status == 1)
                                {
                                    <a href="@Url.Action("AssetRemarkByDivisionHead", "AssetRegistration", new { ISSC_Code = item.ISSCMember_EmpCode })">
                                        <i style="color: green; font-size: 18px;" class="glyphicon glyphicon-check"></i>
                                    </a>  @*  <br /> Removed by TTL ::  SR103777 > CR6964 *@
                                    <span style="font-size: 14px;"> @Convert.ToDateTime(item.DivisionHead_Submit_Date).ToString("dd/MM/yyyy")</span>
                                }
                                @*Added by aumento as on 17062024 for SR71836---------------------------------------------*@
                                else if ((ViewBag.IS_ITOPRATION == true) && item.ITGRCHead_Submit_Status == null) //  @* Added By Aumento :: SR102194 *@
                                {
                                    <i style="color: blue; font-size: 18px;" class="glyphicon glyphicon-unchecked"></i>
                                }
                                else if (((ViewBag.IS_ITOPRATION == false) || ((ViewBag.IS_ITOPRATION == true && item.ITGRCHead_Submit_Status == 1))) && item.DivisionHead_Submit_Status == null)  // @* Added By Aumento :: SR102194 *@
                                {
                                    <a href="@Url.Action("AssetDetailsApproveByDivisionHead", "AssetRegistration", new { ISSC_Code = item.ISSCMember_EmpCode })">
                                        <i style="color:orangered; font-size: 18px;" class="glyphicon glyphicon-exclamation-sign"></i>
                                    </a>
                                }
                                @*--------------------------------------------------------------------------------------------*@
                            }
                            else
                            {
                                <i style="color: blue; font-size: 18px;" class="glyphicon glyphicon-unchecked"></i>
                            }
                        </td>
                        <td style="text-align:center; border:1px solid;">
                            @* START :: Added By Aumento :: SR102194  *@
                            @if (item.ISSC_Member_Submit_Status == 1)
                            {
                                if (item.OperatingHead_Submit_Status == 1)
                                {

                                    <i style="color: green; font-size: 18px;" class="glyphicon glyphicon-check"></i>
                                    <span style="font-size: 14px;"> @Convert.ToDateTime(item.OperatingHead__Submit_Date).ToString("dd/MM/yyyy")</span>
                                }
                                else if (item.DivisionHead_Submit_Status == 1 && item.OperatingHead_Submit_Status == null)
                                {
                                    <i style="color:orangered; font-size: 18px;" class="glyphicon glyphicon-exclamation-sign"></i>
                                }
                                else
                                {
                                    <i style="color: blue; font-size: 18px;" class="glyphicon glyphicon-unchecked"></i>
                                }
                                @* END :: Added By Aumento :: SR102194  *@
                            }
                            else
                            {
                                <i style="color: blue; font-size: 18px;" class="glyphicon glyphicon-unchecked"></i>
                            }
                        </td>
                        <td style="border:1px solid;text-align: center;">@Convert.ToDateTime(item.EndDate).ToString("dd-MM-yyyy")</td>  @* Updated by TTL ::  SR103777 > CR6964 *@

                        <td style="border:1px solid;">
                            @{
                                var days = "";
                                DateTime end_dates = Convert.ToDateTime(item.EndDate);
                                int nodaysleft = end_dates.Subtract(DateTime.Now.Date).Days;
                                if (item.ISSCMember != null && item.OperatingHead_Submit_Status == null && nodaysleft > 0)   // Updated by TTL ::  SR103777 > CR6964 //
                                {
                                    days = nodaysleft + " Days";
                                }
                                else
                                {
                                    days = "";
                                }
                            }
                            @days
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
    @*start foreach loop*@
    <div class="col-lg-6 col-md-6">
        <p style="font-size:18px;font-weight: bold;text-align: center;padding-bottom: 2%;"> Last Year Information Asset Registers</p>
        <table class="table" style="font-size:13px;border:1px solid;margin-left:1.5%;" id="LastKi">
            <thead>
                <tr style="background-color: lightblue;text-align:center;">
                    <th style="text-align:center;">ki</th>
                    <th style="text-align:center;">Division Name</th>
                    <th style="text-align:center;"> Details </th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.DivisionList != null)
                {
                    foreach (var item in ViewBag.DivisionList)
                    {
                        <tr style="text-align:center;">
                            <td> @item.SYKIName </td>
                            <td> @item.DIVISION </td>
                            <td>
                                <a style="font-size: 25px;" href="@Url.Action("LastYearKiAssetDetails", "AssetRegistration", new { SkyiId = item.SYKI, DivId = item.DIVISIONID })" target="_blank" class="glyphicon glyphicon-list-alt"></a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2"> No Record Found.</td>
                        <td style="display: none"></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-lg-12 col-md-12" style="padding-top:0%;">&nbsp;</div>
    @*</div>*@   @* Updated by TTL ::  SR103777 > CR6964 *@
</div>

<div class="row">
    <div class="col-lg-12 col-md-12" style="background-color:rgb(0,32,96);color:white;">
        <p style="font-size: 20px;padding: .5%">
            <a href="~/Asset Register/ISSC Nomination File/Information Asset Register Guideline updated.pdf" target="_blank" style="color:white;">
                Please
                click
                on Guidelines to understand “How to fill Information Asset Register”. If you already
                familiar with this, please start activity directly for current ki by clicking on pending icon.
            </a>
        </p>
    </div>
</div>
