    </div>
    @using (Html.BeginForm("EditUpdateNominationDate", "AssetRegistration", FormMethod.Post, new { encType = "multipart/form-data", id = "SetPeriodForISSCMemberNomination" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(x => x.PeriodForISSCMemberNominationID)
        @Html.HiddenFor(x => x.ActionType)

        <div class="body-content" style="overflow-x:hidden">
            <div id="msform">
                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <tr>

                            <td class="text-right">
                                <b>Ki<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                <div class="col-md-12">
                                    @Html.DropDownList("SYKIID", ViewBag.SYKIData as SelectList, "Select KI", new { @class = "form-control", @required = "required" })
                                    @Html.ValidationMessageFor(m => m.SYKIID, "", new { @class = "text-danger" })
                                </div>
                            </td>
                            <td class="text-right">
                                <b>Operation<span style="color: #ff0000"></span></b>
                            </td>
                            <td class="col-md-2">


                                @Html.DropDownList("OPERATIONID", (IEnumerable<SelectListItem>)ViewBag.OpList, "- Select -", new { @id = "ddlOp", @class = "form-control", name = "Division" })

                            </td>
                            <td class="text-right">
                                <b>Division<span style="color: #ff0000"></span></b>
                            </td>
                            <td class="col-md-2">
                                @Html.DropDownList("DIVISIONID", (IEnumerable<SelectListItem>)ViewBag.DivisionList, "- Select -",
                                    new { @id = "DIVISIONID", @class = "form-control" })                             
                            </td>
                            <td class="text-right">
                                <b>Start Date<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                <div class="col-md-12">
                                    @Html.TextBoxFor(x => x.StartDate, new { @readonly = "readonly", @class = "form-control datepic", @placeholder = "dd/mm/yyyy", @required = "required" })
                                    @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                                </div>
                            </td>
                            <td class="text-right">
                                <b>End Date<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                <div class="col-md-12">
                                @Html.TextBoxFor(x => x.EndDate, new { @readonly = "readonly", @class = "form-control datepic", @placeholder = "dd/mm/yyyy", @required = "required" })
                                    @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="10" style="text-align:center;">
                                <div class="col-md-12" style="align-items: center;">
                                    <input type="submit" class="bttn btn-success btn_disable" value="Submit" id="btnSubmit"
