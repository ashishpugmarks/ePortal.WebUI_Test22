<div class="row" id="Grid">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>
    @using (Html.BeginForm("InsertUpdatePeriodITGRCSettingNew", "AssetRegistration", FormMethod.Post, new { encType = "multipart/form-data" }))
    {
        <input type="hidden" name="GridHtml" id="gridexcel" />
        <div class="body-content" style="overflow-x:hidden">
            <div id="form-group">
                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <tr>
                            @Html.HiddenFor(m => m.ID)
                            @Html.HiddenFor(m => m.SYKIID)
                            @Html.HiddenFor(m => m.OPERATIONID)
                            @Html.HiddenFor(m => m.DIVISIONID)
                            @Html.HiddenFor(m => m.CreatedBy)
                            @Html.HiddenFor(m => m.CreationDate)

                            <td class="text-right">
                                <b>ki<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-1">
                                @Html.TextBoxFor(m => m.SYKI, new { @readonly = "readonly", @class = "form-control" })
                            </td>
                            <td class="text-right">
                                <b>Operation<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                @Html.TextBoxFor(m => m.OperationName, new { @readonly = "readonly", @class = "form-control" })
                            </td>
                            <td class="text-right">
                                <b>Division<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                @Html.TextBoxFor(m => m.DivisionName, new { @readonly = "readonly", @class = "form-control" })
                            </td>
                            <td class="text-right">
                                <b>Start Date<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                @Html.TextBoxFor(m => m.StartDate, new { @readonly = "readonly", @class = "form-control", @placeholder = "dd/MM/yyyy", @required = "required" })
                            </td>
                            <td class="text-right">
                                <b>End Date<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                @Html.TextBoxFor(m => m.EndDate, new { @readonly = "readonly", @class = "form-control", @placeholder = "dd/MM/yyyy", @required = "required" })
                            </td>
                        </tr>
                        <tr>
                            <td colspan="12" style="text-align:center;">
                                <div class="col-md-12" style="align-items: center;">
                                    <input type="submit" class="bttn btn-success btn_disable" value="Update" id="btnSubmitt"
                                           name="btnSubmit" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="12">
                                <a title="Back" href="/AssetRegistration/PeriodSettingITGRC">
                                    <img src="~/images/icon_back.gif" border="0" alt="">
                                    Back
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
