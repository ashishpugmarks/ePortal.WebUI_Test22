<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $(function () {
        $('#StartDate').datepicker({
            format: "dd/mm/yyyy",
            todayHighlight: true,
            autoclose: true,
            clearBtn: true,
            startDate: new Date(),
        });

        $('#EndDate').datepicker({
            format: "dd/mm/yyyy",
            todayHighlight: true,
            autoclose: true,
            clearBtn: true,
            startDate: new Date(),
        });

    });

</script>

<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    $("#BtnCancel").click(function () {
        location.reload(true);

    });
</script>
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
    function BtnBack(ths, event) {
        window.location.href = "Search";
    }
</script>



<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
    $(document).ready(function () {
        $("#btnSubmitt").click(function () {
            var sdate = $('#StartDate').val();
            var edate = $('#EndDate').val();
            var ddlOp = $('#ddlOp');
            var ddldivID = $('#DIVISIONID');

            if ($('#SYKIID').val() == "") {
                alert('Please select ki.');
                return false;
            }
            else if (ddlOp.val() == "") {
                alert("Please select operation id!");
                return false;
            }
            else if (ddldivID.val() == "") {
                alert("Please select division id!");
                return false;
            }
            else if (sdate == "") {
                alert('Please enter start date.');
                return false;
            }
            else if (edate == "") {
                alert('Please enter end date.');
                return false;
            }

            else {
                var sdate = moment($('#StartDate').val(), 'DD-MM-YYYY');
                var edate = moment($('#EndDate').val(), 'DD-MM-YYYY');
                var a = new Date(sdate);
                var b = new Date(edate);
                if (a > b) {
                    alert('End date should be greater than start date.');
                    return false;
                }
            }
        });
    });
</script>
}
