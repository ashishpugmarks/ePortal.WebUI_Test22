<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
    $(document).ready(function () {
        if ($("#End_date_Check").val() == 0) {
            $("#btnSubmit").show();
            $("#btnFinalSubmit").show();
            $("#BtnDraft").show();
            $("#btn_lastKi_data").show();
            $("#BtnNoApplicable").show();


            if ($("#Final_Submit_Check").val() == 0) {
                $("#btnSubmit").show();
                $("#btnFinalSubmit").show();
                $("#BtnDraft").show();
                $("#btn_lastKi_data").show();
                $("#BtnNoApplicable").show();
            }
            else {
                $("#btnSubmit").hide();
                $("#btnFinalSubmit").hide();
                $("#BtnDraft").hide();
                $("#btn_lastKi_data").hide();
                $("#BtnNoApplicable").hide();
            }
        }
        else {
            $("#btnSubmit").hide();
            $("#btnFinalSubmit").hide();
            $("#BtnDraft").hide();
            $("#btn_lastKi_data").hide();
            $("#BtnNoApplicable").hide();
        }

        if ($("#OrgnizationMapping_check").val() == 0)
            $("#btn_lastKi_data").addClass("qwerty1");
        else
            $("#btn_lastKi_data").removeClass("qwerty1");

        if ($("#ID").val() == 0) {
            $("#PrimaryId").removeClass("qwerty");
            $("#ddlApplicabilityID,#txt_appli").hide();
        }
        else {
            $("#PrimaryId").attr("readonly", "readonly");
            $("#PrimaryId").addClass("qwerty");
            var s = $("#Primary_Asset_Value").val();
            var s1 = $("#Retention_Year_value").val();
            $("#PrimaryId").val(s);
            $("#Retention_Year").val(s1);
            var s2 = $("#Action_Value").val();
            if (s2 == 0) {
                $("#ddlAssetClassificationID").prop("disabled", false);
                $("#ddlApplicabilityID,#txt_appli").hide();
            }
            else {
                $("#ddlAssetClassificationID").prop("disabled", true);
                $("#ddlApplicabilityID,#txt_appli").show();
            }

            if ($('#ISSC_Member_Reason').val() != "") {
                $("#txt_reason").show(); $("#ddlApplicabilityID").val("-2");
                $("#Secondary,#ddlAssetTypeID,#Assetlocation,#AssetOwner,#Custodian,#Retention_Month,#Retention_Year,#AssetUser,#Retention_Remarks").prop("disabled", true);
                $("#Secondary,#ddlAssetTypeID,#Assetlocation,#AssetOwner,#Custodian,#Retention_Month,#Retention_Year,#AssetUser,#Retention_Remarks").val("");
            }
            else {
                $("#txt_reason").hide();
                $('#ISSC_Member_Reason').val("");
                $("#Secondary,#ddlAssetTypeID,#Assetlocation,#AssetOwner,#Custodian,#Retention_Month,#Retention_Year,#AssetUser,#Retention_Remarks").prop("disabled", false);
            }
        }
        $("#Primarytxt").prop("disabled", true);
        $("#PrimaryId").change(function () {
            var s = $("#PrimaryId").val();
            if (s == "-1")
                $("#Primarytxt").prop("disabled", false);
            else
                $("#Primarytxt").prop("disabled", true);
        });

        $("#Retention_Year1").change(function () {
            var s = $("#Retention_Year").val();
            if (s == 0) {
                $("#Retention_Month").addClass("qwerty");
                $("#Retention_Month").val(0);
            } else {
                $("#Retention_Month").removeClass("qwerty");
                $("#Retention_Month").val("");
            }

        });

        $("#ddlApplicabilityID").change(function () {
            var s = $("#ddlApplicabilityID").val();
            //var stext = $("#PrimaryId option:selected").text();
            //$("#Primary").val(stext);
            //if (s == "-1")
            //    $("#Primarytxt").prop("disabled", false);
            //else
            //    $("#Primarytxt").prop("disabled", true);
            if (s == "-2") {
                $("#txt_reason").show(); $('#ISSC_Member_Reason').val("");
                $("#Secondary,#ddlAssetTypeID,#Assetlocation,#AssetOwner,#Custodian,#Retention_Month,#Retention_Year,#AssetUser,#Retention_Remarks").prop("disabled", true);
                $("#Secondary,#ddlAssetTypeID,#Assetlocation,#AssetOwner,#Custodian,#Retention_Month,#Retention_Year,#AssetUser,#Retention_Remarks").val("");
            }
            else {
                $("#txt_reason").hide();
                $('#ISSC_Member_Reason').val("");
                $("#Secondary,#ddlAssetTypeID,#Assetlocation,#AssetOwner,#Custodian,#Retention_Month,#Retention_Year,#AssetUser,#Retention_Remarks").prop("disabled", false);
            }

        });

        $("#GetData tbody tr").each(function (i, row) {
            var $actualRow = $(row);
            if ($actualRow.find('#tbl_act_type').val() == 1) {
                $actualRow.css('background-color', '#f7f7055c');
                $actualRow.css('background-color', 'rgba(247, 247, 5, 0.36)');
            }
            else {
                // $actualRow.css('background-color', '');
            }
        });
    });
    $('#btnSubmit').on('click', function () {
        if ($("#ddlApplicabilityID").val() == "-2") {
            if ($('#ISSC_Member_Reason').val() == "") {
                alert('Please enter remarks.');
                return false;
            }
            $('form').validate();
            if ($('form').valid())
                $(this).button('loading'); // button text will be "Submitting!"
        }
        else {
            var sdate = $('#RetentionMonth').val();
            var syear = $('#Retention_Year').val();
            var AssetsID = $('#ddlAssetTypeID');
            if ($('#PrimaryId').val() == "") {
                alert('Please select primary asset.');
                return false;
            }
            else if ($('#PrimaryId').val() == "-1" && $('#Primarytxt').val() == "") {
                alert("Please enter primary asset.");
                return false;
            }
            else if ($("#Secondary").val() == "") {
                alert("Please enter secondary asset.");
                return false;
            }
            else if ($('#ddlAssetTypeID').val() == "") {
                alert("Please select asset type.");
                return false;
            }
            else if ($("#Assetlocation").val() == "") {
                alert('Please enter asset location.');
                return false;
            }
            else if ($("#ddlAssetClassificationID").val() == " ") {
                alert('Please select asset classification.');
                return false;
            }

            else if ($("#AssetOwner").val() == "") {
                alert('Please enter asset owner.');
                return false;
            }
            else if ($("#Custodian").val() == "") {
                alert('Please enter asset custodian.');
                return false;
            }
            else if ($("#AssetUser").val() == "") {
                alert('Please enter asset user.');
                return false;
            }
            else if (syear == "") {
                alert('Please enter retention period year.');
                return false;
            }
            else if ($('#Retention_Month').val() == "") {
                alert('Please enter retention period month.');
                return false;
            }
            $('form').validate();
            if ($('form').valid())
                $(this).button('loading'); // button text will be "Submitting!"
        }
    });
    $("#btnFinalSubmit").on('click', function () {
        //if ($("#Asset_Count").val() == 0) {
        //    alert("Please enter asset details.");
        //    return false;
        //}
        if ($("#chk_TC").prop('checked') != true) {
            alert("Please click on User Undertaking Checkbox.");
            return false;
        }
        else {
            $('#FinalSubmit_AssetDetails').validate();
            if ($('#FinalSubmit_AssetDetails').valid())
                $(this).button('loading');
        }
    }); _pvAssetApplicabilityUpdate.cshtm
</script>
@if (TempData["ResultMsg"] != null)
{
    if ((int)TempData["ResultMsg"] == 1)
    {
        <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
            alert("Data has been saved successfully.");
        </script>
    }
    else if ((int)TempData["ResultMsg"] == 2)
    {
        <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
            alert("There is some problem, please try again later.");
        </script>
    }
    else if ((int)TempData["ResultMsg"] == 3)
    {
        <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
            alert("You have already imported last ki asset register data.");
        </script>
    }
    else if ((int)TempData["ResultMsg"] == 4)
    {
        <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
            alert("Not able to import data kindly contact to ISMS Team.");
        </script>
    }
    else if ((int)TempData["ResultMsg"] == 5)
    {
        <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
            alert("Data is deleted successfully.");
        </script>
    }
}

<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
    $(document).ready(function () {
        $('#Btnback').on('click', function () {
            goBack();
        });
    });
</script>
