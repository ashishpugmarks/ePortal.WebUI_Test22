        width: 329px !important;
    }

    .bttn {
        background-color: #e3e3e3;
        color: #333;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
        font-size: 16px;
    }

    .dropdownt {
        width: 326px !important;
    }

    .resr {
        font-weight: bold;
        background-color: #C3E214;
        border-radius: 5px;
        border: 2px solid #ccc;
        text-align: center;
        padding: 5px 15px;
