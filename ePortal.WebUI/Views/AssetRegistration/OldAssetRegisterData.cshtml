        padding: 1px 4px;
        font-family: Roboto-Regular;
    }

    * {
        box-sizing: border-box;
    }

    .dropdown-check-list {
        display: inline-block;
    }

        .dropdown-check-list .anchor {
            position: relative;
            cursor: pointer;
            display: inline-block;
            padding: 5px 50px 5px 10px;
            border: 1px solid #ccc;
        }

            .dropdown-check-list .anchor:after {
                position: absolute;
                content: "";
                border-left: 2px solid black;
                border-top: 2px solid black;
                padding: 5px;
                right: 10px;
                top: 20%;
                -moz-transform: rotate(-135deg);
                -ms-transform: rotate(-135deg);
                -o-transform: rotate(-135deg);
                -webkit-transform: rotate(-135deg);
                transform: rotate(-135deg);
            }

            .dropdown-check-list .anchor:active:after {
                right: 8px;
                top: 21%;
            }

    dropdown-check-list ul.items {
        padding: 2px;
        display: none;
        margin: 0;
        border: 1px solid #ccc;
        border-top: none;
        width: 370px !important;
    }

    .dropdown-check-list ul.items li {
        list-style: none;
    }

    .dropdown-check-list.visible .anchor {
        color: #0094ff;
    }

    .dropdown-check-list.visible .items {
        display: block;
    }

    .cellpadding {
        padding: 5px 5px;
    }

    .form-wrapper {
        margin-top: 20px;
    }

    .spret {
        border: 1px solid #ccc;
    }

    .form-label {
        color: #000;
        font-size: 10px;
    }

    .form-input {
        font-size: 13px;
        padding: 2px 5px;
        border: 1px solid #ccc;
        // width:220px !important;
    }

    .field-indicator {
        color: #F00;
        vertical-align: middle;
    }

    .multiselect-container > li > a {
        padding: 0px;
        width: 320px !important;
    }

    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    .bttn {
        background-color: #e3e3e3;
        color: #333;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
        font-size: 16px;
    }

    .ui-widget-header, .ui-state-default, ui-button {
        font-weight: bold;
        font-size: 16px;
    }

    .ui-dialog .ui-dialog-content {
        font-size: 14px;
    }

    .ui-dialog-buttonset {
        font-size: 16px;
    }

    .btn1 {
        width: 190px !important;
        font-size: 14px !important;
        background-color: #e3e3e3;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
    }

    .ui-dialog-titlebar-close:before {
        content: "x";
    }
</style>
}
<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>
    @if (TempData["msg"] != null)
    {
        <div style="vertical-align: middle;width:98%;margin-left:.5%;">
            <div style="padding:8px; font-size:12px;font-weight:normal;" class="error">@TempData["msg"]</div>
        </div>
    }

    @using (Html.BeginForm("AssetRegister", "AssetRegistration", FormMethod.Post, new { encType = "multipart/form-data", id = "AssetRegister" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(m => m.ID)
        @Html.HiddenFor(m => m.Primary)

        @Html.Hidden("Asset_Count", (object)ViewBag.Asset_details_List.Count)
        @Html.Hidden("End_date_Check", (object)ViewBag.EnddateCheck)
        @Html.Hidden("Final_Submit_Check", (object)ViewBag.Final_Submit_Check)

        @Html.Hidden("Primary_Asset_Value", (object)ViewBag.Primary_Asset_Value)
        @Html.Hidden("Retention_Year_value", (object)ViewBag.Retention_Year_value)
        @Html.Hidden("Action_Value", (object)ViewBag.Action_Value)
        @Html.HiddenFor(m => m.Classification_Edit_ID)
        @Html.Hidden("OrgnizationMapping_check", (object)ViewBag.OrgnizationMapping_check)
        @Html.HiddenFor(m => m.SYKIID)


    }
    <div style="padding: 1% !important;">
        @*<a id="btn_lastKi_data" href="@Url.Action("LastYear_Ki_AssetDetails", "AssetRegistration")" class="btn" style="background-color:darkblue;color:white;">Import Last Ki Asset Register</a>*@
        @*<button class="bttn btn-success btn_disable" id="btn-export" style="background-color: #ccc; border-color: #4e4e4e;color: #232121; font-weight : bold ;float:right;">Export to Excel</button>*@
        <div style="padding-left: 15px !important;">
            <table class="table table-responsive" style="font-size:13px;border:1px solid; overflow-x:scroll;" id="GetData">
                <thead>
                    <tr style="background-color: lightblue;">
                        <th style="border:1px solid;text-align:center; width:5px;font-weight:bold;">S.No.</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Primary Asset")</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Secondary Asset")</th>
                        <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("Asset Type")</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset Location")</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset Owner")</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset Custodian")</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Asset User")</th>
                        <th style="border:1px solid;text-align:center; width:5%;font-weight:bold;">@Html.DisplayName("Classification")</th>
                        <th style="border:1px solid;text-align:center; width:5%;font-weight:bold;">@Html.DisplayName("Retention Period")</th>
                        <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Remarks</th>
                        <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Applicability</th>
                        <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Reason for NA")</th>
                        @*<th style="border:1px solid;text-align:center; width:1%;font-weight:bold;" class="noExl">Edit</th>
                            <th style="border:1px solid;text-align:center; width:1%;font-weight:bold;" class="noExl">Delete</th>*@
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        foreach (var item in ViewBag.Asset_details_List)
                        {
                            var s = item.Retention_Period;
                            var as_type = item.AssetsID;
                            var cls_type = item.ClassificationID;

                            <tr>
                                <td style="border:1px solid;text-align:center;">@index</td>
                                <td style="border:1px solid;text-align:center;">@item.Primary</td>
                                <td style="border:1px solid;text-align:center;">@item.Secondary</td>
                                <td style="border:1px solid;text-align:center;">
                                    @if (as_type == 1)
                                    {
                                        <p>Information Hard</p>
                                    }
                                    @if (as_type == 2)
                                    {
                                        <p>Information Soft</p>
                                    }
                                    @if (as_type == 3)
                                    {
                                        <p>Physical</p>
                                    }
                                    @if (as_type == 4)
                                    {
                                        <p>Software</p>
                                    } @if (as_type == 5)
                                    {
                                        <p>Service</p>
                                    }
                                    @if (as_type == 6)
                                    {
                                        <p>People</p>
                                    }
                                </td>
                                <td style="border:1px solid;text-align:center;">@item.Assetlocation</td>
                                <td style="border:1px solid;text-align:center;">@item.AssetOwner</td>
                                <td style="border:1px solid;text-align:center;">@item.Custodian</td>
                                <td style="border:1px solid;text-align:center;">@item.AssetUser</td>
                                <td style="border:1px solid;text-align:center;">
                                    @if (cls_type == 1)
                                    {
                                        <p>Top secret </p>
                                    }
                                    @if (cls_type == 2)
                                    {
                                        <p>Secret </p>
                                    }
                                    @if (cls_type == 3)
                                    {
                                        <p>Internal</p>
                                    }
                                </td>
                                <td style="border:1px solid;text-align:center;">
                                    @if (s != null && s != "_")
                                    {
                                        string[] result = s.Split('_');
                                        var mth = result[0];
                                        var year = result[1];
                                        var yr = ""; var mth_ = "";
                                        if (year == "1" || year == "0")
                                        {
                                            yr = "Year";
                                        }
                                        else
                                        {
                                            yr = "Years";
                                        }
                                        if (mth == "1" || mth == "0")
                                        {
                                            mth_ = "Month";
                                        }
                                        else
                                        {
                                            mth_ = "Months";
                                        }
                                        <p>
                                            @(year + yr + " " + mth + mth_)
                                        </p>

                                    }
                                    else
                                    {
                                        <p>NA</p>
                                    }
                                </td>
                                <td style="border:1px solid;text-align:center;">@item.Retention_Remarks</td>
                                <td style="border:1px solid;text-align:center;">
                                    @if (item.ActionType == 1)
                                    {
                                        if (item.Reason_NA == null)
                                        {
                                            <p>Yes</p>
                                        }
                                        else
                                        {
                                            <p> No </p>
                                        }
                                    }
                                    else
                                    {
                                        <p> - </p>
                                    }
                                </td>
                                <td style="border:1px solid;text-align:center;">
                                    @item.Reason_NA
                                </td>
                                @*<td style="border:1px solid;text-align:center;" class="noExl">
                                        @if (ViewBag.Final_Submit_Check == 0 && ViewBag.EnddateCheck == 0)
                                        {
                                            <a title="Edit" onclick="return Edit(@item.ID)" href="@Url.Action("AssetRegister", "AssetRegistration", new { id = @item.ID })"><i class="glyphicon glyphicon-pencil"></i></a>
                                            if (cls_type == 1)
                                            {
                                                <input type="checkbox" name="ID" value="@item.ID" class="custom-checkbox" />
                                            }
                                        }

                                    </td>
                                    <td style="border:1px solid;text-align:center;" class="noExl">
                                        <input type="hidden" value="@item.ActionType" id="tbl_act_type" />
                                        @if (item.ActionType == 0 && ViewBag.Final_Submit_Check == 0 && ViewBag.EnddateCheck == 0)
                                        {
                                            <a title="Delete" href="@Url.Action("DeleteAssetRegister", "AssetRegistration", new { id = @item.ID })"><i class="glyphicon glyphicon-trash"></i></a>
                                        }
                                        else
                                        {
                                            <p>-</p>
                                        }
                                    </td>*@
                            </tr>
                            index++;
                        }
                        if (ViewBag.Asset_details_List.Count == 0)
                        {
                            <tr>
                                <td colspan="13" style="border:1px solid;text-align:center;">No record found.</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="13"><input type="checkbox" id="chk_TC" /><b> I have mentioned all division’s information assets & I will ensure to adhere/Implement asset handling guidelines as per their asset classifications.</b> </td>
                    </tr>
                </tfoot>
            </table>
        </div>



        <div class="row">
            @using (Html.BeginForm("FinalSubmit_AssetDetails", "AssetRegistration", FormMethod.Post, new { encType = "multipart/form-data", id = "FinalSubmit_AssetDetails" }))
            {
                <div class="col-md-12 center">
                    @*<div class="col-md-5">&nbsp;&nbsp;</div>*@
                    <div class="col-md-12 col-sm-12">
                        @*<input type="button" value="Save as Draft" class="bttn btn-success btn_disable" name="BtnDraft" id="BtnDraft" data-loading-text="Saving..." autocomplete="off" style="background-color: #ccc; border-color: #4e4e4e;color: #232121;font-weight : bold ;" />

                            <input type="submit" class="bttn btn-success btn_disable" value="Submit" id="btnFinalSubmit" name="btnFinalSubmit" data-loading-text="Submitting..." autocomplete="off" style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold;" />*@

                        <input type="button" value="Back" class="bttn btn-success btn_disable" name="Btnback" id="Btnback" style="background-color: #ccc; border-color: #4e4e4e; color: #232121;font-weight : bold ;" />

                        @*<input type="button" value="Asset not applicable" class="bttn btn-success btn_disable btnBulkUpdate" id="BtnNoApplicable" style="background-color: #ccc; border-color: #4e4e4e; color: #232121;font-weight : bold ;" />*@

                    </div>
                </div>
            }
        </div>

        @if (ViewBag.Remarks != null && ViewBag.Remarks.Count > 0)
        {
            <h7>Remarks </h7>
            <table class="table" style="font-size:13px;border:1px solid;width:100%;">
                <thead>
                    <tr style="background-color: lightblue;">
                        @foreach (var item1 in ViewBag.Remarks)
                        {
                            if (item1.DivisionDate != null && item1.OperatingDate != null)
                            {
                                <td style="border:1px solid;text-align:center; width:15%;font-weight:bold;">Division Head Remarks</td>
                                <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Date</td>
                                <td style="border:1px solid;text-align:center; width:15%;font-weight:bold;">Operating Head Remarks</td>
                                <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Date</td>
                                break;
                            }
                            else if (item1.DivisionDate != null && item1.OperatingDate == null)
                            {
                                <td style="border:1px solid;text-align:center; width:15%;font-weight:bold;">Division Head Remarks</td>
                                <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Date</td>
                                break;
                            }
                            else if (item1.Operating_Remarks != null && item1.Divison_Remarks == null)
                            {
                                <td style="border:1px solid;text-align:center; width:15%;font-weight:bold;">Operating Head Sendback Remarks</td>
                                <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Date</td>
                                break;
                            }


                            else if (item1.Divison_Remarks != null && item1.Operating_Remarks == null)
                            {
                                <td style="border:1px solid;text-align:center; width:15%;font-weight:bold;">Div. Head Sendback Remarks</td>
                                <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Date</td>
                                break;
                            }
                            else
                            {
                                <td style="border:1px solid;text-align:center; width:15%;font-weight:bold;">Division Head Remarks</td>
                                <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Date</td>
                                <td style="border:1px solid;text-align:center; width:15%;font-weight:bold;">Operating Head Remarks</td>
                                <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Date</td>
                                break;
                            }
                        }
                    </tr>
                </thead>
                <tr>
                    @foreach (var item in ViewBag.Remarks)
                    {
                        if (item.DivisionDate != null && item.OperatingDate != null)
                        {
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.Divison_Remarks</td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">
                                @item.DivisionDate.ToString("dd/MM/yyyy")
                            </td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.Operating_Remarks</td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">
                                @item.OperatingDate.ToString("dd/MM/yyyy")
                            </td>
                            break;
                        }
                        else if (item.DivisionDate != null && item.OperatingDate == null)
                        {
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.Divison_Remarks</td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">
                                @item.DivisionDate.ToString("dd/MM/yyyy")
                            </td>
                            break;
                        }
                        else if (item.Operating_Remarks != null && item.Divison_Remarks == null)
                        {
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.Operating_Remarks</td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">
                                @item.ModifiedDate.ToString("dd/MM/yyyy")
                            </td>
                            break;
                        }

                        else if (item.Divison_Remarks != null && item.Operating_Remarks == null)
                        {
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.Divison_Remarks</td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">
                                @item.ModifiedDate.ToString("dd/MM/yyyy")
                            </td>
                            break;
                        }

                        else
                        {
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;"></td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;"></td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;"></td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;"></td>
                            break;
                        }
                        @*<td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.Divison_Remarks</td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">
                                @if (item.DivisionDate != null)
                                {
                                    @item.DivisionDate.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    @item.ModifiedDate.ToString("dd/MM/yyyy")
                                }
                            </td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.Operating_Remarks</td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">
                                @if (item.OperatingDate != null)
                                {
                                    @item.OperatingDate.ToString("dd/MM/yyyy")
                                }
                            </td>
                            break;*@
                    }
                </tr>
            </table>
        }

        @if (ViewBag.DRemarks.Count > 0)
        {
            <h7>Deficiency Remarks </h7>
            <table class="table" style="font-size:13px;border:1px solid;width:100%;">
                <thead>
                    <tr style="background-color: lightblue;">
                        <td style="border:1px solid;text-align:center; width:10%;font-weight:bold;">Primary Asset</td>
                        <td style="border:1px solid;text-align:center; width:18%;font-weight:bold;">Secondary Asset</td>
                        <td style="border:1px solid;text-align:center; width:30%;font-weight:bold;">Remarks</td>
                        <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Date</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.DRemarks)
                    {
                        <tr>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.PrimaryAsset</td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.SecondaryAsset</td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.Remarks</td>
                            <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.cdate.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div id="bulkUpdateModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;text-transform: none; height:900px;">
    <div class="modal-dialog" style="width:85%">
        <div class="modal-content" style="height:500px; overflow:scroll; padding:20px">
            <div class="modal-header">
                <div class="modal-header modalHieght">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"> Asset Applicability Update</h4>
                </div>
            </div>
            <div class="modal-body">
                <h5><b><span id="Titlecc"></span></b></h5>
                @Html.Partial("~/Views/AssetRegistration/_pvAssetApplicabilityUpdate.cshtml", new ePortal.ViewModels.AssetApplicabilityUpdateVM())
            </div>
        </div>
    </div>
</div>

@section Scripts{
