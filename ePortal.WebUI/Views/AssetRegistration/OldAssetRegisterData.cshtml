<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    var Ids = [];
    $('#GetData tbody').on('click', 'input[type="checkbox"]', function (e) {
        debugger;
        if (this.checked) {
            Ids.push($(this).val());
        }
        else {
            Ids = arrayRemove(Ids, $(this).val());
        }
    })

    function arrayRemove(arr, value) {
        return arr.filter(function (ele) {
            return ele != value;
        });
    }


    $(".btnBulkUpdate").click(function () {
        debugger;
        var newIds = '';
        if (Ids != null && Ids != "") {
            newIds = Ids
        }
        if (Ids != null && Ids != "") {
            $.ajax({
                type: "POST",
                url: "/AssetRegistration/AssetApplicabilityUpdate",
                data: { selectIDs: newIds },
                dataType: "json",
                success: function (result) {
                    debugger;
                    $('#bulkUpdateModal').modal('show');
                    var tr;
                    var count = 0;
                    $("#table1").empty();
                    if (result.lstCommonAAssetsRegListVM.length > 0) {
                        $('#SelectedIds').val(result.SelectedIds);
                        for (var i = 0; i < result.lstCommonAAssetsRegListVM.length; i++) {
                            count = count + 1;
                            tr = $('<tr/>');
                            tr.append('<td style="font-size: 15px;">' + count + "</td>");
                            tr.append('<td style="font-size: 15px;">' + result.lstCommonAAssetsRegListVM[i].Primary + "</td>");
                            if (result.lstCommonAAssetsRegListVM[i].Secondary == null) {
                                tr.append('<td style="font-size: 15px;">' + '' + "</td>");
                            }
                            else {
                                tr.append('<td style="font-size: 15px;">' + result.lstCommonAAssetsRegListVM[i].Secondary + "</td>");
                            }

                            if (result.lstCommonAAssetsRegListVM[i].AssetsID == 1) {
                                tr.append('<td style="font-size: 15px;">' + 'Information Hard' + "</td>");
                            }
                            else if (result.lstCommonAAssetsRegListVM[i].AssetsID == 2) {
                                tr.append('<td style="font-size: 15px;">' + 'Information Soft' + "</td>");
                            }
                            else if (result.lstCommonAAssetsRegListVM[i].AssetsID == 3) {
                                tr.append('<td style="font-size: 15px;">' + 'Physical' + "</td>");
                            }
                            else if (result.lstCommonAAssetsRegListVM[i].AssetsID == 4) {
                                tr.append('<td style="font-size: 15px;">' + 'Software' + "</td>");
                            }
                            else if (result.lstCommonAAssetsRegListVM[i].AssetsID == 5) {
                                tr.append('<td style="font-size: 15px;">' + 'Service' + "</td>");
                            }
                            else if (result.lstCommonAAssetsRegListVM[i].AssetsID == 6) {
                                tr.append('<td style="font-size: 15px;">' + 'People' + "</td>");
                            }
                            else {
                                tr.append('<td style="font-size: 15px;">' + '' + "</td>");
                            }

                            if (result.lstCommonAAssetsRegListVM[i].Assetlocation == null) {
                                tr.append('<td style="font-size: 15px;">' + '' + "</td>");
                            }
                            else {
                                tr.append('<td style="font-size: 15px;">' + result.lstCommonAAssetsRegListVM[i].Assetlocation + "</td>");
                            }

                            if (result.lstCommonAAssetsRegListVM[i].AssetOwner == null) {
                                tr.append('<td style="font-size: 15px;">' + '' + "</td>");
                            }
                            else {
                                tr.append('<td style="font-size: 15px;">' + result.lstCommonAAssetsRegListVM[i].AssetOwner + "</td>");
                            }

                            if (result.lstCommonAAssetsRegListVM[i].Custodian == null) {
                                tr.append('<td style="font-size: 15px;">' + '' + "</td>");
                            }
                            else {
                                tr.append('<td style="font-size: 15px;">' + result.lstCommonAAssetsRegListVM[i].Custodian + "</td>");
                            }

                            if (result.lstCommonAAssetsRegListVM[i].AssetUser == null) {
                                tr.append('<td style="font-size: 15px;">' + '' + "</td>");
                            }
                            else {
                                tr.append('<td style="font-size: 15px;">' + result.lstCommonAAssetsRegListVM[i].AssetUser + "</td>");
                            }

                            if (result.lstCommonAAssetsRegListVM[i].ClassificationID == 1) {
                                tr.append('<td style="font-size: 15px;">' + 'Top secret' + "</td>");
                            }
                            else {
                                tr.append('<td style="font-size: 15px;">' + '' + "</td>");
                            }
                            //else if (result.lstCommonAAssetsRegListVM[i].ClassificationID == 2) {
                            //    tr.append('<td style="font-size: 15px;">' + 'Secret' + "</td>");
                            //}
                            //else if (result.lstCommonAAssetsRegListVM[i].ClassificationID == 3) {
                            //    tr.append('<td style="font-size: 15px;">' + 'Internal' + "</td>");
                            //}
                            if (result.lstCommonAAssetsRegListVM[i].Retention_Remarks == null) {
                                tr.append('<td style="font-size: 15px;">' + '' + "</td>");
                            }
                            else {
                                tr.append('<td style="font-size: 15px;">' + result.lstCommonAAssetsRegListVM[i].Retention_Remarks + "</td>");
                            }

                            if (result.lstCommonAAssetsRegListVM[i].ActionType == 1) {

                                if (result.lstCommonAAssetsRegListVM[i].Reason_NA == null) {
                                    tr.append('<td style="font-size: 15px;">' + 'Yes' + "</td>");
                                }
                                else {
                                    tr.append('<td style="font-size: 15px;">' + 'No' + "</td>");
                                }
                            }
                            else {
                                tr.append('<td style="font-size: 15px;">' + '' + "</td>");
                            }

                            if (result.lstCommonAAssetsRegListVM[i].Reason_NA == null) {
                                tr.append('<td style="font-size: 15px;">' + '' + "</td>");
                            }
                            else {
                                tr.append('<td style="font-size: 15px;">' + result.lstCommonAAssetsRegListVM[i].Reason_NA + "</td>");
                            }
                            //tr.append('<td style="font-size: 15px;">' + result.lstCommonAAssetsRegListVM[i].Reason_NA + "</td>");
                            //tr.append('<td style="font-size: 15px;">' + result.lstCommonAAssetsRegListVM[i].SYKI + "</td>");
                            //tr.append('<td style="font-size: 15px;">' + result.lstCommonAAssetsRegListVM[i].OperationName + "</td>");
                            //tr.append('<td style="font-size: 15px;">' + result.lstCommonAAssetsRegListVM[i].DivisionName + "</td>");

                            $('#table1').append(tr);
                        }
                    }

                },
            });
        }
        else {
            alert("Please select at least one item.")
        }
    });

</script>

<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    $(document).ready(function () {
        // $("#Ki").val(@ViewBag.curki);
        var table = $('#GetData').DataTable({
            pageLength: 1000,
        });

        $('#btn-export').on('click', function () {
            var btn = $(this).button('loading');
            $('<table>')
                .append($(table.table().header()).clone())
                .append(table.$('tr').clone()).table2excel({
                    exclude: ".noExl",
                    name: "NominationList",
                    filename: "Asset List_" + new Date().toISOString().replace(/[\-\:\.]/g, "_"),
                    fileext: ".xls",
                    exclude_img: true,
                    exclude_links: true,
                    exclude_inputs: true,
                    columns: [0, 1, 2, 3]
                });
            setTimeout(function () {
                btn.button('reset');
            }, 2000);
        });
    })
</script>

