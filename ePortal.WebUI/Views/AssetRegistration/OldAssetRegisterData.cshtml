    #GetData_length select {
        width: 30% !important;
        padding: 0px;
    }

    .pagination {
        display: none;
        font-size: 12px !important;
    }

    .btn {
        background-color: #e3e3e3;
        color: #333;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
