
@model ePortal.ViewModels.BulkUpdatePeriod

@{
    Layout = null;
}


<div class="row">
    <div class="col-md-12 with-icon-panel pad-l-r-30">
        <div class="row form-group">
            <div class="col-md-12">
                <input class="col-md-12 col-xs-12 borderblueall wholepadding bluecolor req_field" name="user_id" value="104" type="hidden">
            </div>
        </div>
        @using (Html.BeginForm("BulkUpdatePeriodITGRCSettingNew", "AssetRegistration", FormMethod.Post, new { encType = "multipart/form-data" }))
        {
            <input type="hidden" name="GridHtml" id="gridexcel" />
            <div class="body-content">
                <div id="form-group">
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                @Html.HiddenFor(m => m.SelectedIds)

                                <td class="text-right">
                                    <b>ki<span style="color: #ff0000">*</span></b>
                                </td>
                                <td class="col-md-1">
                                    @Html.TextBoxFor(m => m.SYKI, new { @readonly = "readonly", @class = "form-control" })
                                </td>

                                <td class="text-right">
                                    <b>Start Date<span style="color: #ff0000">*</span></b>
                                </td>
                                <td class="col-md-2">
                                    @Html.TextBoxFor(x => x.StartDate, new { @readonly = "readonly", @class = "form-control sDate", @placeholder = "dd/mm/yyyy", @required = "required" })
                                    @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                                </td>
                                <td class="text-right">
                                    <b>End Date<span style="color: #ff0000">*</span></b>
                                </td>
                                <td class="col-md-2">
                                    @Html.TextBoxFor(x => x.EndDate, new { @readonly = "readonly", @class = "form-control eDate", @placeholder = "dd/mm/yyyy", @required = "required" })
                                    @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                            <tr>
                                <td colspan="12" style="text-align:center;">
                                    <div class="col-md-12" style="align-items: center;">
                                        <input type="submit" class="bttn btn-success btn_disable" value="Update" id="btnSubmitt"
                                               name="btnSubmit" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />

                                        <input type="button" class="bttn btn-success btn_disable" value="Cancel" name="btnCancel" data-ctrl="btn-cancel" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />

                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
        <div class="col-md-12">
            <span style="margin-left:98px">Selected Period Open for Information Asset Register List</span>
        </div>
        <div class="col-md-12" style="padding-top: 12px; margin-left: 99px;">
            <table class="table1 table-bordered table-condensed table-hover table-striped table-responsive">
                <thead>
                    <tr>
                        <th style="font-size: 15px;">S.No.</th>
                        <th style="font-size: 15px;">ki</th>
                        <th style="font-size: 15px;">Operation</th>
                        <th style="font-size: 15px;">Division</th>
                        <th style="font-size: 15px;">Start Date</th>
                        <th style="font-size: 15px;">End Date</th>
                    </tr>
                </thead>
                <tbody id="table1"></tbody>
            </table>
        </div>
        @*<div class="form-group">
                <div class="col-md-12" align="center">
                    <input type="button" onclick="closedialog();" value="Cancel" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ; margin-top:17px">
                </div>
            </div>*@
        <div class="clearfix"></div>
    </div>
</div>
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_12"]">
    $(document).ready(function () {
        $('#Schedulersss').val(" ");

    });

    function closedialog() {
        document.location.reload(true);

    }

    $(document).ready(function () {
        $("#btnSubmitt").click(function () {
            var sdate = $('.sDate').val();
            var edate = $('.eDate').val();

            if (sdate == "") {
                alert('Please enter start date.');
                return false;
            }
            else if (edate == "") {
                alert('Please enter end date.');
                return false;
            }

            else {
                var sdate = moment($('.sDate').val(), 'DD-MM-YYYY');
                var edate = moment($('.eDate').val(), 'DD-MM-YYYY');
                var a = new Date(sdate);
                var b = new Date(edate);
                if (a > b) {
                    alert('End date should be greater than start date.');
                    return false;
                }

            }
        });
    });

</script>


<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_13"]">
    $(document).ready(function () {
        $('[data-ctrl="btn-cancel"]').on('click', function () {
              closedialog();
        });
    });

</script>








