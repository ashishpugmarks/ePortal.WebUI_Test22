<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>
    @if (TempData["msg"] != null)
    {
        <span class="error">
            @TempData["msg"].ToString()
        </span>
    }

    @using (Html.BeginForm("InsertUpdateCommonAssetSetting", "AssetRegistration", FormMethod.Post, new { encType = "multipart/form-data", id = "CommonAssetsRegister" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(x => x.ID)
        <div class="body-content" style="overflow-x:hidden">
            <div id="msform">
                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <tr>
                            <td class="text-right">
                                <b>Primary Asset<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-4">
                                <div class="col-md-12">
                                    @Html.TextBoxFor(x => x.Primary, new { @class = "form-control", @placeholder = "Please enter primary asset" })
                                </div>
                            </td>
                            <td class="text-right">
                                <b>Classification<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                @Html.DropDownList("ClassificationID", new List<SelectListItem>
                        {
                        new SelectListItem{Text="Select",Value=" "},
                        new SelectListItem{Text="Top secret",Value="1"},
                         new SelectListItem{Text="Secret",Value="2"},
                          new SelectListItem{Text="Internal",Value="3"},
                        }, new { @id = "ddlAssetClassificationID", @class = "form-control" })
                            </td>
                            <td class="text-right">
                                <b>Status<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                @Html.DropDownList("Active", new List<SelectListItem>
                        {
                        new SelectListItem{Text="Active",Value="1"},
                         new SelectListItem{Text="InActive",Value="0"},
                        }, new { @id = "ddlActive", @class = "form-control" })
                            </td>
                        </tr>
                        <tr>
                            <td colspan="10" style="text-align:center;">
                                <div class="col-md-12" style="align-items: center;">
                                    <input type="submit" class="bttn btn-success btn_disable" value="Submit" id="btnSubmit" data-loading-text="Submitting..." autocomplete="off"
                                           name="btnSubmit" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />


                                    <input type="button" value="Cancel" class="bttn btn-success btn_disable" name="BtnCancel" id="BtnCancel" style="background-color: #ccc; border-color: #4e4e4e; align-items: center;width: 10%;color: #232121;font-weight : bold ;" />

                                </div>
                            </td>
                        </tr>

                    </tbody>
                </table>


                <table class="table" style="font-size:13px;border:1px solid;" id="GetData">
                    <thead>
                        <tr>
                        <tr style="background-color: lightblue;">
                            <th style="border:1px solid;text-align:center; width:1%;">S.No.</th>
                            <th style="border:1px solid;text-align:left; width:20%;">@Html.DisplayName("Primary Asset")</th>
                            <th style="border:1px solid;width:5%;text-align:center">@Html.DisplayName("Classification")</th>
                            <th style="border:1px solid;width:5%;text-align:center">@Html.DisplayName("Status")</th>
                            <th style="border:1px solid;width:3%;text-align:center">Edit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = 1;
                            foreach (var item in List)
                            {
                                var cls = ""; var sta = "";
                                var clsi = item.ClassificationID;
                                var asst = item.AssetsID;
                                if (clsi == 1)
                                {
                                    cls = "Top secret";
                                }
                                else if (clsi == 2)
                                {
                                    cls = "Secret";
                                }
                                else
                                {
                                    cls = "Internal";
                                }
                                if (@item.Active == 1)
                                {
                                    sta = "Active";
                                }
                                else
                                {
                                    sta = "InActive";
                                }

                                <tr>
                                    <td style="border:1px solid;text-align:center;">@index</td>
                                    <td style="border:1px solid;text-align:left;">@item.Primary</td>
                                    <td style="border:1px solid;text-align:center;">@cls</td>
                                    <td style="border:1px solid;text-align:center;">@sta</td>
                                    <td style="border:1px solid;text-align:center;"><a href="@Url.Action("CommonAssetsRegister", "AssetRegistration", new { id = @item.ID })"><i class="glyphicon glyphicon-pencil"></i></a></td>
                                </tr>
                                index++;
                            }
                            if (List.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" style="border:1px solid;text-align:center;">No record found.</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <td colspan="9">
                                <a data-ctrl="back">
                                    <img src="~/images/icon_back.gif" border="0" alt="">
                                    Back
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    }
</div>
@section Scripts{
@*<script src="~/Scripts/jquery-1.10.2.min.js"></script>*@
@* @Scripts.Render("~/bundles/jqueryval") *@
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    $("#BtnCancel").click(function () {
        location.reload(true);

    });
</script>
<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
    function BtnBack(ths, event) {
        window.location.href = "Search";
    }
</script>

<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
    $(document).ready(function () {
        $('#btnSubmit').on('click', function () {
            var Primary = $('#Primary').val();
            var Secondary = $('#Secondary').val();
            // var ddlAssetTypeID = $('#ddlAssetTypeID');
            var ddlAssetClassificationID = $('#ddlAssetClassificationID');

            if (Primary == "") {
                alert('Please insert primary asset.');
                return false;
            }
            //else if (Secondary == "") {
            //    alert('Please insert secondary asset.');
            //    return false;
            //}
            //else if (ddlAssetTypeID.val() == " ") {
            //    alert("Please select asset type!");
            //    return false;
            //}
            else if (ddlAssetClassificationID.val() == " ") {
                alert("Please select classification!");
                return false;
            }
            $('form').validate();
            if ($('form').valid())
                $(this).button('loading');
        });
    });
</script>
