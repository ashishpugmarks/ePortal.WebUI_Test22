<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
    $(document).ready(function () {
        $('#BtnCancel').on('click', function () {
            CancelBtnClickEvent();
        });

        $('[data-ctrl="back"]').on('click', function () {
            window.history.back();
        });
    });
</script>
