@model ePortal.ViewModels.RouteChangeRequest

@{
    ViewData["Title"] = "Route Change Request";
    Layout = "~/Views/Shared/_layoutinnerpage.cshtml";
}
<link href="~/aspxview/styles/index.css" rel="stylesheet" />

<form method="Get">
    <div style="margin-top:5px">
        <table cellspacing="0" cellpadding="0" width="100%" border="0">
            <tbody>
                <tr>
                    <td valign="top" align="left" style="width: 780px;">
                        <table cellspacing="0" cellpadding="0" width="100%" border="0" id="maintable" runat="server">
                            <tbody>
                                <tr>
                                    <td bgcolor="#ffffff" style="padding-left: 20px">
                                        <fieldset class="swiftfieldset" style="width: 520px">
                                            <legend><b>Bus Membership/Route Change Request Detail</b></legend>
                                            <table width="100%" border="0" cellspacing="1" cellpadding="2">
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="text-align: right; width: 122px">
                                                        <span class="smalltext">Request ID:</span>&nbsp;
                                                    </td>
                                                    <td> &nbsp; @Model.RequestId</td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="text-align: right;">
                                                        <span class="smalltext">Name:</span>&nbsp;
                                                    </td>
                                                    <td>
                                                        &nbsp; @Model.EmployeeName
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="text-align: right; width: 122px">
                                                        <span class="smalltext">Request:</span>&nbsp;
                                                    </td>
                                                    <td>
                                                        &nbsp; @Model.Request
                                                    </td>
                                                </tr>
                                                <tr id="tr_croute" runat="server">
                                                    <td align="left" valign="middle" class="row2" style="text-align: right;">
                                                        <span class="smalltext">Current Route:</span>&nbsp;
                                                    </td>
                                                    <td>
                                                        &nbsp; @Model.CurrentRoute
                                                    </td>
                                                </tr>
                                                <tr id="tr_cstop" runat="server">
                                                    <td align="left" valign="middle" class="row2" style="text-align: right; width: 122px">
                                                        <span class="smalltext">Current Stop:</span>&nbsp;
                                                    </td>
                                                    <td>
                                                        &nbsp; @Model.CurrentStop
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="text-align: right; width: 122px">
                                                        <span class="smalltext">Requested Stop:</span>&nbsp;
                                                    </td>
                                                    <td>
                                                        &nbsp; @Model.NewStop
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="text-align: right;">
                                                        <span class="smalltext">Usage Start Date:</span>&nbsp;
                                                    </td>
                                                    <td>
                                                        &nbsp; @Model.UsageStartDate
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="text-align: right; width: 122px">
                                                        <span class="smalltext">Residential Address:</span>&nbsp;
                                                    </td>
                                                    <td>
                                                        &nbsp; @Model.Address
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="text-align: right;">
                                                        <span class="smalltext">Monthly Charge:</span>&nbsp;
                                                    </td>
                                                    <td>
                                                        &nbsp; @Model.NewCharge
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="text-align: right;">
                                                        <span class="smalltext">Remarks:</span>&nbsp;
                                                    </td>
                                                    <td>
                                                        &nbsp; @Model.Remarks
                                                    </td>
                                                </tr>
                                            </table>
                                        </fieldset>
                                        <fieldset class="swiftfieldset" style="width: 520px">
                                            <legend><b>Approval Status</b></legend>
                                            <table width="100%" border="0" cellspacing="0" cellpadding="2">
                                                <tr>
                                                    <td valign="middle" class="row2" style="text-align: left;width: 122px">
                                                        <span class="smalltext">Status:</span>&nbsp;
                                                    </td>
                                                    <td valign="middle">
                                                        &nbsp; @Model.AdminStatus
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td valign="middle" class="row2" style="text-align: left; width: 122px">
                                                        <span class="smalltext">Remarks:</span>&nbsp;
                                                    </td>
                                                    <td valign="middle">
                                                        &nbsp; @Model.AdminRemarks
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="text-align: left; width: 122px">
                                                        <span class="smalltext">Approved Requested Route:</span>&nbsp;
                                                    </td>
                                                    <td valign="middle">
                                                        &nbsp; @Model.NewRoute
                                                    </td>
                                                </tr>
                                            </table>
                                        </fieldset>
                                        <br />
                                        <br />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</form>