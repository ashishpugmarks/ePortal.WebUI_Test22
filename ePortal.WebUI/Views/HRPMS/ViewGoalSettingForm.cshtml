@model ePortal.ViewModels.GoalSettingViewModel
@{
    Layout = null; // likely this is a popup; set Layout = "_Layout" if you want the site layout.
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Goal Setting Details</title>
    <link href="~/css/index.css" rel="stylesheet" />
    <link href="~/css/ProStyle.css" rel="stylesheet" />
    <style>
        /* small helper for legacy classes if missing */
        .separation {
            height: 8px;
        }

        .totalweight {
            font-weight: bold;
            padding: 6px;
        }
    </style>
</head>
<body>
    <div class="maincontainer">
        <div style="border: 0px solid #6393DF; margin-bottom: 20px; clear: both;">
            <div class="Viewpg_heading">Goal Setting Details</div>

            <table class="tableGridView assdet" width="100%">
                <tr>
                    <td class="HeaderStyle12" colspan="4">&nbsp;Associate Details</td>
                </tr>
                <tr class="row2">
                    <td width="15%" class="collvlstyle" style="height: 25px">Employee:</td>
                    <td width="35%" class="style2"><span class="lblcss">@Model.Employee</span></td>
                    <td width="15%" class="collvlstyle" style="height: 25px">Date of Joining:</td>
                    <td width="35%" class="style2"><span class="lblcss">@Model.DateOfJoining</span></td>
                </tr>
                <tr class="row1">
                    <td class="collvlstyle">Operation:</td>
                    <td><span class="lblcss">@Model.Operation</span></td>
                    <td class="collvlstyle">Division:</td>
                    <td><span class="lblcss">@Model.Division</span></td>
                </tr>
                <tr class="row2">
                    <td class="collvlstyle">Department:</td>
                    <td><span class="lblcss">@Model.Department</span></td>
                    <td class="collvlstyle">Section:</td>
                    <td><span class="lblcss">@Model.Section</span></td>
                </tr>
                <tr class="row1">
                    <td class="collvlstyle">Evaluator:</td>
                    <td><span class="lblcss">@Model.Evaluator</span></td>
                    <td class="collvlstyle">Reviewer:</td>
                    <td><span class="lblcss">@Model.Reviewer</span></td>
                </tr>
            </table>

            <div class="separation">&nbsp;</div>

            <table class="tableGridView" width="100%">
                <tr><td class="HeaderStyle12">&nbsp;Role</td></tr>
                <tr>
                    <td style="padding: 3px; line-height: 15px; text-align: justify;">
                        @Html.Raw(Model.Role ?? string.Empty)
                    </td>
                </tr>
            </table>

            <div class="separation">&nbsp;</div>

            @if (Model.Activities != null && Model.Activities.Any())
            {
                <table class="tableGridView" width="100%">
                    <tr><td class="HeaderStyle12">&nbsp;Performance Assesment[PART A]</td></tr>
                    <tr class="row1">
                        <td style="padding: 2px;">
                            <div class="mainviewdiv">
                                <div class="headerdiv" style="border-bottom: 1px solid #C0C0C0;">Activities</div>
                                <table style="font-weight: bold; margin: 2px; border-collapse: collapse!important;" cellpadding="0" cellspacing="0" width="99.5%">
                                    <tr style="background-color: #EDF4FF; color: #6d929b; text-align: center;">
                                        <th>S.No</th>
                                        <th>Activities</th>
                                        <th>Control Item</th>
                                        <th>Target</th>
                                        <th>Weightage</th>
                                    </tr>
                                    @foreach (var a in Model.Activities)
                                    {
                                        <tr style="font-weight: normal;">
                                            <td align="center" width="6%"><b>@a.SNo</b></td>
                                            <td width="44%" class="txtlineheight_1 txtpadding_1">@a.Activity</td>
                                            <td width="20%" class="txtlineheight_1 txtpadding_1">@a.ControlItem</td>
                                            <td width="20%" class="txtlineheight_1 txtpadding_1">@a.Target</td>
                                            <td width="10%" class="txtlineheight_1 txtpadding_1" align="center">@a.Weightage%</td>
                                        </tr>
                                    }
                                    <tr>
                                        <td colspan="5" class="totalweight">Total Weightage = @Model.ActivitiesTotalWeightage%</td>
                                    </tr>
                                </table>
                            </div>

                            <div class="mainviewdiv">
                                <div class="headerdiv" style="border-bottom: 1px solid #C0C0C0;">Other Activities</div>
                                <table style="font-weight: bold; margin: 2px; border-collapse: collapse!important;" cellpadding="0" cellspacing="0" width="99.5%">
                                    <tr style="background-color: #EDF4FF; color: #6d929b; text-align: center;">
                                        <th>S.No</th>
                                        <th>Activities</th>
                                        <th>Control Item</th>
                                        <th>Target</th>
                                    </tr>
                                    @foreach (var o in Model.OtherActivities)
                                    {
                                        <tr style="font-weight: normal;">
                                            <td align="center" width="6%"><b>@o.SNo</b></td>
                                            <td class="txtlineheight_1 txtpadding_1" width="24%">@o.Activity</td>
                                            <td class="txtlineheight_1 txtpadding_1" width="40%">@o.ControlItem</td>
                                            <td class="txtlineheight_1 txtpadding_1" width="30%">@o.Target</td>
                                        </tr>
                                    }
                                    <tr>
                                        <td colspan="4" class="totalweight">@Model.OtherActivitiesWeightageText</td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                    </tr>
                </table>
            }
            else
            {
                <!-- If no activities, hide section -->
            }

            <div class="separation">&nbsp;</div>

            @if (Model.CompetencyHeaders != null && Model.CompetencyHeaders.Any())
            {
                <table class="tableGridView" width="100%">
                    <tr><td class="HeaderStyle12">&nbsp;Competencies[PART B]</td></tr>
                    <tr class="row1">
                        <td style="padding: 2px; border: 1px solid #C0C0C0;">
                            @foreach (var header in Model.CompetencyHeaders)
                            {
                                <div style="background-color: White; margin-bottom: 5px; border: 1px solid #C0C0C0; padding-bottom: 2px;">
                                    <div class="headerdiv" style="border-bottom: 1px solid #C0C0C0;">@header.HeadDescription</div>
                                    <table style="font-weight: bold; margin: 2px; border-collapse: collapse!important;" cellpadding="0" cellspacing="0" width="99.5%">
                                        <tr style="background-color: #EDF4FF; color: #6d929b; text-align: center;">
                                            <th>S.No</th>
                                            <th>Level Description</th>
                                            <th class="fhassessmentlblhead_1">Skill<br />Level</th>
                                        </tr>
                                        @foreach (var lvl in header.Levels)
                                        {
                                            <tr style="font-weight: normal;">
                                                <td align="center"><b>@lvl.SNo</b></td>
                                                <td class="lvldesc">@lvl.LevelDescription</td>
                                                <td align="center">@lvl.Score</td>
                                            </tr>
                                        }
                                    </table>
                                </div>
                            }
                        </td>
                    </tr>
                </table>
            }

            <div class="separation">&nbsp;</div>

            @if (!string.IsNullOrEmpty(Model.EvalComment) || !string.IsNullOrEmpty(Model.RevComment) || !string.IsNullOrEmpty(Model.AssocComment))
            {
                <table class="tableGridView twowaycomm" width="100%">
                    <tr>
                        <td class="HeaderStyle12 headerstylepad" colspan="2">&nbsp;Two Way Communication</td>
                    </tr>
                    @if (!string.IsNullOrEmpty(Model.EvalComment))
                    {
                        <tr>
                            <td width="20%" align="right" class="fhassessmentlblhead"><b>Evaluator Comment</b></td>
                            <td width="80%" class="txtlineheight_1 txtpadding_1">@Model.EvalComment</td>
                        </tr>
                    }
                    @if (!string.IsNullOrEmpty(Model.RevComment))
                    {
                        <tr>
                            <td align="right" class="fhassessmentlblhead"><b>Reviewer Comment</b></td>
                            <td class="txtlineheight_1 txtpadding_1">@Model.RevComment</td>
                        </tr>
                    }
                    @if (!string.IsNullOrEmpty(Model.AssocComment))
                    {
                        <tr>
                            <td align="right" class="fhassessmentlblhead"><b>Associate Comment</b></td>
                            <td class="txtlineheight_1 txtpadding_1">@Model.AssocComment</td>
                        </tr>
                    }
                </table>
            }
        </div>
    </div>
</body>
</html>
