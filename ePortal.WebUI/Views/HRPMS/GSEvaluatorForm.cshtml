@model ePortal.ViewModels.GSEvaluatorViewModel
@{
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}

<link href="~/css/index.css" rel="stylesheet" />
<link href="~/css/ProStyle.css" rel="stylesheet" />

<input type="hidden" id="hdPMSID" value="@Model.PMSID" />

<div style="height:2.2em;padding-top:10px;font-size:medium;font-weight:bold;
            font-family:Roboto-Regular;background-color:#8A8A8A;color:#FFF;">
    <span style="padding-left:10px;">PMS - Goal Setting Evaluator Form</span>
</div>

<div class="m-2">

    <!-- ================= Associate Details ================= -->
    <table class="table table-bordered table-condensed table-striped">
        <tr><td class="HeaderStyle12" colspan="4">Associate Details</td></tr>
        <tr>
            <td class="text-right">Associate :-</td>
            <td>@Model.Associate</td>
            <td class="text-right">Date of Joining :-</td>
            <td>@Model.DateOfJoining</td>
        </tr>
        <tr>
            <td class="text-right">Operation :-</td>
            <td>@Model.Operation</td>
            <td class="text-right">Division :-</td>
            <td>@Model.Division</td>
        </tr>
        <tr>
            <td class="text-right">Department :-</td>
            <td>@Model.Department</td>
            <td class="text-right">Section :-</td>
            <td>@Model.Section</td>
        </tr>
        <tr>
            <td class="text-right">Evaluator :-</td>
            <td>@Model.Evaluator</td>
            <td class="text-right">Reviewer :-</td>
            <td>@Model.Reviewer</td>
        </tr>
    </table>

    <!-- ================= Role ================= -->
    <table class="table table-bordered">
        <tr><td class="HeaderStyle12">Role</td></tr>
        <tr><td>@Model.Role</td></tr>
    </table>

    <!-- ================= Two Way Communication ================= -->
    <table class="table table-bordered">
        <tr>
            <td class="HeaderStyle12" colspan="2">Two Way Communication</td>
        </tr>

        <tr>
            <td class="collvlstyle feed_1">
                <span class="mandatory">*</span>Feedback to Associate
            </td>
            <td>
                @if (Model.ShowButtons)
                {
                    <textarea id="txtEvalComment"
                              class="form-control"
                              rows="4"
                              maxlength="1000">@Model.EvalComment</textarea>
                }
                else
                {
                    <div class="form-control-plaintext">@Model.EvalComment</div>
                }
            </td>
        </tr>

        @if (Model.ShowButtons)
        {
            <tr>
                <td class="text-right">
                    <input type="checkbox" id="chkTerms" />
                </td>
                <td>
                    <b>I confirm that I have conducted one to one two way feedback with the associate.</b>
                </td>
            </tr>

            <tr>
                <td colspan="2" class="text-center">
                    <button type="button" id="btnSendToReviewer" class="greenbutton">
                        Send to Reviewer
                    </button>

                    @if (Model.ShowSendBack)
                    {
                        <button type="button" id="btnSendBack" class="greenbutton">
                            Send Back to Associate
                        </button>
                    }

                    <button type="button" id="btnCancel" class="greenbutton">
                        Cancel
                    </button>
                </td>
            </tr>
        }
    </table>

    <!-- ================= Back ================= -->
    <div class="well well-sm mt-2">
        <a href="@Url.Action("ManagePMS","HRPMS")">
            <img src="~/images/icon_back.gif" /> Back
        </a>
    </div>
</div>
