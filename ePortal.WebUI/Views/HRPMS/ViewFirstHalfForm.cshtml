@model ePortal.ViewModels.ViewFirstHalfViewModel
@{
    ViewData["Title"] = "PMS - First Half Form";
    Layout = null; // keep same as ASPX (no master page)
}

<!DOCTYPE html>
<html>
<head>
    <title>Employee Portal - Performance Management System :: Honda Motorcycle & Scooter India Pvt. Ltd.</title>

    <link href="~/css/index.css" rel="stylesheet" />
    <link href="~/css/ProStyle.css" rel="stylesheet" />
</head>
<body>

    <div class="maincontainer">
        <div style="border:0; margin-bottom:20px; clear:both;">
            <div class="Viewpg_heading">PMS - First Half Form</div>

            <!-- Associate Details -->
            <table class="tableGridView assdet" width="100%">
                <tr>
                    <td class="HeaderStyle12" colspan="4">Associate Details</td>
                </tr>
                <tr class="row2">
                    <td class="collvlstyle">Employee:</td>
                    <td class="lblcss">@Model.EmployeeName</td>
                    <td class="collvlstyle">Date of Joining:</td>
                    <td class="lblcss">@Model.DateOfJoining</td>
                </tr>
                <tr class="row1">
                    <td class="collvlstyle">Operation:</td>
                    <td class="lblcss">@Model.Operation</td>
                    <td class="collvlstyle">Division:</td>
                    <td class="lblcss">@Model.Division</td>
                </tr>
                <tr class="row2">
                    <td class="collvlstyle">Department:</td>
                    <td class="lblcss">@Model.Department</td>
                    <td class="collvlstyle">Section:</td>
                    <td class="lblcss">@Model.Section</td>
                </tr>
                <tr class="row1">
                    <td class="collvlstyle">Evaluator:</td>
                    <td class="lblcss">@Model.Evaluator</td>
                    <td class="collvlstyle">Reviewer:</td>
                    <td class="lblcss">@Model.Reviewer</td>
                </tr>
            </table>

            <div class="separation">&nbsp;</div>

            <!-- Role -->
            <table class="tableGridView" width="100%">
                <tr>
                    <td class="HeaderStyle12">&nbsp;Role</td>
                </tr>
                <tr>
                    <td style="padding:3px; line-height:15px;">
                        @Model.Role
                    </td>
                </tr>
            </table>

            <div class="separation">&nbsp;</div>

            <!-- Performance Assessment PART A -->
            @if (Model.Activities?.Rows.Count > 0)
            {
                <table class="tableGridView" width="100%">
                    <tr>
                        <td class="HeaderStyle12">&nbsp;Performance Assessment [PART A]</td>
                    </tr>
                    <tr class="row1">
                        <td>

                            <!-- Activities -->
                            <div class="mainviewdiv">
                                <div class="headerdiv">Activities</div>

                                @{
                                    int i = 1;
                                }
                                @foreach (System.Data.DataRow row in Model.Activities.Rows)
                                {
                                    <table class="fhpmstable_u">
                                        <tr>
                                            <td class="tabletd_yellow" colspan="3">@i) Activity</td>
                                        </tr>
                                        <tr>
                                            <td class="txtpaddingassesment" colspan="3">@row["ACTIVITY"]</td>
                                        </tr>
                                        <tr>
                                            <td class="tabletd_blue">Control Item</td>
                                            <td class="tabletd_blue">Target</td>
                                            <td class="tabletd_blue">Weightage</td>
                                        </tr>
                                        <tr>
                                            <td class="txtpaddingassesment pmstblborder">@row["CONTROLITEM"]</td>
                                            <td class="txtpaddingassesment pmstblborder">@row["TARGET"]</td>
                                            <td class="txtpaddingassesment pmstblborder">@row["WEIGHTAGE"]%</td>
                                        </tr>
                                    </table>

                                    <table class="fhpmstable_l">
                                        <tr>
                                            <td class="tabletd_blue" colspan="2">Achievement</td>
                                        </tr>
                                        <tr>
                                            <td class="tabletd_green">First Half</td>
                                            <td class="txtpaddingassesment">@row["MYRESULT"]</td>
                                        </tr>
                                    </table>
                                    i++;
                                }

                                <div class="totalweight_1">
                                    Total Weightage = @Model.ActivityTotalWeight %
                                </div>
                            </div>

                            <!-- Other Activities -->
                            @if (Model.OtherActivities?.Rows.Count > 0)
                            {
                                <div class="mainviewdiv">
                                    <div class="headerdiv">Other Activities</div>

                                    @{
                                        int j = 1;
                                    }
                                    @foreach (System.Data.DataRow row in Model.OtherActivities.Rows)
                                    {
                                        <table class="fhpmstable_u">
                                            <tr>
                                                <td class="tabletd_yellow" colspan="3">@j) Activity</td>
                                            </tr>
                                            <tr>
                                                <td class="txtpaddingassesment" colspan="3">@row["ACTIVITY"]</td>
                                            </tr>
                                            <tr>
                                                <td class="tabletd_blue">Control Item</td>
                                                <td class="tabletd_blue">Target</td>
                                            </tr>
                                            <tr>
                                                <td class="txtpaddingassesment pmstblborder">@row["CONTROLITEM"]</td>
                                                <td class="txtpaddingassesment pmstblborder">@row["TARGET"]</td>
                                            </tr>
                                        </table>

                                        <table class="fhpmstable_l">
                                            <tr>
                                                <td class="tabletd_blue" colspan="2">Achievement</td>
                                            </tr>
                                            <tr>
                                                <td class="tabletd_green">First Half</td>
                                                <td class="txtpaddingassesment">@row["MYRESULT"]</td>
                                            </tr>
                                        </table>
                                        j++;
                                    }

                                    <div class="totalweight_1">
                                        Total Weightage = @Model.OtherActivityWeight %
                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                </table>
            }

            <div class="separation">&nbsp;</div>

            <!-- PART B – Competencies -->
            @if (Model.CompetencyData != null)
            {
                <table class="tableGridView" width="100%">
                    <tr>
                        <td class="HeaderStyle12">&nbsp;Competencies [PART B]</td>
                    </tr>
                    <tr>
                        <td>
                            @foreach (var comp in Model.CompetencyData)
                            {
                                <div style="border:1px solid #C0C0C0; margin-bottom:5px;">
                                    <div class="headerdiv">@comp.HeaderName</div>

                                    <table width="100%">
                                        <tr class="fhassessmentlblhead_1">
                                            <th>S.No</th>
                                            <th>Level Description</th>
                                            <th>Skill Level</th>
                                        </tr>

                                        @{
                                            int k = 1;
                                        }
                                        @foreach (System.Data.DataRow lvl in comp.Levels.Rows)
                                        {
                                            <tr>
                                                <td align="center"><b>@k</b></td>
                                                <td class="lvldesc">@lvl["LEVELDESCRIPTION"]</td>
                                                <td align="center">@lvl["FINAL_SCORE"]</td>
                                            </tr>
                                            k++;
                                        }
                                    </table>
                                </div>
                            }
                        </td>
                    </tr>
                </table>
            }

            <div class="separation">&nbsp;</div>

            <!-- Comments -->
            <table class="tableGridView twowaycomm" width="100%">
                <tr>
                    <td class="HeaderStyle12" colspan="2">&nbsp;Part B Comment</td>
                </tr>
                <tr>
                    <td class="fhassessmentlblhead">Associate Comment</td>
                    <td>@Model.PartBASComment</td>
                </tr>

                @if (!string.IsNullOrEmpty(Model.EvalFeedback))
                {
                    <tr>
                        <td class="fhassessmentlblhead">Evaluator Comment</td>
                        <td>@Model.EvalFeedback</td>
                    </tr>
                }

                @if (!string.IsNullOrEmpty(Model.RevFeedback))
                {
                    <tr>
                        <td class="fhassessmentlblhead">Reviewer Comment</td>
                        <td>@Model.RevFeedback</td>
                    </tr>
                }

                @if (!string.IsNullOrEmpty(Model.AssocFeedback))
                {
                    <tr>
                        <td class="fhassessmentlblhead">Associate Comment</td>
                        <td>@Model.AssocFeedback</td>
                    </tr>
                }
            </table>
        </div>
    </div>

</body>
</html>
