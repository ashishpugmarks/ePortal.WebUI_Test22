@model ePortal.ViewModels.PmsResultModel

@{
    var table = Model?.SelfTable;
    int index = 0;
}

<table style="width: 100%; margin-bottom: 5px;"
       class="table table-bordered table-condensed">
    <tr>
        <td>
            @if (table == null || table.Rows.Count == 0)
            {
                <div class="nodata">No Data Available</div>
            }
            else
            {
                int page = Model.EvaluatorPaging.PageIndex;
                int size = Model.EvaluatorPaging.PageSize;
                int skip = page * size;

                var rows = table.Rows.Cast<System.Data.DataRow>()
                .Skip(skip)
                .Take(size);

                <table class="table table-bordered table-condensed table-hover pms-grid">

                    <tr class="info" style="font-weight:bold;">
                        <td rowspan="2">Employee</td>
                        <td colspan="3">Goal Setting</td>
                        <td colspan="3">First Half</td>
                        <td colspan="3">Second Half</td>
                    </tr>

                    <tr class="warning" style="font-weight:bold;">
                        <td class="self_bg">Self</td>
                        <td>Evaluator</td>
                        <td>Reviewer</td>
                        <td class="self_bg">Self</td>
                        <td>Evaluator</td>
                        <td>Reviewer</td>
                        <td class="self_bg">Self</td>
                        <td>Evaluator</td>
                        <td>Reviewer</td>
                    </tr>

                    @foreach (System.Data.DataRow row in rows)
                    {
                        string gsId = $"gsSelf_{index}";
                        string fhId = $"fhSelf_{index}";
                        string shId = $"shSelf_{index}";

                        <tr>
                            <td><b>@row["EMPNAME"] (@row["EMPCODE"])</b></td>

                            <td class="linkpadding self_bg">
                                <a href="javascript:void(0);"
                                   id="@gsId"
                                   class="gs-self"
                                   data-syki="@row["SYKIID"]"
                                   data-pmsid="@row["HRPMSID"]"
                                   data-confirm="@row["GS2WAYCONFIRMATION"]">
                                    <img src="~/images/PMS/@row["GSSELF"]" width="15" />
                                </a>
                            </td>

                            <td><img src="~/images/PMS/@row["GSEVAL"]" width="15" /></td>
                            <td><img src="~/images/PMS/@row["GSREV"]" width="15" /></td>

                            <td class="linkpadding self_bg">
                                <a href="javascript:void(0);"
                                   id="@fhId"
                                   class="fh-self"
                                   data-pmsid="@row["HRPMSID"]"
                                   data-status="@row["MYRSTATUS"]"
                                   data-comment="@row["MY2WAYCONFIRMATION"]">
                                    <img src="~/images/PMS/@row["FHSELF"]" width="15" />
                                </a>
                            </td>

                            <td><img src="~/images/PMS/@row["FHEVAL"]" width="15" /></td>
                            <td><img src="~/images/PMS/@row["FHREV"]" width="15" /></td>

                            <td class="linkpadding self_bg">
                                <a href="javascript:void(0);"
                                   id="@shId"
                                   class="sh-self"
                                   data-pmsid="@row["HRPMSID"]"
                                   data-status="@row["FYRSTATUS"]"
                                   data-comment="@row["FY2WAYCONFIRMATION"]">
                                    <img src="~/images/PMS/@row["SHSELF"]" width="15" />
                                </a>
                            </td>

                            <td><img src="~/images/PMS/@row["SHEVAL"]" width="15" /></td>
                            <td><img src="~/images/PMS/@row["SHREV"]" width="15" /></td>
                        </tr>

                        index++;
                    }
                </table>
            }
        </td>
    </tr>
</table>
