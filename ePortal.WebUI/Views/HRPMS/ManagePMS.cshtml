        function searchEvent() {

            var model = {
                SYKI: $("#SYKI").val(),
                Operation: $("#Operation").val(),
                Division: $("#Division").val(),
                Department: $("#Department").val(),
                Section: $("#Section").val()
            };

            $.ajax({
                type: "POST",
                url: "/HRPMS/ManagePMS",
                data: JSON.stringify(model),
