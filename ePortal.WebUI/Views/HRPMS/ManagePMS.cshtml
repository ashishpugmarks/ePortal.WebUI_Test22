        $(document).on("click", ".pms-link:not(.disabled)", function () {

            let type = $(this).data("type");
            let _pmsId = $(this).data("pmsid");
            let status = parseInt($(this).data("status") || 0);
            let _url = "";

            if (type === "GSEVAL") {
                if (status < 2) return alert("Sorry you can not able to approved");
                _url = "/HRPMS/GSEvaluator" ;

            }

            if (type === "FHEVAL") {
                if (status < 6) return alert("Sorry you can not able to approved");
                _url = "/HRPMS/FHEvaluator";
            }

            if (type === "SHEVAL") {
                if (status < 13) return alert("Sorry you can not able to approved");
                _url = "/HRPMS/SHEvaluator";
            }


            var modelvalue = {
                    PMSID: _pmsId.toString()
                };

                $.ajax({
                type: "POST",
                url: _url,
                data: JSON.stringify(modelvalue),
                contentType: "application/json; charset=utf-8",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                success: function (result) {
                    //$("#CommonHRPMSVIewID").html(result);
                     if (result.redirect)
                        window.location = result.redirect;

                    if (result.popup)
                        window.open(result.popup, "View",
                            "scrollbars=1,resizable=yes,width=830,height=550,top=80,left=140");
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    alert("Error occurred!");
                }
            });
        });

            function validateEvaluator(isReviewer) {
            var comment = $.trim($("#txtEvalComment").val());

            if (!comment) {
                alert("Evaluator 2-Way Communication Comment is mandatory field");
                $("#txtEvalComment").focus();
                return false;
            }

            if (comment.length > 1000) {
                alert("Evaluator 2-Way Communication Comment should not be greater than 1000 character");
                $("#txtEvalComment").focus();
                return false;
            }

            if (isReviewer && !$("#chkTerms").is(":checked")) {
                alert("Please accept the two way feedback confirmation");
                $("#chkTerms").focus();
                return false;
            }

            return true;
        }

        function postAndRedirect(url) {
            $.ajax({
                url: url,
                type: "POST",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({
                    PMSID: $("#hdPMSID").val(),
                    EvalComment: $("#txtEvalComment").val()
                }),
                success: function (data, status, xhr) {
                    if (xhr.responseURL) {
                        window.location.href = xhr.responseURL;
                    }
                },
                error: function (xhr) {
                    alert(xhr.responseText || "Unexpected error occurred");
                }
            });
        }

        $(document).ready(function () {
            $("#fh_tw_container").show();
        });

        /* =====================================================
           SUBMIT TWO WAY COMMUNICATION
           ===================================================== */
        $(document).on("click", "#btn_fh_submit", function () {

            var feedback = $("#txt_fh_eval_feedback").val().trim();
            var confirmFlag = $("#chk_fh_confirm_flag").is(":checked");

            if (feedback === "") {
                alert("Feedback is mandatory");
                return;
            }

            if (feedback.length > 1000) {
                alert("Maximum 1000 characters allowed");
                return;
            }

            if (!confirmFlag) {
                alert("Please confirm two way feedback");
                return;
            }

            $.ajax({
                url: "/HRPMS/SubmitFHTwoWay",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    EncPmsId: $("#hd_fh_pmsid").val().toString(),
                    EvalFeedback: feedback.toString(),
                    ConfirmFlag: confirmFlag
                }),
                success: function (res) {
                    window.location.href = res.redirect;
                },
                error: function (xhr) {
                    alert(xhr.responseText);
                }
            });
        });

        /* =====================================================
           CANCEL
           ===================================================== */
        $(document).on("click", "#btn_fh_cancel", function () {
            window.location.href = "/HRPMS/CancelFH";
        });

                function loadReviewerPms(page) {

            var payload = {
                SYKI: $("#ddlKi").val(),
                Operation: $("#ddlOperation").val(),
                Division: $("#ddlDivision").val(),
                Department: $("#ddlDepartment").val(),
                Section: $("#ddlSection").val(),
                revPage: page
            };

            $.ajax({
                url: "/HRPMS/ReviewerPMS",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (res) {
                    $("#reviewerContainer").html(res);
                },
                error: function () {
                    alert("Error loading reviewer PMS");
                }
            });
        }

        /* Paging */
        $(document).on("click", ".js-rev-page", function () {
            var page = $(this).data("page");
            loadReviewerPms(page);
        });

        /* GS Reviewer */
        $(document).on("click", ".js-gs-review", function () {
            var _pmsId = $(this).data("pmsid");
            var status = $(this).data("status");

            if (!status || parseInt(status) < 3) {
                alert("Sorry you cannot approve");
                return;
            }


            var modelvalue = {
                    PMSID: _pmsId.toString()
                };

                $.ajax({
                type: "POST",
                url: "/HRPMS/GSReviewer",
                data: JSON.stringify(modelvalue),
                contentType: "application/json; charset=utf-8",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                success: function (result) {
                    //$("#CommonHRPMSVIewID").html(result);
                     if (result.redirect)
                        window.location = result.redirect;

                    if (result.popup)
                        window.open(result.popup, "View",
                            "scrollbars=1,resizable=yes,width=830,height=550,top=80,left=140");
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    alert("Error occurred!");
                }
            });
        });

        /* FH Reviewer */
        $(document).on("click", ".js-fh-review", function () {
            var _pmsId = $(this).data("pmsid");
            var status = $(this).data("status");

            if (!status || parseInt(status) < 7) {
                alert("Sorry you cannot approve");
                return;
            }


            var modelvalue = {
                    PMSID: _pmsId.toString()
                };

                $.ajax({
                type: "POST",
                url: "/HRPMS/ViewFirstHalfReviewer",
