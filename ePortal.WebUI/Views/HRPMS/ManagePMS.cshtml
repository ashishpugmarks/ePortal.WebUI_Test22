              function getPMSID() {
            return $("#hdPMSID_shevalator").val();
        }

        function showError(msg) {
            alert(msg);
        }

        function goTo(divId) {
            $(".maings").hide();
            $("#" + divId).show();
        }
              $("#btnRoleNext").on("click", function () {
            goTo("PERFASSESMENTDIV");
        });

        $("#btnCancel_shEvaluator").on("click", function () {
            window.location.href = "/ManagePMS";
        });
                function savePartA() {

            var pid = getPMSID();
            var activities = [];
            var valid = true;

            $(".activity-block").each(function () {

                var goalId = $(this).data("goalid");
                var score = $(this).find(".eval-score").val();

                if (score === "0") {
                    showError("Second Half evaluator score is mandatory");
                    valid = false;
                    return false;
                }

                activities.push({
                    GoalId: goalId,
                    Score: score
                });
            });

            if (!valid) return;

            var partAComment = $("#txtPartAComment").val().trim();
            if (partAComment === "") {
                showError("PART A Evaluator Comment is mandatory");
                return;
            }

            var model = {
                PID: pid,
                OtherActivityScore: "0", // no separate dropdown in new UI
                PartAEvalComment: partAComment,
                Activities: activities
            };

            $.ajax({
                url: "/HRPMS/SavePartA",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(model),
                success: function (res) {
                    if (res.success) {
                        goTo("COMPETENCIESDIV");
                    } else {
                        showError(res.message);
                    }
                },
                error: function (err) {
                    showError(err.responseText || "Error saving Part A");
                }
            });


        function savePartB() {

            var pid = getPMSID();
            var competencies = [];
            var valid = true;

            $(".competency-row").each(function () {

                var compId = $(this).data("compid");
                var score = $(this).find(".com-score").val();

                if (score === "0") {
                    showError("Second Half evaluator score is mandatory");
                    valid = false;
                    return false;
                }

                competencies.push({
                    CompetencyId: compId,
                    Score: score
                });
            });

            if (!valid) return;

            var partBComment = $("#txtPartBComment").val().trim();
            if (partBComment === "") {
                showError("PART B Evaluator Comment is mandatory");
                return;
            }

            // final score is calculated server-side (same as WebForms)
            var model = {
                PID: pid,
                PartBEvalComment: partBComment,
                FinalEvalScore: "0",
                FinalReviewerScore: "0",
                FinalRating: "",
                FinalSHScore: "",
                Competencies: competencies
            };

            $.ajax({
                url: "/HRPMS/SavePartB",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(model),
                success: function (res) {
                    if (res.success) {
                        goTo("TWOWAYDIV");
                    } else {
                        showError(res.message);
                    }
                },
                error: function (err) {
                    showError(err.responseText || "Error saving Part B");
                }
            });
        }

        $("#btnPartBNext").on("click", savePartB);

        }

        $("#btnPartANext").on("click", savePartA);


                
        function sendToReviewer() {

            var pid = getPMSID();
            var feedback = $("#txtFeedback").val().trim();

            if (feedback === "") {
                showError("Feedback to associate comment is mandatory");
                return;
            }

            if (!$("#chkTerms").is(":checked")) {
                showError("Please confirm two way feedback");
                return;
            }

            var isSame = true;

            var model = {
                PID: pid,
                EvalFeedbackComment: feedback,
                IsEvaluatorReviewerSame: isSame
            };

            $.ajax({
                url: "/HRPMS/SendToReviewer",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(model),
                success: function (res) {
                    if (res.success) {
                        alert("Second Half Evaluation completed successfully");
                        window.location.href = res.redirect;
                    } else {
                        showError(res.message);
                    }
                },
                error: function (err) {
                    showError(err.responseText || "Error sending to reviewer");
                }
            });
        }

        $("#btnSendToReviewer").on("click", sendToReviewer);

            $("#btnSubmit_UQ_903").on("click", function () {

            let comment = $("#txtReviewerComment_UQ_901").val().trim();

            if (comment.length === 0) {
                alert("Reviewer comment is mandatory");
                return;
            }

            if (comment.length > 1000) {
                alert("Comment should not exceed 1000 characters");
                return;
            }

            if (!$("#chkConfirm_UQ_902").is(":checked")) {
                alert("Please confirm two way feedback");
                return;
            }

            $.get("/GSReviewerPopup/Submit", {
                pid: "0",
                comment: comment
            }, function (res) {
                if (res.success) {
                    alert("Review submitted successfully");
                    window.location.href = "/ManagePMS";
                } else {
                    alert("Error while submitting review");
                }
            });
        });
        </script>
    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#btnSearch').on('click', function () {
                searchEvent();
            });
            
        });

        // -------- SEND TO REVIEWER --------
        $(document).on("click", "#btnSendToReviewer", function () {
            if (!validateEvaluator(true)) return;
            postAndRedirect("/HRPMS/SendToReviewer");
        });

        // -------- SEND BACK --------
        $(document).on("click", "#btnSendBack", function () {
            if (!validateEvaluator(false)) return;
            postAndRedirect("/HRPMS/SendBack");
        });

        // -------- CANCEL --------
        $(document).on("click", "#btnCancel", function () {
            window.location.href = "/ManagePMS";
        });

    </script>
}
