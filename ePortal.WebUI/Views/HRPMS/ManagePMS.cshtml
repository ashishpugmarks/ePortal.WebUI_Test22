@model ePortal.ViewModels.PMSViweModel
@{
    ViewData["Title"] = "Manage PMS";
    var result = ViewBag.Result as ePortal.ViewModels.PmsResultModel;
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}

@section Styles {

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    .HeaderStyle12 {
        background-color: #d9edf7;
        padding: 6px;
        font-weight: bold;
    }

        .homeContent {
            font-family: 'Roboto-Regular';
        }
    .collvlstyle {
        font-weight: bold;
        padding: 4px;
    }

    .archive {
        color: #d9534f !important;
        text-decoration: underline;
    }

    .mng_legend img { height: 18px; margin-right: 4px; }
    .mng_legend b { margin-right: 12px; }

    .nodata {
        padding: 8px;
        color: #a94442;
        font-weight: bold;
    }

    .linkpadding { padding: 4px !important; }

    .self_bg { background-color: #F2F2E6; }

    .Pagingtbl td { padding: 4px; }

    .paging_1, .paging_2, .paging_3 {
        padding: 4px;
        margin: 2px;
        cursor: pointer;
        display: inline-block;
    }

    .managelink { font-weight: bold; text-decoration: underline; }

        .mng_legend {
            padding: 10px;
        }

        .topRow {
            padding: 15px;
        }

        .info {
            font-weight: bold;
        }

        .warning {
            font-weight: bold;
        }
        /* Common PMS grid alignment */
        .pms-grid {
            width: 100%;
            table-layout: fixed;
            text-align: center;
        }

            /* Employee column */
            .pms-grid th:nth-child(1),
            .pms-grid td:nth-child(1) {
                width: 10%;
                text-align: center;
            }

            /* Remaining 9 status columns */
            .pms-grid th:nth-child(n+2),
            .pms-grid td:nth-child(n+2) {
                width: 10%;
            }

            /* Keep icons centered */
            .pms-grid img {
                display: inline-block;
            }


    </style>
}

<!-- -------------------------------- HEADER -------------------------------- -->
<div class="row">
<div style="height: 2.2em; padding-top: 10px; font-size: medium;
            font-weight: bold; font-family: Roboto-Regular;
            background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
    <span style="padding-left: 18px;">Manage PMS</span>
</div>

<div class="topRow">
<div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">

    <!-- SEARCH CRITERIA -->
    <table style="width: 100%; margin-bottom: 5px;" class="table table-bordered table-condensed table-striped">
        <tr>
            <td class="HeaderStyle12" colspan="4">
                <span style="float: left;">Search Criteria</span>
                <span style="float: right;">
                            <a href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageOHApproval.aspx" title="Archive PMS(Before 93Ki)" class="archive">
                                Archive PMS(Before 93ki)
                            </a>
                </span>
            </td>
        </tr>

        <form asp-action="Index" method="post">
        <tr>
            <td class="collvlstyle text-right">Ki:</td>
                <td><select id="SYKI" asp-for="SYKI" asp-items="Model.KiList" class="form-select"></select></td>
            <td colspan="2"></td>
        </tr>

        <tr>
            <td class="collvlstyle text-right">Operation:</td>
                <td><select id="Operation" asp-for="Operation" asp-items="Model.OperationList" class="form-select"></select></td>

            <td class="collvlstyle text-right">Division:</td>
                <td><select id="Division" asp-for="Division" asp-items="Model.DivisionList" class="form-select"></select></td>
        </tr>

        <tr>
            <td class="collvlstyle text-right">Department:</td>
                <td><select id="Department" asp-for="Department" asp-items="Model.DepartmentList" class="form-select"></select></td>

            <td class="collvlstyle text-right">Section:</td>
                <td><select id="Section" asp-for="Section" asp-items="Model.SectionList" class="form-select"></select></td>
        </tr>

        <tr>
            <td colspan="4" class="text-center">
                    <button id="btnSearch" type="button" class="btn btn-primary">Search</button>
            </td>
        </tr>

        <tr>
            <td colspan="4">
                Note: Only confirmed associates are eligible for mid year & final year appraisal process
            </td>
        </tr>
        </form>
    </table>

    <!-- LEGEND -->
    <div class="mng_legend" style="background-color: #E8F5FF;">
        <img src="~/images/PMS/PMS_COMPLETED.png" /><b>Completed</b>
        <img src="~/images/PMS/PMS_PENDING.png" /><b>Pending</b>
        <img src="~/images/PMS/PMS_NOTAPPLICABLE.png" /><b>Not Start</b>
        <img src="~/images/PMS/PMS_COMPLETEDWITHVIEW.png" /><b>View(Completed)</b>
        <img src="~/images/PMS/PMS_PENDINGWITHVIEW.png" /><b>Pending at Self</b>
    </div>

    <!-- ------------- PARTIALS RENDER ------------- -->
    <div id="CommonHRPMSVIewID">
            @await Html.PartialAsync("_cmnPMSView", result)
        </div>

</div>

<!-- BACK BUTTON -->
<div style="margin-left: 0.8em; margin-right: 0.8em; padding: 4px;" class="well well-sm">
    <table style="width: 100%;">
        <tr>
            <td style="vertical-align: middle;">
                <a href="/Home/Home" title="Back">
                    <img src="~/images/icon_back.gif" alt="Back" />
                </a>
                <span style="font-size: 15px; margin-left: 10px;">
                    <a href="/Home/Home" title="Back">Back</a>
                </span>
            </td>
        </tr>
    </table>
</div>
    </div>

</div>

