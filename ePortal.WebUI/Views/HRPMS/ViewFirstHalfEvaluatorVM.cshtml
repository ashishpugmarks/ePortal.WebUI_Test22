@model ePortal.ViewModels.ViewFirstHalfEvaluatorVM
@{
    Layout = null;
}

<link href="~/css/index.css" rel="stylesheet" />
<link href="~/css/ProStyle.css" rel="stylesheet" />

<div class="maincontainer">
    <div class="Viewpg_heading">PMS - First Half Evaluation Form</div>

    <!-- Associate Details -->
    <table class="tableView" width="100%" cellpadding="0" cellspacing="0">
        <tr>
            <td class="HeaderStyle12" colspan="4">&nbsp;Associate Details</td>
        </tr>
        <tr class="row2">
            <td class="collvlstyle">Associate :-</td>
            <td class="lblcss">@Model.Associate</td>
            <td class="collvlstyle">Date of Joining :-</td>
            <td class="lblcss">@Model.DateOfJoining</td>
        </tr>
        <tr class="row1">
            <td class="collvlstyle">Operation :-</td>
            <td class="lblcss">@Model.Operation</td>
            <td class="collvlstyle">Division :-</td>
            <td class="lblcss">@Model.Division</td>
        </tr>
        <tr class="row2">
            <td class="collvlstyle">Department :-</td>
            <td class="lblcss">@Model.Department</td>
            <td class="collvlstyle">Section :-</td>
            <td class="lblcss">@Model.Section</td>
        </tr>
        <tr class="row1">
            <td class="collvlstyle">Evaluator :-</td>
            <td class="lblcss">@Model.Evaluator</td>
            <td class="collvlstyle">Reviewer :-</td>
            <td class="lblcss">@Model.Reviewer</td>
        </tr>
    </table>

    <div class="separation">&nbsp;</div>

    <!-- Role -->
    <table class="tableGridView" width="100%">
        <tr>
            <td class="HeaderStyle12">&nbsp;Role</td>
        </tr>
        <tr>
            <td style="padding:3px; line-height:15px;">@Model.Role</td>
        </tr>
    </table>

    <div class="separation">&nbsp;</div>

    <!-- PART A -->
    <table class="tableGridView" width="100%">
        <tr>
            <td class="HeaderStyle12">&nbsp;Performance Assessment [PART A]</td>
        </tr>
        <tr class="row1">
            <td>
                <div class="mainviewdiv">
                    <div class="headerdiv">Activities</div>

                    @foreach (var a in Model.Activities)
                    {
                        <table class="fhpmstable_u" cellpadding="0" cellspacing="0">
                            <tr>
                                <td class="tabletd_yellow" colspan="3">Activity</td>
                            </tr>
                            <tr>
                                <td class="txtpaddingassesment" colspan="3">@a.Activity</td>
                            </tr>
                            <tr>
                                <td class="tabletd_blue">Control Item</td>
                                <td class="tabletd_blue">Target</td>
                                <td class="tabletd_blue">Weightage</td>
                            </tr>
                            <tr>
                                <td class="txtpaddingassesment pmstblborder">@a.ControlItem</td>
                                <td class="txtpaddingassesment pmstblborder">@a.Target</td>
                                <td class="txtpaddingassesment pmstblborder">@a.Weightage%</td>
                            </tr>
                        </table>

                        <table class="fhpmstable_l" cellpadding="0" cellspacing="0">
                            <tr>
                                <td class="tabletd_blue" colspan="4">Achievement</td>
                            </tr>
                            <tr>
                                <td class="tabletd_green">First Half</td>
                                <td class="txtpaddingassesment">@a.MyResult</td>
                                <td class="tabletd_green">Eval Score</td>
                                <td class="txtpaddingassesment">@a.EvalScore</td>
                            </tr>
                        </table>
                    }

                    <div class="totalweight_1">
                        Total Weightage = @Model.ActivityWeightage%
                    </div>
                </div>
            </td>
        </tr>
    </table>

    <div class="separation">&nbsp;</div>

    <!-- PART B -->
    <table class="tableGridView" width="100%">
        <tr>
            <td class="HeaderStyle12">&nbsp;Competencies [PART B]</td>
        </tr>
        <tr>
            <td>
                @foreach (var h in Model.Competencies)
                {
                    <div class="mainviewdiv">
                        <div class="headerdiv">@h.HeaderDescription</div>

                        <table width="99.5%" cellpadding="0" cellspacing="0">
                            <tr class="fhassessmentlblhead_1">
                                <th>S.No</th>
                                <th>Level Description</th>
                                <th>Skill Level</th>
                                <th>First Half Eval Score</th>
                            </tr>

                            @{
                                var i = 1;
                            }
                            @foreach (var l in h.Levels)
                            {
                                <tr>
                                    <td align="center"><b>@i</b></td>
                                    <td class="lvldesc">@l.LevelDescription</td>
                                    <td align="center">@l.SkillLevel</td>
                                    <td align="center">@l.EvalScore</td>
                                </tr>
                                i++;
                            }
                        </table>
                    </div>
                }
            </td>
        </tr>
    </table>

    <div class="separation">&nbsp;</div>

    <!-- Total Score & Comments -->
    <table class="tableGridView" width="100%">
        <tr>
            <td class="HeaderStyle12" colspan="2">&nbsp;Total Score</td>
        </tr>
        <tr>
            <td class="fhassessmentlblhead_2">Evaluator Score</td>
            <td class="labelpadding">
                <span style="color:darkorange">@Model.Formula</span>
                <b>@Model.TotalScore</b>
            </td>
        </tr>

        <tr>
            <td class="HeaderStyle12" colspan="2">&nbsp;Part A Comment</td>
        </tr>
        <tr>
            <td class="fhassessmentlblhead_2">Evaluator Comment</td>
            <td class="labelpadding">@Model.PartAEvalComment</td>
        </tr>

        <tr>
            <td class="HeaderStyle12" colspan="2">&nbsp;Part B Comment</td>
        </tr>
        <tr>
            <td class="fhassessmentlblhead_2">Associate Comment</td>
            <td class="labelpadding">@Model.PartBAssComment</td>
        </tr>
        <tr>
            <td class="fhassessmentlblhead_2">Evaluator Comment</td>
            <td class="labelpadding">@Model.PartBEvalComment</td>
        </tr>

        <tr>
            <td class="HeaderStyle12" colspan="2">&nbsp;Two Way Communication</td>
        </tr>
        <tr>
            <td class="fhassessmentlblhead_2">Evaluator Comment</td>
            <td class="labelpadding">@Model.TwoWayEvalComment</td>
        </tr>
    </table>
</div>
