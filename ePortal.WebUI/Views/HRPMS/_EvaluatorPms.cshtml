@model ePortal.ViewModels.PmsResultModel
@{
    var table = Model?.EvaluatorTable;
}

<div id="evalGrid">

    <table class="table table-bordered table-condensed">
        <tr>
            <td>

                @if (table == null || table.Rows.Count == 0)
                {
                    <div class="nodata">No Data Available</div>
                }
                else
                {
                    int page = Model.EvaluatorPaging.PageIndex;
                    int size = Model.EvaluatorPaging.PageSize;
                    int skip = page * size;

                    var rows = table.Rows.Cast<System.Data.DataRow>()
                    .Skip(skip)
                    .Take(size);

                    <table class="table table-bordered table-condensed table-hover pms-grid">

                        <tr class="info fw-bold">
                            <td rowspan="2">Employee</td>
                            <td colspan="3">Goal Setting</td>
                            <td colspan="3">First Half</td>
                            <td colspan="3">Second Half</td>
                        </tr>

                        <tr class="warning fw-bold">
                            <td>Associate</td>
                            <td class="self_bg">Evaluator</td>
                            <td>Reviewer</td>
                            <td>Associate</td>
                            <td class="self_bg">Evaluator</td>
                            <td>Reviewer</td>
                            <td>Associate</td>
                            <td class="self_bg">Evaluator</td>
                            <td>Reviewer</td>
                        </tr>

                        @foreach (var r in rows)
                        {
                            int gs = string.IsNullOrEmpty(r["GSSTATUS"].ToString()) ? 0 : Convert.ToInt32(r["GSSTATUS"]);
                            int fh = string.IsNullOrEmpty(r["MYSTATUS"].ToString()) ? 0 : Convert.ToInt32(r["MYSTATUS"]);
                            int sh = string.IsNullOrEmpty(r["FYSTATUS"].ToString()) ? 0 : Convert.ToInt32(r["FYSTATUS"]);

                            <tr>
                                <td><b>@r["EMPNAME"]</b></td>

                                <td><img src="~/images/PMS/@r["GSSELF"]" width="15" /></td>

                                <td class="self_bg">
                                    <a href="javascript:void(0)"
                                       class="pms-link @(gs < 2 ? "disabled":"")"
                                       data-type="GSEVAL"
                                       data-pmsid="@r["PMSID"]"
                                       data-status="@gs">
                                        <img src="~/images/PMS/@r["GSEVAL"]" width="15" />
                                    </a>
                                </td>

                                <td><img src="~/images/PMS/@r["GSREV"]" width="15" /></td>

                                <td><img src="~/images/PMS/@r["FHSELF"]" width="15" /></td>

                                <td class="self_bg">
                                    <a href="javascript:void(0)"
                                       class="pms-link @(fh < 6 ? "disabled":"")"
                                       data-type="FHEVAL"
                                       data-pmsid="@r["PMSID"]"
                                       data-status="@fh">
                                        <img src="~/images/PMS/@r["FHEVAL"]" width="15" />
                                    </a>
                                </td>

                                <td><img src="~/images/PMS/@r["FHREV"]" width="15" /></td>

                                <td><img src="~/images/PMS/@r["SHSELF"]" width="15" /></td>

                                <td class="self_bg">
                                    <a href="javascript:void(0)"
                                       class="pms-link @(sh < 13 ? "disabled":"")"
                                       data-type="SHEVAL"
                                       data-pmsid="@r["PMSID"]"
                                       data-status="@sh">
                                        <img src="~/images/PMS/@r["SHEVAL"]" width="15" />
                                    </a>
                                </td>

                                <td><img src="~/images/PMS/@r["SHREV"]" width="15" /></td>
                            </tr>
                        }
                    </table>
                }
            </td>
        </tr>
    </table>

</div>
