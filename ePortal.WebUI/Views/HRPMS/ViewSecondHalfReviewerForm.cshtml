@model ePortal.ViewModels.ViewSecondHalfReviewerVM


@{
    ViewData["Title"] = "Employee Portal - Performance Management System";
    Layout = null; // use layout if you have one
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
    <link href="~/css/index.css" rel="stylesheet" />
    <link href="~/css/ProStyle.css" rel="stylesheet" />
</head>
<body>
    <div class="maincontainer">

        <div class="Viewpg_heading">PMS - Second Half Evaluation Form</div>

        <!-- ================= Associate Details ================= -->
        <table class="tableView" width="100%">
            <tr><td class="HeaderStyle12" colspan="4">&nbsp;Associate Details</td></tr>
            <tr class="row2">
                <td class="collvlstyle">Associate :-</td>
                <td>@Model.Associate</td>
                <td class="collvlstyle">Date of Joining :-</td>
                <td>@Model.DateOfJoining</td>
            </tr>
            <tr class="row1">
                <td class="collvlstyle">Operation :-</td>
                <td>@Model.Operation</td>
                <td class="collvlstyle">Division :-</td>
                <td>@Model.Division</td>
            </tr>
            <tr class="row2">
                <td class="collvlstyle">Department :-</td>
                <td>@Model.Department</td>
                <td class="collvlstyle">Section :-</td>
                <td>@Model.Section</td>
            </tr>
            <tr class="row1">
                <td class="collvlstyle">Evaluator :-</td>
                <td>@Model.Evaluator</td>
                <td class="collvlstyle">Reviewer :-</td>
                <td>@Model.Reviewer</td>
            </tr>
        </table>

        <div class="separation"></div>

        <!-- ================= Role ================= -->
        <table class="tableGridView" width="100%">
            <tr><td class="HeaderStyle12">&nbsp;Role</td></tr>
            <tr>
                <td style="padding:3px">@Html.Raw(Model.Role)</td>
            </tr>
        </table>

        <div class="separation"></div>

        <!-- ================= PART A ================= -->
        <table class="tableGridView" width="100%">
            <tr><td class="HeaderStyle12">&nbsp;Performance Assessment [PART A]</td></tr>
            <tr>
                <td>
                    <div class="mainviewdiv">
                        <div class="headerdiv">Activities</div>

                        @if (Model.Activities != null)
                        {
                            int i = 1;
                            foreach (System.Data.DataRow row in Model.Activities.Rows)
                            {
                                <table class="fhpmstable_u">
                                    <tr>
                                        <td class="tabletd_yellow" colspan="3">@i) Activity</td>
                                    </tr>
                                    <tr>
                                        <td colspan="3">@row["ACTIVITY"]</td>
                                    </tr>
                                    <tr>
                                        <td class="tabletd_blue">Control Item</td>
                                        <td class="tabletd_blue">Target</td>
                                        <td class="tabletd_blue">Weightage</td>
                                    </tr>
                                    <tr>
                                        <td>@row["CONTROLITEM"]</td>
                                        <td>@row["TARGET"]</td>
                                        <td>@row["WEIGHTAGE"]%</td>
                                    </tr>
                                </table>

                                <table class="fhpmstable_l">
                                    <tr><td class="tabletd_blue" colspan="4">Achievement</td></tr>
                                    <tr>
                                        <td class="tabletd_green">First Half</td>
                                        <td>@row["MYRESULT"]</td>
                                        <td class="tabletd_green">Eval</td>
                                        <td>@ePortal.Shared.Encryption.Decrypt(row["MYEVLTSCORE"].ToString())</td>
                                    </tr>
                                    <tr>
                                        <td class="tabletd_green">Rev</td>
                                        <td colspan="3">@ePortal.Shared.Encryption.Decrypt(row["MYRVWRSCORE"].ToString())</td>
                                    </tr>
                                </table>
                                i++;
                            }
                        }

                        <div class="totalweight_1">
                            Total Weightage = @Model.PartAWeightage%
                        </div>
                    </div>
                </td>
            </tr>
        </table>

        <div class="separation"></div>

        <!-- ================= PART B ================= -->
        <table class="tableGridView" width="100%">
            <tr><td class="HeaderStyle12">&nbsp;Competencies [PART B]</td></tr>
            <tr>
                <td>
                    @foreach (System.Data.DataRow head in Model.CompetencyHeaders.Rows)
                    {
                        <div class="mainviewdiv">
                            <div class="headerdiv">@head["HEADDESCRIPTION"]</div>
                            <!-- Nested competency rows loaded in controller -->
                        </div>
                    }
                </td>
            </tr>
        </table>

        <div class="separation"></div>

        <!-- ================= Scores ================= -->
        <table class="tableGridView" width="100%">
            <tr><td class="HeaderStyle12" colspan="2">First Half Score</td></tr>
            <tr>
                <td>Evaluator</td>
                <td>@Model.FHEvalFormula <b>@Model.FHEvalTotal</b></td>
            </tr>
            <tr>
                <td>Reviewer</td>
                <td>@Model.FHRevFormula <b>@Model.FHRevTotal</b></td>
            </tr>

            <tr><td class="HeaderStyle12" colspan="2">Second Half Score</td></tr>
            <tr>
                <td>Evaluator</td>
                <td>@Model.SHEvalFormula <b>@Model.SHTotal</b></td>
            </tr>
        </table>

        <div class="separation"></div>

        <!-- ================= Comments ================= -->
        <table class="tableGridView" width="100%">
            <tr><td class="HeaderStyle12" colspan="2">Two Way Communication</td></tr>
            <tr>
                <td>Evaluator</td>
                <td>@Model.SHEvalComment</td>
            </tr>
            <tr>
                <td>Reviewer</td>
                <td>@Model.SHRevComment</td>
            </tr>
            <tr>
                <td>Associate</td>
                <td>@Model.AssociateComment</td>
            </tr>
        </table>

    </div>
</body>
</html>
