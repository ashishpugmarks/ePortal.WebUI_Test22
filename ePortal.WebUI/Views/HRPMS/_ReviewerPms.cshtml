@model ePortal.ViewModels.PmsResultModel

@{
    var table = Model?.ReviewerTable;
}

<table class="table table-bordered table-condensed">
    <tr>
        <td>

            @if (table == null || table.Rows.Count == 0)
            {
                <div class="nodata">No Data Available</div>
            }
            else
            {
                int page = Model.ReviewerPaging.PageIndex;
                int size = Model.ReviewerPaging.PageSize;
                int skip = page * size;

                var rows = table.Rows.Cast<System.Data.DataRow>()
                .Skip(skip)
                .Take(size);

                <table class="table table-bordered table-condensed table-hover pms-grid">

                    <tr class="info fw-bold">
                        <td rowspan="2">Employee</td>
                        <td colspan="3">Goal Setting</td>
                        <td colspan="3">First Half</td>
                        <td colspan="3">Second Half</td>
                    </tr>

                    <tr class="warning fw-bold">
                        <td>Associate</td>
                        <td>Evaluator</td>
                        <td class="self_bg">Reviewer</td>
                        <td>Associate</td>
                        <td>Evaluator</td>
                        <td class="self_bg">Reviewer</td>
                        <td>Associate</td>
                        <td>Evaluator</td>
                        <td class="self_bg">Reviewer</td>
                    </tr>

                    @foreach (var r in rows)
                    {
                        <tr>
                            <td><b>@r["EMPNAME"]</b></td>

                            <td><img src="~/images/PMS/@r["GSSELF"]" width="15" /></td>
                            <td><img src="~/images/PMS/@r["GSEVAL"]" width="15" /></td>
                            <td class="linkpadding self_bg">
                                <a href="javascript:void(0)"
                                   class="js-gs-review"
                                   data-pmsid="@r["PMSID"]"
                                   data-status="@r["GSSTATUS"]">
                                    <img src="~/images/PMS/@r["GSREV"]" width="15" />
                                </a>
                            </td>

                            <td><img src="~/images/PMS/@r["FHSELF"]" width="15" /></td>
                            <td><img src="~/images/PMS/@r["FHEVAL"]" width="15" /></td>
                            <td class="linkpadding self_bg">
                                <a href="javascript:void(0)"
                                   class="js-fh-review"
                                   data-pmsid="@r["PMSID"]"
                                   data-status="@r["MYSTATUS"]">
                                    <img src="~/images/PMS/@r["FHREV"]" width="15" />
                                </a>
                            </td>

                            <td><img src="~/images/PMS/@r["SHSELF"]" width="15" /></td>
                            <td><img src="~/images/PMS/@r["SHEVAL"]" width="15" /></td>
                            <td class="linkpadding self_bg">
                                <a href="javascript:void(0)"
                                   class="js-sh-review"
                                   data-pmsid="@r["PMSID"]"
                                   data-status="@r["FYSTATUS"]">
                                    <img src="~/images/PMS/@r["SHREV"]" width="15" />
                                </a>
                            </td>
                        </tr>
                    }
                </table>
            }
        </td>
    </tr>
</table>
