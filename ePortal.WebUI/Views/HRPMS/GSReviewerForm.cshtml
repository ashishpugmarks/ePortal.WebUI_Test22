@model ePortal.ViewModels.GSReviewerViewModel
@{
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}

<link href="~/css/index.css" rel="stylesheet" />
<link href="~/css/ProStyle.css" rel="stylesheet" />

<script type="text/javascript">
    function ReviewerValidate() {
        var varrevcomment = document.getElementById('txtReviewerComment_UQ_901').value.trim();
        if (varrevcomment === "") {
            alert("Reviewer 2-Way Communication Comment is mandatory field");
            document.getElementById('txtReviewerComment_UQ_901').focus();
            return false;
        }
        else if (varrevcomment.length > 1000) {
            alert("Reviewer 2-Way Communication Comment should not be greater than 1000 character");
            return false;
        }
        else if (!document.getElementById("chkConfirm_UQ_902").checked) {
            alert("Please accept the two way feedback confirmation");
            return false;
        }
        return true;
    }
</script>

<!-- Header -->
<div class="header-bar-gray">
    PMS - Goal Setting Reviewer Form
</div>

<div style="margin:10px;">

    <!-- Associate Details -->
    <table class="table table-bordered table-condensed table-striped">
        <tr>
            <td class="HeaderStyle12" colspan="4">Associate Details</td>
        </tr>
        <tr>
            <td class="collvlstyle text-right">Associate :</td>
            <td>@Model.AssociateName</td>
            <td class="collvlstyle text-right">Date of Joining :</td>
            <td>@Model.DateOfJoining</td>
        </tr>
        <tr>
            <td class="collvlstyle text-right">Operation :</td>
            <td>@Model.Operation</td>
            <td class="collvlstyle text-right">Division :</td>
            <td>@Model.Division</td>
        </tr>
        <tr>
            <td class="collvlstyle text-right">Department :</td>
            <td>@Model.Department</td>
            <td class="collvlstyle text-right">Section :</td>
            <td>@Model.Section</td>
        </tr>
        <tr>
            <td class="collvlstyle text-right">Evaluator :</td>
            <td>@Model.Evaluator</td>
            <td class="collvlstyle text-right">Reviewer :</td>
            <td>@Model.Reviewer</td>
        </tr>
    </table>

    <div class="separation"></div>

    <!-- Role -->
    <table class="table table-bordered table-condensed table-striped">
        <tr>
            <td class="HeaderStyle12">Role</td>
        </tr>
        <tr>
            <td>@Model.Role</td>
        </tr>
    </table>

    <div class="separation"></div>

    <!-- PART A -->
    <table class="table table-bordered table-condensed table-striped">
        <tr>
            <td class="HeaderStyle12">Performance Assessment [PART A]</td>
        </tr>
        <tr>
            <td>
                <table class="table table-bordered table-condensed">
                    <tr class="bg-info text-center">
                        <th>S.No</th>
                        <th>Activities</th>
                        <th>Control Item</th>
                        <th>Target</th>
                        <th>Weightage</th>
                    </tr>
                    @{
                        int i = 1;
                        foreach (var a in Model.Activities)
                        {
                            <tr>
                                <td class="text-center"><b>@i</b></td>
                                <td>@a.Activity</td>
                                <td>@a.ControlItem</td>
                                <td>@a.Target</td>
                                <td class="text-center">@a.Weightage %</td>
                            </tr>
                            i++;
                        }
                    }
                </table>

                <div class="separation"></div>

                <!-- Other Activities -->
                <table class="table table-bordered table-condensed">
                    <tr class="bg-info text-center">
                        <th>S.No</th>
                        <th>Activities</th>
                        <th>Control Item</th>
                        <th>Target</th>
                    </tr>
                    @{
                        int j = 1;
                        foreach (var a in Model.OtherActivities)
                        {
                            <tr>
                                <td class="text-center"><b>@j</b></td>
                                <td>@a.Activity</td>
                                <td>@a.ControlItem</td>
                                <td>@a.Target</td>
                            </tr>
                            j++;
                        }
                    }
                </table>
            </td>
        </tr>
    </table>

    <div class="separation"></div>

    <!-- PART B -->
    <table class="table table-bordered table-condensed">
        <tr>
            <td class="HeaderStyle12">Competencies [PART B]</td>
        </tr>
        <tr>
            <td>
                @foreach (var h in Model.Competencies)
                {
                    <div class="mainviewdiv">
                        <div class="headerdiv">@h.HeaderDescription</div>

                        <table class="table table-bordered table-condensed">
                            <tr class="bg-info text-center">
                                <th>S.No</th>
                                <th>Level Description</th>
                                <th>Skill Level</th>
                            </tr>
                            @{
                                int k = 1;
                                foreach (var l in h.Levels)
                                {
                                    <tr>
                                        <td class="text-center"><b>@k</b></td>
                                        <td>@l.LevelDescription</td>
                                        <td class="text-center">@l.SkillLevel</td>
                                    </tr>
                                    k++;
                                }
                            }
                        </table>
                    </div>
                }
            </td>
        </tr>
    </table>

    <div class="separation"></div>

    <!-- Evaluator Comment -->
    <table class="table table-bordered table-condensed">
        <tr>
            <td class="HeaderStyle12">Evaluator Two Way Communication Comment</td>
        </tr>
        <tr>
            <td>@Model.EvaluatorComment</td>
        </tr>
    </table>

    @if (Model.IsEditable)
    {
        <div class="separation"></div>

        <!-- Reviewer Comment -->
        <table class="table table-bordered table-condensed">
            <tr>
                <td class="HeaderStyle12" colspan="2">Two Way Communication</td>
            </tr>
            <tr>
                <td class="collvlstyle text-right" style="width:20%;">
                    <span class="mandatory">*</span> Feedback to Associate
                </td>
                <td>
                    <textarea id="txtReviewerComment_UQ_901"
                              class="form-control"
                              maxlength="1000"
                              rows="4">@Model.ReviewerComment</textarea>
                </td>
            </tr>
            <tr>
                <td class="text-right">
                    <input type="checkbox" id="chkConfirm_UQ_902" />
                </td>
                <td>
                    <strong>I confirm that I have conducted one to one two way feedback with the associate.</strong>
                </td>
            </tr>
            <tr>
                <td colspan="2" class="text-center">
                    <button id="btnSubmit_UQ_903"
                            class="greenbutton"
                            onclick="return ReviewerValidate();">
                        Submit
                    </button>
                </td>
            </tr>
        </table>
    }

    <!-- Back -->
    <div class="well well-sm">
        <a href="@Url.Action("ManagePMS","HRPMS")">
            <img src="~/images/icon_back.gif" alt="Back" />
            Back
        </a>
    </div>

</div>
