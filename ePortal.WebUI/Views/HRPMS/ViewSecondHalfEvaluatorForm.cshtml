@model ePortal.ViewModels.ViewSecondHalfEvaluatorVM
@{
    ViewData["Title"] = "Employee Portal - Performance Management System :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = null;
}

<link href="~/css/index.css" rel="stylesheet" />
<link href="~/css/ProStyle.css" rel="stylesheet" />

<div class="maincontainer">
    <div style="border:0;margin-bottom:20px;clear:both;">
        <div class="Viewpg_heading">Second Half Evaluator Details</div>

        <!-- Associate Details -->
        <table class="tableView" width="100%">
            <tr>
                <td class="HeaderStyle12" colspan="4">&nbsp;Associate Details</td>
            </tr>
            <tr class="row2">
                <td class="collvlstyle">Associate :-</td>
                <td>@Model.EmployeeName</td>
                <td class="collvlstyle">Date of Joining :-</td>
                <td>@Model.DateOfJoining</td>
            </tr>
            <tr class="row1">
                <td class="collvlstyle">Operation :-</td>
                <td>@Model.Operation</td>
                <td class="collvlstyle">Division :-</td>
                <td>@Model.Division</td>
            </tr>
            <tr class="row2">
                <td class="collvlstyle">Department :-</td>
                <td>@Model.Department</td>
                <td class="collvlstyle">Section :-</td>
                <td>@Model.Section</td>
            </tr>
            <tr class="row1">
                <td class="collvlstyle">Evaluator :-</td>
                <td>@Model.Evaluator</td>
                <td class="collvlstyle">Reviewer :-</td>
                <td>@Model.Reviewer</td>
            </tr>
        </table>

        <div class="separation"></div>

        <!-- Role -->
        <table class="tableGridView" width="100%">
            <tr>
                <td class="HeaderStyle12">&nbsp;Role</td>
            </tr>
            <tr>
                <td style="padding:3px;line-height:15px;">@Model.Role</td>
            </tr>
        </table>

        <div class="separation"></div>

        <!-- PART A -->
        <table class="tableGridView" width="100%">
            <tr>
                <td class="HeaderStyle12">&nbsp;Performance Assesment [PART A]</td>
            </tr>
            <tr>
                <td>
                    <div class="mainviewdiv">
                        <div class="headerdiv">Activities</div>

                        @for (int i = 0; i < Model.Activities.Length; i++)
                        {
                            var a = Model.Activities[i];
                            <table class="fhpmstable_u">
                                <tr>
                                    <td class="tabletd_yellow" colspan="3">@(i + 1)) Activity</td>
                                </tr>
                                <tr>
                                    <td colspan="3">@a["ACTIVITY"]</td>
                                </tr>
                                <tr>
                                    <td class="tabletd_blue">Control Item</td>
                                    <td class="tabletd_blue">Target</td>
                                    <td class="tabletd_blue">Weightage</td>
                                </tr>
                                <tr>
                                    <td>@a["CONTROLITEM"]</td>
                                    <td>@a["TARGET"]</td>
                                    <td>@a["WEIGHTAGE"]%</td>
                                </tr>
                            </table>

                            <table class="fhpmstable_l">
                                <tr>
                                    <td colspan="4" class="tabletd_blue">Achievement</td>
                                </tr>
                                <tr>
                                    <td class="tabletd_green">First Half</td>
                                    <td>@a["MYRESULT"]</td>
                                    <td class="tabletd_green">Eval Score</td>
                                    <td align="center">@ePortal.Shared.Encryption.Decrypt(a["MYEVLTSCORE"].ToString())</td>
                                </tr>
                                <tr>
                                    <td class="tabletd_green">Second Half</td>
                                    <td>@a["FYRESULT"]</td>
                                    <td class="tabletd_green">Eval Score</td>
                                    <td align="center">@ePortal.Shared.Encryption.Decrypt(a["FYEVLTSCORE"].ToString())</td>
                                </tr>
                            </table>
                        }

                        <div class="totalweight_1">
                            Total Weightage = @Model.PartAActivityWeightage %
                        </div>
                    </div>

                    <div class="separation"></div>

                    <!-- Other Activities -->
                    <div class="mainviewdiv">
                        <div class="headerdiv">Other Activities</div>

                        @foreach (var a in Model.OtherActivities)
                        {
                            <table class="fhpmstable_u">
                                <tr>
                                    <td colspan="3" class="tabletd_yellow">Activity</td>
                                </tr>
                                <tr>
                                    <td colspan="3">@a["ACTIVITY"]</td>
                                </tr>
                                <tr>
                                    <td class="tabletd_blue">Control Item</td>
                                    <td class="tabletd_blue">Target</td>
                                </tr>
                                <tr>
                                    <td>@a["CONTROLITEM"]</td>
                                    <td>@a["TARGET"]</td>
                                </tr>
                            </table>

                            <table class="fhpmstable_l">
                                <tr>
                                    <td colspan="2" class="tabletd_blue">Achievement</td>
                                </tr>
                                <tr>
                                    <td class="tabletd_green">First Half</td>
                                    <td>@a["MYRESULT"]</td>
                                </tr>
                                <tr>
                                    <td class="tabletd_green">Second Half</td>
                                    <td>@a["FYRESULT"]</td>
                                </tr>
                            </table>
                        }

                        <table class="othActScore_3">
                            <tr>
                                <td class="tabletd_green">First Half Eval Score</td>
                                <td align="center">@Model.FirstHalfScore</td>
                                <td class="tabletd_green">Second Half Eval Score</td>
                                <td align="center">@Model.SecondHalfScore</td>
                            </tr>
                        </table>

                        <div class="totalweight_5">
                            Total Weightage = @Model.OtherActivityWeightage %
                        </div>
                    </div>
                </td>
            </tr>
        </table>

        <div class="separation"></div>

        <!-- PART B -->
        <table class="tableGridView" width="100%">
            <tr>
                <td class="HeaderStyle12">&nbsp;Competencies [PART B]</td>
            </tr>
            <tr>
                <td>
                    @foreach (System.Data.DataRow h in Model.Headers.Rows)
                    {
                        <div class="mainviewdiv">
                            <div class="headerdiv">@h["HEADDESCRIPTION"]</div>

                            <table width="100%">
                                <tr class="tabletd_blue">
                                    <th>S.No</th>
                                    <th>Level Description</th>
                                    <th>Skill Level</th>
                                    <th>FH Score</th>
                                    <th>SH Score</th>
                                </tr>

                                @* Loaded via controller logic *@
                            </table>
                        </div>
                    }
                </td>
            </tr>
        </table>

        <div class="separation"></div>

        <!-- Total Score -->
        <table class="tableGridView" width="100%">
            <tr>
                <td class="HeaderStyle12" colspan="2">&nbsp;Total Score</td>
            </tr>
            <tr>
                <td>First Half Evaluator Score</td>
                <td>
                    <span style="color:darkorange">@Model.FirstHalfFormula</span>
                    @Model.FirstHalfTotalScore
                </td>
            </tr>
            <tr>
                <td>Second Half Evaluator Score</td>
                <td>
                    <span style="color:darkorange">@Model.SecondHalfFormula</span>
                    @Model.SecondHalfTotalScore
                </td>
            </tr>
        </table>

    </div>
</div>
