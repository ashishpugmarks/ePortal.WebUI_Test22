@model ePortal.ViewModels.ViewSecondHalfFormViewModel
@{
    ViewData["Title"] = "PMS - Second Half Form";
    Layout = null; // keep same as ASPX (no master page)
}

<link href="~/css/index.css" rel="stylesheet" />
<link href="~/css/ProStyle.css" rel="stylesheet" />

<style>
    .style1 {
        height: 41px;
    }
</style>

<div class="maincontainer">
    <div style="border: 0px solid #6393DF; margin-bottom: 20px; clear: both;">
        <div class="Viewpg_heading">PMS - Second Half Form</div>

        <!-- Associate Details -->
        <table class="tableGridView assdet" width="100%">
            <tr>
                <td class="HeaderStyle12" colspan="4">&nbsp;Associate Details</td>
            </tr>
            <tr class="row2">
                <td class="collvlstyle">Employee:</td>
                <td class="lblcss">@Model.EmployeeName</td>
                <td class="collvlstyle">Date of Joining:</td>
                <td class="lblcss">@Model.DateOfJoining</td>
            </tr>
            <tr class="row1">
                <td class="collvlstyle">Operation:</td>
                <td class="lblcss">@Model.Operation</td>
                <td class="collvlstyle">Division:</td>
                <td class="lblcss">@Model.Division</td>
            </tr>
            <tr class="row2">
                <td class="collvlstyle">Department:</td>
                <td class="lblcss">@Model.Department</td>
                <td class="collvlstyle">Section:</td>
                <td class="lblcss">@Model.Section</td>
            </tr>
            <tr class="row1">
                <td class="collvlstyle">Evaluator:</td>
                <td class="lblcss">@Model.Evaluator</td>
                <td class="collvlstyle">Reviewer:</td>
                <td class="lblcss">@Model.Reviewer</td>
            </tr>
        </table>

        <div class="separation">&nbsp;</div>

        <!-- Role -->
        <table class="tableGridView" width="100%">
            <tr>
                <td class="HeaderStyle12">&nbsp;Role</td>
            </tr>
            <tr>
                <td style="padding:3px">@Model.Role</td>
            </tr>
        </table>

        <div class="separation">&nbsp;</div>

        <!-- PART A -->
        @if (Model.Activities.Any())
        {
            <table class="tableGridView" width="100%">
                <tr>
                    <td class="HeaderStyle12">&nbsp;Performance Assessment [PART A]</td>
                </tr>
                <tr>
                    <td>
                        <div class="mainviewdiv">
                            <div class="headerdiv">Activities</div>
                            @{
                                int i = 1;
                            }
                            @foreach (var act in Model.Activities)
                            {
                                <table class="fhpmstable_u">
                                    <tr>
                                        <td class="tabletd_yellow" colspan="3">@i) Activity</td>
                                    </tr>
                                    <tr>
                                        <td colspan="3">@act.Activity</td>
                                    </tr>
                                    <tr>
                                        <td class="tabletd_blue">Control Item</td>
                                        <td class="tabletd_blue">Target</td>
                                        <td class="tabletd_blue">Weightage</td>
                                    </tr>
                                    <tr>
                                        <td>@act.ControlItem</td>
                                        <td>@act.Target</td>
                                        <td>@act.Weightage %</td>
                                    </tr>
                                </table>

                                <table class="fhpmstable_l">
                                    <tr>
                                        <td class="tabletd_blue" colspan="2">Achievement</td>
                                    </tr>
                                    <tr>
                                        <td class="tabletd_green">First Half</td>
                                        <td>@act.FirstHalfResult</td>
                                    </tr>
                                    <tr>
                                        <td class="tabletd_green">Second Half</td>
                                        <td>@act.SecondHalfResult</td>
                                    </tr>
                                </table>
                                i++;
                            }

                            <div class="totalweight_1">
                                Total Weightage = @Model.ActivityTotalWeight %
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        }

        <div class="separation">&nbsp;</div>

        <!-- PART B -->
        @if (Model.CompetencyHeaders.Any())
        {
            <table class="tableGridView" width="100%">
                <tr>
                    <td class="HeaderStyle12">&nbsp;Competencies [PART B]</td>
                </tr>
                <tr>
                    <td>
                       
                        @foreach (var header in Model.CompetencyHeaders)
                        {
                            <div style="border:1px solid #C0C0C0;margin-bottom:5px">
                                <div class="headerdiv">@header.Description</div>

                                <table width="100%">
                                    <tr>
                                        <th>S.No</th>
                                        <th>Level Description</th>
                                        <th>Skill Level</th>
                                    </tr>
                                    @{
                                        int i = 1;
                                    }
                                    @foreach (var lvl in header.Levels)
                                    {
                                        <tr>
                                            <td align="center">@i</td>
                                            <td>@lvl.Description</td>
                                            <td align="center">@lvl.FinalScore</td>
                                        </tr>
                                        i++;
                                    }
                                </table>
                            </div>
                           
                        }
                    </td>
                </tr>
            </table>
        }

        <div class="separation">&nbsp;</div>

        <!-- COMMENTS -->
        <table class="tableGridView twowaycomm" width="100%">
            <tr>
                <td class="HeaderStyle12" colspan="2">&nbsp;Part B Comment</td>
            </tr>
            <tr>
                <td class="fhassessmentlblhead_2"><b>First Half Associate Comment</b></td>
                <td>@Model.FirstHalfAssociateComment</td>
            </tr>

            @if (!string.IsNullOrEmpty(Model.SecondHalfAssociateComment))
            {
                <tr>
                    <td class="fhassessmentlblhead_2"><b>Second Half Associate Comment</b></td>
                    <td>@Model.SecondHalfAssociateComment</td>
                </tr>
            }

            @if (!string.IsNullOrEmpty(Model.EvaluatorComment))
            {
                <tr>
                    <td class="fhassessmentlblhead_2"><b>Evaluator Comment</b></td>
                    <td>@Model.EvaluatorComment</td>
                </tr>
            }

            @if (!string.IsNullOrEmpty(Model.ReviewerComment))
            {
                <tr>
                    <td class="fhassessmentlblhead_2"><b>Reviewer Comment</b></td>
                    <td>@Model.ReviewerComment</td>
                </tr>
            }

            @if (!string.IsNullOrEmpty(Model.AssociateComment))
            {
                <tr>
                    <td class="fhassessmentlblhead_2"><b>Associate Comment</b></td>
                    <td>@Model.AssociateComment</td>
                </tr>
            }
        </table>
    </div>
</div>
