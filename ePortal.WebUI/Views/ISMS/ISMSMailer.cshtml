@model ePortal.ViewModels.APPX.ISMS.ISMSMailerModel
@{
    ViewBag.Title = "ISMSMailer";
    Layout = "~/Views/Shared/ISMSPAGE.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="../css/NewMasterStyleSheet.css" />
    <link rel="stylesheet" href="../css/jquery.dataTables.css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .form-control {
            height: 29px;
            padding: 4px 9px;
            font-size: 13px;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        #grdmailler th {
            height: 30px; 
            line-height: 30px; 
        }

        #grdmailler tr {
            height: 30px; 
            line-height: 30px; 
        }


    </style>
}

  <div class="form-horizontal">           
    <div class="body-content">    
            <div class="row" id="_form">
                <div class="panel-group" style="margin-top: -16px;">
                    <div class="panel panel-primary">
                        <div class="panel-heading" style="text-align:left;background-color: #8A8A8A;">
                            <h2 class="panel-title">
                                <strong>Awareness Mailer</strong>
                            </h2>
                        </div>
                        <div class="panel-body" style="padding:5px;">
                            <div class="row" style="padding:2px;">
                               <label for="lblcatserch" class="control-label col-md-2">Category : </label>
                                <div class="col-md-2 col-lg-2">
                                <form id="ddcategory">
                                    <select id="ddcategorysearh" asp-for="SelectedCategoryId"
                                            asp-items="@(new SelectList(Model.CategoryViewModel, "CatId", "CategoryName",Model.SelectedCategoryId))"
                                            class="form-control" style="width:157px;height:32px;">
                                        <option value="0">--Select Category--</option>
                                    </select>
                                </form>
                                </div>
                                <label for="lblcatserch" class="control-label col-md-2">Year : </label>
                                <div class="col-md-2 col-lg-2">
                                <form id="ddyears">
                                    <select id="ddyear" asp-for="SelectedYear"
                                            asp-items="@(new SelectList(Model.YearCategoryViewModel, "Year", "Year",Model.SelectedYear))"
                                            class="form-control" style="width:135px;height:32px;">
                                        <option value="0">--Select Year--</option>
                                    </select>
                                </form>
                                </div>
                                <label for="lblcatserch" class="control-label col-md-2">Month : </label>
                                <div class="col-md-2 col-lg-2">
                                <form id="ddmonths">
                                    <select id="ddmonth" asp-for="SelectedMonth"
                                            asp-items="@(new SelectList(Model.MonthCategoryViewModel, "MonthYear", "MonthYear",Model.SelectedMonth))"
                                            class="form-control" style="width:135px;height:32px;">
                                        <option value="0">--Select Month--</option>
                                    </select>
                                </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <div class="row" style="margin-bottom: 15px;">
        </div>
       
        <div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
                <table id="grdmailler" class="table table-bordered table-hover table-striped table-responsive">
                    <thead class="bg-info">
                        <tr>
                            <th style="text-align:center">Sr. No</th>
                            <th>Mailer Subject</th>
                            <th style="text-align:center">Published On</th>
                        </tr>
                    </thead>
                    <tbody style="text-align:left;">
                                @if (!Model.GetMaillerDetailsViewModel.Any())
                                {
                                    <tr>
                                        <td colspan="3">No Record Found.</td>
                                    </tr>
                                }
                                else
                                {
                                    var srNo = 1;
                                    foreach (var item in Model.GetMaillerDetailsViewModel)
                                    {
                                        <tr>
                                    <td class="text-center" style="width:7%">@srNo</td>
                                    <td style="width:73%">
                                        <a target="_blank" href="@Url.Action("OpenForm", "ISMS", new { FILENAME = item.FileName })">
                                            @item.MailerDescription
                                        </a>

                                            </td>
                                    <td class="text-center" style="width:10%">@item.DateValue.ToString("dd MMM yyyy")</td>
                                        </tr>
                                        srNo++;
                                    }
                                }
                            </tbody>
                        </table>

            </div>
                    <div style="margin-left: 0.8em; margin-right: 0.8em;" class="well well-sm">
                        <table border="0" style="width: 100%;">
                            <tr>
                                <td style="height: 20px;">
                                    <table style="width: 100%;">
                                        <tbody>
                                            <tr>
                                                <td style="width: 20px; vertical-align: middle; text-align: center;">
                                                    <a title="Back" href="@Url.Action("ISMSHome", "ISMS")">
                                                        <img src="../images/icon_back.gif" border="0" alt="" />
                                                    </a>
                                                </td>
                                                <td style="vertical-align: middle; font-size: 15px;">
                                                    <span><a title="Back" href="@Url.Action("ISMSHome", "ISMS")">Back</a></span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>
        </div>
    </div>


@section Scripts {
    <script src="../js/jquery.3.6.3.js"></script>
    <script src="../js/jquery.dataTables.js"></script>
    <script src="../lib/bootstrap/js/bootstrap.min.js"></script>
    <script src="../js/alertmessage.js"></script>
     <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        $(document).ready(function () {
          function WindowSettings_WithoutMenu(str1,str2)
           {
	        var winTop = (screen.height / 2) - 325 ;
	        var winLeft = (screen.width / 2) - 425 ;
	        var windowFeatures = "location=no,status=no,width=800,height=550" ;
	        windowFeatures = windowFeatures + ",left = " + winLeft + "," ;
	        windowFeatures = windowFeatures + "top=" + winTop + ",resizable"+ ",scrollbars" ;
	        window.open(str1, str2, windowFeatures) ;
           }

            $("#ddcategorysearh").change(function () {
                var selectedCat = $(this).val();
                var selectedCatText = $("#ddcategorysearh option:selected").text(); 
                var selectedYearText = $("#ddyear option:selected").text();
                var selectedMonthText = $("#ddmonth option:selected").text(); 

                $.ajax({
                    url: '/ISMS/ddcategorysearhIndexChange',
                    type: 'POST',
                    data: { 
                        SelectedCategoryId: selectedCat,
                        SelectedCatIdText: selectedCatText,
                        SelectedYearText: selectedYearText,
                        SelectedMonthText: selectedMonthText
                    },
                    success: function (result) {
                        $("body").html(result);
                    },
                    error: function () {
                        alert("Error loading FAQs");
                    }
                });
            });

            $("#ddyear").change(function () {
                var selectedYr = $(this).val();
                var selectedCatText = $("#ddcategorysearh option:selected").text();
                var selectedYearText = $("#ddyear option:selected").text();
                var selectedMonthText = $("#ddmonth option:selected").text();
                var selectedCat = $("#ddcategorysearh option:selected").val();
                $.ajax({
                    url: '/ISMS/ddyear_SelectedIndexChanged',
                    type: 'POST',
                    data: { 
                        SelectedYear: selectedYr,
                        SelectedCatIdText: selectedCatText,
                        SelectedYearText: selectedYearText,
                        SelectedMonthText: selectedMonthText,
                        SelectedCategoryId: selectedCat,
                    },
                    success: function (result) {
                        $("body").html(result);
                    },
                    error: function () {
                        alert("Error loading FAQs");
                    }
                });
            });

            $("#ddmonth").change(function () {
                var selectedMnth = $(this).val();
                var selectedCatText = $("#ddcategorysearh option:selected").text();
                var selectedYearText = $("#ddyear option:selected").text();
                var selectedMonthText = $("#ddmonth option:selected").text();
                var selectedCat = $("#ddcategorysearh option:selected").val();
                $.ajax({
                    url: '/ISMS/ddmonth_SelectedIndexChanged',
                    type: 'POST',
                    data: { 
                        SelectedMonth: selectedMnth,
                        SelectedCatIdText: selectedCatText,
                        SelectedYearText: selectedYearText,
                        SelectedMonthText: selectedMonthText,
                        SelectedCategoryId: selectedCat,
                    },
                    success: function (result) {
                        $("body").html(result);
                    },
                    error: function () {
                        alert("Error loading FAQs");
                    }
                });
            });

            initializeTables();
        });
        function initializeTables() {
            debugger;
            var $mailler = $('#grdmailler');

            if ($.fn.DataTable.isDataTable($mailler)) $mailler.DataTable().destroy();
            $mailler.DataTable({ pageLength: 15, lengthChange: false, bFilter: false });
        }
       
        
     </script>
      
}