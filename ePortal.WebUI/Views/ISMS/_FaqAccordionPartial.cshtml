@model IEnumerable<ePortal.ViewModels.APPX.ISMS.FaqViewModel>

<div id="repAccordian" class="row" style="margin-bottom: 15px;">
    <div id="accordion" style="width: 100%;">
            @if (Model != null && Model.Any())
            {
                foreach (var faq in Model)
                {
                <div style="min-height: 60px;">
                        Question : @faq.Description
                        <br />
                </div>
                    <div>
                    <table style="min-height: 30px;">
                            <tr>
                                <td><b>Answer</b></td>
                                <td>:&nbsp;&nbsp;</td>
                                <td>@faq.Answer</td>
                            </tr>
                        </table>
                    </div>
                }
            }
           
        </div><br /><br /><br />
        <div style="margin-left: 0.8em; margin-right: 0.8em;" class="well well-sm">
            <table border="0" style="width: 100%;">
                <tr>
                    <td style="height: 20px;">
                        <table style="width: 100%;">
                            <tbody>
                                <tr>
                                    <td style="width: 20px; vertical-align: middle; text-align: center;">
                                        <a title="Back" href="@Url.Action("ISMSHome", "ISMS")">
                                            <img src="../images/icon_back.gif" border="0" alt="" />
                                        </a>
                                    </td>
                                    <td style="vertical-align: middle; font-size: 15px;">
                                        <span><a title="Back" href="@Url.Action("ISMSHome", "ISMS")">Back</a></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </div>
