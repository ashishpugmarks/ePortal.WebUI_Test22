@model ePortal.ViewModels.SISMenuViewModel
@using System.Data;
@using System.Web;
@{
    ViewBag.Title = "ISMSHome";
    Layout = "~/Views/Shared/ISMSPAGE.cshtml";
}

@section Styles {

   <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
     table.dataTable thead th, table.dataTable thead td {
             padding: 8px 12px;
         }

         .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
             line-height: 1.0;
             vertical-align: middle;
             font-family: "Helvetica Neue", Helvetica, Arial;
         }

         table.dataTable tbody td {
             padding: 4px 3px;
         }

         .form-control {
             height: 29px;
             padding: 4px 9px;
             font-size: 13px;
         }

         select.input-sm {
             line-height: 10px !important;
         }

         .readmore {
             margin-top: 9px;
         }
      @@media screen and (max-width:767px) {
          .img {
              position: center;
              right: auto;
              width: 100%;
              height: auto;
          }

          .img1 {
              position: center;
              right: auto;
              width: 100%;
              height: auto;
          }

          .img3 {
              position: center;
              right: auto;
              width: 100%;
              height: auto;
          }

          .mrg {
              margin-top: 650px;
          }
      }

      @@media screen and (min-width:767px) {
          .img {
              width: 100%;
              height: 84px;
          }

          .img1 {
          }

          .img3 {
              width: 100%;
              height: 80px;
          }

          .mrg {
              margin-top: 50px;
          }
      }

      @@media screen and (min-width:1184px) {
          .img {
              width: 250px;
              height: 180px;
          }

          .img3 {
              width: 250px;
              height: 175px;
          }

          .img1 {
              height: 250px;
          }

          .mrg {
              margin-top: 50px;
          }
      }

    </style>
}


<div class="col-sm-3">
    <div class="col-sm-12">
        <div class="sidebar" style="height:9.6em;">
            <ul>
                <li style="height:auto;">

                    <h2 style="font-family:Roboto-Regular; text-align:center">Pocket Manual</h2>
                    <ul>
                        <li>
                            <a id="apm">
                                <img class="img" border="0" src="~/ASPXView/images/ISMS/PoketManual.JPG" alt="Pocket Manual" style="margin-bottom: 13px;" align="left" />
                            </a>
                        </li>
                    </ul>
                    <ul>
                        <li>

                            &nbsp;&nbsp; <a id="a1" class="hindilanbuttons" href="@Url.Content("~/Uploads/ISMS/Hindi.pdf")" target="_blank"><b>Hindi</b></a>&nbsp;&nbsp;
                            <a id="a2" class="englanbuttons" href="@Url.Content("~/Uploads/ISMS/English.pdf")" target="_blank"><b>English</b></a>&nbsp;&nbsp;
                            <a id="a3" class="kannadalanbuttons" href="@Url.Content("~/Uploads/ISMS/Kannada.pdf")" target="_blank"><b>Kannada</b></a> &nbsp;&nbsp;
                            <a id="a4" class="gujartilanbuttons" href="@Url.Content("~/Uploads/ISMS/Gujrati.pdf")" target="_blank"><b>Gujrati</b></a>&nbsp;&nbsp;&nbsp;
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="mrg col-sm-9">
  <div class="col-xs-12 col-sm-8">
      <div class="col-sm-12" style="width:120%; margin-left: -75px; margin-top: -45px; margin-bottom: 50px;">
            <div class="col-sm-12">
                <div class="announcements" style="background-image: url('/images/announcement_bg.jpg'); background-size: 100% 100%;">
                    <div class="verticalText">
                        <h4 style="margin-bottom: 24px;font-family: 'roboto_slabregular';color: white;">Policy&nbsp;Statement</h4>
                    </div>

                    <div id="myCarousel" class="carousel slide" style="overflow: hidden;" data-interval="false">
                        <ol>
                            <li data-target="#myCarousel" data-slide-to="0" class="active"></li>
                            <li data-target="#myCarousel" data-slide-to="1"></li>
                            <li data-target="#myCarousel" data-slide-to="2"></li>
                        </ol>
                        <div class="carousel-inner">

                            <div class="item active">

                                <img src="~/ASPXView/images/ISMS//Hindi.png" class="imgresp img1" style="margin-left:4%" alt="Hindi">


                            </div>

                            <div class="item">

                                <img src="~/ASPXView/images/ISMS/Policy1.png" class="imgresp img1" style="margin-left:4%" alt="English">
                            </div>

                            <div class="item">

                                <img src="~/ASPXView/images/ISMS/gujrati1.png" class="imgresp img1" style="margin-left:4%" alt="Gujrati">
                            </div>
                            <div class="item">

                                <img src="~/ASPXView/images/ISMS/kannada20.png" class="imgresp img1" style="margin-left:4%" alt="Kannada">
                            </div>

                        </div>


                        <a class="left carousel-control" href="#myCarousel" data-slide="prev">
                            <span class="glyphicon glyphicon-chevron-left"></span>
                            <span class="sr-only">Previous</span>
                        </a>
                        <a class="right carousel-control" href="#myCarousel" data-slide="next">
                            <span class="glyphicon glyphicon-chevron-right"></span>
                            <span class="sr-only">Next</span>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div> <div class="col-sm-4">
        <div class="col-sm-12">
            <div class="sidebar1" style="height: 9.6em;">
                <ul>
                    <li style="height: 200px;">
                        <h2 style="margin-top: -51px;font-family:'Roboto-Regular'; text-align:center">Awareness Mailer</h2>
                        <ul>
                            <li>
                                <a id="ans">
                                    <img border="0" src="~/ASPXView/images/ISMS/mailernews.png" class="img3" alt="News Letter" align="left" />
                                </a>
                            </li>
                        </ul>
                        <ul>
                            <li>
                                <h1>
                                      <a href="@ViewBag.lblmmggNavigateUrl" target="_blank" style="height:20px; font-size:13px">
                                        <b>Mailer of the Month: @ViewBag.lblmmggtext</b>
                                      </a>

                                </h1>
                            </li>
                            <br />
                            <li>
                                <a id="lnkmailerofmonth" href="@Url.Action("lnkmailerofmonth_Click", "ISMS")" style="height:20px;font-size:14px;">Read More ....</a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
  </div>

</div>

<div class="col-sm-3">
    <div class=" mrg col-sm-12">

        <div class="sidebar" style="height:9.6em;">
            <ul>
                <li style="height: 200px;margin-top:-93%">
                    <h2 style="margin-top:-83px;font-family:Roboto-Regular; text-align:center">ISO 27001 & ISO 27701 Certificates</h2>
                    <ul>
                        <li>
                           
                            <a id="acf" target="_blank">
                                <img src="@Url.Content("~/ASPXView/images/ISMS/certificate.PNG")"
                                     class="img" alt="ISO 27001 Certificate" style="border:0;" align="left" />
                            </a>

                        </li>
                    </ul>
                </li>
            </ul>
        </div>


    </div>
</div>

<div class="col-sm-9">
    <div class="col-xs-12 col-sm-8">
        <div class="col-sm-12" style="width:120%; margin-left: -75px; margin-top: -30px; margin-bottom: 50px;">
                <div class="col-sm-12" hidden>
                    <div class="announcements" style="height:12.2em; background-image: url('/images/announcement_ISMSbg.jpg'); background-size: 100% 100%;">
                        <div class="verticalText">
                            <h4 style="margin-left:12px;margin-bottom: 23px;font-family: 'roboto_slabregular';color: white;">Latest&nbsp;&nbsp;Update</h4>
                        </div>

                        <div id="myCarousel1" class="carousel slide media-carousel" data-ride="carousel" style="height:43px">
                            <ol class="carousel-indicators">
                            @{
                                var imgTable = ViewBag.ImgTable as DataTable;
                            }
                            @if (imgTable != null && imgTable.Rows.Count > 0)
                            {
                                for (int i = 0; i < imgTable.Rows.Count; i++)
                                {
                                    <li data-target="#myCarousel1"
                                        data-slide-to="@i"
                                        class="@(i == 0 ? "active" : "")"></li>
                                }
                            }

                            </ol>

                            <div class="carousel-inner">
                                @if (imgTable != null && imgTable.Rows.Count > 0)
                                {
                                    for (int i = 0; i < imgTable.Rows.Count; i++)
                                    {
                                        var row = imgTable.Rows[i];
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img style="height:12.2em;width:100%;" src="@row["MENU_URL"]" alt="@row["Description"]" />
                                            <div class="carousel-caption d-none d-md-block">
                                            <h4 style="color:black;margin-bottom: 42px;">@row["DESCRIPTION"]</h4>
                                            <a href="javascript:void(0);" onclick="openWindow('@row["ANNOUCE_ID"]');"></a>
                                            </div>
                                        </div>
                                    }
                                }

                            </div>
                        </div>
                        <div class="announceContent" style="background-size: 100% 100%; background-repeat: no-repeat; color: #003666;">


                            <div class="clear-both"></div>
                            <div>


                                <p class="topMargin" style="white-space: pre-wrap; margin-left: 3.01em;"></p>

                            </div>

                            <img src="@Url.Content("~/images/logo_honda_announcement.png")"
                             alt="Announcement"
                             title="Announcement"
                             class="announcementImg" />

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mrg col-sm-4">
            <div class="col-sm-12">
                <div class="sidebar1" style="height: 9.6em;">
                    <ul>
                        <li style="height: 200px;margin-top:-93%;">
                            <h2 style="margin-top: -83px;font-family:'Roboto-Regular';text-align:center">FAQS </h2>
                            <ul>
                                <li>
                                    <a id="a11">
                                       <img border="0" src="~/ASPXView/images/ISMS/Faq2.png" alt="FAQ" class="img" align="left" />
                                    </a>
                                </li>
                                <li>
                                 <a id="lnkfaq" href="@Url.Action("lnkfaq_Click", "ISMS")" style="height:20px;font-size:14px;">Read More ....</a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        $(document).ready(function () {
            debugger;
            //Added by aumento as on 08082024 for the SR72656 -----------------------------------------------------
            $.ajax({
                type: "GET",
                url: "/ISMSMaster/GetActiveLink",
                contentType: "application/json; charset=utf-8",
                dataType: "text",
                success: function (response) {

                    // Debugging: Log the response to the console
                    // console.log("Response:", response);

                    if (response != null || response != "") {
                        document.getElementById('acf').setAttribute('href', '/Uploads/ISMS/' + response);
                        //$('#acf').attr('href', '/Uploads/ASR/Calendar/' + response);
                    } else {
                        console.error("ActiveLink not found in the response.");
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    // Detailed error logging
                    console.error("Error retrieving active link:", textStatus, errorThrown);
                    alert("Failed to retrieve active link.");
                }
            });

            //-------------------------------------------------------------------------------------------------------
            $.ajax({
                type: "GET",
                url: "/ISMS/GetAnnoncementList",
                data: "",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    debugger;
                    var daobj = data.ISMSANNOUNANCEVMLISTItems

                }
            });


        });
    </script>
}