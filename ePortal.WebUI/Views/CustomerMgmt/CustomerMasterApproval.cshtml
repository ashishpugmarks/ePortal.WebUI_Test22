    <style type="text/css" nonce="@Context.Items["StyleNonce_2"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
    </style>
    <script src="~/bundle/jquery.min.js"></script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $('#btnsubmit').on('click', function (e) {
                e.preventDefault();
                submitdata($(this));
            });
            $('#btncancelfrm').on('click', function (e) {
                e.preventDefault();
                window.location.href = "CMRequestApproval";
            });
            $('a').on('click', function (event) {
                event.preventDefault();                
                $(this).prop("style", "color:green;font-weigth:bold;");
                let urlpath = '../../Uploads/CustomerMaster/' + $(this).text();
                openDialog(urlpath, 980, 680);
            });
        });
        function openDialog(url, w, h) { window.open(url, "_blank", `width=${w},height=${h},resizable=yes,scrollbars=yes`); }

        function submitdata(id) {

            try {
                $('#lblErrMsg').text('');
                $('#lblSuccessMsg').text('');

                // Read values
                const $ddl = $('#ddlstatus');
                const selectedIndex = $ddl.prop('selectedIndex');
                const action1 = parseInt($ddl.val(), 10); // 1=Approve, 0=Reject, 2=Send Back
                const remarks = $('#txt_Remarks').val().trim();
                const chkMatch = $('#chk_match').is(':checked');
                const chkDecl = $('#chkdeclaration').is(':checked');

                const cmheadid = parseInt($('#hidCMHeader').val(), 10);
                const requestNo = $('#hidCMRequest').val();



                if (selectedIndex < 1) {
                    const msg = 'Please select action type!';
                    $('#lblErrMsg').text(msg);
                    sweetAlert("Customer Master", msg, "warning");
                    return;
                }
                if (remarks.length < 1) {
                    const msg = 'Please enter remarks!';
                    $('#lblErrMsg').text(msg);
                    sweetAlert("Customer Master", msg, "warning");
                    return;
                }
                if (!chkMatch) {
                    const msg = 'Please verify and match details of customer!';
                    $('#lblErrMsg').text(msg);
                    sweetAlert("Customer Master", msg, "warning");
                    return;
                }
                if (!chkDecl) {
                    const msg = 'Please read and check declaration condition!';
                    $('#lblErrMsg').text(msg);
                    sweetAlert("Customer Master", msg, "warning");
                    return;
                }

                const code = $('#lblcode').text().trim();
                const name = $('#lblName1').text().trim();
                const $btn = $(id).prop('disabled', true);
                var data = {
                    cmheadid: cmheadid,
                    request_no: requestNo,
                    action: action1,
                    Remarks: remarks,
                    Customer_Code: code,
                    Name1: name
                };

                $.ajax({
                    type: "POST",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    url: "/CustomerMgmt/ApprovalRequestSubmit",
                    data: JSON.stringify(data),
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    success: function (data) {
                        if (data.RS == 1) {
                            $('#lblSuccessMsg').text(data.message);
                            sweetAlert("Customer Master data", data.message, "success");
                            window.location.href = data.redirecturl;
                        }
                        else {
                            $('#lblErrMsg').text(data.message);
                            sweetAlert("", data.message, "warning");
                            $btn.prop('disabled', false);
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        $btn.prop('disabled', false);
                        sweetAlert("", "Oops... Something went wrong!.", "warning");

                    }
                });

            } catch (ex) {
                sweetAlert("", "Oops... Something went wrong!.", "warning");
                console.log(ex.message || 'Unexpected error');
                $(id).prop('disabled', false);
            }


        }


    </script>
