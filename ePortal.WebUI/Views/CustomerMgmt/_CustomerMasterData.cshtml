    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
            $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
       if ($.fn.DataTable.isDataTable("#tbRequestReport")) {
            $("#tbRequestReport").DataTable().clear().destroy();
          }
          // $('#TainingTable tbody').empty();

            $("#tbRequestReport").DataTable({
            "bFilter": false,
            "bLengthChange": false,
            "paging": true,
            "pageLength": 10,
            "ordering": false,
            "autoWidth": false
        });
        // $('[data-ctrl-id="bt-edit-dt"]').on('click', function () {
        //      EditMasterData($(this)[0]);
        // });

    $('#tbRequestReport tbody').on('click', '[data-ctrl-id="bt-edit-dt"]', function (e) {
          e.preventDefault();
          EditMasterData(this);
        });


      });
    </script>

@* </head>
<body> *@
 
  <table class="table table-bordered table-hover table-responsive" id="tbRequestReport" style="width:100%;border-collapse:collapse;border:1px">
    <thead>
                <tr class="grdHeader cmgrdhead">
            <th>
                @Html.DisplayName("Srl No")
            </th>
            <th>
                @Html.DisplayName("Code")
            </th>
            <th>
                @Html.DisplayName("Code Description")
            </th>
            <th>
                @Html.DisplayName("Parent Group")
            </th>                 
            <th>
                @Html.DisplayName("Status")
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @{
            int rowNo = 0;
        }
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                string clname = "";
                int r = rowNo + 1;
                if(r%2==0)
                {
                    clname = " background-color: White;color: #5D838C";
                }
                        <tr class="grdrow cmgrdrow" style="@clname">
                    <td class="text-left" style="width:10%;">
                        @(rowNo += 1)
                    </td>
                    <td >
                        @Html.DisplayFor(modelItem => item.Code)
                    </td>
                    <td >
                        @Html.DisplayFor(modelItem => item.CodeDesc)
                    </td>
                     <td >
                        @Html.DisplayFor(modelItem => item.PgroupName)
                    </td>              
               
                    <td >
                        @Html.DisplayFor(modelItem => item.IsActive)
                    </td>
                    <td class="text-center">

                        <input type="image"
                               src="~/images/icon_edit.gif"
                               alt="edit"
                               title="Click here to edit record" data-ctrl-id='bt-edit-dt' data-id="@item.CmdId" />

                             @* <button class="btn btn-info btn-xs glyphicon glyphicon-tasks" title="Click to detail" onclick="ViewReqForm('@Html.DisplayFor(modelItem => item.CmdId)');"></button> *@
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    No data available.
                </td>
            </tr>
        }
    </tbody>
    
</table>

@* </body>
</html> *@
