@using System.Net;
@model List<ePortal.ViewModels.APPX.CustomerMgmt.CustomerRequestRpt>


@{
    ViewBag.Title = "Customer Master Data";
    Layout = "~/Views/Shared/_Layout.cshtml";//_LayoutInnerPage.cshtml
   // Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles{
    <link href="~/css/CMStyle.css" rel="stylesheet" type="text/css" />
    <link href="~/css/index.css" rel="stylesheet" type="text/css" />
    <link href="~/css/jquery.dataTables.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_2"]">
        div.dataTables_info {
            padding-top: 10px;
            margin-left: 25px;
            margin-top: 10px;
            font-weight: bold;
            color: #337ab7;
            white-space: nowrap;
        }
        /*.row {
            margin-right: 0px;
            margin-left: 0px;
            font-size:12px;
        }*/
        .vendorbtn{
            font-size:13px!important;
        }
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
    </style>
}
@section Scripts{

    <script type="text/javascript" src="~/app/JS/CustomerMgmt/CustomerManageRequestAdmin.js" >     
    </script>
}

<div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle; margin-right: -15px;">
    <span style="padding-left: 10px;">Customer Master : Manage Request</span>
</div>
<div class="headmain" style="margin-left: 10px; margin-right: 10px; margin-top: 5px; margin-bottom: 5px; vertical-align: middle;">
    <table class="table table-bordered table-condensed" width="100%">
        <tr class="row1">
            <td class="HeaderStyle12" colspan="4">Search Criteria</td>
        </tr>
        <tr>
            <td colspan="4">
                <div ID="infoPanel" Width="100%" style="display:none">
                    <table style="margin-left: 0px;width:100%; padding-top:5px;" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td align="center" valign="top">
                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="tborder">
                                    <tbody>
                                        <tr class="row4">
                                            <td>
                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                    <tr>
                                                        <td width="16" align="left" valign="middle">
                                                            <img src="../images/icon_info.gif" border="0" alt="" />
                                                        </td>
                                                        <td align="left" class="row4">
                                                            <span class="smalltext">
                                                                <span ID="infoMsg"></span>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
                <div ID="errorPanel" Width="100%" style="display:none">
                    <table width="0%" style="margin: 0px; width:100%; padding-top:5px;" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td align="left" valign="top">
                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                    <tbody>
                                        <tr class="errorbox">
                                            <td>
                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                    <tr>
                                                        <td width="16" align="left" valign="middle">
                                                            <img src="../images/icon_error.gif" border="0" alt="" />
                                                        </td>
                                                        <td align="left" class="errorbox">
                                                            <span class="smalltext"><span ID="errorMsg"></span></span>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </td>
        </tr>
        <tr class="row1">
            <td class="collvlstyle">Request Type:-</td>
            <td>
                <select ID="ddlrequesttype" class="swiftselect" style="width:180px" >
                    <option Value="">-Select-</option>
                    <option Value="C">Create Customer</option>
                    <option Value="U">Update Customer</option>
                </select>
            </td>
            <td class="collvlstyle">Account Group:-</td>
            <td>
                <select id="ddlcustomeraccgrp" class="swiftselect" style="width:180px">
                    <option Value="">-Select-</option>
                    <option Value="5AG1">5AG1-Customer Dealer Vehicle</option>
                    <option Value="5AG3">5AG3-Customer Other Than Vehicle</option>
                    <option Value="5AGV">5AGV-Vendor as Customer</option>
                    <option Value="5AGG">5AGG-DG S&D Customer(Govt)</option>
                    <option Value="5AG6">5AG6-Customer Sub Dealer</option>
                    <option Value="5AGW">5AGW-Customer as Vendor</option>
                    <option Value="5AG2">5AG2-Customer Honda group(Dom/Exp)</option>
                    <option Value="5AG5">5AG5-HMSI Export</option>
                </select>
            </td>
        </tr>
        <tr class="row2">
            <td class="collvlstyle">Date From:-</td>
            <td>
                <input id="txtdatefrom" class="swifttext" type="text" placeholder="dd-Mon-yyyy" readonly="readonly" style="width:180px" />
                <img id="calendarIcon" src="~/images/cal.gif" alt="Calendar Icon" style="cursor: pointer; width: 15px; height: 15px;">             
            </td>
            <td class="collvlstyle">Date To:-</td>
            <td>
                <input ID="txtdateto" class="swifttext" type="text" placeholder="dd-Mon-yyyy" readonly="readonly" style="width:180px" />
                <img id="ImgBtnToDate" src="~/images/cal.gif" alt="calendar" style="cursor: pointer; width: 15px; height: 15px;" />                
            </td>
        </tr>
        <tr class="row1">
            <td class="collvlstyle">Customer Code:-</td>
            <td>
                <input type="text" ID="txtcustomercode" class="swifttext" style="width:180px" />
            </td>
            <td class="collvlstyle">Status:-</td>
            <td>
                <select id="ddlstatus" cl="swiftselect"style="width:180px">
                    <option Value="">--Select--</option>
                    <option Value="S">Submited</option>
                    <option Value="R">Rejected</option>
                    <option Value="P">Inprogress</option>
                    <option Value="A">Aprroved</option>
                    <option Value="B">Sent Back</option>
                    <option Value="Y">Success</option>
                    <option Value="N">Not Success</option>
                </select>
            </td>
        </tr>
        <tr class="row2">
            <td class="collvlstyle">Customer Name:-</td>
            <td>
                <input type="text" id="txtName" class="swifttext" style="width:180px" />
            </td>
            <td class="collvlstyle">Request No.:-</td>
            <td>
                <input type="text" id="txtReq" class="swifttext" style="width:180px" />
            </td>
        </tr>
        <tr class="active">
            <td colspan="4" align="center">
                <input type="button" id="btnsubmit" value="Search" class="vendorbtn" />&nbsp; &nbsp;
                <input type="button" id="btncancelfrm" value="Cancel" class="vendorbtn" />
                &nbsp; &nbsp;
                <input type="button" id="btnExport" value="Export" class="vendorbtn" />
            </td>
        </tr>
    </table>
    <div id="RequestDataList">

    </div>
   
</div>
<div style="margin-left: 10px; margin-right: 10px;" class="well well-sm">
    <table border="0" style="width: 100%;">
        <tr>
            <td style="height: 20px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td style="width: 20px; vertical-align: middle; text-align: center;" align="left">
                                <a title="Back" href="../Home/Home">
                                    <img src="../images/icon_back.gif" border="0" alt="" />
                                </a>
                            </td>
                            <td style="vertical-align: middle; font-size: 15px;">
                                <span><a title="Back" href="../Home/Home">Back</a></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>
<div id="ajaxLoader"></div>

