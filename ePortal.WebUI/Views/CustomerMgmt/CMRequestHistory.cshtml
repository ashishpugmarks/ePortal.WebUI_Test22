@using ePortal.ViewModels.APPX.CustomerMgmt
@model CMRequestHistoryDetail
@{
    ViewBag.Title = "Customer Approval Request";
    Layout = null;
   
}
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title>Customer Master Request : Details History</title>
   
  
    <link media="all" href="~/css/index.css" type="text/css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_2"]">
        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
            line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
            font-size: 11px;
            border-collapse: collapse;
            color: #000000;
            font-family: Verdana, Tahoma;
        }

            .tableMainInner tr td {
                border: solid 1px #CCDCE0;
                padding: 0;
            }

                .tableMainInner tr td.heading {
                    text-align: right;
                }

        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
        }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                line-height: 20px;
                font-family: Verdana, Arial, Helvetica;
                font-size: 11px;
                padding: 2px;
            }

            .tableGridView tr th {
                background: url(../images/bg_header.jpg) #cae8ea no-repeat;
            }

        .style1 {
            width: 780px;
            height: 582px;
        }
    </style>
    

</head>
<body style="background-color: White;">

    <div>
        <table cellspacing="0" cellpadding="0" width="100%" border="0">
            <tbody>
                <tr>
                    <td valign="top" align="left" class="style1">
                        <table cellspacing="0" cellpadding="0" width="100%" border="0" id="maintable">
                            <tbody>
                                <tr>
                                    <td bgcolor="#ffffff" style="padding: 10px">
                                        <br />
                                        <b>Request Details</b>
                                        <table class="tableGridView" width="100%" border="0" cellspacing="0" cellpadding="0">
                                            <tr class="row1">
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    Requestor
                                                </td>
                                                <td align="left" valign="middle">
                                                    <label id="lblRequestor">@Model.RequesterDetail</label>
                                                </td>
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    Requested Date
                                                </td>
                                                <td align="left" valign="middle">
                                                    <label id="lblRequestedDate">@Model.RequestDate</label>
                                                </td>
                                            </tr>
                                            <tr class="row2">
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    Recomendation Approval
                                                </td>
                                                <td align="left" valign="middle">
                                                    <label id="lblApprovedBy">@Model.SectionDetail</label>
                                                </td>
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    Approval Authority
                                                </td>
                                                <td align="left" valign="middle">
                                                    <label id="lblPPCApprovalAuthority">@Model.DeptDetail</label>
                                                </td>
                                            </tr>
                                            <tr class="row1">
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    <label id="lblFinance2">Finance Approval Authority2</label>
                                                </td>
                                                <td align="left" valign="middle">
                                                    <label id="lblRecomendationBy">@Model.FinDetail2</label>
                                                </td>
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    Finance Approval Authority
                                                </td>
                                                <td align="left" valign="middle">
                                                    <label id="lblFinanceApprovalAuthority">@Model.FinDetail</label>
                                                </td>
                                            </tr>
                                        </table>
                                        <br />
                                        <b>Approval Status</b>
                                        <table class="tableGridView" width="100%" border="0" cellspacing="0" cellpadding="0">
                                            <tr class="row1">
                                                <td valign="top" class="smalltext" style="text-align: right;width:200px" >
                                                    Recomendation Approval Status
                                                </td>
                                                <td align="left" valign="middle">
                                                    <label id="lblApprovalStatus">@Model.SectionStatus</label>
                                                </td>
                                                <td valign="top" class="smalltext" style="text-align: right;width:200px" >
                                                    Approval Authority
                                                </td>
                                                <td align="left" valign="middle">
                                                    <label id="lblPPCStatus">@Model.DeptStatus</label>
                                                </td>
                                            </tr>
                                            <tr class="row2">
                                                <td valign="top" class="smalltext" style="text-align: right;width:200px" >
                                                    <label id="lblFinance21">Finance Approval Authority2</label>
                                                </td>
                                                <td align="left" valign="middle">
                                                    <label id="lblRecomendationStatus">@Model.FinStatus2</label>
                                                </td>
                                                <td valign="top" class="smalltext" style="text-align: right;width:200px" >
                                                    Finance Status
                                                </td>
                                                <td align="left" valign="middle">
                                                    <label id="lblFinanceStatus">@Model.FinStatus</label>
                                                </td>
                                            </tr>
                                        </table>

                                        <br />
                                        <b>
                                            <label id="Label1">Approval Details</label>
                                            &nbsp;(<label id="lbl_requestNo">@Model.GenRequestNo</label>)
                                        </b>
                                        <br />
                                        <table id="gvMMApprovalDetail" class="tableGridView" style="width: 100%">
                                            <thead>
                                                <tr>
                                                    <th>Approval Type</th>
                                                    <th>User Id</th>
                                                    <th>User Name</th>
                                                    <th>Action</th>
                                                    <th>Action Date</th>
                                                    <th>Remark</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{ int r = 1;}
                                                @foreach (var item in Model.Historymodle)
                                                {
                                                    string clname = "";
                                                    r = r + 1;
                                                    if ((r % 2) == 0)
                                                    {
                                                        clname = " background-color: White;color: #5D838C";
                                                    }
                                                <tr class="grdrow" style="@clname">
                                                    <td>@item.Role</td>
                                                    <td>@item.UserId</td>
                                                    <td>@item.EName</td>
                                                    <td>@item.Action</td>
                                                    <td>@item.ActionDate</td>
                                                    <td>@item.ActionRemarks</td>
                                                </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</body>
</html>
