@model List<ePortal.ViewModels.APPX.CustomerMgmt.CustomerMasterDataMng>

@{
    ViewBag.Title = "Customer Master Data";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var res = ViewBag.res;
}
@section Scripts{

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
         $(document).ready(function () {
         // if ($.fn.DataTable.isDataTable("#existingTable")) {
         //    $("#existingTable").DataTable().clear().destroy();
         //  }        

         $("#existingTable").DataTable({
            "bFilter": false,
            "bLengthChange": false,
            "paging": true,
            "pageLength": 7,
            "ordering": false,
            "autoWidth": false
        });
        //  $('[data-ctrl-id="bt-edit-dt"]').on('click', function () {
        //      confirmMessage();
        // });
        // $('#btnAdd').on("click", function(){
        // confirmMessage();
        // });

        // $('input[type="submit"]').on('click', function(e) {
              
        //        if (!confirm('Are you sure you want to submit this form?')) {
        //            e.preventDefault();
        //        }
        // });


        });
        
        if(@Html.Raw(Json.Serialize(ViewBag.res)) == "1"){
             swal({
                        title: "Customer Master",
                        text: "Data has been successfully saved!",
                        type: "success",
                    });
            ShowMessage("success", "Data has been successfully saved!");
        }
        else if(@Html.Raw(Json.Serialize(ViewBag.res)) != "1" && @Html.Raw(Json.Serialize(ViewBag.res)) != ""){
            swal({
                        title: "Customer Master",
                        text: "@ViewBag.res",
                        type: "error",
                    });
            ShowMessage("error", res);
        }
        else{
            ShowMessage("","");
        }
        function confirmMessage() {
            var confirmation = confirm("Are you sure you want to submit?");
            return confirmation;
        }
        function ShowMessage(messagetype, message) {
            if (messagetype == "error") {

                $("#errorPanel").show();
                $("#infoPanel").hide();
                $("#errorMsg").text(message);
                $("#infoMsg").text("");

            }
            else if (messagetype == "success") {
                $("#errorPanel").hide();
                $("#infoPanel").show();
                $("#infoMsg").text(message);
                $("#errorMsg").text("");
            }
            else {
                $("#errorPanel, #infoPanel").hide();
                $("#errorMsg, #infoMsg").text("");
            }

        }
    </script>
}
<div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
    <span style="padding-left: 10px;">Master Data Management</span>
</div>
<div class="body-content" style="overflow-x:auto!important;">

    <table class="table table-responsive" style="width: 100%; ">
        <tbody>
            <tr>
                <td>
                    <div ID="infoPanel" Width="100%" style="display:none">
                        <table style="margin-left: 0px;width:100%; padding-top:5px;" border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td align="center" valign="top">
                                    <table cellpadding="3" cellspacing="0" border="0" width="100%" class="tborder">
                                        <tbody>
                                            <tr class="row4">
                                                <td>
                                                    <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                        <tr>
                                                            <td width="16" align="left" valign="middle">
                                                                <img src="../images/icon_info.gif" border="0" alt="" />
                                                            </td>
                                                            <td align="left" class="row4">
                                                                <span class="smalltext">
                                                                    <span ID="infoMsg"></span>
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div ID="errorPanel" Width="100%" style="display:none">
                        <table width="0%" style="margin: 0px; width:100%; padding-top:5px;" border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td align="left" valign="top">
                                    <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                        <tbody>
                                            <tr class="errorbox">
                                                <td>
                                                    <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                        <tr>
                                                            <td width="16" align="left" valign="middle">
                                                                <img src="../images/icon_error.gif" border="0" alt="" />
                                                            </td>
                                                            <td align="left" class="errorbox">
                                                                <span class="smalltext"><span ID="errorMsg"></span></span>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>

                </td>
            </tr>
        <tr>
          <td>
                    
                        <table id="existingTable" class="table table-bordered table-responsive text-center" style="width:99%">
                            <caption>
                                <h2 style="font-size: 20px; padding-bottom: 10px;">
                                    Assign mandatory/non-mandatory fields for customer creation
                                </h2>
                            </caption>

                            <thead>
                                <tr style="background-color: #f2f2f2;">
                                    <th>S.No.</th>
                                    <th>Field Name</th>
                                    <th id="5AG1">5AG1</th>
                                    <th id="5AG3">5AG3</th>
                                    <th id="5AGV">5AGV</th>
                                    <th id="5AGG">5AGG</th>
                                    <th id="5AG6">5AG6</th>
                                    <th id="5AGW">5AGW</th>
                                    <th id="5AG2">5AG2</th>
                                    <th id="5AG5">5AG5</th>
                                    <th>Client ID Label</th>
                                    <th>Client ID Textbox</th>
                                    <th>Group Name</th>
                                    <th>Functionality</th>
                                </tr>
                            </thead>

                            <tbody>
                           
                                
                                <tr style="background-color: #f2f2f2;">
                                <form method="post" action="AddMasterDataManagement" enctype="multipart/form-data">
                                    <td>0</td>
                                    <td>
                                    <input id="FIELDNAME" name="FIELDNAME" type="text" class="form-control" disabled />
                                    </td>
                                <td><input id="AG_5AG1" name="AG_5AG1" type="checkbox" /></td>
                                <td><input id="AG_5AG3" name="AG_5AG3" type="checkbox" /></td>
                                <td><input id="AG_5AGV" name="AG_5AGV" type="checkbox" /></td>
                                <td><input id="AG_5AGG" name="AG_5AGG" type="checkbox" /></td>
                                <td><input id="AG_5AG6" name="AG_5AG6" type="checkbox" /></td>
                                <td><input id="AG_5AGW" name="AG_5AGW" type="checkbox" /></td>
                                <td><input id="AG_5AG2" name="AG_5AG2" type="checkbox" /></td>
                                <td><input id="AG_5AG5" name="AG_5AG5" type="checkbox" /></td>
                                    <td>
                                        <input id="ClientIdLabel" name="" type="text" disabled />
                                    </td>
                                    <td>
                                        <input id="ClientIdTextLabel" name="" type="text" disabled />
                                    </td>
                                    <td>
                                    <select id="GROUP_NAME" name="GROUP_NAME" disabled>
                                            <option value="">---Select---</option>
                                        <option Value="GeneralData">General Data</option>
                                        <option Value="BankDetails">Bank Details</option>
                                        <option Value="IndustryDetails">Industry Details</option>
                                        <option Value="CINDetails">CIN Details</option>
                                        <option Value="Sales Area Data">Sales Area Data</option>
                                        <option Value="Company Code Data">Company Code Data</option>
                                        </select>
                                    </td>
                                    <td>
                                    <input type="hidden" name="ID" value="0" />
                                        <button type="submit" id="btnAdd" class="btn btn-primary" >
                                            Add
                                        </button>
                                    </td>
                                </form>
                                </tr>
                                
                               
                                @if (Model != null)
                                {

                                    int i = 0;
                                    foreach (var item in Model)
                                    {
                                        i = i + 1;
                                       
                                        <tr>
                                       <form method="post" action="MasterDataManagement" enctype="multipart/form-data">
                                            <td>@(i)</td>
                                            <td>
                                            <input type="text" name="FIELDNAME" value="@item.FIELDNAME" />
                                            </td>
                                        <td><input name="AG_5AG1" value="1" @(item.AG_5AG1 == "1" ? "checked" : "") type="checkbox" /></td>
                                        <td><input name="AG_5AG3" value="1" @(item.AG_5AG3 == "1" ? "checked" : "") type="checkbox" /></td>
                                        <td><input name="AG_5AGV" value="1" @(item.AG_5AGV == "1" ? "checked" : "") type="checkbox" /></td>
                                        <td><input name="AG_5AGG" value="1" @(item.AG_5AGG == "1" ? "checked" : "") type="checkbox" /></td>
                                        <td><input name="AG_5AG6" value="1" @(item.AG_5AG6 == "1" ? "checked" : "") type="checkbox" /></td>
                                        <td><input name="AG_5AGW" value="1" @(item.AG_5AGW == "1" ? "checked" : "") type="checkbox" /></td>
                                        <td><input name="AG_5AG2" value="1" @(item.AG_5AG2 == "1" ? "checked" : "") type="checkbox" /></td>
                                        <td><input name="AG_5AG5" value="1" @(item.AG_5AG5 == "1" ? "checked" : "") type="checkbox" /></td>
                                            <td>
                                            <input type="text" name="CLIENTIDLABEL" value="@item.CLIENTIDLABEL" />
                                            </td>
                                            <td>
                                            <input type="text" name="CLIENTIDTEXTLABEL" value="@item.CLIENTIDTEXTLABEL" />
                                            </td>
                                            <td>
                                            <input type="text" name="GROUP_NAME" value="@item.GROUP_NAME" />
                                            <input type="hidden" name="ID" value="@item.ID" />
                                            </td>
                                            <td>                                               
                                            <button type="submit" class="btn btn-success" value="Update">Update</button>
                                            </td>
                                        </form>
                                     </tr>
                                        
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="14" class="text-center">No data available.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    
          </td>
        </tr>
        </tbody>
    </table>
</div>




