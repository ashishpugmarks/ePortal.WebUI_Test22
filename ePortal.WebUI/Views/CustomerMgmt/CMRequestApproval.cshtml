@using System.Net;
@model List<ePortal.ViewModels.APPX.CustomerMgmt.CMRequestModel>

@{
    ViewBag.Title = "Customer Approval Request";
    //Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="~/css/index.css" rel="stylesheet" type="text/css" />
    <link href="~/css/CMStyle.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_2"]">
        #tableGridView_info {
            margin: 9px 7px 2px 20px;
            font-weight: bold;
            padding-left: 10px;
        }
       /* .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
        }

            .tableGridView tr th {
                color: #000000;
            }

