@{
    ViewBag.Title = "Customer Master Data";
    Layout = "~/Views/Shared/_Layout.cshtml";    
}
@section Styles{
    <link rel="stylesheet" href="~/app/css/CustomerMgmt/CMApprovalAuthorityMatrix.css" type="text/css" />
     <link href="~/css/index.css" rel="stylesheet" type="text/css" />     
}
@section Scripts{   
    <script type="text/javascript" src="~/app/JS/CustomerMgmt/CMApprovalAuthorityMatrix.js"></script>
       
}

    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle; margin-right: -15px; ">
        <span style="padding-left: 10px;">
            Customer Master - Approval Authority matrix
        </span>
    </div>
   <div class="body-content" style="overflow-x:auto!important;">
      
        <table class="table table-responsive" style="width: 100%;">
            <tbody>
                <tr ID="trMessagePanel" style="border-top: 0px !important; display:none;">
                    <td>
                        <div ID="infoPanel"  Width="100%" style="display:none">
                            <table style="margin-left: 0px;width:100%; padding-top:5px;" border="0" cellspacing="0" cellpadding="0">
                                <tr>
                                    <td align="center" valign="top">
                                        <table cellpadding="3" cellspacing="0" border="0" width="100%" class="tborder">
                                            <tbody>
                                                <tr class="row4">
                                                    <td>
                                                        <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                            <tr>
                                                                <td width="16" align="left" valign="middle">
                                                                    <img src="../images/icon_info.gif" border="0" alt="" />
                                                                </td>
                                                                <td align="left" class="row4">
                                                                    <span class="smalltext">
                                                                        <span ID="infoMsg"></span>
                                                                    </span>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div ID="errorPanel"  Width="100%" style="display:none">
                            <table width="0%" style="margin: 0px; width:100%; padding-top:5px;" border="0" cellspacing="0" cellpadding="0">
                                <tr>
                                    <td align="left" valign="top">
                                        <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                            <tbody>
                                                <tr class="errorbox">
                                                    <td>
                                                        <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                            <tr>
                                                                <td width="16" align="left" valign="middle">
                                                                    <img src="../images/icon_error.gif" border="0" alt="" />
                                                                </td>
                                                                <td align="left" class="errorbox">
                                                                    <span class="smalltext"><span ID="errorMsg"></span></span>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>                       
                        <table class="table table-bordered table-hover table-responsive" width="100%">
                            <tbody>
                                <tr>
                                    <td class="HeaderStyle123" colspan="8">Customer Master Data</td>
                                </tr>
                                <tr>
                                    <td class="smalltext" colspan="8">
                                        <table cellpadding="0" cellspacing="1" border="0" width="100%">
                                            <tr class="row2">

                                            <td colspan="4" style="padding: 0px; margin-left:10px;border:0;">                                               
                                                <input type="radio" id="optFinance" name="ActionType" checked value="2" />
                                                <label for="optFinance">FINANCE</label>
                                                <input type="radio" id="optSwitchApprover" name="ActionType" value="4" />
                                                <label for="optSwitchApprover">Switch Approver</label>                                              
                                            </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr id="typePanel">
                                    <td class="smalltext" colspan="8">
                                    <table id="TblPanelFinance"  style="border:0; width:100%;">
                                        <tr class="row1">

                                            <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                Master Type<span style="color: #ff0000">*</span>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                &nbsp;
                                                @Html.DropDownList("ddlMastertype1",new List<SelectListItem>{
                                                                                                new SelectListItem { Text = "--Select--", Value = "" },
                                                                                                new SelectListItem { Text = "Customer Master", Value = "1" }
                                                                                            },new {
                                                                                                @id = "ddlMastertype1",
                                                                                                @class = "form-select",
                                                                                                title = "Must select one master type",
                                                                                                style = "width:183px"
                                                                                                })
                                            </td>
                                        </tr>
                                        <tr class="row2">
                                            <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                Request Type<span style="color: #ff0000">*</span>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                &nbsp;
                                             @Html.DropDownList("ddlRequestType",new List<SelectListItem>{
                                                                                                new SelectListItem { Text = "--Select--", Value = "" },
                                                                                                new SelectListItem { Text = "Finance", Value = "A" },
                                                                                                new SelectListItem { Text = "Finance2", Value = "B" }
                                                                                            },new {
                                                                                                @id = "ddlRequestType",
                                                                                                @class = "form-select",
                                                                                                title = "Must select one request type",
                                                                                                style = "width:183px"
                                                                                                })

                                            </td>

                                        </tr>
                                        <tr class="row1">
                                            <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                Authorization Authority<span style="color: #ff0000">*</span>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                &nbsp;
                                                @Html.TextBox("TxtEmpCode1","",new{@id="TxtEmpCode1",title = "Enter authorization authority ", style = "width:183px"})
                                               
                                                <label for="TxtEmpCode1" id="LblEmpName1" style="width:200px"></label>
                                            </td>
                                        </tr>
                                        <tr class="row2">
                                            <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                Authorization Active User
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                               
                                                 @Html.CheckBox("chkFINActiveUser",false, new{ @id="chkFINActiveUser"})
                                                 @Html.Hidden("hdRefID","0", new{@id="hdRefID"})
                                                 
                                            </td>
                                        </tr>
                                    </table>

                                    <table id="TblPanelSwitchApprover"  style="border:0; width:100%;" >
                                        <tr class="row1">
                                            <td valign="top" class="smalltext" colspan="4"><span style="font-size:1.2em; font-weight:bold"> Approval for Customer Request </span></td>
                                        </tr>
                                        <tr class="row2">
                                            <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                Customer Request No<span style="color: #ff0000">*</span>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                &nbsp;
                                                @Html.TextBox("txtCustomerRequestno", "", new{@id="txtCustomerRequestno",title = "Enter customer request number", style = "width:183px"})
                                                <img src="~/images/icon_search1.gif" id="btnCheck" />
                                            </td>
                                        </tr>
                                        <tr class="row1">
                                            <td colspan="4">
                                                <div id="CustReqApprDetails"></div>
                                            </td>
                                        </tr>
                                        <tr class="row2">
                                            <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                Approver/Initiator<span style="color: #ff0000">*</span>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                &nbsp;@Html.DropDownList("ddlApprovalRole",new List<SelectListItem>{
                                                                            new SelectListItem { Text = "--Select--", Value = "" },
                                                                            new SelectListItem { Value = "1", Text = "Initiator" },
                                                                            new SelectListItem { Value = "2", Text = "Recommendation Authority" },
                                                                            new SelectListItem { Value = "3", Text = "Approval Authority" },
                                                                            new SelectListItem { Value = "4", Text = "Finance" },
                                                                            new SelectListItem { Value = "5", Text = "Finance2" }
                                                                            },
                                                                            new{@id="ddlApprovalRole", @class="swiftselect",title = "Enter customer request number", style = "width:183px"})
                                            </td>
                                        </tr>
                                        <tr class="row1">
                                            <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                Current Approver<span style="color: #ff0000">*</span>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                &nbsp;
                                                        @Html.TextBox("txtCurrentApprpver", "", new{@id="txtCurrentApprpver", @class="swiftselect",title = "Enter current approver code",  style = "width:183px"})
                                                                   &nbsp;
                                                        @Html.Label("txtCurrentApprpver","",new{@id="lblCurrentApprover",style="height: 22px; padding: 3px;"})
                                                                   
                                            </td>
                                        </tr>
                                        <tr class="row2">
                                            <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                New Approver<span style="color: #ff0000">*</span>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                &nbsp;@Html.TextBox("txtNewApprover", "", new{@id="txtNewApprover",title = "Enter current approver code",maxlength="10", style = "width:183px"})
                                                @Html.Label("txtNewApprover","",new{@id="lblNewApprover",style="height: 22px; padding: 3px;"})
                                            
                                            </td>
                                        </tr>
                                        <tr class="row1">
                                            <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                Remarks<span style="color: #ff0000">*</span>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                &nbsp;@Html.TextBox("txtRemarks", "",new{@id="txtRemarks",title = "Enter current approver code",maxlength="10", style = "width:183px"})
                                               
                                            </td>
                                        </tr>
                                        <tr class="row2">
                                            <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                Attach Document<span style="color: #ff0000">*</span>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                &nbsp;<input type="file" id="fpRefDoc" placeholder="size upto maximum 1 mb" />
                                              
                                                <a href="#" id="btnViewAttachement" target="_blank"></a>
                                            </td>
                                        </tr>
                                    </table>
                                    </td>
                                </tr>

                                <tr id="submitPanel" runat="server">
                                    <td align="left" colspan="8">
                                        <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                            <tr>
                                                <td align="center" style="padding-top: 5px; padding-bottom: 5px;" colspan="2">                                         
                                                <input type="button"  id="btnSubmit" class="btn btn-success btn-sm" value="Submit" />
                                                <input type="button" id="btnCancel" class="btn btn-success btn-sm" value="Cancel" />
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr>
                                    <td align="left" colspan="8">
                                        <div id="DataBindPPCFIN"></div>
                                        <div id="DataBindSIS"></div>
                                    </td>
                                    
                                </tr>
                                 <tr>
                                    <td colspan="8">
                                                <table class="table table-bordered table-hover table-responsive">
                                                    <tbody>
                                                        <tr>
                                                            <td style="height: 24px; width: 23px;" valign="middle" align="left">
                                                                <a title="Back" href="home/home">
                                                                    <img src="../images/icon_back.gif" border="0" alt="" /></a>
                                                            </td>
                                                            <td style="height: 24px;" align="left">
                                                                <span class="smalltext"><a title="Back" href="home/home">Back</a></span>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                  </tr>
                            </tbody>
                        </table>                        
                    </td>
                </tr>
                
            </tbody>
        </table>
      
    </div>

