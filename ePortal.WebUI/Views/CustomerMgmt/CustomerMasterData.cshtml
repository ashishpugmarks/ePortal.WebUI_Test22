@model ePortal.ViewModels.APPX.CustomerMgmt.CMMASTER_DATA;

@{
    ViewBag.Title = "Customer Master Data";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
}
@section Styles{
    <link rel="stylesheet" href="~/app/CSS/CustomerMgmt/CustomerMasterData.css" />
     <link href="~/css/index.css" rel="stylesheet" type="text/css" />
     
}
@section Scripts{   
    <script type="text/javascript" src="~/app/JS/CustomerMgmt/CustomerMasterData.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
//     $('.homeContent').removeClass('homeContent');
// $(document).ready(function () {
//     $('#btnSubmit').on('click', function () {
//         SubmitData();
//     });
//     $('#btnCancel').on('click', function () {
//         ResetData();
//     });
//     $('#ddlMasterType').on('change', function () {
//         getMasterDataList();
//     });   
   
// });

    </script>
    
}

    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">
            Customer Master Data
        </span>
    </div>
   <div class="body-content" style="overflow-x:auto!important;">
      
        <table class="table table-responsive" style="width: 100%; ">
            <tbody>
                <tr>
                    <td>
                        <div ID="infoPanel"  Width="100%" style="display:none">
                            <table style="margin-left: 0px;width:100%; padding-top:5px;" border="0" cellspacing="0" cellpadding="0">
                                <tr>
                                    <td align="center" valign="top">
                                        <table cellpadding="3" cellspacing="0" border="0" width="100%" class="tborder">
                                            <tbody>
                                                <tr class="row4">
                                                    <td>
                                                        <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                            <tr>
                                                                <td width="16" align="left" valign="middle">
                                                                    <img src="../images/icon_info.gif" border="0" alt="" />
                                                                </td>
                                                                <td align="left" class="row4">
                                                                    <span class="smalltext">
                                                                        <span ID="infoMsg"></span>
                                                                    </span>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div ID="errorPanel"  Width="100%" style="display:none">
                            <table width="0%" style="margin: 0px; width:100%; padding-top:5px;" border="0" cellspacing="0" cellpadding="0">
                                <tr>
                                    <td align="left" valign="top">
                                        <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                            <tbody>
                                                <tr class="errorbox">
                                                    <td>
                                                        <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                            <tr>
                                                                <td width="16" align="left" valign="middle">
                                                                    <img src="../images/icon_error.gif" border="0" alt="" />
                                                                </td>
                                                                <td align="left" class="errorbox">
                                                                    <span class="smalltext"><span ID="errorMsg"></span></span>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </td>
                </tr>
                <tr>
                    <td>
                       
                        <table class="table table-bordered table-hover table-responsive" width="100%">
                            <tbody>
                                <tr>
                                    <td class="HeaderStyle123" colspan="8">Customer Master Data</td>
                                </tr>
                                <tr>
                                    <td class="smalltext" colspan="8">
                                        <table cellpadding="0" cellspacing="1" border="0" width="100%">
                                            <tr class="row2">
                                                <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                    Master Type<span style="color: #ff0000">*</span>
                                                </td>
                                                <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                    &nbsp;
                                                    @Html.DropDownList("MasterTypes", new List<SelectListItem>
                                                                                            {
                                                                                                new SelectListItem { Text = "--Select--", Value = "" }, 
                                                                                                new SelectListItem { Text = "Distribution", Value = "Distribution" },
                                                                                                new SelectListItem { Text = "Division", Value = "Division" },
                                                                                                new SelectListItem { Text = "Country", Value = "Country" },
                                                                                                new SelectListItem { Text = "Region", Value = "Region" },
                                                                                                new SelectListItem { Text = "Transportation Code", Value = "Transportation Code" },
                                                                                                new SelectListItem { Text = "Industry", Value = "Industry" },
                                                                                                new SelectListItem { Text = "City Code", Value = "City Code" },
                                                                                                new SelectListItem { Text = "Customer Class", Value = "Customer Class" },
                                                                                                new SelectListItem { Text = "Exchange Rate Type", Value = "Exchange Rate Type" },
                                                                                                new SelectListItem { Text = "Sales District", Value = "Sales District" },
                                                                                                new SelectListItem { Text = "Sales Office", Value = "Sales Office" },
                                                                                                new SelectListItem { Text = "Sales Group", Value = "Sales Group" },
                                                                                                new SelectListItem { Text = "Customer Group", Value = "Customer Group" },
                                                                                                new SelectListItem { Text = "Cust. Price", Value = "Cust. Price" },
                                                                                                new SelectListItem { Text = "Delivery Priority", Value = "Delivery Priority" },
                                                                                                new SelectListItem { Text = "Shipping Conditions", Value = "Shipping Conditions" },
                                                                                                new SelectListItem { Text = "Incoterms", Value = "Incoterms" },
                                                                                                new SelectListItem { Text = "Terms Of Payment", Value = "Terms Of Payment" },
                                                                                                new SelectListItem { Text = "Credit Control Area", Value = "Credit Control Area" },
                                                                                                new SelectListItem { Text = "Acct Assignment Group", Value = "Acct Assignment Group" }
                                                                                            }, 
                                                                                         new {
                                                                                                @id = "ddlMasterType",
                                                                                                @class = "form-select",
                                                                                                title = "Must select one master type entry",
                                                                                                style = "width:183px",
                                                                                                // onchange = "this.form.submit()"
                                                                                            }
                                                                                        )                                                    
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr id="typePanel">
                                    <td class="smalltext" colspan="8">
                                        <table class="table table-bordered table-hover table-responsive" width="99%">
                                            <tr class="row1">
                                                <td colspan="4" style="padding: 5px;">
                                                    <h4>&nbsp;Data Type Details</h4>
                                                </td>
                                            </tr>
                                            <tr class="row2">
                                                <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                    ID/CODE<span style="color: #ff0000">*</span>
                                                </td>
                                                <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                    &nbsp;
                                                    @Html.TextBox("Code",Model.Code, new{ @id="txtCode", @class="swifttext",style="width:300px"})
                                                </td>
                                            </tr>
                                            <tr class="row2">
                                                <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                    Description<span style="color: #ff0000">*</span>
                                                </td>
                                                <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                    &nbsp;
                                                 @Html.TextBox("CodeDesc",Model.CodeDesc, new{ @id="txtDesc", @class="swifttext",style="width:300px", maxlength="100"})
                                                </td>
                                            </tr>
                                            <tr class="row2">
                                                <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                    Parent Group
                                                </td>
                                                <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                    &nbsp;
                                                    @Html.TextBox("PgroupName",Model.PgroupName, new{ @id="txtPGroup", @class="swifttext",style="width:300px"})
                                                                      <span style="color:#808080; margin-left:2px;">Default value is 0</span>
                                                </td>
                                            </tr>
                                            <tr class="row2">
                                                <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                                    Status<span style="color: #ff0000">*</span>
                                                </td>
                                                <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                    &nbsp;
                                                    @Html.CheckBox("IsActive",Model.IsActive=="1"?true:false, new{ @id="chkStatus"})IsActive
                                                </td>
                                            </tr>
                                            <tr class="row2" style="display: none;">
                                                <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Hidden Field</td>
                                                <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                                  
                                                   @Html.Hidden("txtCmd", Model.CmdId)
                                                </td>
                                            </tr>

                                        </table>
                                    </td>
                                </tr>

                                <tr id="submitPanel" runat="server">
                                    <td align="left" colspan="8">
                                        <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                            <tr>
                                                <td align="center" style="padding-top: 5px; padding-bottom: 5px;" colspan="2">
                                                 
                                                <input type="button"  id="btnSubmit" class="btn btn-success btn-sm" value="Submit" />
                                                <input type="button" id="btnCancel" class="btn btn-success btn-sm" value="Cancel" />
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr>
                                    <td align="left" colspan="8">
                                        <div id="MasterDataList"></div>
                                    </td>
                                    
                                </tr>
                            </tbody>
                        </table>
                        
                    </td>
                </tr>
                
            </tbody>
        </table>
       
        
        
    </div>
