    ViewBag.Title = "View Cutomer Detail";
}
<html>
<head>
    <link href="~/css/index.css" rel="stylesheet" type="text/css" />
    <link href="~/css/VendorMaster.css" rel="stylesheet" type="text/css" />
    <script src="~/bundle/jquery.min.js" type="text/javascript"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_1"]"> 
        $(document).ready(function () {
            $('a').on('click', function (event) {
                event.preventDefault();
                /* bindLink($(this), $(this).text()); */
                $(this).prop("style", "color:green;font-weigth:bold;");
                let urlpath = '../../Uploads/CustomerMaster/' + $(this).text();
                openDialog(urlpath, 980, 680);
            });

        });
        function openDialog(url, w, h) { window.open(url, "_blank", `width=${w},height=${h},resizable=yes,scrollbars=yes`); }
      
    </script>
