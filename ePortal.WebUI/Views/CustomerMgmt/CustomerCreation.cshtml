@section Scripts {
    <script type="text/javascript" src="~/js/CalendarPopup.js"></script>
    <script type="text/javascript" src="~/app/JS/CustomerMgmt/CustomerCreation.js"></script>
}
<div style="font-size: 13px;">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Customer Creation/Extend/Update Request</span>
        <span style="float:right; padding-right:5px; color:#5112ef"> <a href="../../Uploads/CustomerMaster/HMSI Customer Master.pdf" target="_blank">User Manual</a></span>
        <span style="clear:both"></span>
    </div>
    <table class="table table-responsive">
        <tr>
            <td>
                <table width="100%">
                    <tbody>
                        <tr>
                            <td>
                                <div ID="infoPanel" Width="100%" style="display:none">
                                    <table style="margin-left: 0px;width:100%; padding-top:5px;" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td align="center" valign="top">
                                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="tborder">
                                                    <tbody>
                                                        <tr class="row4">
                                                            <td>
                                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                                    <tr>
                                                                        <td width="16" align="left" valign="middle">
                                                                            <img src="../images/icon_info.gif" border="0" alt="" />
                                                                        </td>
                                                                        <td align="left" class="row4">
                                                                            <span class="smalltext">
                                                                                <span ID="infoMsg"></span>
                                                                            </span>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div ID="errorPanel" Width="100%" style="display:none">
                                    <table width="0%" style="margin: 0px; width:100%; padding-top:5px;" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td align="left" valign="top">
                                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                                    <tbody>
                                                        <tr class="errorbox">
                                                            <td>
                                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                                    <tr>
                                                                        <td width="16" align="left" valign="middle">
                                                                            <img src="../images/icon_error.gif" border="0" alt="" />
                                                                        </td>
                                                                        <td align="left" class="errorbox">
                                                                            <span class="smalltext"><span ID="errorMsg"></span></span>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <table class="table table-bordered table-hover table-responsive" width="99%">
                                    <tr class="HeaderStyle123">
                                        <td class="auto-style3">
                                            <div id="rdlRequest">
                                                <input type="radio" id="rdCreateRequst" name="ApplicationRequestType" value="C" checked /><label for="rdCreateRequst">Create Request&nbsp;&nbsp;</label>
                                                <input type="radio" id="rdUpdateRequst" name="ApplicationRequestType" value="U"><label for="rdUpdateRequst">Extend/Update Request</label>
                                            </div>
                                        </td>
                                        <td class="auto-style3">
                                            <label id="lblCreationCustID" style="display:none">
                                                Customer ID&nbsp;&nbsp;:&nbsp;&nbsp;
                                            </label>
                                            <input type="text" id="txtSearchCustomerID" style="width:100px;display:none;" />
                                            &nbsp;&nbsp;
                                            <input type="button" id="btnSearch" class="btn-primary" value="Search" style="display:none" />
                                            <input type="hidden" id="hidHeaderID" value="" />
                                            <input type="hidden" id="hidDetaildID" value="" />
                                            <input type="hidden" id="hidDetaildID1" value="" />
                                            <input type="hidden" id="hidGenDetailID" value="@ViewBag.hidGenDetailID" />                                            

                                        </td>

                                        <td class="auto-style3">
                                            <span class="rdlReq"> Request Type&nbsp;:&nbsp;</span>

                                            <input type="radio" id="rdlRequestTypeDM" name="RequestType" Value="DM" checked /><label>Domestic</label>
                                            <input type="radio" id="rdlRequestTypeEX" name="RequestType" Value="EX"><label>Export</label>
                                            <span class="search" style="align-content:space-around; float:right">
                                                <a href="../CustomerManageRequest">
                                                    Search <img alt="Search CM" src="../Images/search.png" />
                                                </a>
                                            </span>
                                            <span style="clear:both"></span>
                                        </td>
                                    </tr>

                                </table>
                            </td>
                        </tr>

                        <tr>
                            <td style="font-size: 11px; color: #333333;" colspan="8">
                                <table class="table table-bordered table-responsive" width="99%">

                                    <tr class="row2">
                                        <td class="HeaderStyle123" colspan="12" style="padding: 5px;">
                                            <span>&nbsp;Type of customer Request</span>
                                        </td>
                                    </tr>
                                    <tr id="dom_options1" style="display: table-row;">
                                        <td colspan="3" style="border: none;">
                                            <div class="radioButton">
                                                <input type="checkbox" id="chk5AG1" name="CustomerAccountGroup" value="chk5AG1" />
                                                <label for="chk5AG1">5AG1 → Customer Dealer Vehicle</label>
                                            </div>
                                        </td>

                                        <td colspan="3" style="border: none;">
                                            <div class="radioButton">
                                                <input type="checkbox" id="chk5AG3" name="CustomerAccountGroup" value="chk5AG3" />
                                                <label for="chk5AG3">5AG3 → Customer Other Than Vehicle</label>
                                            </div>
                                        </td>

                                        <td colspan="3" style="border: none;">
                                            <div class="radioButton">
                                                <input type="checkbox" id="chk5AGV" name="CustomerAccountGroup" value="chk5AGV" />
                                                <label for="chk5AGV">5AGV → Vendor as Customer</label>
                                            </div>
                                        </td>
                                    </tr>

                                    <tr id="dom_options2" style="display: table-row;">
                                        <td colspan="3" style="border: none;">
                                            <div class="radioButton">
                                                <input type="checkbox" id="chk5AGG" name="CustomerAccountGroup" value="chk5AGG" />
                                                <label for="chk5AGG">5AGG → DG S&amp;D Customer (Govt)</label>
                                            </div>
                                        </td>

                                        <td colspan="3" style="border: none;">
                                            <div class="radioButton">
                                                <input type="checkbox" id="chk5AG6" name="CustomerAccountGroup" value="chk5AG6" />
                                                <label for="chk5AG6">5AG6 → Customer Sub Dealer</label>
                                            </div>
                                        </td>

                                        <td colspan="3" style="border: none;">
                                            <div class="radioButton">
                                                <input type="checkbox" id="chk5AGW" name="CustomerAccountGroup" value="chk5AGW" />
                                                <label for="chk5AGW">5AGW → Customer as Vendor</label>
                                            </div>
                                        </td>
                                    </tr>

                                    <tr id="exp_options" style="display: none;">
                                        <td colspan="3" style="border: none;">
                                            <div class="radioButton">
                                                <input type="checkbox" id="chk5AG2" name="CustomerAccountGroup" value="chk5AG2" />
                                                <label for="chk5AG2">5AG2 → Customer Honda group (Dom/Exp)</label>
                                            </div>
                                        </td>

                                        <td colspan="3" style="border: none;">
                                            <div class="radioButton">
                                                <input type="checkbox" id="chk5AG5" name="CustomerAccountGroup" value="chk5AG5" />
                                                <label for="chk5AG5">5AG5 → HMSI Export</label>
                                            </div>
                                        </td>
                                    </tr>

                                    <tr class="row2">
                                        <td colspan="1" class="smalltext" style="text-align: right; padding: 3px;" valign="top" id="lblDistribution">
                                            Distribution<span style="color: #ff0000">*</span>
                                        </td>
                                        <td colspan="2" align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            <select id="ddlDistribution">
                                                <option value="">-- Select --</option>
                                                <option value="01">01 Distribution Channel 01</option>
                                                <option value="03">03 Domestic STO</option>
                                                <option value="04">04 Exports STO</option>
                                                <option value="DM">DM Domestic Sales</option>
                                                <option value="EX">EX Export Sales</option>
                                            </select>

                                        </td>

                                        <td class="smalltext" style="text-align: right; padding: 3px;" valign="top" id="lblSalesOrganization" colspan="2">
                                            Sales Organization
                                        </td>
                                        <td colspan="2" align="left" style="height: 22px; padding: 3px;">
                                            &nbsp;
                                            <input type="text" id="txtSalesOrganization" class="swifttext" Width="180px" disabled value="HMSI" />
                                        </td>
                                        <td class="smalltext" style="text-align: right; padding: 3px;" valign="top" id="lblCompanyCode" colspan="2">
                                            Company Code
                                        </td>
                                        <td colspan="1" align="left" style="height: 22px; padding: 3px;">
                                            &nbsp;<input type="text" id="txtCompanyCode" class="swifttext" Width="180px" disabled value="50AG" />
                                        </td>
                                    </tr>
                                    <tr class="row1">
                                        <td class="smalltext" style="text-align: right; padding: 3px;" valign="top"><b>Division</b></td>
                                        <td class="smalltext" style="text-align: left; padding: 3px;" valign="top" colspan="11">

                                            @foreach (var item in Division)
                                            {
                                                <div style="display: inline-block; width: 16.5%;">
                                                    <input type="checkbox"
                                                           id="chk_@item.CODE"
                                                           name="Divisions" value="@item.CODE" />
                                                    <label for="chk_@item.CODE">@item.CODE_DESC</label>
                                                </div>
                                            }

                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td class="smalltext">
                                <div>

                                    <button type="button" id="btnTab1" name="tab" value="GeneralData" class="tabs">General Data</button>
                                    <button type="button" id="btnTab2" name="tab" value="BankDetails" class="tabs">Bank Details</button>
                                    <button type="button" id="btnTab3" name="tab" value="IndustryDetails" class="tabs">Industry Details</button>
                                    <button type="button" id="btnTab4" name="tab" value="SalesAreaData" class="tabs">Sales Area Data</button>
                                    <button type="button" id="btnTab5" name="tab" value="CINDetails" class="tabs">CIN Details</button>
                                    <button type="button" id="btnTab6" name="tab" value="CompanyCodeData" class="tabs">Company Code Data</button>
                                </div>

                                <div id="tab_body_1" runat="server" class="tab-body" visible="true">

                                    <table class="table table-bordered table-hover table-responsive" width="99%">
                                        <tr class="row1">
                                            <td class="HeaderStyle123" colspan="12">Create Customer - General Data</td>
                                        </tr>

                                        <!-- Dealer/Customer Code -->
                                        <tr class="row2">
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblcode" for="txtDealerCode">Dealer/Customer Code</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtDealerCode" name="txtDealerCode" class="swifttext" maxlength="10" value="@Model.CUSTOMER_CODE" />
                                            </td>

                                            <!-- Title (Company) -->
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblTitle" for="ddlTitle">Title(Company)</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <select id="ddlTitle" name="ddlTitle" class="swifttext" style="width: 180px">
                                                    <option value="">--Select--</option>
                                                    <option value="0001">Ms.</option>
                                                    <option value="0002">Mr.</option>
                                                    <option value="0003">Company</option>
                                                    <option value="0004">Mr. and Mrs.</option>
                                                </select>
                                            </td>
                                        </tr>

                                        <!-- Name 1 and Name 2 -->
                                        <tr class="row1">
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblName1" for="txtName1">Name 1</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtName1" name="txtName1" class="swifttext" maxlength="40" value="@Model.NAME1" />
                                            </td>
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblName2" for="txtName2">Name 2</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtName2" name="txtName2" class="swifttext" maxlength="40" value="@Model.NAME2" />
                                            </td>
                                        </tr>

                                        <!-- Name 3 (Legal Name) and Name 4 -->
                                        <tr class="row2">
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblName3" for="txtName3">Name 3(Legal Name)</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtName3" name="txtName3" class="swifttext" maxlength="40" value="@Model.NAME3" />
                                            </td>
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblName4" for="txtName4">Name 4</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtName4" name="txtName4" class="swifttext" maxlength="40" value="@Model.NAME4" />
                                            </td>
                                        </tr>

                                        <!-- Search Terms and Street/House -->
                                        <tr class="row1">
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblSearchTerms" for="txtSearchTerms">Search Terms</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtSearchTerms" name="txtSearchTerms" class="swifttext" maxlength="25" value="@Model.SEARCHTERM" />
                                            </td>
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblStreetHouse" for="txtStreetHouse">Street/House</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtStreetHouse" name="txtStreetHouse" class="swifttext" maxlength="40" value="@Model.STREETHOUSENUMBER" />
                                            </td>
                                        </tr>

                                        <!-- Street2 and Street3 -->
                                        <tr class="row2">
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblStreet2" for="txtStreet2">Street2</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtStreet2" name="txtStreet2" class="swifttext" maxlength="40" value="@Model.STREET2" />
                                            </td>
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblStreet3" for="txtStreet3">Street3</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtStreet3" name="txtStreet3" class="swifttext" maxlength="40" value="@Model.STREET3" />
                                            </td>
                                        </tr>

                                        <!-- Street4 and Street5 -->
                                        <tr class="row1">
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblStreet4" for="txtStreet4">Street4</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtStreet4" name="txtStreet4" class="swifttext" maxlength="40" value="@Model.STREET4" />
                                            </td>
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblStreet5" for="txtStreet5">Street5</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtStreet5" name="txtStreet5" class="swifttext" maxlength="40" value="@Model.STREET5" />
                                            </td>
                                        </tr>

                                        <!-- Postal Code and City -->
                                        <tr class="row2">
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblPostalCode" for="txtPostalCode">Postal Code</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtPostalCode" name="txtPostalCode" maxlength="10" class="swifttext" value="@Model.POSTALCODE" />
                                            </td>
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblCity" for="txtCity">City</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtCity" name="txtCity" class="swifttext" maxlength="40" value="@Model.CITYCODE" />
                                            </td>
                                        </tr>

                                        <!-- Country and Region -->
                                        <tr class="row1">
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblCountry" for="ddlCountry">Country</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">

                                                <select id="ddlCountry" name="ddlCountry" class="swifttext" style="width: 180px">
                                                    @foreach (var item in ViewBag.ddlCountry)
                                                    {
                                                        <option value="@item.CODE">@item.CODE_DESC</option>
                                                    }

                                                </select>
                                            </td>
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblRegion" for="ddlRegion">Region</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <select id="ddlRegion" name="ddlRegion" class="swifttext" style="width: 180px">

                                                    @foreach (var item in ViewBag.ddlRegion)
                                                    {
                                                        <option value="@item.CODE">@item.CODE_DESC</option>
                                                    }
                                                </select>
                                            </td>
                                        </tr>

                                        <!-- Time Zone and Transportation Code -->
                                        <tr class="row2">
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblTimeZone" for="ddlTimeZone">Time Zone</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <select id="ddlTimeZone" name="ddlTimeZone" class="swifttext" style="width: 180px">
                                                    @foreach (var item in ViewBag.ddlTimeZone)
                                                    {
                                                        <option value="@item.CODE">@item.CODE_DESC</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblTransportationCode" for="ddlTransportationCode">Transportation Code</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <select id="ddlTransportationCode" name="ddlTransportationCode" class="swifttext" style="width: 180px">
                                                    @foreach (var item in ViewBag.Trans_dm)
                                                    {
                                                        <option value="@item.CODE">@item.CODE_DESC</option>
                                                    }
                                                </select>
                                            </td>
                                        </tr>

                                        <!-- Mobile Phone and Fax -->
                                        <tr class="row1">
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblMobilePhone" for="txtMobilePhone">Mobile Phone</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtMobilePhone" name="txtMobilePhone" maxlength="16" class="swifttext" value="@Model.MOBILEPHONE" />
                                            </td>
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblFax" for="txtFax">Fax</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="text" id="txtFax" name="txtFax" class="swifttext" value="@Model.FAX" />
                                            </td>
                                        </tr>

                                        <!-- Email and Industry -->
                                        <tr class="row2">
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblEmail" for="txtEmail">Email</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <input type="email" id="txtEmail" name="txtEmail" class="swifttext" value="@Model.EMAIL" />
                                            </td>
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblIndustry" for="ddlIndustry">Industry</label>
                                            </td>
                                            <td align="left" style="height: 22px; padding: 3px;">
                                                <select id="ddlIndustry" name="ddlIndustry" class="swifttext" style="width: 180px">
                                                    @foreach (var item in ViewBag.ddlIndustry)
                                                    {
                                                        <option value="@item.CODE">@item.CODE_DESC</option>
                                                    }
                                                </select>
                                            </td>
                                        </tr>

                                        <!-- GST No. and City Code -->
                                        <tr class="row1">
                                            <td class="smalltext" style="text-align: right; padding: 3px;">
                                                <label id="lblTaxNumberGst" for="txtTaxNumberGst">GST No.</label>
