</style>


<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
            $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
       if ($.fn.DataTable.isDataTable("#tbRequestReport")) {
            $("#tbRequestReport").DataTable().clear().destroy();
          }
          // $('#TainingTable tbody').empty();

            $("#tbRequestReport").DataTable({
            "bFilter": false,
            "bLengthChange": false,
            "paging": true,
            "pageLength": 10,
            "ordering": false,
            "autoWidth": false
        });
       
      });
</script>



<table class="table table-bordered table-hover table-responsive" id="tbRequestReport" style="width:100%;border-collapse:collapse;border:1px">
    <thead>
        <tr class="grdHeader cmgrdhead">
            <th>
                @Html.DisplayName("Srl No")
            </th>
            <th>
                @Html.DisplayName("Reference No")
            </th>
            <th>
                @Html.DisplayName("Customer Request No")
            </th>
            <th>
                @Html.DisplayName("Previous Approver")
            </th>
            <th>
                @Html.DisplayName("New Approver")
            </th>
             <th>
                @Html.DisplayName("Approver Role")
            </th>
            <th>
                @Html.DisplayName("Created By")
            </th>
            <th>
                @Html.DisplayName("Created Date")
            </th>
            <th>
                @Html.DisplayName("Remarks")
            </th>
            <th> @Html.DisplayName("Attached Doc")</th>
        </tr>
    </thead>
    <tbody>
        @{
            int rowNo = 0;
        }
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                string clname = "";
                int r = rowNo + 1;
                if (r % 2 == 0)
                {
                    clname = " background-color: White;color: #5D838C";
                }
                <tr class="grdrow cmgrdrow" style="@clname">
                    <td class="text-left" style="width:10%;">
                        @(rowNo += 1)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.REF_ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CM_REQUEST_NO)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PRE_APPROVER)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NEW_APPROVER)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.APPROVER_ROLE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CREATED_BY)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CREATED_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.REMARKS)
                    </td>

                    <td class="text-center">
                        <a href="@("../../Uploads/CustomerMaster/" +item.ATTACHED_DOC))" target="_blank" >
                        <input type="image"
                                   src="~/images/viewer.png"
                               alt="view" />
                        </a>

                        
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center">
                    No data available.
                </td>
            </tr>
        }
    </tbody>

</table>

@* </body>
</html> *@
