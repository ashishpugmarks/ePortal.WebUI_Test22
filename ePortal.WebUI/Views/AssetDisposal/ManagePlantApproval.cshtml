@model IEnumerable<ePortal.ViewModels.AssetDisposalViewModel>

@{
    ViewBag.Title = "ManagePlantApproval";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
    </style>
}

    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Manage Plant PPC Approval</div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Asset Disposal Approval List</strong>
                            <strong class="pull-right">
                                <button class="btn btn-default btn-xs" id="btnGetApprovalHistory">History</button>
                            </strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <table class="table table-bordered table-hover table-responsive" id="tbManagePlant">
                            <thead>
                                <tr>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.DISPOSALHEADERID)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.ASSETTYPE)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.EMP_NAME)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.DATEADDED)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.AssetCount)
                                    </th>
                                    @*<th class="text-center">
                                            @Html.DisplayNameFor(model => model.ACTIVE)
                                        </th>*@
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.PROCESSSTATUS)
                                    </th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rowNo = 0; }
                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="text-center" style="width:3%;">
                                                @(rowNo += 1)
                                                @Html.HiddenFor(modelItem => item.DISPOSALHEADERID)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.ASSETTYPE)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.EMP_NAME)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.DATEADDED)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.AssetCount)
                                            </td>
                                            @*<td class="text-center">
                                                    @if (item.ACTIVE == true)
                                                    {
                                                        <button class="btn btn-success btn-xs" style="cursor: text !important">Active</button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-danger btn-xs" style="cursor: text !important">Deactive</button>
                                                    }
                                                </td>*@
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.PROCESSSTATUS)
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-default btn-xs glyphicon glyphicon-print" title="Click to print asset detail" data-id="@item.DISPOSALHEADERID" data-ctrl="print-request"></button>
                                                <button class="btn btn-warning btn-xs glyphicon glyphicon-edit" title="Click to edit" data-id="@item.DISPOSALHEADERID" data-ctrl="edit-request"></button>
                                                <button class="btn btn-info btn-xs glyphicon glyphicon-tasks" title="Click to detail" data-id="@item.DISPOSALHEADERID" data-ctrl="detail-request"></button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <form id="_form" action="@Url.Action("PlanApproval","AssetDisposal")" method="post">
        <input type="hidden" id="hfHeaderId" name="id" value="0" />
    </form>
    <div id="myCreateModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header" style="padding:10px!important;">
                    <div class="pull-left">
                        <h5 class="modal-title"><span id="sp_type"></span></h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body" style="padding:10px!important;">
                    <div id="myCreateModelContent"></div>
                </div>
            </div>
        </div>
    </div>
@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('.homeContent').removeClass('homeContent');
            $("#tbManagePlant").dataTable({
                "bFilter": false,
                "bLengthChange": false
            });
        });
        function EditRequest(current) {
            var _disposalHeaderId = $(current).attr('data-id');
            if (_disposalHeaderId != undefined) {
                $('#hfHeaderId').val(_disposalHeaderId);
                $('#_form').submit();
            }
            //window.location.href = "/AssetDisposal/PlanMgfApproval/" + disposalHeaderId;
        }

        function DetailRequest(current) {
            window.location.href = "/AssetDisposal/AssetRequestDetail/" + $(current).attr('data-id');
        }

        function GetApprovalHistory(current) {
            $.ajax({
                type: "GET",
                //beforeSend: function () {
                //    $("#ajaxLoader").addClass('loader');
                //},
                url: "/AssetDisposal/GetRequestHistory",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#sp_type').html("Request Approval History");
                        $('#myCreateModelContent').html(data);
                        $('#myCreateModel').modal({ backdrop: "static" });
                    }
                },
                //complete: function () {
                //    $("#ajaxLoader").removeClass('loader');
                //},
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function GetPrint(current) {
            var data = {
                DISPOSALHEADERID: $(current).attr('data-id')
            }
            $.ajax({
                type: "POST",
                url: "/AssetDisposal/PrintRequest",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data != "") {
                        Print(data);
                    }
                    else {
                        sweetAlert("", "Record not found", "warning");
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function Print(html) {
            var newWin = window.open();
            newWin.document.write(html);
            newWin.document.close();
            newWin.print();
            newWin.close();
        }

    </script>

    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $(document).on('click', '[data-ctrl="print-request"]', function () {
                GetPrint($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="edit-request"]', function () {
                EditRequest($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="detail-request"]', function () {
                DetailRequest($(this)[0]);
            });
            $('#btnGetApprovalHistory').on('click', function () {
                GetApprovalHistory($(this)[0]);
            });
        });
    </script>
}