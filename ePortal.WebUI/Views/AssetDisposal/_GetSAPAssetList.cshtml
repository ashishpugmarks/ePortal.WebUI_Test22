@model IEnumerable<ePortal.ViewModels.AssetDetailViewModel>

<table class="table table-bordered table-hover table-responsive" id="tbSapAssetDetail">
    <thead>
        <tr style="background-color: lightgray;">
            <th style="width:3%;">&nbsp;</th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.ASSETCODE)
            </th>
            @*Change by aumento as on 02082023 for SR51823============================*@
            <th class="text-center">
                @Html.DisplayNameFor(model => model.ASSETCLASSNAME)
            </th>
            @*========================================================================*@
            <th class="text-center">
                @Html.DisplayNameFor(model => model.ASSETDESCRIPTION)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.ASSETDETAIL)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.VENDORNAME)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.VENDORCODE)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.INVOICENO)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.INVOICEDATE)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.SERIALNUMBER)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.PONUMBER)
            </th>
            @*Change by aumento as on 02082023 for SR51823============================*@
            <th class="text-center">
                @Html.DisplayNameFor(model => model.COSTCENTER)
            </th>
            @*========================================================================*@
            <th class="text-center">
                @Html.DisplayNameFor(model => model.PLANTID)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.CAPTALIZED_DATE)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.ORIGINALCOST)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.DEPRECIATIONCOST)
            </th>
            <th class="text-center" @*style="width:8%;"*@>
                @Html.DisplayNameFor(model => model.WDV)
            </th>
            @*<th class="text-center">
                @Html.DisplayNameFor(model => model.SALESPRICE)
            </th>*@
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr style="font-size: small;" class="tr_@item.ASSETCODE">
                <td><input type="checkbox" id="@item.ASSETCODE" class="chk" style="width: 17px;height: 17px; margin:0px!important;" /></td>
                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.ASSETCODE)
                </td>
                @*Change by aumento as on 02082023 for SR51823============================*@
                <td class="text-left">
                    @Html.DisplayFor(modelItem => item.ASSETCLASSNAME)
                </td>
                @*========================================================================*@
                <td class="text-left">
                    @Html.DisplayFor(modelItem => item.ASSETDESCRIPTION)
                </td>
                <td class="text-left">
                    @Html.DisplayFor(modelItem => item.ASSETDETAIL)
                </td>
                <td class="text-left">
                    @Html.DisplayFor(modelItem => item.VENDORNAME)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.VENDORCODE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INVOICENO)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INVOICEDATE)
                </td>
                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.SERIALNUMBER)
                </td>
                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.PONUMBER)
                </td>
                @*Change by aumento as on 02082023 for SR51823============================*@
                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.COSTCENTER)
                </td>
                @*========================================================================*@
                <td class="text-center">
                    @Html.HiddenFor(modelItem => item.PLANTID, new { @id = "hfPlantId" })
                    @Html.HiddenFor(modelItem => item.PROFITCENTER, new { @id="hfPC" })
                    @Html.DisplayFor(modelItem => item.PLANTNAME)
                </td>
                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.CAPTALIZED_DATE)
                </td>
                <td class="text-right">
                    @Html.DisplayFor(modelItem => item.ORIGINALCOST)
                </td>
                <td class="text-right">
                    @Html.DisplayFor(modelItem => item.DEPRECIATIONCOST)
                </td>
                <td class="text-right">
                    @Html.DisplayFor(modelItem => item.WDV)
                </td>
                @*<td class="text-center">
                    @Html.TextBoxFor(modelItem => item.SALESPRICE, new { @id = "txtSalesPrice_" + item.ASSETCODE, @type = "number", placeholder = "Sales Price", @style = "height: 20px;width: 90px;margin-bottom: 0px;padding: 3px;text-align: right;" })
                </td>*@
            </tr>
        }
    </tbody>
</table>
@* CSP 3.0 Compliant Changes *@
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
    $(document).ready(function () {
        $(document).on('click', '.chk', function () {
            ChkClick($(this)[0]);
        });
    });
</script>

