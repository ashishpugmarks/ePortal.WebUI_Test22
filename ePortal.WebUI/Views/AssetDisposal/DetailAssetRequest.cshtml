        window.onpaint = preloadFunc();
        function preloadFunc() {
            $("#ajaxLoader2").addClass('loader');
        }

        $(document).ready(function () {
            $("#ajaxLoader2").removeClass('loader');

            $("#tbDetailAsset").dataTable({
                "bFilter": false,
                "bLengthChange": false,
                "paging": false,
                "bInfo": false,
                "scrollY": "220px",
                "scrollX": true,
                "scrollCollapse": true,
            });

            $("#tbApprovalHis").dataTable({
                "bFilter": false,
                "bLengthChange": false,
                "paging": false,
                "bInfo": false
            });

            //$('.dpLicenseDate').datepicker({
            //    format: "dd-M-yyyy",
            //    todayHighlight: true,
            //    autoclose: true
            //});
        });

        function CancelClick() {
            window.location.href = "/Home/Home";
        }

        $(function () {
            $("#btnSubmit").click(function () {
                $("input[name='GridHtml']").val($("#Grid").html());
            });
        });
    </script>
