@model IEnumerable<ePortal.ViewModels.AssetDisposalViewModel>

@{
    ViewBag.Title = "ManageRequestCancellation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
   
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .validationError {
            border: 1px solid #a94442;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
    </style>
}

    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                Manage Cancellation / Update
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">

                        <h2 class="panel-title">
                            <strong>Asset Request List</strong>
                            @*------------------START-[Code Added by Aumento on 22-Dec-2023]------------------------------*@
                            <strong class="pull-right">
                                <input type="button" name="excel" class="excel action-button " value="Export to Excel" id="btnExcel" style="background: gray;width: auto;" />
                            </strong>
                            @*------------------END-[Code Added by Aumento on 22-Dec-2023]------------------------------*@
                        </h2>


                    </div>

                    <div class="panel-body">
                        <div class="table-responsive">@*--[Code Added by Aumento on 01-Feb-2024]--------*@
                            <table class="table table-bordered table-hover table-responsive" id="tbManageCancellation">
                                <thead>
                                    <tr>
                                        <th class="text-center">
                                            @Html.DisplayNameFor(model => model.DISPOSALHEADERID)
                                        </th>
                                        <th class="text-center">
                                            @Html.DisplayNameFor(model => model.ASSETTYPE)
                                        </th>
                                        <th class="text-center">
                                            @Html.DisplayNameFor(model => model.EMP_NAME)
                                        </th>
                                        <th class="text-center">
                                            @Html.DisplayNameFor(model => model.DATEADDED)
                                        </th>
                                        <th class="text-center">
                                            @Html.DisplayNameFor(model => model.AssetCount)
                                        </th>
                                        <th class="text-center">
                                            @Html.DisplayNameFor(model => model.ACTIVE)
                                        </th>
                                        <th class="text-center">
                                            @Html.DisplayNameFor(model => model.IBM_APPDATE)
                                        </th>
                                        <th class="text-center">
                                            @Html.DisplayNameFor(model => model.PROCESSSTATUS)
                                        </th>
                                        @*------------------START-[Code Added by Aumento on 22-Dec-2023]------------------------------*@
                                        <th class="text-center">
                                            IC Month
                                        </th>
                                        <th class="text-center">
                                            Implementation Month
                                        </th>
                                        <th class="text-center">
                                            Operation
                                        </th>
                                        <th class="text-center">
                                            Original Cost Summary
                                        </th>
                                        <th class="text-center">
                                            Net Value
                                        </th>
                                        @*------------------END-[Code Added by Aumento on 22-Dec-2023]--------------------------------*@
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int rowNo = 0; }
                                    @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                <tr>
                                    <td class="text-center" style="width:3%;">
                                        @(rowNo += 1)
                                        @Html.HiddenFor(modelItem => item.DISPOSALHEADERID)
                                    </td>
                                    <td class="text-center">
                                        @Html.DisplayFor(modelItem => item.ASSETTYPE)
                                    </td>
                                    <td class="text-center">
                                        @Html.DisplayFor(modelItem => item.EMP_NAME)
                                    </td>
                                    <td class="text-center">
                                        @Html.DisplayFor(modelItem => item.DATEADDED)
                                    </td>
                                    <td class="text-center">
                                        @Html.DisplayFor(modelItem => item.AssetCount)
                                    </td>
                                    <td class="text-center">
                                        @if (item.ACTIVE == true)
                                                {
                                                <button class="btn btn-success btn-xs" style="cursor: text !important">Active</button>
                                                }
                                                else
                                                {
                                                <button class="btn btn-danger btn-xs" style="cursor: text !important">Deactive</button>
                                                }
                                    </td>
                                    <td class="text-center">
                                        @Html.DisplayFor(modelItem => item.IBM_APPDATE)
                                    </td>
                                    <td class="text-center">
                                        @Html.DisplayFor(modelItem => item.PROCESSSTATUS)
                                    </td>
                                    @*------------------START-[Code Added by Aumento on 22-Dec-2023]------------------------------*@
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.ICMONTH)</td>@* [Added by Aumento on 09-Jan-2024]*@
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.IMPLEMENTMONTH)</td>@* [Added by Aumento on 09-Jan-2024]*@
                                    <td class="text-center">
                                        @Html.DisplayFor(modelItem => item.Emp_Detail._OpDesc)
                                    </td>
                                    <td class="text-center">
                                        @{
                                                    decimal ORIGINALCOSTSum = 0;
                                                    foreach (var it in item.DisposalDetailList)
                                                    {
                                                        ORIGINALCOSTSum += it.ORIGINALCOST ?? 0;
                                                    }
                                        }
                                        @if (ORIGINALCOSTSum != 0)
                                                {
                                                @String.Format("{0:N}", ORIGINALCOSTSum)
                                                }
                                                else
                                                {
                                                @ORIGINALCOSTSum
                                                }
                                    </td>
                                    <td class="text-center">
                                        @{
                                                    decimal WDVsum = 0;

                                                    foreach (var it in item.DisposalDetailList)
                                                    {
                                                        WDVsum += it.WDV ?? 0;
                                                    }
                                        }
                                        @if (WDVsum != 0)
                                                {
                                                @String.Format("{0:N}", WDVsum)
                                                }
                                                else
                                                {
                                                @WDVsum
                                                }
                                    </td>
                                    @*------------------END-[Code Added by Aumento on 22-Dec-2023]--------------------------------*@
                                    <td class="text-center">
                                        <button class="btn btn-danger btn-xs glyphicon glyphicon-remove" title="Click to cancel" data-ctrl="btn-cancel-req" data-id="@item.DISPOSALHEADERID"></button>
                                        @{
                                                    var _ibmAppDate = item.IBM_APPDATE == null ? "" : string.Format("{0:dd-MMM-yyyy}", item.IBM_APPDATE);
                                                <button class="btn btn-warning btn-xs glyphicon glyphicon-pencil" title="Click to update IBM approval date" data-ctrl="btn-upd-ibm-dt" data-ibmAppDate="@_ibmAppDate" data-id="@item.DISPOSALHEADERID"></button>
                                        }
                                        <button class="btn btn-info btn-xs glyphicon glyphicon-tasks" title="Click to detail" data-id="@item.DISPOSALHEADERID" data-ctrl="btn-detail-request"></button>
                                    </td>
                                </tr>
                                                        }
                                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="myCreateModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="padding:10px!important;">
                    <div class="pull-left">
                        <h5 class="modal-title"><span id="sp_type">Update Approval Date</span></h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body" style="padding:10px!important;">
                    <div id="myCreateModelContent" style="height:110px;font-size: medium;">
                        <div class="form-group">
                            @* @Html.Label("IBM Approval Date", htmlAttributes: new { @class = "control-label col-md-4" }) *@
                            @Html.Label("IBM Approval Date", "IBM Approval Date", new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                <input type="text" id="txtAppDate" class="form-control appDate" readonly="readonly" />
                                @Html.ValidationMessage("ValidationMsg", "", new { @id = "validationText", @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group" style="padding-top: 60px;">
                            <div class="col-md-offset-4 col-md-8">
                                <input type="hidden" id="hfHeaderId" />
                                <input type="button" value="Update" class="btn btn-success" id="btnUpdate" />
                                <button type="button" class="btn btn-default" data-dismiss="modal" aria-label="Close">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="ajaxLoader"></div>
@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $("#tbManageCancellation").dataTable({
                //"bFilter": false,
                //"bLengthChange": false
            });

            $('.appDate').datepicker({
                format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                clearBtn: true
            });
        });

        function DetailRequest(current) {
            window.location.href = "/AssetDisposal/AssetRequestDetail/" + $(current).attr('data-id');
        }

        function CancelRequest(current) {
            swal({
                title: "Are you sure want to cancel request?",
                text: "",
                type: "input",
                showCancelButton: true,
                closeOnConfirm: false,
                inputPlaceholder: "Please enter remark",
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, cancel it!",
            }, function (inputValue) {
                if (inputValue === false) return false;
                if (inputValue === "") {
                    swal.showInputError("Cancel remark is mandatory field!");
                    return false
                }
                else {
                    var approvalData = {
                        DISPOSALHEADERID: $(current).attr('data-id'),
                        REMARKS: inputValue
                    }
                    var data = {
                        DISPOSALHEADERID: $(current).attr('data-id'),
                        Approval_History: approvalData,
                    }                   
                    $.ajax({
                        type: "PUT",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        url: "/AssetDisposal/CancelRequest",
                        data: JSON.stringify(data),
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (res) {
                            if (res == 1) {
                                swal({
                                    title: "",
                                    text: "Request cancelled successfully",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                        window.location.href = "/AssetDisposal/ManageRequestCancellation";
                                    }
                                });
                            }
                            else if (res == 0 || res == -1) {
                                sweetAlert("", "Request not cancelled", "warning");
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }
            });
        }

        function UpdateIBMAppDate(current) {
            $("#validationText").text('');
            $("#txtAppDate").removeClass('validationError');
            $('#txtAppDate').val('');
            $("#hfHeaderId").val($(current).attr('data-id'));
            $("#txtAppDate").val($(current).attr('data-ibmAppDate'));
            $('#myCreateModel').modal({ backdrop: "static" });
        }

        function updateData() {
            $("#validationText").text('');
            $("#txtAppDate").removeClass('validationError');
            if ($('#txtAppDate').val() == "") {
                $("#txtAppDate").addClass('validationError');
                $("#validationText").text('Please select approval date.');
                return;
            }

            $('#myCreateModel').modal('hide');
            var data = {
                DISPOSALHEADERID: $("#hfHeaderId").val(),
                //IBM_APPDATE: new Date($("#txtAppDate").val()),Changed by TTL on 11-Oct-2025 agaiconst CR7306
                IBM_APPDATE: new Date($("#txtAppDate").val() + " 12:00:00"),
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/AssetDisposal/UpdateIBMDate",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (res) {
                    if (res == 1) {
                        swal({
                            title: "",
                            text: "Approval date updated successfully",
                            type: "success",
                        }, function (isConfirm) {
                            if (isConfirm) {
                                window.location.href = "/AssetDisposal/ManageRequestCancellation";
                            }
                        });
                    }
                    else if (res == 0 || res == -1) {
                        sweetAlert("", "Approval date not updated", "warning");
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
        @*------------------START-[Code Added by Aumento on 22-Dec-2023]------------------------------*@
        function ExportToExcel() {
            $.ajax({
                type: "GET",
                url: "/AssetDisposal/ExportToExcelICDisposalData",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    debugger;
                    if (data == 1) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "AssetDisposal", Action = "DownloadExcel" })";
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
        @*------------------END-[Code Added by Aumento on 22-Dec-2023]------------------------------*@
    </script>

    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $(document).on('click', '[data-ctrl="btn-detail-request"]', function () {
                DetailRequest($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="btn-upd-ibm-dt"]', function () {
                UpdateIBMAppDate($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="btn-cancel-req"]', function () {
                CancelRequest($(this)[0]);
            });
            $('#btnUpdate').on('click', function () {
                updateData();
            });
            $('#btnExcel').on('click', function () {
                ExportToExcel();
            });
        });
    </script>
}