@model ePortal.ViewModels.AssetDisposalViewModel
@using Microsoft.AspNetCore.Http

@{
    ViewBag.Title = "EditUserApproval";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loginUser = Context.Session.GetString("userID") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userID").ToString());


    if (Model.IsEnableForApp == 0)
    {
         bool isRowExist = Model.AppHistoryList.Any(h => h.PROCESSSTATUSID == Model.PROCESSSTATUSID && h.APPCODE == Convert.ToInt64(Context.Session.GetString("userID")));
        if (isRowExist)
        // var isRowExist = Model.AppHistoryList.FirstOrDefault(h => h.PROCESSSTATUSID == Model.PROCESSSTATUSID && h.APPCODE == loginUser);

        // if (isRowExist != null)
        {
            Model.IsEnableForApp = 1;
        }
    }

}
@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }
        /* Changed by TTL against CR7608 - Start*/
        .toast-title{
            font-size: medium;
            font-weight: 100;
        }
        .toast-message{
            font-size: small;
            margin-top: 5px;
        }

        .toast.toast-success {
            opacity: 1 !important;
        }
        /* Changed by TTL against CR7608 - Start*/
    </style>
}
<link href="~/css/toastr.min.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/new-aproval-page.css" asp-append-version="true" />

@* Header and Breadcrumb *@
<div class="app-header">
    <div>Edit User Approval</div>
    <div class="pull-right"><span style="color:#e6dede91"> <i class="fa fa-home"></i> <i class="fa fa-angle-right"></i> Asset Disposal <i class="fa fa-angle-right"></i> </span>Edit User Approval</div>
</div>
<div class="app-header app-sub-header">
    <div>Asset Disposal Detail</div>
    <div class="pull-right"><a href="~/Uploads/AssetDisposal/InformationDoc/ScreenGuideUserapproval.pdf" class="pull-right glyphicon glyphicon-info-sign" style="font-size:25px;top: 1px;color: #008080;" id="ancOpenInfo"></a></div>
</div>
@* Requestor Details *@
<div class="panel panel-shadow">
    <div class="panel-heading" data-toggle="collapse" data-target="#reqDetails">
        <span class="panel-title">
            <i class="fa fa-caret-down caret-color"></i>Requestor's Details
        </span>
    </div>
    <div id="reqDetails" class="panel-body panel-collapse collapse in">
        <table class="table table-responsive approval-table table-curved">
            <tbody>
                <tr>
                    <th width="15%">
                        @Html.HiddenFor(model => model.IsEnableForApp, new { @id = "hdappaction" })
                        @Html.HiddenFor(model => model.STATUS_LEVEL, new { @id = "hfStatusLevel" })
                        @Html.HiddenFor(model => model.ASSETTYPEID, new { @id = "hfAssetTypeId" })
                        @Html.LabelFor(model => model.ASSETTYPE)
                    </th>
                    <td width="35%">@Model.ASSETTYPE</td>
                    <th width="15%">
                        @Html.HiddenFor(model => model.ADEMPCODE, new { @id = "hfEmpCode" })
                        @Html.LabelFor(model => model.EMP_NAME)
                    </th>
                    <td width="35%">@Model.EMP_NAME</td>
                </tr>
                <tr>
                    <th>@Html.Label("Operation")</th>
                    <td>@Model.Emp_Detail._OpDesc</td>
                    <th>@Html.Label("Division")</th>
                    <td>@Model.Emp_Detail._DivDesc</td>
                </tr>
                <tr>
                    <th>@Html.Label("Department")</th>
                    <td>@Model.Emp_Detail._DepDesc</td>
                    <th>@Html.Label("Section")</th>
                    <td>@Model.Emp_Detail._SecDescrip</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
@* Asset Details *@
<div class="panel panel-shadow">
    <div class="panel-heading" data-toggle="collapse" data-target="#assetDetails">
        <span class="panel-title">
            <i class="fa fa-caret-down caret-color"></i>Asset Details
            @Html.HiddenFor(model => model.TOTAL_AMOUNT, new { @id = "hfTotal_Amt" })
        </span>
    </div>
    <div id="assetDetails" class="panel-body panel-collapse collapse in">
        <table class="table table-responsive approval-table custom-datatable table-curved" id="tbUserApproval">
            <thead>
                <tr class="bg-info">
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].DISPOSALDETAILID)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].ASSETCODE)
                    </th>
                    <th class="text-left" style="width: 15%!important;">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].ASSETDESCRIPTION)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].VENDORCODE)
                    </th>
                    <th class="text-left">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].VENDORNAME)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].INVOICENO)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].INVOICEDATE)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].SERIALNUMBER)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].PONUMBER)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].PLANTID)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].CAPTALIZED_DATE)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].PARTIAL_FULL)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].ORIGINALCOST)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].DEPRECIATIONCOST)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].WDV)
                    </th>
                    @if (Model.ASSETTYPEID == 1)
                    {
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.DisposalDetailList[0].SALESPRICE)
                        </th>
                    }
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].PROFIT_LOSS)
                    </th>
                    @if (Model.ASSETTYPEID == 1)
                    {
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.DisposalDetailList[0].VALUATION_GST)
                        </th>
                    }
                    @if (Model.ASSETTYPEID == 2)
                    {
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.DisposalDetailList[0].TENTATIVE)
                        </th>
                    }
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].CONDITIONID)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].VIBRATION_SENSOR)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].ASSET_CATEGORY)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].BILLENTRY)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].LICENSENO)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].PURCHASEDDATE)
                    </th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNo = 0;
                }
                @if (Model != null)
                {
                    foreach (var item in Model.DisposalDetailList)
                    {
                        var _InvoiceDate = item.INVOICEDATE == null ? "" : string.Format("{0:yyyy-MM-dd}", item.INVOICEDATE);
                        <tr class="row_data">
                            <td class="text-center" style="width:3%;">
                                @(rowNo += 1)
                                @Html.HiddenFor(modelItem => item.DISPOSALDETAILID)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.ASSETCODE)
                                @Html.HiddenFor(modelItem => item.DISPOSALHEADERID)
                            </td>
                            <td class="text-left" style="width: 15%!important;">
                                @Html.DisplayFor(modelItem => item.ASSETDESCRIPTION)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.VENDORCODE)
                            </td>
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.VENDORNAME)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.INVOICENO)
                            </td>
                            <td class="text-center">
                                @_InvoiceDate
                                @*@Html.DisplayFor(modelItem => item.INVOICEDATE)*@
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.SERIALNUMBER)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.PONUMBER)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.PLANTNAME)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.CAPTALIZED_DATE)
                            </td>
                            <td class="text-center">
                                @{
                                    if (item.PARTIAL_FULL == 2)
                                    {
                                        <span>Partial</span>
                                    }
                                    else
                                    {

                                        <span>Full</span>
                                    }
                                }
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.ORIGINALCOST)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.DEPRECIATIONCOST)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.WDV)
                            </td>
                            @if (Model.ASSETTYPEID == 1)
                            {
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.SALESPRICE)
                                </td>
                            }
                            <td class="text-right">
                                @Html.DisplayFor(modelItem => item.PROFIT_LOSS)
                            </td>
                            @if (Model.ASSETTYPEID == 1)
                            {
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.VALUATION_GST)
                                </td>
                            }
                            @if (Model.ASSETTYPEID == 2)
                            {
                                <td class="text-right">
                                    @Html.DisplayFor(modelItem => item.TENTATIVE)
                                </td>
                            }
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.ASSET_CONDITION)
                            </td>
                            <td class="text-center">
                                @{
                                    if (item.VIBRATION_SENSOR == 1)
                                    {
                                        <span>Yes</span>
                                    }
                                    else if (item.VIBRATION_SENSOR == 0)
                                    {

                                        <span>No</span>
                                    }
                                }
                            </td>
                            <td class="text-center">
                                @{
                                    if (item.ASSET_CATEGORY == 1)
                                    {
                                        <span>Import</span>
                                    }
                                    else if (item.ASSET_CATEGORY == 2)
                                    {

                                        <span>Domestic</span>
                                    }
                                }
                            </td>

                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.BILLENTRY)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.LICENSENO)
                            </td>
                            <td class="text-center">
                                @if (item.PURCHASEDDATE == null)
                                {
                                    <span>N/A</span>
                                }
                                else
                                {
                                    @Html.DisplayFor(modelItem => item.PURCHASEDDATE)
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@* Summary *@
<div class="panel panel-shadow">
    <div class="panel-heading" data-toggle="collapse" data-target="#assetDetailSummary">
        <span class="panel-title">
            <i class="fa fa-caret-down caret-color"></i>Summary
            @Html.HiddenFor(model => model.TOTAL_AMOUNT, new { @id = "hfTotal_Amt" })
        </span>
    </div>
    <div id="assetDetailSummary" class="panel-body panel-collapse collapse in">
        <table class="table table-responsive approval-table custom-datatable table-curved" id="tbUserApproval">
            <thead>
                <tr class="bg-info">
                    <th class="text-center" style="width:20%;">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].ORIGINALCOST)
                    </th>
                    <th class="text-center" style="width:20%;">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].DEPRECIATIONCOST)
                    </th>
                    <th class="text-center" style="width:20%;">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].WDV)
                    </th>
                    <th class="text-center" style="width:20%;">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].SALESPRICE)
                    </th>
                    <th class="text-center" style="width:20%;">
                        @Html.DisplayNameFor(model => model.DisposalDetailList[0].PROFIT_LOSS)
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    @if (Model.DisposalDetailList != null)
                    {
                        <td class="text-center">
                            @String.Format("{0:0,0.00}", Model.DisposalDetailList.Sum(o => o.ORIGINALCOST))
                        </td>
                        <td class="text-center">
                            @String.Format("{0:0,0.00}", Model.DisposalDetailList.Sum(d => d.DEPRECIATIONCOST))
                        </td>
                        <td class="text-center">
                            @String.Format("{0:0,0.00}", Model.DisposalDetailList.Sum(w => w.WDV))
                        </td>
                        <td class="text-center">
                            @String.Format("{0:0,0.00}", Model.DisposalDetailList.Sum(s => s.SALESPRICE))
                        </td>
                        <td class="text-center">
                            @String.Format("{0:0,0.00}", Model.DisposalDetailList.Sum(p => p.PROFIT_LOSS))
                        </td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
</div>
@* Customer Details *@
@if (Model.ASSETTYPEID == 1 && Model.CustomerDetail != null)
{
    <div class="panel panel-shadow" id="div_CustomerDtl">
        <div class="panel-heading" data-toggle="collapse" data-target="#customerDetails">
            <span class="panel-title">
                <i class="fa fa-caret-down caret-color"></i>Customer Details
            </span>
        </div>
        <div id="customerDetails" class="panel-body panel-collapse collapse in">
            <table class="table table-responsive approval-table table-curved">
                <tbody>
                    <tr>
                        <th width="15%">
                            @Html.LabelFor(model => model.CustomerDetail.CUSTOMERCODE, htmlAttributes: new { @class = "control-label" })
                        </th>
                        <td width="35%">
                            @Html.TextBoxFor(model => model.CustomerDetail.CUSTOMERCODE, htmlAttributes: new { @placeholder = "Customer Code", @id = "txtCustomerCode", @readonly = "readonly", @class = "form-control" })
                        </td>
                        <th width="15%">
                            @Html.LabelFor(model => model.CustomerDetail.CUSTOMERNAME, htmlAttributes: new { @class = "control-label" })
                        </th>
                        <td width="35%">
                            @Html.TextBoxFor(model => model.CustomerDetail.CUSTOMERNAME, htmlAttributes: new { @placeholder = "Customer Name", @id = "txtCustomerName", @readonly = "readonly", @class = "form-control" })
                        </td>
                    </tr>
                    <tr>
                        <th>
                            @Html.LabelFor(model => model.CustomerDetail.CUSTADDRESS, htmlAttributes: new { @class = "control-label" })
                        </th>
                        <td>
                            @Html.TextAreaFor(model => model.CustomerDetail.CUSTADDRESS, htmlAttributes: new { @placeholder = "Customer Address", @id = "txtCustomerAddress", @readonly = "readonly", @class = "form-control" })
                        </td>
                        <th>
                            @Html.LabelFor(model => model.CustomerDetail.PAYMENTDETAILS, htmlAttributes: new { @class = "control-label" })
                        </th>
                        <td>
                            @Html.TextAreaFor(model => model.CustomerDetail.PAYMENTDETAILS, htmlAttributes: new { @placeholder = "Payment Detail", @id = "txtPaymentDetail", @class = "form-control", @readonly = "readonly" })
                        </td>
                    </tr>
                    <tr>
                        <th>
                            @Html.LabelFor(model => model.CustomerDetail.CUSTGSTIN, htmlAttributes: new { @class = "control-label" })
                        </th>
                        <td>
                            @Html.TextBoxFor(model => model.CustomerDetail.CUSTGSTIN, htmlAttributes: new { @placeholder = "GST", @id = "txtGST", @readonly = "readonly", @class = "form-control" })
                        </td>
                        <th>
                            @Html.LabelFor(model => model.CustomerDetail.BASICVALUE, htmlAttributes: new { @class = "control-label" })
                        </th>
                        <td>
                            @Html.TextBoxFor(model => model.CustomerDetail.BASICVALUE, htmlAttributes: new { @placeholder = "Sales Value", @id = "txtSalesValue", @readonly = "readonly", @class = "form-control" })
                        </td>
                    </tr>
                    <tr>
                        <th>
                            @Html.LabelFor(model => model.CustomerDetail.GSTRATE, htmlAttributes: new { @class = "control-label" })
                        </th>
                        <td>
                            @Html.TextBoxFor(model => model.CustomerDetail.GSTRATE, htmlAttributes: new { @placeholder = "GST", @id = "txtGSTRATE", @readonly = "readonly", @class = "form-control" })
                        </td>
                        <th></th>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}
@* Attachments *@
<div class="panel panel-shadow" id="div_Attachmnet">
    <div class="panel-heading" data-toggle="collapse" data-target="#attachments">
        <span class="panel-title">
            <i class="fa fa-caret-down caret-color"></i>Attachments
        </span>
    </div>
    <div id="attachments" class="panel-body panel-collapse collapse in">
        @if (string.IsNullOrEmpty(Model.BACKUP_ATTACHMENT_NAME) && string.IsNullOrEmpty(Model.TRANSFERSLIP_ATTACHMENT_NAME))
        {
            <div class="app-header app-sub-header">
                @Html.DisplayName("Attachments not found")
            </div>
        }
        else
        {
            <table class="table table-responsive approval-table table-curved">
                <tbody>
                    <tr>
                        @if (!string.IsNullOrEmpty(Model.BACKUP_ATTACHMENT_NAME))
                        {
                            <th width="15%">
                                @if (Model.ASSETTYPEID == 1)
                                {
                                    @Html.LabelFor(model => model.QUOTATION_ATTACHMENT_NAME, htmlAttributes: new { @class = "control-label" })
                                }
                                else
                                {
                                    @Html.LabelFor(model => model.BACKUP_ATTACHMENT, htmlAttributes: new { @class = "control-label" })
                                }
                            </th>
                            <td>
                                <div class="btn btn-md btn-aprvl-view">
                                    <a target="_blank" href="@Url.Action("DownloadAttachment", "AssetDisposal", new { file_name = Model.BACKUP_ATTACHMENT_NAME })" title="Click to download pdf">
                                        <i class="fa fa-external-link" style="cursor:pointer;"></i>
                                        View Attachment
                                    </a>
                                </div>
                            </td>
                        }
                        @if (!string.IsNullOrEmpty(Model.TRANSFERSLIP_ATTACHMENT_NAME))
                        {
                            <th width="15%">
                                @if (Model.ASSETTYPEID == 1)
                                {
                                    @Html.LabelFor(model => model.INVOICE_ATTACHMENT_NAME, htmlAttributes: new { @class = "control-label" })
                                }
                                else
                                {
                                    @Html.LabelFor(model => model.TRANSFERSLIP_ATTACHMENT, htmlAttributes: new { @class = "control-label" })
                                }
                            </th>
                            <td>
                                <div class="btn btn-md btn-aprvl-view">
                                    <a target="_blank" href="@Url.Action("DownloadAttachment", "AssetDisposal", new { file_name = Model.TRANSFERSLIP_ATTACHMENT_NAME })" title="Click to download pdf">
                                        <i class="fa fa-external-link" style="cursor:pointer;"></i>
                                        View Attachment
                                    </a>
                                </div>
                            </td>
                        }
                    </tr>
                </tbody>
            </table>
        }
    </div>
</div>
@* Approval History *@
<div class="panel panel-shadow">
    <div class="panel-heading" data-toggle="collapse" data-target="#approvalHistory">
        <span class="panel-title">
            <i class="fa fa-caret-down caret-color"></i>Approval History
        </span>
    </div>
    <div id="approvalHistory" class="panel-body panel-collapse collapse in">
        <div class="table-responsive">
            <table class="table table-responsive approval-table table-curved custom-datatable" id="tbApprovalHis">
            <thead>
                <tr>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.AppHistoryList[0].APPROVALHISTORYID)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.AppHistoryList[0].APPEMP_NAME)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.AppHistoryList[0].APPROVALSTATUS)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.AppHistoryList[0].DATEADDED)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.AppHistoryList[0].REMARKS)
                    </th>
                    <th class="text-center">
                        @Html.DisplayName("Attachment")
                        @*@Html.DisplayNameFor(model => model.AppHistoryList[0].ATTACHMENT)*@
                    </th>
                </tr>
            </thead>
            <tbody>
                @{
                    int row_No = 0;
                }
                @if (Model.AppHistoryList != null)
                {
                    foreach (var item in Model.AppHistoryList)
                    {
                        <tr class="row_data">
                            <td class="text-center">
                                @if (item.STATUS_LEVEL == 7)
                                {
                                    <span class="row-header row-toggle-btn" title="Click to show PPC approval detail.">
                                        <b style="padding:5px;">+</b>
                                    </span>
                                }
                                @(row_No += 1)
                                @Html.HiddenFor(modelItem => item.APPROVALHISTORYID)
                            </td>
                            <td class="text-left">
                                @Html.HiddenFor(modelItem => item.DISPOSALHEADERID)
                                @Html.DisplayFor(modelItem => item.APPEMP_NAME)
                            </td>
                            <td class="text-left">
                                @{
                                    string _msg = item.ARS_MSG + " " + item.DISPLAY_MSG;
                                    <span>@_msg</span>
                                }
                            </td>
                            <td class="text-center">
                                @{
                                    var _date = string.Format("{0:dd-MMM-yyyy}", item.DATEADDED);
                                    var _dateAdded = (_date == "01-Jan-0001" ? "" : _date);
                                }
                                @_dateAdded
                            </td>
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.REMARKS)
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.ATTACHMENT))
                                {
                                    <a href="@Url.Action("DownloadApprovalAttachment", "AssetDisposal", new { file_name = item.ATTACHMENT })">
                                        <i class="glyphicon glyphicon-download-alt"></i>
                                    </a>
                                }
                            </td>
                        </tr>

                        if (item.STATUS_LEVEL == 7)
                        {
                            <tr id="tr_PPC" class="row_data hidden">
                                <td colspan="6">
                                    <table class="table table-responsive approval-table table-curved custom-datatable">
                                        <thead>
                                            <tr>
                                                <th colspan="4">Plant PPC Approval Attachments</th>
                                            </tr>
                                        </thead>
