@* Approval *@
<div class="panel panel-shadow">
    <div class="panel-heading" data-toggle="collapse" data-target="#approval">
        <span class="panel-title"><i class="fa fa-caret-down caret-color"></i>Approval</span>
    </div>
    <div id="approval" class="panel-body panel-collapse collapse in">
        <div class="remarks-box">
            <div class="text-center pnl-btn">
                <button type="button" class="btn action-btn btn-md reject" data-id="@Model.DISPOSALHEADERID" data-status="3"><i class="fa fa-times-circle-o"></i>REJECT</button>
                <button type="button" class="btn btn-md hold hidden" data-id="@Model.DISPOSALHEADERID" data-status="5"><i class="fa fa-pause"></i>HOLD</button>
                <button type="button" class="btn action-btn btn-md approve flex-2_3_po" data-id="@Model.DISPOSALHEADERID" data-status="1"><i class="fa fa-check-circle-o"></i>APPROVE</button>
            </div>
            <div style="margin: 5px 0;">
                <div class="well">
                    @Html.LabelFor(model => model.ForwardedTo, htmlAttributes: new { @class = "remark-panel-label" })
                    @Html.TextBoxFor(model => model.ForwardedTo, htmlAttributes: new { @id = "txtForwardedTo", @readonly = "readonly", @class = "form-control" })
                </div>
            </div>
            <div>
                <div class="well">
                    <textarea id="txtRemarks" class="form-control" placeholder="Please enter approval remarks."></textarea>
                </div>
            </div>
            <div class="text-center pnl-btn last-row-btn">
                <a title="Back" class="btn back" href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx"><i class="fa fa-arrow-left"></i>BACK</a>
                <button type="button" class="btn action-btn btn-md sendback" data-id="@Model.DISPOSALHEADERID" data-status="2"><i class="fa fa-undo"></i>SEND BACK</button>
                <a title="Skip" class="btn skip" href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx"><i class="fa fa-step-forward"></i>SKIP</a>
            </div>
        </div>
    </div>
</div>

<div id="ajaxLoader"></div>
<script src="~/js/toastr.min.js"></script>
@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $("#tbUserApproval").dataTable({
                "bFilter": false,
                "bLengthChange": false,
                "paging": false,
                "bInfo": false,
                "scrollY": "220px",
                "scrollX": true,
                "scrollCollapse": true,
            });

            OpenConfirModel();

            $('.row-header').click(function () {
                $(this).find('b').text(function (_, value) { return value == '-' ? '+' : '-' });
                $('#tr_PPC').toggleClass('hidden');
            });
        });

        function OpenConfirModel() {
            var chked_count = 0;
            var IsEnableForApp = document.getElementById("hdappaction").value;
            if (IsEnableForApp == 0) {
                $("#btnSubmit").attr("disabled", true);
                swal({
                    title: "",
                    text: "You have already taken the action on this request.",
                    type: "info",
                    showCancelButton: false,
                    confirmButtonClass: "btn-info",
                    confirmButtonText: "OK",
                    cancelButtonText: "No",
                    closeOnConfirm: true,
                    closeOnCancel: true
                },
                function (isConfirm) {
                    if (isConfirm) {
                        window.location.href = "/Home/Home";
                    }
                    else {

                    }
                });
            }
        }

        var arrayList = new Array, _disposalDetailId = 0, _disposalHeaderId = 0;
        function SaveData(current) {
            var _IsValid = CheckValidation(current);
            if (!_IsValid) {
                return;
            }
            $("#btnSubmit").attr("disabled", true);
            var approvalData = {
                DISPOSALHEADERID: $(current).attr('data-id'),
                APPROVALSTATUS: $(current).attr('data-status'),
                REMARKS: $("#txtRemarks").val()
            }
            var data = {
                DISPOSALHEADERID: $(current).attr('data-id'),
                ADEMPCODE: $('#hfEmpCode').val(),
                ASSETTYPEID: $('#hfAssetTypeId').val(),
                STATUS_LEVEL: $('#hfStatusLevel').val(),
                TOTAL_AMOUNT: $('#hfTotal_Amt').val(),
                Approval_History: approvalData,
                Emp_Detail: {
                    _SecId: parseInt('@Model.Emp_Detail._SecId'),
                    _DepId: parseInt('@Model.Emp_Detail._DepId'),
                    _DivId: parseInt('@Model.Emp_Detail._DivId'),
                    _OpId: parseInt('@Model.Emp_Detail._OpId'),
                }
            }
            $.ajax({
                type: "PUT",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/AssetDisposal/EditUserApproval",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        /* Changed by TTL against CR7608 - Start*/
                        toastr.options = {
                            positionClass: 'toast-bottom-center',
                            timeOut: 2000,
                            closeButton: true,
                            progressBar: true
                        };
                        toastr.success('Record saved successfully', 'Success');
                        setTimeout(function(){
                            window.location.href = "/AssetDisposal/ManageUserApproval";
                        }, 1000);
                        /* Changed by TTL against CR7608 - End*/
                    }
                    else if (data == 0 || data == -1) {
                        sweetAlert("", "Record not saved", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data == -2) {
                        sweetAlert("", "Kindly contact to IT team for set approval authority.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function CheckValidation(current) {
            var isVailed = true;
            $('#txtRemarks').removeClass('validationError');
            //Added by TTL :: CR7036
            if ($('#txtRemarks').val() == "" && $(current).attr('data-status') != "1") {
                $('#txtRemarks').addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }
        function openInfo(url) {
            window.open(url, 'mywin', 'width=800,height=600');
        }
        function CancelClick() {
            window.location.href = "/AssetDisposal/ManageUserApproval";
        }

    </script>

    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('.action-btn').on('click', function () {
                SaveData($(this)[0]);
            });
            $('#ancOpenInfo').on('click', function (e) {
                e.preventDefault();
                openInfo($(this).attr('href'));
                return false;
            });
            $('#reqDetails, #assetDetails, #assetDetailSummary, #customerDetails, #attachments, #approvalHistory, #approval').on('show.bs.collapse', function () {
                $(this).prev('.panel-heading').find('.caret-color').removeClass('fa-caret-right').addClass('fa-caret-down');
            });

            $('#reqDetails, #assetDetails, #assetDetailSummary, #customerDetails, #attachments, #approvalHistory, #approval').on('hide.bs.collapse', function () {
                $(this).prev('.panel-heading').find('.caret-color').removeClass('fa-caret-down').addClass('fa-caret-right');
            });

            setPanelWidth();
        });
        $(window).resize(function(){
            setPanelWidth();
        });
        function setPanelWidth() {
            var btnApproveClientWidth = $('.pnl-btn .approve').prop('clientWidth');
            if (window.innerWidth < 1024) { // Mobile layout
                $('.last-row-btn .btn').css({
                    'maxWidth': `auto`
                });
            }
            else {
                $('.last-row-btn .btn').css({
                    'maxWidth': `${btnApproveClientWidth}px`
                });
            }
        }
    </script>
}
