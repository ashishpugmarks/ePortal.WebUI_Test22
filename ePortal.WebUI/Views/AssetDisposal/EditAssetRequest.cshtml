        function readBackupFile(input) {
            var _URL = window.URL || window.webkitURL;
            var file = input.files[0];
            var image = new Image();
            image.src = _URL.createObjectURL(file);
            var extension = $(input).val().split('.').pop().toLowerCase();
            var validFileExtensions = _type == 1 ? ['pdf'] : ['pdf', 'doc', 'docx'];
            if ($.inArray(extension, validFileExtensions) == -1) {
                var _msg = _type == 1?"Sorry! Upload only 'pdf' file" : "Sorry! Upload only 'pdf', 'doc', 'docx' file";
                sweetAlert(" ", _msg, "warning");
                $(input).replaceWith($(input).val('').clone(true));
            }
            else{
                IsUploadAttachment = false;
            }
        }

