                            rows += _pval == 2 ? "<option value='2' selected='selected'>Partial</option></select>" : "<option value='2'>Partial</option></select>"
                            rows += "</td>"
                            rows += "<td class='text-right'><input class='cOrgCost" + rowId + "' id='txtOrgCost_ " + item.ASSETCODE + "' value='" + item.ORIGINALCOST + "' type='number' disabled='disabled' data-type='1' data-ctrl='txt-org-cost-2' placeholder='Original Cost' style='height: 20px;width: 120px;text-align: right;margin-bottom: 0px;' /></td>"
                            rows += "<td class='text-right'><input class='cDepVal" + rowId + "' id='txtDepreciation_ " + item.ASSETCODE + "' value='" + item.DEPRECIATIONCOST + "' type='number' disabled='disabled' data-type='2' data-ctrl='txt-depreciation-2' placeholder='Depreciation Cost' style='height: 20px;width: 120px;text-align: right;margin-bottom: 0px;' /></td>"
                            //===========================================================================
                            //rows += "<td class='text-right'>" + item.ORIGINALCOST + "</td>"
                            //rows += "<td class='text-right'>" + item.DEPRECIATIONCOST + "</td>"

                            //Below Added by aumento on 20042023===================================================================================================================================================
                            //rows += "<td class='text-right" + rowId + "'>" + item.WDV + "</td>"
                            rows += "<td class='text-right cNetVal" + rowId + "'>" + item.WDV + "</td>"
                            // rows += "<td class='text-right'><input id='txtSalePrice_ " + item.ASSETCODE + "' value='" + Sale_Value + "' type='number' data-wdv='" + item.WDV + "' onkeyup='SaleValueOnKeyup(this);' placeholder='Sales Price' style = 'height: 20px;width: 90px;text-align: right;margin-bottom: 0px;' /></td>"
                            rows += "<td class='text-right'><input class='cSalVal" + rowId + "' id='txtSalePrice_ " + item.ASSETCODE + "' value='" + item.SALESPRICE + "' type='number' data-wdv='" + item.WDV + "' data-ctrl='txt-sale-price-1' placeholder='Sales Price' style='height: 20px;width: 120px;text-align: right;margin-bottom: 0px;' /></td>"
                            //=====================================================================================================================================================================================
                            profit_loss = parseFloat((Sale_Value == "" ? 0 :Sale_Value) - item.WDV).toFixed(2); /// (SaleValue - wdv)
