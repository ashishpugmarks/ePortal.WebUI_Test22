        function AssetTypeChange(crnt) {
            if (crnt.checked == true && crnt.value == "1") {
                $('#div_CustomerDtl').removeClass('hidden');
                //$('#div_Attachmnet').addClass('hidden');

                $('#div-scrap').removeClass('highlightBackground');
                $('#div-sale').addClass('highlightBackground');

                $('#lblBackupAtt').text('Quotation Attachment');
                $('#lblTransferAtt').text('Invoice Attachment');

                $('#lblQuotation').text('[Selected customer quotation]')
                $('#lblInvoice').text('[Selected asset purchase invoice]')
                _type = 1;
                return;
            }
            else if (crnt.checked == true && crnt.value == "2") {
                //$('#div_Attachmnet').removeClass('hidden');
                $('#div_CustomerDtl').addClass('hidden');

                $('#div-sale').removeClass('highlightBackground');
                $('#div-scrap').addClass('highlightBackground');

                $('#lblBackupAtt').text('Invoice / Photograph');
                $('#lblTransferAtt').text('Scrap Approval / Technical Note');

                $('#lblQuotation').text('')
                $('#lblInvoice').text('')
                _type = 2;
                return;
            }
            else {
                $('#div_Attachmnet').addClass('hidden');
                $('#div_CustomerDtl').addClass('hidden');
                return;
            }
        }

        function FillCustomerAndAttachments(){
            if(_type == 1){
                $("#rbSale").prop("checked", true);
                $('#div_CustomerDtl').removeClass('hidden');
                //$('#div_Attachmnet').addClass('hidden');

                $('#div-scrap').removeClass('highlightBackground');
                $('#div-sale').addClass('highlightBackground');

                $('#lblBackupAtt').text('Quotation Attachment');
                $('#lblTransferAtt').text('Invoice Attachment');

                $('#lblQuotation').text('[Selected customer quotation]')
                $('#lblInvoice').text('[Selected asset purchase invoice]')
            }
            else{
                $('#rbScrap').prop("checked", true);
