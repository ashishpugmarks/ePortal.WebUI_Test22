                $(_total_row).find('td')[3].innerText = _sSum.toFixed(2);
                $(_total_row).find('td')[4].innerText = _pSum.toFixed(2);
                $(_total_row).find('td')[5].innerText = _tSum.toFixed(2);
                $("#txtTotalSaleValue").val(_sSum.toFixed(2));
            }
            return;
        }

        function ResetCustomerDetail() {
            $('#txtCustomerCode').val('');
            $('#txtCustomerName').val('');
            $('#txtCustomerAddress').val('');
            $('#txtGST').val('');
            $('#txtCustomerGSTIN').val('');
            $('#txtPaymentDetail').val('');
            $('#txtTotalSaleValue').val('');
        }

        function ResetAttachments() {
            $('#txtBackupFile').val('');
            $('#txtScrapSlipFile').val('');
            //$('#txtMutilationFile').val('');
        }

        function DateFormat(date){
            if(ValidateDate(date)){
                return date;
            }

            var _date = new Date(parseInt(date.replace('/Date(', '')));
            return _date.toLocaleDateString('en-GB', {year: 'numeric'}) + "-" + _date.toLocaleDateString('en-GB', {month: '2-digit'}) + "-" + _date.toLocaleDateString('en-GB', {day: '2-digit'})
            //return _date.toLocaleDateString('en-GB', {year: 'numeric', month: 'numeric', day: 'numeric'}).replace(/ /g, '-');
        }

        function ValidateDate(dtValue) {
            var dtRegex = new RegExp(/^\d\d\d\d?-\w\w-\d\d/);
            return dtRegex.test(dtValue);
        }

        function ExportToExcel() {
            if (TotalRowCount == 0) {
                $("#div-table").addClass('validationBackground');
                $("#span-errorMsg").text("Please select asset items. ");
                return;
            }
            DisposalHeader = {
                DisposalDetailList: arrayList,
            }
            $.ajax({
                type: "POST",
                url: "/AssetDisposal/ExportToExcel",
                data: JSON.stringify(DisposalHeader),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "AssetDisposal", Action = "DownloadExcel" })";
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
    </script>
