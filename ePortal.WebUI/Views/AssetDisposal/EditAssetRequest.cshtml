        function ValueOnKeyup(crnt) {
            if ($(crnt).attr('data-type') == "1") {
                var tds = $(crnt).parent().nextAll().slice(0, 3);
                //-- Set Net Value
                var _val = parseFloat($(crnt).val()) - parseFloat(tds[0].firstElementChild.value);
                if (isNaN(_val)) {
                    _val = 0.00;
                }
                tds[1].textContent = _val.toFixed(2);

                //-- Set profit/loss
                var _val2 = parseFloat(0) - parseFloat(tds[1].textContent);
                if (isNaN(_val2)) {
                    _val2 = 0.00;
                }

                tds[2].textContent = _val2.toFixed(2);


            }
            else {
                var next_tds = $(crnt).parent().nextAll().slice(0, 2);
                var prev_td = $(crnt).parent().prev();
                //-- Set Net Value
                var _val = parseFloat(prev_td[0].firstElementChild.value) - parseFloat($(crnt).val());
                if (isNaN(_val)) {
                    _val = 0.00;
                }
                next_tds[0].textContent = _val.toFixed(2);

                //-- Set profit/loss
                var _val2 = parseFloat(0) - parseFloat(next_tds[0].textContent);
                if (isNaN(_val2)) {
                    _val2 = 0.00;
                }

                next_tds[1].textContent = _val2.toFixed(2);

            }
            CalculateTotalSummary();
        }

