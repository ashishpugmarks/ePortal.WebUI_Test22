        //        text: "Are you sure want to cancel request?",
        //        type: "warning",
        //        showCancelButton: true,
        //        confirmButtonClass: "btn-danger",
        //        confirmButtonText: "Yes, cancel it!",
        //        closeOnConfirm: false
        //    }, function () {
        //        var data = {
        //            DISPOSALHEADERID: $(current).attr('data-id')
        //        }
        //        $.ajax({
        //            type: "POST",
        //            url: "/AssetDisposal/CancelRequest",
        //            data: JSON.stringify(data),
        //            contentType: "application/json; charset=utf-8",
        //            datatype: "json",
        //            success: function (res) {
        //                if (res == 1) {
        //                    swal({
        //                        title: "",
        //                        text: "Request cancelled successfully",
        //                        type: "success",
        //                    }, function (isConfirm) {
        //                        if (isConfirm) {
        //                            window.location.href = "/AssetDisposal/ManageAssetRequest";
        //                        }
        //                    });
        //                }
        //                else if (res == 0 || res == -1) {
        //                    sweetAlert("", "Request not cancelled", "warning");
        //                }
        //            },
        //            error: function () {
        //                sweetAlert("Oops...", "Something went wrong!", "error");
        //            }
        //        });
        //    });
        //}

        function CancelRequest(current) {
            var _disposalHeaderId = $(current).attr('data-id');
            if (_disposalHeaderId != undefined) {
                $('#_form')[0].action = "/AssetDisposal/CancelRequest";
                $('#hfHeaderId').val(_disposalHeaderId);
                $('#_form').submit();
            }
        }
    </script>

    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $(document).on('click', '[data-ctrl="detail-request"]', function () {
                DetailRequest($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="upload-invoice"]', function () {
                UploadInvoice($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="edit-request"]', function () {
                EditRequest($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="cancel-request"]', function () {
                CancelRequest($(this)[0]);
            });
            $('#btnCreateNewRequest').on('click', function () {
                CreateRequest($(this)[0]);
            });
        });
    </script>
}