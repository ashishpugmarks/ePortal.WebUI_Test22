                            arrayList[objIndex].DEPRECIATIONCOST = row.cells[13].firstChild.value == "" ? null : row.cells[13].firstChild.value;
                            arrayList[objIndex].SALESPRICE = row.cells[15].firstChild.value == "" ? 0 : row.cells[15].firstChild.value;
