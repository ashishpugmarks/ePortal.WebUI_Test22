                var row = rows[i];
                if (row != undefined) {
                    var assetCode = row.cells[0].innerHTML.trim()
                    var objIndex = -1;
                    arrayList.some(function (el, i) {
                        if (el.ASSETCODE == assetCode) {
                            objIndex = i;
                            return true;
                        }
                    });
                    if (objIndex > -1) {
                        if (_type == 2) { // InCase of Scrap
