@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            if ('@Model.Emp_Detail._SiteId' == '3') { //// HMSI-Manesar
                $('.th-C1F').addClass('hidden');
            }
            else if ('@Model.Emp_Detail._SiteId' == '6') { //// HMSI-Tapukara
                $('.th-C2F').addClass('hidden');
            }
            else if ('@Model.Emp_Detail._SiteId' == '8') { //// HMSI-Narsapura
                $('.th-C3F').addClass('hidden');
            }
            else if ('@Model.Emp_Detail._SiteId' == '21') { //// HMSI-Vithalapur
                $('.th-C4F').addClass('hidden');
            }

            if ('@Model.IsPlantRequired' == 1) {
                $('#tbPPCApproval').removeClass('hidden');
                ddRequiredClick();
            }
            else {
                $('#tbPPCApproval').addClass('hidden');
            }
            if ('@Model.IsPlantRequired' == null || '@Model.IsPlantRequired' == '') {
                $("#btnSubmit").attr("disabled", true);
                $("#btnSubmit").addClass('hidden');
                $('#div_Approval').addClass('hidden');
            }
            else {
                $("#btnUpdate").attr("disabled", true);
                $("#btnUpdate").addClass("hidden");
                $('#ddRequired').attr("disabled", true);
                $('#div_Approval').removeClass('hidden');

            }
            $("#tbMgfApproval").dataTable({
                "bFilter": false,
                "bLengthChange": false,
                "paging": false,
                "bInfo": false,
                "scrollY": "220px",
                "scrollX": true,
                "scrollCollapse": true,
            });

            //$("#tbApprovalHis").dataTable({
            //    "bFilter": false,
            //    "bLengthChange": false,
            //    "paging": false,
            //    "bInfo": false
            //});

            //$('.dpLicenseDate').datepicker({
            //    format: "dd-M-yyyy",
            //    todayHighlight: true,
            //    autoclose: true,
            //});
        });

        var arrayList = new Array, _disposalDetailId = 0, _disposalHeaderId = 0, _approvalStatus = 0;
        function SaveData() {
            if ($('#ddRequired').val() == "1") {
                if (parseInt('@Model.P1FAppStatus') == 0 || parseInt('@Model.P2FAppStatus') == 0 || parseInt('@Model.P3FAppStatus') == 0 || parseInt('@Model.P4FAppStatus') == 0) {
                    sweetAlert("", "Plant PPC confirmation required for submission.", "warning");
                    return;
                }
            }

            var _IsValid = CheckValidation();
            if (!_IsValid) {
                return;
            }
            $("#btnSubmit").attr("disabled", true);
            var rowLength = $('#tbMgfApproval').find('.row_data').length;
            var rows = $('#tbMgfApproval').find('.row_data');
            for (var i = 0; i < rowLength; i += 1) {
                var row = rows[i];
                if (row != undefined) {
                    _disposalDetailId = $(row.cells[0]).find('input[type=hidden]').val() == "" ? 0 : $(row.cells[0]).find('input[type=hidden]').val();
                    _disposalHeaderId = $(row.cells[1]).find('input[type=hidden]').val() == "" ? 0 : $(row.cells[1]).find('input[type=hidden]').val();
                    _approvalStatus = $(row).find('#AppStatus_' + _disposalDetailId).find('.active input[type=radio]').val();
                    var rowData = {
                        DISPOSALDETAILID: _disposalDetailId,
                        DISPOSALHEADERID: _disposalHeaderId,
                        APPROVAL_STATUS: _approvalStatus,
                        //CONDITIONID: $(row).find('#ddCondition_' + _disposalDetailId).val() == "" ? null : $(row).find('#ddCondition_' + _disposalDetailId).val(),
                    }
                    //if (rowData.CONDITIONID == null) {
                    //    sweetAlert("", "Please select asset condition of each asset item.", "warning");
                    //    arrayList = new Array();
                    //    $("#btnSubmit").attr("disabled", false);
                    //    return;
                    //}
                    arrayList.push(rowData);
                }
            }
            var approvalData = {
                DISPOSALHEADERID: _disposalHeaderId,
                APPROVALSTATUS: $("#ddApprovalStatus").val(),
                REMARKS: $("#txtRemarks").val()
            }
            var data = {
                DISPOSALHEADERID: _disposalHeaderId,
                ADEMPCODE: $('#hfEmpCode').val(),
                ASSETTYPEID: $('#hfAssetTypeId').val(),
                STATUS_LEVEL: $('#hfStatusLevel').val(),
                TOTAL_AMOUNT: $('#hfTotal_Amt').val(),
                Approval_History: approvalData,
                DisposalDetailList: arrayList,
                Emp_Detail: {
                    _SecId: parseInt('@Model.Emp_Detail._SecId'),
                    _DepId: parseInt('@Model.Emp_Detail._DepId'),
                    _DivId: parseInt('@Model.Emp_Detail._DivId'),
                    _OpId: parseInt('@Model.Emp_Detail._OpId'),
                }
            }

            $.ajax({
                type: "PUT",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/AssetDisposal/PlanMgfApproval",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        swal({
                            title: "",
                            text: "Record saved successfully",
                            type: "success",
                        },
                            function (isConfirm) {
                                if (isConfirm) {
                                    window.location.href = "/AssetDisposal/ManagePlantMgfApproval";
                                }
                            });
                    }
                    else if (data == 0 || data == -1) {
                        sweetAlert("", "Record not saved", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data == -2) {
                        sweetAlert("", "Kindly contact to SIS team for set approval authority.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    //else if (data == -3) {
                    //    sweetAlert("", "Kindly contact to SIS team for set next approval authority.", "warning");
                    //    $("#btnSubmit").attr("disabled", false);
                    //}
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function UpdateData() {
            $('#spn_PPCReq').text('');
            $('#ddRequired').removeClass('validationError');
            if ($('#ddRequired').val() == "") {
                $('#ddRequired').addClass('validationError');
                $('#spn_PPCReq').text('Please select PPC Approval required.');
                return;
            }
            var _disposalHeaderId = 0;
            $("#btnUpdate").attr("disabled", true);
            var rowLength = $('#tbMgfApproval').find('.row_data').length;
            var rows = $('#tbMgfApproval').find('.row_data');
            for (var i = 0; i < rowLength; i += 1) {
                var row = rows[i];
                if (row != undefined) {
                    _disposalHeaderId = $(row.cells[1]).find('input[type=hidden]').val() == "" ? 0 : $(row.cells[1]).find('input[type=hidden]').val();
                }
            }
            var data = {
                DISPOSALHEADERID: _disposalHeaderId,
                ADEMPCODE: $('#hfEmpCode').val(),
                ASSETTYPEID: $('#hfAssetTypeId').val(),
                STATUS_LEVEL: $('#hfStatusLevel').val(),
                TOTAL_AMOUNT: $('#hfTotal_Amt').val(),
                IsPlantRequired: $('#ddRequired').val(),
            }

            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/AssetDisposal/UpdateReqApproval",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        swal({
                            title: "",
                            text: "Record Updated successfully",
                            type: "success",
                        },
                            function (isConfirm) {
                                if (isConfirm) {
                                    if ($('#ddRequired').val() == 0) {
                                        $("#btnUpdate").attr("disabled", true);
                                        $("#btnUpdate").addClass("hidden");

                                        $("#btnSubmit").removeClass('hidden');
                                        $("#btnSubmit").attr("disabled", false);

                                        $('#ddRequired').attr("disabled", true);
                                        $('#div_Approval').removeClass('hidden');
                                    }
                                    else {
                                        window.location.href = "/AssetDisposal/ManagePlantMgfApproval";
                                    }
                                }
                            });
                    }
                    else if (data == 0 || data == -1) {
                        sweetAlert("", "Record not saved", "warning");
                        $("#btnUpdate").attr("disabled", false);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function CheckValidation() {
            var isVailed = true;
            $('#ddApprovalStatus').removeClass('validationError');
            if ($('#ddApprovalStatus').val() == "" || $('#ddApprovalStatus').val() == "0") {
                $('#ddApprovalStatus').addClass('validationError');
                isVailed = false;
            }
            $('#txtRemarks').removeClass('validationError');
            //Added by TTL :: CR7036
            if ($('#txtRemarks').val() == "" && $('#ddApprovalStatus').val() != "1") { 
                $('#txtRemarks').addClass('validationError');
                isVailed = false;
            }
            $('#ddRequired').removeClass('validationError');
            if ($('#ddRequired').val() == "") {
                $('#ddRequired').addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }

        function readBackupFile(input) {
            var _URL = window.URL || window.webkitURL;
            var file = input.files[0];
            var image = new Image();
            image.src = _URL.createObjectURL(file);
            var extension = $(input).val().split('.').pop().toLowerCase();
            var validFileExtensions = ['pdf'];
            if ($.inArray(extension, validFileExtensions) == -1) {
                sweetAlert(" ", "Sorry! Upload only 'pdf' file", "warning");
                $(input).replaceWith($(input).val('').clone(true));
            }
        }

        function UploadAttachment() {
            $('#txtApprvalAttachment').removeClass('validationError');
            if ($('#txtApprvalAttachment').val() == "") {
                $('#txtApprvalAttachment').addClass('validationError');
                return;
            }
            var formData = new FormData();
            formData.append("APPROVAL_ATTACHMENT", document.getElementById("txtApprvalAttachment").files[0]);
            $.ajax({
                type: "POST",
                url: "/AssetDisposal/UploadApprovalAttachment",
                data: formData,
                datatype: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data == 1) {
                        $("#span-attachmentMsg").text('Attachment uploaded successfully. ').css('color', 'green').show().delay(5000).fadeOut();
                    }
                    else if (data == 0 || data == -1) {
                        $("#span-attachmentMsg").text('Attachment not uploaded, Please try again. ').css('color', '#a94442').show().delay(5000).fadeOut();
                    }
                },
                error: function () {
                    $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                }
            });
        }

        function GetPrint(current) {
            var data = {
                DISPOSALHEADERID: $(current).attr('data-id')
            }
            $.ajax({
                type: "POST",
                url: "/AssetDisposal/PrintRequest",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data != "") {
                        Print(data);
                    }
                    else {
                        sweetAlert("", "Record not found", "warning");
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function Print(html) {
            var newWin = window.open();
            newWin.document.write(html);
            newWin.document.close();
            newWin.print();
            newWin.close();
        }

        function openInfo(url) {
            window.open(url, 'mywin', 'width=800,height=600');
        }

        function CancelClick() {
            window.location.href = "/AssetDisposal/ManagePlantMgfApproval";
        }

        function ddRequiredClick() {
            if ($('#ddRequired').val() == 1) {
                $.ajax({
                    type: "GET",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    url: "/AssetDisposal/GetPPCPlantAuthority",
                    data: { siteId: 0, statusLevel: 23 },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.res.length > 0) {
                            if ($('#C1F_Authority').text() == "") {
                                var _data = $.grep(data.res, function (e) { return e.SITE == "HMSI-Manesar" });
                                if (_data != null || _data != undefined) { $('#C1F_Authority').text("Pending - " + _data[0].EMPNAME); }
                            }
                            if ($('#C2F_Authority').text() == "") {
                                var _data = $.grep(data.res, function (e) { return e.SITE == "HMSI-Tapukara" });
                                if (_data != null || _data != undefined) { $('#C2F_Authority').text("Pending - " + _data[0].EMPNAME); }
                            }
                            if ($('#C3F_Authority').text() == "") {
                                var _data = $.grep(data.res, function (e) { return e.SITE == "HMSI-Narsapura" });
                                if (_data != null || _data != undefined) { $('#C3F_Authority').text("Pending - " + _data[0].EMPNAME); }
                            }
                            if ($('#C4F_Authority').text() == "") {
                                var _data = $.grep(data.res, function (e) { return e.SITE == "HMSI-Vithalapur" });
                                if (_data != null || _data != undefined) { $('#C4F_Authority').text("Pending - " + _data[0].EMPNAME); }
                            }
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
                $('#tbPPCApproval').removeClass('hidden');
                $('#spn_PPCReq').text('');
            }
            else {
                $('#tbPPCApproval').addClass('hidden');
                $('#spn_PPCReq').text('');
            }
        }
    </script>

