@model ePortal.ViewModels.A00ViewModel
@{
    ViewBag.Title = "Auto Reminders No of Days Master List";
    Layout = "~/Views/Shared/_LayoutAsset.cshtml";

    var List = ViewBag.ViewToList as List<ePortal.ViewModels.AutoRemindersNoofDaysMaster>;
}
@section Styles {

    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">

        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .ui-widget-header, .ui-state-default, ui-button {
            font-weight: bold;
            font-size: 16px;
        }

        .ui-dialog .ui-dialog-content {
            font-size: 14px;
        }

        .ui-dialog-buttonset {
            font-size: 16px;
        }

        .btn1 {
            width: 190px !important;
            font-size: 14px !important;
            background-color: #e3e3e3;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
        }

        .ui-dialog-titlebar-close:before {
            content: "x";
        }
    </style>
}


<div class="row" id="Grid">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>

    <input type="hidden" name="GridHtml" id="gridexcel" />

    <div class="body-content" style="overflow-x:hidden">
        <div id="form-group">
            <table class="table" style="font-size:13px;border:1px solid;" id="GetData">
                <thead>
                    <tr style="background-color:lightblue;">
                        <th style="border:1px solid;text-align:center; width:4%;">Sr.No.</th>
                        <th style="border:1px solid;width:20%;text-align:center">@Html.DisplayName("Reminder Type")</th>
                        <th style="border:1px solid;width:4%;text-align:center">@Html.DisplayName("No Of Days")</th>
                        <th style="border:1px solid;width:3%;text-align:center" class="noExl">Edit</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        foreach (var item in List)
                        {
                            <tr>
                                <td style="border:1px solid;text-align:center;">@index</td>
                                <td style="border:1px solid;text-align:center;">@item.REMINDER_TYPE.Replace("_", " ")</td>
                                <td style="border:1px solid;text-align:center;">@item.NO_OF_DAYS</td>
                                <td style="border:1px solid;text-align:center;" class="noExl">
                                    <a href="@Url.Action("Edit", "AutoRemindersNoofDaysMaster", new { id = @item.SRNO })"><i class="glyphicon glyphicon-pencil"></i></a>
                                </td>
                            </tr>
                            index++;
                        }
                        if (List.Count == 0)
                        {
                            <tr>
                                <td colspan="6" style="border:1px solid;text-align:center;">No record found.</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            
            <table class="table table-bordered table-hover table-responsive">
                <tr>
                    <td colspan="9">
                        <a title="Back" href="/home/home">
                            <img src="~/images/icon_back.gif" border="0" alt="">
                            Back
                        </a>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_1"]">
        $(document).ready(function () {
            $('#GetData').DataTable({
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ]
            });
        });
    </script>
    
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_2"]">
        function BtnBack(ths, event) {
            window.location.href = "Search";

        }
    </script>
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $("#BtnCancel").click(function () {
            location.reload(true);

        });
    </script>
   
}