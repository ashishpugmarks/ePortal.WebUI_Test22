@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";
    //Layout = "~/Views/Shared/_Layout.cshtml";

}
@section Styles{
    <style nonce="@Context.Items["StyleNonce_1"]">
        .homeContent {
            padding: 0.52em 0.3em 0.78em !important;
        }

        label {
            font-weight: normal !important;
            font-size: 17px !important;
        }
    </style>
}



<div class="panel panel-primary top-margin-10">
    <div class="panel-heading">
        <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px;">Create Process</h2>
    </div>
    <div class="panel-body">
        <span id="span-attachmentMsg" style="font-weight:600;"></span>
        <div style="margin-top:25px;">

            <div class="row" style="margin:10px; display:flex">
                <div class="col-lg-3 col-sm-3 col-md-3" style="margin:10px;">
                    <label style="padding-bottom:5px">Process Name<span style="color:red;font-weight:bold"> *</span></label>
                    <input type="text" class="form-control" id="txtProcessName" placeholder="Enter Process Name" autocomplete="off" />
                </div>

                <div class="col-lg-3 col-sm-3 col-md-3" style="margin:10px;">
                    <label style="padding-bottom:5px">Status<span style="color:red;font-weight:bold"> *</span></label>

                    <select id="ddlStatusType" class="form-control">
                        <option value="1">Active</option>
                        <option value="2">In-Active</option>
                    </select>
                </div>

            </div>

            <div class="row" style="margin:10px; display:flex">
                @*<div class="col-lg-2" style="margin:10px;">
                        <label style="padding-bottom:5px">To Date</label>
                        @*<input type="date" class="form-control" id="txtToDate" autocomplete="off"  min="{{ DateTime.Today.ToString("yyyy-MM-dd") }}" />
                        <input type="date" class="form-control" id="txtToDate" autocomplete="off" />
                    </div>*@

                <div class="col-xs-1" style="margin:10px;">
                    <button type="submit" id="btnsubmit" class="btn btn-block btn-success" @* onclick="return Save();" *@><i class="menu-icon fa fa-save"></i> &nbsp; Save</button>
                </div>

                <div class="col-xs-1" style="margin:10px;">
                    <button type="submit" id="btnCancel" class="btn btn-block btn-danger" @* onclick="Cancel()" *@><i class="menu-icon fa fa-close"></i> &nbsp; Cancel</button>
                </div>


            </div>

        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_1"]">

        $(document).ready(function () {

            $("#btnsubmit").on("click", function () {
                Save();
            });

            $("#btnCancel").on("click", function () {
                Cancel();
            });
        });

        function Save() {

            var dropdown = document.getElementById("ddlStatusType");
            var status = dropdown.value;
            var statusDescrip = dropdown.options[dropdown.selectedIndex].text;

            var ProcessName = $('#txtProcessName').val();
            var errpar = "";

            if (ProcessName == "") {
                errpar += "ProcessName";
            }

            if (errpar=="") {

                var URL = '/MenuProcessRole/AddProcess/?ProcessName=' + ProcessName + '&status=' + status;

                $.ajax({
                    type: "POST",
                    url: URL,
                    datatype: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data.res == 1) {
                            alert("Data Inserted Successfully");
                            parent.jQuery.fancybox.close();
                        }
                        else if (data.res == 0) {
                            alert("Process Name is already exist");
                        }
                        else {
                            alert("Error: " + data.error);
                        }

                    },
                    error: function (err) {
                        alert("Error: " + err.responseText);
                    }

                });

            }
            else {

                alert("Must fill the data for Field: " + errpar);
            }
            return false;
        }
        function Cancel() {
            parent.jQuery.fancybox.close();
        }
    </script>
}


