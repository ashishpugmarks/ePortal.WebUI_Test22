                display: inline;
            }

            .pagination a, .pagination span {
                position: relative;
                float: left;
                padding: 0.5rem 0.75rem;
                margin-left: -1px;
                line-height: 1.25;
                color: #007bff;
                text-decoration: none;
                background-color: #fff;
                border: 1px solid #ddd;
            }

            .pagination .page-item.disabled span, .pagination .page-item.disabled a {
                color: #6c757d;
                pointer-events: none;
                cursor: auto;
                background-color: #fff;
                border-color: #ddd;
            }

            .pagination .page-item.active span, .pagination .page-item.active a {
                z-index: 2;
                color: #fff;
                background-color: #007bff;
                border-color: #007bff;
            }

            .pagination .page-link {
                display: block;
                padding: 0.5rem -0.25rem;
                margin-bottom: 0;
                font-size: 13px;
                line-height: 1.25;
                color: #007bff;
                background-color: #fff;
                border: 1px solid #ddd;
            }

                .pagination .page-link:hover {
                    z-index: 2;
                    color: #0056b3;
                    text-decoration: none;
                    background-color: #e9ecef;
                    border-color: #ddd;
                }
