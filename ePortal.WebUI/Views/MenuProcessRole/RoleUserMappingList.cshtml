@{
    ViewBag.Title = "RoleUserMappingList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .tableHD {
            padding: 6px 10px;
            text-align: center;
        }

        .tableHDPurpose {
            padding: 6px 10px;
            text-align: center;
            white-space: nowrap;
        }

        .table th i {
            margin-left: 5px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            padding: 5px;
            padding: 5px;
            width: initial;
            line-height: 1.2;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
            border: 1px solid #8ac2de;
            align-content: center;
            font-size: 65% !important;
        }

        .table-bordered {
            border: 1px solid #8ac2de;
        }


        .table > tbody > tr:nth-of-type(even) {
            background: #e9e9e9;
        }

        body {
            font-family: montserrat, arial, verdana;
            background: transparent;
        }

        .Headepanel {
            padding: 0px !important;
            margin: 2px;
        }

        .homeContent div {
            padding: 0px;
        }

        label {
            font-weight: normal !important;
            font-size: 17px !important;
        }

        #tblData tbody td:first-child {
            text-align: center;
        }

        /* Style for the action column */
        #tblData tbody td:last-child {
            text-align: center;
        }

        /* Style for the hidden columns */
        #tblData tbody td.hidden {
            display: none;
        }

        /* Style for the edit button */
        #tblData tbody td:last-child a.btn-primary {
            color: #fff;
            background-color: #428bca;
            border-color: #357ebd;
            padding: 6px 12px;
            margin: 2px;
            font-size: 12px;
            cursor: pointer;
            text-decoration: none;
            border-radius: 3px;
        }

        /* Style for the search input */
        #searchInput {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        /* Style for the date inputs */
        #txtFromDate,
        #txtToDate {
            width: 46%;
            margin-top: -5px;
        }

        /* Style for the search button */
        #btnSearch {
            width: 40px;
            height: 35px;
            margin-left: 15px;
        }


        .panel-bodyHeader {
            border: solid 1px #7ac7f9;
            background-color: #c7e8f3;
            color: black;
            padding: 15px;
            margin-top: -7px;
        }

        .Headepanel {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
        }

        input {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }


        #tblData thead th {
            position: sticky;
            top: 0;
            background-color: inherit; /* Change the background color as needed */
            z-index: 1; /* Ensure the header stays above the content */
        }

        .tblScroll {
