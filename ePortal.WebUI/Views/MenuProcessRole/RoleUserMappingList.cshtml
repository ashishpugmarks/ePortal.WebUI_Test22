<div class="panel-group" style="padding: 0px 8px 0px 8px;">

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Role User Mapping Master</h2>
        </div>

        <div class="panel-body">
            <div class="row" style="margin-top:25px;">
                <div class="col-lg-3" style="margin-left: 17px;display: flex;">
                    <input type="text" class="form-control" placeholder="Search Here.." id="searchInput">
                    <button type="button" class="btn btn-primary" id="btnSearch" @* onclick="Search()" *@ style="margin-left: -6px;">
                        <i class="fa fa-search"></i>
                    </button>

                </div>

                <div class="col-lg-2" style="margin-left: 17px;">
                    <a title="Create Mapping" id="btnAdd" class="btn btn-success" @* onclick="return ADD()" *@><i class="fa fa-plus" aria-hidden="true"></i>&nbsp;Create Mapping</a>
                </div>
            </div>
        </div><br />
        <div class="panel-body">
            <div id="pagination-container" class="text-center">
                <div class="form-group" style="margin-bottom: 0px;">
                    <form id="myform">
                        <div class="table-responsive text-nowrap">
                            <table class="table table-bordered" style="margin-bottom: 0px!important;">
                                <thead>
                                    <tr class="bg-info">
                                        <th class="text-center">Actions <i class="fa fa-sort"></i></th>
                                        <th class="text-center">Role Name<i class="fa fa-sort"></i></th>
                                        <th class="text-center">User Name<i class="fa fa-sort"></i></th>
                                        <th class="text-center">Status<i class="fa fa-sort"></i></th>
                                    </tr>
                                </thead>
                                <tbody id="append_Data">
                                    <tr><th colspan="7" class="text-center">No record found.</th></tr>
                                </tbody>
                            </table>
                        </div>
                    </form>
                </div>
                <ul class="pagination"></ul>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">

        $(document).ready(function () {

            //Function For Sorting//
            $("th").click(function () {
                var table = $(this).parents("table").eq(0)
                var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()))
                this.asc = !this.asc
                if (!this.asc) { rows = rows.reverse() }
                for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
            })
            //Function For Sorting//
            function comparer(index) {
                return function (a, b) {
                    var valA = getCellValue(a, index), valB = getCellValue(b, index)
                    return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
                }
            }
            //Function For Sorting//
            function getCellValue(row, index) {
                return $(row).children("td").eq(index).html()
            }
            $("#btnSearch").click(function () {

                var Searchvalue = $("#searchInput").val().toLowerCase();
                PreLoadData(1, Searchvalue);
            });

            $("#btnAdd").on('click', function() {
                ADD();
            });

            $(document).on('click', '.edit-button', function () {
                var roleId = $(this).data('id');
                Edit(roleId);
            });

            PreLoadData(1, "");

        });


        function PreLoadData(currentPage, value) {
            var recordsPerPage = 30;
            debugger;
            $.ajax({
                async: false,
                type: "GET",
                url: "/MenuProcessRole/GetRoleUserMappingList",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    debugger;
                    if (JSON.parse(data).length != 0) {

                        var Data1 = JSON.parse(data);
                        var startIndex = (currentPage - 1) * recordsPerPage;
                        var endIndex = startIndex + recordsPerPage;

                        var filteredData = Data1.filter(function (item) {
                            //debugger;

                            var valueLowerCase = value ? value.toString().toLowerCase() : "";

                            return (
                                (item.RoleName && item.RoleName.toString().toLowerCase().includes(valueLowerCase)) ||
                                (item.UserName && item.UserName.toString().toLowerCase().includes(valueLowerCase)) ||
                                //(item.Operator && item.Operator.toString().toLowerCase().includes(valueLowerCase)) ||
                                (item.Status && item.Status.toString().toLowerCase().includes(valueLowerCase))
                            );

                        });

                        var currentPageData = filteredData.slice(startIndex, endIndex);
                        $("#append_Data").empty();
                        $.each(currentPageData, function (i, r) {

                            debugger;
                            //$("#append_Data").append('<tr><td>' + EditorFormatter(r.MappingId) + '</td><td><center>' + r.RoleName + '</center></td><td><center>' + r.UserName + '</center></td><td><center>' + r.Status + '</center></td></tr>');
                            $("#append_Data").append(
                                '<tr><td>' +
                                '<center><a title="Edit" class="btn btn-primary btn-xs edit-button" data-id="' + r.MappingId + '">' +
                                '<i class="ace-icon fa fa-edit"></i></a></center></td>' +
                                '<td><center>' + r.RoleName + '</center></td>' +
                                '<td><center>' + r.UserName + '</center></td>' +
                                '<td><center>' + r.Status + '</center></td></tr>'
                            );

                            //$("#append_Data").append('<tr><td><center>' + (i + 1) + '</center></td><td><center>' + r.Title + '</center></td><td><center>' + r.ToolTip + '</center></td><td><center>' + ((r.MenuType == 1) ? "User Level" : "Admin Level") + '</center></td><td><center>' + ((r.Status == 0) ? "Inactive" : "Active") + '</center></td><td><center>' + r.URL + '</center></td><td>' + EditorFormatter(r.MenuId) + '</td></tr>');

                        });
                        updatePagination(currentPage, Math.ceil(filteredData.length / recordsPerPage));
                    }
                    else {
                        $("#append_Data").empty();
                        $("#append_Data").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>")
                    }
                },
                complete: function () {
                },
                error: function () {
                    alert("Oops...", "Something went wrong!");
                }
            });



        }
        function updatePagination(currentPage, totalPages) {
            var container = $('#pagination-container .pagination');

            container.empty();

            for (var i = 1; i <= totalPages; i++) {
                var listItem = $('<li></li>').addClass('page-item').append(
                    $('<a></a>').addClass('page-link').attr({
                        href: 'javascript:void(0);',
                        'data-page': i
                    }).text(i)
                );

                if (i === currentPage) {
                    listItem.addClass('active');
                }

                listItem.on('click', function () {
                    var page = parseInt($(this).find('a').attr('data-page'));
                    PreLoadData(page);
                });

                container.append(listItem);
            }
        }

        function ADD() {
            debugger;
            var URL = '/MenuProcessRole/AddRoleUserMapping';

            $.fancybox.open({

                href: URL,
                type: 'iframe',
                padding: 2,
                maxWidth: 1000,
                maxHeight: 1000,
                fitToView: false,
                width: '800px',
                height: '1000px',
                autoSize: true,
                closeClick: true,
                openEffect: 'elastic',
                openSpeed: 120,
                closeEffect: 'elastic',
                closeSpeed: 100,
                helpers:
                {
                    overlay: { closeClick: false }
                },
                afterClose: function () {

                    //window.location.reload();
                    PreLoadData(1, "");
                }

            });


        }

        /*function EditorFormatter(MenuId) {
            return '<center><a title="Edit"  class="btn btn-primary btn-xs" onclick="Edit(' + MenuId + ');"><i class="ace-icon fa fa-edit"></i></a> </center>';

            //<a title="Delete"   class="btn btn-danger btn-xs" onclick="Delete(' + MenuId + ');"><i class="ace-icon fa fa-trash"></i></a>
        }*/

        function Edit(SrNo) {
            debugger;
            var URL = '/MenuProcessRole/EditRoleUserMapping?id=' + SrNo;

            $.fancybox.open({

                href: URL,
                type: 'iframe',
                padding: 2,
                maxWidth: 1000,
                maxHeight: 1000,
                fitToView: false,
                width: '800px',
                height: '1000px',
                autoSize: true,
                closeClick: true,
                openEffect: 'elastic',
                openSpeed: 120,
                closeEffect: 'elastic',
                closeSpeed: 100,
                helpers:
                {
                    overlay: { closeClick: false }
                },
                afterClose: function () {

                    //window.location.reload();
                    PreLoadData(1, "");
                }

            });


        }

    </script>
}



