@{
    ViewBag.Title = "ProcessList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <style nonce="@Context.Items["StyleNonce_0"]">
        /*table Css*/
        .table > thead > tr > th {
            padding: 6px 10px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            /*padding: 10px;*/
            padding: 5px;
            /*line-height: 1.2;*/
            line-height: 0.7;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
            border: 1px solid #8ac2de;
            align-content: center;
            font-size: 70% !important;
            /*font-size:83% !important;*/
        }

        .table-bordered {
            border: 1px solid #8ac2de;
        }

        .table > tbody > tr > td {
            /*padding: 4px 3px;*/
            /*padding: 0px 3px !important;*/
            padding: 8px 3px !important;
        }

        .table > tbody > tr:nth-of-type(even) {
            background: #e9e9e9;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .validationBackground {
            background-color: #a94442 !important;
            color: white;
        }

        .highlightBackground {
            background-color: #8bb55a !important;
            color: white;
        }
        /*basic reset*/
        * {
            margin: 0;
            padding: 0;
        }

        html {
            height: 100%;
            background: white; /* fallback for old browsers */
            background: -webkit-linear-gradient(to left, #6441A5, #2a0845); /* Chrome 10-25, Safari 5.1-6 */
        }

        body {
            font-family: montserrat, arial, verdana;
            background: transparent;
        }

        /*form styles*/
        #msform {
            text-align: center;
            position: relative;
        }

            #msform fieldset {
                background: white;
                border: 0 none;
                border-radius: 0px;
                box-shadow: 0 0 15px 1px rgba(0, 0, 0, 0.4);
                padding: 8px 0px;
                box-sizing: border-box;
                width: 100%;
                position: relative;
            }

                /*Hide all except first fieldset*/
                #msform fieldset:not(:first-of-type) {
                    display: none;
                }

        /*headings*/
        .fs-title {
            font-size: 18px;
            text-transform: uppercase;
            color: #2C3E50;
            margin-bottom: 10px;
            letter-spacing: 2px;
            font-weight: bold;
        }

        .fs-subtitle {
            font-weight: normal;
            font-size: 13px;
            color: #666;
            margin-bottom: 20px;
        }

        /*progressbar*/
        #progressbar {
            margin-bottom: 20px;
            overflow: hidden;
            /*CSS counters to number the steps*/
            counter-reset: step;
        }

            #progressbar li {
                list-style-type: none;
                color: #6080dc;
                text-transform: uppercase;
                font-size: 9px;
                font-weight: 800;
                /*width: 33.33%;*/
                width: 50%;
                float: left;
                position: relative;
                letter-spacing: 1px;
            }

                #progressbar li:before {
                    content: counter(step);
                    counter-increment: step;
                    width: 40px;
                    height: 24px;
                    line-height: 26px;
                    display: block;
                    font-size: 12px;
                    color: #333;
                    background: #ccc;
                    border-radius: 25px;
                    margin: 0 auto 6px auto;
                }

                /*progressbar connectors*/
                #progressbar li:after {
                    content: '';
                    width: 100%;
                    height: 8px;
                    background: #ccc;
                    position: absolute;
                    left: -50%;
                    top: 8px;
                    z-index: -1; /*put it behind the numbers*/
                }

                #progressbar li:first-child:after {
                    /*connector not needed before the first step*/
                    content: none;
                }

                /*marking active/completed steps green*/
                /*The number of the step and the connector before it = green*/
                #progressbar li.active:before, #progressbar li.active:after {
                    background: #6080dc;
                    color: white;
                }


        /* Not relevant to this form */
        .dme_link {
            margin-top: 30px;
            text-align: center;
        }

            .dme_link a {
                background: #FFF;
                font-weight: bold;
                color: #6080dc;
                border: 0 none;
                border-radius: 25px;
                cursor: pointer;
                padding: 5px 25px;
                font-size: 12px;
            }

                .dme_link a:hover, .dme_link a:focus {
                    background: #C5C5F1;
                    text-decoration: none;
                }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            /*background-image: url('../../assets/images/loading_double.gif');*/
            opacity: .7;
        }

        .panel-heading {
            padding: 8px 15px;
        }

        #pr_div {
            border: 1px solid #ccc;
            padding: 8px; /*15px 0px 15px 0px;*/
            margin-left: 10px;
            border-radius: 5px;
            background-color: #eee;
            overflow: auto;
            min-height: 35px;
            max-height: 92px;
            width: 73.30%;
        }

        .alert-error {
            background-color: antiquewhite;
            margin-left: 15px;
            margin-right: 15px;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .required::after {
            content: "*";
            font-weight: 800;
            color: red;
            margin-left: 5px;
        }

        .ui-widget {
            font-family: Verdana,Arial,sans-serif;
            font-size: 0.6em !important;
            overflow: auto;
            max-height: 150px;
        }

        /*=========For Pagging =================*/

        .pagination {
            display: inline-block;
            padding-left: 0;
            margin: 20px 0;
            border-radius: 0.25rem;
        }

            .pagination li {
                display: inline;
            }

            .pagination a, .pagination span {
                position: relative;
                float: left;
                padding: 0.5rem 0.75rem;
                margin-left: -1px;
                line-height: 1.25;
                color: #007bff;
                text-decoration: none;
                background-color: #fff;
                border: 1px solid #ddd;
            }

            .pagination .page-item.disabled span, .pagination .page-item.disabled a {
                color: #6c757d;
                pointer-events: none;
                cursor: auto;
                background-color: #fff;
                border-color: #ddd;
            }

            .pagination .page-item.active span, .pagination .page-item.active a {
                z-index: 2;
                color: #fff;
                background-color: #007bff;
                border-color: #007bff;
            }

            .pagination .page-link {
                display: block;
                padding: 0.5rem -0.25rem;
                margin-bottom: 0;
                font-size: 13px;
                line-height: 1.25;
                color: #007bff;
                background-color: #fff;
                border: 1px solid #ddd;
            }

                .pagination .page-link:hover {
                    z-index: 2;
                    color: #0056b3;
                    text-decoration: none;
                    background-color: #e9ecef;
                    border-color: #ddd;
                }
    </style>
}



<div class="panel-group" style="padding: 0px 8px 0px 8px;">

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Process Master</h2>
        </div>

        <div class="panel-body">
            <div class="row" style="margin-top:25px;">
                <div class="col-lg-3" style="margin-left: 17px;display: flex;">
                    <input type="text" class="form-control" placeholder="Search Here.." id="searchInput">
                    <button type="button" class="btn btn-primary" id="btnSearch" @* onclick="Search()" *@ style="margin-left: -6px;">
                        <i class="fa fa-search"></i>
                    </button>

                </div>

                <div class="col-lg-2" style="margin-left: 17px;">
                    <a title="Create Process" id="btnAdd" class="btn btn-success" @* onclick="return ADD()" *@><i class="fa fa-plus" aria-hidden="true"></i>&nbsp;Create Process</a>
                </div>
            </div>
        </div><br />
        <div class="panel-body">
            <div id="pagination-container" class="text-center">
                <div class="form-group" style="margin-bottom: 0px;">
                    <form id="myform">
                        <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                            <thead>
                                <tr class="bg-info">
                                    <th class="text-center">Actions <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Process Name<i class="fa fa-sort"></i></th>
                                    <th class="text-center">Status<i class="fa fa-sort"></i></th>
                                </tr>
                            </thead>
                            <tbody id="append_Data">
                                <tr><th colspan="7" class="text-center">No record found.</th></tr>
                            </tbody>
                        </table>
                    </form>
                </div>
                <ul class="pagination"></ul>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">

        $(document).ready(function () {

            $("#btnAdd").on('click', function() {
                ADD();
            });

            // $("#btnSearch").on('click', function() {
            //     Search();
            // });

            //Function For Sorting//
            $("th").click(function () {
                var table = $(this).parents("table").eq(0)
                var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()))
                this.asc = !this.asc
                if (!this.asc) { rows = rows.reverse() }
                for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
            })


            //Function For Sorting//
            function comparer(index) {
                return function (a, b) {
                    var valA = getCellValue(a, index), valB = getCellValue(b, index)
                    return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
                }
            }

            //Function For Sorting//
            function getCellValue(row, index) {
                return $(row).children("td").eq(index).html()
            }
            $("#btnSearch").click(function () {

                var Searchvalue = $("#searchInput").val().toLowerCase();
                PreLoadData(1, Searchvalue);
            });

            $(document).on('click', '.edit-button', function () {
                var processId = $(this).data('id');
                Edit(processId);
            });

            PreLoadData(1,"");

        });

        function PreLoadData(currentPage, value) {
            var recordsPerPage = 30;

            $.ajax({
                async: false,
                type: "GET",
                url: "/MenuProcessRole/GetProcessList",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    //debugger;
                    if (JSON.parse(data).length != 0) {

                        var Data1 = JSON.parse(data);
                        var startIndex = (currentPage - 1) * recordsPerPage;
                        var endIndex = startIndex + recordsPerPage;

                        var filteredData = Data1.filter(function (item) {
                            //debugger;

                            var valueLowerCase = value ? value.toString().toLowerCase() : "";

                            return (
                                (item.PROCESS_ID && item.PROCESS_ID.toString().toLowerCase().includes(valueLowerCase)) ||
                                (item.PROCESS_NAME && item.PROCESS_NAME.toString().toLowerCase().includes(valueLowerCase)) ||
                                (item.Status && item.Status.toString().toLowerCase().includes(valueLowerCase))
                            );

                        });

                        var currentPageData = filteredData.slice(startIndex, endIndex);

                        $("#append_Data").empty();
                        $.each(currentPageData, function (i, r) {

                            //$("#append_Data").append('<tr><td>' + EditorFormatter(r.PROCESS_ID) + '</td><td><center>' + r.PROCESS_NAME + '</center></td><td><center>' + r.Status1 + '</center></td></tr>');
                            $("#append_Data").append(
                                '<tr><td>' +
                                '<center><a title="Edit" class="btn btn-primary btn-xs edit-button" data-id="' + r.PROCESS_ID + '">' +
                                '<i class="ace-icon fa fa-edit"></i></a></center></td>' +
                                '<td><center>' + r.PROCESS_NAME + '</center></td>' +
                                '<td><center>' + r.Status1 + '</center></td></tr>'
                            );

                            //$("#append_Data").append('<tr><td><center>' + (i + 1) + '</center></td><td><center>' + r.Title + '</center></td><td><center>' + r.ToolTip + '</center></td><td><center>' + ((r.MenuType == 1) ? "User Level" : "Admin Level") + '</center></td><td><center>' + ((r.Status == 0) ? "Inactive" : "Active") + '</center></td><td><center>' + r.URL + '</center></td><td>' + EditorFormatter(r.MenuId) + '</td></tr>');

                        });
                        updatePagination(currentPage, Math.ceil(filteredData.length / recordsPerPage));
                    }
                    else {
                        $("#append_Data").empty();
                        $("#append_Data").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>")
                    }
                },
                complete: function () {
                },
                error: function () {
                    alert("Oops...", "Something went wrong!");
                }
            });

        }

        function updatePagination(currentPage, totalPages) {
            var container = $('#pagination-container .pagination');

            container.empty();

            for (var i = 1; i <= totalPages; i++) {
                var listItem = $('<li></li>').addClass('page-item').append(
                    $('<a></a>').addClass('page-link').attr({
                        href: 'javascript:void(0);',
                        'data-page': i
                    }).text(i)
                );

                if (i === currentPage) {
                    listItem.addClass('active');
                }

                listItem.on('click', function () {
                    var page = parseInt($(this).find('a').attr('data-page'));
                    PreLoadData(page);
                });

                container.append(listItem);
            }
        }

         function ADD() {
             debugger;
             var URL = '/MenuProcessRole/AddProcess';

                $.fancybox.open({

                    href: URL,
                    type: 'iframe',
                    padding: 2,
                    maxWidth:1000,
                    maxHeight: 1000,
                    fitToView: false,
                    width: '1000px',
                    height: '900px',
                    autoSize: true,
                    closeClick: true,
                    openEffect: 'elastic',
                    openSpeed: 120,
                    closeEffect: 'elastic',
                    closeSpeed: 100,
                    helpers:
                    {
                        overlay: { closeClick: false }
                    },
                    afterClose: function () {

                        //window.location.reload();
                        PreLoadData(1,"");
                    }

                });

         }

         debugger;
         /*function EditorFormatter(PROCESS_ID)
         {
             return '<center><a title="Edit"  class="btn btn-primary btn-xs" onclick="Edit(' + PROCESS_ID + ');"><i class="ace-icon fa fa-edit"></i></a> </center>';

         }*/

         function Edit(PROCESS_ID) {

             debugger;
             var URL = '/MenuProcessRole/EditProcess?PROCESS_ID=' + PROCESS_ID;

             $.fancybox.open({

                 href: URL,
                 type: 'iframe',
                 padding: 2,
                 maxWidth: 1000,
                 maxHeight: 1000,
                 fitToView: false,
                 width: '1000px',
                 height: '900px',
                 autoSize: true,
                 closeClick: true,
                 openEffect: 'elastic',
                 openSpeed: 120,
                 closeEffect: 'elastic',
                 closeSpeed: 100,
                 helpers:
                 {
                     overlay: { closeClick: false }
                 },
                 afterClose: function () {

                     //window.location.reload();
                     PreLoadData(1,"");
                 }

             });

         }

         function Delete(SrNo) {

             var URL = '/LocalConveyance/LC_ZTABLEDelete/?id=' + SrNo;

             $.ajax({
                             type: "POST",
                             url: URL,
                             datatype: "json",
                             contentType: false,
                             processData: false,
                             success: function (data) {
                                 if (data == true)
                                 {
                                     alert("Record Delete Sucessfully.");
                                 }
                                 window.location.reload();
                             },
                             error: function () {
                                 $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                                 $("#btnUpload").attr("disabled", false);
                             }
                         });

         }

         function parseJsonDate(jsonDateString) {

             const dateString = jsonDateString;
             const dateNumber = dateString.match(/\d+/)[0];
             const date = new Date(+dateNumber);
             const options = {
                 month: 'short',
                 day: 'numeric',
                 year: 'numeric'
             };
             const formattedDate = date.toLocaleDateString('en-IN', options);
             return formattedDate;
         }


    </script>
}
