}


<div class="panel panel-primary top-margin-10">
    <div class="panel-heading">
        <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Create Menu Mapping</h2>
    </div>
    <div class="panel-body">
        <div style="margin-top:25px;">
            <div class="row" style="margin:10px; display:flex">
                <div class="col-md-4 col-sm-4 col-lg-4" style="margin-left:10px;margin-right:10px">
                    <label>Menu Name<span style="color:red"> *</span></label>
                    <input type="hidden" id="selectedMenuID" name="selectedMenuID">
                    <input class="form-control" type="text" id="txtMenuName" />
                </div>
                <div class="col-md-4 col-sm-4 col-lg-4" style="margin-left:10px;margin-right:10px">
                    <label>Operator</label>
                    <select id="ddlOperator" class="form-control">
                        <option value="1">Equal</option>
                        <option value="0">Not Equal</option>
                    </select>
                </div>
                <div class="col-md-4 col-sm-4 col-lg-4" style="margin-left:10px;margin-right:10px">
                    <label>Status<span style="color:red"> *</span></label>
                    <select id="ddlStatus" class="form-control">
                        <option value="1">Active</option>
                        <option value="0">InActive</option>
                    </select>
                </div>
            </div>

            <div class="row" style="margin:10px; display:flex">
                <div class="col-md-5 col-sm-5 col-lg-5" style="margin-left:10px;margin-right:10px">
                    <label>Mapping Based on<span style="color:red"> *</span></label>
                    @Html.DropDownList("ddlmappingbased", new SelectList(ViewBag.DropDownList, "value", "text"), new { @class = "form-control" })
                </div>
                <div class="col-md-6 col-sm-6 col-lg-6" style="margin-left:10px;margin-right:10px">
                    <label id="selmappingfield"></label><span style="color:red"> *</span>
                    <input type="hidden" id="selectedValID" name="selectedValID">
                    <input class="form-control" type="text" id="txtselectVal" />
                </div>
                <div class="col-md-2 col-sm-2 col-lg-2" style="margin-left:10px;margin-right:10px">
                    <button class="form-control btn btn-success" id="btnAdd" @* onclick="Add()" *@ style="margin-top:20px">Add</button>
                </div>
            </div>

            <div class="row" style="margin:20px; display:flex">
                <div class="form-group col-lg-12 col-md-12 col-sm-12" style="margin-bottom: 0px;">
                    <form id="myform">
                        <table class="table table-bordered" id="myrecord" style="font-size:20px">
                            <thead>
                                <tr>
                                    <th>ID <i class="fa fa-sort"></i></th>
                                    <th class="text-center">Description<i class="fa fa-sort"></i></th>
                                    <th class="text-center">Delete<i class="fa fa-sort"></i></th>
                                </tr>
                            </thead>

                            <tbody id="append_Data">
                                @*<tr><th colspan="7" class="text-center">No record found.</th></tr>*@
                            </tbody>
                        </table>
                    </form>
                </div>
            </div>

            <ul class="pagination"></ul>

            <div class="row" style="margin:10px; display:flex">

                <div class="col-lg-2 col-md-2 col-sm-2" style="margin:10px;">
                    <button type="submit" id="btnsubmit" class="btn btn-block btn-success" @* onclick="return Save();" *@><i class="menu-icon fa fa-save"></i> &nbsp; Save</button>
                </div>

                <div class="col-lg-2 col-md-2 col-sm-2" style="margin:10px;">
                    <button type="button" id="btnCancel" class="btn btn-block btn-danger" @* onclick="Cancel()" *@><i class="menu-icon fa fa-close"></i> &nbsp; Cancel</button>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    @* <script src="~/js/jquery.3.6.3.min.js"></script> *@
    <script src="~/js/jquery-ui.js"></script>
    
    <!-- jQuery UI -->
    @* <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script> *@

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_1"]">

        $(document).ready(function () {

            $(document).on('click', '.delete-row', function () {

                $(this).closest('tr').remove();

            });

            $("#btnAdd").on('click', function() {
                Add();
            });

            $("#btnsubmit").on('click', function() {
                Save();
            });

            $("#btnCancel").on('click', function() {
                Cancel();
            });

            const searchTermInput = $("#txtMenuName");
            AutocompleteForMenu(searchTermInput);
            const searchTermInput1 = $("#txtselectVal");
            const TypeId = $("#ddlmappingbased");
            AutocompleteForSelectVal(searchTermInput1, TypeId);
            getdropdownvalue();

            $("#ddlmappingbased").on('change', function () {
                getdropdownvalue();
            });



        });

        function getdropdownvalue() {

            var value = "Select " + $("#ddlmappingbased option:selected").text();
            document.getElementById("selmappingfield").innerHTML = value;
            //document.getElementById("selMenu").innerHTML = value;
        }

        function Add() {
            var ID = $("#selectedValID").val();
            var Descrip = $("#txtselectVal").val();

            $("#append_Data").append('<tr><td><center>' + ID + ' </center></td><td><center>' + Descrip + '</center></td><td><center><a href="#" class="delete-button delete-row" ><i class="fa fa-trash-o"></i></a></center></td></tr>');
        }

        function Save() {

            var MenuId = $('#selectedMenuID').val();
            var Operator = $('#ddlOperator').val();
            var Status = $('#ddlStatus').val();
            var MenuParamId = $('#ddlmappingbased').val();
            var mapingbased = $('#selmappingfield').text();
            var Id = "";
            $('#myrecord tbody tr').each(function () {

                if (Id == "") {
                    Id = $(this).find('td:first').text().trim();
                }
                else {

                    Id += "," + $(this).find('td:first').text().trim();
                }

            });

            debugger;
            var errpar = "";

            if (MenuId == "") {
                errpar = "MenuName, ";
            }
            if (Id == "") {
                errpar +=mapingbased;
            }

            if (errpar == "") {

                var URL = '/MenuProcessRole/AddMapping/?MenuId=' + MenuId + '&Operator=' + Operator + '&Status=' + Status + '&Id=' + Id + '&MenuParamId=' + MenuParamId;

                $.ajax({
                    type: "POST",
                    url: URL,
                    datatype: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data.res == 1) {
                            alert("Data Inserted Successfully");
                            parent.jQuery.fancybox.close();
                        }
                        else if (data.res == 0) {
                            alert("Meapping Id is already exist");
                        }
                        else {
                            alert("Error: " + data.error);
                        }


                    },
                    error: function (err) {
                        alert("Error: " + err.responseText);
                    }

                });

            }
            else {
                alert("Must fill the data for Field: " + errpar);

            }
            return false;
        }
        function Cancel() {
            parent.jQuery.fancybox.close();
        }
   
        function AutocompleteForMenu(ID) {
            //alert(ID.val());
            ID.autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/MenuProcessRole/AutocompleteMenuName",
                        data: { term: request.term },
                        dataType: "json",
                        method: "GET",
                        success: function (data) {
                            debugger;
                            if (data && data.length > 0) {
                                const suggestions = data.map(function (suggestion) {
                                    return {
                                        label: suggestion.MenuName,
                                        value: suggestion.MenuID,
                                    };
                                });
                                response(suggestions.slice(0, 15));
                            } else {
                                response([]);
                            }
                        },
                        error: function (error) {
                            console.error("Error fetching autocomplete suggestions:", error);
                            response([]);
                        },
                    });
                },
                minLength: 1,
                maxShowItems: 5,
                select: function (event, ui) {
                    $("#txtMenuName").val(ui.item.label);
                    $("#selectedMenuID").val(ui.item.value);
                    return false;
                },
            });

        }


        function AutocompleteForSelectVal(ID, TYPEID) {
            ID.autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/MenuProcessRole/GetSuggesionValue",
                        data: { term: request.term, ParamType: TYPEID.val() },
                        dataType: "json",
                        method: "GET",
                        success: function (data) {
                            debugger;
                            if (data && data.length > 0) {
                                const suggestions = data.map(function (suggestion) {
                                    return {
                                        label: suggestion.text,
                                        value: suggestion.value,
                                    };
                                });
                                response(suggestions.slice(0, 15));
                                console.log("Suggestions:", data);
                            } else {
                                response([]);
                            }
                        },
                        error: function (error) {
                            console.error("Error fetching autocomplete suggestions:", error);
                            response([]);
                        },
                    });
                },
                minLength: 1,
                maxShowItems: 5,
                select: function (event, ui) {


                    $("#txtselectVal").val(ui.item.label);
                    $("#selectedValID").val(ui.item.value);
                    return false;
                },
            });
        }
    </script>

}

