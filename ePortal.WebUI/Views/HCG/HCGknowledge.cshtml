    @* <table id="summaryTable" class="table table-bordered table-hover table-responsive" cellpadding="0" cellspacing="0" style="width: 97%;"> *@
        <table id="summaryTable" class="table table-bordered table-condensed" style="width:100%;padding:5px;">
        <thead>
            <tr class="grdHeader" style="height:25px;">              
                <th style="width:8%;">&nbsp;S.No.</th>
                <th style="width:50%;" class="text-left">&nbsp;Series</th>
                <th style="width:20%;" class="text-left">&nbsp;Release Date</th>
            </tr>
        </thead>
        <tbody>
         @if (Model.HcgItems != null && Model.HcgItems.Count > 0)
        {
            @foreach (var entry in Model.HcgItems
               .Where(x => x.HcgType == 1)
            .Select((item, index) => new { item, index }))
            {
                    <tr class="grdrow" style="height:20px;">                        
                        <td class="text-center">
                            <span style="padding:8px;">@(entry.index + 1)</span>
                        </td>
                    <td>                                                  
                            <a href="#" class="open-window" data-url="@Url.Content($"../../Uploads/HCGknowledge/" + Convert.ToString(entry.item.Attachment))" data-type="DT" data-width="900" data-height="600">
                                @entry.item.Series
                            </a>
                    </td>                   
                    <td>
                            <span style="padding:8px;">
                        @(string.IsNullOrEmpty(entry.item.ReleaseDate)
                            ? ""
                            : DateTime.Parse(entry.item.ReleaseDate).ToString("dd MMM yyyy"))
                       
                        </span>
                        </td>
                </tr>
            }
            }
            else
            {
                <tr style="height:20px;background-color:#F5FFF0;">
                    <td colspan="3" style="font-family:Calibri;color:#274D14;">No records found.</td>
                </tr>
            }
        </tbody>
    </table>
