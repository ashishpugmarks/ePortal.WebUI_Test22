@model ePortal.ViewModels.ICREQHEADER

@{
    Layout = null;
}
<!doctype html>
<html>
<head>
<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .validationError {
            border: 1px solid #a94442;
        }
    </style>
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
        $(document).ready(function () {

        });

        function SaveData() {
            var isFormVaildation = CheckFormValidation();
            if (isFormVaildation) {
                $("#btnSave").attr("disabled", true);
                var data = {
                    ICREQID: $('#hficreqId').val(),
                    AUCCODE: $('#txtauccode').val(),
                    AUCCODEREMARK: $('#txtRemark').val(),
                }
                $('#myCreateModel').modal('hide');
                $.ajax({
                    type: "POST",
                    url: "/ICIBM/UpdateAUC",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: JSON.stringify(data),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                       
                        if (data.RESULT == 1) {
                            swal({
                                title: "",
                                text: "Record saved successfully.",
                                type: "success",
                            }, function (isConfirm) {
                                if (isConfirm) {
                                    $("#btnSubmit").click();
                                    //window.location.href = "/PR/PRReport";
                                }
                            });
                        }
                        else if (data.RESULT == -2) {
                            swal({
                                title: "",
                                text: "Record saved successfully, But mail not sent.",
                                type: "success",
                            }, function (isConfirm) {
                                if (isConfirm) {
                                    $("#btnSubmit").click();
                                }
                            });
                        }
                        else {
                            sweetAlert("", "Record not saved.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function CheckFormValidation() {
            var isVailed = true;
            $('#ddPrStatus').removeClass('validationError');
            if ($('#ddPrStatus').val() == "") {
                $('#ddPrStatus').addClass('validationError');
                isVailed = false;
            }
            $("#txtPrRemark").removeClass('validationError');
            if ($('#txtPrRemark').val() == "") {
                $("#txtPrRemark").addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }
    </script>
<script nonce="@Context.Items["ScriptNonce_9"]">
    $(document).ready(function () {
        $("#btnSave").on('click', function () {
            SaveData();
        });
    });
</script>
</head>

<body>
    <div class="body-content" style="padding:0px !important;">
        <div>
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group">
                    @Html.LabelFor(model=>model.ICTITLE, htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.DisplayFor(model => model.ICTITLE, new { @class = "form-control" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.HiddenFor(model => model.ICREQID, htmlAttributes: new { @id = "hficreqId" })
                    @Html.LabelFor(model => model.AUCCODE, htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.TextBoxFor(model => model.AUCCODE, new { @class = "form-control", @id = "txtauccode" })
                        @Html.ValidationMessageFor(model => model.AUCCODE, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.AUCCODEREMARK, htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.AUCCODEREMARK, new { @class = "form-control", @id = "txtRemark", @style = "max-width:354px; min-height:110px;" })
                        @Html.ValidationMessageFor(model => model.AUCCODEREMARK, "", new { @class = "text-danger" })
                    </div>
                </div>

                 <div class="form-group">
                    <div class="col-md-offset-4 col-md-8">
                        <input type="button" value="Save" class="btn btn-success" id="btnSave" />
                        <button type="button" class="btn btn-default" data-dismiss="modal" aria-label="Close">Cancel</button>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div id="ajaxLoader"></div>

</body>
</html>
