@using Microsoft.AspNetCore.Http
@model ePortal.ViewModels.ICREQHEADER
@{
    ViewBag.Title = "IC Approval";
    Layout = null;
    string _path = "../../../Uploads/ICIBM/";
    var loginUser = Context.Session.GetString("userID") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userID").ToString());    
}
<head>
    <style type="text/css" media="print" nonce="@Context.Items["StyleNonce_0"]">
             * {
                 -webkit-print-color-adjust: exact !important; /* Chrome, Safari 6 – 15.3, Edge
        */
                 color-adjust: exact !important; /* Firefox 48 – 96
        */
                 print-color-adjust: exact !important; /* Firefox 97+, Safari 15.4+
        */
             }
    </style>
    <script nonce="@Context.Items["ScriptNonce_0"]">
        function disablerow() {
            debugger;

            var docTr = document.getElementsByClassName("tr-checkbox");
            if (docTr.length > 0) {
                for (var i = 0; i < docTr.length; i += 1) {
                    var row = docTr[i];
                    if (row != undefined) {
                        if (row.checked) {
                            var row_id = (row).value;
                            document.getElementById("tr_"+row_id).style.display = "none";
                        }
                        
                    }
                }
            }
            for (const e of document.getElementsByClassName("hide1")) {
                e.style.display = 'none'
            }
            window.print();
        }


    </script>
<script nonce="@Context.Items["ScriptNonce_1"]">
    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById("btn-print").onclick = function (e) {
            e.preventDefault();
            disablerow();
        }
    });
</script>
</head>
<body>
    <table style="border:1px #91b4ff solid;width:100%;" >
        <tr>
            <th colspan="2" style="text-align:left;background-color:#91b4ff;padding:2px;">IC Detail</th>
        </tr>
        <tr>
            <td width="50%" style="vertical-align:top;">
                <table style="border:1px #91b4ff solid;width:100%;">
                    <tr>
                        <td style="vertical-align:top;">
                            <table style="font-size:15px;border:1px #91b4ff solid;width:100%;">
                                <tr style="background: #e9e9e9;">
                                    <th style="padding:5px;">
                                        @Html.LabelFor(model => model.ICTITLE, htmlAttributes: new { @class = "control-label required" })
                                    </th>
                                    <td style="padding:5px;">
                                        @Html.HiddenFor(model => model.ICREQID, new { @id = "hfICHeaderId" })
                                        @Html.DisplayFor(model => model.ICTITLE, new { @class = "control-label" })
                                    </td>
                                </tr>
                                <tr>
                                    <th style="padding:5px;">
                                        @Html.LabelFor(model => model.DEPARTMENT, htmlAttributes: new { @class = "control-label required" })
                                    </th>
                                    <td style="padding:5px;">
                                        @Html.DisplayFor(model => model.DEPARTMENT, new { @class = "control-label" })
                                    </td>
                                </tr>
                                <tr style="background: #e9e9e9;">
                                    <th style="padding:5px;">
                                        @Html.LabelFor(model => model.ICBACKGROUND, htmlAttributes: new { @class = "control-label required" })
                                    </th>
                                    <td style="padding:5px;">
                                        @Html.DisplayFor(model => model.ICBACKGROUND, new { @class = "control-label" })
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align:top;">
                            <table style="border:1px #91b4ff solid;width:100%;font-size:15px;">
                                <tbody style="text-align:left;padding:5px;  ">
                                    <tr>
                                        @*style="background-color: #d9edf7!important;"*@
                                        <th style="background-color: #d9edf7!important;" colspan="2">A00 Details</th>
                                    </tr>
                                    <tr>
                                        <th style="width:20%;">
                                            @Html.LabelFor(model => model.ICA00, htmlAttributes: new { @class = "control-label" })
                                        </th>
                                        <td>
                                            @Html.DisplayFor(model => model.ICA00, new { @class = "control-label" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="width:20%;background: #e9e9e9;">
                                            @Html.LabelFor(model => model.ICPURPOSE, htmlAttributes: new { @class = "control-label" })
                                        </th>
                                        <td style="background: #e9e9e9;">
                                            <span style="white-space: pre-line">@Model.ICPURPOSE</span>
                                            @*@Html.DisplayFor(model => model.ICA00, new { @class = "control-label" })*@
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="width:20%;">
                                            @Html.LabelFor(model => model.REQUIREMENT, htmlAttributes: new { @class = "control-label" })
                                        </th>
                                        <td>
                                            <span style="white-space: pre-line">@Model.REQUIREMENT</span>
                                            @*@Html.DisplayFor(model => model.REQUIREMENT, new { @class = "control-label" })*@
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="width:20%;">
                                            @Html.LabelFor(model => model.TARGET, htmlAttributes: new { @class = "control-label" })
                                        </th>
                                        <td>
                                            <span style="white-space: pre-line">@Model.TARGET</span>
                                            @*@Html.DisplayFor(model => model.TARGET, new { @class = "control-label" })*@
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align:top;">
                            <table style="border:1px #91b4ff solid;height:3em;width:100%;font-size:15px;">
                                <tbody style="text-align:left;">
                                    <tr>
                                        <th style="width:40%; background-color:#e9e9e9;margin-right:5px;">
                                            @Html.LabelFor(model => model.CONTENTOFEXE, htmlAttributes: new { })
                                        </th>
                                        <td style="background-color:white;">
                                            @Html.DisplayFor(model => model.CONTENTOFEXE, new { })
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <table style="border:1px #91b4ff solid;width:100%;font-size:15px;">
                                <tbody>
                                    <tr>
                                        <th style="width:30%;padding:5px;background-color:#e9e9e9;">
                                            @Html.LabelFor(model => model.PAYBACK_PERIOD, htmlAttributes: new { @class = "control-label required" })
                                        </th>
                                        <td style="background-color:white; width:20%">
                                            @Html.DisplayFor(model => model.PAYBACK_PERIOD, new { @class = "control-label" })
                                        </td>
                                        <th style="width:30%;padding:5px;background-color:#e9e9e9;">
                                            @Html.LabelFor(model => model.COSTSAVING, htmlAttributes: new { @class = "control-label required" })
                                        </th>
                                        <td style="background-color:white;">
                                            @Html.DisplayFor(model => model.COSTSAVING, new { @class = "control-label" })
                                        </td>
                                    </tr>
                                    
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <table  width="100%" style="border:1px #91b4ff solid;border-bottom: 0px;font-size:15px;">
                                <tr>
                                    <th style="text-align:left;background-color:#337ab7;color:white;padding:2px;">Schedule With Milestone</th>
                                </tr>
                                <tbody>
                                    <tr>
                                        <td>
                                            <table cellspacing="0" border="1" style="margin-bottom: 0px;width:100%;border:1px #91b4ff solid;border-top: 0px;font-size:15px;">
                                                <thead>
                                                    <tr style="background-color:#d9edf7;">
                                                        <th>SNo.</th>
                                                        <th>Target</th>
                                                        <th colspan="2" style="width:35%;">Schedule</th>
                                                    </tr>
                                                </thead>
                                                <tbody style="text-align:center;">
                                                    @{
                                                    if (Model.ICREQ_SCHEDULE != null && Model.ICREQ_SCHEDULE.Count() > 0)
                                                    {
                                                    int rowno = 0;
                                                    foreach (var obj in Model.ICREQ_SCHEDULE)
                                                    {
                                                    rowno = rowno + 1;
                                                    <tr>
                                                        <td>@rowno</td>
                                                        <td>@obj.TARGET</td>
                                                        <td colspan="2" style="width:35%;">@obj.SCHEDULE.ToString("MMM-yyyy")</td>
                                                    </tr>
                                                    }
                                                    }
                                                    else
                                                    {
                                                    <tr><th colspan="4" class="text-center">No record found.</th></tr>
                                                    }
                                                    }
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
            <td width="50%" style="vertical-align:top;">
                <table style="width:100%;height:9em;border:1px #91b4ff solid;font-size:15px;">
                    <tr>
                        <td style="vertical-align:top;">
                            <table cellspacing="0" border="1" style="width:100%;height:9em;border: #91b4ff;font-size:15px;">
                                <tbody style="text-align:left;border:1px #91b4ff solid;">
                                    <tr style="background-color: #d9edf7!important;border:1px #91b4ff solid!important;">
                                        <th colspan="4">Budget Detail</th>
                                        <th>
                                            @Html.LabelFor(model => model.BASIC_BUDGET, htmlAttributes: new { @class = "control-label required" })
                                        </th>
                                        <th>
                                            @Html.LabelFor(model => model.BASIC_PROPOSED, htmlAttributes: new { @class = "control-label required" })
                                        </th>
                                    </tr>
                                    @*// BASIC*@
                                    <tr style="border:1px #91b4ff solid!important;">
                                        <th colspan="4">Basic</th>
                                        <td style="border:1px #91b4ff solid;">
                                            @Html.DisplayFor(model => model.BASIC_BUDGET, new { @class = "control-label" })
                                        </td>

                                        <td style="border:1px #91b4ff solid;">
                                            @Html.DisplayFor(model => model.BASIC_PROPOSED, new { @class = "control-label" })
                                        </td>
                                    </tr>

                                    @*// TAX*@
                                    <tr style="background-color:white;">
                                        <th colspan="4">Tax</th>
                                        <td sstyle="border:1px #91b4ff solid;">
                                            @Html.DisplayFor(model => model.TAX_BUDGET, new { @class = "control-label" })
                                        </td>
                                        <td>
                                            @Html.DisplayFor(model => model.TAX_PROPOSED, new { @class = "control-label" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th colspan="3">
                                            @Html.LabelFor(model => model.IMPORT_LOCAL, htmlAttributes: new { @class = "control-label required" })
                                        </th>
                                        <td>
                                            @{string StrImport = Model.IMPORT_LOCAL == 1 ? "Import" : Model.IMPORT_LOCAL == 2 ? "Local" : ""; }
                                            <span>@StrImport</span>
                                        </td>
                                        <th>
                                            @Html.LabelFor(model => model.TAX_CREDIT_AVAIL, htmlAttributes: new { @class = "control-label required" })
                                        </th>
                                        <td>
                                            @{string StrTax = Model.TAX_CREDIT_AVAIL == 1 ? "Yes" : Model.IMPORT_LOCAL == 2 ? "No" : ""; }
                                            <span>@StrTax</span>
                                        </td>
                                    </tr>
                                    @{
                                        var ISrenovation = Model.INVEST_EFFECT.Contains("5");
                                        if (ISrenovation)
                                        {
                                            <tr>
                                                <th colspan="2" style="width:30%;padding:5px;background-color:#e9e9e9;">
                                                    @Html.LabelFor(model => model.GAVAMT, htmlAttributes: new { @class = "control-label" })
                                                </th>
                                                <td style="background-color:white; width:20%">
                                                    @Html.DisplayFor(model => model.GAVAMT, new { @class = "control-label" })
                                                </td>
                                                <th colspan="2" style="width:30%;padding:5px;background-color:#e9e9e9;">
                                                    @Html.LabelFor(model => model.SRVAMT, htmlAttributes: new { @class = "control-label" })
                                                </th>
                                                <td style="background-color:white; width:20%">
                                                    @Html.DisplayFor(model => model.SRVAMT, new { @class = "control-label" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <th colspan="2" style="width:30%;padding:5px;background-color:#e9e9e9;">
                                                    @Html.LabelFor(model => model.NAVAMT, htmlAttributes: new { @class = "control-label" })
                                                </th>
                                                <td style="background-color:white; width:20%">
                                                    @Html.DisplayFor(model => model.NAVAMT, new { @class = "control-label" })
                                                </td>
                                                <th colspan="2" style="width:30%;padding:5px;background-color:#e9e9e9;">
                                                    @Html.LabelFor(model => model.NPLAMT, htmlAttributes: new { @class = "control-label required" })
                                                </th>
                                                <td style="background-color:white; width:20%">
                                                    @Html.DisplayFor(model => model.NPLAMT, new { @class = "control-label" })
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <table width="100%" style="font-size:15px;border:1px #91b4ff solid;height:4em;">
                                <tr>
                                    <th style="background-color: #d9edf7!important;">Investment Effect Forecast (Tick Appropriate Box)</th>
                                </tr>
                                <tr>
                                    <td>
                                        <table width="100%">
                                            @foreach (var names in @Model.ICINVEST_EFFECT)
                                            {
                                            Console.WriteLine(names);
                                            var checkBoxId = "chk" + names.Value;
                                            var tdId = "td" + names.Value;
                                            string[] inveffarr = Model.INVEST_EFFECT.Split(',');
                                            string check = "";
                                            if (inveffarr.Contains(names.Value))
                                            {
                                            <tr class="tr_chk">
                                                <td width="20%" style="text-align:left;">
                                                    &nbsp;<input type="checkbox" id="@checkBoxId" value="@names.Value" checked disabled="disabled" />
                                                </td>
                                                <td id="@tdId" width="60%" style="text-align:left;">
                                                    @names.Text
                                                </td>
                                            </tr> }
                                            else
                                            {
                                            check = "false";
                                            }


                                            }
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <table  width="100%" style="border:1px #91b4ff solid;font-size:15px;">
                                <th style="background-color:#91b4ff;text-align:left;padding:2px;">Approval History</th>
                                <tr>
                                    <td>
                                        <table cellspacing="0" border="1" style="margin-bottom: 0px;border:1px #91b4ff solid;font-size:10px;" width="100%">
                                            <thead>
                                                <tr style="background-color:#d9edf7;">
                                                    <th class="hide1">
                                                        Hide
                                                    </th>
                                                    <th>
                                                        @Html.DisplayNameFor(model => model.ICAPPHISTORY[0].ICAPPHISTORY_ID)
                                                    </th>
                                                    <th>
                                                        @Html.DisplayNameFor(model => model.ICAPPHISTORY[0].APPEMP_NAME)
                                                    </th>
                                                    <th class="text-left">
                                                        @Html.DisplayNameFor(model => model.ICAPPHISTORY[0].APP_HEADER)
                                                    </th>
                                                    <th>
                                                        @Html.DisplayNameFor(model => model.ICAPPHISTORY[0].APPROVAL_STATUS)
                                                    </th>
                                                    <th>
                                                        @Html.DisplayNameFor(model => model.ICAPPHISTORY[0].APP_DATE)
                                                    </th>
                                                    <th>
                                                        @Html.DisplayNameFor(model => model.ICAPPHISTORY[0].APPROVAL_REMARK)
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody style="text-align:center">
                                                @{ int row_No = 0; }
                                                @if (Model.ICAPPHISTORY != null)
                                                {
                                                foreach (var item in Model.ICAPPHISTORY)
                                                {
                                                <tr id="tr_@row_No">
                                                    <td class="hide1">
                                                        <input class="tr-checkbox" value="@row_No" type="checkbox"  />
                                                    </td>
                                                    <td>
                                                        @(row_No += 1)
                                                        @Html.HiddenFor(modelItem => item.ICAPPHISTORY_ID)
                                                    </td>
                                                    <td style="padding-left: 5px;">
                                                        @Html.HiddenFor(modelItem => item.ICREQID)
                                                        @Html.DisplayFor(modelItem => item.APPEMP_NAME)
                                                    </td>
                                                    <td class="text-left" style="padding-left: 10px;">
                                                        @{
                                                            if (item.APP_TYPE == 1)
                                                            {
                                                                <span>User Management Approval </span>
                                                            }
                                                            else if (item.APP_TYPE == 3)
                                                            {
                                                                <span>Finance Approval </span>
                                                            }
                                                            else if (item.APP_TYPE == 2)
                                                            {
                                                                <span>@item.APP_HEADER</span>
                                                            }
                                                        }
                                                    </td>
                                                    <td style="padding-left: 5px;">
                                                        @{
                                                        string _msg = "";
                                                        if (item.APPROVAL_STATUS == 1)
                                                        {
                                                        _msg = "Approved";
                                                        }
                                                        else if (item.APPROVAL_STATUS == 2)
                                                        {
                                                        _msg = "Send back";
                                                        }
                                                        else if (item.APPROVAL_STATUS == 3)
                                                        {
                                                        _msg = "Rejected";
                                                        }
                                                        else if (item.APPROVAL_STATUS == 0)
                                                        {
                                                        _msg = "Pending";
                                                        }
                                                        <span>@_msg</span>
                                                        }
                                                    </td>
                                                    <td style="font-size:12px;">
                                                        @Html.DisplayFor(modelItem => item.APP_DATE)
                                                    </td>
                                                    <td style="padding-left: 5px;">
                                                        @Html.DisplayFor(modelItem => item.APPROVAL_REMARK)
                                                    </td>
                                                </tr>
                                                }
                                                }
                                            </tbody>
                                        </table>

                                    </td>
                                </tr>

                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
    
       
    
    <div style="text-align:center;">
        <button id="btn-print" style="padding:12px;background-color:green;border-radius:4px;border: 2px solid #4CAF50;color:white;">Print</button>
    </div>
</body>

