        function RejectAssetRequest(current) {
            debugger;
            var _reqID = $(current).attr('data-headerid');
            var _Title = $(current).attr('data-html');
            $(current).attr('disabled', true);
            $(current).attr('title', 'Action already taken.kindly refresh.');
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/ICIBM/ICAssetRequestRejection",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                data: JSON.stringify({ ICTitle: _Title, ICREQID: _reqID }),
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#sp_type').html("Update Status");
                        $('#myCreateModelContent').html(data);
                        $('#myCreateModel').modal({ backdrop: "static" });
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
        function GeneratePDF(current) {

            $.ajax({
                type: "GET",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/ICIBM/ICViewDetailPDF",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                data: { id: "27" },
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        //$('#sp_type').html("Update Status");
                        //$('#myCreateModelContent').html(data);
                        //$('#myCreateModel').modal({ backdrop: "static" });
                        //window.location
                        debugger;
                        var val = htmlToPdfmake(data);
                        var dd = { content: val };
                        pdfMake.createPdf(dd).download();
                    }
                },
                complete: function () {
