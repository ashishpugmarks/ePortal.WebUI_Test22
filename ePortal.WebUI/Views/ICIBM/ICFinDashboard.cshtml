                }
            });
        }
    </script>

    <script nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
                $("#btnSubmit").on('click', function(e) {
                e.preventDefault();
                GetReportList(e);
            });
            $("#btn-reset").on("click", function () {
                window.location.href = '@Url.Action("ICFinDashboard", "ICIBM")';
            });
        });
    </script>
}
