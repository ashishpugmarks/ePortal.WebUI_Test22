        function OpenDoc(current) {
            var _pdfName = $(current).attr('data-name');
            var width = screen.width - 100;
            var height = screen.height - 100;
            var winTop = 50;
            var winLeft = 50;
            var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
            window.open("../../../Uploads/PR/" + _pdfName, "Approved PR", windowFeatures);
        };
        function RejectRequest(current) {
            debugger;
            var _reqID = $(current).attr('data-headerid');
            var _Title = $(current).attr('data-html');
            $(current).attr('disabled', true);
            $(current).attr('title', 'Action already taken.kindly refresh.');
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/ICIBM/ICRequestRejection",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                data: JSON.stringify({ ICTitle: _Title, ICREQID: _reqID }),
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#sp_type').html("Update Status");
                        $('#myCreateModelContent').html(data);
                        $('#myCreateModel').modal({ backdrop: "static" });
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function InitiateICApproval(current) {
            debugger;
            arrICList = new Array;
            var docTr = $(".chkselect");
            var reqIds = "";
            if (docTr.length > 0) {
                for (var i = 0; i < docTr.length; i += 1) {
                    var row = docTr[i];
                    if (row != undefined) {
                        if (row.checked == true) {
                            reqIds = reqIds + "," + $(row).attr('data-headerid');
                            var data = {
                                ICREQID: $(row).attr('data-headerid'),
                                ICTYPE: $(row).attr('data-content'),
                            }
                            arrICList.push(data);
                        }
                    }
                }
                if (reqIds == "") {
                    sweetAlert("", "Please select atleast one request to initiate IC approval", "warning");
                    return;
                }
            }

            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/ICIBM/InitiateICApproval",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                data: JSON.stringify({ ICREQID: arrICList }),
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#sp_type').html("Initiate IC Member Approval");
                        $('#myCreateModelContent').html(data);
                        $('#myCreateModel').modal({ backdrop: "static" });
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

