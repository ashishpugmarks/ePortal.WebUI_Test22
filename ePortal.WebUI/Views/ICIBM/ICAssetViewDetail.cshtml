@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {

        });

        function openInfo(url) {
            window.open(url, 'mywin', 'width=800,height=600');
        }
        function CancelClick() {
            window.location.href = "/Home/Home";
        }


        function Popup() {
            var content = document.getElementById("row1").innerHTML;
            var html = "<html><head><title>IC Detail</title><link type='text/css' rel='stylesheet' href='/css/home.css'><link type='text/css' rel='stylesheet' href='/css/megamenu.css'><link type='text/css' rel='stylesheet' href='/bootstrap/css/bootstrap.css'> <style>.table > tbody > tr > td{padding:6px;} .table {margin-bottom:5px;padding:7px;} body{font-size:11px;} .div-heading {text-align: left;height: 2.2em;font-weight: bold;background-color: #91b4ff;vertical-align: middle;font-family: \"Helvetica Neue\", Helvetica, Arial;}</style></head><body>" + content + "</body></html"
            var tab = window.open('about:blank', '_blank');
            tab.document.write(html); // where 'html' is a variable containing your HTML
            tab.document.close();
        }
    </script>

    <script nonce="@Context.Items["ScriptNonce_4"]">
            $(document).ready(function () {
                $("[data-ctrl-id='open-doc']").on('click', function (e) {
                    e.preventDefault();
                    OpenDoc($(this)[0]);
                });
            });

           function OpenDoc(current) {
            var _pdfPath = '@_path';//$(current).attr('data-path');
            var _pdfName = $(current).attr('data-path');
            var width = screen.width - 100;
            var height = screen.height - 100;
            var winTop = 50;
            var winLeft = 50;
            var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
            window.open(_pdfPath + _pdfName, _pdfName, windowFeatures);
        };
    </script>
}

