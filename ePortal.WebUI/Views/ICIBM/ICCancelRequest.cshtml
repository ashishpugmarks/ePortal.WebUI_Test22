    @*<div id="ajaxLoader"></div>*@<div id="ajaxLoader"></div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {

        });

        function SaveData(current) {
            debugger;
            var _IsValid = CheckValidation();
            if (!_IsValid) {
                return;
            }
            $("#btnSubmit").attr("disabled", true);
            var approvalData = {
                ICREQID: $(current).attr('data-id'),
                APPROVAL_REMARK: $("#txtRemarks").val(),
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/ICIBM/ICCancelRequest",
                data: JSON.stringify(approvalData),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        swal({
                            title: "",
                            text: "Record Saved Successfully",
                            type: "success",
                        },
                        function (isConfirm) {
                            if (isConfirm) {
                                //window.location.href = "/ASPXView/ManageRequest.aspx";
                                window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                            }
                        });
                    }
                    else if (data == 0 || data == -1) {
                        sweetAlert("", "Record Not Saved", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data == 5) {
                        swal({
                            title: "",
                            text: "Session Expired",
                            type: "warning",
                        },
                       function (isConfirm) {
                           if (isConfirm) {
                               window.location.href = "/Login";
                           }
                       });
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function CheckValidation() {
            var isVailed = true;
            $('#txtRemarks').removeClass('validationError');
                if ($('#txtRemarks').val() == "") {
                    $('#txtRemarks').addClass('validationError');
                    isVailed = false;
                }
            return isVailed;
        }

        function openInfo(url) {
            window.open(url, 'mywin', 'width=800,height=600');
        }
        function CancelClick() {
            //window.location.href = "/ASPXView/ManageRequest.aspx";
            window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
        }

        function OpenDoc(current) {
            debugger;
            var _pdfPath = '@_path';//$(current).attr('data-path');
            var _pdfName = $(current).attr('data-path');
            var width = screen.width - 100;
            var height = screen.height - 100;
            var winTop = 50;
            var winLeft = 50;
            var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
            window.open(_pdfPath + _pdfName, _pdfName, windowFeatures);
        };

    </script>

    <script nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $("[data-ctrl-id='open-doc']").on('click', function (e) {
                e.preventDefault();
                OpenDoc($(this)[0]);
            });
            $("#btnSubmit").on('click', function(e) {
                e.preventDefault();
                SaveData($(this)[0]);
            });
            $("#btnCancel").on('click', function(e) {
                e.preventDefault();
                CancelClick();
            });
        });
    </script>
}
