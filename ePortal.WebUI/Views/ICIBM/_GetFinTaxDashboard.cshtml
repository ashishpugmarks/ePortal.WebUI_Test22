@using System.Net
@using ePortal.Shared
@model IEnumerable<ePortal.ViewModels.VM_ICIBM_FINANCETAXDASHBOARD>

@{
    Layout = null;
}

<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    table.dataTable thead > tr > th.sorting_asc, table.dataTable thead > tr > th.sorting_desc, table.dataTable thead > tr > th.sorting, table.dataTable thead > tr > td.sorting_asc, table.dataTable thead > tr > td.sorting_desc, table.dataTable thead > tr > td.sorting {
        padding-right: 20px;
    }

    table.dataTable thead th, table.dataTable thead td {
        padding: 4px 6px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    select.input-sm {
        line-height: 10px !important;
    }
</style>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
    $('.homeContent').removeClass('homeContent');
    $(document).ready(function () {
       
    });
    function openPopupwithScrol(strOpenUrl, width, height) {
        var winTop = (screen.height / 2) - 325;
        var winLeft = (screen.width / 2) - 425;
        window.open(strOpenUrl, "mywindow", "TOOLBAR=no,MENUBAR=no,SCROLLBARS=yes,RESIZABLE=yes,LOCATION=no,DIRECTORIES=no,STATUS=no,width=" + width + ",height=" + height + ",top=" + winTop + ";left=" + winLeft);
    }
</script>

<script nonce="@Context.Items["ScriptNonce_9"]">
    $(document).ready(function () {
        $("[data-ctrl-id='open-popup-with-Scrol']").on('click', function (e) {
            e.preventDefault();
            openPopupwithScrol($(this).data("url"), $(this).data("width"), $(this).data("height"));
        });
        $("[data-ctrl-id='update-approval']").on('click', function () {
            UpdateApproval($(this)[0]);
        });
    });
    </script>

<div class="panel-group">
    <div class="panel panel-primary">
        <div class="panel-heading">
            <table style="width:100%;">
                <tr>
                    <td>
                        <h2 class="panel-title">
                            <strong>IC/IBM Request List</strong>
                        </h2>
                    </td>
                </tr>
            </table>
        </div>
        <div class="panel-body">
            <table class="table table-bordered table-hover table-responsive" id="tbRequestReport">
                <thead>
                    <tr>
                        <th class="text-center">
                            @Html.DisplayName("View Detail")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Request Type")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Employee")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Title")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Department")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Operation")
                        </th>
                        @*<th class="text-center">
                                @Html.DisplayName("Department/Section")
                            </th>*@
                        @*<th class="text-center">
                            @Html.DisplayName("Submission Date")
                        </th>*@
                        <th class="text-center">
                            @Html.DisplayName("Process Status")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Print")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Action")
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNo = 0;}
                    @if (Model != null)
                    {
                        foreach (var item in Model.OrderBy(m => m.ICREQID))
                        {
                            //var _ReqDate = string.Format("{0:dd-MM-yyyy}", item.LASTAPPROVAL_FROM);
                            var _tId = WebUtility.UrlEncode(Encryption.Encrypt(item.ICREQID.ToString())).ToString();
                            string _urlStr = "";
                            string _urlPrintstr = "";
                            if (item.ICTYPE == "1")
                            {
                                _urlStr = "/ICIBM/ICViewDetail?id=" + _tId;
                                _urlPrintstr = "/ICIBM/ICPrintView?id=" + _tId;
                            }
                            else if (item.ICTYPE == "2")
                            {
                                _urlStr = "/ICIBM/ICAssetViewDetail?id=" + _tId;
                                _urlPrintstr = "/ICIBM/ICAssetPrintView?id=" + _tId;
                            }
                            <tr id="tr_@item.ICREQID">
                                <td class="text-center" style="width:4%;">
                                    @*@(rowNo += 1)*@
                                    <a href="@_urlStr" target="_blank"><i class="glyphicon glyphicon-tasks" style="cursor:pointer;" title="Click here to view detail."></i></a>&nbsp;
                                </td>
                                <td class="text-center" style="width:8%;">
                                    @Html.DisplayFor(modelItem => item.REQUESTTYPE)
                                </td>
                                <td class="text-left" style="width:10%;">
                                    @Html.DisplayFor(modelItem => item.ENAME)-@Html.DisplayFor(modelItem => item.ADEMPCODE)
                                </td>
                                @*<td class="text-center">
                                        @Html.DisplayFor(modelItem => item.Emp_Detail._ECode)
                                    </td>*@
                                <td class="text-left">
                                    @Html.DisplayFor(modelItem => item.ICTITLE)
                                </td>
                                <td class="text-left">
                                    @Html.DisplayFor(modelItem => item.DEPARTMENT)
                                </td>
                                <td class="text-left">
                                    @Html.DisplayFor(modelItem => item.OPERATION)
                                </td>
                                @*<td class="text-center" style="width:9%;">
                                    @{
                                        if (item.LASTAPPROVAL_FROM != null)
                                        {
                                            @item.LASTAPPROVAL_FROM.ToString("dd-MMM-yyyy")
                                            }
                                     }
                                </td>*@
                                <td class="text-center" style="width:7%;">
                                    @if (item.PROCESSSTATUS == 1)
                                    {
                                        <button class="btn btn-danger btn-xs" style="cursor: text !important">Pending for Approval</button>
                                    }
                                    @if (item.PROCESSSTATUS == 2)
                                    {
                                        <button class="btn btn-info btn-xs" style="cursor: text !important">Accepted By Finance</button>
                                    }
                                    @if (item.PROCESSSTATUS == 3)
                                    {
                                        <button class="btn btn-info btn-xs" style="cursor: text !important">Rejected</button>
                                    }
                                    @if (item.PROCESSSTATUS == 4)
                                    {
                                        <button class="btn btn-info btn-xs" style="cursor: text !important">Cancelled</button>
                                    }
                                    @if (item.PROCESSSTATUS == 5)
                                    {
                                        <button class="btn btn-info btn-xs" style="cursor: text !important">Sentback</button>
                                    }
                                    @if (item.PROCESSSTATUS == 6)
                                    {
                                        <button class="btn btn-warning btn-xs" style="cursor: text !important">Pending for IC Approval</button>
                                    }
                                    @if (item.PROCESSSTATUS == 7)
                                    {
                                        <button class="btn btn-success btn-xs" style="cursor: text !important">Completed</button>
                                    }
                                    @if (item.PROCESSSTATUS == 9)
                                    {
                                        <button class="btn btn-danger btn-xs" style="cursor: text !important">IC Rejection</button>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href='#' data-ctrl-id='open-popup-with-Scrol' data-url="@_urlPrintstr" data-width="800px" data-height="500px" data-toggle='tooltip' title='Print'><span class='glyphicon glyphicon-print text-primary' aria-hidden='true'></span></a>
                                </td>
                                <td class="text-center" style="width: 5%;">
                                    @if (item.STATUS == 1)
                                    {
                                        <button class="btn-xs glyphicon glyphicon-eye-close" data-headerid="@item.ICREQID" data-ctrl-id="update-approval"></button>
                                    }
                                </td>
                            </tr>
                                 }
                                        }
                </tbody>
            </table>

        </div>
    </div>
</div>
