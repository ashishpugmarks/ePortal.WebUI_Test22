        </td>
        <td style="vertical-align:top;">
            <table style="border:1px #91b4ff solid;width:100%;font-size:15px;text-align:left;">
                <tr>
                    <td>
                        <table cellspacing="0" border="1" style="margin-bottom: 0px;width:100%;border:1px #91b4ff solid;font-size:15px;">
                            <tr style="background-color: #d9edf7!important;">
                                <td style="width:50%;text-align:left;padding:5px;">
                                    <b> Budget Detail</b>
                                </td>
                                <td style="text-align:right!important;padding:5px;">
                                    <b> (In Million)</b>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px;">
                                    @Html.LabelFor(model => model.BASIC_BUDGET, htmlAttributes: new { })
                                </td>
                                <td style="padding:5px;">
                                    @Html.DisplayFor(model => model.BASIC_BUDGET, new { })
                                </td>
                            </tr>
                            @*// BASIC*@
                            <tr>
                                <td style="padding:5px;">
                                    @Html.LabelFor(model => model.BASIC_PROPOSED, htmlAttributes: new { })
                                </td>

                                <td style="padding:5px;">
                                    @Html.DisplayFor(model => model.BASIC_PROPOSED, new { })
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px;">
                                    @Html.LabelFor(model => model.TAX_BUDGET, htmlAttributes: new { })
                                </td>

                                <td style="padding:5px;">
                                    @Html.DisplayFor(model => model.TAX_BUDGET, new { })
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:5px;">
                                    @Html.LabelFor(model => model.TAX_PROPOSED, htmlAttributes: new { })
                                </td>

                                <td style="padding:5px;">
                                    @Html.DisplayFor(model => model.TAX_PROPOSED, new { })
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td>
                        <table style="border:1px #91b4ff solid;width:100%;font-size:15px;text-align:left;">
                            <tr style="background-color: #337ab7!important;">
                                <th style="width:50%;text-align:left;padding:5px;color:white;">
                                    Approval History
                                </th>
                            </tr>
                            <tr>
                                <td>
                                    <table cellspacing="0" border="1" style="margin-bottom: 0px;border:1px #91b4ff solid;font-size:10px;" width="100%">
                                        <thead>
                                            <tr style="background-color:#d9edf7;">
                                                <th class="hide1">
                                                    Hide
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.ICAPPHISTORY[0].ICAPPHISTORY_ID)
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.ICAPPHISTORY[0].APPEMP_NAME)
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.ICAPPHISTORY[0].APPROVAL_STATUS)
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.ICAPPHISTORY[0].APP_DATE)
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.ICAPPHISTORY[0].APPROVAL_REMARK)
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody style="text-align:center">
                                            @{ int row_No = 0; }
                                            @if (Model.ICAPPHISTORY != null)
                                            {
                                                foreach (var item in Model.ICAPPHISTORY)
                                                {
                                                    <tr id="tr_@row_No">
                                                        <td class="hide1">
                                                            <input class="tr-checkbox" value="@row_No" type="checkbox" />
                                                        </td>
                                                        <td>
                                                            @(row_No += 1)
                                                            @Html.HiddenFor(modelItem => item.ICAPPHISTORY_ID)
                                                        </td>
                                                        <td style="padding-left: 10px;">
                                                            @Html.HiddenFor(modelItem => item.ICREQID)
                                                            @Html.DisplayFor(modelItem => item.APPEMP_NAME)
                                                        </td>
                                                        <td style="padding-left: 10px;">
                                                            @{
                                                                string _msg = "";
                                                                if (item.APPROVAL_STATUS == 1)
                                                                {
                                                                    _msg = "Approved";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 2)
                                                                {
                                                                    _msg = "Send back";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 3)
                                                                {
                                                                    _msg = "Rejected";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 0)
                                                                {
                                                                    _msg = "Pending";
                                                                }
                                                                <span>@_msg</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => item.APP_DATE)
                                                        </td>
                                                        <td style="padding-left: 10px;">
                                                            @Html.DisplayFor(modelItem => item.APPROVAL_REMARK)
                                                        </td>
                                                    </tr>
