                                <th style="background-color: #d9edf7!important;text-align:left;" colspan="2">A00 Details</th>
                            </tr>
                            <tr>
                                <th style="width:20%;">
                                    @Html.LabelFor(model => model.ICA00, htmlAttributes: new {   })
                                </th>
                                <td>
                                    @Html.DisplayFor(model => model.ICA00, new {   })
                                </td>
                            </tr>
                            <tr>
                                <th style="width:20%;background: #e9e9e9;">
                                    @Html.LabelFor(model => model.ICPURPOSE, htmlAttributes: new {   })
                                </th>
                                <td style="background: #e9e9e9;">
                                    @Html.DisplayFor(model => model.ICPURPOSE, new {   })
                                </td>
                            </tr>
                            <tr>
                                <th style="width:20%;">
                                    @Html.LabelFor(model => model.REQUIREMENT, htmlAttributes: new {   })
                                </th>
                                <td>
                                    @Html.DisplayFor(model => model.REQUIREMENT, new {   })
                                </td>
                            </tr>
                            <tr>
                                <th style="width:20%;">
                                    @Html.LabelFor(model => model.TARGET, htmlAttributes: new {   })
                                </th>
                                <td>
                                    @Html.DisplayFor(model => model.TARGET, new {   })
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="vertical-align:top;">
                        <table  style="border:1px #91b4ff solid;height:3em;width:100%;font-size:15px;text-align:left;">
                            <tr>
                                <th style="width:40%; background-color:#e9e9e9;margin-right:5px;">
                                    @Html.LabelFor(model => model.CONTENTOFEXE, htmlAttributes: new {  })
                                </th>
                                <td style="background-color:white;">
                                    <span style="white-space: pre-line">@Model.CONTENTOFEXE</span>
                                    @*@Html.DisplayFor(model => model.CONTENTOFEXE, new {   })*@
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr style="text-align:left;">
                    <td style="vertical-align:top;">
                        <table style="border:1px #91b4ff solid;width:100%;font-size:15px;text-align:left;">
                            <tr>
                                <th style="text-align:left;background-color:#337ab7;color:white;padding:2px;">Schedule With Milestone</th>
                            </tr>
                            <tr>
                                <td>
                                    <table cellspacing="0" border="1" style="margin-bottom: 0px;width:100%;border:1px #91b4ff solid;border-top: 0px;font-size:15px;text-align:center;">
                                        <thead>
                                            <tr class="bg-info">
                                                <th class="text-center">SNo.</th>
                                                <th class="text-center">Target</th>
                                                <th colspan="2" style="width:35%;">Schedule</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                if (Model.ICREQ_SCHEDULE != null && Model.ICREQ_SCHEDULE.Count() > 0)
                                                {
                                                    int rowno = 0;
                                                    foreach (var obj in Model.ICREQ_SCHEDULE)
                                                    {
                                                        rowno = rowno + 1;
                                                        <tr>
                                                            <td >@rowno</td>
                                                            <td >@obj.TARGET</td>
                                                            <td colspan="2" style="width:35%;">@obj.SCHEDULESTR</td>
                                                        </tr>
                                                    }
