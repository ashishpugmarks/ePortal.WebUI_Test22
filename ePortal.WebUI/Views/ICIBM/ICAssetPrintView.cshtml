@using Microsoft.AspNetCore.Http
@model ePortal.ViewModels.ICASSETDISREQHEADER
@{
    ViewBag.Title = "ICAssetViewDetailcopy";
    Layout = null;
    string _path = "../../../Uploads/ICIBM/";
    //var loginUser = Context.Session.GetString("userID") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userID").ToString());
    var loginUser = Context.Session.GetString("userID") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userID").ToString());
}

<head>
    <style type="text/css" media="print" nonce="@Context.Items["StyleNonce_0"]">
            * {
                -webkit-print-color-adjust: exact !important; /* Chrome, Safari 6 – 15.3, Edge
        */
                color-adjust: exact !important; /* Firefox 48 – 96
        */
                print-color-adjust: exact !important; /* Firefox 97+, Safari 15.4+
        */
            }
    </style>
    <script nonce="@Context.Items["ScriptNonce_0"]">
        function disablerow() {
            debugger;

            var docTr = document.getElementsByClassName("tr-checkbox");
            if (docTr.length > 0) {
                for (var i = 0; i < docTr.length; i += 1) {
                    var row = docTr[i];
                    if (row != undefined) {
                        if (row.checked) {
                            var row_id = (row).value;
                            document.getElementById("tr_" + row_id).style.display = "none";
                        }

                    }
                }
            }
            for (const e of document.getElementsByClassName("hide1")) {
                e.style.display = 'none'
            }
            window.print();
        }
    </script>
<script nonce="@Context.Items["ScriptNonce_1"]">
    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById("btn-print").onclick = function (e) {
            e.preventDefault();
            disablerow();
        }
    });
</script>
</head>
<body>
