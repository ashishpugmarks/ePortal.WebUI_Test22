        function AddOAuthority() {
            $('#spn_O_auth_msg').text('');
            //$('#txtOheader').removeClass('validationError');
            //if ($('#txtOheader').val() == "") {
            //    $('#txtOheader').addClass('validationError');
            //    $('#spn_O_auth_msg').text('Please select header.');
            //    return;
            //}
            $('#txtOEmpcode').removeClass('validationError');
            if ($('#txtOEmpcode').val() == "") {
                $('#txtOEmpcode').addClass('validationError');
                $('#spn_O_auth_msg').text('Please enter employee code.');
                return;
            }
            if (arrayList.length > 0) {
                var _ecode = parseInt($('#txtOEmpcode').val().split("-")[0].trim());
                var itemArray = $.grep(arrayList, function (e) {
                    return e.ADEMPCODE == _ecode;
                });
                if (itemArray.length > 0) {
                    $('#txtOEmpcode').addClass('validationError');
                    $('#spn_O_auth_msg').text('This approval authority already added.');
                    return;
                }
            }
            $.ajax({
                type: "GET",
                url: "/ICIBM/GetAppAuthority",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: { eCode: $('#txtOEmpcode').val(), headerId: arrayList.length, header: $("#txtOheader").val() },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.ECODE > 0 && data.ENAME != "") {
                        arrayList = data.SEQ_LIST;
                        $('#txtOEmpcode').val('');
                        //$("#ddHeader").val('');
                    }
                    else {
                        $('#spn_O_auth_msg').text('Record not found.');
                    }
                },
                complete: function () {
                    BindData(arrayList);
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
        function DeleteItem(current) {
            var appHeader = $(current).attr('data-headerid');
            $.ajax({
                type: "GET",
                url: "/ICIBM/DeleteAppAuthority",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: { eCode: current.id, header: appHeader, ISALL: 0 },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.RESULT == 1) {
                        arrayList = data.SEQ_LIST;
                    }
                    else {
                        $('#spn_auth_msg').text('Record not deleted.');
                    }
                },
                complete: function () {
                    BindData(arrayList);


                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
        function BindData(arrayList) {
            var rows = "", rowId = 0;
            if (arrayList != null) {
                if (arrayList.length > 0) {
                    $.each(arrayList, function (i, item) {
                        rowId = i + 1;
                        rows += "<tr class='tr-auth'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.ADEMPCODE + "</td>"
                        rows += "<td class='text-left'><input type='hidden' value='" + item.APP_SEQ + "'>" + item.ADEMPNAME + "</td><td class='text-center'><input type='hidden' value='" + item.FNDESID + "'>" + item.ADDESIGNATION + "</td>"
                        //rows += "<td class='text-center'>" + item.APP_SEQ + "</td>"

                        rows += "<td class='text-center'><a id='" + item.ADEMPCODE + "' data-headerid='" + "" + "' style='cursor: pointer;' data-ctrl-id='po-att-delete-item'>Delete</a></td>"
                        rows += "</tr>"
                    });
                }
                else {
                    rows += "<tr id='div-table'><td colspan='5' class='text-center'>No record found.</td></tr>"
                }
                document.getElementById("append_row").innerHTML = rows;
                $("[data-ctrl-id='po-att-delete-item']").on('click', function() {
                    DeleteItem($(this)[0]);
                });
            }
            else {
                rows += "<tr id='div-table'><td colspan='5' class='text-center'>No record found.</td></tr>"
                document.getElementById("append_row").innerHTML = rows;
            }
        }
        function submitForm() {
            $('#txtOEmpcode').removeClass('validationError');
            var isFormVaildation = CheckFormValidation();
            if (isFormVaildation) {

                var docTr = $("#append_docRow .tr_doc");
                if (docTr.length > 0) {
                    for (var i = 0; i < docTr.length; i += 1) {
                        var row = docTr[i];
                        if (row != undefined) {
                            var varificationText = row.cells[3].innerHTML.trim();
                            if (varificationText == "Not Verified") {
                                sweetAlert("", "Document not verified. Please open all document & verified", "warning");
                                return;
                            }
                        }
                    }
                }
                else {
                    sweetAlert("", "Please upload documents.", "warning");
                    return;
                }

                if (arrayList == null || arrayList.length == 0) {
                    $('#txtOEmpcode').addClass('validationError');
                    sweetAlert("", "Please add approval authority.", "warning");
                    return;
                }
                else {
                    $("#btnSave").attr("disabled", true);
                    var data = {
                        ICREQID: $("#hfICHeaderId").val(),
                        REMARK: $("#txtRemark").val(),
                        STATUS: 1,
                        PROCESSSTATUS: 1,
                        IsFinalSubmit: 1,
                        ICAPPAUTHSEQ: arrayList,
                    };
                    $.ajax({
                        type: "POST",
                        url: "/ICIBM/ICRequest",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        data: JSON.stringify(data),
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (data) {
                            if (data == 1) {
                                swal({
                                    title: "",
                                    text: "Record saved successfully.",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                        //window.location.href = "/ASPXView/ManageRequest.aspx";
                                         window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                                    }
                                });
                            }
                            else if (data == 3) {
                                sweetAlert("", "Please upload IC Document.", "warning");
                                $("#btnSave").attr("disabled", false);
                            }
                            else {
                                sweetAlert("", "Record not saved.", "warning");
                                $("#btnSave").attr("disabled", false);
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                            $("#btnSave").attr("disabled", false);
                        }
                    });
                }
            }
            else {
                $('#div_valid_msg').removeClass('hidden');
            }
        }
