        function UploadAttachment() {
            var IsAttachmentsValidation = CheckAttachmentsValidation();
            if (!IsAttachmentsValidation) {
                return;
            }
            $("#btnUpload").attr("disabled", true);
            var formData = new FormData();
            formData.append("FILE", document.getElementById("txtFile").files[0]);
            formData.append("DOC_TYPE", $("#ddDocType").val());
            formData.append("ADDITIONAL_INFO", $("#txtAddInfo").val());
            formData.append("ICREQID", $("#hfICHeaderId").val());
            $.ajax({
                type: "POST",
                url: "/ICIBM/UploadAttachment",
                data: formData,
                datatype: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.res == 1) {
                        attachmentArray = data.attachmentList;
                        if (attachmentArray != null) {
                            if (attachmentArray.length > 0) {
                                BindDocument(attachmentArray);
                            }
                            $("#span-attachmentMsg").text('Attachment uploaded successfully. ').css('color', 'green').show().delay(5000).fadeOut();
                            IsUploadAttachment = true;
                            $("#txtFile").val('');
                            $("#ddDocType").val('');
                            $("#txtAddInfo").val('');
                        }
                    }
                    else if (data.res == 0 || data.res == -1) {
                        $("#span-attachmentMsg").text('Attachment not uploaded, Please try again. ').css('color', '#a94442').show().delay(5000).fadeOut();
                    }
                    $("#btnUpload").attr("disabled", false);
                },
                error: function () {
                    $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                    $("#btnUpload").attr("disabled", false);
                }
            });
        }
        function DeleteDoc(crnt) {
            var fileName = $(crnt).attr('data-name');
            var docType = $(crnt).attr('data-type');
            var ICHeaderId = $(crnt).attr('data-id');

            $.ajax({
                type: "Delete",
                url: "/ICIBM/DeleteAttachment",
                data: JSON.stringify({ fileName: fileName, docType: docType, ICHeaderId: ICHeaderId }),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.res == 1) {
                        attachmentArray = data.attachmentList;
                        //if(attachmentArray != null){
                        //    if(attachmentArray.length > 0){
                        BindDocument(attachmentArray);
                        //    }
                        //}
                        sweetAlert("", "Document deleted successfully.", "success");
                    }
                    else {
                        sweetAlert("", "Document not deleted, Please try again.", "warning");
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
        function CheckAttachmentsValidation() {
            var isVailed = true;
            $('#txtFile').removeClass('validationError');
            if ($('#txtFile').val() == "") {
                $('#txtFile').addClass('validationError');
                isVailed = false;
            }

            $("#ddDocType").removeClass('validationError');
            if ($('#ddDocType').val() == "") {
                $("#ddDocType").addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }
        function readBackupFile(input) {
            var _URL = window.URL || window.webkitURL;
            var file = input.files[0];
            var image = new Image();
            image.src = _URL.createObjectURL(file);
            var extension = $(input).val().split('.').pop().toLowerCase();
            var validFileExtensions = ['pdf','ppt','pptx'];
            if ($.inArray(extension, validFileExtensions) == -1) {
                var _msg = "Sorry! Upload only 'pdf, ppt and pptx' file";
                sweetAlert(" ", _msg, "warning");
                $(input).replaceWith($(input).val('').clone(true));
            }
            if (file.size > (5e+6)) {
                sweetAlert(" ", "Sorry! Max allowed file size is 5 mb", "warning");
                $(input).replaceWith($(input).val('').clone(true));
                return;
            }
            else {
                IsUploadAttachment = false;
            }
        }
        function BindDocument(attList) {
            var rows = "", rowId = 0;
            if (attList != null) {
                if (attList.length > 0) {
                    $.each(attList, function (i, item) {
                        rowId = i + 1;
                        var additionalInfo = item.ADDITIONAL_INFO == null ? "" : item.ADDITIONAL_INFO;
                        rows += "<tr class='tr_doc'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.DOC_TYPE + "</td>"
                        rows += "<td class='text-left'><a style='cursor: pointer;' data-ctrl-id='po-att-get-pdf' data-id='" + item.FILENAME + "'>" + item.FILENAME + "</a></td>"
                        rows += "<td class='text-center' style='color:#a94442'>Not Verified</td><td class='text-left'>" + additionalInfo + "</td>"
                        rows += "<td class='text-center'><a data-name='" + item.FILENAME + "' data-type='" + item.DOC_TYPE + "' data-id='" + item.ICREQID + "' style='cursor: pointer;' data-ctrl-id='po-att-delete-doc'>Delete</a></td>"
                        rows += "</tr>"
                    });
                    document.getElementById("append_docRow").innerHTML = rows;
                    $("[data-ctrl-id='po-att-delete-doc']").on('click', function() {
                        DeleteDoc($(this)[0]);
                    });
                    $("[data-ctrl-id='po-att-get-pdf']").on('click', function() {
                        GetPDF($(this)[0]);
                    });
                }
            }
        }
        function GetPDF(current) {
            var _pdfName = $(current).attr('data-id');
            $(current).parent().next()[0].textContent = "Verified";
            $(current).parent().next().css("color", "green");
            if (_pdfName != "") {
                $.ajax({
                    type: "GET",
                    url: "/ICIBM/GetPDF",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { fileName: _pdfName },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.FILEPATH != "") {
                            document.getElementById("myCreateModelContent").innerHTML = data.FILEPATH;
                            $('#myCreateModel').modal({ backdrop: "static" });
                        }
                        else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }
