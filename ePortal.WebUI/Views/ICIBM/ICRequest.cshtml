                IMPORT_LOCAL: $("#ddlImport_Local").val(),
                //TAX_CREDIT_AVAIL: $("#ddltaxcredit").val(),
                ICREQ_SCHEDULE:MilestoneList,
                REMARK: "",
                STATUS: 1,
                PROCESSSTATUS: 0,
                IsFinalSubmit: 0,
                INVEST_EFFECT: invest_effect_val,

                // GAVAMT: $("#txtGAVAMT").val(),
                // SRVAMT: $("#txtSRVAMT").val(),
                // NAVAMT: $("#txtNAVAMT").val(),
                // NPLAMT: parseFloat($("#txtSRVAMT").val()-$("#txtNAVAMT").val()).toFixed(2),
                // NPLAMT: $("#txtNPLAMT").val(),

                GAVAMT: gavamtVal ? parseFloat(gavamtVal) : null,
                SRVAMT: srvamtVal ? parseFloat(srvamtVal) : null,
                NAVAMT: navamtVal ? parseFloat(navamtVal) : null,
                NPLAMT: (srvamtVal && navamtVal) ? parseFloat(srvamtVal - navamtVal).toFixed(2) : 0,
            }
            $.ajax({
                type: "POST",
                url: "/ICIBM/SaveICDetail",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.res == 1 && data.ICID > 0) {
                        $("#hfICHeaderId").val(data.ICID);
                        $("#hfencryICReqID").val(data.ICENCRYT);
                        $(".next").click();
                    }
                    else { sweetAlert("", "Detail not saved.", "warning"); }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
        function UpdateMilestone()
        {
            if ($("#txtSM_Target").val().trim() == "" || $("#txtSM_Schedule").val() == "")
            {
                swal("Target & Schedule are mandetory field.");
                return;
            }
            if (MilestoneList.length > 0) {
                var tmpArray = $.grep(MilestoneList, function (e) {
                    return e.MilestoneTarget == $("#txtSM_Target").val().trim();
                });
                if (tmpArray.length > 0)
                {
                    swal("Target Already exist in list.");
                    return;
                }

            }
            var data = {
                Milid:MilestoneList.length+1,
                TARGET: $("#txtSM_Target").val().trim(),
                //SCHEDULE: $("#txtSM_Schedule").val().trim(),
                SCHEDULESTR: $("#txtSM_Schedule").val().trim()//.substr($("#txtSM_Schedule").val().trim().indexOf('-') + 1)
            }
            MilestoneList.push(data);
            $("#txtSM_Target").val("");
            $("#txtSM_Schedule").val("");
            BindMilestoneData(MilestoneList);

        }
        function BindMilestoneData(MilestoneList) {
            var rows = "", rowId = 0;
            if (MilestoneList != null) {
                if (MilestoneList.length > 0) {
                    $.each(MilestoneList, function (i, item) {
                        rowId = i + 1;
                        rows += "<tr class='tr-auth'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.TARGET + "</td><td class='text-center' colspan='2'>" + item.SCHEDULESTR + "</td>"
                        rows += "<td class='text-center'><a id='" + item.Milid + "' data-header='" + item.Milid + "' style='cursor: pointer;' data-ctrl-id='po-att-delete-mail'>Delete</a></td>"
                        rows += "</tr>"
                    });
                }
                else {
                    rows += "<tr id='div-table'><td colspan='5' class='text-center'>No record found.</td></tr>"
                }
                document.getElementById("append_MilRow").innerHTML = rows;
                $("[data-ctrl-id='po-att-delete-mail']").on('click', function() {
                    DeleteMil($(this)[0]);
                });

            }
            else {
                rows += "<tr id='div-table'><td colspan='5' class='text-center'>No record found.</td></tr>"
                document.getElementById("append_MilRow").innerHTML = rows;
            }
        }
