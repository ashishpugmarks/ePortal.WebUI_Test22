@section Scripts {
    <script nonce="@Context.Items["ScriptNonce_3"]">
        function deleteIC(id){
            var data={
                ICCONFIGID:id,
                status:0
            };
            $.ajax({
                url:"/ICIBM/DeleteIC",
                type:"delete",
                data:JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype:"json",
                success: function (data) {
                    if (data == 1) {
                        sweetAlert("", "Record Deleted", "warning");
                    }
                }
            });
            window.location.reload();
        }

        function EditIC(id) {
            localStorage.setItem("edit",1);
            }
    </script>
    <script nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $("[data-ctrl-id='edit-ic']").on('click', function () {
                EditIC($(this).data("id"));
            });
            $("[data-ctrl-id='delete-ic']").on('click', function() {
                deleteIC($(this).data("id"));
            });
        });
    </script>
    }