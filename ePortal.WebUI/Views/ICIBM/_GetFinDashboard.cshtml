@using System.Net
@using ePortal.Shared
@model IEnumerable<ePortal.ViewModels.VM_ICIBM_FINANCEDASHBOARD>

@{
    Layout = null;
}

<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    table.dataTable thead > tr > th.sorting_asc, table.dataTable thead > tr > th.sorting_desc, table.dataTable thead > tr > th.sorting, table.dataTable thead > tr > td.sorting_asc, table.dataTable thead > tr > td.sorting_desc, table.dataTable thead > tr > td.sorting {
        padding-right: 20px;
    }

    table.dataTable thead th, table.dataTable thead td {
        padding: 4px 6px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    select.input-sm {
        line-height: 10px !important;
    }
</style>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
    $('.homeContent').removeClass('homeContent');
    $(document).ready(function () {
       
    });
    function UpdateICMemberMaster() {
        $.ajax({
            type: "GET",
            beforeSend: function () {
                $("#ajaxLoader").addClass('loader');
            },
            url: "/ICIBM/UpdateICMemberMaster",
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            success: function (data) {
                if (data == "error") {
                    sweetAlert("", "An error occurred while processing your request.", "error");
                }
                else {
                    $('#sp_type').html("Update Master");
                    //$('#myCreateModel').css({ 'width': '400px!important;' });
                    $('#myCreateModelContent').html(data);
                    $('#myCreateModel').modal({ backdrop: "static" });
                }
            },
            complete: function () {
                $("#ajaxLoader").removeClass('loader');
            },
            error: function () {
                sweetAlert("Oops...", "Something went wrong!", "error");
            }
        });
    }
    function UploadFinalDocument(current) {
        var _reqID = $(current).attr('data-headerid');
        var _Title = $(current).attr('data-html');
        var _Type = $(current).attr('data-content');
        $(current).attr('disabled', true);
        $(current).attr('title', 'Action already taken.kindly refresh.');
        $.ajax({
            type: "POST",
            beforeSend: function () {
                $("#ajaxLoader").addClass('loader');
            },
            url: "/ICIBM/UploadFinalDocument",
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            data: JSON.stringify({ ICTitle: _Title, ICREQID: _reqID, APP_TYPE: _Type }),
            success: function (data) {
                if (data == "error") {
                    sweetAlert("", "An error occurred while processing your request.", "error");
                }
                else {
                    $('#sp_type').html("Upload Final Document");
                    $('#myCreateModelContent').html(data);
                    $('#myCreateModel').modal({ backdrop: "static" });
                }
            },
            complete: function () {
                $("#ajaxLoader").removeClass('loader');
            },
            error: function () {
                sweetAlert("Oops...", "Something went wrong!", "error");
            }
        });
    }
    function openPopupwithScrol(strOpenUrl, width, height) {
        var winTop = (screen.height / 2) - 325;
        var winLeft = (screen.width / 2) - 425;
        window.open(strOpenUrl, "mywindow", "TOOLBAR=no,MENUBAR=no,SCROLLBARS=yes,RESIZABLE=yes,LOCATION=no,DIRECTORIES=no,STATUS=no,width=" + width + ",height=" + height + ",top=" + winTop + ";left=" + winLeft);
    }
</script>
<script nonce="@Context.Items["ScriptNonce_9"]">
        $(document).ready(function () {
             $("#lnkupdmaster").on('click', function(e) {
                e.preventDefault();
                UpdateICMemberMaster();
            });
            $("[data-ctrl-id='open-popup-with-Scrol']").on('click', function (e) {
                e.preventDefault();
                openPopupwithScrol($(this).data("url"), $(this).data("width"), $(this).data("height"));
            });
            $("[data-ctrl-id='update-approval']").on('click', function() {
                UpdateApproval($(this)[0]);
            });
            $("[data-ctrl-id='reject-request']").on('click', function() {
                RejectRequest($(this)[0]);
            });
            $("[data-ctrl-id='upload-final-document']").on('click', function() {
                UploadFinalDocument($(this)[0]);
            });
            $("[data-ctrl-id='reject-asset-request']").on('click', function() {
                RejectAssetRequest($(this)[0]);
            });
            $("[data-ctrl-id='update-asset-approval']").on('click', function() {
                UpdateAssetApproval($(this)[0]);
            });
            $("#btnicinitiation").on('click', function() {
                InitiateICApproval();
            });
        });
</script>
<div class="panel-group">
    <div class="panel panel-primary">
        <div class="panel-heading">
            <table style="width:100%;">
                <tr>
                    <td style="width:50%;">
                        <h2 class="panel-title">
                            <strong>IC Request List</strong>
                        </h2>
                    </td>
                    <td class="panel-title" style="text-align:right!important;">
                        <a href="#" class="hidden" id="lnkupdmaster">IC Member Master</a>
                    </td>
                    @*<td align="right" style="width:20%;text-align:right;vertical-align:middle;"><strong>Legends(PR Processing Cycle)</strong>&nbsp;&nbsp;</td>
                        <td align="right" style="width:4%;vertical-align:middle;"><div style="background-color: #f5c3c3;width: 25px; border: 1px solid green;height:25px;"></div></td>
                        <td style="width:6%;text-align:left;vertical-align:middle;">&nbsp;1st - 10th </td>
                        <td align="right" style="width:4%;vertical-align:middle;"><div style="background-color: #e8df75;width: 25px; border: 1px solid green;height:25px;"></div></td>
                        <td style="width:6%;text-align:left;vertical-align:middle;">&nbsp;11th - 20th</td>
                        <td align="right" style="width:4%;vertical-align:middle;"><div style="background-color: #d6fbd6;width: 25px; border: 1px solid green;height:25px;"></div></td>
                        <td style="width:6%;text-align:left;vertical-align:middle;">&nbsp;21th - 30th</td>*@
                </tr>
            </table>
        </div>
        <div class="panel-body table-responsive">
            <table class="table table-bordered table-hover" id="tbRequestReport">
                <thead>
                    <tr>
                        <th class="text-center">
                            @Html.DisplayName("View Detail")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Request Type")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Employee")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Title")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Department")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Operation")
                        </th>
                        <th class="text-center">
                                @Html.DisplayName("Budget Amount / Proposed Amount")
                            </th>
                        <th class="text-center">
                            @Html.DisplayName("Net Asset Value / Scrap Value ")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Submission Date")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Status")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Print")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Action")
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNo = 0;}
                    @if (Model != null)
                    {
                        foreach (var item in Model.OrderBy(m=>m.LASTAPPROVAL_FROM))
                        {
                            //var _ReqDate = string.Format("{0:dd-MM-yyyy}", item.LASTAPPROVAL_FROM);
                            var _tId = WebUtility.UrlEncode(Encryption.Encrypt(item.ICREQID.ToString())).ToString();
                            string _urlStr = "";
                            string _urlPrintstr = "";
                            if (item.ICTYPE == "1")
                            {
                                _urlStr = "/ICIBM/ICViewDetail?id=" + _tId;
                                _urlPrintstr = "/ICIBM/ICPrintView?id=" + _tId;
                            }
                            else if (item.ICTYPE == "2")
                            {
                                _urlStr = "/ICIBM/ICAssetViewDetail?id=" + _tId;
                                _urlPrintstr = "/ICIBM/ICAssetPrintView?id=" + _tId;
                            }
                            //var _color = "";
                            //int _dateNum = Convert.ToInt32(_ReqDate.Split('-')[0]);
                            //if (_dateNum > 0 && _dateNum <= 10)
                            //{
                            //    _color = "#f5c3c3";
                            //}
                            //else if (_dateNum > 10 && _dateNum <= 20)
                            //{
                            //    _color = "#e8df75";
                            //}
                            //else if (_dateNum > 20 && _dateNum <= 31)
                            //{
                            //    _color = "#d6fbd6";
                            //}

                            //<tr style="background-color: @_color;" id="tr_@item.ICREQID">
                            <tr id="tr_@item.ICREQID">
                                <td class="text-center" style="width:4%;">
                                    @*@(rowNo += 1)*@
                                    <a href="@_urlStr" target="_blank"><i class="glyphicon glyphicon-tasks" style="cursor:pointer;" title="Click here to view detail."></i></a>&nbsp;
                                </td>
                                <td class="text-center" style="width:8%;">
                                    @Html.DisplayFor(modelItem => item.REQUESTTYPE)
                                </td>
                                <td class="text-left" style="width:10%;">
                                    @Html.DisplayFor(modelItem => item.ENAME)-@Html.DisplayFor(modelItem => item.ADEMPCODE)
                                </td>
                                @*<td class="text-center">
                                        @Html.DisplayFor(modelItem => item.Emp_Detail._ECode)
                                    </td>*@
                                <td class="text-left">
                                    @Html.DisplayFor(modelItem => item.ICTITLE)
                                </td>
                                <td class="text-left">
                                    @Html.DisplayFor(modelItem => item.DEPARTMENT)
                                </td>
                                <td class="text-left">
                                    @Html.DisplayFor(modelItem => item.OPERATION)
                                </td>
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.BASIC_BUDGET) / @Html.DisplayFor(modelItem => item.BASIC_PROPOSED)
                                </td>
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.NAVAMT) / @Html.DisplayFor(modelItem => item.SRVAMT)
                                </td>
                                <td class="text-center" style="width:9%;">
                                    @{
                                        if (item.LASTAPPROVAL_FROM != null)
                                        {
                                            @item.LASTAPPROVAL_FROM?.ToString("dd-MMM-yyyy");
                                        }
                                    }
                                </td>
                                <td class="text-center" style="width:7%;">
                                    @if (item.status == 1)
                                    {
                                        <button class="btn btn-danger btn-xs" style="cursor: text !important">Pending for Approval</button>
                                    }
                                    @if (item.status == 2)
                                    {
                                        <button class="btn btn-info btn-xs" style="cursor: text !important">Accepted By Finance</button>
                                    }
                                    @if (item.status == 6)
                                    {
                                        <button class="btn btn-warning btn-xs" style="cursor: text !important">Pending for IC Approval</button>
                                    }
                                    @if (item.status == 7)
                                    {
                                        <button class="btn btn-success btn-xs" style="cursor: text !important">Completed</button>
                                    }
                                    @if (item.status == 9)
                                    {
                                        <button class="btn btn-danger btn-xs" style="cursor: text !important">IC Rejection</button>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href='#' data-ctrl-id='open-popup-with-Scrol' data-url="@_urlPrintstr" data-width="800px" data-height="500px" data-toggle='tooltip' title='Print'><span class='glyphicon glyphicon-print text-primary' aria-hidden='true'></span></a>
                                </td>
                                <td class="text-center" style="width: 5%;">
                                    @if (item.status == 1 && item.ICTYPE=="1")
                                    {
                                        <button class="btn-xs glyphicon glyphicon-eye-close" data-headerid="@item.ICREQID" data-ctrl-id='update-approval'></button>
                                    }
                                    @if (item.status == 2 && item.ICTYPE == "1")
                                    {
                                        <input type="checkbox" class="chkselect" id="rdbicreqid" data-headerid="@item.ICREQID" data-content="1"/><br />
                                        <button class="btn-xs glyphicon glyphicon-floppy-remove" style="margin-top:2px!important;" data-html="@item.ICTITLE" data-headerid="@item.ICREQID" data-ctrl-id='reject-request'></button><br />
                                        <button class="btn-xs glyphicon glyphicon-upload" style="margin-top:2px!important;" data-html="@item.ICTITLE" data-content="1" data-headerid="@item.ICREQID" data-ctrl-id='upload-final-document'></button>

                                    }
                                    @if (item.status == 1 && item.ICTYPE == "2")
                                    {
                                        <button class="btn-xs glyphicon glyphicon-eye-close" data-headerid="@item.ICREQID" data-ctrl-id='update-asset-approval'></button>
                                    }
                                    @if (item.status == 2 && item.ICTYPE == "2")
                                    {
                                        <input type="checkbox" class="chkselect" id="rdbicreqid" data-headerid="@item.ICREQID" data-content="2" /> <br />
                                        <button class="btn-xs glyphicon glyphicon-floppy-remove" style="margin-top:2px!important;" data-html="@item.ICTITLE" data-headerid="@item.ICREQID" data-ctrl-id='reject-asset-request'></button><br />
                                        <button class="btn-xs glyphicon glyphicon-upload" style="margin-top:2px!important;" data-html="@item.ICTITLE" data-content="2" data-headerid="@item.ICREQID" data-ctrl-id='upload-final-document'></button>
                                    }
                                </td>
                            </tr>
                                 }
                                        }
                    <tr id="tricinitiation">
                        <td colspan="10" class="text-left">
                            <input type="button" value="Initiate IC Approval" class="submit btn btn-success" id="btnicinitiation" />
                        </td>
                    </tr>
                </tbody>
            </table>

        </div>
    </div>
</div>
