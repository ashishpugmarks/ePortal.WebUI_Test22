@model ePortal.ViewModels.VPF_CreateDetailViewModel

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    
    <div class="row">
        <div style="height: 2.2em; padding-top: 10px; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <span style="padding-left: 8px;">Edit VPF Contribution Request</span>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="body-content">
                <div class="form-horizontal">
                    @*<h4>VPF_CreateDetailViewModel</h4>*@
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.ID)

                    <table class="table table-bordered table-condensed table-striped table-responsive" style="width:100%">
                        <tr class="info">
                            <td style="width:30%;">
                                @Html.HiddenFor(model => model.REQUESTTYPE)
                                @Html.LabelFor(model => model.REQUESTTYPE, htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                            </td>
                            <td style="width:70%;">
                                <div class="col-md-6">

                                    @if (Model.REQUESTTYPE == 1)
                                    {
                                        @Html.Label("Start")
                                    }
                                    else if (Model.REQUESTTYPE == 2)
                                    {
                                        @Html.Label("Change")
                                    }
                                    else if (Model.REQUESTTYPE == 3)
                                    {
                                        @Html.Label("Stop")
                                    }
                                    else
                                    {
                                        @Html.Label("")
                                    }
                                </div>
                            </td>
                        </tr>
                        <tr class="active">
                            <td style="width:30%;">
                                @Html.LabelFor(model => model.BASICSALARY, htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                            </td>
                            <td style="width:70%;">
                                <div class="col-md-6">
                                    @Html.HiddenFor(model => model.BASICSALARY)
                                    @Html.DisplayFor(model => model.BASICSALARY, new { htmlAttributes = new { @class = "col-md-6" } })
                                    @Html.ValidationMessageFor(model => model.BASICSALARY, "", new { @class = "text-danger" })
                                </div>
                            </td>
                        </tr>
                        <tr class="info">
                            <td style="width:30%;">
                                @Html.LabelFor(model => model.CURRENTVPF, htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                            </td>
                            <td style="width:70%;">
                                <div class="col-md-6">
                                    @Html.HiddenFor(model => model.CURRENTVPF)
                                    @Html.DisplayFor(model => model.CURRENTVPF, new { htmlAttributes = new { @id = "lblPreVPF", @class = "col-md-6" } })
                                    @Html.ValidationMessageFor(model => model.CURRENTVPF, "", new { @class = "text-danger" })
                                </div>
                            </td>
                        </tr>
                        <tr class="active">
                            <td style="width:30%;">
                                @Html.Label("","Previous VPF Amount", htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                            </td>
                            <td style="width:70%;">
                                <div class="col-md-3">
                                    <label id="LblPreviousAMT"></label>
                                </div>
                                @*@Html.LabelFor(model =>model.d, new { htmlAttributes = new { @class = "col-md-1", @id="LblCalcu" }  })*@
                            </td>
                        </tr>
                        <tr class="info">
                            <td style="width:30%;">
                                @Html.LabelFor(model => model.VPFCONTRIBUTION, htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                            </td>
                            <td style="width:70%;">
                                <div class="col-md-2">
                                    @Html.TextBoxFor(model => model.VPFCONTRIBUTION, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.VPFCONTRIBUTION, "", new { @class = "text-danger" })
                                </div>
                            </td>
                        </tr>
                        <tr class="active">
                            <td style="width:30%;">
                                @Html.Label("","VPF Deduction Amount", htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                            </td>
                            <td style="width:70%;">
                                <div class="col-md-6">
                                    <label id="LblCalcu"></label>
                                    @*@Html.LabelFor(model =>model.d, new { htmlAttributes = new { @class = "col-md-1", @id="LblCalcu" }  })*@
                                </div>
                            </td>
                        </tr>
                        <tr class="info">
                            <td style="width:30%;">
                                @Html.LabelFor(model => model.EFFECTIVEDATE, htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                            </td>
                            <td style="width:70%;">
                                <div class="col-md-2">
                                    @*@Html.EditorFor(model => model.EFFECTIVEDATE, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.EFFECTIVEDATE, "", new { @class = "text-danger" })*@
                                    @Html.TextBoxFor(model => model.EFFECTIVEDATE, new { @class = "form-control text-center", @readonly = "readonly" })
                                    @Html.ValidationMessageFor(model => model.EFFECTIVEDATE, "", new { @class = "text-danger" })
                                </div>
                            </td>
                        </tr>
                        <tr class="active">
                            <td colspan="2">
                                <div class="col-md-offset-1 col-md-6 text-center">
                                    <input type="submit" value="Update" class="btn btn-success" />
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        }
    </div>

