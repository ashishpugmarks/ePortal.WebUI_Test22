@model ePortal.ViewModels.VPF_CreateDetailViewModel

@{
    ViewBag.Title = "Cancel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    @*<link href="~/assets/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />*@

    <div class="row">
        <div style="height: 2.2em; padding-top: 10px; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <span style="padding-left: 8px;">Cancel VPF Contribution Request</span>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="body-content">
                <div class="form-horizontal">
                    @*<h4>VPF_CreateDetailViewModel</h4>*@
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.ID)

                    <table class="table table-bordered table-hover table-striped table-responsive" style="width:100%">
                        <tr class="info">
                            <td>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.REQUESTTYPE, htmlAttributes: new { @class = "control-label col-md-3" })
                                    @Html.HiddenFor(model => model.REQUESTTYPE)
                                    <div class="col-md-6" style="margin-top: 8px;">
                                        @if (Model.REQUESTTYPE == 1)
                                        {
                                            @Html.Label("Start")
                                        }
                                        else if (Model.REQUESTTYPE == 2)
                                        {
                                            @Html.Label("Change")
                                        }
                                        else if (Model.REQUESTTYPE == 3)
                                        {
                                            @Html.Label("Stop")
                                        }
                                        else
                                        {
                                            @Html.Label("")
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>

                        <tr class="active">
                            <td>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.BASICSALARY, htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-6" style="margin-top: 8px;">
                                        @Html.HiddenFor(model => model.BASICSALARY)
                                        @Html.DisplayFor(model => model.BASICSALARY, new { htmlAttributes = new { @class = "col-md-6" } })
                                        @Html.ValidationMessageFor(model => model.BASICSALARY, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr class="info">
                            <td>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CURRENTVPF, htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-6" style="margin-top: 8px;">
                                        @Html.HiddenFor(model => model.CURRENTVPF)
                                        @Html.DisplayFor(model => model.CURRENTVPF, new { htmlAttributes = new { @id = "lblPreVPF", @class = "col-md-6" } })
                                        @Html.ValidationMessageFor(model => model.CURRENTVPF, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr class="active">
                            <td>
                                <div class="form-group">
                                    @Html.Label("","Previous VPF Amount", htmlAttributes: new { @class = "control-label col-md-3" })

                                    <div class="col-md-3" style="margin-top: 8px;">
                                        <label id="LblPreviousAMT"></label>
                                    </div>
                                    @*@Html.LabelFor(model =>model.d, new { htmlAttributes = new { @class = "col-md-1", @id="LblCalcu" }  })*@
                                </div>
                            </td>
                        </tr>
                        <tr class="info">
                            <td>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.VPFCONTRIBUTION, htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-6" style="margin-top: 8px;">
                                        @Html.DisplayFor(model => model.VPFCONTRIBUTION, new { htmlAttributes = new { @class = "col-md-6" } })
                                        @Html.HiddenFor(model => model.VPFCONTRIBUTION)

                                        @Html.ValidationMessageFor(model => model.VPFCONTRIBUTION, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr class="active">
                            <td>
                                <div class="form-group">
                                    @Html.Label("","Vpf Deduction Amount", htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-6" style="margin-top: 8px;">
                                        <label id="LblCalcu"></label>
                                        @*@Html.LabelFor(model =>model.d, new { htmlAttributes = new { @class = "col-md-1", @id="LblCalcu" }  })*@
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr class="info">
                            <td>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.EFFECTIVEDATE, htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-6" style="margin-top: 8px;">
                                        @Html.DisplayFor(model => model.EFFECTIVEDATE, "{0:MM/dd/yyyy}", new { htmlAttributes = new { @class = "col-md-9" } })
                                        @Html.HiddenFor(model => model.EFFECTIVEDATE)
                                        @Html.ValidationMessageFor(model => model.EFFECTIVEDATE, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </td>
                        </tr>

                        <tr class="active">
                            <td>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CANCELREMARKS, htmlAttributes: new { @class = "control-label col-md-3" })
                                    <div class="col-md-4" style="margin-top: 8px;">
                                        @Html.TextAreaFor(model => model.CANCELREMARKS, new { @class = "form-control col-md-12" })
                                        @Html.ValidationMessageFor(model => model.CANCELREMARKS, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr class="info">
                            <td>
                                <div>
                                    <div class="col-md-offset-1 col-md-6 text-center">
                                        <input type="submit" value="Submit" class="btn btn-success" />
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        }
    </div>

    @section Scripts{
    @*<script src="~/assets/js/jquery.3.6.3.min.js"></script>
        <script src="~/assets/lib/bootstrap/js/bootstrap.min.js"></script>
        <script src="~/assets/lib/bootstrap/js/bootstrap-datepicker.min.js"></script>*@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

        $(document).ready(function () {
            $('.homeContent').removeClass('homeContent');
            $('#VPFCONTRIBUTION').change(function () {
                var BasicSal = parseInt(@Model.BASICSALARY);
                var VPFCont = $('#VPFCONTRIBUTION').val();
                var CalcuDedu = Math.round(BasicSal / 100) * VPFCont;
                $('#LblCalcu').text(CalcuDedu);
                //var value = $("#LblCalcu").val();
                //var label = $('#LblCalcu').text();
                //var Cal = $('#LblCalcu').val();
                //var month = label.attr('month');

            });

        });


        $(document).ready(function () {
            $('#EFFECTIVEDATE').datepicker({
                //format: "yyyy/mm/dd",
                format: "mm/dd/yyyy",
                //startDate:  new Date(),

                //endDate: "2015-01-01",
                //todayBtn: "linked",
                autoclose: true,
                todayHighlight: true
            });

        });

        $(document).ready(function () {
            var BasicSal = parseInt(@Model.BASICSALARY);
            var VPFCont = $('#VPFCONTRIBUTION').val();
            var CalcuDedu = (BasicSal / 100) * VPFCont;
            $('#LblCalcu').text(CalcuDedu);

            var preVPF = $('#lblPreVPF').text();
            var PreCal = Math.round((BasicSal / 100) * preVPF);
            $('#LblPreviousAMT').text(PreCal);
        });

    </script>

    }
