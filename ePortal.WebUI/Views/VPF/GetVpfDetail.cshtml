@model IEnumerable<ePortal.ViewModels.VPF_CreateDetailViewModel>

@{
    ViewBag.Title = "GetVpfDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <style type="text/css">
        .modal-close {
            color: #aaa;
            position: absolute;
            right: 15px;
            top: 15px;
            padding-top: 3px;
            background: #fff;
            font-size: 16px;
            width: 25px;
            height: 25px;
            font-weight: bold;
            text-align: center;
            cursor: pointer;
        }

            .modal-close:hover {
                color: #333;
            }
    </style>
}
@*<p>
        @Html.ActionLink("Create New", "Create")
    </p>*@

<div class="row">
    <div style="height: 2.2em; padding-top: 10px; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 8px;">VPF Details List</span>
    </div>
    <div class="body-content">

        <table id="tblVpfDetails" class="table table-bordered table-responsive">
            <thead>
                <tr class="info">
                    <td colspan="10">
                        <b class="pull-left">
                            VPF Details List
                        </b>
                    </td>
                    @*<td width="10%">
                            @Html.ActionLink("Create New", "VPF_CreateDetails", null, new { @style = "color:black" })
                        </td>*@
                <tr>
                    <th>
                            @Html.DisplayNameFor(model => model.EMPLOYEECODE)
                    </th>
                    <th>
                            @Html.DisplayNameFor(model => model.REQUESTTYPE)
                    </th>
                    <th>
                            @Html.DisplayNameFor(model => model.VPFCONTRIBUTION)
                    </th>
                    <th>
                            @Html.DisplayNameFor(model => model.EFFECTIVEDATE)
                    </th>
                    <th>
                            @Html.DisplayNameFor(model => model.CANCELREMARKS)
                    </th>

                        @*<th>
                                @Html.DisplayNameFor(model => model.DATEADDED)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.MODIFIEDDATE)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.MODIFIEDBY)
                            </th>*@
                    <th>
                            @Html.DisplayNameFor(model => model.APPROVESTATUS)
                    </th>
                        @*<th>
                                @Html.DisplayNameFor(model => model.APPROVALAUTHID)
                            </th>*@
                    <th>
                            @Html.DisplayNameFor(model => model.APPROVALDATE)
                    </th>
                    <th>
                            @Html.DisplayNameFor(model => model.APPROVALREMARKS)
                    </th>
                    <th>
                            @Html.DisplayNameFor(model => model.STATUS)
                    </th>
                        @*<th>
                                @Html.DisplayNameFor(model => model.BASICSALARY)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.CURRENTVPF)
                            </th>*@
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center" style="width:9%">
                            @Html.DisplayFor(modelItem => item.EMPLOYEECODE)
                        </td>
                        <td class="text-center" style="width:9%">
                            @if (item.REQUESTTYPE == 1)
                            {
                                @Html.Label("Start")
                            }
                            else if (item.REQUESTTYPE == 2)
                            {
                                @Html.Label("Change")
                            }
                            else if (item.REQUESTTYPE == 3)
                            {
                                @Html.Label("Stop")
                            }
                            else
                            {
                                @Html.Label("")
                            }
                        </td>
                        <td class="text-center" style="width:11%">
                            @Html.DisplayFor(modelItem => item.VPFCONTRIBUTION)
                        </td>
                        <td class="text-center" style="width:10%">
                            @Html.DisplayFor(modelItem => item.EFFECTIVEDATE)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CANCELREMARKS)
                        </td>

                        @*<td>
                                    @Html.DisplayFor(modelItem => item.DATEADDED)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MODIFIEDDATE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MODIFIEDBY)
                                </td>*@
                        <td class="text-center">
                            @if (item.APPROVESTATUS == 0)
                            {
                                @Html.Label("Rejected by IR")
                            }
                            else if (item.APPROVESTATUS == 1)
                            {
                                @Html.Label("Approved by IR")
                            }
                            else
                            {
                                @Html.Label("")
                            }
                        </td>
                        @*<td>
                                    @Html.DisplayFor(modelItem => item.APPROVALAUTHID)
                                </td>*@
                        <td>
                            @Html.DisplayFor(modelItem => item.APPROVALDATE)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.APPROVALREMARKS)
                        </td>
                        <td class="text-center">
                            @if (item.STATUS == 0)
                            {
                                <button class="btn btn-danger btn-xs" style="cursor: text !important">Cancelled</button>
                            }
                            else if (item.STATUS == 1)
                            {
                                <button class="btn btn-success btn-xs" style="cursor: text !important">Active</button>
                            }
                            else
                            {
                                @Html.Label("")
                            }
                        </td>
                        @*<td>
                                    @Html.DisplayFor(modelItem => item.BASICSALARY)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CURRENTVPF)
                                </td>*@
                        <td class="text-center" style="width:10%">

                            @if (item.STATUS == 0)
                            {
                                <span class="text-danger">Cancelled by User</span>
                            }
                            @*else
                                    {

                                    }*@

                            else if (item.APPROVESTATUS == 0)
                            {
                                <span class="text-danger">Rejected by IR</span>
                            }
                            else if (item.APPROVESTATUS == 1)
                            {
                                <span class="text-success">Approved by IR</span>
                            }
                            else
                            {
                                @Html.ActionLink(" ", "Edit", new { id = item.ID }, new { @class = "btn glyphicon glyphicon-edit text-primary" })

                                @Html.ActionLink(" ", "Cancel", new { id = item.ID }, new { @class = "btn glyphicon glyphicon-remove text-danger" })
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>
<div id="myModal" class="modal">
    <div class="modal-dialog" style="margin-top: 160px;">
        <div class="modal-content" style="background-color:#d2f5f4;">
            <label id="closbtn" class="modal-close" for="modal-toggle">&#x2715;</label>
            <div id="myModalContent"></div>
        </div>
    </div>
</div>
@*@Scripts.Render("~/bundles/jquery")
        @Scripts.Render("~/bundles/bootstrap")*@

@section Scripts{
@* <script src="~/lib/bootstrap/js/bootstrap.min.js"></script> *@
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    function openCreatePopup(current) {
        var $buttonClicked = $(this);
        var options = {
            "backdrop": "static",
            keyboard: true
        };
        $.ajax({
            type: "GET",
            url: "/PresidentDesk/CreatePresidentMessages",
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            success: function (data) {
                $('#myModalContent').html(data);
                $('#myModal').modal(options);
                $('#myModal').modal('show');
            },
            error: function () {
                alert("Content load failed.");
            }
        });
    }
    function openEditPopup(current) {
        var $buttonClicked = $(this);
        var options = {
            "backdrop": "static",
            keyboard: true
        };
        $.ajax({
            type: "GET",
            url: "/PresidentDesk/Edit",
            data: { id: current.id },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            success: function (data) {
                $('#myModalContent').html(data);
                $('#myModal').modal(options);
                $('#myModal').modal('show');
            },
            error: function () {
                alert("Content load failed.");
            }
        });
    }
    function openImagePopup(current) {
        var $buttonClicked = $(this);
        var options = {
            "backdrop": "static",
            keyboard: true
        };
        $('#myModalContent').html('<img src="' + current.id + '" />');
        $('#myModal').modal(options);
        $('#myModal').modal('show');
    }
    $("#closbtn").click(function () {
        $('#myModal').modal('hide');
    });
</script>
    @* <script src="~/js/jquery.3.6.3.min.js"></script> *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#tblVpfDetails').DataTable({
                "pagingType": "full_numbers",
                "bPaginate": true,
                "bInfo": false,
                "bFilter": true,
                "bLengthChange": false,
                "iDisplayLength": 10,
            });
            $('.homeContent').removeClass('homeContent');
            $('.dataTables_length').addClass('bs-select');
            $('.input-sm').removeClass('input-sm');
            $(".homeContent").removeClass("homeContent");
            //$(".container-fluid").removeClass("container-fluid");
        });
    </script>

}
