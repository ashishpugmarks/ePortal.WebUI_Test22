    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('.homeContent').removeClass('homeContent');
            if ($("input[name='REQUESTTYPE']:checked").val() != null) {
                if ($("input[name='REQUESTTYPE']:checked").val() == 3) {
                    $('#VPFCONTRIBUTION').attr("readonly", "true");
                    $("#VPFCONTRIBUTION").rules("remove", "required");
                }
                else {
                    $('#VPFCONTRIBUTION').removeAttr("readonly");
                    $('#VPFCONTRIBUTION').rules("add", "required");
                }
            };
            $('#VPFCONTRIBUTION').change(function () {
                var VPFCont = $('#VPFCONTRIBUTION').val();

                if (VPFCont < 6 || VPFCont > 100) {
                    $('#LblCalcu').text('Contribution be between 6% and 100%"');
                    return;
                }
                else {
                    var BasicSal = parseInt(@Model.BASICSALARY);
                    var CalcuDedu = Math.round((BasicSal / 100) * VPFCont);
                    $('#LblCalcu').text(CalcuDedu);
                    //var value = document.getElementById("BASICSALARY").value;
                    //var CalcuDedu = Math.round((value / 100) * VPFCont);
                    //$('#LblCalcu').text(CalcuDedu);
                    //var value = $("#LblCalcu").val();
                    //var label = $('#LblCalcu').text();
                    //var Cal = $('#LblCalcu').val();
                    //var month = label.attr('month');
                }
            });
            $('input[type=radio]').change(function () {
                if ($("input[name='REQUESTTYPE']:checked").val() != null) {
                    if ($("input[name='REQUESTTYPE']:checked").val() == 3) {
                        $('#VPFCONTRIBUTION').attr("readonly", "true");
                        $("#VPFCONTRIBUTION").rules("remove", "required");
                    }
                    else {
                        $('#VPFCONTRIBUTION').removeAttr("readonly");
                        $('#VPFCONTRIBUTION').rules("add", "required");
                    }
                }
            });

            $('#myBtn').click(function () {
                debugger;
                if ($('#CURRENTVPF').val() != 0 && $("input[name='REQUESTTYPE']:checked").val() == 1) {
                    alert('VPF Contribution already started')
                    return false;
                }
                else if ($('#CURRENTVPF').val() == 0 && $("input[name='REQUESTTYPE']:checked").val() == 2) {
                    alert('VPF Contribution not started')
                    return false;
                }
                else if ($('#CURRENTVPF').val() == 0 && $("input[name='REQUESTTYPE']:checked").val() == 3) {
                    alert('VPF Contribution not started')
                    return false;
                }
                else {
                    return true;
                }
            });
        });

        $(document).ready(function () {
            var BasicSal = parseInt(@Model.BASICSALARY);
            var VPFCont = $('#VPFCONTRIBUTION').val();
            var CalcuDedu = Math.round((BasicSal / 100) * VPFCont);
            $('#LblCalcu').text(CalcuDedu);
            var preVPF = $('#CURRENTVPF').val();
            var PreCal = Math.round((BasicSal / 100) * preVPF);
            $('#LblPreviousAMT').text(PreCal);
        });

