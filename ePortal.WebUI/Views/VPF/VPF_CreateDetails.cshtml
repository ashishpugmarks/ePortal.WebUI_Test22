@model ePortal.ViewModels.VPF_CreateDetailViewModel

@{
    ViewBag.Title = "VPF_CreateDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*<link href="~/assets/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />*@


<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">VPF Contribution Request</div>
    </div>
    <div class="body-content" style="overflow-x:auto!important;">

        @using (Html.BeginForm(new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <table class="table table-bordered table-condensed table-striped table-responsive" style="width:100%">
                    <tr class="info">
                        <td style="width:30%;">
                            @Html.LabelFor(model => model.REQUESTTYPE, htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                        </td>
                        <td style="width:70%;">
                            <div class="col-md-2">
                                @Html.RadioButtonFor(model => model.REQUESTTYPE, "1", htmlAttributes: new { @class = "" })
                                @Html.Label("", "Start", htmlAttributes: new { @class = "" })
                            </div>
                            <div class="col-md-2">
                                @Html.RadioButtonFor(model => model.REQUESTTYPE, "2", htmlAttributes: new { @class = "" })
                                @Html.Label("", "Change", htmlAttributes: new { @class = "" })
                            </div>
                            <div class="col-md-2">
                                @Html.RadioButtonFor(model => model.REQUESTTYPE, "3", htmlAttributes: new { @class = "" })
                                @Html.Label("", "Stop", htmlAttributes: new { @class = "" })
                            </div>
                            @Html.ValidationMessageFor(model => model.REQUESTTYPE, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr class="active">
                        <td style="width:30%;">
                            @Html.LabelFor(model => model.BASICSALARY, htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                        </td>
                        <td style="width:70%;">
                            <div class="col-md-3">
                                @Html.HiddenFor(model => model.BASICSALARY)
                                @Html.DisplayFor(model => model.BASICSALARY, new { htmlAttributes = new { @class = "col-md-6" } })
                                @Html.ValidationMessageFor(model => model.BASICSALARY, "", new { @class = "text-danger" })
                            </div>
                        </td>
                    </tr>

                    <tr class="info">
                        <td style="width:30%;">
                            @Html.LabelFor(model => model.CURRENTVPF, htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                        </td>
                        <td style="width:70%;">
                            <div class="col-md-3">
                                @Html.HiddenFor(model => model.CURRENTVPF)
                                @Html.DisplayFor(model => model.CURRENTVPF, new { htmlAttributes = new { @id = "lblPreVPF", @class = "col-md-6" } })
                                @Html.ValidationMessageFor(model => model.CURRENTVPF, "", new { @class = "text-danger" })
                            </div>
                        </td>
                    </tr>
                    <tr class="active">
                        <td style="width:30%;">
                            @Html.Label("", "Previous VPF Amount", htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                        </td>
                        <td style="width:70%;">
                            <div class="col-md-3">
                                <label id="LblPreviousAMT"></label>
                            </div>
                            @*@Html.LabelFor(model =>model.d, new { htmlAttributes = new { @class = "col-md-1", @id="LblCalcu" }  })*@
                        </td>
                    </tr>
                    <tr class="info">
                        <td style="width:30%;">
                            @Html.LabelFor(model => model.VPFCONTRIBUTION, htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                        </td>
                        <td style="width:70%;">
                            <div class="col-md-2">
                                @Html.TextBoxFor(model => model.VPFCONTRIBUTION, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.VPFCONTRIBUTION, "", new { @class = "text-danger" })
                            </div>
                        </td>
                    </tr>
                    <tr class="active">
                        <td style="width:30%;">
                            @Html.Label("", "Current VPF Deduction Amount", htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                        </td>
                        <td style="width:70%;">
                            <div class="col-md-3">
                                <label id="LblCalcu"></label>
                                @*@Html.LabelFor(model =>model.d, new { htmlAttributes = new { @class = "col-md-1", @id="LblCalcu" }  })*@
                            </div>
                        </td>
                    </tr>
                    <tr class="info">
                        <td style="width:30%;">
                            @Html.LabelFor(model => model.EFFECTIVEDATE, htmlAttributes: new { @class = "control-label col-md-8 pull-right" })
                        </td>
                        <td style="width:70%;">
                            <div class="col-md-2">
                                @Html.TextBoxFor(model => model.EFFECTIVEDATE, new { @class = "form-control text-center", @readonly = "readonly" })
                            </div>
                        </td>
                    </tr>

                    <tr class="active">
                        <td colspan="2" style="text-align:center">
                            <div class="col-md-offset-3 col-md-3">
                                <input type="submit" value="Submit" id="myBtn" class="btn btn-success" />
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        }

        @*<div>
                    @Html.ActionLink("Back to List", "Index")
                </div>*@

        @if (ViewBag.Message != null)
        {
            <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
                window.onload = function () {
                    alert("@ViewBag.Message");
                };
            </script>

        }
    </div>
</div>
