@model ePortal.ViewModels.VPF_CreateDetailViewModel

@{
    ViewBag.Title = "IRVpfDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*<h2>VPF Detail</h2>*@
    <meta name="viewport" content="width=device-width" />
   
    <div class="row">
        <div style="height: 2.2em; padding-top: 10px; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <span style="padding-left: 8px;">VPF Details for Approval</span>
        </div>
        <div class="body-content" style="overflow-x:auto!important;">
            @using (Html.BeginForm("IRVpfDetail", "VPF", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <table class="table table-bordered table-hover table-striped table-responsive" style="width:100%">
                    <thead>
                        <tr class="info">
                            <th colspan="10">
                                <b class="pull-left">Search</b>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="row">
                                    <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
                                        <div class="col-xs-6 col-sm-3 col-md-3 col-lg-4">
                                            @Html.Label("From Date")
                                        @Html.EditorFor(model => model.SearchViewModel.FromDate, new { htmlAttributes = new { @id = "dpFromDate", @class = "form-control", placeholder = "dd-mm-yyyy", @type = "text" } })
                                        </div>

                                        <div class="col-xs-6 col-sm-3 col-md-3 col-lg-4">
                                            @Html.Label("To Date")
                                        @Html.EditorFor(model => model.SearchViewModel.ToDate, new { htmlAttributes = new { @id = "dpToDate", @class = "form-control", placeholder = "dd-mm-yyyy", @type = "text" } })
                                        </div>


                                    </div>

                                    <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
                                        <div class="col-xs-6 col-sm-3 col-md-3 col-lg-4">
                                            @Html.Label("Emp-Code")
                                            @Html.EditorFor(model => model.SearchViewModel.EmployeeCode, new { htmlAttributes = new { @id = "dpEmployee", @class = "form-control" } })
                                        </div>
                                        <div class="col-xs-6 col-sm-3 col-md-3 col-lg-4">
                                            @Html.Label("Status")
                                            @Html.DropDownListFor(x => x.SearchViewModel.Status, new List<SelectListItem>
                                        {
                                        new SelectListItem() {Text = "All", Value=""},
                                        new SelectListItem() {Text = "Pending", Value="2", Selected=true},
                                        new SelectListItem() {Text = "Rejected", Value="0"},
                                        new SelectListItem() {Text = "Approved", Value="1"}
                                        }, new { @id = "ddStatus", @class = "form-control" } )
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
                                        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="margin-top:20px;">
                                            <div class="form-group">
                                                <input type="submit" value="Search" name="type" class="btn btn-info" />
                                                <input type="submit" value="Export-to-Excel" name="type" class="btn btn-primary" />
                                                @*<button value="Excel" name="type" id="btnExcel" class="btn btn-primary" formaction="IRVpfDetail">Export to Excel</button>*@
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            }
            <table id="tblVpfDetails" class="table table-bordered table-responsive">
                @*<tr class="info">
                    <td colspan="12">
                        <b class="pull-left">
                            VPF Details for IR Approval
                        </b>
                        <b class="pull-right">
                            <button class="btn btn-primary btn-sm" onclick="openCreatePopup(this);">Create New</button>*@
                @*@Html.ActionLink("Create New", "CreatePresidentMessages", null, new { @style = "color:white" })*@
                @*</b>
                        </td>
                    </tr>*@
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.EMPLOYEECODE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.FIRSTNAME)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.REQUESTTYPE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.VPFCONTRIBUTION)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.EFFECTIVEDATE)
                        </th>
                        @*
                            <th>
                                @Html.DisplayNameFor(model => model.ADDEDBY)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.STATUS)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.DATEADDED)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.MODIFIEDDATE)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.MODIFIEDBY)
                            </th>*@
                        @*
                            <th>
                                @Html.DisplayNameFor(model => model.APPROVESTATUS)
                            </th>*@
                        @*
                            <th>
                                @Html.DisplayNameFor(model => model.APPROVALAUTHID)
                            </th>*@
                        <th>
                            @Html.DisplayNameFor(model => model.APPROVALDATE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.APPROVALREMARKS)
                        </th>
                        @*
                            <th>
                                @Html.DisplayNameFor(model => model.BASICSALARY)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.CURRENTVPF)
                            </th>*@
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.VPF_List)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.EMPLOYEECODE)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FIRSTNAME)
                                @Html.Label(" ")
                                @Html.DisplayFor(modelItem => item.LASTNAME)
                            </td>
                            <td>
                                @if (item.REQUESTTYPE == 1)
                                {
                                    @Html.Label("Start")
                                }
                                else if (item.REQUESTTYPE == 2)
                                {
                                    @Html.Label("Change")
                                }
                                else if (item.REQUESTTYPE == 3)
                                {
                                    @Html.Label("Stop")
                                }
                                else
                                {
                                    @Html.Label("")
                                }
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.VPFCONTRIBUTION)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.EFFECTIVEDATE)
                            </td>
                            @*
                                <td>
                                    @Html.DisplayFor(modelItem => item.ADDEDBY)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.STATUS)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.DATEADDED)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MODIFIEDDATE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MODIFIEDBY)
                                </td>*@
                            @*
                                <td>
                                    @if (item.APPROVESTATUS == 0)
                                    {
                                    @Html.Label("Reject")
                                    }
                                    else if (item.REQUESTTYPE == 1)
                                    {
                                    @Html.Label("Approve")
                                    }
                                    else
                                    {
                                    @Html.Label("Pending")
                                    }
                                </td>*@
                            @*
                                <td>
                                    @Html.DisplayFor(modelItem => item.APPROVALAUTHID)
                                </td>*@
                            <td>
                                @Html.DisplayFor(modelItem => item.APPROVALDATE)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.APPROVALREMARKS)
                            </td>
                            @*
                                <td>
                                    @Html.DisplayFor(modelItem => item.BASICSALARY)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CURRENTVPF)
                                </td>*@
                            <td>
                                @if (item.APPROVESTATUS == 0)
                                {
                                    @Html.Label("Rejected")
                                }
                                else if (item.APPROVESTATUS == 1)
                                {
                                    @Html.Label("Approved")
                                }
                                else
                                {
                                    @Html.ActionLink("Approve/Reject", "Approve", new { id = item.ID })
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

    </div>
    @section Scripts{
    @* <script src="~/js/jquery.3.6.3.min.js"></script> *@
    @* <script src="~/lib/bootstrap/js/bootstrap.min.js"></script> *@
    @* <script src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script> *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#dpFromDate').datepicker({
                //format: "yyyy/mm/dd",
                format: "dd-mm-yyyy",
                //startDate:  new Date(),

                //endDate: "2015-01-01",
                //todayBtn: "linked",
                autoclose: true,
                todayHighlight: true
            });
             $('#dpToDate').datepicker({
                //format: "yyyy/mm/dd",
                format: "dd-mm-yyyy",
                //startDate:  new Date(),

                //endDate: "2015-01-01",
                //todayBtn: "linked",
                autoclose: true,
                todayHighlight: true
            });
             $('#tblVpfDetails').DataTable({
                "pagingType": "full_numbers",
                "bPaginate": true,
                "bInfo": false,
                "bFilter": true,
                "bLengthChange": false,
                "iDisplayLength": 10
            });
            $('.dataTables_length').addClass('bs-select');
            $('.input-sm').removeClass('input-sm');
            $(".homeContent").removeClass("homeContent");
            //$(".container-fluid").removeClass("container-fluid");
        });

        
    </script>
    }