<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/font-awesome.css" />
    <link rel="stylesheet" href="~/fancybox/jquery.fancybox.css" />

    <link rel="stylesheet" href="~/css/loading_spinner.css" />

    <link href="~/css/jquery-uii.css" rel="stylesheet" />
    <link href="~/css/sweetalert.css" rel="stylesheet" />

    <style nonce="@Context.Items["StyleNonce_0"]">
        .textcenter {
            text-align: center !important;
        }

        .textright{
            text-align:right;
        }

        .row {
            display: flex !important;
        }

        .textcenter {
            text-align: center !important;
            vertical-align: middle !important;
        }

        .ui-autocomplete {
            max-height: 200px;
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 99999;
        }

        .alert-error {
            background-color: antiquewhite;
            margin-left: 15px;
            margin-right: 15px;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }
         a {
                cursor: pointer !important;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <div id="menu_div">
        <div class="container-fluid homeContent">
            @RenderBody()
        </div>
    </div>

    <div id="loader_new" class="loading hidden overlayer">
        <div class="loading-text">
            <span class="loading-text-words">L</span>
            <span class="loading-text-words">O</span>
            <span class="loading-text-words">A</span>
            <span class="loading-text-words">D</span>
            <span class="loading-text-words">I</span>
            <span class="loading-text-words">N</span>
            <span class="loading-text-words">G</span>
        </div>
    </div>

    <script src="~/js/jquery.3.6.3.min.js"></script>
    <script src="~/js/jquery-ui.min.js"></script>

    <script src="~/fancybox/jquery.fancybox.js"></script>
    <script src="~/js/sweetalert.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
