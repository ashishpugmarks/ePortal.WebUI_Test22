@using Microsoft.AspNetCore.Http

@{
    var userName = Context.Session.GetString("userName");
    var idleTimeoutMinutes = Context.Session.GetString("IdleTimeoutMinutes");
}

<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    @* Bundle CSS files  *@
    <link rel="stylesheet" href="~/bundle/style.min.css" />

    <link type="text/css" rel="stylesheet" href="~/css/home.css">
    <link type="text/css" rel="stylesheet" href="~/css/megamenu.css">

    @*------------------------------- /// Aumento chnages- VISHAL -  30-12-2023 - Start ---------------------------*@
    <link href="~/css/font-awesome.css" rel="stylesheet" />
    <link href="~/fancybox/jquery.fancybox.css" rel="stylesheet" />

    @*------------------------------- /// Aumento chnages- VISHAL -  30-12-2023 - End ---------------------------*@


    @RenderSection("Styles", required: false)

    @* Bundle JS files  *@
    <script src="~/bundle/jquery.min.js"></script>

    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        var sessionTimeoutWarning = "5";            
        var sessionTimeout = @idleTimeoutMinutes;
        var timeOnPageLoad = new Date();
        var sessionWarningTimer = null;
        var redirectToWelcomePageTimer = null;

        //For warning
        var sessionWarningTimer = setTimeout(SessionWarning, (parseInt(sessionTimeout) - parseInt(sessionTimeoutWarning))* 60 * 1000);

        //Session Warning
        function SessionWarning() {
            //minutes left for expiry
            var cTime = new Date();
            var minutesForExpiry =  (parseInt(sessionTimeout) - parseInt(sessionTimeoutWarning));
            var message = "Your session will expire in another " + sessionTimeoutWarning + " min(s) from now ie. "+ cTime.toLocaleString() +" . Do you want to extend the session?";
            answer = confirm(message);

           // debugger;
            if(answer)
            {
                var currentTime = new Date();
                var timeForExpiry = timeOnPageLoad.setMinutes(timeOnPageLoad.getMinutes() + parseInt(sessionTimeout));
                if(Date.parse(currentTime) > timeForExpiry)
                {
                    // swal({
                    //     title: "",
                    //     text: "Session expired",
                    //     type: "warning",
                    // });

                    //Added By TTL against CR6695 as on 29 - 07 - 2025
                     swal({ title: "", text: "Sorry, Your session has expired. Please login again", type: "warning", },
                        function (isConfirm) {
                            if (isConfirm) { window.location='/TokenBridge/OldLogin'; }
                        });
                }
                else
                {
                    var img = new Image(1, 1);
                    img.src = '@Url.Action("KeepSessionAlive", "Home")' + '?date=' + encodeURIComponent(new Date());
                    timeOnPageLoad =  new Date();
                    sessionWarningTimer = setTimeout(SessionWarning, (parseInt(sessionTimeout) - parseInt(sessionTimeoutWarning))* 60 * 1000);
                }
            }
            else
            {
                //if the session time is over. Then exit the session.
                var currentTime = new Date();
                var timeForExpiry = timeOnPageLoad.setMinutes(timeOnPageLoad.getMinutes() + parseInt(sessionTimeout));
                if(Date.parse(currentTime) > timeForExpiry)
                {
                    // swal({
                    //     title: "",
                    //     text: "Session expired",
                    //     type: "warning",
                    // });

                    //Added By TTL against CR6695 as on 29 - 07 - 2025
                     swal({ title: "", text: "Sorry, Your session has expired. Please login again", type: "warning", },
                        function (isConfirm) {
                            if (isConfirm) { window.location='/TokenBridge/OldLogin'; }
                        });
                }
            }
        }

        $(function () {
            $.ajaxPrefilter(function (options, originalOptions, jqXHR) {
                let error = options.error;
                options.error = function (jqXHR, textStatus, errorThrown) {
                    // global error handling first
                    if(jqXHR.status == 401){
                        swal({ title: "", text: "Sorry, Your session has expired. Please login again", type: "warning", },
                        function (isConfirm) {
                            if (isConfirm) { //window.location = '/Login'; 
                            window.location='/TokenBridge/OldLogin'; //Added By TTL against CR6695 as on 29 - 07 - 2025
                            }
                        });
                    }
                    else{
                        // override local error handling if exists
                        if ($.isFunction(error)) {
                            return $.proxy(error, this)(jqXHR, textStatus, errorThrown);
                        }
                    }
                };
            });
        });
    </script>
</head>
<body>
