@model ePortal.ViewModels.CreativeMasterViewModel

<style type="text/css" nonce="@Context.Items["StyleNonce_8"]">
    .scrollit {
        overflow-y: auto;
        max-height: 100px;
    }
</style>

<div>
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.CM_PROCESS_MST.PROCESS_NAME)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.CM_PROCESS_MST.PROCESS_NAME)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.SUBJECT)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.SUBJECT)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.BRIEF)
        </dt>

        <dd class="scrollit">
            @Html.DisplayFor(model => model.BRIEF)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.START_DATE)
        </dt>

        <dd class="scrollit">
            @Html.DisplayFor(model => model.START_DATE)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.END_DATE)
        </dt>

        <dd class="scrollit">
            @Html.DisplayFor(model => model.END_DATE)
        </dd>


        <dt hidden>
            @Html.DisplayNameFor(model => model.DESCRIPTION)
        </dt>

        <dd hidden>
            <div class="scrollit">
                @Html.DisplayFor(model => model.DESCRIPTION)
            </div>
        </dd>
        @*<hr />*@
        @*<dt>
                @Html.DisplayNameFor(model => model.START_DATE)
            </dt>

            <dd class="scrollit">
                <div class="col-md-12">
                    <div class="col-md-3 ">
                        @Html.DisplayFor(model => model.START_DATE)
                    </div>
                    <div class="col-md-4">
                        <label>@Html.DisplayNameFor(model => model.END_DATE)</label>
                    </div>
                    <div class="col-md-3">
                        @Html.DisplayFor(model => model.END_DATE)
                    </div>
                    <div class="col-md-2">
                    </div>
                </div>
            </dd>*@

        @*<dt>
            </dt>

            <dd>
            </dd>*@
        <hr />
        <dt>
            @Html.DisplayNameFor(model => model.BANNER_CONTENTTYPE)
        </dt>

        <dd>
            @if (Model.BANNER != null)
            {               

            var base64 = Convert.ToBase64String(@Model.BANNER);
            var imgSrc = String.Format("data:" + @Model.BANNER_CONTENTTYPE + ";base64,{0}", base64);
            <div>
                <img src="@imgSrc" alt="" width="380" height="200">               
            </div>
            <span>( @Html.DisplayFor(model => model.BANNER_NAME).</span>
            <span>@Html.DisplayFor(model => model.BANNER_CONTENTTYPE) )</span>
            @Html.ActionLink("Download", "Download", "CorporateNews", new { id = Model.ATTACHMENTID, type = "BANNER" }, null)
            }
            else
            {
                <span>N/A</span>
            }
        </dd>      
        <dt>
            @Html.DisplayNameFor(model => model.ATTACHMENT1_CONTENTTYPE)
        </dt>

        <dd>
            @if (Model.ATTACHMENT1 != null)
            {               
            var base64_1 = Convert.ToBase64String(@Model.ATTACHMENT1);
            var VideoSrc1 = String.Format("data:" + @Model.ATTACHMENT1_CONTENTTYPE + ";base64,{0}", base64_1);
            <div>

                <video width="380" height="200" controls>
                    <source src="@VideoSrc1" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            </div>
            <span>( @Html.DisplayFor(model => model.ATTACHMENT1_NAME).</span>
            <span>@Html.DisplayFor(model => model.ATTACHMENT1_CONTENTTYPE) )</span>
            @Html.ActionLink("Download", "Download", "CorporateNews", new { id = Model.ATTACHMENTID, type = "Attachment1" }, null)
            }
            else
            {
                <span>N/A</span>
            }
        </dd>        
        <dt hidden>
            @Html.DisplayNameFor(model => model.ATTACHMENT2_CONTENTTYPE)
        </dt>

        <dd hidden>
            @if (Model.ATTACHMENT2 != null)
            {
                @Html.ActionLink("Download", "Download", "CorporateNews", new { id = Model.ATTACHMENTID, type = "Attachment2" }, null)               
                <span>( @Html.DisplayFor(model => model.ATTACHMENT2_NAME).</span>
                <span>@Html.DisplayFor(model => model.ATTACHMENT2_CONTENTTYPE) )</span>
            }
            else
            {
                <span>N/A</span>
            }
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.APPAUTH1_ECODE)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.APPAUTH1_User)
            <b>@Html.DisplayFor(model => model.AppAuth1_status)</b>
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.APPAUTH2_ECODE)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.APPAUTH2_User)
            <b>@Html.DisplayFor(model => model.AppAuth2_status)</b>
        </dd>        
        <hr />
        <dt>
            @Html.DisplayNameFor(model => model.CREATED_DATE)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.CREATED_DATE)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.CREATED_BY)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.User_Name)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.STATUS)
        </dt>

        <dd>
            @if (Model.STATUS == 1)
            {
                <button class="btn btn-success btn-xs" style="cursor: text !important;">Active (After Approval) </button>
            }
            else if (Model.STATUS == 2)
            {
                <button class="btn btn-warning btn-xs" style="cursor: text !important">WIP (Pending for Approval)</button>
            }
            else if (Model.STATUS == 0)
            {
                <button class="btn btn-danger btn-xs" style="cursor: text !important;">Deactive</button>
            }
            else if (Model.STATUS == 3)
            {
                <button class="btn btn-danger btn-xs" style="cursor: text !important;">Rejected By Approval Authority</button>
            }
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.INITIATOR_REMARKS)
        </dt>

        <dd class="scrollit">
            @Html.DisplayFor(model => model.INITIATOR_REMARKS)
        </dd>
        <hr />        
    </dl>
</div>
