        function OpenDoc(current) {
            var _pdfPath = $(current).attr('data-path');
            var _pdfName = $(current).attr('data-name');
            var width = screen.width - 100;
            var height = screen.height - 100;
            var winTop = 50;
            var winLeft = 50;
            var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
            window.open(_pdfPath, _pdfName, windowFeatures);
        };

        function GetNext(IOMID_V) {
            var IOMIDCURR = IOMID_V;
            debugger;
            if (IOMIDCURR != "") {
                $.ajax({
                    type: "GET",
                    url: "/IOM/IOMNextApproval",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { IOMID_PARAM: IOMIDCURR },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data != "") {
                            window.location.href = "/IOM/IOMApproval?id=" + data;
                        }
                        else {
                            window.location.href = "/ASPXView/ManageApproval.aspx";
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        window.location.href = "/ASPXView/ManageApproval.aspx";
                    }
                });
            }
        }
    </script>

