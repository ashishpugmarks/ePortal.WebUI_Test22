					<tbody>
						<tr>
							<td class="text-right">
								<b>ki<span style="color: #ff0000">*</span></b>
							</td>
							<td class="col-md-3">
								@Html.DropDownList("SYKIID", ViewBag.SYKIData as SelectList, new { @class = "form-control", @required = "required" })
								@Html.ValidationMessageFor(m => m.SYKIID, "", new { @class = "text-danger" })
							</td>
							<td class="text-right">
								<b>Start Date<span style="color: #ff0000">*</span></b>
							</td>
							<td class="col-md-3">
								@Html.TextBoxFor(x => x.StartDate, new { @readonly = "readonly", @class = "form-control sDate", @placeholder = "dd/mm/yyyy", @required = "required" })
								@Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })

							</td>
							<td class="text-right">
								<b>End Date<span style="color: #ff0000">*</span></b>
							</td>
							<td class="col-md-3">
								@Html.TextBoxFor(x => x.EndDate, new { @readonly = "readonly", @class = "form-control eDate", @placeholder = "dd/mm/yyyy", @required = "required" })
								@Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })

							</td>
						</tr>
						<tr>
							<td colspan="10" style="text-align:center;">
