	<script type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
		$("#BtnCancel").click(function () {
			location.reload(true);

		});
	</script>





	<script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
		//$(document).ready(function () {
		//    debugger;
		//    $('#Schedulersss').val(" ");

		//});

		$("#btnSubmit").click(function () {
			debugger;
			var sdate = $('#StartDate').val();
			var edate = $('#EndDate').val();

			if ($('#SYKIID').val() == "") {
				alert('Please select ki.');
				return false;
			}

			else if (sdate == "") {
				alert('Please enter start date.');
				return false;
			}
			else if (edate == "") {
				alert('Please enter end date.');
				return false;
			}
			else {
				var sdate = moment($('#StartDate').val(), 'DD-MM-YYYY');
				var edate = moment($('#EndDate').val(), 'DD-MM-YYYY');
				var a = new Date(sdate);
				var b = new Date(edate);

				if (a > b) {
					alert('End date should be greater than start date.');
					return false;
				}

			}

		});
	</script>


	<script type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
		$('#btnSubmit').on('click', function () {
			$('form').validate();
			if ($('form').valid())
				$(this).button('loading'); // button text will be "Submitting!"
		});
		$(document).ready(function () {
