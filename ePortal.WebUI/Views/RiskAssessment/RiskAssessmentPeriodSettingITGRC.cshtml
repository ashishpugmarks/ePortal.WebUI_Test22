					<h4 class="modal-title"> Risk Assessment - Period extend for Current Ki</h4>
				</div>
			</div>
			<div class="modal-body">
				<h5><b><span id="Titlecc"></span></b></h5>
				@Html.Partial("~/Views/RiskAssessment/_RiskAssessmentPeriodSettingITGRCBulkUpdate.cshtml", new ePortal.ViewModels.BulkUpdatePeriod())
			</div>
		</div>
