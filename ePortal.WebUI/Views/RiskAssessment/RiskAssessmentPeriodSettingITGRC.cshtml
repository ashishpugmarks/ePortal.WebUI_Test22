	<form asp-action="RiskAssessmentPeriodSettingITGRC" asp-controller="RiskAssessment"
		  method="post" enctype="multipart/form-data" id="RiskPeriodSettingITGRC">
		<br />
		<div asp-validation-summary="ModelOnly" class="text-danger"></div>
		<input asp-for="ID" type="hidden" />
		<input asp-for="ActionType" type="hidden" />

