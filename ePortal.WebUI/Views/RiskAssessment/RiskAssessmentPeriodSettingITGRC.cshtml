									<tr>
										<td style="border:1px solid;text-align:center;">@index</td>
										<td style="border:1px solid;text-align:center;">@item.SYKI</td>
										<td style="border:1px solid;text-align:center;">@item.OperationName</td>
										<td style="border:1px solid;text-align:center;">@item.DivisionName</td>
										<td style="border:1px solid;text-align:center;">@Convert.ToDateTime(@item.StartDate).ToString("dd/MM/yyyy")</td>
										<td style="border:1px solid;text-align:center;">@Convert.ToDateTime(@item.EndDate).ToString("dd/MM/yyyy")</td>
