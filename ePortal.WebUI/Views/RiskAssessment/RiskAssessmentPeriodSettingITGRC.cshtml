</div>


@section Scripts {
	<script src="~/bundle/jqueryval.min.js"></script>
	<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
		$(document).ready(function () {
			$('#GetData').DataTable({
				lengthMenu: [
					[10, 25, 50, -1],
					[10, 25, 50, 100],
				],
			});
		});
	</script>

	@*<script src="https://code.jquery.com/jquery-3.1.0.min.js"></script>*@


	<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
		var Ids = [];
		$('#GetData tbody').on('click', 'input[type="checkbox"]', function (e) {
			debugger;
			if (this.checked) {
				Ids.push($(this).val());
			}
			else {
				Ids = arrayRemove(Ids, $(this).val());
			}
		})

		function arrayRemove(arr, value) {
			return arr.filter(function (ele) {
				return ele != value;
			});
		}


		$(".btnBulkUpdate").click(function () {
			debugger;
			var newIds = '';
			if (Ids != null && Ids != "") {
				newIds = Ids.toString()
			}
			if (Ids != null && Ids != "") {
				$.ajax({
					type: "POST",
					url: "/RiskAssessment/BulkUpdate",
					data: { selectIDs: newIds },
					dataType: "json",
					success: function (result) {
						debugger;
						$('#bulkUpdateModal').modal('show');
						var tr;
						var count = 0;
						$("#table1").empty();
						if (result.lstPeriodForITGRC.length > 0) {
							for (var i = 0; i < result.lstPeriodForITGRC.length; i++) {

								var startdate = JsonDateConvert(result.lstPeriodForITGRC[i].StartDate);
								var Enddate = JsonDateConvert(result.lstPeriodForITGRC[i].EndDate);

								count = count + 1;
								tr = $('<tr/>');
								tr.append('<td style="font-size: 15px;">' + count + "</td>");
								tr.append('<td style="font-size: 15px;">' + result.lstPeriodForITGRC[i].SYKI + "</td>");
								tr.append('<td style="font-size: 15px;">' + result.lstPeriodForITGRC[i].OperationName + "</td>");
								tr.append('<td style="font-size: 15px;">' + result.lstPeriodForITGRC[i].DivisionName + "</td>");
								tr.append('<td style="font-size: 15px;">' + startdate + "</td>");
								tr.append('<td style="font-size: 15px;">' + Enddate + "</td>");
								$('#table1').append(tr);
								$('#SYKI').val(result.lstPeriodForITGRC[i].SYKI)
							}
							$('#SelectedIds').val(result.PeriodForITGRC.SelectedIds)

						}

					},
				});
			}
			else {
				alert("Please select at least on item for asset edit.")
			}
		});

		//function JsonDateConvert(jsonDate) {
		//    debugger;
		//    //var dateString = jsonDate.substr(6);
		//    //var currentTime = new Date(parseInt(jsonDate));
		//    var currentTime = moment(jsonDate, 'DD-MM-YYYY');
		//    var dateString = new Date(currentTime);
		//    var month = dateString.getMonth() + 1;
		//    var day = dateString.getDate();
		//    var year = dateString.getFullYear();
		//    var date = day + "/" + month + "/" + year;
		//    return date;
		//}

		function JsonDateConvert(jsonDate) {
			debugger;
			var dateString = jsonDate.substr(6);
			//var currentTime = new Date(parseInt(dateString));
			var currentTime = moment(jsonDate, 'DD-MM-YYYY');
			var dateString = new Date(currentTime);
			var month = dateString.getMonth() + 1;
			var day = dateString.getDate();
			var year = dateString.getFullYear();
			var date = day + "/" + month + "/" + year;
			return date;
		}

	</script>




	<script nonce="@Context.Items["ScriptNonce_5"]">
		function BtnBack(ths, event) {
			window.location.href = "Search";
		}
	</script>

	<script type="text/javascript" language="javascript" nonce="@Context.Items["ScriptNonce_6"]">
		$(function () {
