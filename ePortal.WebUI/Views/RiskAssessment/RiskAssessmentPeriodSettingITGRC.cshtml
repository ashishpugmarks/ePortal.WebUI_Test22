							<th style="border:1px solid;text-align:center; width:5%;">@Html.DisplayName("ki")</th>
							<th style="border:1px solid;text-align:center; width:15%;">@Html.DisplayName("Operation")</th>
							<th style="border:1px solid; width:15%;text-align:center">@Html.DisplayName("Division")</th>
							<th style="border:1px solid;width:6%;text-align:center">@Html.DisplayName("Start Date")</th>
							<th style="border:1px solid;width:6%;text-align:center">@Html.DisplayName("End Date")</th>
