        }

        .impact_lavel {
            width: 100%;
            float: left;
        }

        .impact-left {
            width: 20%;
            float: left;
            margin-right: 2%;
        }

        .impact-right {
        }

            .impact-right .frequency_table td {
                text-align: left;
                border: none;
            }

        .table > thead > tr > th {
            text-align: left;
            border-right: 1px solid#fff !important;
        }

        body td {
            text-align: left;
            border-right: 1px solid#fff !important;
        }

        .impact-right .frequency_table .table > thead > tr {
            text-align: left;
            border: none !important;
        }

        .tooltip .tooltiptext.frequency_data {
            background-color: #000;
