    <style nonce="@Context.Items["StyleNonce_1"]">
        .tooltip {
            position: relative;
            display: inline-block;
            z-index: unset !important;
            opacity: 8;
        }

            .tooltip .tooltiptext {
                visibility: hidden;
                width: 250px;
                background-color: black;
                color: #fff;
                text-align: center;
                border-radius: 6px;
                padding: 5px;
                position: absolute;
                z-index: 1;
                top: 0;
                left: 110%;
            }

                .tooltip .tooltiptext::after {
                    content: "";
                    position: absolute;
                    top: 22%;
                    right: 100%;
                    margin-top: -5px;
                    border-width: 5px;
                    border-style: solid;
                    border-color: transparent black transparent transparent;
                }

            .tooltip:hover .tooltiptext {
                visibility: visible;
            }

            .tooltip:hover span {
                top: 0;
                color: #fff;
                padding: 10px;
                left: 2em;
            }

            .tooltip:hover div.imgcontainer {
                top: 0;
                color: #fff;
                padding: 10px;
                left: 2em;
            }

        .info_tooltip {
            display: inline-block;
            padding: 1px 8px;
            border-radius: 50%;
            border: 1px solid #e7e7e7;
            text-decoration: none;
            background-color: lightgray;
        }

        .tooltip .tooltiptext.frequency_data {
            background-color: #000;
            padding: 5px 0px 0px;
            margin-bottom: 0px;
            z-index: 999999;
        }

        span.tooltiptext.impact_data {
            width: 1000px;
            background: #fff;
            position: absolute;
            left: -300px;
        }

        .impact-right .table .table {
            background-color: #000;
        }

