@model IEnumerable<ePortal.ViewModels.CommonRiskAssessmentVM>

@{
    ViewBag.Title = "Grid Report";
    Layout = "~/Views/Shared/_LayoutAsset.cshtml";
}
@section Styles{
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />

    <style nonce="@Context.Items["StyleNonce_0"]">
        #LastKi_filter {
            font-size: 12px !important;
            padding-right: 4%;
        }

        #LastKi_length {
            display: none;
        }

            #LastKi_length select {
                width: 32% !important;
                padding: 0px;
            }

        #LastKi_info, #LastKi_length {
            font-size: 12px !important;
            padding-left: 4%;
        }

        .pagination {
            font-size: 12px !important;
        }

        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .ui-widget-header, .ui-state-default, ui-button {
            font-weight: bold;
            font-size: 16px;
        }

        .ui-dialog .ui-dialog-content {
            font-size: 14px;
        }

        .ui-dialog-buttonset {
            font-size: 16px;
        }

        .btn1 {
            width: 190px !important;
            font-size: 14px !important;
            background-color: #e3e3e3;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
        }

        .ui-dialog-titlebar-close:before {
            content: "x";
        }
    </style>
}

<div class="row">

    @*<div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>*@



    <div class="col-md-2" style="margin-left:1%;">
        <button class="bttn btn-success btn_disable" id="btn-export" style="background-color: #ccc; border-color: #4e4e4e;color: #232121; font-weight : bold ;float:right;">Export to Excel</button>

        @*<button class="bttn btn-success btn_disable" id="btn-export" style="background-color: #ccc;margin-right: 35px; border-color: #4e4e4e;color: #232121; font-weight : bold ;float:right;"><a href="@Url.Action("DownloadDataInExcelFile", "RiskAssessment",new {skyID=(object)ViewBag.CurrKey, ISSCMem=(object)ViewBag.ISSCM })">Export to Excel</a></button>*@
    </div>

    <table class="table" style="font-size:13px;border:1px solid;width:96%;" id="Risk">
        <thead>
            <tr>
            <tr style="background-color: lightblue;">
                <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">S.No.</th>
                <th style="border:1px solid;text-align:center; width:15%;font-weight:bold;">@Html.DisplayName("PRIMARY RISK")</th>
                <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("RISK CATEGORY")</th>
                <th style="border:1px solid;text-align:center; width:15%;font-weight:bold;">@Html.DisplayName("POTENTIAL RISK")</th>
                <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("RISK LEAD TO BREACH (C/I/A)")</th>
                <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("CM TOPRVNT POTENTIAL RISK")</th>
                <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("FREQUENCY")</th>
                <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("IMPACT")</th>
                <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("DEGREE RISK LEVEL")</th>
                <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("ACTION ITEM")</th>
                <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("RISK TREATMENT LEVEL")</th>
                <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("RESPONSIBILITY")</th>
                <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("TARGET DATE")</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Status</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Frequency_RA</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Impact_RA</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Current_Risk_Level_RA</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Frequency_RRA</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Impact_RRA</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Current_Risk_Level_RRA</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Risk_Owner</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Current_Measure_Level</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Impact_Type</th>

            </tr>
        </thead>
        <tbody>
            @{
                int indexq = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td style="border:1px solid;text-align:center;">@indexq</td>


                        <td style="border:1px solid;text-align:center;">
                            @item.PrimaryRisk
                        </td>

                        <td style="border:1px solid;text-align:center;">
                            @item.RiskCategory
                        </td>




                        <td style="border:1px solid;text-align:center;">
                            @if (item.PotentialRisk != null && item.PotentialRisk != "")
                            {
                                @item.PotentialRisk
                            }
                            else
                            {
                                @item.Other_Potential_Risk
                            }

                        </td>

                        <td style="border:1px solid;text-align:center;">
                            @item.RiskLeadToBreach
                        </td>


                        <td style="border:1px solid;text-align:center;">
                            @item.CM_To_Pre_Potential_Risk
                        </td>

                        <td style="border:1px solid;text-align:center;">
                            @item.Frequency_RA
                        </td>
                        <td style="border:1px solid;text-align:center;">
                            @item.Impact_RA
                        </td>
                        <td style="border:1px solid;text-align:center;">
                            @item.Current_Risk_Level_RA
                        </td>
                        <td style="border:1px solid;text-align:center;">
                            @item.ActionItem
                        </td>

                        <td style="border:1px solid;text-align:center;">
                            @item.Treatement_For_Risk_Level
                        </td>
                        <td style="border:1px solid;text-align:center;">@item.Responsebiity</td>

                        <td style="border:1px solid;text-align:center;">
                            @Convert.ToDateTime(item.TargetDate).ToString("dd/MM/yyyy")
                        </td>

                        @if (@item.RiskStatus == 2 || @item.RiskStatus == 0)
                        {
                            <td style="border:1px solid;text-align:center;display:none">Close</td>
                        }
                        else
                        {
                            <td style="border:1px solid;text-align:center;display:none">Open</td>
                        }
                        <td style="border:1px solid;text-align:center;display:none">@item.Frequency_RA</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Impact_RA</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Current_Risk_Level_RA</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Frequency_RRA</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Impact_RRA</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Current_Risk_Level_RRA</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.RiskOwner</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Current_Measures_Level</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Impact_Type</td>




                    </tr>
                    indexq++;
                }


            }
        </tbody>
    </table>
</div>

@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#Risk').DataTable({
                pageLength: 1000,
            });
        });
        $('#btn-export').on('click', function () {
            $("#Risk").table2excel({
                filename: "RiskAssessment.xls"
            });
        });
    </script>

    <script src="~/js/jquery.validate.min.js"></script>
    <script src="~/js/jquery.table2excel.js"></script>
