@{
    ViewBag.Title = "Risk Assessment Dashboard For Operating Head";
    Layout = "~/Views/Shared/_LayoutAsset.cshtml";
}

@section Styles{
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />
    @*<link rel="stylesheet" href="~/css/jquery-ui.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.23/css/jquery.dataTables.min.css">*@
    <style nonce="@Context.Items["StyleNonce_0"]">
        #LastKi_filter, #LastKi_info, #LastKi_length {
            display: none;
        }

        #LastKi_filter {
            display: none;
        }

        #LastKi_info, #LastKi_length {
            font-size: 12px !important;
        }

        #LastKi_paginate {
            font-size: 12px !important;
        }

        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .ui-widget-header, .ui-state-default, ui-button {
            font-weight: bold;
            font-size: 16px;
        }

        .ui-dialog .ui-dialog-content {
            font-size: 14px;
        }

        .ui-dialog-buttonset {
            font-size: 16px;
        }

        .btn1 {
            width: 190px !important;
            font-size: 14px !important;
            background-color: #e3e3e3;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
        }

        .ui-dialog-titlebar-close:before {
            content: "x";
        }
    </style>
}


@Html.Hidden("end_dt_Asset", (object)ViewBag.endate)
<div class="col-lg-12 col-md-12" style="margin-top:-1%;">&nbsp;</div>
<div class="row">
    <div class="col-md-5" style="border: 1px solid;background-color: aliceblue;height: 54px;">
        <table>
            <tr>
                <td style="width:10%;text-align: center;color: blue;padding-top: 0.5%;"><i class="glyphicon glyphicon-unchecked"></i></td>
                <td style="width:10%;text-align: center;color: orangered;"><i class="glyphicon glyphicon-exclamation-sign"></i></td>
                @*<td style="width:10%;text-align: center;color: sandybrown;visibility:hidden"><i class="glyphicon glyphicon-hourglass"></i></td>*@
                <td style="width:10%;text-align: center;color: green;"><i class="glyphicon glyphicon-check"></i></td>
            </tr>
            <tr>
                <td style="width:10%;font-size:14px;text-align: center;font-weight: bold;">Not Started</td>
                <td style="width:10%;font-size:14px;text-align: center;font-weight: bold;">Pending</td>
                @*<td style="width:10%;font-size:14px;text-align: center;font-weight: bold;visibility:hidden">Under Approval</td>*@
                <td style="width:10%;font-size:14px;text-align: center;font-weight: bold;">Completed</td>

            </tr>
        </table>
    </div>
    <div class="col-md-5" style="background-color:rgb(0,32,96);border: 1px solid;">
        <p style="font-size:18px;text-align: center;color: white;height: 52px;padding-top:3%;"><b> Information Risk Assessment Target Date :  @ViewBag.endate </b></p>
    </div>
    <div class="col-md-2" style="background-color:#ce1010;border: 1px solid;">
        <p style="font-size:18px;text-align: center;color: white;height: 52px;padding-top:7%;"><b> Days Left :  @ViewBag.nodaysleft </b></p>
    </div>

    <br />
    <div class="row">
        <table style="width:100%;font-size:10px;height: 40px;margin-left: 15px;">
            <thead>
                <tr style="background-color:rgba(44, 169, 226, 1);">
                    <th style="width:60px;font-size:18px;text-align:center;border:1px solid;">Operation</th>
                    <th style="width:50px;font-size:18px;text-align:center;border:1px solid;height: 40px;padding-top: 13px;">Division Name</th>
                    <th style="width:50px;font-size:18px;text-align:center;border:1px solid;">ISSC Member</th>
                    <th style="width:50px;font-size:18px;text-align:center;border:1px solid;">Asset Updation (self)</th>
                    <th style="width:50px;font-size:18px;text-align:center;border:1px solid;">Division Head Approval</th>
                    <th style="width:50px;font-size:18px;text-align:center;border:1px solid;">Operating Head Approval</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ViewBag.ISSC_MemberData)
                {
                    <tr>
                        <td style="width:50px;font-size:18px;text-align:center;border:1px solid;">@item.OperationName</td>
                        <td style="width:50px;font-size:18px;text-align:center;border:1px solid;">@item.DivisionName</td>
                        <td style="width:50px;font-size:18px;text-align:center;border:1px solid;">@item.ISSCMember</td>
                        <td style="width:50px;font-size:30px;text-align:center;border:1px solid;">
                            @if (item.ISSC_Member_Submit_Status == 1)
                            {
                                <i style="color: green;" class="glyphicon glyphicon-check"></i>

                                <span style="font-size: 14px;position: absolute;padding-top:1%;">@Convert.ToDateTime(item.ISSC_Member_Submit_Date).ToString("dd/MM/yyyy")</span>
                            }
                            else
                            {
                                <i style="color: orangered;" class="glyphicon glyphicon-exclamation-sign"></i>
                            }
                        </td>
                        <td style="width:50px;font-size:30px;text-align:center;border:1px solid;">
                            @{
                                if (item.DivisionHead_Submit_Status == 1)
                                {
                                    <a href="@Url.Action("RiskRemarkByDivisionHead", "RiskAssessment", new { ISSC_Code =item.ISSCMember_EmpCode })">
                                        <i style="color: green;" class="glyphicon glyphicon-check"></i>
                                    </a>
                                    <span style="font-size: 14px;position: absolute;padding-top:1%;"> @Convert.ToDateTime(item.DivisionHead_Submit_Date).ToString("dd/MM/yyyy")</span>
                                }
                                else if (item.ISSC_Member_Submit_Status == 1)
                                {
                                    <i style="color: orangered;" class="glyphicon glyphicon-exclamation-sign"></i>
                                }
                                else
                                {
                                    <i style="color: blue;" class="glyphicon glyphicon-unchecked"></i>
                                }
                            }
                        </td>
                        <td style="width:50px;font-size:30px;text-align:center;border:1px solid;">
                            @{
                                if (item.OperatingHead_Submit_Status == 1)
                                {
                                    <a href="@Url.Action("RiskRemarkByDivisionHead", "RiskAssessment", new { ISSC_Code =item.ISSCMember_EmpCode })">
                                        <i style="color: green;" class="glyphicon glyphicon-check"></i>
                                    </a>
                                    <span style="font-size: 14px;position: absolute;padding-top:1%;"> @Convert.ToDateTime(item.OperatingHead__Submit_Date).ToString("dd/MM/yyyy")</span>
                                }
                                else if (item.DivisionHead_Submit_Status == 1)
                                {
                                    <a href="@Url.Action("RiskDetailsApproveByOperatingHead", "RiskAssessment", new { ISSC_Code = item.ISSCMember_EmpCode })">
                                        <i style="color:orangered;" class="glyphicon glyphicon-exclamation-sign"></i>
                                    </a>
                                }
                                else
                                {
                                    <i style="color: blue;" class="glyphicon glyphicon-unchecked"></i>
                                }
                            }
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
    <div class="row">
        @if (ViewBag.Lastki_details.Count > 0 && ViewBag.Lastki_details != null)
        {
            <p style="font-size:18px;font-weight: bold;text-align: center;padding-top: 1%;padding-bottom: 1%;">Last Year Information Risk Assessment</p>
        }
        <table style="width:100%;font-size:10px;height: 40px;margin-left: 15px;">
            @if (ViewBag.Lastki_details.Count > 0 && ViewBag.Lastki_details != null)
            {
                <thead>
                    <tr style="background-color:rgba(44, 169, 226, 1);">
                        <th style="width:32%;font-size:18px;text-align:center;border:1px solid;">Operation</th>
                        <th style="width:50px;font-size:18px;text-align:center;border:1px solid;height: 40px;padding-top: 13px;">Division Name</th>
                        <th style="width:10%;font-size:18px;text-align:center;border:1px solid;">ki</th>
                        <th style="width:10%;font-size:18px;text-align:center;border:1px solid;">Details</th>
                    </tr>
                </thead>
            }
            <tbody>
                @if (ViewBag.Lastki_details.Count > 0 && ViewBag.Lastki_details != null)
                {
                    foreach (var item in ViewBag.Lastki_details)
                    {
                        <tr style="text-align:center;">
                            <td style="width:50px;font-size:18px;text-align:center;border:1px solid;">@item.OperationName</td>
                            <td style="width:50px;font-size:18px;text-align:center;border:1px solid;">@item.DIVISIONNAMEN</td>
                            <td style="width:2px;font-size:18px;text-align:center;border:1px solid;">@item.KICODE</td>
                            <td style="width:2px;font-size:18px;text-align:center;border:1px solid;"><a style="font-size: 25px;" href="@Url.Action("Get_Last_Ki_Asset_Details_OH", "RiskAssessment", new { SkyiId = @item.SYKIID, OPID=item.OPID })" class="glyphicon glyphicon-list-alt"></a></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" style="font-size:14px;border:1px solid;text-align:center;">No Record Found.</td>
                        <td style="display: none"></td>
                    </tr>
                }
            <tbody>
        </table>
    </div>

    @if (TempData["ResultMsg"] != null)
    {
        if ((int)TempData["ResultMsg"] == 1)
        {
            <script nonce="@Context.Items["ScriptNonce_3"]">
                alert("Asset register approval request has been approved successfully.");
            </script>
        }
        else if ((int)TempData["ResultMsg"] == 2)
        {
            <script nonce="@Context.Items["ScriptNonce_4"]">
                alert("There is some problem, please try again later.");
            </script>
        }
        else if ((int)TempData["ResultMsg"] == 3)
        {
            <script nonce="@Context.Items["ScriptNonce_5"]">
                alert("You have successfully sent back the Risk register approval request.");
            </script>
        }
    }
