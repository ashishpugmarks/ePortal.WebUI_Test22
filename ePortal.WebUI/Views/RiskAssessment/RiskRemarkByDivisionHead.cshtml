@model ePortal.ViewModels.CommonRiskAssessmentVM
@{
    ViewBag.Title = "Risk Register Approve By Division Head";
    Layout = "~/Views/Shared/_LayoutAsset.cshtml";
}
@section Styles{
    <link href="~/Contextcss/index.css" rel="stylesheet" type="text/css" media="all" />

    <style nonce="@Context.Items["StyleNonce_0"]">
        #LastKi_filter {
            font-size: 12px !important;
            padding-right: 4%;
        }

        #LastKi_length {
            display: none;
        }

            #LastKi_length select {
                width: 32% !important;
                padding: 0px;
            }

        #LastKi_info, #LastKi_length {
            font-size: 12px !important;
            padding-left: 4%;
        }

        .pagination {
            font-size: 12px !important;
        }

        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .ui-widget-header, .ui-state-default, ui-button {
            font-weight: bold;
            font-size: 16px;
        }

        .ui-dialog .ui-dialog-content {
            font-size: 14px;
        }

        .ui-dialog-buttonset {
            font-size: 16px;
        }

        .btn1 {
            width: 190px !important;
            font-size: 14px !important;
            background-color: #e3e3e3;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
        }

        .ui-dialog-titlebar-close:before {
            content: "x";
        }

    }
</style>
}






<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>
    <div class="col-md-12" style="margin-left:1%;padding-top: 1%;">
        <div class="col-md-2" style="width:12%">
            <table>
                <tr><td style="border:1px solid #333;background-color:#FA364C;color:white;padding-top: 0%;vertical-align:middle;">&nbsp; S &nbsp;</td><td style="border:1px solid  #333;text-align:center;background-color:#FA364C;color:black;height: 32px;font-size:18px;vertical-align:middle;">&nbsp; Extreme &nbsp;</td><td style="border:1px solid  #333;font-size:18px;vertical-align:middle;">&nbsp;  @ViewBag.Extreme  &nbsp;</td></tr>
            </table>
        </div>
        <div class="col-md-2" style="width:10.5%">
            <table>
                <tr><td style="border:1px solid  #333;background-color:#FFA360;color:white;padding-top: 0%;vertical-align:middle;">&nbsp; A &nbsp;</td><td style="border:1px solid  #333;text-align:center;background-color:#FFA360;color:black;height: 32px;font-size:18px;vertical-align:middle;">&nbsp;&nbsp; High &nbsp;&nbsp;</td><td style="border:1px solid  #333;font-size:18px;vertical-align:middle;">&nbsp;  @ViewBag.High  &nbsp;</td></tr>
            </table>
        </div>
        <div class="col-md-2" style="width:12.6%">
            <table>
                <tr><td style="border:1px solid  #333;background-color:#FFC65F;color:white;padding-top: 0%;vertical-align:middle;">&nbsp; B &nbsp;</td><td style="border:1px solid  #333;text-align:center;background-color:#FFC65F;color:black;height: 32px;font-size:18px;vertical-align:middle;">&nbsp;&nbsp; Medium &nbsp;&nbsp;</td><td style="border:1px solid  #333;font-size:18px;vertical-align:middle;">&nbsp;  @ViewBag.Medium  &nbsp;</td></tr>
            </table>
        </div>
        <div class="col-md-2" style="width:11%">
            <table>
                <tr><td style="border:1px solid  #333;background-color:#A0C460;color:white;padding-top: 0%;vertical-align:middle;">&nbsp; C &nbsp;</td><td style="border:1px solid  #333;text-align:center;background-color:#A0C460;color:black;height: 32px;font-size:18px;vertical-align:middle;">&nbsp;&nbsp; Low &nbsp;&nbsp;</td><td style="border:1px solid  #333;font-size:18px;vertical-align:middle;">&nbsp;  @ViewBag.Low  &nbsp;</td></tr>
            </table>
        </div>
        <div class="col-md-2" style="width:37%">
            <table>
                <tr><td style="border:1px solid  #333;background-color:#5EC665;color:white;padding-top: 0%;vertical-align:middle;">&nbsp; D &nbsp;</td><td style="border:1px solid  #333;text-align:center;background-color:#5EC665;color:black;height: 32px;font-size:18px;vertical-align:middle;">&nbsp;&nbsp; Very Low &nbsp;&nbsp;</td><td style="border:1px solid  #333;font-size:18px;vertical-align:middle;">&nbsp;  @ViewBag.VeryLow &nbsp;</td></tr>
            </table>
        </div>
        <div class="col-md-2">
            <button class="bttn btn-success btn_disable" id="btn-export" style="background-color: #ccc; border-color: #4e4e4e;color: #232121; font-weight : bold ;float:right;">Export to Excel</button>

            @*<button class="bttn btn-success btn_disable" id="btn-export" style="background-color: #ccc;margin-right: 35px; border-color: #4e4e4e;color: #232121; font-weight : bold ;float:right;"><a href="@Url.Action("DownloadDataInExcelFile", "RiskAssessment",new {skyID=Model.SKYID, ISSCMem=(object)ViewBag.ISSCMEM })">Export to Excel</a></button>*@
        </div>
    </div>
    <table class="table" style="font-size:13px;border:1px solid;width:134%; margin-left: 27px;" id="LastKi">
        <thead>
            <tr>
            <tr style="background-color: lightblue;">
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;">S.No.</th>
                <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("Primary Risk")</th>
                <th style="border:1px solid;text-align:center; width:7%;font-weight:bold;">@Html.DisplayName("Risk Category")</th>
                <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("Potential Risk")</th>
                <th style="border:1px solid;text-align:center; width:4%;font-weight:bold;">@Html.DisplayName("Risk lead to breach of (C/I/A)")</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Risk_Owner</th>
                <th style="border:1px solid;text-align:center; width:15%;font-weight:bold;">@Html.DisplayName("Current Measures to prevent the Potential risk")</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Current_Measure_Level</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Frequency_RI</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Imapct_Type</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Impact_RI</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Current_Degree_Risk_Level_RI</th>
                <th style="border:1px solid;text-align:center; width:5%;font-weight:bold;">@Html.DisplayName("Frequency")</th>
                <th style="border:1px solid;text-align:center; width:5%;font-weight:bold;">@Html.DisplayName("Impact")</th>
                <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@Html.DisplayName("Current Degree/ Risk Level ")</th>
                <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@Html.DisplayName("Risk Treatment  for Risk Level S/A/B")</th>
                <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Action item")</th>
                <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Responsibility")</th>
                <th style="border:1px solid;text-align:center; width:5%;font-weight:bold;">@Html.DisplayName("Target Date")</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Status</th>
                    @*<th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Frequency_RA</th>
        <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Impact_RA</th>
        <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Current_Risk_Level_RA</th>*@
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Frequency_RRA</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Impact_RRA</th>
                <th style="border:1px solid;text-align:center; width:0%;font-weight:bold;display:none">Current_Risk_Level_RRA</th>

            </tr>
        </thead>
        <tbody>
            @{
                int index = 1;
                foreach (var item in ViewBag.Riskdetails)
                {

                    <tr>


                        <td style="border:1px solid;text-align:center;">@index</td>
                        <td style="border:1px solid;text-align:center;">@item.PrimaryRisk</td>
                        <td style="border:1px solid;text-align:center;">@item.RiskCategory</td>
                        @if (@item.PotentialRisk != null)
                        {
                            <td style="border:1px solid;text-align:center;">@item.PotentialRisk</td>
                        }
                        else
                        {
                            <td style="border:1px solid;text-align:center;">@item.Other_Potential_Risk</td>
                        }

                        <td style="border:1px solid;text-align:center;">@item.RiskLeadToBreach</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.RiskOwner</td>
                        <td style="border:1px solid;text-align:center;">@item.CM_To_Pre_Potential_Risk</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Current_Measures_Level</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Iden_Frequency</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Impact_Type</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Iden_Impact</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Iden_Current_Risk_Level</td>
                        <td style="border:1px solid;text-align:center;">@item.Frequency_RA</td>
                        <td style="border:1px solid;text-align:center;">@item.Impact_RA</td>
                        @if (@item.Current_Risk_Level_RA == "S")
                        {
                            <td style="background-color:#FA364C;border:1px solid;text-align:center;">@item.Current_Risk_Level_RA</td>
                        }
                        else if (@item.Current_Risk_Level_RA == "A")
                        {
                            <td style="background-color:#FFA360;border:1px solid;text-align:center;">@item.Current_Risk_Level_RA</td>
                        }
                        else if (@item.Current_Risk_Level_RA == "B")
                        {
                            <td style="background-color:#FFC65F;border:1px solid;text-align:center;">@item.Current_Risk_Level_RA</td>
                        }
                        else if (@item.Current_Risk_Level_RA == "C")
                        {
                            <td style="background-color:#A0C460;border:1px solid;text-align:center;">@item.Current_Risk_Level_RA</td>
                        }
                        else if (@item.Current_Risk_Level_RA == "D")
                        {
                            <td style="background-color:#5EC665;border:1px solid;text-align:center;">@item.Current_Risk_Level_RA</td>
                        }

                        <td style="border:1px solid;text-align:center;">@item.Treatement_For_Risk_Level</td>
                        <td style="border:1px solid;text-align:center;">@item.ActionItem</td>
                        <td style="border:1px solid;text-align:center;">@item.Responsebiity</td>
                        @if (@item.TargetDate != null)
                        {
                            <td style="border:1px solid;text-align:center;">@Convert.ToDateTime(@item.TargetDate).ToString("dd/MM/yyyy")</td>
                        }
                        else
                        {
                            <td style="border:1px solid;text-align:center;"></td>
                        }
                        @if (@item.RiskStatus == 2 || @item.RiskStatus == 0)
                        {
                            <td style="border:1px solid;text-align:center;display:none">Close</td>
                        }
                        else
                        {
                            <td style="border:1px solid;text-align:center;display:none">Open</td>
                        }
                        @*<td style="border:1px solid;text-align:center;display:none">@item.Frequency_RA</td>
                                <td style="border:1px solid;text-align:center;display:none">@item.Impact_RA</td>
                                <td style="border:1px solid;text-align:center;display:none">@item.Current_Risk_Level_RA</td>*@
                        <td style="border:1px solid;text-align:center;display:none">@item.Frequency_RRA</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Impact_RRA</td>
                        <td style="border:1px solid;text-align:center;display:none">@item.Current_Risk_Level_RRA</td>
                        @*<td style="border:1px solid;text-align:center;display:none">@item.RiskOwner</td>
                                <td style="border:1px solid;text-align:center;display:none">@item.Current_Measures_Level</td>
                                <td style="border:1px solid;text-align:center;display:none">@item.Impact_Type</td>*@

                    </tr>
                    index++;
                }
                if (ViewBag.Riskdetails.Count == 0)
                {
                    <tr>
                        <td colspan="13" style="border:1px solid;text-align:center;">No record found.</td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <h7 style="margin-left:1%;">Remarks </h7>
    <table class="table" style="font-size:13px;border:1px solid;width:98%;margin-left:1%;">
        <thead>
            <tr style="background-color: lightblue;">
                <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Division Head Remarks</td>
                <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">Operating Head Remarks</td>
            </tr>
        </thead>
        <tr>
            @foreach (var item in ViewBag.Remarks)
            {
                <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.Divison_Remarks</td>
                <td style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@item.Operating_Remarks</td>
                break;
            }
        </tr>
    </table>
</div>

