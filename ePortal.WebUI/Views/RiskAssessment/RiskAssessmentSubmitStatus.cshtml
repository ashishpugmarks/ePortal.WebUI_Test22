@model ePortal.ViewModels.A00ViewModel
@{
    ViewBag.Title = "Asset Register Submit Status";
    Layout = "~/Views/Shared/_LayoutAsset.cshtml";

    var List = ViewBag.ViewToList as List<ePortal.ViewModels.RiskAssessmentSearchModel>;
}

@section Styles{
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />

    <style nonce="@Context.Items["StyleNonce_0"]">

        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .ui-widget-header, .ui-state-default, ui-button {
            font-weight: bold;
            font-size: 16px;
        }

        .ui-dialog .ui-dialog-content {
            font-size: 14px;
        }

        .ui-dialog-buttonset {
            font-size: 16px;
        }

        .btn1 {
            width: 190px !important;
            font-size: 14px !important;
            background-color: #e3e3e3;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
        }

        .ui-dialog-titlebar-close:before {
            content: "x";
        }
    </style>
}

<div class="row" id="Grid">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>

    <input type="hidden" name="GridHtml" id="gridexcel" />

    <div class="body-content" style="overflow-x:hidden">
        <div id="form-group">
            @using (Html.BeginForm("RiskAssessmentSubmitStatus", "RiskAssessment", FormMethod.Post, new { encType = "multipart/form-data", @id = "submit", @role = "form", }))
            {
                @Html.Hidden("curki", (object)ViewBag.curki)
                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <tr>
                            <td class="text-right">
                                <b>ki<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-3">
                                @Html.DropDownList("SYKIDatanew", ViewBag.SYKIDatanew as SelectList, "- Select -", new { @class = "form-control", name = "Ki", id = "Ki", @required = "required", @title = "Please select Ki" })
                            </td>
                            <td class="text-right">
                                <b>Operation<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-3">
                                @Html.DropDownList("OPERATIONID", (IEnumerable<SelectListItem>)ViewBag.OpList, "- Select -",
                                         new { @id = "ddlOp", @class = "form-control", name = "Division" })
                            </td>
                            <td class="text-right">
                                <b>Division<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-3">
                                @Html.DropDownList("DIVISIONID", (IEnumerable<SelectListItem>)ViewBag.DivisionList, "- Select -",
                                         new { @id = "DIVISIONID", @class = "form-control" })
                                @*<select id="DIVISIONID" class="form-control" name="DIVISIONID">
                                        <option value="0">--Select--</option>
                                    </select>*@
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" style="text-align:center;">
                                <div class="col-md-12" style="align-items: center;">
                                    <input type="submit" class="bttn btn-success btn_disable" value="Search" id="btnSubmitt" data-loading-text="Submitting..." autocomplete="off"
                                           name="btnSubmit" style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold ;" />
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" style="text-align:right;">
                                <div class="col-md-12" style="align-items: center;">
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            }
            <button class="bttn btn-success btn_disable" id="btn-export" style="background-color: #ccc; border-color: #4e4e4e;color: #232121; font-weight : bold ;">Export to Excel</button>
            <table class="table" style="font-size:13px;border:1px solid;" id="GetData">
                <thead>
                    <tr style="background-color:rgba(44, 169, 226, 1);">
                        <th style="border:1px solid;text-align:center; width:2%;">S.No.</th>
                        <th style="border:1px solid;text-align:center; width:18%;">@Html.DisplayName("Operation Name")</th>
                        <th style="border:1px solid; width:18%;text-align:center">@Html.DisplayName("Division Name")</th>
                        <th style="border:1px solid;width:18%;text-align:center">@Html.DisplayName("ISSC Member")</th>
                        <th style="border:1px solid;width:18%;text-align:center">@Html.DisplayName("Division Head")</th>
                        <th style="border:1px solid;width:18%;text-align:center">@Html.DisplayName("Operating Head")</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        foreach (var item in List)
                        {
                            var s = ViewBag.CurrentSYKIData;
                            <tr>
                                <td style="border:1px solid;text-align:center;">@index</td>
                                <td style="border:1px solid;text-align:center;">@item.OPERATIONNAME</td>
                                <td style="border:1px solid;text-align:center;">@item.DIVISIONNAMEN</td>
                                <td style="border:1px solid;text-align:center;">
                                    @item.EmpName

                                    @item.ISSC_EMPCODE

                                </td>
                                <td style="border:1px solid;text-align:center;">
                                    @item.Div_Head

                                    @item.Div_EMPCODE

                                </td>
                                <td style="border:1px solid;text-align:center;">
                                    @item.Opr_Head

                                    @item.Op_EMPCODE

                                </td>
                            </tr>
                            index++;
                        }
                        if (List.Count == 0)
                        {
                            <tr>
                                <td colspan="6" style="border:1px solid;text-align:center;">No record found.</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <table class="table table-bordered table-hover table-responsive">
                <tr>
                    <td colspan="9">
                        <a title="Back" href="/home/home">
                            <img src="~/images/icon_back.gif" border="0" alt="">
                            Back
                        </a>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

@section Scripts{

@* <script src="~/Scripts/table2excel.js"></script>
@Scripts.Render("~/bundles/jqueryval") *@
    <script src="~/bundle/jqueryval.min.js"></script>
    <script src="~/js/jquery.table2excel.js"></script>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

    function BindOperation(crnt, call) {
        var dID = $(crnt).val();
        var select = $("#ddlOp");
        if (dID != "") {
            $.getJSON("/RiskAssessment/BindOperationId", { SYKIID: dID },
                  function (data) {
                      select.empty();
                      if (data.length > 0) {
                          select.append($('<option />', {
                              value: "",
                              text: "--Select--"
                          }));
                          $.each(data, function (index, itemData) {
                              select.append($('<option />', {
                                  value: itemData.ADORGLEVELID,
                                  text: itemData.LEVELDESCRIP
                              }));
                          });
                      }
                      else {
                          select.append($('<option />', {
                              value: "",
                              text: "--No record--"
                          }));
                      }
                  });
        }
        else {
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Select--"
            }));

        }
    };

    function BindDivision(crnt, call) {
        var dID = $(crnt).val();
        var select = $("#DIVISIONID");
        if (dID != "") {
            $.getJSON("/RiskAssessment/BindDivisionByOperationId", { id: dID },
                  function (data) {
                      select.empty();
                      if (data.length > 0) {

                          select.append($('<option />', {
                              value: "",
                              text: "--Select--"
                          }));

                          $.each(data, function (index, itemData) {
                              select.append($('<option />', {
                                  value: itemData.DIVISIONID,
                                  text: itemData.DIVISION
                              }));
                          });
                          debugger;
                          BindDepartment($("#DIVISIONID"), "0");
                          BindSection($("#ddlDep"), "0");

                      }
                      else {
                          select.append($('<option />', {
                              value: "",
                              text: "--No record--"
                          }));
                      }
                  });
        }
        else {
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Select--"
            }));
            BindDepartment($("#DIVISIONID"), "0");
            BindSection($("#ddlDep"), "0");

        }
    };

</script>
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    function exportToExcel() {
        $("#GetData").table2excel({
            exportOptions: {
                pageLength: 5,
                columns: [0, 1, 2, 3,4]
            },
            filename: "Risk Assessment Submit Status.xls"
        });
    }
</script>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
    $(document).ready(function () {
        $('#GetData').DataTable({
            dom: 'Bfrtip',
            buttons: [
              'copy', 'csv', 'excel', 'pdf', 'print'
            ]
        });
    });
</script>


<script nonce="@Context.Items["ScriptNonce_6"]">
    function BtnBack(ths, event) {
        window.location.href = "Search";

    }
</script>
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
    $("#BtnCancel").click(function () {
        $("#SYKIDatanew").val("");
        location.reload(true);

    });
</script>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
    $('#btnSubmitt').on('click', function () {
        $('form').validate();
        if ($('form').valid())
            $(this).button('loading'); // button text will be "Submitting!"
    });

</script>

<script nonce="@Context.Items["ScriptNonce_9"]">
    $(document).ready(function () {
        // $("#Ki").val(@ViewBag.curki);
        var table = $('#GetData').DataTable();
        $('#btn-export').on('click', function () {
            var btn = $(this).button('loading');
            $('<table>')
                .append($(table.table().header()).clone())
                .append(table.$('tr').clone()).table2excel({
                    exclude: ".noExl",
                    name: "Risk Assessment Submit Status",
                    filename: "Risk Assessment Submit Status" + new Date().toISOString().replace(/[\-\:\.]/g, "_"),
                    fileext: ".xls",
                    exclude_img: true,
                    exclude_links: true,
                    exclude_inputs: true,
                    columns: [0, 1, 2, 3]
                });
            setTimeout(function () {
                btn.button('reset');
            }, 2000);
        });
        $('#Ki').on('change', function () {
            BindOperation(this, 1);
        });
        $('#ddlOp').on('change', function () {
            BindDivision(this, 0);
        });
    })
</script>


}