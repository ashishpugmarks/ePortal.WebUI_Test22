@{
    ViewBag.Title = "Risk Dashboard For Division Head";
    Layout = "~/Views/Shared/_LayoutAsset.cshtml";
}
@section Styles{
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />
    @*<link rel="stylesheet" href="~/css/jquery-ui.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.23/css/jquery.dataTables.min.css">*@
    <style nonce="@Context.Items["StyleNonce_0"]">
        a:hover {
            background-color: white;
            color: rgb(0,32,96) !important;
        }

        #LastKi_filter, #LastKi_info, #LastKi_length {
            display: none;
        }

        #LastKi_filter {
            display: none;
        }

        #LastKi_info, #LastKi_length {
            font-size: 12px !important;
        }

        #LastKi_paginate {
            font-size: 12px !important;
        }

        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .ui-widget-header, .ui-state-default, ui-button {
            font-weight: bold;
            font-size: 16px;
        }

        .ui-dialog .ui-dialog-content {
            font-size: 14px;
        }

        .ui-dialog-buttonset {
            font-size: 16px;
        }

        .btn1 {
            width: 190px !important;
            font-size: 14px !important;
            background-color: #e3e3e3;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
        }

        .ui-dialog-titlebar-close:before {
            content: "x";
        }
    </style>
}


<div class="col-lg-12 col-md-12" style="margin-top:-1%;">&nbsp;</div>
<div class="row">
    <div class="col-md-5" style="border: 1px solid;background-color: aliceblue;height: 54px;">
        <table>
            <tr>
                <td style="width:10%;text-align: center;color: blue;padding-top: 0.5%;"><i class="glyphicon glyphicon-unchecked"></i></td>
                <td style="width:10%;text-align: center;color: orangered;"><i class="glyphicon glyphicon-exclamation-sign"></i></td>
                <td style="width:10%;text-align: center;color: green;"><i class="glyphicon glyphicon-check"></i></td>
            </tr>
            <tr>
                <td style="width:10%;font-size:14px;text-align: center;font-weight: bold;">Not Started</td>
                <td style="width:10%;font-size:14px;text-align: center;font-weight: bold;">Pending</td>
                <td style="width:10%;font-size:14px;text-align: center;font-weight: bold;">Completed</td>

            </tr>
        </table>
    </div>
    <div class="col-md-7" style="background-color:rgb(0,32,96);border: 1px solid;">
        <p style="font-size:18px;text-align: center;color: white;height: 53px;padding-top:3%;"><b> Information Risk Assessment</b></p>
    </div>
    @*<div class="col-md-2" style="background-color:#ce1010;border: 1px solid;">
        <p style="font-size:18px;text-align: center;color: white;height: 53px;padding-top:7%;"><b> Days Left :   </b></p>
    </div>*@
</div>
<br />
<div class="row">
    <div class="col-lg-3 col-md-3">
        <a href="~/Asset Register/ISSC Nomination File/Information Asset Register Guideline updated.pdf" target="_blank">
            <img style="padding-right: 1%;" src="~/Asset Register/ISSC Nomination File/Risk-Assessment_L.jpg" class="img-responsive" />
        </a>
    </div>
    <div class="col-lg-9 col-md-9">
        <div class="col-lg-12 col-md-12">
            <p style="font-size:18px;font-weight: bold;text-align: center;padding-bottom: 2%;">Current Year Information Risk Assessment</p>
            <table class="table-responsive table table-bordered" style="font-size:13px;border:1px solid;font-weight: bold;">
                <thead>
                    <tr>
                        <th style="border:1px solid;">Division Name</th>
                        <th style="border:1px solid;">ISSC Member</th>
                        <th style="border:1px solid;">Risk Updation (ISSC Member)</th>
                        <th style="border:1px solid;">Division Head Approval</th>
                        <th style="border:1px solid;">Operating Head Approval</th>
                        <th style="border:1px solid;">Target Date</th>
                        <th style="border:1px solid;">Days Left</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.AssetsDetailList)
                    {
                        <tr>
                            <td style="border:1px solid;">@item.DivisionName</td>
                            <td style="border:1px solid;">@item.ISSCMember</td>
                            <td style="text-align:center;border:1px solid;">
                                @if (item.ISSC_Member_Submit_Status == 1)
                                {
                                    <i style="color: green; font-size: 18px;" class="glyphicon glyphicon-check"></i>

                                    <br />
                                    <span style="font-size: 14px;"> @Convert.ToDateTime(item.ISSC_Member_Submit_Date).ToString("dd/MM/yyyy")</span>
                                }
                                else
                                {
                                    <i style="color: orangered; font-size: 18px;" class="glyphicon glyphicon-exclamation-sign"></i>
                                }
                            </td>
                            <td style="text-align:center;border:1px solid;">
                                @if (item.ISSC_Member_Submit_Status == 1)
                                {
                                    if (item.DivisionHead_Submit_Status == 1)
                                    {
                                        <a href="@Url.Action("RiskRemarkByDivisionHead", "RiskAssessment", new { ISSC_Code = item.ISSCMember_EmpCode })">
                                            <i style="color: green; font-size: 18px;" class="glyphicon glyphicon-check"></i>
                                        </a>

                                        <br />
                                        <span style="font-size: 14px;"> @Convert.ToDateTime(item.DivisionHead_Submit_Date).ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("RiskDetailsApproveByDivisionHead", "RiskAssessment", new { ISSC_Code = item.ISSCMember_EmpCode })">
                                            <i style="color:orangered; font-size: 18px;" class="glyphicon glyphicon-exclamation-sign"></i>
                                        </a>
                                    }
                                }
                                else
                                {
                                    <i style="color: blue; font-size: 18px;" class="glyphicon glyphicon-unchecked"></i>
                                }
                            </td>
                            <td style="text-align:center; border:1px solid;">
                                @if (item.OperatingHead_Submit_Status == 1)
                                {
                                    <a href="@Url.Action("RiskRemarkByDivisionHead", "RiskAssessment", new { ISSC_Code = item.ISSCMember_EmpCode })">
                                        <i style="color: green; font-size: 18px;" class="glyphicon glyphicon-check"></i>
                                    </a>
                                    <span style="font-size: 14px;"> @Convert.ToDateTime(item.OperatingHead__Submit_Date).ToString("dd/MM/yyyy")</span>
                                }
                                else
                                {
                                    <i style="color: blue; font-size: 18px;" class="glyphicon glyphicon-unchecked"></i>
                                }
                            </td>
                            <td style="border:1px solid;">@Convert.ToDateTime(item.EndDate).ToString("dd-MM-yyyy")</td>

                            <td style="border:1px solid;">
                                @{
                                    var days = "";
                                    DateTime end_dates = Convert.ToDateTime(item.EndDate);
                                    int nodaysleft = end_dates.Subtract(DateTime.Now.Date).Days;
                                    if (item.ISSCMember != null && item.OperatingHead_Submit_Status == null)
                                    {
                                        days = nodaysleft + " Days";
                                    }
                                    else
                                    {
                                        days = "0 Days";
                                    }
                                }
                                @days
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
        @*start foreach loop*@
        <div class="col-lg-6 col-md-6">
            @if (ViewBag.DivisionList.Count > 0 && ViewBag.DivisionList != null)
            {
                <p style="font-size:18px;font-weight: bold;text-align: center;padding-bottom: 2%;"> Last Year Information Risk Assessment</p>
            }
            <table class="table" style="font-size:13px;border:1px solid;margin-left:0%;" id="LastKi">
                @if (ViewBag.DivisionList.Count > 0 && ViewBag.DivisionList != null)
                {
                    <thead>
                        <tr style="background-color: lightblue;text-align:center;">
                            <th style="text-align:center;">ki</th>
                            <th style="text-align:center;">Division Name</th>
                            <th style="text-align:center;"> Details </th>
                        </tr>
                    </thead>
                }
                <tbody>
                    @if (ViewBag.DivisionList.Count > 0 && ViewBag.DivisionList != null)
                    {
                        foreach (var item in ViewBag.DivisionList)
                        {
                            <tr style="text-align:center;">
                                <td> @item.SYKIName </td>
                                <td> @item.DIVISION </td>
                                <td>
                                    <a style="font-size: 25px;" href="@Url.Action("LastYearKiRiskDetails", "RiskAssessment", new { SkyiId = item.SYKI,DivId= item.DIVISIONID })" target="_blank" class="glyphicon glyphicon-list-alt"></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        @*<tr>
                            <td colspan="2"> No Record Found.</td>
                            <td style="display: none"></td>
                        </tr>*@
                    }
                </tbody>
            </table>
        </div>
        <div class="col-lg-12 col-md-12" style="padding-top:0%;">&nbsp;</div>
    </div>
</div>

<br />
<div class="row">
    <div class="col-lg-12 col-md-12" style="background-color:rgb(0,32,96);color:white;">
        <p style="font-size: 20px;padding: .5%">
            <a href="~/Asset Register/ISSC Nomination File/Information Asset Register Guideline updated.pdf" target="_blank" style="color:white;">
                Click here
            </a> to understand "how to fill Information Risk Assessment". If you are already familiar, please start activity by clicking on pending icon.

        </p>
    </div>
</div>

@section Scripts{

<script nonce="@Context.Items["ScriptNonce_3"]">
    $('#LastKi').DataTable({
        pageLength: 5,
        "bSort": false
    });
</script>
@if (TempData["ResultMsg"] != null)
{
    if ((int)TempData["ResultMsg"] == 1)
    {
        <script nonce="@Context.Items["ScriptNonce_4"]">
            alert("Risk assessment approval request has been approved successfully.");
        </script>
    }
    else if ((int)TempData["ResultMsg"] == 2)
    {
        <script nonce="@Context.Items["ScriptNonce_5"]">
            alert("There is some problem, please try again later.");
        </script>
    }
    else if ((int)TempData["ResultMsg"] == 3)
    {
        <script nonce="@Context.Items["ScriptNonce_6"]">
            alert("You have successfully sent back the Risk assessment approval request.");
        </script>
    }
}
}