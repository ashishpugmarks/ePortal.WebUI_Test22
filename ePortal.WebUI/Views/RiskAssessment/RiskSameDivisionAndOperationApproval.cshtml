@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#ddlDiv').on('change', function () {
                BindDivisionHeadEmpCodeOnChange(this, 0);
            });
            $('#ddlOp').on('change', function () {
                BindDivisionOnChange(this, 0);
            });
        });

        ////======== Bind Division on change of Operation========////
        function BindDivisionOnChange(crnt, call) {
            debugger;
            var oID = $(crnt).val();
            var SYKIID = $("#SYKIID").val();
            var select = $("#ddlDiv");
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Please wait--"
            }));
            if (oID != "") {
                $.getJSON("/RiskAssessment/BindDivisionWithOldOperationHeadEmpCodeByOperationId", { id: oID, sYKIID: SYKIID },
                          function (data) {
                              debugger;
                              $('#ExistingOPHeadEmpCode').val(data.OperatingHeadEmpCode);
                              select.empty();
                              if (data.divList.length > 0) {
                                  select.append($('<option />', {
                                      value: "",
                                      text: "--Select--"
                                  }));
                                  $.each(data.divList, function (index, itemData) {
                                      select.append($('<option />', {
                                          value: itemData.DIVISIONID,
                                          text: itemData.DIVISION
                                      }));
                                  });
                              }
                              else {
                                  select.append($('<option />', {
                                      value: "",
                                      text: "--No record--"
                                  }));
                              }
                          });
            }
            else {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Select--"
                }));
            }
        };

        // Bind Division Head Employee Code on change division

        function BindDivisionHeadEmpCodeOnChange(crnt, call) {
            debugger;
            var oID = $('#ddlDiv').val();
            var SYKIID = $("#SYKIID").val();
            if (oID != "") {
                $.getJSON("/RiskAssessment/BindOldDivisionHeadEmpCodeByDivisionId", { id: oID, sYKIID: SYKIID },
                          function (data) {
                              debugger;
                              $('#ExistingDivHeadEmpCode').val(data.DivisionHeadEmpCode);

                          });
            }
            else {
                alert(" Please select division");
            }

        };


        $("#BtnCancel").click(function () {
            location.reload(true);

        });

        $("#btnSubmit").click(function () {
            if (($('#NewOPHeadEmpCode').val() != "" && $('#NewOPHeadEmpCode').val() != "0") && ($('#NewDivHeadEmpCode').val() != "" && $('#NewDivHeadEmpCode').val() != "0")) {
                if ($('#ddlOp').val() == "") {
                    alert("Please select operation")
                    return false;
                }
                else if ($('#ddlDiv').val() == "") {
                    alert("Please select division")
                    return false;
                } else
                    return true;
            }
            else if ($('#NewOPHeadEmpCode').val() != "" && $('#NewOPHeadEmpCode').val() != "0") {
                if ($('#ddlOp').val() == "") {
                    alert("Please select operation")
                    return false;
                } else
                    return true;
            }
            else if ($('#NewDivHeadEmpCode').val() != "" && $('#NewDivHeadEmpCode').val() != "0") {
                if ($('#ddlOp').val() == "") {
                    alert("Please select operation")
                    return false;
                }
                else if ($('#ddlDiv').val() == "") {
                    alert("Please select division")
                    return false;
                } else
                    return true;
            }
            else if ($('#ddlOp').val() == "") {
                alert("Please select operation");
                return false;
            }
            else if ($('#ddlOp').val() != "" && $('#ddlDiv').val() == "" && ($('#NewOPHeadEmpCode').val() == "" || $('#NewOPHeadEmpCode').val() == "0")) {
                alert("Please enter valid new operation head employee code")
                return false;
            }
            else if ($('#ddlDiv').val() != "" && $('#ddlOp').val() != "" && ($('#NewDivHeadEmpCode').val() == "" || $('#NewDivHeadEmpCode').val() == "0")) {
                alert("Please enter valid new division head employee code")
                return false;
            }

        });
    </script>
}
