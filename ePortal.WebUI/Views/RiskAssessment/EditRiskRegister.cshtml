@model ePortal.ViewModels.RiskAssessmentVM
@{
    ViewBag.Title = "Risk Register";
    Layout = "~/Views/Shared/_LayoutAsset.cshtml";
}
@section Styles{
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />

    <style nonce="@Context.Items["StyleNonce_0"]">
        .qwerty {
            background: #eee;
            pointer-events: none;
            touch-action: none;
        }

        .qwerty1 {
            background-color: #ccc !important;
            pointer-events: none;
            touch-action: none;
        }

        #GetData_filter, #GetData_length {
            display: none;
        }

        #GetData_info {
            display: none;
            font-size: 12px !important;
        }

        #GetData_length select {
            width: 30% !important;
            padding: 0px;
        }

        .pagination {
            display: none;
            font-size: 12px !important;
        }

        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .ui-widget-header, .ui-state-default, ui-button {
            font-weight: bold;
            font-size: 16px;
        }

        .ui-dialog .ui-dialog-content {
            font-size: 14px;
        }

        .ui-dialog-buttonset {
            font-size: 16px;
        }

        .btn1 {
            width: 190px !important;
            font-size: 14px !important;
            background-color: #e3e3e3;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
        }

        .ui-dialog-titlebar-close:before {
            content: "x";
        }
    </style>
}


<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #3fb3fe; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>
    @if (TempData["msg"] != null)
    {
        <div style="vertical-align: middle;width:98%;margin-left:.5%;">
            <div style="padding:8px; font-size:12px;font-weight:normal;" class="error">@TempData["msg"]</div>
        </div>
    }

    @using (Html.BeginForm("EditRiskRegister", "RiskAssessment", FormMethod.Post, new { encType = "multipart/form-data", id = "RiskRegister" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.SkyId)
        <div class="body-content" style="overflow-x:hidden">
            <div id="msform">
                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <h4 style="font-weight:bold;font-size: 22px;margin-bottom: 10px">Risk Identification(RI)</h4>
                        <tr>
                            <td class="text-right col-md-1">
                                <b>Primary Risk<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                <div class="col-md-12">
                                    @Html.DropDownListFor(x => x.PrimaryAssetId, ViewBag.primaryAssetList as SelectList, "- Select -", new { @class = "form-control", @required = "required" })
                                    @Html.ValidationMessageFor(m => m.PrimaryAssetId, "", new { @class = "text-danger" })
                                </div>
                            </td>
                            <td class="text-right col-md-1">
                                <b>Risk Category<span style="color: #ff0000"></span></b>
                            </td>
                            <td class="text-right col-md-1">
                                @Html.DropDownListFor(x => x.Risk_CategoryId, ViewBag.categoryList as SelectList, "- Select -",
                                         new
                                         {
                                             @class = "form-control",
                                             @id = "ddlCateogory",
                                             @required = "required"
                                         })
                                @Html.ValidationMessageFor(m => m.Risk_CategoryId, "", new { @class = "text-danger" })
                            </td>
                            <td class="text-right col-md-1">
                                <b id="txt_appli">Potential Risk <span style="color: #ff0000"></span></b>
                            </td>
                            <td class="text-right col-md-" id="Other_Potential">
                                @Html.TextAreaFor(x => x.OtherPotential,
                                         new { @class = "form-control", @required = "required", @maxlength = "500", @placeholder = "Please enter potential risk" })
                                @Html.ValidationMessageFor(m => m.OtherPotential, "", new { @class = "text-danger" })
                            </td>
                            <td class="text-right col-md-" id="ddl_Potential">
                                @Html.DropDownListFor(x => x.Potential_RiskId, ViewBag.potentialList as SelectList, "- Select -",
                                         new { @class = "form-control", @id = "ddlPotential", @required = "required" })
                                @Html.ValidationMessageFor(m => m.Potential_RiskId, "", new { @class = "text-danger" })


                            </td>
                        </tr>
                        <tr>
                            <td class="text-right">
                                <b>Risk lead to breach of (C/I/A)<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="text-right">
                                @Html.DropDownListFor(x => x.Risk_LeadId, ViewBag.leadList as SelectList, "- Select -", new { @class = "form-control", @id = "ddlRiskBreach", @required = "required" })
                                @Html.ValidationMessageFor(m => m.Risk_LeadId, "", new { @class = "text-danger" })

                            <td class="text-right"><b>Risk Owner <span style="color: #ff0000">*</span></b></td>
                            <td class="col-md-2">
                                    @Html.TextBoxFor(m => m.Risk_Owner, new { @class = "form-control disable", @placeholder = "Please enter risk owner", @maxlength = "250" })
                            </td>
                            <td class="text-right"><b>frequency <span style="color: #ff0000">*</span></b></td>
                            <td class="text-right">
                                    @Html.DropDownListFor(x => x.Ident_Frequency,
                                             ViewBag.freqList as SelectList, "- Select -",
                                             new { @class = "form-control", @id = "ddl_Ident_Frequency", @required = "required" })
                                    @Html.ValidationMessageFor(m => m.Ident_Frequency, "", new { @class = "text-danger" })
                            </td>
                        </tr>

                        <tr>
                            <td class="text-right"><b>Imapct Type <span style="color: #ff0000">*</span></b></td>
                            <td class="col-md-2">
                                @Html.DropDownListFor(x => x.RiskImactTypeId,
                                         ViewBag.impactTypeList as SelectList, "- Select -",
                                         new { @class = "form-control", @id = "ddlRiskImpact", @required = "required" })
                                @Html.ValidationMessageFor(m => m.RiskImactTypeId, "", new { @class = "text-danger" })
                            </td>
                            <td class="text-right">
                                <b>Impact<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="text-right">
                                @Html.DropDownListFor(x => x.Ident_Imapct,
                                         ViewBag.riskImpactList as SelectList, "- Select -",
                                         new { @class = "form-control", @id = "ddl_Ident_Imapct", @required = "required" })
                                @Html.ValidationMessageFor(m => m.Ident_Imapct, "", new { @class = "text-danger" })
                            </td>

                            <td class="text-right"><b>Degree Risk Level <span style="color: #ff0000">*</span></b></td>
                            <td class="col-md-2">
                                @Html.DropDownListFor(x => x.Ident_Current_Degree_Risk_Lebel, ViewBag.DegLVLList as SelectList, "- Select -", new { @class = "form-control", @id = "ddl_Ident_RiskLVL", @required = "required" })
                                @Html.ValidationMessageFor(m => m.Ident_Current_Degree_Risk_Lebel, "", new { @class = "text-danger" })
                            </td>
                        </tr>


                    </tbody>
                </table>

                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <h4 style="font-weight:bold;font-size: 22px;margin-bottom: 10px;">Risk Analysis(RA)</h4>
                        <tr>
                            <td class="text-right col-md-3">
                                <b>Current measure to prevent the potential risk<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2" colspan="8">
                                <div class="col-md-10" style="width:100%">
                                    @Html.TextAreaFor(m => m.Current_Measures_To_Prevent_Potential_Risk, new { @class = "form-control", @placeholder = "Please enter current measure to potential risk", @maxlength = "500", @required = "required" })
                                    @Html.ValidationMessageFor(m => m.Current_Measures_To_Prevent_Potential_Risk, "", new { @class = "text-danger" })
                                </div>
                            </td>

                        </tr>
                        <tr>
                            <td class="text-right">
                                <b>Current Measure Level<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="text-right">
                                @Html.DropDownListFor(x => x.Current_Measures_Level, ViewBag.riskMeasureList as SelectList, "- Select -", new { @class = "form-control", @required = "required" })
                                @Html.ValidationMessageFor(m => m.Current_Measures_Level, "", new { @class = "text-danger" })
                            </td>

                            <td class="text-right"><b>Frequency <span style="color: #ff0000">*</span></b></td>
                            <td class="col-md-2">
                                @Html.DropDownListFor(x => x.Frequency,
                                         ViewBag.freqList as SelectList, "- Select -",
                                         new { @class = "form-control", @id = "ddl_Frequency", @required = "required" })
                                @Html.ValidationMessageFor(m => m.Frequency, "", new { @class = "text-danger" })
                            </td>
                            <td class="text-right"><b>Impact <span style="color: #ff0000">*</span></b></td>
                            <td class="col-md-2">
                                @Html.DropDownListFor(x => x.Imapct,
                                         ViewBag.riskImpactList as SelectList, "- Select -",
                                         new { @class = "form-control", @required = "required", @id = "ddl_Imapct_RA" })
                                @Html.ValidationMessageFor(m => m.Imapct, "", new { @class = "text-danger" })
                            </td>

                        </tr>

                        <tr>
                            <td class="text-right"><b>Degree Risk Level <span style="color: #ff0000">*</span></b></td>
                            <td class="col-md-2">
                                @Html.DropDownListFor(x => x.Current_Degree_Risk_Lebel, ViewBag.DegLVLList1 as SelectList, "- Select -", new { @class = "form-control", @id = "ddlRiskLVL", @required = "required" })
                                @Html.ValidationMessageFor(m => m.Current_Degree_Risk_Lebel, "", new { @class = "text-danger" })
                            </td>
                        </tr>
                    </tbody>
                </table>


                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <h4 style="font-weight:bold;font-size: 22px;margin-bottom: 10px">Risk Treatment(RT)</h4>

                        <tr id="riskAction">
                            <td class="text-right col-md-2">
                                <b>Action Item<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2" colspan="8">
                                <div class="col-md-12">
                                    @Html.TextAreaFor(x => x.Action_Item, new { @class = "form-control", @placeholder = "Please enter action item", @required = "required" })
                                    @Html.ValidationMessageFor(m => m.Action_Item, "", new { @class = "text-danger" })
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right">
                                <b>Risk Treatment Level<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="text-right">
                                @Html.DropDownListFor(x => x.Risk_Treatment_for_Risk_Level, ViewBag.riskTRTList as SelectList, "- Select -", new { @class = "form-control", @id = "ddlRiskTRTLVL" })
                                @Html.ValidationMessageFor(m => m.Risk_Treatment_for_Risk_Level, "", new { @class = "text-danger" })
                            </td>

                            <td class="text-right" id="response"><b>Responsbility <span style="color: #ff0000">*</span></b></td>
                            <td class="col-md-2" id="response1">
                                @Html.TextBoxFor(x => x.Responsbility, new { @class = "form-control", @placeholder = "Please enter PIC name", @required = "required" })
                                @Html.ValidationMessageFor(m => m.Responsbility, "", new { @class = "text-danger" })
                            </td>
                            <td class="text-right" id="Tdate"><b>Target Date <span style="color: #ff0000">*</span></b></td>
                            <td class="col-md-2" id="Tdate1">
                                @Html.TextBoxFor(x => x.Target_Date, new { @class = "form-control", @placeholder = "Please select target date", @required = "required" })
                                @Html.ValidationMessageFor(m => m.Target_Date, "", new { @class = "text-danger" })
                            </td>
                        </tr>

                        <tr id="statusTRT">
                            <td class="text-right">
                                <b>Status<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="text-right">
                                @Html.DropDownListFor(x => x.Risk_Status, new List<SelectListItem>
                            {
                            new SelectListItem{Text="Open",Value="1"},
                            new SelectListItem{Text="Close",Value="2"},
                            }, new { @id = "ddlStatus", @class = "form-control" })
                            </td>
                        </tr>


                    </tbody>
                </table>

                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <h4 style="font-weight:bold;font-size: 22px;margin-bottom: 10px" id="RRAHeading">Residual Risk Analysis(RRA)</h4>

                        <tr>
                            <td class="text-right" id="RRAfrequendy">
                                <b>Frequency<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="text-right" id="RRAfrequendy1">
                                @Html.DropDownListFor(x => x.Frequency_RRA,
                                         ViewBag.freqList as SelectList, "- Select -",
                                         new { @class = "form-control", @id = "ddl_Frequency_RRA", @required = "required" })
                                @Html.ValidationMessageFor(m => m.Frequency_RRA, "", new { @class = "text-danger" })
                            </td>
                            <td class="text-right" id="RRAImpct"><b>Impact <span style="color: #ff0000">*</span></b></td>
                            <td class="col-md-2" id="RRAImpct1">
                                @Html.DropDownListFor(x => x.Imapct_RRA,
                                         ViewBag.riskImpactList as SelectList, "- Select -",
                                         new { @class = "form-control", @required = "required", @id = "ddl_Imapct_RRA" })
                                @Html.ValidationMessageFor(m => m.Imapct_RRA, "", new { @class = "text-danger" })
                            </td>

                            <td class="text-right" id="RRAdeglvl"><b>Degree Level <span style="color: #ff0000">*</span></b></td>
                            <td class="col-md-2" id="RRAdeglvl1">
                                @Html.DropDownListFor(x => x.Risk_Degree_Level_RRA, ViewBag.DegLVLList2 as SelectList, "- Select -", new { @class = "form-control", id = "ddlRRLevel", @required = "required" })
                                @Html.ValidationMessageFor(m => m.Risk_Degree_Level_RRA, "", new { @class = "text-danger" })
                            </td>
                        </tr>

                        <tr>
                            <td colspan="10" style="text-align:center;">
                                <div class="col-md-12" style="align-items: center;">
                                    <input type="submit" class="bttn btn-success" value="Submit" id="btnSubmit" data-loading-text="Submitting..." autocomplete="off"
                                           name="btnSubmit" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>
    }

</div>

@section Scripts{

<script src="~/js/jquery.validate.min.js"></script>
@* @Scripts.Render("~/bundles/jqueryval") *@
@*<script type="text/javascript" src="~/lib/bootstrap/js/bootstrap.min.js"></script>*@
