<script src="~/Scripts/table2excel.js"></script>
<script type="text/javascript" language="javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $(function () {
        debugger;

        $('#Target_Date').datepicker({
            format: "dd/mm/yyyy",
            todayHighlight: true,
            autoclose: true,
            clearBtn: true,
            startDate: new Date(),
        });
    });

</script>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">

    function BindIdentityImpactRiskLVLOnChange() {
        debugger;
        var impId = $('#RiskImactTypeId').val();
        var select = $("#ddl_Ident_Imapct");
        select.empty();
        select.append($('<option />', {
            value: "",
            text: "--Please wait--"
        }));
        var select1 = $("#ddl_Imapct_RA");
        select1.empty();
        select1.append($('<option />', {
            value: "",
            text: "--Please wait--"
        }));

        var select2 = $("#ddl_Imapct_RRA");
        select2.empty();
        select2.append($('<option />', {
            value: "",
            text: "--Please wait--"
        }));
        var select5 = $("#ddl_Ident_RiskLVL");
        select5.empty();
        select5.append($('<option />', {
            value: "",
            text: "--Please wait--"
        }));
        if (impId != "" && impId != "") {
            $.getJSON("/RiskAssessment/GetImpactByImpactTypeId", {impTypeId: impId},
                      function (data) {
                          debugger;
                          select.empty();
                          if (data != null) {
                              select.append($('<option />', {
                                  value: "",
                                  text: "--Select--"
                              }));
                              $.each(data, function (index, itemData) {
                                  select.append($('<option />', {
                                      value: itemData.RiskLevelid,
                                      text: itemData.DegreeOfImpact
                                  }));
                                  select1.append($('<option />', {
                                      value: itemData.RiskLevelid,
                                      text: itemData.DegreeOfImpact
                                  }));
                                  select2.append($('<option />', {
                                      value: itemData.RiskLevelid,
                                      text: itemData.DegreeOfImpact
                                  }));
                              });


                          }
                          else {
                              select.append($('<option />', {
                                  value: "",
                                  text: "--No record--"
                              }));
                              select1.append($('<option />', {
                                  value: "",
                                  text: "--No record--"
                              }));
                              select2.append($('<option />', {
                                  value: "",
                                  text: "--No record--"
                              }));
                          }
                      });
        }
        else {
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Select--"
            }));

            select1.empty();
            select1.append($('<option />', {
                value: "",
                text: "--Select--"
            }));
            select2.empty();
            select2.append($('<option />', {
                value: "",
                text: "--Select--"
            }));
        }

    };

    function BindAllFrequencyExceptRiskIdenificationOnChange() {
        debugger;
        var impId = $('#Ident_Frequency').val();
        var select = $("#ddl_Frequency");
        var select1 = $("#ddl_Frequency_RRA");
        select.empty();
        select.append($('<option />', {
            value: "",
            text: "--Please wait--"
        }));
        select1.empty();
        select1.append($('<option />', {
            value: "",
            text: "--Please wait--"
        }));
        if (impId != "" && impId != "") {
            $.getJSON("/RiskAssessment/GetFrequencyByFrequencyId", { freqId: impId },
                      function (data) {
                          debugger;
                          select.empty();
                          select1.empty();
                          if (data != null) {

                              $.each(data, function (index, itemData) {
                                  select.append($('<option />', {
                                      value: itemData.FrequencyLevelId,
                                      text: itemData.DegreeOfFrequency
                                  }));
                                  select1.append($('<option />', {
                                      value: itemData.FrequencyLevelId,
                                      text: itemData.DegreeOfFrequency
                                  }));
                              });
                              BindDegreeRiskLVLOnChange();

                          }
                          else {
                              select.append($('<option />', {
                                  value: "",
                                  text: "--No record--"
                              }));
                              select1.append($('<option />', {
                                  value: "",
                                  text: "--No record--"
                              }));
                          }
                      });
        }
        else {
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Select--"
            }));

            select1.empty();
            select1.append($('<option />', {
                value: "",
                text: "--Select--"
            }));

        }

    };




    function BindIdentityDegreeRiskLVLOnChange() {
        debugger;
        var freqID = $('#Ident_Frequency').val();
        var impID = $('#ddl_Ident_Imapct').val();
        var select = $("#ddl_Ident_RiskLVL");
