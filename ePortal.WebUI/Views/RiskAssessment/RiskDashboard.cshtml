
@{
    ViewBag.Title = "Risk Dashboard";
    Layout = "~/Views/Shared/_LayoutAsset.cshtml";
}

@section Styles{
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />

    <style nonce="@Context.Items["StyleNonce_0"]">
        a:hover {
            background-color: white;
            color: rgb(0,32,96) !important;
        }

        #LastKi_filter, #LastKi_info, #LastKi_length {
            display: none;
        }

        #LastKi_filter {
            display: none;
        }

        #LastKi_info, #LastKi_length {
            font-size: 12px !important;
        }

        #LastKi_paginate {
            font-size: 12px !important;
        }

        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .ui-widget-header, .ui-state-default, ui-button {
            font-weight: bold;
            font-size: 16px;
        }

        .ui-dialog .ui-dialog-content {
            font-size: 14px;
        }

        .ui-dialog-buttonset {
            font-size: 16px;
        }

        .btn1 {
            width: 190px !important;
            font-size: 14px !important;
            background-color: #e3e3e3;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
        }

        .ui-dialog-titlebar-close:before {
            content: "x";
        }
    </style>

}



<div class="col-lg-12 col-md-12" style="margin-top:-1%;">&nbsp;</div>
@if (TempData["msg"] != null)
{
        <span class="error" style="font-size:16px;font-weight:bold;">
        @TempData["msg"].ToString()
        </span>
        <br />    <br />
}
<div class="row">
    <div class="col-md-5" style="border: 1px solid;background-color: aliceblue;height: 54px;">
        <table>
            <tr>
                <td style="width:10%;text-align: center;color: blue;padding-top: 0.5%;"><i class="glyphicon glyphicon-unchecked"></i></td>
                <td style="width:10%;text-align: center;color: orangered;"><i class="glyphicon glyphicon-exclamation-sign"></i></td>
                <td style="width:10%;text-align: center;color: green;"><i class="glyphicon glyphicon-check"></i></td>
            </tr>
            <tr>
                <td style="width:10%;font-size:14px;text-align: center;font-weight: bold;">Not Started</td>
                <td style="width:10%;font-size:14px;text-align: center;font-weight: bold;">Pending</td>
                <td style="width:10%;font-size:14px;text-align: center;font-weight: bold;">Completed</td>

            </tr>
        </table>
    </div>
    <div class="col-md-5" style="background-color:rgb(0,32,96);border: 1px solid;">
        <p style="font-size:18px;text-align: center;color: white;height: 53px;padding-top:3%;"><b> Information Risk Assessment Completion Date :  @ViewBag.endate </b></p>
    </div>
    <div class="col-md-2" style="background-color:#ce1010;border: 1px solid;">
        <p style="font-size:18px;text-align: center;color: white;height: 53px;padding-top:7%;"><b> Days Left :  @ViewBag.nodaysleft </b></p>
    </div>
</div>
<br />
<div class="row">
    <div class="col-lg-4 col-md-4">
        <a href="~/Asset Register/ISSC Nomination File/Information Asset Register Guideline updated.pdf" target="_blank" style="display:inline-block;width:100%;">
            <img style="height: 297px; width: 88%;padding-left: 1%;" src="~/Asset Register/ISSC Nomination File/Risk-Assessment_L.jpg" />
        </a>
    </div>
    <table class="col-md-5" style="font-size:13px;border:1px solid;font-weight: bold;padding-left: 1%;">
        <tbody>
            <tr>
                <td style="font-size:16px;border:1px solid;padding:18px;">Division Name</td>
                <td style="width:60%;font-size:16px;border:1px solid;text-align:center;">@ViewBag.Division </td>
            </tr>
            <tr>
                <td style="font-size:16px;border:1px solid;padding:18px;">ISSC Member</td>
                <td style="width:20%;font-size:16px;border:1px solid;text-align:center;">@ViewBag.ISSC </td>
            </tr>
            <tr>
                <td style="font-size:16px;border:1px solid;padding:18px;">Risk Updation (self)</td>
                <td style="width:50px;font-size:30px;text-align:center;border:1px solid;">
                    @if (ViewBag.ISSCStatus == 1)
                    {
                            <a href="../RiskAssessment/RiskRegister">
                                <i style="color: green;" class="glyphicon glyphicon-check"></i>
                            </a>
                            <span style="font-size: 14px;position: absolute; top: 48%;left: 67%;"> @Convert.ToDateTime(ViewBag.ISSCFinalDate).ToString("dd/MM/yyyy")</span>
                    }
                    else
                    {
                            <a href="../RiskAssessment/RiskRegister">
                                <i style="color: orangered;" class="glyphicon glyphicon-exclamation-sign"></i>
                            </a>
                    }

                </td>
            </tr>
            <tr>
                <td style="font-size:16px;border:1px solid;padding:18px;">Division Head Approval   <br />(@ViewBag.DHeadName)</td>
                <td style="width:50px;font-size:30px;text-align:center;border:1px solid;">
                    @if (ViewBag.ISSCStatus == 1)
                    {
                        if (ViewBag.Divisionstatus == 1)
                        {
                                    <a href="@Url.Action("RiskRemarkByDivisionHead", "RiskAssessment", new { ISSC_Code = ViewBag.ISSC_MemberCode })">
                                        <i style="color: green;" class="glyphicon glyphicon-check"></i>
                                    </a>
                                    <span style="font-size: 14px;position: absolute; top: 67%;left: 67%;"> @Convert.ToDateTime(ViewBag.DivisionFinalDate).ToString("dd/MM/yyyy")</span>
                        }
                        else
                        {
                                    <i style="color:orangered;" class="glyphicon glyphicon-exclamation-sign"></i>
                        }
                    }
                    else
                    {
                            <i style="color: blue;" class="glyphicon glyphicon-unchecked"></i>
                    }
                </td>
            </tr>
            <tr>
                <td style="font-size:16px;border:1px solid;padding:18px;width:44%;">Operating Head Approval <br />(@ViewBag.OHeadName)</td>
                <td style="width:50px;font-size:30px;text-align:center;border:1px solid;">
                    @if (ViewBag.OperatingStatus == 1)
                    {
                            <a href="@Url.Action("RiskRemarkByDivisionHead", "RiskAssessment", new { ISSC_Code = ViewBag.ISSC_MemberCode })">
                                <i style="color: green;" class="glyphicon glyphicon-check"></i>
                            </a>

                            <span style="font-size: 14px;position: absolute; top: 89%;left: 67%;"> @Convert.ToDateTime(ViewBag.OperatingFinalDate).ToString("dd/MM/yyyy")</span>
                    }
                    else
                    {
                            <i style="color: blue;" class="glyphicon glyphicon-unchecked"></i>
                    }
                </td>
            </tr>
        </tbody>
    </table>

    <div class="col-lg-3 col-md-3">
        @if (ViewBag.Lastki_details.Count > 0 && ViewBag.Lastki_details != null)
        {
            <p style="font-size:18px;font-weight: bold;text-align: center;padding-bottom: 2%;">Last Year Information Risk Assessment</p>
        }
        <table class="table" style="font-size:13px;border:1px solid;margin-left:1.5%;" id="LastKi">
            @if (ViewBag.Lastki_details.Count > 0 && ViewBag.Lastki_details != null)
            {
                    <thead>
                        <tr style="background-color: lightblue;text-align:center;">
                            <th style="text-align:center;">ki</th>
                            <th style="text-align:center;">Details</th>
                        </tr>
                    </thead>
            }
            <tbody>

                @if (ViewBag.Lastki_details != null)
                {
                    foreach (var item in ViewBag.Lastki_details)
                    {
                            <tr style="text-align:center;">
                                <td>@item.KICODE</td>
                                <td><a style="font-size: 25px;" href="@Url.Action("LastYearKiRiskDetails", "RiskAssessment", new { SkyiId = @item.SYKIID })" class="glyphicon glyphicon-list-alt"></a></td>
                            </tr>
                    }
                }
                else
                {
                        <tr>
                            <td colspan="2">No Record Found.</td>
                            <td style="display: none"></td>
                        </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-lg-12 col-md-12" style="padding-top:0%;">&nbsp;</div>
    <div class="col-lg-12 col-md-12" style="background-color:rgb(0,32,96);color:white;">
        <p style="font-size: 20px;padding: .5%">
            <a href="~/Asset Register/ISSC Nomination File/Information Asset Register Guideline updated.pdf" target="_blank" style="color:white;">
                Click here
            </a> to understand "how to fill Information Risk Assessment". If you are already familiar, please start activity by clicking on pending icon.

        </p>
    </div>

</div>

@section Scripts{
    <script nonce="@Context.Items["ScriptNonce_3"]">
        $('#LastKi').DataTable({
            pageLength: 5,
            "bSort": false
        });
    </script>
}

