@model ePortal.ViewModels.A00ViewModel
@{
    ViewBag.Title = "Last Year Information Risk Assessment";
    Layout = "~/Views/Shared/_LayoutAsset.cshtml";
}
@section Styles{
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />
    <style nonce="@Context.Items["StyleNonce_0"]">
        #LastKi_filter, #LastKi_length {
            display: none;
        }

        #LastKi_info {
            font-size: 12px !important;
        }

        #LastKi_length select {
            width: 32% !important;
            padding-top: 0px;
        }

        .pagination {
            font-size: 12px !important;
        }

        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .ui-widget-header, .ui-state-default, ui-button {
            font-weight: bold;
            font-size: 16px;
        }

        .ui-dialog .ui-dialog-content {
            font-size: 14px;
        }

        .ui-dialog-buttonset {
            font-size: 16px;
        }

        .btn1 {
            width: 190px !important;
            font-size: 14px !important;
            background-color: #e3e3e3;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
        }

        .ui-dialog-titlebar-close:before {
            content: "x";
        }
    </style>
}

<div class="row" id="Grid">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>
    <div style="padding: 1% !important;">
        <table class="table" style="font-size:13px;border:1px solid;width:96%;" id="LastKi">
            <thead>
                <tr>
                <tr style="background-color: lightblue;">
                    <th style="border:1px solid;text-align:center; width:5px;font-weight:bold;">S.No.</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Primary Risk")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Risk Category")</th>
                    <th style="border:1px solid;text-align:center; width:6%;font-weight:bold;">@Html.DisplayName("Potential Risk")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Risk lead to breach of (C/I/A)")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Current Measures to prevent the Potential risk")</th>
                    <th style="border:1px solid;text-align:center; width:5%;font-weight:bold;">@Html.DisplayName("Frequency")</th>
                    <th style="border:1px solid;text-align:center; width:5%;font-weight:bold;">@Html.DisplayName("Impact")</th>
                    <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@Html.DisplayName("Current Degree/ Risk Level ")</th>
                    <th style="border:1px solid;text-align:center; width:3%;font-weight:bold;">@Html.DisplayName("Risk Treatment  for Risk Level S/A/B")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Action item")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Responsibility")</th>
                    <th style="border:1px solid;text-align:center; width:10%;font-weight:bold;">@Html.DisplayName("Target Date")</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 1;
                    foreach (var item in ViewBag.Riskdetails)
                    {

                        <tr>
                            <td style="border:1px solid;text-align:center;">@index</td>
                            <td style="border:1px solid;text-align:center;">@item.PrimaryRisk</td>
                            <td style="border:1px solid;text-align:center;">@item.RiskCategory</td>
                            @if (@item.PotentialRisk != null)
                            {
                                <td style="border:1px solid;text-align:center;">@item.PotentialRisk</td>
                            }
                            else
                            {
                                <td style="border:1px solid;text-align:center;">@item.Other_Potential_Risk</td>
                            }

                            <td style="border:1px solid;text-align:center;">@item.RiskLeadToBreach</td>
                            <td style="border:1px solid;text-align:center;">@item.CM_To_Pre_Potential_Risk</td>
                            <td style="border:1px solid;text-align:center;">@item.Frequency_RA</td>
                            <td style="border:1px solid;text-align:center;">@item.Impact_RA</td>
                            <td style="border:1px solid;text-align:center;">@item.Current_Risk_Level_RA</td>
                            <td style="border:1px solid;text-align:center;">@item.Treatement_For_Risk_Level</td>
                            <td style="border:1px solid;text-align:center;">@item.ActionItem</td>
                            <td style="border:1px solid;text-align:center;">@item.Responsebiity</td>
                            @if (@item.TargetDate != null)
                            {
                                <td style="border:1px solid;text-align:center;">@Convert.ToDateTime(@item.TargetDate).ToString("dd/MM/yyyy")</td>
                            }
                            else
                            {
                                <td style="border:1px solid;text-align:center;"></td>
                            }

                        </tr>
                        index++;
                    }
                    if (ViewBag.Riskdetails.Count == 0)
                    {
                        <tr>
                            <td colspan="13" style="border:1px solid;text-align:center;">No record found.</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <br />
        <table class="table table-bordered table-hover table-responsive">
            <tr style="background-color:#f3f3f3">
                <td style="height: 20px;font-size: 14px;">
                    <table style="width: 100%;">
                        <tbody>
                            <tr>
                                <td colspan="4">
                                    <a title="Back" href="#">
                                        <img src="~/images/icon_back.gif" border="0" alt="">
                                        Back
                                    </a>
                                </td>

                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </table>
    </div>

</div>

@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#LastKi').DataTable({
                pageLength: 1000,
            });
        });
    </script>

@*<script src="https://cdn.datatables.net/1.10.23/js/jquery.dataTables.min.js"></script>*@
<script nonce="@Context.Items["ScriptNonce_4"]">
    function goBack() {
        window.history.back();
    }
</script>
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
    $(document).ready(function () {
        $('#btnBack').on('click', function () {
            goBack();
        });
    });
</script>
}
