@model ePortal.ViewModels.A00ViewModel
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_LayoutAsset.cshtml";

    var List = ViewBag.ViewToList as List<ePortal.ViewModels.AssetRegistrationSearchModel>;
}

@section Styles{
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />


    <style nonce="@Context.Items["StyleNonce_0"]">
        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .ui-widget-header, .ui-state-default, ui-button {
            font-weight: bold;
            font-size: 16px;
        }

        .ui-dialog .ui-dialog-content {
            font-size: 14px;
        }

        .ui-dialog-buttonset {
            font-size: 16px;
        }

        .btn1 {
            width: 190px !important;
            font-size: 14px !important;
            background-color: #e3e3e3;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
        }

        .ui-dialog-titlebar-close:before {
            content: "x";
        }
    </style>

}


<div class="row" id="Grid">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>
    @using (Html.BeginForm("RiskSearch", "RiskAssessment", FormMethod.Post, new { encType = "multipart/form-data", id = "AssetRegister" }))
    {
        <div class="body-content" style="overflow-x:hidden">
            <div id="form-group">
                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <tr>
                            <td class="text-right">
                                <b>ki<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-3">
                                @Html.DropDownList("SYKIDatanew", ViewBag.SYKIDatanew as SelectList, new { @class = "form-control", name = "Ki", id = "Ki", })
                            </td>
                            <td class="text-right">
                                <b>Operation<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-3">
                                @Html.DropDownList("OPERATIONID", (IEnumerable<SelectListItem>)ViewBag.OpList, "- Select -",
                                         new { @id = "ddlOp", @class = "form-control", name = "Division" })
                            </td>
                            <td class="text-right">
                                <b>Division<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-3">
                                @Html.DropDownList("DIVISIONID", (IEnumerable<SelectListItem>)ViewBag.DivisionList, "- Select -",
                                         new { @id = "DIVISIONID", @class = "form-control" })
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" style="text-align:center;">
                                <div class="col-md-12" style="align-items: center;">
                                    <input type="submit" class="bttn btn-success btn_disable" value="Search" id="btnSubmitt" name="btnSubmit" style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold ;" />
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
<div class="row" style="padding: 1px !important;">
    <div class="col-md-12" style="padding: 1px !important;">
        <h7 class="text-center"><b> Risk Level Wise Summary </b></h7>
        <hr />
    </div>
    <div class="col-md-12 col-lg-12 col-sm-12" style="padding: 1px !important;">
        <div id="chartContainer" style="height: 500px;"></div>
    </div>
    <div class="col-md-12" style="padding: 1px !important;">
        <h7 class="text-center"><b>Division Wise Risk Count </b></h7>
        <hr />
    </div>
    <div class="col-md-12 col-lg-12 col-sm-12" style="padding: 1px !important;">
        <div id="container" style="padding-top: 2%; height: 500px; width:100%;">
        </div>
    </div>
</div>

@section Scripts{

@*@Scripts.Render("~/bundles/jqueryval")*@
<script src="~/Scripts/loader.js"></script>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

    google.charts.load('current', {packages: ['corechart']});
    $("#btnSubmitt").click(function () {
        debugger;
        var OPID = $("#ddlOp").val();
        var DivId = $('#DIVISIONID').val();

        if (OPID == "") {
            alert('Please select operation.');
            return false;
        }
        else if (DivId == "") {
            alert('Please select division.');
            return false;
        }
    });
</script>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        function BindOperation(crnt, call) {
            var dID = $(crnt).val();
            var select = $("#ddlOp");
            if (dID != "") {
                $.getJSON("/RiskAssessment/BindOperationId", { SYKIID: dID },
                      function (data) {
                          select.empty();
                          if (data.length > 0) {
                              select.append($('<option />', {
                                  value: "",
                                  text: "--Select--"
                              }));
                              $.each(data, function (index, itemData) {
                                  select.append($('<option />', {
                                      value: itemData.ADORGLEVELID,
                                      text: itemData.LEVELDESCRIP
                                  }));
                              });
                          }
                          else {
                              select.append($('<option />', {
                                  value: "",
                                  text: "--No record--"
                              }));
                          }
                      });
            }
            else {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Select--"
                }));

            }


            // chart
            $.getJSON("/RiskAssessment/BindDivisionHeadChart1", { SYKIID: dID },
                     function (data) {
                         debugger;
                         if (data.length > 0) {
                             var d_ = data.split(',');
                             var TSCount=  d_[0];
                             var TACount= d_[1];
                             var TBCount=  d_[2];
                             var TCCount= d_[3];
                             var TDCount=  d_[4];
                             var data = google.visualization.arrayToDataTable([
                                ['Task', 'Hours per Day'],
                                ['Extreme',   TSCount ],
    ['High',      TACount ],
    ['Medium',  TBCount ],
    ['Low',      TCCount ],
    ['Very Low',  TDCount ],
                             ]);

                             var options = {
                                 //title: 'My Daily Activities',
                                 pieHole: 0.4,
                                 colors: ['#FA364C', '#FFA360', '#FFC65F', '#A0C460', '#5EC665']
                             };

                             var chart = new google.visualization.PieChart(document.getElementById('chartContainer'));
                             chart.draw(data, options);
                         }
                         else {

                         }
                     });

            $.getJSON("/RiskAssessment/BindDivisionHeadChart2",
                   function (data) {
                       if (data.length > 0) {
                           var cdata=data;
                           var data1=[];
                           var Header= ['Genre', 'Extreme', 'High', 'Medium', 'Low', 'Very Low', { role: 'annotation' }];
                           data1.push(Header);
                           for (var i = 0; i < cdata.length; i++) {
                               var temp=[];
                               temp.push(cdata[i].DivisionName);
                               temp.push(cdata[i].TSCount);
                               temp.push(cdata[i].TACount);
                               temp.push(cdata[i].TBCount);
                               temp.push(cdata[i].TCCount);
                               temp.push(cdata[i].TDCount);
                               temp.push('');
                               data1.push(temp);
                           }
                           if(cdata.length==0)
                           {   var temp=[];
                               temp.push('');
                               temp.push(0);
                               temp.push(0);
                               temp.push(0);
                               temp.push(0);
                               temp.push(0);
                               temp.push('');
                               data1.push(temp);
                           }
                           var data = google.visualization.arrayToDataTable(data1);
                           var options = {
                               height: 400,
                               legend: { position: 'top', maxLines: 3 },
                               bar: { groupWidth: '75%' },
                               isStacked: true,
                               colors: ['#FA364C', '#FFA360', '#FFC65F', '#A0C460', '#5EC665']
                               //title: 'Division wise Asset Count',
                               //titleFontSize:18
                           };
                           // Instantiate and draw the chart.
                           var chart = new google.visualization.ColumnChart(document.getElementById('container'));
                           chart.draw(data, options);
                       }
                       else {

                       }
                   });

        };

        function BindDivision(crnt, call) {
            var dID = $(crnt).val();
            var select = $("#DIVISIONID");
            if (dID != "") {
                $.getJSON("/RiskAssessment/GetOperationIdsByLoginUserId", { id: dID },
                      function (data) {
                          select.empty();
                          if (data.length > 0) {
                              select.append($('<option />', {
                                  value: "",
                                  text: "--Select--"
                              }));

                              $.each(data, function (index, itemData) {
                                  select.append($('<option />', {
                                      value: itemData.DIVISIONID,
                                      text: itemData.DIVISION
                                  }));
                              });
                          }
                          else {
                              select.append($('<option />', {
                                  value: "",
                                  text: "--No record--"
                              }));
                          }
                      });
            }
            else {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Select--"
                }));
            }
        };

</script>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        // google.charts.load("current", {packages:["corechart"]});
        google.charts.setOnLoadCallback(drawChart);
        function drawChart() {
            var data = google.visualization.arrayToDataTable([
              ['Task', 'Hours per Day'],
              ['Extreme',   @ViewBag.Extreme],
    ['High',      @ViewBag.High],
    ['Medium',  @ViewBag.Medium ],
    ['Low',      @ViewBag.Low ],
    ['Very Low',  @ViewBag.VeryLow ],
            ]);

            var options = {
                //title: 'My Daily Activities',
                pieHole: 0.4,
                colors: ['#FA364C', '#FFA360', '#FFC65F', '#A0C460', '#5EC665']
            };

            var chart = new google.visualization.PieChart(document.getElementById('chartContainer'));
            chart.draw(data, options);
        }
</script>


<script language="JavaScript" nonce="@Context.Items["ScriptNonce_6"]">
    function drawChart() {
            var cdata=@Html.Raw(Json.Serialize(@ViewBag.divcount));
        var data1=[];
        var Header= ['Genre', 'Extreme', 'High', 'Medium', 'Low', 'Very Low', { role: 'annotation' }];
        data1.push(Header);
        for (var i = 0; i < cdata.length; i++) {
            var temp=[];
            temp.push(cdata[i].DivisionName);
            temp.push(cdata[i].TSCount);
            temp.push(cdata[i].TACount);
            temp.push(cdata[i].TBCount);
            temp.push(cdata[i].TCCount);
            temp.push(cdata[i].TDCount);
            temp.push('');
            data1.push(temp);
        }
        if(cdata.length==0)
        {   var temp=[];
            temp.push('');
            temp.push(0);
            temp.push(0);
            temp.push(0);
            temp.push(0);
            temp.push(0);
            temp.push('');
            data1.push(temp);
        }
        var data = google.visualization.arrayToDataTable(data1);
        var options = {
            height: 400,
            legend: { position: 'top', maxLines: 3 },
            bar: { groupWidth: '75%' },
            isStacked: true,
            colors: ['#FA364C', '#FFA360', '#FFC65F', '#A0C460', '#5EC665']
            //title: 'Division wise Asset Count',
            //titleFontSize:18
        };
        // Instantiate and draw the chart.
        var chart = new google.visualization.ColumnChart(document.getElementById('container'));
        chart.draw(data, options);
    }
    google.charts.setOnLoadCallback(drawChart);
</script>
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
    $(document).ready(function () {
        $('#Ki').on('change', function () {
            BindOperation(this, 0);
        });
        $('#ddlOp').on('change', function () {
            BindDivision(this, 0);
        });
    });
</script>

}



