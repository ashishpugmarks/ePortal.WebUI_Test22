@model ePortal.ViewModels.RiskStatementCreVM
@{
    ViewBag.Title = "Potential Risk";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
        <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />

    <style nonce="@Context.Items["StyleNonce_0"]">
        .qwerty {
            background: #eee;
            pointer-events: none;
            touch-action: none;
        }

        .qwerty1 {
            background-color: #ccc !important;
            pointer-events: none;
            touch-action: none;
        }

        #GetData_filter, #GetData_length {
            display: none;
        }

        #GetData_info {
            display: none;
            font-size: 12px !important;
        }

        #GetData_length select {
            width: 30% !important;
            padding: 0px;
        }

        .pagination {
            display: none;
            font-size: 12px !important;
        }

        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .ui-widget-header, .ui-state-default, ui-button {
            font-weight: bold;
            font-size: 16px;
        }

        .ui-dialog .ui-dialog-content {
            font-size: 14px;
        }

        .ui-dialog-buttonset {
            font-size: 16px;
        }

        .btn1 {
            width: 190px !important;
            font-size: 14px !important;
            background-color: #e3e3e3;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
        }

        .ui-dialog-titlebar-close:before {
            content: "x";
        }
    </style>
}


<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>
    @if (TempData["msg"] != null)
    {
        <div style="vertical-align: middle;width:98%;margin-left:.5%;">
            <div style="padding:8px; font-size:12px;font-weight:normal;" class="error">@TempData["msg"]</div>
        </div>
    }

    @using (Html.BeginForm("PotentialRisk", "RiskAssessment", FormMethod.Post, new { encType = "multipart/form-data", id = "RiskRegister" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(x => x.StatementId)

        <div class="body-content" style="overflow-x:hidden">
            <div id="msform">
                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <tr>
                            <td class="text-right col-md-1">
                                <b>Risk Category<span style="color: #ff0000"></span></b>
                            </td>
                            <td class="text-right col-md-1">
                                @Html.DropDownListFor(x => x.RiskId, ViewBag.RiskCategories as SelectList, "- Select -",
                                         new
                                         {
                                             @class = "form-control",
                                             @id = "ddlCateogory",
                                             @required = "required"
                                         })
                                @Html.ValidationMessageFor(m => m.RiskId, "", new { @class = "text-danger" })
                            </td>
                            <td class="text-right col-md-1">
                                <b>Potential Risk<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-2">
                                <div class="col-md-12">
                                    @Html.TextBoxFor(x => x.Statement,
                                             new { @class = "form-control", @required = "required", @maxlength = "200", @placeholder = "Please enter potential risk" })
                                    @Html.ValidationMessageFor(m => m.Statement, "", new { @class = "text-danger" })
                                </div>
                            </td>

                        </tr>
                        <tr>
                            <td colspan="10" style="text-align:center;">
                                <div class="col-md-12" style="align-items: center;">
                                    <input type="submit" class="bttn btn-success" value="Submit" id="btnSubmit" data-loading-text="Submitting..." autocomplete="off"
                                           name="btnSubmit" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>
    }
</div>

@section Scripts{
    <script src="~/bundle/jqueryval.min.js"></script>
    @*<script type="text/javascript" src="~/assets/lib/bootstrap/js/bootstrap.min.js"></script>*@
    @*<script src="~/assets/bootstrap/js/bootstrap-datepicker.js"></script>*@
    <script src="~/Scripts/table2excel.js"></script>
}

