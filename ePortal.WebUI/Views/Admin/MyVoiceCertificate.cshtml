@model IEnumerable<ePortal.ViewModels.MyVoiceViewModel>
@{
    ViewBag.Title = "MyVoiceCertificate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../assets/images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
    </style>
    }
    @section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $("#tbMyVoiceCertificate").dataTable({
                "bFilter": true,
                "bLengthChange": true,
                "scrollX": false,
            });

             $('[data-ctrl-id="bt-GenerateSent-dt"]').on('click', function () {
                   GenerateCertificate($(this)[0]);
             });
             $('[data-ctrl-id="bt-Generate-dt"]').on('click', function(){
                   GenerateCertificate($(this)[0]);
             });

          $('#btnSubmit').on('click', function () {
              $('form').validate();
              if ($('form').valid())
                  $(this).button('loading') // button text will be "finished!"
          });

        });
    
       function GenerateCertificate(crnt) {
            var row_id = $(crnt).attr("data-id");
            var name = $(crnt).attr("data-name");
            var date = $(crnt).attr("data-date");
            var certificate = $(crnt).attr("data-certificate");
            var mailto = $(crnt).attr("data-mailto");
                 var GenInput= { ID: row_id, EMP_NAME: name, IMPLEMENTED_ON: date, EMAILID: mailto, CERTIFICATE_NAME: certificate }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/Admin/CertificateGeneration",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                data: JSON.stringify(GenInput),
               // data: JSON.stringify({ id: row_id, name: name, date: date, mailTo: mailto, certificateName: certificate }),                 
                success: function (data) {
                    if (data == "1") {
                        swal({
                            title: "",
                            text: "Certificate generated and Email sent successfully.",
                            type: "success",
                        },
                        function (isConfirm) {
                            if (isConfirm) {
                                window.location.href = "/Admin/MyVoiceCertificate";
                            }
                        });
                    }
                    else {
                        sweetAlert("", "Certificate not generate, Please try again.", "warning");
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
                       
    </script>
    }

    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">My Voice Certificate Generation</div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>My Voice List</strong>
                            @*<strong class="pull-right">
                                    <button class="btn btn-success btn-xs" onclick="AddGroup();">Add Group</button>
                                </strong>*@
                        </h2>
                    </div>
                    <div class="panel-body">
                        <div class="row" style="padding:4px;">

                        @using (Html.BeginForm("myvoicecertificate", "admin", FormMethod.Post, new { @name = "MyVoiceCertificate" }))
                        {
                            @Html.AntiForgeryToken()
                            @* @Html.Label("lblCertificateGeneration","Certificate Generation", new { @class = "control-label text-right col-md-2", @style = "margin-top: 7px;" }) *@
                            <label class="control-label text-right col-md-2" style="margin-top: 7px;">Certificate Generation</label>
                            <div class="col-md-2 col-lg-2">
                                @Html.DropDownList("searchFilter", new List<SelectListItem>
                            {
                            new SelectListItem{ Text="Pending", Value = "0" },
                            new SelectListItem{ Text="Certificate Generated", Value = "1" },
                            }, new { @id = "ddlCertificateGeneration", @name = "ddlCertificateGeneration", @class = "form-control" })
                            </div>
                            <div class="col-md-2 col-lg-2">
                                <input type="submit" name="btnSubmit" id="btnSubmit" value="Search" class="btn btn-success" />
                                <input type="button" value="Reset" name="btReset" id="btReset" class="btn btn-default btn-sm" onclick="location.href='@Url.Action("MyVoiceCertificate", "Admin")'" />
                            </div>
                        }
                       

                           
                        </div>
                        <table class="table table-bordered table-hover table-responsive" id="tbMyVoiceCertificate">
                            <thead>
                                <tr>
                                    <th class="text-center hidden-xs" style="width:5%;">
                                        @Html.DisplayName("SNo")
                                    </th>
                                    <th class="text-left" style="width:7%;">
                                        @Html.DisplayNameFor(model => model.ID)
                                    </th>
                                    <th class="text-center" style="width:8%;">
                                        @Html.DisplayNameFor(model => model.ECODE)
                                    </th>
                                    <th class="text-center" style="width:10%;">
                                        @Html.DisplayNameFor(model => model.EMP_NAME)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.IDEA)
                                    </th>
                                    <th class="text-center" style="width:7%;">
                                        @Html.DisplayNameFor(model => model.STATUS)
                                    </th>
                                    <th class="text-center" style="width:10%;">
                                        @Html.DisplayNameFor(model => model.IMPLEMENTED_ON)
                                    </th>
                                    <th class="text-center" style="width:7%;">
                                        @Html.DisplayNameFor(model => model.EMAIL_STATUS)
                                    </th>
                                    <th class="text-center" style="width:7%;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rowNo = 0; }
                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="text-center" style="width:5%;">
                                                @(rowNo += 1)
                                                @Html.HiddenFor(modelItem => item.ID)
                                            </td>
                                            <td class="text-center" style="width:7%;">
                                                @Html.DisplayFor(modelItem => item.ID)
                                            </td>
                                            <td class="text-center" style="width:8%;">
                                                @Html.DisplayFor(modelItem => item.ECODE)
                                            </td>
                                            <td class="text-left" style="width:18%;">
                                                @Html.DisplayFor(modelItem => item.EMP_NAME)
                                            </td>
                                            <td class="text-left">
                                                @Html.DisplayFor(modelItem => item.IDEA)
                                            </td>
                                            <td class="text-center" style="width:7%;">
                                                <button class="btn btn-success btn-xs" style="cursor: text !important">@Html.DisplayFor(modelItem => item.STATUS)</button>
                                            </td>
                                            <td class="text-center" style="width:10%;">
                                                @Html.DisplayFor(modelItem => item.IMPLEMENTED_ON)
                                            </td>
                                            <td class="text-center" style="width:7%;">
                                                @if (item.EMAIL_STATUS.ToUpper() == "SENT")
                                                {
                                                    <b class="text-success">Sent</b>
                                                }
                                                else
                                                {
                                                    <b class="text-danger">Not Send</b>
                                                }
                                            </td>
                                            <td class="text-center" style="width:7%;">
                                                @if (item.EMAIL_STATUS.ToUpper() == "SENT")
                                                {
                                                    <button class="btn btn-warning btn-xs glyphicon glyphicon-repeat" title="Click to regenerate" data-ctrl-id='bt-GenerateSent-dt' data-name="@item.EMP_NAME" data-date="@item.IMPLEMENTED_ON" data-id="@item.ID" data-certificate="@item.CERTIFICATE_NAME" data-mailto="@item.EMAILID" ></button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-info btn-xs glyphicon glyphicon-send" title="Click to generate" data-ctrl-id="bt-Generate-dt" data-name="@item.EMP_NAME" data-date="@item.IMPLEMENTED_ON" data-id="@item.ID" data-certificate="@item.CERTIFICATE_NAME" data-mailto="@item.EMAILID"></button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="myCreateModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="padding:10px!important;">
                    <div class="pull-left">
                        <h5 class="modal-title"><span id="sp_type"></span></h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body" style="padding:10px!important;">
                    <div id="myCreateModelContent"></div>
                </div>
            </div>
        </div>
    </div>

    <div id="ajaxLoader"></div>


