@model ePortal.ViewModels.APPX.Finance.FinanceViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewBag.Title = "Employee Portal  :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loginUser = Context.Session.GetString("userId") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userId").ToString());

    var projSrc = string.IsNullOrEmpty(Model.CurrProjImg)
            ? Url.Content("~/images/notapplicable20.png")
            : Url.Content(Model.CurrProjImg);
    var accSrc = string.IsNullOrEmpty(Model.CurrAccImg)
    ? Url.Content("~/images/notapplicable20.png")
    : Url.Content(Model.CurrAccImg);

}
@section Styles {
    <link href="~/lib/bootstrap/css/dataTables.bootstrap.min.css" rel="stylesheet" />

    <style nonce="@Context.Items["StyleNonce_0"]">
        .homeContent {
            padding: 0;
        }

        table {
            font-size: 14px;
        }

        .row1 {
            FONT-SIZE: 11px;
            COLOR: #000000;
            FONT-FAMILY: Verdana, Arial, Helvetica;
            BACKGROUND-COLOR: #DBF1FF;
            height: 24px;
            vertical-align: middle;
        }

        .row2 {
            FONT-SIZE: 11px;
            COLOR: #000000;
            FONT-FAMILY: Verdana, Arial, Helvetica;
            BACKGROUND-COLOR: #ffffff;
            height: 24px;
            vertical-align: middle;
        }

        div.dataTables_wrapper div.dataTables_paginate {
            font-size: 13px !important
        }
    </style>
}
