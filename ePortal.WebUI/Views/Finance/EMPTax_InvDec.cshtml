    <link href="../../css/NewAsset.css" rel="stylesheet" type="text/css" />
    <link href="../../css/VendorMaster.css" rel="stylesheet" type="text/css" />
    <style nonce="@Context.Items["StyleNonce_0"]">
        table td {
            font-size: 10px;
        }

     .tblparent{
           border: 1px solid #000
       }

        td {
            vertical-align: middle;
        }

        #Divgap {
            height: 3px
        }

        .disabled-div {
            pointer-events: none; /* disables clicks, typing, etc. */
            opacity: 1; /* optional: make it look disabled */
        }

        .blink {
            animation: blink-animation 1s steps(2, start) infinite;
            color: red; /* Optional: make it more noticeable */
            font-weight: bold;
        }

        @@keyframes blink-animation {
            0% {
                visibility: visible;
            }

            50% {
                visibility: hidden;
            }

            100% {
                visibility: visible;
            }
        }
        .buttons{
            cursor:pointer !important;
        }
    </style>
}
