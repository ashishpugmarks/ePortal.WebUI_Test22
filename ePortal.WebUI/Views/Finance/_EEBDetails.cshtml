@using System.Text.Json
@model ePortal.ViewModels.APPX.Finance.ReceiptIndexViewModel
@{
    ViewData["Title"] = "Nature of Investments/Payments";
    Layout = null;
}
<html>
<head>
    <script src="~/app/js/finance/eeb_details.js" nonce="@Context.Items["ScriptNonce_3"]"></script>

</head>
<body>
    <table width="100%" style="font-size: 10px; margin: 2px;" cellpadding="1" cellspacing="1"
           class="table table-bordered">
        <tr id="tr_errorhra" class="errormessage" style="display:none">
            <td colspan="4">
                <label id="lblerror_hra"></label>
            </td>
        </tr>



        <tr>


            <td style="width:30%;vertical-align:middle;">
                <input asp-for="NewReceipt._TaxHeadID" type="hidden" class="form-control" />
                <input asp-for="TaxHeadName" type="hidden" class="form-control" />
                <input asp-for="NewReceipt.SLNO" type="hidden" class="form-control" />
                <label class="form-label">Vehicle Type</label>
               
                <select data-ctrl-id="NewReceipt_ReceiptNo" asp-for="NewReceipt._ReceiptNo" class="form-control"
                        asp-items="@(new SelectList(
                                                                            new[] {
                                                                                                        new { Value = "1", Text = "Electric" },
                                                                                new { Value = "0", Text = "Other" }
                                                                            },
                                                                            "Value", "Text"))">
                </select>
                <span asp-validation-for="NewReceipt._ReceiptNo" class="text-danger"></span>
            </td>

            <td style="width:30%;vertical-align:middle;">
                <label class="form-label">Date of loan sanctioned</label>
                @* <input asp-for="NewReceipt._PrmDate" class="form-control"/> *@
                @Html.TextBoxFor(model => model.NewReceipt._PrmDate, "{0:dd-MMM-yyyy}", new { @class = "form-control dpDate", @id = "txtDtFrom" })
                <span asp-validation-for="NewReceipt._PrmDate" class="text-danger"></span>
            </td>

            <td style="width:30%;vertical-align:middle;">
                <label class="form-label">Interest paid</label>
                <input asp-for="NewReceipt.Amount" class="form-control" type="number" />
                <span asp-validation-for="NewReceipt.Amount" class="text-danger"></span>
            </td>

            <td style="width:10%;vertical-align:middle;">
                <a style="margin-top:20px;cursor:pointer" data-ctrl-id="addEEB">
                    <img src="~/images/Save1.png" />

                </a>
            </td>


        </tr>
    </table>

    <!-- Grid (WebForms GridView equivalent) -->
    <table class="table table-bordered" style="font-size: 10px; margin: 2px;">
        <thead class="text-center">
            <tr class="tcat1 HeaderStyle123">
                <th style="border-right: solid 1px white;width: 25%;">Vehicle Type</th>
                <th style="border-right: solid 1px white;width: 20%;">Vehicle Type</th>
                <th style="border-right: solid 1px white;width: 20%;">Interest paid</th>
                <th style="border-right: solid 1px white;width: 10%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Receipts.Count > 0)
            {
                foreach (var r in Model.Receipts)
                {
                    var result = (@r._ReceiptNo == "1") ? "Electric" : "Others";
                    <tr class="text-center">
                        <td>@result</td>
                        <td>@r._PrmDate</td>
                        <td>@r.Amount</td>
                        <td>
                            <a style="margin-top:20px" data-ctrl-id="editEEB" data-value="@JsonSerializer.Serialize(r))">
                                <img src="~/images/icon_edit.gif" />

                            </a>&nbsp;<a style="margin-top:20px" data-ctrl-id="deleteEEB" data-value="@r.SLNO">
                                <img src="~/images/icon_delete.gif" />

                            </a>


                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No record found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <br/>
    <div class="row2">
        <div align="center" style="padding: 5px;">
            <a data-ctrl-id="btnsubmitEEB" class="buttons">Submit</a>
            &nbsp;&nbsp;&nbsp;
            <a data-ctrl-id="btncancelEEB" class="buttons">Cancel</a>
        </div>
    </div>
</body>
</html>

