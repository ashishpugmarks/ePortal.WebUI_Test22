@model ePortal.ViewModels.APPX.Finance.HRADetailList
@{
    var msg = "";
    Layout = null;
}
<html>
<head>
    <script type="text/javascript" src="~/app/js/finance/hra_details.js" nonce="@Context.Items["ScriptNonce_3"]"></script>
</head>
<body>

    <form id="hraForm"> 
        @Html.AntiForgeryToken()

    <table width="98%" style="font-size: 10px; margin: 2px;" cellpadding="1" cellspacing="1"
           class="table table-bordered">
        <tr id="tr_errorhra" class="errormessage" style="display:none">
            <td>
                <label id="lblerror_hra"></label>
            </td>
        </tr>

        <tr class="darkyellow_row">
            <td style="padding-left: 2px; font-family: Trebuchet MS; font-size: 12px; color: #BD1156; border: solid 1px #E8DD72; font-weight: bold;">
                House Rent Details
            </td>
        </tr>

        <tr>
            <td>
                <input type="hidden" asp-for="hRADetails.TotalRentAmount" />
                    <input type="hidden" asp-for="hRADetails.ActionType" />
<input type="hidden" asp-for="hRADetails.SLNO" />
                    <input type="hidden" asp-for="hRADetails._strFINEMPRENTDTLID" />
                    
                <table class="table table-bordered" style="width:100%;" cellpadding="0" cellspacing="0">
                    <tr>
                        <!-- Keep IDs if you need them for JS -->
                        <td colspan="4" class="HeaderStyle123">
                            House Rent Period Detail
                            <div class="mt-1">
                                <span id="lblFinPeriodStartDatehra">@Model.hRADetails.FinPeriodStartDate</span>
                                &nbsp;-&nbsp;
                                <span id="lblFinPeriodEndDatehra">@Model.hRADetails.FinPeriodEndDate</span>
                            </div>
                        </td>
                    </tr>

                    <!-- Period From / To -->
                    <tr class="row1">
                        <td style="width:35%; padding:5px; font-family:'Trebuchet MS'; font-size:14px;" align="left">
                            Period From:
                        </td>
                        <td style="width:35%;" align="left" colspan="3">
                            <select asp-for="hRADetails.PeriodFromMonth"
                                    asp-items="Model.hRADetails.FromMonthOptions"
                                    class="form-select smalltext"
                                    style="max-width:140px;">
                            </select>
                            &nbsp;&nbsp;To&nbsp;
                            <select asp-for="hRADetails.PeriodToMonth"
                                    asp-items="Model.hRADetails.ToMonthOptions"
                                    class="form-select smalltext"
                                    style="max-width:140px;">
                            </select>
                            <div>
                                <span class="text-danger" asp-validation-for="hRADetails.PeriodFromMonth"></span>
                                <span class="text-danger" asp-validation-for="hRADetails.PeriodToMonth"></span>
                            </div>
                        </td>
                    </tr>

                    <!-- Monthly Rent -->
                    <tr class="row2">
                        <td style="width:35%; padding:5px; font-family:'Trebuchet MS'; font-size:14px;" align="left">
                            Monthly House Rent Paid to Landlord:
                        </td>
                        <td style="width:35%; padding:5px; font-family:'Trebuchet MS'; font-size:14px;" align="left" colspan="3">
                            <input asp-for="hRADetails.MonthlyRentAmount"
                                   class="swifttext"
                                   style="max-width:140px;"
                                   type="number"
                                   inputmode="numeric"
                                   data-ctrl-id='MonthlyRentAmount'
                                   min="0"
                                   step="1" />
                            <span class="text-danger" asp-validation-for="hRADetails.MonthlyRentAmount"></span>
                        </td>
                    </tr>

                    <!-- Present Residential Address -->
                    <tr class="row1">
                        <td style="width:35%; padding:5px; font-family:'Trebuchet MS'; font-size:14px;" align="left">
                            Present Residential Address:
                        </td>
                        <td style="width:35%;" align="left" colspan="3">
                            <input asp-for="hRADetails.PresentResidentialAddress" class="swifttext" maxlength="250" />
                            <span class="text-danger" asp-validation-for="hRADetails.PresentResidentialAddress"></span>
                        </td>
                    </tr>

                    <!-- City Category & Employee S/O D/O -->
                    <tr class="row2">
                        <td style="width:30%; padding:5px; font-family:'Trebuchet MS'; font-size:14px;" align="left">
                            Location of Rented House:<br />
                            <span style="color:Blue; font-family:Arial; font-size:12px; font-weight:bold;">
                                (Metro City = Delhi, Kolkata, Mumbai &amp; Chennai)
                            </span><br />
                            <span style="color:Blue; font-family:Arial; font-size:12px; font-weight:bold;">
                                (Non Metro = Other city)
                            </span>
                        </td>
                        <td style="width:20%; padding:5px; font-family:'Trebuchet MS'; font-size:14px;">
                            <select asp-for="hRADetails.CityCategory" class="form-select swiftselect" style="max-width:140px;">
                                <option value="0">Non Metro</option>
                                <option value="1">Metro</option>
                            </select>
                            <span class="text-danger" asp-validation-for="hRADetails.CityCategory"></span>
                        </td>
                        <td style="width:30%; padding:5px; font-family:'Trebuchet MS'; font-size:14px;" align="left">
                            Employee S/O D/O:
                        </td>
                        <td style="width:20%; padding:5px; font-family:'Trebuchet MS'; font-size:14px;" align="left">
                            <input asp-for="hRADetails.EmployeeSO" class="swifttext" maxlength="100" style="max-width:140px;" />
                            <span class="text-danger" asp-validation-for="hRADetails.EmployeeSO"></span>
                        </td>
                    </tr>



                    <tr class="landlord1">
                        <td class="HeaderStyle123" colspan="4">
                            Landlord Declaration Details
