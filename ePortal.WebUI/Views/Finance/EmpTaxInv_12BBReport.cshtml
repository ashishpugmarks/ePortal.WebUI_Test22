@using System.Text.Json
@model ePortal.ViewModels.APPX.Finance.EmpTaxInvDec12BBReportModel
@{
    Layout = null;
}
<html>
<head runat="server">
    <title>INCOME-TAX RULES, 1962</title>
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <script type="text/javascript" language="Javascript" src="~/js/jquery-3.7.1.min.js"></script>
    <style type="text/css">
        .main {
            width: 700px;
            height: auto;
            margin-left: auto;
            margin-right: auto;
            border: 1px solid black;
            padding: 5px 5px 5px 5px;
            font-family: Calibri;
        }

        .txt_top {
            width: 99.7%;
            height: 30px;
            font-weight: bold;
            font-size: 1.2em;
            text-align: center;
            padding-top: 5PX
        }

        .txt_top_1 {
            width: 99.7%;
            font-weight: BOLD;
            font-size: 0.8em;
            text-align: center;
            padding-top: 5PX;
            padding-bottom: 5PX;
        }

        .txt_top_2 {
            width: 99.7%;
            font-weight: bold;
            font-size: 0.85em;
            text-align: center;
            padding-bottom: 10PX;
        }

        .formlabel {
            color: #6299c5;
        }

        .printbtn {
            color: Blue;
            cursor: pointer;
            font-family: Calibri;
            font-weight: bold;
            width: 200px;
            margin-left: auto;
            margin-right: auto;
            margin-top: 10px;
        }

        .style1 {
            height: 21px;
        }
    </style>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
                         $(document).ready(function () {

                           
                    $("[data-ctrl-id='btnprint']").on('click', function () {

                        window.print();
                           })
                        }
                );
                </script>
</head>
<body>
    <form>
        <div id="div1">
            <div class="main">
                <div class="txt_top">INCOME-TAX RULES, 1962</div>
                <div class="txt_top_1">FORM NO. 12BB<br />(See rule 26C)</div>
                <div class="txt_top_2">Statement showing particulars of claims by an employee for deduction of tax under section 192</div>
                <table cellpadding="0" cellspacing="0" width="100%" border="1" style="font-size:0.8em;line-height:20px;margin-top:10px;border-collapse:collapse;">
                    <tr>
                        <td align="left" width="30%">&nbsp;Name of the employee:</td>
                        <td align="left" width="70%">&nbsp;<lable class="formlabel"> <lable class="formlabel">@Model.lblname</lable></td>
                    </tr>
                    <tr>
                        <td align="left">&nbsp;Address of the employee:</td>
                        <td align="left">&nbsp;<lable class="formlabel">@Model.lbladdress</lable></td>
                    </tr>
                    <tr>
                        <td align="left" class="style1">&nbsp;PAN of the employee:</td>
                        <td align="left" class="style1">&nbsp;<lable class="formlabel">@Model.lblpannumber</lable></td>
                    </tr>
                    <tr>
                        <td align="left">&nbsp;Financial year:</td>
                        <td align="left">&nbsp;<lable class="formlabel">@Model.lblfinancialyear</lable></td>
                    </tr>
                </table>
                <table cellpadding="0" cellspacing="0" width="100%" style="font-size:0.8em;border-collapse:collapse;line-height:20px;margin-top:10px;" border="1">
                    <tr><td colspan="4" align="center"><b>Details of claims and evidence there of</b></td></tr>
                    <tr style="font-weight:bold;line-height:13px;">
                        <td align="center" width="5%">Sl. No.</td>
                        <td align="center" width="50%">Nature of claim</td>
                        <td align="center" width="32%">Amount(Rs.)</td>
                        <td align="center" width="13%">Evidence /<br /> particulars</td>
                    </tr>
                    <tr>
                        <td align="center">(1)</td>
                        <td align="center">(2)</td>
                        <td align="center">(3)</td>
                        <td align="center">(4)</td>
                    </tr>
                    <tr>
                        <td align="center">1.</td>
                        <td colspan="2">
                            <table width="93.8%" style="border-collapse:collapse;font-size:0.8em;line-height:20px;margin-top:10px;border-collapse:collapse;">
                                <tr>
                                    <td align="left" style="width:65%">&nbsp;House Rent Allowance: </td>
                                    <td style="width:35%" style="border-left:1px solid #C0C0C0;"> &nbsp;</td>
                                </tr>
                               @foreach(var item in @Model.HouseItem){
                                   
                                        <tr>  <td align="left" valign="top">&nbsp;(i) Rent paid of period </td>  <td align="left" valign="top" style="border-left:1px solid #C0C0C0;padding-left:5px;"> @item.RENT_FROM - @item.RENT_TO"</td> </tr>
                                        <tr>  <td align="left" valign="top">&nbsp;(ii) Rent paid to the landlord </td>  <td align="left" valign="top" style="border-left:1px solid #C0C0C0;padding-left:5px;"> @item.RENT_AMOUNT</td> </tr>
                                        <tr>  <td align="left" valign="top">&nbsp;(iii) Name of the landlord </td>  <td align="left" valign="top" style="border-left:1px solid #C0C0C0;padding-left:5px;"> @item.LANDLORDNAME</td> </tr>
                                    <tr>  <td align="left" valign="top">&nbsp;(iv) Address of the landlord </td>  <td align="left" valign="top" style="border-left:1px solid #C0C0C0;padding-left:5px;">@item.LLHNO &nbsp;&nbsp;@item.LLGNO&nbsp;&nbsp;@item.LLVILLAGE&nbsp;&nbsp;@item.LLCITY</td> </tr>
                                    <tr>  <td align="left" valign="top"> &nbsp;(v) Permanent Account Number of the landlord</td>  <td align="left" valign="top" style="border-left:1px solid #C0C0C0;padding-left:5px;">@item.LANDLORDPAN </td> </tr>
                                  }
                                <tr>
                                    <td align="left" valign="top"> <div style="line-height:13px;"><b>Note:</b> Permanent Account Number shall be furnished if the aggregate rent paid during the previous year exceeds one lakh rupees</div></td>
                                    <td style="border-left:1px solid #C0C0C0;"> &nbsp;</td>
                                </tr>
                            </table>

                        </td>
                        <td align="left">
                            @Model.ltlldevidance<br />
                        </td>
                    </tr>
                    <tr>
                        <td align="center">2.</td>
                        <td align="left">&nbsp;Leave travel concessions or assistance</td>
                        <td align="left" valign="top" style="padding-left:5px;">   @Model.ltl_LTAAmount<br /></td>
                        <td align="left" valign="top"> @Model.ltlltaevidance<br /></td>
                    </tr>
                    <tr>
                        <td align="center">3.</td>
                        <td colspan="2">
                            <table width="93.8%" style="border-collapse:collapse;font-size:0.8em;line-height:20px;margin-top:10px;border-collapse:collapse;">
                                <tr>
                                    <td align="left" style="width:65%">Deduction of interest on borrowing: </td>
                                    <td width="35%" style="border-left:1px solid #C0C0C0;"> &nbsp;</td>
                                </tr>
                                <tr>  <td align="left" valign="top">&nbsp;(i) Interest payable/paid to the lender </td>  <td align="left" valign="top" style="border-left:1px solid #C0C0C0;padding-left:5px;"> <asp:Literal ID="ltlhlpayable" runat="server"></asp:Literal></td> </tr>
                               @foreach(var item in @Model.REPHOUSELOAN){
                                  
                                        <tr>  <td align="left" valign="top">&nbsp;(ii)Name of the lender </td>  <td align="left" valign="top" style="border-left:1px solid #C0C0C0;padding-left:5px;"> @item.LoanProvider</td> </tr>
                                    <tr>  <td align="left" valign="top">&nbsp;(iii) Address of the lender </td>  <td align="left" valign="top" style="border-left:1px solid #C0C0C0;padding-left:5px;"> @item.addressLoanProvider</td> </tr>
                                    <tr>  <td align="left" valign="top"> &nbsp;(iv) Permanent Account Number of the lender</td>  <td align="left" valign="top" style="border-left:1px solid #C0C0C0;padding-left:5px;"> @item.panLoanProvider</td> </tr>
                                  }
                                <tr>
                                    <td align="left">(a) Financial Institutions(if available)</td>
                                    <td style="border-left:1px solid #C0C0C0;"> &nbsp;</td>
                                </tr>
                                <tr>
                                    <td align="left">(b) Employer(if available)</td>
                                    <td style="border-left:1px solid #C0C0C0;"> &nbsp;</td>
                                </tr>
                                <tr>
                                    <td align="left">(c) Others</td>
                                    <td style="border-left:1px solid #C0C0C0;"> &nbsp;</td>
                                </tr>
                            </table>
                        </td>
                        <td align="left">
                            @Model.ltlhlevidance<br />
                        </td>
                    </tr>
                    <tr>
                        <td align="center">4.</td>
                        <td colspan="2" align="left">
                            <table width="93.8%" style="margin-left:5px;border-collapse:collapse;font-size:0.8em;line-height:20px;margin-top:10px;border-collapse:collapse;">
                                <tr><td>&nbsp;<u>Deduction under Chapter VI-A</u><br /></td><td style="border-left:1px solid #C0C0C0;">&nbsp;</td></tr>
                                <tr><td>A) Section 80C<br /></td><td style="border-left:1px solid #C0C0C0;">&nbsp;</td></tr>
                                @for (int i = 0; i < @Model.Rep_section80c.Count(); i++)
                                    {
                                   

                                    <tr>
                                        <td align="left" valign="top" width="64%" style="line-height:13px;">(@(i + 1))@Model.Rep_section80c[i].TAXHEAD </td>
                                        <td align="left" valign="top" width="36%" style="border-left:1px solid #C0C0C0;padding-left:5px;">@(!string.IsNullOrEmpty(Model.Rep_section80c[i].ACT_AMOUNT) ? decimal.Parse(Model.Rep_section80c[i].ACT_AMOUNT).ToString("0") : null) </td>
                                    </tr>
                                }
                                <tr><td>(B) Other sections (e.g. 80E,,80CCC, 80CCD 80G, 80TTA, etc.) under Chapter VI-A.<br /></td><td style="border-left:1px solid #C0C0C0;">&nbsp;</td></tr>
                               
                                    @for (int i = 0; i < @Model.Rep_sectionother.Count(); i++)
                                    {


                                        <tr>
                                        <td align="left" valign="top" width="64%" style="line-height:13px;">(@(i + 1))@Model.Rep_sectionother[i].TAXHEAD </td>
                                        <td align="left" valign="top" width="36%" style="border-left:1px solid #C0C0C0;padding-left:5px;">@(!string.IsNullOrEmpty(Model.Rep_sectionother[i].ACT_AMOUNT) ? decimal.Parse(Model.Rep_sectionother[i].ACT_AMOUNT).ToString("0"):null)</td>
                                        </tr>
                                    }
                               
                            </table>
                        </td>

                        <td align="left">
                            @Model.ltlsec80cevidance<br />
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td align="center" colspan="3"><b>Verification</b></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td align="left" colspan="3" style="padding:2px;line-height:13px;">
                           I @Model.litverificationname,
                            son/daughter of @Model.litfathername,
                            do hereby certify that the information given above is complete and correct.
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>&nbsp;Place: @Model.litplace</td>
                        <td colspan="2" rowspan="2" align="center" valign="bottom">(Signature of the employee)</td>
                    </tr>
                    <tr>
                        <td></td>
                        <td align="left">&nbsp;Date: @Model.litdate</td>
                    </tr>
                    <tr>
                        <td></td>
                        <td align="left">&nbsp;Designation: @Model.litdesignation</td>
                        <td colspan="2">&nbsp;Full Name: @Model.litfulldate</td>
                    </tr>
                    <tr>
                        <td colspan="4"  align="center" style="padding: 5px;">
                            <a data-ctrl-id="btnprint" class="buttons">Print</a>
                            
                            
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </form>
</body>
</html>