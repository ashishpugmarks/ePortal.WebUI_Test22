@using System.Text.Json
@model ePortal.ViewModels.APPX.Finance.LoanApplicationViewModel
@{
    var msg = "";
    Layout = null;
}
<html>
<head>
    <style>
        td{
            vertical-align:middle !important;
        }
    </style>
    <script src="~/app/js/finance/loan_details.js" nonce="@Context.Items["ScriptNonce_3"]"></script>
</head>
<body>
    <div id="actualLoan" style="display:none">
    <table width="100%" cellspacing="0" cellpadding="0" class="tborder">
        <tr class="darkyellow_row">
            <td colspan="2" style="padding-left: 2px; font-family: Trebuchet MS; font-size: 12px; color: #BD1156; border: solid 1px #E8DD72; font-weight: bold;">
                Interest On Housing Loan
            </td>
        </tr>
        <tr class="row1">
            <td class="style5">
                <input asp-for="TaxId" type="hidden" />
                <input asp-for="ID" type="hidden" />
                &nbsp;Is Property Under Construction <span style="color: Red;">*</span>
            </td>
            <td>
                <input type="radio" data-ctrl-id="IsUnderCons" asp-for="IsUnderCons" value="1" /> Yes
                <input type="radio" data-ctrl-id="IsUnderCons" asp-for="IsUnderCons"  value="0" /> No


            </td>
        </tr>
        <tr class="row2">
            <td class="style5">
                &nbsp;Owner of the property <span style="color: Red;">*</span>
            </td>
            <td>
                <select asp-for="PropertyOwner" data-ctrl-id="PropertyOwner" style="width:149px" class="swiftselect">
                    <option value="-1">Select</option>
                    <option value="1">Self</option>
                    <option value="2">Joint</option>
                    @* <asp:ListItem Text="Other" Value="3"></asp:ListItem>-*@
                </select>
            </td>
        </tr>
        <tr class="row1 pnlinterestdtl">
            <td class="style5">
                &nbsp;Date on which loan was taken
            </td>
            <td>

                <input asp-for="LoanTaken" data-ctrl-id="LoanTaken" class="smalltext dpDate" style="width:149px" />

            </td>

        </tr>
        <tr class="row2 pnlinterestdtl">
            <td class="">
                &nbsp;Date of Completion of Construction
            </td>
            <td class="style5">
                <input asp-for="ConsDate" data-ctrl-id="LoanTaken" class="smalltext dpDate" style="width:149px" />

            </td>
        </tr>
        <tr>
            <td class="style5">
                &nbsp;Value of house
            </td>
            <td>
                <input asp-for="ValueOfHouse" type="number" class="smalltext" style="width:149px" />

            </td>
        </tr>
        <tr class="row12">
            <td class="style5">
                &nbsp;Is employee owner of any other house <span style="color: Red;">*</span>
            </td>
            <td>
                <input type="radio" asp-for="IsEmployeeOwner" value="1" /> Yes
                <input type="radio" asp-for="IsEmployeeOwner" value="0" /> No
            </td>
        </tr>
        <tr class="row1">
            <td>
                &nbsp;Gross annual rent
            </td>
            <td>
                <input asp-for="AnnualRent" type="number" maxlength="8" class="smalltext" style="width:149px" />

            </td>
        </tr>
        <tr class="row2">
            <td>
                &nbsp;Municipal Tax paid
            </td>
            <td>
                <input asp-for="MunicipalTax" type="number" maxlength="8" class="smalltext" style="width:149px" />

            </td>
        </tr>

    </table>
   
        <table width="100%" border="0" cellspacing="1" cellpadding="2" class="tborder">
        @if (Model.PnlValidatedVisible){
            <tr class="HeaderStyle123">
                <td colspan="4" height="26px">
                    Loan provider Detail's
                </td>
            </tr>
            <tr class="row1">
                <td>
                    &nbsp;Amount of loan
                </td>
                <td>
                <input asp-for="LoanProvider.Id" type="hidden" />
                    <input asp-for="LoanProvider.SLNO" type="hidden" />
                    <input asp-for="LoanProvider.LoanAmount" type="number" Width="100px" MaxLength="10" class="smalltext" />
                    
                </td>
                <td>
                    &nbsp;Name of loan provider
                </td>
                <td>
                    <input asp-for="LoanProvider.LoanProvider"Width="100px" MaxLength="100" class="smalltext" />
                </td>
            </tr>
            <tr class="row2">
                <td>
                    &nbsp;Address of loan provider
                </td>
                <td>
                    <textarea asp-for="LoanProvider.AddressLoanProvider"
                              cols="40"
                              rows="2"
                              maxlength="250"
                              style="width:200px;"
                              class="smalltext">
</textarea>
                </td>
                <td>
                    &nbsp;PAN of loan provider
                </td>
                <td>
                        <input asp-for="LoanProvider.PanLoanProvider" data-ctrl-id="PAN"
                               class="smalltext" />
                        <span style="display:none" class="text-danger PAN">Invalid PAN</span>

         
                </td>
            </tr>
            <tr class="row1">

                <td colspan="4" align="center">
                    <a data-ctrl-id="cmdAddMore" class="buttons" style="cursor:pointer">Add</a></td>
            </tr>

            @if (Model.LoanProviders != null)
            {
                <tr>
                <td colspan="4">
                   <table class="table" style="width:100%; border-collapse:collapse; color:#333333;">
    <thead style="background-color:#5D7B9D; color:white; font-weight:bold;">
        <tr>
            <th style="text-align:left; vertical-align:top;">Amount</th>
            <th style="text-align:left; vertical-align:top;">Loan provider</th>
            <th style="text-align:left; vertical-align:top;">Add Of Loan Prov.</th>
            <th style="text-align:left; vertical-align:top;">PAN Of Loan Prov.</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
                            
           @foreach (var item in Model.LoanProviders){
            <tr style="background-color:#F7F6F3; color:#333333;">
                <td>@item.LoanAmount</td>
                <td>@item.LoanProvider</td>
                <td>@item.AddressLoanProvider</td>
                <td>@item.PanLoanProvider</td>
                <td>
                                            <a data-ctrl-id="EditLoan" data-value="@JsonSerializer.Serialize(item))">
                        <img src="~/images/icon_edit.gif"  alt="edit" />
                    </a>
                </td>
                <td>
                                            <a data-ctrl-id="DeleteLoan" data-value="@item.SLNO">
                        <img src="~/images/icon_delete.gif" alt="delete" />
                    </a>
                </td>
            </tr>
        }
    </tbody>
                    </table>
                </td>
            </tr>}

            }<tr class="row1">
                        <td colspan="4" style="padding-top: 5px; padding-left: 1px; padding-right: 1px;">
                            <div id="">
