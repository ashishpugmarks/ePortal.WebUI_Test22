@model ePortal.ViewModels.APPX.Finance.EEDetailsModels

@{
    var msg = "";
    Layout = null;
}
<html>
<head>
    <script src="~/app/js/finance/ee_details.js" nonce="@Context.Items["ScriptNonce_3"]"></script>
</head>
<body>
    <table width="99%" style="font-size: 10px; margin: 2px;" cellpadding="1" cellspacing="1"
           class="tborder">
        <tr class="darkyellow_row" style="">
            <td style="padding-left: 2px; font-family: Trebuchet MS; font-size: 12px; color: #BD1156;
                            border: solid 1px #E8DD72; font-weight: bold;">
                Section 80EE detail
            </td>
        </tr>
        <tr class="row2" id="tr_80ee" visible="true">
            <td align="center">
                <table width="100%" cellpadding="2" cellspacing="1" style="font-size: 12px;" class="tborder">
                    <tr class="gridview_header_blue">
                        <td align="center" style="border: solid 1px #9FC3E3; padding: 4px;">
                            <span style="font-size: 14px; font-weight: bold;">Declaration of 80EE Details</span>
                        </td>
                    </tr>
                    <tr align="left" class="grdview_blue_altrow">
                        <td style="padding: 3px; font-size: 13px;">
                            <table>
                                <tr>
                                    <td>
                                        Date of Loan Sanctioned :
                                    </td>
                                    <td>
                                        <input asp-for="TaxId" type="hidden" data-ctrl-id="Loansanctiondate"  />
                                        <input asp-for="Loansanctiondate" data-ctrl-id="Loansanctiondate" class="dpDate" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Amount of Loan Sanctioned :
                                    </td>
                                    <td>
                                        <input asp-for="Loansanctionamount" data-ctrl-id='validateLoan' type="number" class="ctrl" />

                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Total Value of Residential House Purchased :
                                    </td>
                                    <td>
                                        <input asp-for="Vofhouse" data-ctrl-id='validateLoan' type="number" class="ctrl" />

                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Is employee owner of any other house :
                                    </td>
                                    <td>
                                        <select asp-for="Ownerofoterhhouse" data-ctrl-id='validateLoan' class="smalltext ctrl">
                                            <option value="">select</option>
                                            <option value="1">Yes</option>
                                            <option value="0">No</option>
                                        </select>

                                </tr>
                                <tr>
                                    <td>
                                        Owner of the property :
                                    </td>
                                    <td>
                                        <select asp-for="Ownerofproperty" data-ctrl-id='validateLoan' class="smalltext ctrl">
                                            <option value="">select</option>
                                            <option value="1">Self</option>
                                            <option value="0">Joint</option>
                                        </select>

                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Is Property Under Construction :
                                    </td>
                                    <td>
                                        <select asp-for="Popunderconstr" data-ctrl-id='validateLoan' class="smalltext ctrl">
                                            <option value="">select</option>
                                            <option value="1">Yes</option>
                                            <option value="0">No</option>
                                        </select>

                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Date of Completion of Construction :
                                    </td>
                                    <td>
                                        <input type="number" class="ctrl dpDate" asp-for="Compofconstdate" data-ctrl-id='validateLoan' readonly="readonly" />

                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Whether Same interset amount claimed U/S 24B:
                                    </td>
                                    <td>
                                        <select asp-for="Amtclaimed24b" data-ctrl-id='validateLoan' class="smalltext ctrl">
                                            <option value="">select</option>
                                            <option value="1">Yes</option>
                                            <option value="0">No</option>
                                        </select>

                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Percentage of Share in Property :
                                    </td>
                                    <td>
                                        <input type="number" asp-for="Perofshareproperty" class="ctrl" />

                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Percentage of Share in Tax exemption :
                                    </td>
                                    <td>
                                        <input type="number" asp-for="Perofshareintax" class="ctrl" />

                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Interest Paid :
                                    </td>
                                    <td>
                                        <input type="number" asp-for="Declamount" class="ctrl" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Dedection U/S 80EE :
                                    </td>
                                    <td>
                                        <input type="text" asp-for="EEamount" class="ctrl" readonly="readonly" />

                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
        <tr class="row1">
            <td align="center">
                &nbsp;
            </td>
        </tr>
        <tr class="row3">
            <td align="center" style="padding: 5px;">
                <a data-ctrl-id="btnsubmitEE"
                   class="buttons ctrl">Submit</a>
                &nbsp;&nbsp;&nbsp;
                <a data-ctrl-id="btncancelEE"
                   class="buttons">Cancel</a>
            </td>
        </tr>
    </table>
</body>
</html>
