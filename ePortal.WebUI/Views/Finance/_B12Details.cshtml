@using System.Text.Json
@model ePortal.ViewModels.APPX.Finance.EmployerB12ViewModel


<script src="~/app/js/finance/b12details.js" nonce="@Context.Items["ScriptNonce_3"]"></script>
<table width="100%" style="font-size: 10px;" cellpadding="0" cellspacing="0" class="tborder">
    <tr class="HeaderStyle12" height="26px">
        <td colspan="2" align="center">
            <span style="font-size: 14px; font-weight: bold;">Form No. 12B (See rule 26 A)</span>
        </td>
    </tr>
    <tr class="classic">
        <td colspan="2" style="font-size: 13px; padding: 3px; font-family: Trebuchet MS;
                            font-size: 12px;">
            Form for furnishing details of income under section 192(2) for the year ending 31<sup>st</sup>
            March&nbsp;<asp:Literal ID="ltlfinyearstart"></asp:Literal>.
            <br />
            Please give details of income from previous employer during the financial year
            <asp:Literal ID="ltlfinyear"></asp:Literal>.
        </td>
    </tr>
    <tr class="row1">
        <td align="right" style="width: 20%;">
            Name :&nbsp;
        </td>
        <td align="left" style="width: 80%;">
            @Model.Name
        </td>
    </tr>
    <tr class="row2">
        <td align="right">
            Address :&nbsp;
        </td>
        <td align="left">
            <input id="txtempaddress" asp-for="Address" class="smalltext" />
        </td>
    </tr>
    <tr class="row1">
        <td align="right">
            Permanent Account No. :&nbsp;
        </td>
        <td align="left">
            @Model.PAN
        </td>
    </tr>
    <tr class="row2">
        <td align="right">
            Residential Status :&nbsp;
        </td>
        <td align="left">
            @Model.Resident
        </td>
    </tr>
    <tr class="row1">
        <td colspan="2" align="center">
            &nbsp;
        </td>
    </tr>
    <tr class="row2">
        <td colspan="2">
            <table style="width:100%;" cellpadding="1" cellspacing="0">
                <thead>
                    <tr class="tcat">
                        <td style="border-right: solid 1px white; width: 8%;">
                            Name of Employer(s)
                        </td>
                        <td style="border-right: solid 1px white; width: 15%;">
                            Address
                        </td>
                        <td style="border-right: solid 1px white; width: 8%;">
                            TAN of Employer(s)
                        </td>
                        <td style="border-right: solid 1px white; width: 8%;">
                            PAN of Employer(s)
                        </td>
                        <td style="border-right: solid 1px white; width: 10%;">
                            Period of employment
                        </td>
                        <td style="border-right: solid 1px white; width: 7%;">
                            Total Gross Earning<br>
                            (Gross Salary)
                        </td>
                        <td style="border-right: solid 1px white; width: 7%;">
                            Total Gross Earning<br>
                            (Perk)
                        </td>
                        <td style="border-right: solid 1px white; width: 10%;">
                            Total Exemptions (HRA,Attire, Conveyance, Education etc.)
                        </td>
                        <td style="border-right: solid 1px white; width: 6%;">
                            Total Deductions<br>
                            (LIC,PF etc.)
                        </td>
                        <td style="border-right: solid 1px white; width: 6%;">
                            Taxable Income<br>
                            (6-7-8)
                        </td>
                        <td style="border-right: solid 1px white; width: 10%;">
                            Total amount of tax deducted<br>
                            during the year(enclose From 16)
                        </td>
                        <td style="width: 80px;">
                        </td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.B12List)
                    {
                        <tr>
                            <td style="width: 8%; border-right: solid 1px white;">
                                @item.EmployerName
                                <input type="hidden" asp-for="@item.ID" />
                                <input type="hidden" asp-for="@item.SLNO" />
                            </td>
                            <td style="width: 15%; border-right: solid 1px white;">@item.EmployerAddress</td>
                            <td style="width: 8%; border-right: solid 1px white;">@item.EmployerTan</td>
                            <td style="width: 8%; border-right: solid 1px white;">@item.EmployerPan</td>
                            <td style="width: 10%; border-right: solid 1px white;">
                                From: @item.FromDate <br />
                                To: @item.ToDate
                            </td>
                            <td style="width: 7%; border-right: solid 1px white;">@item.TotalGross</td>
                            <td style="width: 7%; border-right: solid 1px white;">@item.Perk</td>
                            <td style="width: 10%; border-right: solid 1px white;">@item.TotalExempt</td>
                            <td style="width: 6%; border-right: solid 1px white;">@item.Deductions</td>
                            <td style="width: 6%; border-right: solid 1px white;">@item.TaxableIncome</td>
                            <td style="width: 10%; border-right: solid 1px white;">@item.TotalAmtTax</td>
                            <td style="width: 80px;">
                                <a style="margin-top:20px;cursor:pointer" data-ctrl-id="EditDetails" data-value="@JsonSerializer.Serialize(item))">
                                    <img src="~/images/icon_edit.gif" alt="Edit" />
                                </a>
                                <a style="margin-top:20px;cursor:pointer" data-ctrl-id="DeleteDetails" data-value="@item.SLNO">
                                    <img src="~/images/icon_delete.gif" alt="Delete" />
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td style="border-right: solid 1px white; width: 8%;">
                            @Html.HiddenFor(m => m.B12.SLNO)
                            @Html.HiddenFor(m => m.B12.ID)
                            @Html.TextBoxFor(m => m.B12.EmployerName, new { @class = "smalltext", style = "width:58px;" })
                            @Html.Hidden("hdnidB12", "")
                        </td>
                        <td style="border-right: solid 1px white; width: 15%;">
                            @Html.TextAreaFor(m => m.B12.EmployerAddress, new { @class = "smalltext", style = "height:45px;width:100px;" })
                        </td>
                        <td style="border-right: solid 1px white; width: 8%;">
                            @Html.TextBoxFor(m => m.B12.EmployerTan, new { @class = "smalltext", maxlength = "10", style = "width:95%;" })
                        </td>
                        <td style="border-right: solid 1px white; width: 8%;">
                            @Html.TextBoxFor(m => m.B12.EmployerPan, new { @class = "smalltext", maxlength = "10", style = "width:95%;" })
                        </td>
                        <td style="border-right: solid 1px white; width: 10%;">
                            From :
                            @Html.TextBoxFor(m => m.B12.FromDate, new { @class = "smalltext dpDate", style = "width:95%;" })
                            <br />
                            To :
                            @Html.TextBoxFor(m => m.B12.ToDate, new { @class = "smalltext dpDate", style = "width:95%;" })
                        </td>
                        <td style="border-right: solid 1px white; width: 7%;">
                            @Html.TextBoxFor(m => m.B12.TotalGross, new { @class = "smalltext", type = "number", style = "width:95%;" })
                        </td>
                        <td style="border-right: solid 1px white; width: 7%;">
                            @Html.TextBoxFor(m => m.B12.Perk, new { @class = "smalltext", type = "number", style = "width:95%;" })
                        </td>
                        <td style="border-right: solid 1px white; width: 10%;">
                            @Html.TextBoxFor(m => m.B12.TotalExempt, new { @class = "smalltext", type = "number", style = "width:95%;" })
                        </td>
                        <td style="border-right: solid 1px white; width: 6%;">
                            @Html.TextBoxFor(m => m.B12.Deductions, new { @class = "smalltext", type = "number", style = "width:95%;" })
                        </td>
                        <td style="width: 6%; solid 1px white;">
                            @Html.TextBoxFor(m => m.B12.TaxableIncome, new { @class = "smalltext", style = "width:95%;", disabled = "disabled" })
                        </td>
                        <td style="border-right: solid 1px white; width: 10%;">
                            @Html.TextBoxFor(m => m.B12.TotalAmtTax, new { @class = "smalltext", type = "number", style = "width:95%;" })
                        </td>
                        <td style="width: 80px;">
                            <a style="cursor:pointer" data-ctrl-id="AddDetails">
                                <img src="~/images/Save1.png" alt="Save" />
                            </a>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </td>
    </tr>
    <tr class="row1">
        <td colspan="2" align="center">
            &nbsp;
        </td>
    </tr>
    <tr class="row3">
        <td colspan="2" align="center" style="padding: 5px;">
            <a data-ctrl-id="btnSubmitb12" class="buttons">Submit</a>
            &nbsp;&nbsp;&nbsp;
            <a data-ctrl-id="btnCancelb12" class="buttons">Cancel</a>
        </td>
    </tr>
</table>