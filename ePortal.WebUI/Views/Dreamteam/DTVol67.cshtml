@{
    ViewData["Title"] = "Canvas [ Vol - 11 ]";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="imagetoolbar" content="no" />
    <title>@ViewData["Title"]</title>

    <script src="~/app/js/dreamteam/dreamteam.js"></script>
</head>
<body>
    <table cellspacing="0" cellpadding="1" width="100%" border="0">
        <tr>
            <td>
                @for (int i = 1; i <= 60; i++)
                {
                    @* <img src="../../../assets/images/Dreamteam/Vol67/page_Page_60.jpg" alt="Dreamteam - Page60"  border="1"/> </br> *@
                    string path = $"~/images/Dreamteam/Vol67/page_Page_{i.ToString("D2")}.jpg";
                    <img src="@Url.Content($"~/images/Dreamteam/Vol67/page_Page_{i.ToString("D2")}.jpg")" alt="Dreamteam - Page @path" border="1" />
                    <br />

                }
            </td>
        </tr>
    </table>
</body>
</html>
