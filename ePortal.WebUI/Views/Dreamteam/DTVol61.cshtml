@{
    ViewData["Title"] = "Canvas [ Vol - 5 ]";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="imagetoolbar" content="no" />
    <title>@ViewData["Title"]</title>

    <script src="~/app/js/dreamteam/dreamteam.js"></script>
</head>
<body>
    <table cellspacing="0" cellpadding="1" width="100%" border="0">
        <tr>
            <td>
                @for (int i = 1; i <= 68; i++)
                {
                    @* <img src="../../../assets/images/Dreamteam/Vol61/img1.jpg" alt="Dreamteam - Page1" border="1" />*@

                    <img src="@Url.Content($"~/images/Dreamteam/Vol61/img{i}.jpg")" alt="Dreamteam - Page @i" border="1" />
                    <br />

                }
            </td>
        </tr>
    </table>
</body>
</html>
