@{
    ViewData["Title"] = "Canvas [ Vol - 16 ]";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="imagetoolbar" content="no" />
    <title>@ViewData["Title"]</title>

    <script src="~/app/js/dreamteam/dreamteam.js"></script>
</head>
<body>
    <table cellspacing="0" cellpadding="1" width="100%" border="0">
        <tr>
            <td>
                @for (int i = 1; i <= 70; i++)
                {
                    @* <img src="../../../assets/images/Dreamteam/Vol72/1.jpg" alt="Dreamteam - Page1"  border="1"/></br> *@
                    string path = $"~/images/Dreamteam/Vol72/{i}.jpg";
                    <img src="@Url.Content($"~/images/Dreamteam/Vol72/{i}.jpg")" alt="Dreamteam - Page @path" border="1" />
                    <br />

                }
            </td>
        </tr>
    </table>
</body>
</html>
