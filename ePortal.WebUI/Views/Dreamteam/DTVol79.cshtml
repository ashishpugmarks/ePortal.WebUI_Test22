@{
    ViewData["Title"] = "Canvas [ Vol - 23 ]";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="imagetoolbar" content="no" />
    <title>@ViewData["Title"]</title>

    <script src="~/app/js/dreamteam/dreamteam.js"></script>
</head>
<body>
    <table cellspacing="0" cellpadding="1" width="100%" border="0">
        <tr>
            <td>
                @for (int i = 1; i <= 72; i++)
                {
                    @* <img src="../../../assets/images/Dreamteam/Vol79/Honda Canvas Vol 23 F-72.jpg" alt="Dreamteam - Page72"  border="1"/> </br>   *@
                    
                    <img src="@Url.Content($"~/images/Dreamteam/Vol79/Honda Canvas Vol 23 F-{i}.jpg")" alt="Dreamteam - Page @i" border="1" />
                    <br />
                }
            </td>
        </tr>
    </table>
</body>
</html>
