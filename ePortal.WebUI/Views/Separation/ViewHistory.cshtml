@model ePortal.ViewModels.APPX.Separation.ViewHistoryModel
@{
    ViewBag.Title = "ViewHistory";
    Layout = null;
}


    <link href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/css/home.css" rel="stylesheet" />
    <link href="~/css/megamenu.css" rel="stylesheet" />
    <link href="~/css/sweetalert.css" rel="stylesheet" />
    <link href="~/css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .maincontainer {
            /*width: 800px;*/
            border: 0px solid gray;
            height: auto;
            padding: 2px;
            background-color: White;
            margin-left: 5px;
            margin-right: 5px;
        }

        .mainhead {
            background-image: url( '../../assets/images/box_top_m.gif' );
            background-repeat: repeat-x;
            line-height: 25px;
            text-align: left;
            padding-left: 10px;
            color: White;
            font-weight: bold;
            margin-bottom: 5px;
            font-size: 0.9em;
        }

        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
            line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
            font-size: 11px;
            border-collapse: collapse;
            color: #000000;
            font-family: Verdana, Tahoma;
        }

            .tableMainInner tr td {
                border: solid 1px #CCDCE0;
                padding: 0;
            }

                .tableMainInner tr td.heading {
                    text-align: right;
                }

        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
        }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                line-height: 24px;
                font-family: Verdana, Arial, Helvetica;
                font-size: 11px;
            }

            .tableGridView tr th {
                background: url(../../assets/Images/bg_header.jpg) #cae8ea no-repeat;
            }

        #resignapp th {
            color: #6D929B !important;
            font-weight: bold !important;
        }

        #pendclrform th {
            color: #6D929B !important;
            font-weight: bold !important;
        }

        #manageclrheader th {
            color: #6D929B !important;
            font-weight: bold !important;
        }

        .HeaderStyle12 {
            border: 1px solid #C1C4C8;
            border-bottom: none;
        }

        .frmtable .inputtxtcss {
            border: 1px solid gray !important;
            width: 168px !important;
            height: 20px;
            padding-left: 3px;
        }

        .DET_1 {
            width: 100%;
            height: auto;
        }

        .Head_1 {
            background-color: #2D5094;
            line-height: 25px;
            text-align: center;
            font-weight: bold;
            color: White;
        }

        .pendingspan {
            color: Red;
            font-weight: bold;
        }

        .completedspan {
            color: Green;
            font-weight: bold;
        }

        .holdspan {
            color: Orange;
            font-weight: bold;
        }

        .lblcss {
            color: #6299C5 !important;
        }

        .auto-style1 {
            BACKGROUND: #80a9ea url('../../assets/images/tablebg.gif') repeat-x left top;
            FONT: 12px Verdana, Tahoma;
            COLOR: #ffffff;
            width: 680px;
        }
        /*.auto-style2 {
                    width: 680px;
                }*/
    </style>


<div class="maincontainer" id="maincontainer" >
    <table class="tableGridView" style="border-color: #CCDCE0; border-width: 1px; border-style: solid;
            margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;" cellpadding="0"
           cellspacing="0" width="100%">
       <thead>
            <tr class="HeaderStyle123">
                <td colspan="2">
                    &nbsp;Associate Details
                </td>
            </tr>
       </thead>
        <tbody>
          <tr>
            <td>
             <table class="table table-bordered table-condensed table-striped table-responsive" width="100%" border="1">
            <tbody>
                <tr id="tr_1"  class="info" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Name :-
                    </td>
                    <td class="smalltext" style="width: 30%; color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_assname" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_assname</label>&nbsp;[<label id="lbl_assecode" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_assecode</label>]
                    </td>
                    <td style="width: 20%; text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Joining Date :-
                    </td>
                    <td class="smalltext" style="width: 25%; color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_joindate" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_joindate</label>
                    </td>
                </tr>
                <tr class="active" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Designation :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_desg" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_desg</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Func. Designation :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_fundesg" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_fundesg</label>
                    </td>
                </tr>
                <tr class="info">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        <span class="smalltext">Mobile Number :-</span>
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_phone" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_phone</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        Email Id :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_emailid" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_emailid</label>
                    </td>
                </tr>
                <tr class="active" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Operation :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_op" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_op</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Division :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_div" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_div</label>
                    </td>
                </tr>
                <tr class="info" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Department :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_dept" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_dept</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Section :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_sec" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_sec</label>
                    </td>
                </tr>
                <tr class="active" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Site :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_site" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_site</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Resignation Date :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_applydate" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_applydate</label>
                    </td>
                </tr>
                <tr class="info">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Relieving Date (Associate) :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_reldate" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_reldate</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Final Relieving Date :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_deptreldate" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_deptreldate</label>
                    </td>
                </tr>
                <tr class="active" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Subject :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                        colspan="3">
                        &nbsp;<label id="lbl_subject" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_subject</label>
                    </td>
                </tr>
                <tr class="info" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Body :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                        colspan="3">
                        &nbsp;<label id="lbl_reason" class="lblcss">@Model.AssociatedetailsViewModel?.lbl_reason</label>
                    </td>
                </tr>
            </tbody>
        </table>
            </td>
          </tr>
        </tbody>
    </table>
   @*------------------------------------------Resignation History Detail--------------------------------->*@
    <table class="tableGridView" style="border-color: #CCDCE0; border-width: 1px; border-style: solid;
            margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;" cellpadding="0"
           cellspacing="0" width="100%">
        <thead>
            <tr class="HeaderStyle123">
                <td colspan="2">
                    &nbsp;Approval Details
                </td>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="2">
                    <table id="grdApprovalDetails" class="tableGridView" style="width:100%; border-collapse:collapse;" cellpadding="0" cellspacing="0">
                        <thead class="grdHeader" style="height:25px;">
                            <tr>
                                <th style="text-align:center; width:25%;">Name</th>
                                <th style="text-align:center; width:15%;">Func.Designation</th>
                                <th style="text-align:center; width:10%;">Status</th>
                                <th style="text-align:center; width:20%;">Approval Date</th>
                                <th style="text-align:center; width:70%;">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ApprovalDetailsModel != null)
                            {
                                foreach (var item in Model.ApprovalDetailsModel)
                                {
                                    <tr class="grdrow" style="height:20px;">
                                        <td style="text-align:center;">
                                            @item.AppName [@item.AppECode]
                                        </td>
                                        <td style="text-align:center;">
                                            @item.Designation
                                        </td>
                                        <td style="text-align:center; color:green;">
                                            @item.Status
                                        </td>
                                        <td style="text-align:center;">
                                            @item.AppSubmittedDate
                                        </td>
                                        <td style="text-align:center;">
                                            @item.AppRemark
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="emptyRow" style="background-color:#F5FFF0; height:20px; font-family:Calibri; color:#274D14;">
                                    <td colspan="5">No approval details found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
   @*<------------------------------------------Resignation History Detail-------------------------------->
    <------------------------------------------Clearance Subheader History Detail--------------------------->*@
    @if (Model.ViewHistoryParentModel.ShowPendClrForm)
    {
     <table id="pendclrform"  visible="false" class="tableGridView" style="border-color: #CCDCE0;
            border-width: 1px; border-style: solid; margin-bottom: 2px; margin-left: 0px;
            margin-right: 2px; margin-top: 2px;" cellpadding="0" cellspacing="0" width="100%">
        <thead>
            <tr class="HeaderStyle123">
                <td colspan="2">
                    &nbsp;Clearance Details
                </td>
            </tr>
        </thead>
        <tbody>
            <tr class="info" style="line-height: 25px;" id="tr1" >
                <td colspan="2">
                    <table id="gridrescleardetails" class="tableGridView" style="width:100%; border-collapse:collapse;">
                        <thead>
                            <tr style="font-weight:bold; color:#6D929B;">
                                <th style="width:200px;">Description</th>
                                <th style="width:150px;">Amount (If any)</th>
                                <th style="width:360px;">Remarks</th>
                                <th style="width:50px; text-align:center;">
                                    <img src="~/Images/icons/attachment.gif" alt="Attachment" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ViewHistoryParentModel.PendingClearanceFormViewModel != null)
                            {
                                foreach (var item in Model.ViewHistoryParentModel.PendingClearanceFormViewModel)
                                {
                                    <tr class="grdrow" style="height:20px;">
                                        <td style="font-weight:bold; color:gray;">
                                            @item.Description
                                        </td>
                                        <td>
                                            @item.Amount
                                        </td>
                                        <td>
                                            @item.Remarks
                                        </td>
                                        <td style="text-align:center;">
                                            @if (!string.IsNullOrEmpty(item.AttachDocument))
                                            {
                                                <a href="~/Uploads/Separation/@item.AttachDocument" target="_blank"
                                                   onclick="open(this.href, this.target, 'width=800,height=550,top=90,left=200'); return false;">
                                                    <img alt="Doc" width="15" src="~/Images/icon_document.gif" />
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="emptyRow" style="background-color:#F5FFF0; height:20px; font-family:Calibri; color:#274D14;">
                                    <td colspan="4">No Detail Found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
               </td>
            </tr>
        </tbody>
    </table>
    }
    @*<------------------------------------------Clearance Subheader History Detail--------------------------------->
    <------------------------------------------Clearance Header History Detail---------------------------------> *@
    @if (Model.ViewHistoryParentModel.ShowManageClrHeader)
    {
     <table id="manageclrheader"  visible="false" class="tableGridView"
           style="border-color: #CCDCE0; border-width: 1px; border-style: solid; margin-bottom: 2px;
            margin-left: 0px; margin-right: 2px; margin-top: 2px;" cellpadding="0" cellspacing="0"
           width="100%">
        <thead>
            <tr class="HeaderStyle123">
                <td colspan="2">
                    &nbsp;Header Clearance Details
                </td>
            </tr>
        </thead>
        <tbody>
            <tr style="line-height: 25px; border: none;" id="tr2" >
              <td colspan="2" style="border: none;">
                <table id="grid_subheaderdetails" class="tableGridView" style="width:100%; border-collapse:collapse;">
                 <tbody>
                            @foreach (var subHeader in Model.ViewHistoryParentModel.ManageClearanceHeaderViewModel)
                    {
                        <tr>
                            <td>
                                <!-- Child Grid Equivalent -->
                                <table class="tableGridView" style="width:100%; border-collapse:collapse;">
                                    <thead>
                                        <tr style="font-weight:bold; color:#6D929B;">
                                            <th style="width:350px;">Description</th>
                                            <th style="width:100px;">Amount</th>
                                            <th style="width:500px;">Remarks</th>
                                            <th style="width:230px;">Submit By</th>
                                            <th style="width:200px;">Submit Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (subHeader.HeaderDetailsChildModel != null)
                                        {
                                            foreach (var child in subHeader.HeaderDetailsChildModel)
                                            {
                                                <tr class="info">
                                                    <td style="font-weight:bold; font-size:0.85em;">@child.Description</td>
                                                    <td>@child.Amount</td>
                                                    <td>@child.Remarks</td>
                                                    <td>@child.SubmitBy</td>
                                                    <td>@child.SubmitDate</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr class="emptyRow" style="background-color:White; height:25px; color:Black;">
                                                <td colspan="5">&nbsp; No record found.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                <!-- Remarks Section -->
                                <table style="width:100%; background-color:White;">
                                    <tr>
                                        <td style="width:100px; text-align:right; vertical-align:top;">
                                            <b>Remarks:-</b>
                                        </td>
                                        <td>
                                           @subHeader.Remarks
                                        </td>
                                    </tr>
                                </table>
                                <br />
                            </td>
                        </tr>
                    }
                 </tbody>
                </table>
                </td>
            </tr>
        </tbody>
    </table>
    }
    @* <------------------------------------------Clearance Header History Detail--------------------------------->
    <------------------------------------------Department Clearance History Detail---------------------------------> *@
    @if (Model.ViewHistoryParentModel.ShowDeptClrForm)
    {
     <table id="deptclrform"  visible="false" width="100%" cellpadding="0" CssClass="table table-bordered table-condensed table-striped table-responsive"
           cellspacing="0" style="border-color: #CCDCE0; border-width: 1px; border-style: solid;
            margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;">
        <tr>
            <td colspan="3">
                <div class="HeaderStyle123" style="padding: 0px 0px 0px 0px; line-height: 25px; border-bottom: 1px solid #C0C0C0;
                        border-top: none; border-left: none; border-right: none; font-family: Verdana, Arial, Helvetica;
                        font-size: 11px;">
                    &nbsp;<b>Department Clearance Details</b>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <table class="table table-bordered table-condensed table-striped table-responsive" width="100%">
                    <thead>
                        <tr>
                            <th class="tcat">
                                <b style="line-height: 20px;">Description</b>
                            </th>
                            <th class="tcat">
                                <b style="line-height: 20px">Remarks</b>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="info">
                            <td>
                                <b style="color: #4B4D4C;">Confidential Documents &amp; Material</b>
                            </td>
                            <td>
                                <label id="lbl_confdoc">@Model.ViewHistoryParentModel.DeptClearanceFormViewModel.lbl_confdoc</label>
                            </td>
                        </tr>
                        <tr class="active">
                            <td>
                                <b style="color: #4B4D4C;">Other Documents and Material</b>
                            </td>
                            <td>
                                <label id="lbl_otherdoc">@Model.ViewHistoryParentModel.DeptClearanceFormViewModel.lbl_otherdoc</label>
                            </td>
                        </tr>
                        <tr class="info">
                            <td>
                                <b style="color: #4B4D4C;">Books/Library</b>
                            </td>
                            <td>
                                <label id="lbl_book">@Model.ViewHistoryParentModel.DeptClearanceFormViewModel.lbl_book</label>
                            </td>
                        </tr>
                        <tr class="active">
                            <td>
                                <b style="color: #4B4D4C;">Laptop, CDS, Pen Drives etc.</b>
                            </td>
                            <td>
                                <label id="lbl_itasset">@Model.ViewHistoryParentModel.DeptClearanceFormViewModel.lbl_itasset</label>
                            </td>
                        </tr>
                        <tr class="info">
                            <td>
                                <b style="color: #4B4D4C;">Camera</b>
                            </td>
                            <td>
                                <label id="lbl_camera">@Model.ViewHistoryParentModel.DeptClearanceFormViewModel.lbl_camera</label>
                            </td>
                        </tr>
                        <tr class="active">
                            <td>
                                <b style="color: #4B4D4C;">Key(Drawer/File/Cabinet)</b>
                            </td>
                            <td>
                                <label id="lbl_key">@Model.ViewHistoryParentModel.DeptClearanceFormViewModel.lbl_key</label>
                            </td>
                        </tr>
                        <tr class="info">
                            <td>
                                <b style="color: #4B4D4C;">Travel Bills.if any submitted to Finance(Yes/No)</b>
                            </td>
                            <td>
                                <label id="lbl_travel">@Model.ViewHistoryParentModel.DeptClearanceFormViewModel.lbl_travel</label>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
    }
    @*<------------------------------------------Department Clearance History Detail--------------------------------->*@
</div>

