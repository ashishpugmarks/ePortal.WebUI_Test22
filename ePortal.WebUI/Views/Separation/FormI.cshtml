@model ePortal.ViewModels.APPX.Separation.FormIModel
@{
    ViewBag.Title = "FormI";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
            line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
            font-size: 11px;
            border-collapse: collapse;
            color: #000000;
            font-family: Verdana, Tahoma;
        }

            .tableMainInner tr td {
                border: solid 1px #CCDCE0;
                padding: 0;
            }

                .tableMainInner tr td.heading {
                    text-align: right;
                }

        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
            margin-bottom: 4px;
        }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                line-height: 24px;
                font-family: Verdana, Arial, Helvetica;
                font-size: 11px;
            }

            .tableGridView tr th {
                background: url(../images/bg_header.jpg) #cae8ea no-repeat;
            }

        .HeaderStyle12 {
            border: 1px solid #C1C4C8;
            border-bottom: none;
        }

        .lblcss {
            color: #6299C5 !important;
        }
    </style>
}

@* Error Panel *@
<div id="errorpanel" style="width:100%; display:none;">
    <table width="100%" border="0" cellspacing="0" cellpadding="0">
        <tr id="tr_ErrorRow">
            <td style="padding:5px 2px;">
                <div id="pnlErrorHeader" style="background-color:#ED243B; width:100%;" class="roundedPanel">
                    <div style="padding-left:6px;">
                        <div id="pnlError" style="background-color:#ffeaea; width:99%;" class="roundedPanel">
                            <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                <tr>
                                    <td style="padding:2px 5px; color:Black;">
                                        @* Hidden textbox (if needed) *@
                                        @Html.TextBox("txtup", null, new { style = "width:0px; border:none;" })

                                        @* Status label *@
                                        <span id="status" style="font-size:13px; font-family:'Trebuchet MS';">
                                            @ViewBag.Status
                                        </span>

                                        @* Hidden field for REGID_ECODE *@
                                        <input type="hidden" id="hdn_REGID_ECODE" name="hdn_REGID_ECODE" value="@ViewBag.hdn_REGID_ECODE" />
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
    </table>
</div>
<div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
    <div style="height: 8px;"></div>
    <span style="padding-left: 20px;">FormI </span>
</div>
<div class="headmain">
    <div style="padding-left: 6px; padding-right: 6px;">
        <table class="table table-responsive table-bordered table-condensed table-striped" style="border-color: #CCDCE0; border-width: 1px; border-style: solid;
                                margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;" cellpadding="0"
               cellspacing="0" width="100%">
            <thead>
                <tr>
                    <td class="HeaderStyle12" colspan="2">
                        &nbsp;Application for Gratuity by an Employee
                    </td>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="2">
                        I beg to apply for payment of gratuity to which I am entitled under sub-section (1) of Section 4 of the Payment of Gratuity Act, 1972 on account of my superannuation/retirement/resignation after completion of not less than five years of continuous service/total disablement due to accident/total disablement due to disease with effect from the
                        &nbsp; <u> <label id="lbl_resignationdate" class="lblcss">@Model.FormIEmpDtlsViewModel?.lbl_resignationdate</label>  </u>&nbsp; Necessary particulars relating to my appointment are given in the statement below.

                    </td>
                </tr>
                <tr id="tr_1" runat="server" style="line-height: 25px;">
                    <td style="text-align: left; vertical-align: top;" class="font12">
                        &nbsp;1. Name in full  :-
                    </td>
                    <td class="smalltext" style="width: 75%; color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_assname" class="lblcss">@Model.FormIEmpDtlsViewModel?.lbl_assname</label>&nbsp;[<label id="lbl_assecode" class="lblcss">@Model.FormIEmpDtlsViewModel?.lbl_assecode</label>]
                    </td>

                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: left; vertical-align: top;" class="font12">
                        &nbsp;2. Address in full  :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_daddress" class="lblcss">@Model.FormIEmpDtlsViewModel?.lbl_daddress</label>
                    </td>
                </tr>
                <tr>
                    <td style="text-align: left; vertical-align: top;" class="font12">
                        <span class="smalltext">&nbsp;3. Department/Branch/Section where last employed :-</span>
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_org" class="lblcss">@Model.FormIEmpDtlsViewModel?.lbl_org</label>
                    </td>

                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: left; vertical-align: top;" class="font12">
                        &nbsp;4. Post held with Ticket No., or Serial No., if any  :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_ecodedesg" class="lblcss">@Model.FormIEmpDtlsViewModel?.lbl_ecodedesg</label>
                    </td>

                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: left; vertical-align: top;" class="font12">
                        &nbsp;5. Date of appointment  :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_joindate" class="lblcss">@Model.FormIEmpDtlsViewModel?.lbl_joindate</label>
                    </td>

                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: left; vertical-align: top;" class="font12">
                        &nbsp;6. Date and cause of termination of service  :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_Relivingdate" class="lblcss">@Model.FormIEmpDtlsViewModel?.lbl_Relivingdate</label> / Resigned
                    </td>

                </tr>
                <tr>
                    <td style="text-align: left; vertical-align: top;" class="font12">
                        &nbsp;7. Total period of service  :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_serviceperiod" class="lblcss">@Model.FormIEmpDtlsViewModel?.lbl_serviceperiod</label>
                    </td>

                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: left; vertical-align: top;" class="font12">
                        &nbsp;8. Amount of wages last drawn  :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                        colspan="3">
                        &nbsp;<label id="lbl_basicamt" class="lblcss">@Model.FormIEmpDtlsViewModel?.lbl_basicamt</label>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: left; vertical-align: top;" class="font12">
                        &nbsp;9. Amount of gratuity claimed  :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                        colspan="3">
                        &nbsp;<label id="lbl_gratuityamt" class="lblcss">@Model.FormIEmpDtlsViewModel?.lbl_gratuityamt</label>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td colspan="2" style="text-align: left; vertical-align: top;" class="font12">
                        &nbsp; &nbsp;1. I was rendered totally disabled as a result of---</br>
                        &nbsp; &nbsp;(Here give the details of the nature of disease or accident) 	</br>
                        &nbsp; &nbsp;The evidences/witnesses in support of my total disablement are as follows:--</br>
                        &nbsp; &nbsp;(Here give details)&nbsp; <b> NA</b>
                        </br>
                        &nbsp; &nbsp;2. Payment may please be made in case/open or crossed bank cheque or Bank Transfer.
                        </br>
                        &nbsp; &nbsp;3.As the amount of gratuity payable is less than rupees one thousand, I shall request you to arrange for payment of the sum due to me by Postal Money Order at the address mentioned above after deducting postal money order commission therefrom <b>NA</b>

                    </td>

                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: left; vertical-align: top;" class="font12">
                        &nbsp;10. Personal Mail Id  :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                        colspan="3">
                        &nbsp;
                        <input type="text" id="txt_emailid" name="txt_emailid"
                               style="width:400px; max-width:530px; border-color:#888888;"
                               onkeypress="return (this.value.length < 500);" onpaste="return false" />
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <input type="checkbox" id="cb_agree" name="cb_agree" style="margin-left:20px; font-weight:bold;" />
                        <label for="cb_agree">&nbsp; I hereby declare that above details are correct as per my knowledge.</label>
                    </td>
                </tr>
                <tr>
                    <td class="buttonwrapper" align="center" colspan="2">
                        <button type="button" id="cmdSubmit" class="yellowbuttonbig">Submit</button>
                        &nbsp;
                        <a style="text-align: center;width:100px;display: inline-block;" href="@Url.Action("ManageResignationRequest", "Separation")"
                           class="yellowbuttonbig">Cancel</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</div>
<div class="clear">
</div>
<table cellspacing="0" cellpadding="0" style="margin-left:7px;" width="98%" border="0" class="backrow_grey">
    <tbody>
        <tr>
            <td style="height:24px; width:20px; padding-left:2px;" valign="middle" align="right">
                <a title="Back" href="@Url.Action("Index", "Home")">
                    <img src="../../images/icon_back.gif" height="16" width="16" alt="Back" />
                </a>
            </td>
            <td style="height:24px; padding-left:4px;font-size:14px;" align="left">
                <a title="Back" href="@Url.Action("Index", "Home")">Back</a>
            </td>
        </tr>
    </tbody>
</table>
<br />
<div class="clear">
</div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        $(document).ready(function () {
            $("#cmdSubmit").click(function () {
                var data = {
                    EmailId: $("#txt_emailid").val(),
                    Agree: $("#cb_agree").is(":checked"),
                    ResigID: $("#hdn_REGID_ECODE").val(),
                    BasicAmt: $("#lbl_basicamt").text(),
                    GratuityAmt: $("#lbl_gratuityamt").text(),
                    RelievingDate: $("#lbl_Relivingdate").text()
                };

                $.ajax({
                    url: '@Url.Action("SubmitFormI", "Separation")',
                    type: 'POST',
                    data: data,
                    success: function (response) {
                        if (response.success) {
                            window.location.href = response.redirectUrl;
                        } else {
                            sweetAlert("", response.message, "error");
                        }
                    },
                    error: function () {
                        alert("An error occurred while submitting.");
                    }
                });
            });
        });
    </script>
}


