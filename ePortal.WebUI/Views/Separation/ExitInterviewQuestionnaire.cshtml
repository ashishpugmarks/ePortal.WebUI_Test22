                                </b><br />
                            </td>
                        </tr>
                        <tr>
                            <td>
                                1 - Strongly Disagree
                            </td>
                            <td>
                                2 - Disagree
                            </td>
                            <td>
                                3 - Neither Agree nor Disagree
                            </td>
                        </tr>
                        <tr>
                            <td>
                                4 - Agree
                            </td>
                            <td>
                                5 - Strongly Agree
                            </td>
                            <td>
                                NA - Not Applicable
                            </td>
                        </tr>
                    </table>
                </div>
                    <div class="mygrid" style="width: 100%; padding: 0;font-size:13px;">
                        @for (int secIndex = 0; secIndex < Model.ExitIntQuestModel.Count; secIndex++)
                        {
                            var sec = Model.ExitIntQuestModel[secIndex];
                            if (sec.SectionId != "5") { continue; }

                            @* <h4>Section @sec.SectionId: @sec.SectionTitle</h4> *@
                            <table class="table table-bordered">
                                @for (int qIndex = 0; qIndex < sec.Questions.Count; qIndex++)
                                {
                                    var question = sec.Questions[qIndex];
                                    var answerSection = Model.ExitIntAnsModel.FirstOrDefault(s => s.SectionId == sec.SectionId);
                                    var answer = answerSection?.Questions.FirstOrDefault(a => a.ExitInterviewQusId == question.ExitInterviewQusId);

                                    <tr>
                                        <td>
                                            <strong>@question.QusDesc</strong><br />

                                            <!-- Hidden metadata -->
                                            <input type="hidden" name="ExitIntAnsModel[@secIndex].SectionId" value="@sec.SectionId" />
                                            <input type="hidden" name="ExitIntAnsModel[@secIndex].Questions[@qIndex].ExitInterviewQusId" value="@question.ExitInterviewQusId" />
                                            <input type="hidden" name="ExitIntAnsModel[@secIndex].Questions[@qIndex].QusType" value="@question.QusType" />

                                            @if (question.QusType == "3") // checkboxes
                                            {
                                                foreach (var opt in question.Options)
                                                {
                                                    bool isChecked = answer?.SelectedOptions.Contains(opt.ExitInterviewOptionId) == true;
                                                    <label>
                                                        <input type="checkbox"
                                                               name="ExitIntAnsModel[@secIndex].Questions[@qIndex].SelectedOptions"
                                                               value="@opt.ExitInterviewOptionId"
                                                        @(isChecked ? "checked" : "") />
                                                        @opt.OptionDesc
                                                    </label>
                                                    <br />
                                                }
                                            }
                                            else if (question.QusType == "2") // radio
                                            {
                                                 <div class="horizontal-radio">
                                                @foreach (var opt in question.Options)
                                                {
                                                    bool isSelected = answer?.SelectedOption == opt.ExitInterviewOptionId;
                                                    <label>
                                                        <input type="radio"
                                                               name="ExitIntAnsModel[@secIndex].Questions[@qIndex].SelectedOption"
                                                               value="@opt.ExitInterviewOptionId"
                                                        @(isSelected ? "checked" : "") />
                                                        @opt.OptionDesc
                                                    </label>
                                                    <br />
                                                }
                                                </div>
                                            }
                                            else // text
                                            {
                                                <textarea class="form-control"
                                                          onkeypress="return (this.value.length < 200);"
                                                          onpaste="return false"
                                                          name="ExitIntAnsModel[@secIndex].Questions[@qIndex].TextAns">@answer?.TextAns</textarea>
                                            }
                                        </td>
                                    </tr>
                                }
                            </table>
                        }
                    </div>
                    <div class="pagerstyle nextbottom">
                        <button type="button" id="btn_learninggrowth" class="btn btn-primary">Next</button>
                    </div>
            </div>
            @* <%--Learning & Growth End--%> *@

             @* <%--General Start--%> *@
            <div id="general" class="tab-pane">
                    <div class="mygrid" style="width: 100%; padding: 0;font-size:13px;">
                        @for (int secIndex = 0; secIndex < Model.ExitIntQuestModel.Count; secIndex++)
                        {
                            var sec = Model.ExitIntQuestModel[secIndex];
                            if (sec.SectionId != "6") { continue; }

                            <h4>Section @sec.SectionId: @sec.SectionTitle</h4>
                            <table class="table table-bordered">
                                @for (int qIndex = 0; qIndex < sec.Questions.Count; qIndex++)
                                {
                                    var question = sec.Questions[qIndex];
                                    var answerSection = Model.ExitIntAnsModel.FirstOrDefault(s => s.SectionId == sec.SectionId);
                                    var answer = answerSection?.Questions.FirstOrDefault(a => a.ExitInterviewQusId == question.ExitInterviewQusId);

                                    <tr>
                                        <td>
                                            <strong>@question.QusDesc</strong><br />

                                            <!-- Hidden metadata -->
                                            <input type="hidden" name="ExitIntAnsModel[@secIndex].SectionId" value="@sec.SectionId" />
                                            <input type="hidden" name="ExitIntAnsModel[@secIndex].Questions[@qIndex].ExitInterviewQusId" value="@question.ExitInterviewQusId" />
                                            <input type="hidden" name="ExitIntAnsModel[@secIndex].Questions[@qIndex].QusType" value="@question.QusType" />

                                            @if (question.QusType == "3") // checkboxes
                                            {
                                                foreach (var opt in question.Options)
                                                {
                                                    bool isChecked = answer?.SelectedOptions.Contains(opt.ExitInterviewOptionId) == true;
                                                    <label>
                                                        <input type="checkbox"
                                                               name="ExitIntAnsModel[@secIndex].Questions[@qIndex].SelectedOptions"
                                                               value="@opt.ExitInterviewOptionId"
                                                        @(isChecked ? "checked" : "") />
                                                        @opt.OptionDesc
                                                    </label>
                                                    <br />
                                                }
                                            }
                                            else if (question.QusType == "2") // radio
                                            {
                                                 <div class="horizontal-radio">
                                                @foreach (var opt in question.Options)
                                                {
                                                    bool isSelected = answer?.SelectedOption == opt.ExitInterviewOptionId;
                                                    <label>
                                                        <input type="radio"
                                                               name="ExitIntAnsModel[@secIndex].Questions[@qIndex].SelectedOption"
                                                               value="@opt.ExitInterviewOptionId"
                                                        @(isSelected ? "checked" : "") />
                                                        @opt.OptionDesc
                                                    </label>
                                                    <br />
                                                }
                                                </div>
                                            }
                                            else // text
                                            {
                                                <textarea class="form-control"
                                                          onkeypress="return (this.value.length < 200);"
                                                          onpaste="return false"
                                                          name="ExitIntAnsModel[@secIndex].Questions[@qIndex].TextAns">@answer?.TextAns</textarea>
                                            }
                                        </td>
                                    </tr>
                                }
                            </table>
                        }
                    </div>
                    <div class="pagerstyle nextbottom">
                        <button type="button" id="btn_general" class="btn btn-primary">Final Submit</button>
                    </div>
            </div>
             @* <%--General End--%> *@

        </div>
        </form>
    </div>
</div>
