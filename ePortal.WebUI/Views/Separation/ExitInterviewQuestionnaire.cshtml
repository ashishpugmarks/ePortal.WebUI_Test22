@section Scripts {
    <script src="~/bundle/bootstrap.bundle.min.js"></script>
     <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
         $(document).ready(function () {
            $("#btn_Perinfo").click(function () {
                const qual = document.getElementById('txt_qualification').value;
                if (!qual) {
                    sweetAlert("", "Enter Your Qualification.", "warning");
                    return;
                }
                else {
                    $('#reasonLeaving').addClass('active show');
                    $('a[href="#reasonLeaving"]').tab('show');
                }
             });

            $("#btn_reasonleav").click(function () {
                let valid = true;
                let message = "";

                $("#reasonLeaving input[type=checkbox]").each(function () {
                    let groupName = $(this).attr("name");
                    let checkedCount = $("#reasonLeaving input[name='" + groupName + "']:checked").length;
                    if (checkedCount !== 3) {
                        valid = false;
                        message = "Please select only three reasons";
                        sweetAlert("", message, "warning");
                        return false;
                    }
                });

                $("#reasonLeaving input[type=radio]").each(function () {
                    let groupName = $(this).attr("name");
                    if ($("#reasonLeaving input[name='" + groupName + "']:checked").length === 0) {
                        valid = false;
                        message = "Please select all option type questions.";
                        sweetAlert("", message, "warning");
                        return false;
                    }
                });

                if (valid) {
                    $('#workCondition').addClass('active show');
                    $('a[href="#workCondition"]').tab('show');
                } else {
                    $('#reasonLeaving').addClass('active show');
                    $('a[href="#reasonLeaving"]').tab('show');
                }
             });

            $("#btn_workcondition").click(function () {
                let valid = true;
                let message = "";

                $("#workCondition input[type=radio]").each(function () {
                    let groupName = $(this).attr("name");
                    if ($("#workCondition input[name='" + groupName + "']:checked").length === 0) {
                        valid = false;
                        message = "Please select all option type questions.";
                        sweetAlert("", message, "warning");
                        return false;
                    }
                });

                if (valid) {
                    $('#superVision').addClass('active show');
                    $('a[href="#superVision"]').tab('show');
                } else {
                    $('#workCondition').addClass('active show');
                    $('a[href="#workCondition"]').tab('show');
                }
             });

            $("#btn_supervision").click(function () {
                let valid = true;
                let message = "";

                $("#superVision input[type=radio]").each(function () {
                    let groupName = $(this).attr("name");
                    if ($("#superVision input[name='" + groupName + "']:checked").length === 0) {
                        valid = false;
                        message = "Please select all option type questions.";
                        sweetAlert("", message, "warning");
                        return false;
                    }
                });

                if (valid) {
                    $('#learningGrowth').addClass('active show');
                    $('a[href="#learningGrowth"]').tab('show');
                } else {
                    $('#superVision').addClass('active show');
                    $('a[href="#superVision"]').tab('show');
                }
            });

            $("#btn_learninggrowth").click(function () {
                let valid = true;
                let message = "";

                $("#learningGrowth input[type=radio]").each(function () {
                    let groupName = $(this).attr("name");
                    if ($("#learningGrowth input[name='" + groupName + "']:checked").length === 0) {
                        valid = false;
                        message = "Please select all option type questions.";
                        sweetAlert("", message, "warning");
                        return false;
                    }
                });

                if (valid) {
                    $('#general').addClass('active show');
                    $('a[href="#general"]').tab('show');
                } else {
                    $('#learningGrowth').addClass('active show');
                    $('a[href="#learningGrowth"]').tab('show');
                }
             });

            $("#btn_general").click(function () {
                let valid = true;
                let message = "";

                $("#general input[type=radio]").each(function () {
                    let groupName = $(this).attr("name");
                    if ($("#general input[name='" + groupName + "']:checked").length === 0) {
                        valid = false;
                        message = "Please select all option type questions.";
                        sweetAlert("", message, "warning");
                        return false;
                    }
                });

                const qual = $("#txt_qualification").val();
                let formData = $("#exitInterviewForm").serialize();
                formData += "&qualification=" + encodeURIComponent(qual);

                if (valid) {
                    $.ajax({
                        url: '/Separation/insertinterviewanswer',
                        type: 'POST',
                        //data: $("#exitInterviewForm").serialize(),
                        data: formData,
                        success: function (response) {
                            if (response.success) {
                                window.location.href = '/Separation/MyResignationRequest';
                            } else {
                                sweetAlert("", response.message, "error");
                            }
                        }
                    });
                } else {
                    $('#general').addClass('active show');
                    $('a[href="#general"]').tab('show');
                }
             });
         });

    </script>
}