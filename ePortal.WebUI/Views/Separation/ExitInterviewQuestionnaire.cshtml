                            <td style="width: 20%; text-align: right; vertical-align: top;" class="font12">
                                Name :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left; width: 25%;">
                                <label id="lbl_name" class="lblcss">@Model.EmpDetailsIntQuestModel?.lbl_name</label>
                            </td>
                            <td style="width: 25%; text-align: right; vertical-align: top;" class="font12">
                                Ecode :-
                            </td>
                            <td class="auto-style1" style="color: #6299c5; vertical-align: top; text-align: left;">
                                <label id="lbl_ecode" class="lblcss">@Model.EmpDetailsIntQuestModel?.lbl_ecode</label>
                            </td>
                        </tr>
                        <tr class="active" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Age :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                <label id="lbl_age" class="lblcss">@Model.EmpDetailsIntQuestModel?.lbl_age</label>
                            </td>
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Div &amp; Dept :-
                            </td>
                            <td class="auto-style1" style="color: #6299c5; vertical-align: top; text-align: left;">
                                <label id="lbl_dept" class="lblcss">@Model.EmpDetailsIntQuestModel?.lbl_dept</label>
                            </td>
                        </tr>
