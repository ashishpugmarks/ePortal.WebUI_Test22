                <a class="nav-link disabled" data-bs-toggle="tab" href="#reasonLeaving">Reason for Leaving HMSI</a>
            </li>
            <li class="nav-item">
                <a class="nav-link disabled" data-bs-toggle="tab" href="#workCondition">Work Condition & Environment</a>
            </li>
             <li class="nav-item">
                <a class="nav-link disabled" data-bs-toggle="tab" href="#superVision">Super Vision</a>
            </li>
            <li class="nav-item">
