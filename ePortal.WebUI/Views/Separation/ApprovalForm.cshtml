@model ePortal.ViewModels.APPX.Separation.ApprovalFormModel
@{
    ViewBag.Title = "ApprovalForm";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
            line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
            font-size: 11px;
            border-collapse: collapse;
            color: #000000;
            font-family: Verdana, Tahoma;
        }

            .tableMainInner tr td {
                border: solid 1px #CCDCE0;
                padding: 0;
            }

                .tableMainInner tr td.heading {
                    text-align: right;
                }

        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
            margin-bottom: 4px;
        }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                line-height: 24px;
                font-family: Verdana, Arial, Helvetica;
                font-size: 11px;
            }

            .tableGridView tr th {
                background: url(../images/bg_header.jpg) #cae8ea no-repeat;
            }

        .HeaderStyle12 {
            border: 1px solid #C1C4C8;
            border-bottom: none;
        }

        .lblcss {
            color: #6299C5 !important;
        }
    </style>
}

<table cellspacing="0" cellpadding="1" width="100%" border="0">
    <tr>
        <td>
            <div id="errorpanel" style="width:100%; display:none;">
                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr id="tr_ErrorRow">
                        <td style="padding-top: 5px; padding-bottom: 2px; padding-left: 2px; padding-right: 2px;">
                            <div id="pnlErrorHeader" style="background-color:#ED243B; width:100%;" class="roundedPanel">
                                <div style="padding-left: 6px;">
                                    <div style="background-color:#ffeaea; width:99%;" id="pnlError" class="roundedPanel">
                                        <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                            <tr>
                                                <td style="padding: 2px; padding-left: 5px; color: Black;">
                                                    @Html.TextBox("txtup", null, new { style = "width:0px; border:none;" })
                                                    <label id="status" style="font-size:13px; font-family:'Trebuchet MS';"></label>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </td>
    </tr>
</table>
@*-------------Heading Start-------*@
<div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
    <div style="height: 8px;"></div>
    <span style="padding-left: 20px;">Resignation Approval </span>
</div>
@*-----------Heading End----------*@
<div class="headmain">
    <div style="padding-left: 6px; padding-right: 6px;">
        <table class="table table-responsive table-bordered table-condensed table-striped" style="border-color: #CCDCE0; border-width: 1px; border-style: solid;
                                margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;" cellpadding="0"
               cellspacing="0" width="100%">
            <thead>
                <tr>
                    <td class="HeaderStyle12" colspan="4">
                        &nbsp;Associate Detail&#39;s
                    </td>
                </tr>
            </thead>
            <tbody>
                <tr id="tr_1" runat="server" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Name :-
                    </td>
                    <td class="smalltext" style="width: 30%; color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_assname" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_assname</label>&nbsp;[<label id="lbl_assecode" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_assecode</label>]
                    </td>
                    <td style="width: 20%; text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Joining Date :-
                    </td>
                    <td class="smalltext" style="width: 25%; color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_joindate" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_joindate</label>
                        @* <label id="lblResignType" Visible="false" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lblResignType</label> *@
                        <input id="lblResignType" type="hidden" name="lblResignType" value="@Model.ApprvFormEmpDetailsViewModel?.lblResignType" />
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Designation :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_desg" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_desg</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Func. Designation :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_fundesg" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_fundesg</label>
                    </td>
                </tr>
                <tr>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        <span class="smalltext">Mobile Number :-</span>
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_phone" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_phone</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        Email Id :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_emailid" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_emailid</label>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Operation :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_op" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_op</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Division :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_div" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_div</label>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Department :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_dept" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_dept</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Section :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_sec" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_sec</label>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Site :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_site" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_site</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Resignation Date :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_applydate" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_applydate</label>
                    </td>
                </tr>
                <tr>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Relieving Date (Associate) :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_reldate" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_reldate</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Final Relieving Date :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_deptreldate" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_deptreldate</label>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Subject :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                        colspan="3">
                        &nbsp;<label id="lbl_subject" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_subject</label>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Body :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                        colspan="3">
                        &nbsp;<label id="lbl_reason" class="lblcss">@Model.ApprvFormEmpDetailsViewModel?.lbl_reason</label>
                    </td>
                </tr>
            </tbody>
        </table>
        <table class="table table-responsive table-bordered table-condensed table-striped" style="border-color: #CCDCE0; border-width: 1px; border-style: solid;
                                margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;" cellpadding="0"
               cellspacing="0" width="100%">
            <thead>
                <tr>
                    <td class="HeaderStyle12" colspan="2">
                        &nbsp;Approval Detail&#39;s
                    </td>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="2">
                        <table id="grdApprovalDetails" class="tableGridView" style="width:100%">
                            <thead class="grdHeader">
                                <tr>
                                    <th style="width:25%">Name</th>
                                    <th style="width:15%">Func.Designation</th>
                                    <th style="width:10%">Status</th>
                                    <th style="width:20%">Approval Date</th>
                                    <th style="width:70%">Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.ApprvFormApprovalDtlsViewModel.Any())
                                {
                                    var rowIndex = 0;
                                    foreach (var item in Model.ApprvFormApprovalDtlsViewModel)
                                    {
                                        var rowClass = rowIndex % 2 == 0 ? "grdrow" : "altrow"; 
                                        <tr class="@rowClass">
                                            <td>@item.APPNAME [@item.APPECODE]</td>
                                            <td>@item.DESIG</td>
                                            <td style="color:green">@item.STATUS</td>
                                            <td>@item.APPSUBMITEDATE</td>
                                            <td>@item.APPREMARK</td>
                                        </tr>
                                        rowIndex++;
                                    }
                                }
                                else
                                {
                                    <tr class="emptyrow" style=" background-color: #F5FFF0;height:20px;font-family:Calibri;color:#274D14;">
                                        <td colspan="5">No approval details found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        
                    </td>
                </tr>
                <tr style="line-height: 25px;" id="tr_approval" runat="server">
                    <td style="width: 25%; text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Final Relieving Date :-<span class="mandatory">*</span>
                    </td>
                    <td class="smalltext" style="width: 75%; color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;
                        @Html.DropDownListFor(m => m.ApprvFormEmpDetailsViewModel.SelectedoptDay, Model?.ApprvFrmDateTimeViewModel.Days,
                                 new { @id = "optDay", @class = "swiftselect", style = "font-size:8pt;"})

                        @Html.DropDownListFor(m => m.ApprvFormEmpDetailsViewModel.SelectedoptMonth, Model?.ApprvFrmDateTimeViewModel.Months,
                                 new { @id = "optMonth", @class = "swiftselect", style = "font-size:8pt;"})

                        @Html.DropDownListFor(m => m.ApprvFormEmpDetailsViewModel.SelectedoptMonth, Model?.ApprvFrmDateTimeViewModel.Years,
                                 new { @id = "optYear", @class = "swiftselect", style = "font-size:8pt;"})
                    </td>
                </tr>

                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Approval Status :-<span class="mandatory">*</span>
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;
                            <input type="radio" id="Approved" name="rdoappstatus" value="1" checked />
                            <label for="Approved">Approved</label>

                            <input type="radio" id="Hold" name="rdoappstatus" value="2" />
                            <label for="Hold">Hold</label>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Remarks :-<span class="mandatory">*</span>
                    </td>
                    <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                        &nbsp;
                        <textarea id="txt_remarks" name="txt_remarks"
                                  class="font12"
                                  style="border:1px solid #888888; width:500px;"
                                  onkeypress="return (this.value.length < 200);"
                                  onpaste="return false">
                        </textarea>

                    </td>
                </tr>
                <tr>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Approving Authority :-<span class="mandatory">*</span>
                    </td>
                    <td style="color: #6299c5; vertical-align: top; text-align: left;">
                        <label id="lbl_appauth" class="swifttext" Style="width: 250px;
                        margin-left: 4px!Important; background-color: #F6F8FA; color: Gray; line-height: 15px;">@Model?.ApprvFormEmpDetailsViewModel?.ApprvFormFillAPPAUTHDetails?.lbl_appauth</label>
                        <input type="hidden" id="hdauthlevel" name="hdauthlevel" value="@Model?.ApprvFormEmpDetailsViewModel?.ApprvFormFillAPPAUTHDetails?.hdauthlevel" />
                        <input type="hidden" id="hdauthcode" name="hdauthcode" value="@Model?.ApprvFormEmpDetailsViewModel?.ApprvFormFillAPPAUTHDetails?.hdauthcode" />
                        <input type="hidden" id="hdauthemailid" name="hdauthemailid" value="@Model?.ApprvFormEmpDetailsViewModel?.ApprvFormFillAPPAUTHDetails?.hdauthemailid" />
                        <input type="hidden" id="hdauthname" name="hdauthname" value="@Model?.ApprvFormEmpDetailsViewModel?.ApprvFormFillAPPAUTHDetails?.hdauthname" />
                        @* Hidden field for REGID_ECODE *@
                        <input type="hidden" id="hdn_ResigID" name="hdn_ResigID" value="@ViewBag.ResigID" />
                    </td>
                </tr>
                <tr>
                    <td class="buttonwrapper" align="center" colspan="2">
                        <button type="button" id="cmdSubmit" class="yellowbuttonbig">Submit</button>
                        &nbsp;
                        <a style="text-align: center;width:100px;display: inline-block;" href="@Url.Action("ManageResignationRequest", "Separation")"
                           class="yellowbuttonbig">Cancel</a>
                    </td>
                </tr>
            </tbody>
        </table>

    </div>

</div>
<div class="clear">
</div>
<table cellspacing="0" cellpadding="0" style="margin-left: 7px;" width="99%" border="0"
       class="backrow_grey">
    <tbody>
        <tr>
            <td style="height:24px; width:20px; padding-left:2px;" valign="middle" align="right">
                <a title="Back" href="@Url.Action("ManageResignationRequest", "Separation")">
                    <img src="../../images/icon_back.gif" height="16" width="16" alt="Back" />
                </a>
            </td>
            <td style="height:24px; padding-left:4px;font-size:14px;" align="left">
                <a title="Back" href="@Url.Action("ManageResignationRequest", "Separation")">Back</a>
            </td>
        </tr>
    </tbody>
</table>
<br />
<div class="clear">
</div>
@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">

        $(document).ready(function () {
                               
          $('#cmdSubmit').on('click', function () {
                  var data = {
                      ResigID: $("#hdn_ResigID").val(),
                      SelectedDay: $("#optDay").val(),
                      SelectedMonth: $("#optMonth").val(),
                      SelectedMonthText: $("#optMonth option:selected").text(),
                      SelectedYear: $("#optYear").val(),
                      ResignType: $("#lblResignType").val(),
                      RadiobtnAppAtatus: $("input:radio[name='rdoappstatus']:checked").val(),
                      Remarks: $("#txt_remarks").val(),
                      AuthCode: $("#hdauthcode").val(),
                      AuthLevel: $("#hdauthlevel").val(),
                      AppAuth: $("#lbl_appauth").val(),
                      AssName: $("#lbl_assname").val(),
                      AsseCode: $("#lbl_assecode").val(),
                      RelDate: $("#lbl_reldate").val(),
                      Reason: $("#lbl_reason").val(),
                      Emailid: $("#lbl_emailid").val(),
                      AuthMailId: $("#hdauthemailid").val(),
                      AuthName: $("#hdauthname").val(),
                  };

                    $.ajax({
                        url: '@Url.Action("SubmitApprovalForm", "Separation")',
                        type: 'POST',
                        data: data,
                        success: function (response) {
                            if (response.success) {
                                window.location.href = response.redirectUrl;
                            } else {
                                if (response.showErrorPanel === true) {
                                    $("#errorpanel").show();
                                }
                                else if (response.showErrorPanel === false) {
                                    $("#errorpanel").hide();
                                }
                                $("#status").text(response.message);
                                if (response.focusId) {
                                    $("#" + response.focusId).focus();
                                }
                            }
                        },
                        error: function () {
                            alert("An error occurred while submitting.");
                        }
                    });
                });

          function cclick() {
            for (var i = 0; i < document.getElementById("<%=optMonth.ClientID %>").options.length; i++) {
                if (document.getElementById("<%=optMonth.ClientID %>").options[i].selected == true) {
                    if (document.getElementById("<%=optMonth.ClientID %>").options[i].value == 2) {
                        for (var j = 0; j < document.getElementById("<%=optDay.ClientID %>").options.length; j++) {
                            if (document.getElementById("<%=optDay.ClientID %>").options[j].selected == true) {
                                if (document.getElementById("<%=optDay.ClientID %>").options[j].value > 28) {
                                    if (document.getElementById("<%=optDay.ClientID %>").options[j].value == 29 & (document.getElementById("<%=optYear.ClientID %>").options.value == 2008 || document.getElementById("<%=optYear.ClientID %>").options.value == 2012 || document.getElementById("<%=optYear.ClientID %>").options.value == 2016 || document.getElementById("<%=optYear.ClientID %>").options.value == 2020 || document.getElementById("<%=optYear.ClientID %>").options.value == 2024 || document.getElementById("<%=optYear.ClientID %>").options.value == 2028)) {
                                    }
                                    else {
                                        //alert("Invalid date!")
                                        document.getElementById("<%=errorpanel.ClientID%>").style.display = "inline";
                                        document.getElementById("<%=status.ClientID%>").innerHTML = "Invalid date! please select valid  date.";
                                        document.getElementById("<%=optDay.ClientID %>").options[27].selected = true
                                    }
                                }
                            }
                        }
                    }
                    if (document.getElementById("<%=optMonth.ClientID %>").options[i].value == 4 || document.getElementById("<%=optMonth.ClientID %>").options[i].value == 6 || document.getElementById("<%=optMonth.ClientID %>").options[i].value == 9 || document.getElementById("<%=optMonth.ClientID %>").options[i].value == 11) {
                        for (var j = 0; j < document.getElementById("<%=optDay.ClientID %>").options.length; j++) {
                            if (document.getElementById("<%=optDay.ClientID %>").options[j].selected == true) {
                                if (document.getElementById("<%=optDay.ClientID %>").options[j].value > 30) {
                                    document.getElementById("<%=errorpanel.ClientID%>").style.display = "inline";
                                    document.getElementById("<%=status.ClientID%>").innerHTML = "Invalid date! please select valid  date.";
                                    document.getElementById("<%=optDay.ClientID %>").options[29].selected = true
                                }
                            }
                        }
                    }
                }
            }
        }
        });
    </script>
}
      
