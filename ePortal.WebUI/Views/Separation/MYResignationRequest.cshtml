@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        $(document).ready(function () {
             $("#detailslinkbtn").click(function () {
                  const resignId = document.getElementById('hd_Resign').value;
                  $.post('@Url.Action("SetResignSession", "Separation")', { resignId: resignId }, function () {
                  var url = '@Url.Action("ViewResignationDetails", "Separation")';
                  window.open(url, 'View', 'scrollbars=1,resizable=no,status=no,width=820,height=490,top=120,left=280');
               });
             });

              $("#linkanswerview").click(function () {
                const resignId = document.getElementById('hd_resignid').value;
                   var url = '@Url.Action("ExitInterviewAnswers", "Separation")' + '?id=' + encodeURIComponent(resignId);
                   window.open(url, 'View', 'scrollbars=1,resizable=no,status=no,width=820,height=490,top=120,left=280');
              });

              $("#linkfromiview").click(function () {
                   const resignId = document.getElementById('hd_Resign').value;
                   $.post('@Url.Action("SetResignSession", "Separation")', { resignId: resignId }, function () {
                   var url = '@Url.Action("ViewFormI", "Separation")';
                   window.open(url, 'View', 'scrollbars=1,resizable=no,status=no,width=820,height=490,top=120,left=280');
                   });
              });

               $("#clrlinkbtn").click(function () {
                const resignId = document.getElementById('hd_Resign').value;
                   //  const targetUrl = "/ASPXView/admin/separate/LetterPrint/ClearanceFormPrint.aspx?id=" + encodeURIComponent(resignId);
                   //  const url = "/TokenBridge/RedirectToOldApp?target=" + encodeURIComponent(targetUrl);
                   // window.open(url, 'View', 'scrollbars=1,resizable=no,status=no,width=820,height=490,top=120,left=280');

                var url = '@Url.Action("clrformbtn_click", "Separation")' + '?id=' + resignId;
                window.open(url, 'View', 'scrollbars=1,resizable=no,status=no,width=820,height=490,top=120,left=280');

               });

              $("#deptlinkbtn").click(function () {
                    const resignId = document.getElementById('hd_resignid').value;
                   const userId = '@ViewBag.UserID';
                    const url = '@Url.Action("ViewHistory", "Separation")' +
                    '?History=deptclrform1' +
                    '&ResignID=' + encodeURIComponent(resignId) +
                    '&ECODE=' + encodeURIComponent(userId) +
                    '&DEPTMGRID=';
                    window.open(url, 'View', 'scrollbars=1,resizable=no,status=no,width=820,height=490,top=120,left=280');
                });

                $('.detailLink').on('click', function (e) {
                    e.preventDefault();
                    var resignId = $(this).data('resignid');
                    var clrheaderId = $(this).data('clrheaderid');
                    var url = '@Url.Action("ViewClearanceDetails", "Separation")'
                              + '?RESIGNID=' + resignId + '&CLRHEADERID=' + clrheaderId;
                    openPopupwithScrol(url, 810, 420);
                });
          });

        function openPopupwithScrol(strOpenUrl, width, height) {
             var winTop = (screen.height - height) / 2;
            var winLeft = (screen.width - width) / 2;
                var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
                windowFeatures = windowFeatures + ",left = " + winLeft + ",";
                windowFeatures = windowFeatures + "top=" + winTop + ",resizable" + ",scrollbars";
                window.open(strOpenUrl, "mywindow", windowFeatures);
          }

    </script>
}