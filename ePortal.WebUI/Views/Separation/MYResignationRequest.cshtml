@model ePortal.ViewModels.APPX.Separation.MyResignationRequestModel
@{
    ViewBag.Title = "MyResignationRequest";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}

@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .grdheader th {
            padding-left: 3px;
        }

        .grdrow td {
            padding-left: 3px;
        }

            .grdrow td img {
                margin-top: 5px;
            }

        .leftdiv {
            float: left;
            width: 48%;
            height: 500px;
            border: 0px solid black;
        }

        .rightdiv {
            float: right;
            width: 48%;
            height: 500px;
            border: 0px solid red;
        }

        .mainapp {
            border: 1px solid #E1E1E8;
            width: 100%;
            height: 113px;
            padding: 8px 15px 8px 15px;
            background-color: #F2F2F2;
        }

        .userimg {
            border: 1px solid #E1E1E8;
            float: left;
            width: 70px;
            height: 70px;
        }

        .rightappdiv {
            padding: 0px 0px 0px 0px;
            border: 0px solid red;
            /*width: 340px;*/
            text-align: center;
            height: 70px;
        }

        .Detail-1 {
            background-color: #2C4D92;
            color: white;
            font-weight: bold;
            padding: 5px 15px;
            clear: both;
            cursor: pointer;
        }

            .Detail-1:hover {
                color: white;
                opacity: 1;
            }


        .Pending-1 {
            color: Red;
            font-weight: bold;
            padding: 5px 15px 5px 15px;
        }

        .HOLD-1 {
            color: #FF9219;
            font-weight: bold;
            padding: 5px 15px 5px 15px;
            cursor: text;
        }

        .APPROVE-1 {
            color: #009F01;
            font-weight: bold;
            clear: both;
            line-height: 20px;
        }

        .Pending-1 b {
            color: #444444 !Important;
        }

        .APPROVE-1 b {
            color: #444444 !Important;
        }

        .HOLD-1 b {
            color: #444444 !Important;
        }

        .Pending-1 b {
            color: #444444 !Important;
        }

        .withdraw-1 {
            background-color: #53BCDC;
            color: White;
            font-weight: bold;
            padding: 5px 15px 5px 15px;
        }

        .Edit-1 {
            background-color: #B848FF;
            color: White;
            font-weight: bold;
            padding: 5px 15px 5px 15px;
        }

        .mainheader {
            border: 1px solid #CCCCCC;
            /*width: 370px;*/
            height: 113px;
            padding: 10px;
            background-color: #F2F2F2;
        }

        .head-11 {
            width: 100%;
            border-bottom: 1px solid #6A99E6;
            font-weight: bolder;
            background-color: #6A99E6;
            line-height: 25PX;
            color: white;
            margin-bottom: 5px;
        }

        .nodata {
            border: 1px solid Red;
            line-height: 30px;
            width: 100%;
            color: Red;
            font-weight: bold;
            font-size: 1.5em;
        }

        .head-2 {
            width: 100%;
            border-bottom: 1px solid #CCCCCC;
            font-weight: bold;
            background-color: #EEEEEE;
            line-height: 25PX;
            color: gray;
            margin-bottom: 5px;
        }
    </style>
}

@* <%----------------------------------------------Heading Start-----------------------------------------%> *@
