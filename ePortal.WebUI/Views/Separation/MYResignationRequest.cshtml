                                                       data-clrheaderid="@item.CLEARENCEHEADERID"
                                                       style="margin-top:5px; display:inline-block;">
                                                       Details
                                                    </a>

                                                   @*  <a href="javascript:openPopupwithScrol('@Url.Action("ViewClearanceDetails", "Separation", new { RESIGNID = item.RESIGNATIONID, CLRHEADERID = item.CLEARENCEHEADERID })',830,560)" style="margin-top: 10px !important;" class="Detail-1">
                                                        Details
                                                    </a> *@

                                                </div>
                                            }
                                  </div>
                               }
                            </div>
                        </div>
                        }
                    </div>
                </td>
