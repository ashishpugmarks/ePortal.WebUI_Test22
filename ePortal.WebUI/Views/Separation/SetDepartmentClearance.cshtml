                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center">
                            <button type="button" id="cmdSubmit" class="bluebutton">Submit</button>
                            &nbsp;
                            <a id="cmdCancel" style="text-align: center;width:100px;display: inline-block;" href="@Url.Action("ManageResignationRequest", "Separation")"
                               class="bluebutton">Cancel</a>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<table cellspacing="0" cellpadding="0" style="margin-left: 7px;" width="99%" border="0"
       class="backrow_grey">
    <tbody>
        <tr>
            <td style="height:24px; width:20px; padding-left:2px;" valign="middle" align="right">
                <a title="Back" href="@Url.Action("ManageResignationRequest", "Separation")">
                    <img src="../../images/icon_back.gif" height="16" width="16" alt="Back" />
                </a>
            </td>
            <td style="height:24px; padding-left:4px;font-size:14px;" align="left">
                <a title="Back" href="@Url.Action("ManageResignationRequest", "Separation")">Back</a>
            </td>
        </tr>
    </tbody>
</table>
<br />
<div class="clear">
</div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        $(document).ready(function () {
            $("#cmdSubmit").click(function () {
                var data = {
                    ConfDoc: $("#txt_confdoc").val(),
                    OtherDoc: $("#txt_otherdoc").val(),
                    LibraryBook: $("#txt_librarybook").val(),
                    ItAssest: $("#txt_itassets").val(),
                    Camere: $("#txt_camera").val(),
                    Key: $("#txt_key").val(),
                    TravelBill: $("#txt_travelbill").val(),
                    BasicSal: $("#lbl_basicsal").val(),
                    Regid_Ecode: $("#hdn_REGID_ECODE").val(),
                };

                $.ajax({
                    url: '@Url.Action("SubmitSetDeptClearance", "Separation")',
                    type: 'POST',
                    data: data,
                    success: function (response) {
                        if (response.success) {
                            window.location.href = response.redirectUrl;
                        } else {
                            sweetAlert("", response.message, "error");
                        }
                    },
                    error: function () {
                        alert("An error occurred while submitting.");
                    }
                });
            });
        });


  function moveCaretToStart(el) {
    el.setSelectionRange(0, 0);
  }

  const ids = ["txt_confdoc", "txt_otherdoc", "txt_librarybook","txt_itassets", "txt_camera", "txt_key","txt_travelbill"];

  ids.forEach(function(id) {
    const txt = document.getElementById(id);
    if (txt) {
      txt.addEventListener("focus", function() {
        moveCaretToStart(this);
      });
      txt.addEventListener("click", function() {
        moveCaretToStart(this);
      });
    }
  });
 </script>
}