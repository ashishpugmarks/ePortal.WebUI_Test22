                                        </td>
                                        <td>
                                            <textarea id="txt_confdoc" name="txt_confdoc"
                                                      class="form-control"
                                                      style="max-width:391px; height:43px;"
                                                      onkeypress="return this.value.length < 200;"
                                                      onpaste="return false">
                                            </textarea>

                                        </td>
                                    </tr>
                                    <tr class="active">
                                        <td>
                                            <b style="color: #4B4D4C;">Other Documents and Material</b>
                                        </td>
                                        <td>
                                            <textarea id="txt_otherdoc" name="txt_otherdoc"
                                                      class="form-control"
                                                      style="max-width:391px; height:35px;"
                                                      onkeypress="return this.value.length < 200;"
                                                      onpaste="return false">
                                            </textarea>

                                        </td>
                                    </tr>
                                    <tr class="info">
                                        <td>
                                            <b style="color: #4B4D4C;">Books/Library</b>
                                        </td>
                                        <td>
