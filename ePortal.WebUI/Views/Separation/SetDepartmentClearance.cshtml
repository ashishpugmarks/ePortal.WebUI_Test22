                                        </td>
                                        <td>
                                            <textarea id="txt_camera" name="txt_camera"
                                                      class="form-control"
                                                      style="max-width:391px; height:35px;"
                                                      onkeypress="return this.value.length < 200;"
                                                      onpaste="return false">
                                            </textarea>

                                        </td>
                                    </tr>
                                    <tr class="active">
                                        <td>
                                            <b style="color: #4B4D4C;">Key(Drawer/File/Cabinet)</b>
                                        </td>
                                        <td>
                                            <textarea id="txt_key" name="txt_key"
                                                      class="form-control"
                                                      style="max-width:391px; height:35px;"
                                                      onkeypress="return this.value.length < 200;"
                                                      onpaste="return false">
                                            </textarea>

                                        </td>
                                    </tr>
                                    <tr class="info">
                                        <td>
                                            <b style="color: #4B4D4C;">Travel Bills.if any submitted to Finance(Yes/No)</b>
                                        </td>
                                        <td>
                                            <textarea id="txt_travelbill" name="txt_travelbill"
                                                      class="form-control"
                                                      style="max-width:391px; height:35px;"
                                                      onkeypress="return this.value.length < 200;"
                                                      onpaste="return false">
