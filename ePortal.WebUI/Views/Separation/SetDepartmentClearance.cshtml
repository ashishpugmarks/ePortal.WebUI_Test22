                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label ID="lbl_site" class="lblcss">@Model.SetDeptClrEmpDtlsViewModel?.lbl_site</label>
                            </td>
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Resignation Date :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label ID="lbl_applydate" class="lblcss">@Model.SetDeptClrEmpDtlsViewModel?.lbl_applydate</label>
                            </td>
                        </tr>
                        <tr class="info">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Relieving Date (Associate) :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label ID="lbl_reldate" class="lblcss">@Model.SetDeptClrEmpDtlsViewModel?.lbl_reldate</label>
                            </td>
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Final Relieving Date :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label ID="lbl_deptreldate" class="lblcss">@Model.SetDeptClrEmpDtlsViewModel?.lbl_deptreldate</label>
                            </td>
                        </tr>
                        <tr class="active" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Basic Salary :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
