@model ePortal.ViewModels.APPX.Separation.ViewFormIModel
@{
    ViewBag.Title = "ViewFormI";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}

@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
            line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
            font-size: 11px;
            border-collapse: collapse;
            color: #000000;
            font-family: Verdana, Tahoma;
        }

            .tableMainInner tr td {
                border: solid 1px #CCDCE0;
                padding: 0;
            }

                .tableMainInner tr td.heading {
                    text-align: right;
                }

        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
        }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                line-height: 24px;
                font-family: Verdana, Arial, Helvetica;
                font-size: 11px;
            }

            .tableGridView tr th {
                background: url(../../images/bg_header.jpg) #cae8ea no-repeat;
            }

        .HeaderStyle12 {
            border: 1px solid #C1C4C8;
            border-bottom: none;
        }

        .lblcss {
            color: #6299C5 !important;
        }

        .whitener {
            color: White;
        }

        .colorme {
            color: #6299c5;
        }
    </style>
}
<div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular;  vertical-align: middle;">
</div>
<div id="divToPrint" style="background-color: White;">
    <table class="table table-responsive table-bordered table-condensed table-striped" style="border-color: #CCDCE0; border-width: 1px; border-style: solid;
                                margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;" cellpadding="0"
           cellspacing="0" width="100%">
        <thead>
            <tr>
                <td colspan="2" align="center" style="vertical-align:middle;font-size: large; font-weight: bold; font-family: Roboto-Regular; ">
                    &nbsp;Form 'I'
                </td>
            </tr>
            <tr>
                <td colspan="2" align="center" style="vertical-align:middle;font-size: large; font-weight: bold; font-family: Roboto-Regular; ">
                    &nbsp;Application for Gratuity by an Employee
                </td>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="2">
                    </br> To, </br>
                    </br>
                    Honda Motorcycle & Scooter India Pvt. Ltd.</br>
                    Plot No. 1, Sector-3, IMT Manesar,</br>
                    Distt. Gurgaon, Haryana</br></br>

                    Sir,</br>
                    </br>
                    I beg to apply for payment of gratuity to which I am entitled under sub-section (1) of Section 4 of the Payment of Gratuity Act, 1972 on account of my superannuation/retirement/resignation after completion of not less than five years of continuous service/total disablement due to accident/total disablement due to disease with effect from the
                    &nbsp; <u> <label id="lbl_resignationdate" class="lblcss">@Model.EmployeeViewFormIModel?.lbl_resignationdate</label>  </u>&nbsp; Necessary particulars relating to my appointment are given in the statement below.
                    </br>
                </td>
            </tr>
            <tr>
                <td colspan="2" align="center" style="height:10px;"></td>
            </tr>
            <tr>
                <td colspan="2" align="center" style="height:10px; font-weight: bold;"> Statement</td>
            </tr>
            <tr>
                <td colspan="2" align="center" style="height:10px;"></td>
            </tr>
            <tr id="tr_1" runat="server" style="line-height: 25px;">
                <td style="text-align: left; vertical-align: top;" class="font12">
                    &nbsp;1. Name in full  :-
                </td>
                <td class="smalltext" style="width: 65%; color: #6299c5; vertical-align: top; text-align: left;">
                    &nbsp;<label id="lbl_assname" class="lblcss">@Model.EmployeeViewFormIModel?.lbl_assname</label>&nbsp;[<label id="lbl_assecode" class="lblcss">@Model.EmployeeViewFormIModel?.lbl_assecode</label>]
                </td>

            </tr>
            <tr style="line-height: 25px;">
                <td style="text-align: left; vertical-align: top;" class="font12">
                    &nbsp;2. Address in full  :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                    &nbsp;<label id="lbl_daddress" class="lblcss">@Model.EmployeeViewFormIModel?.lbl_daddress</label>
                </td>
            </tr>
            <tr>
                <td style="text-align: left; vertical-align: top;" class="font12">
                    <span class="smalltext">&nbsp;3. Department/Branch/Section where last employed :-</span>
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                    &nbsp;<label id="lbl_org" class="lblcss">@Model.EmployeeViewFormIModel?.lbl_org</label>
                </td>

            </tr>
            <tr style="line-height: 25px;">
                <td style="text-align: left; vertical-align: top;" class="font12">
                    &nbsp;4. Post held with Ticket No., or Serial No., if any  :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                    &nbsp;<label id="lbl_ecodedesg" class="lblcss">@Model.EmployeeViewFormIModel?.lbl_ecodedesg</label>
                </td>

            </tr>
            <tr style="line-height: 25px;">
                <td style="text-align: left; vertical-align: top;" class="font12">
                    &nbsp;5. Date of appointment  :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                    &nbsp;<label id="lbl_joindate" class="lblcss">@Model.EmployeeViewFormIModel?.lbl_joindate</label>
                </td>

            </tr>
            <tr style="line-height: 25px;">
                <td style="text-align: left; vertical-align: top;" class="font12">
                    &nbsp;6. Date and cause of termination of service  :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                    &nbsp;<label id="lbl_Relivingdate" class="lblcss">@Model.EmployeeViewFormIModel?.lbl_Relivingdate</label> / Resigned
                </td>

            </tr>
            <tr>
                <td style="text-align: left; vertical-align: top;" class="font12">
                    &nbsp;7. Total period of service  :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                    &nbsp;<label id="lbl_serviceperiod" class="lblcss">@Model.EmployeeViewFormIModel?.lbl_serviceperiod</label>
                </td>

            </tr>
            <tr style="line-height: 25px;">
                <td style="text-align: left; vertical-align: top;" class="font12">
                    &nbsp;8. Amount of wages last drawn  :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                    colspan="3">
                    &nbsp;<label id="lbl_basicamt" class="lblcss">@Model.EmployeeViewFormIModel?.lbl_basicamt</label>
                </td>
            </tr>
            <tr style="line-height: 25px;">
                <td style="text-align: left; vertical-align: top;" class="font12">
                    &nbsp;9. Amount of gratuity claimed  :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                    colspan="3">
                    &nbsp;<label id="lbl_gratuityamt" class="server">@Model.EmployeeViewFormIModel?.lbl_gratuityamt</label>
                </td>
            </tr>
            <tr style="line-height: 25px;">
                <td colspan="2" style="text-align: left; vertical-align: top;" class="font12">
                    &nbsp; &nbsp;1. I was rendered totally disabled as a result of---</br>
                    &nbsp; &nbsp;(Here give the details of the nature of disease or accident) 	</br>
                    &nbsp; &nbsp;The evidences/witnesses in support of my total disablement are as follows:--</br>
                    &nbsp; &nbsp;(Here give details)&nbsp; <b> NA</b>
                    </br>
                    &nbsp; &nbsp;2. Payment may please be made in case/open or crossed bank cheque or Bank Transfer.
                    </br>
                    &nbsp; &nbsp;3. As the amount of gratuity payable is less than rupees one thousand, I shall request you to arrange for payment of the sum due to me by Postal Money Order at the address mentioned above after deducting postal money order commission therefrom <b>NA</b>

                </td>

            </tr>
            <tr style="line-height: 25px;">
                <td style="text-align: left; vertical-align: top;" class="font12">
                    &nbsp;10. Personal Mail Id  :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                    colspan="3">
                    &nbsp; <label id="lblemailid" class="lblcss">@Model.EmployeeViewFormIModel?.lblemailid</label>
                </td>
            </tr>
            <tr>
                <td colspan="2" align="center" style="height:10px;"></td>
            </tr>
            <tr>
                <td colspan="2" align="center" style="height:10px;"></td>
            </tr>
            <tr>
                <td colspan="2" align="center" style="height:10px;"></td>
            </tr>
            <tr>
                <td colspan="2" align="right">
                    </br></br> Yours faithfully,</br>
                    &nbsp;<label id="lbl_namesing" class="lblcss">@Model.EmployeeViewFormIModel?.lbl_namesing</label>&nbsp;
                </td>
            </tr>

        </tbody>
    </table>

</div>
<center style="background-color: White;">
    <input id="printbtn" type="button" class="bluebutton" value="Print"/>
</center>
<br />
<br />
@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        $(document).ready(function () {
            $("#printbtn").click(function () {
                var divToPrint = document.getElementById('divToPrint');
                var popupWin = window.open('', '_blank', 'scrollbars=1,center=yes,resizable=no,STATUS=no,Width=850px,Height=550px,top=110px,left=260px');
                popupWin.document.open();
                popupWin.document.write('<html><body onload="window.print()">' + divToPrint.innerHTML + '</html>');
                popupWin.document.close();
                window.focus();
                window.close();
            });
        });
        function ShowHideTestCases() {
            var link = document.getElementById('linkTestCases');
            var s = document.getElementById("divTestCases");
            if (s.style.display == 'block') {
                s.style.display = 'none';
                link.innerHTML = 'Show';
            }
            else {
                s.style.display = 'block';
                link.innerHTML = 'Hide';
            }
        }
        function openPopup(strOpenUrl, width, height) {
            window.open(strOpenUrl, "mywindow2", "TOOLBAR=no,MENUBAR=no,RESIZABLE=no,SCROLLBARS=yes,LOCATION=no,DIRECTORIES=no,STATUS=no,width=" + width + ",height=" + height);
        }
    </script>
}
