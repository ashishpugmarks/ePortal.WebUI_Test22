@model ePortal.ViewModels.APPX.Separation.ViewResignationDetailsModel
@{
    ViewBag.Title = "ViewResignationDetails";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}

@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
            line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
            font-size: 11px;
            border-collapse: collapse;
            color: #000000;
            font-family: Verdana, Tahoma;
        }

            .tableMainInner tr td {
                border: solid 1px #CCDCE0;
                padding: 0;
            }

                .tableMainInner tr td.heading {
                    text-align: right;
                }

        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
        }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                line-height: 24px;
                font-family: Verdana, Arial, Helvetica;
                font-size: 11px;
            }

            .tableGridView tr th {
                background: url(../../images/bg_header.jpg) #cae8ea no-repeat;
            }

        .HeaderStyle12 {
            border: 1px solid #C1C4C8;
            border-bottom: none;
        }

        .lblcss {
            color: #6299C5 !important;
        }

        .whitener {
            color: White;
        }

        .colorme {
            color: #6299c5;
        }
    </style>
}

@using (Html.BeginForm())
{
    <div style="background-color: White;">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="height: 8px;"></div>
            <span style="padding-left: 20px;"> Resignation Details</span>
        </div>
        <div id="divToPrint" style="background-color: White;font-size:12px;">
            <table class="table table-bordered table-condensed table-striped table-responsive" width="100%">
                <tbody>
                    <tr>
                        <td valign="top" align="left">
                            <table class="table table-bordered table-condensed table-striped table-responsive" width="100%" id="maintable" runat="server">
                                <tbody>
                                    <tr>
                                        <td bgcolor="#ffffff" style="padding: 0px">
                                            <table class="table table-bordered table-condensed table-striped table-responsive" width="100%" style="padding: 2px 1px 2px 1px; border-collapse: collapse;"
                                                border="1px" cellspacing="0" cellpadding="0">
                                                <thead>
                                                    <tr class="HeaderStyle123" style="line-height: 30px; padding-left: 1px; border: 1px solid #C0C0C0; border-bottom: none;">
                                                        <td colspan="4"><b>&nbsp;&nbsp;Associate's Detail</b></td>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr id="tr_1" runat="server" class="info" style="line-height: 25px;">
                                                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Name :-
                                                        </td>
                                                        <td class="colorme" style="width: 30%; vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_assname" class="lblcss">@Model.EmployeeDetails?.lbl_assname</label>&nbsp;[<label id="lbl_assecode" class="lblcss">@Model.EmployeeDetails?.lbl_assecode</label>]
                                                        </td>
                                                        <td style="width: 20%; text-align: right; vertical-align: top;" class="font12">&nbsp;Joining Date :-
                                                        </td>
                                                        <td class="colorme" style="width: 25%; vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_joindate" class="lblcss">@Model.EmployeeDetails?.lbl_joindate</label>
                                                        </td>
                                                    </tr>
                                                    <tr class="active" style="line-height: 25px;">
                                                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Designation :-
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_desg"  class="lblcss">@Model.EmployeeDetails?.lbl_desg</label>
                                                        </td>
                                                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Func. Designation :-
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_fundesg"  class="lblcss">@Model.EmployeeDetails?.lbl_fundesg</label>
                                                        </td>
                                                    </tr>
                                                    <tr class="info">
                                                        <td style="text-align: right; vertical-align: top;" class="font12">
                                                            <span class="smalltext">Mobile Number :-</span>
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_phone" class="lblcss">@Model.EmployeeDetails?.lbl_phone</label>
                                                        </td>
                                                        <td style="text-align: right; vertical-align: top;" class="font12">Email Id :-
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_emailid" class="lblcss">@Model.EmployeeDetails?.lbl_emailid</label>
                                                        </td>
                                                    </tr>
                                                    <tr class="active" style="line-height: 25px;">
                                                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Operation :-
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_op" class="lblcss">@Model.EmployeeDetails?.lbl_op</label>
                                                        </td>
                                                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Division :-
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_div" class="lblcss">@Model.EmployeeDetails?.lbl_div</label>
                                                        </td>
                                                    </tr>
                                                    <tr class="info" style="line-height: 25px;">
                                                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Department :-
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_dept" class="lblcss">@Model.EmployeeDetails?.lbl_dept</label>
                                                        </td>
                                                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Section :-
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_sec" class="lblcss">@Model.EmployeeDetails?.lbl_sec</label>
                                                        </td>
                                                    </tr>
                                                    <tr class="active" style="line-height: 25px;">
                                                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Site :-
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_site" class="lblcss">@Model.EmployeeDetails?.lbl_site</label>
                                                        </td>
                                                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Resignation Date :-
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_applydate" class="lblcss">@Model.EmployeeDetails?.lbl_applydate</label>
                                                        </td>
                                                    </tr>
                                                    <tr class="info">
                                                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Relieving Date(Associate) :-
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_reldate" class="lblcss">@Model.EmployeeDetails?.lbl_reldate</label>
                                                        </td>
                                                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Final Relieving Date:-
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;">
                                                            &nbsp;<label id="lbl_deptreldate" class="lblcss">@Model.EmployeeDetails?.lbl_deptreldate</label>
                                                        </td>
                                                    </tr>
                                                    <tr class="active" style="line-height: 25px;">
                                                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Subject :-
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;" colspan="3">
                                                            &nbsp;<label id="lbl_subject" class="lblcss">@Model.EmployeeDetails?.lbl_subject</label>
                                                        </td>
                                                    </tr>
                                                    <tr class="info" style="line-height: 25px;">
                                                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Body :-
                                                        </td>
                                                        <td class="colorme" style="vertical-align: top; text-align: left;" colspan="3">
                                                            &nbsp;<label id="lbl_reason" class="lblcss">@Model.EmployeeDetails?.lbl_reason</label>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                            <br />
                                            <div class="HeaderStyle123" style="line-height: 25px; padding-left: 1px; border: 1px solid #C0C0C0; border-bottom: none;">
                                                <b>&nbsp;&nbsp;Approval Status</b>
                                            </div>
                                            <table class="table table-bordered table-condensed table-striped table-responsive" style="width:100%; border-spacing:0; border-collapse:collapse;">
                                                <thead class="grdHeader" style="height:25px;">
                                                    <tr>
                                                        <th style="width:25%; text-align:center;">Name</th>
                                                        <th style="width:15%; text-align:center;">Functional Designation</th>
                                                        <th style="width:10%; text-align:center;">Status</th>
                                                        <th style="width:20%; text-align:center;">Approval Date</th>
                                                        <th style="width:20%; text-align:center;">Remarks</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.ApprovalDetails != null && Model.ApprovalDetails.Any())
                                                    {
                                                        int rowIndex = 0;
                                                        foreach (var item in Model.ApprovalDetails)
                                                        {
                                                            var rowClass = rowIndex % 2 == 0 ? "grdrow" : "";
                                                            <tr class="@rowClass" style="height:20px; background-color:@(rowClass == "" ? "White" : "inherit")">
                                                                <td style="text-align:center; vertical-align:middle;">
                                                                    @item.APPNAME [@item.APPECODE]
                                                                </td>
                                                                <td style="text-align:center; vertical-align:middle;">
                                                                    @item.DESIG
                                                                </td>
                                                                <td style="text-align:center; vertical-align:middle;">
                                                                    @item.STATUS
                                                                </td>
                                                                <td style="text-align:center; vertical-align:middle;">
                                                                    @item.APPSUBMITEDATE
                                                                </td>
                                                                <td style="text-align:center; vertical-align:middle;">
                                                                    @item.APPREMARK
                                                                </td>
                                                            </tr>
                                                            rowIndex++;
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="5" style="background-color:#F5FFF0; height:20px; font-family:Calibri; color:#274D14; text-align:center; font-weight:bold;">
                                                                No Approval Found
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            <br />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4">
                            <div class="whitener" id="printhelp" style="margin-left: 500px;">
                                Printed By :- &nbsp
                                <label id="lblPrintedby">@Model.EmployeeDetails?.lblPrintedby</label>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <center style="background-color: White;">
        <input id="printbtn" type="button" class="bluebutton" value="Print"/>
    </center>
        <br />
        <br />
    </div>
}


@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
          $(document).ready(function () {
               $("#printbtn").click(function () {
                   var divToPrint = document.getElementById('divToPrint');
                    var popupWin = window.open('', '_blank', 'scrollbars=1,center=yes,resizable=no,STATUS=no,Width=850px,Height=550px,top=110px,left=260px');
                    popupWin.document.open();
                    popupWin.document.write('<html><body onload="window.print()">' + divToPrint.innerHTML + '</html>');
                    popupWin.document.close();
                    window.focus();
                    window.close();
               });
          });

        function ShowHideTestCases() {
            var link = document.getElementById('linkTestCases');
            var s = document.getElementById("divTestCases");
            if (s.style.display == 'block') {
                s.style.display = 'none';
                link.innerHTML = 'Show';
            }
            else {
                s.style.display = 'block';
                link.innerHTML = 'Hide';
            }
        }
        function openPopup(strOpenUrl, width, height) {
            window.open(strOpenUrl, "mywindow2", "TOOLBAR=no,MENUBAR=no,RESIZABLE=no,SCROLLBARS=yes,LOCATION=no,DIRECTORIES=no,STATUS=no,width=" + width + ",height=" + height);
        }
    </script>
}


