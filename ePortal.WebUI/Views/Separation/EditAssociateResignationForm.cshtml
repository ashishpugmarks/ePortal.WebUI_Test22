@model ePortal.ViewModels.APPX.Separation.EditAssociateResignationFormModel
@{
    ViewBag.Title = "EditAssociateResignationForm";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
        <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
               table {
            }

            .tableMainInner tr td, .tableMainOuter tr td {
                line-height: 20px;
            }

            .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
                font-size: 11px;
                border-collapse: collapse;
                color: #000000;
                font-family: Verdana, Tahoma;
            }

                .tableMainInner tr td {
                    border: solid 1px #CCDCE0;
                    padding: 0;
                }

                    .tableMainInner tr td.heading {
                        text-align: right;
                    }

            .oneRow {
                white-space: nowrap;
                padding: 0 2px 0 2px;
            }

            .tableGridView {
                border-collapse: collapse;
            }

                .tableGridView tr th, .tableGridView tr td {
                    border: 1px solid Silver;
                    line-height: 24px;
                    font-family: Verdana, Arial, Helvetica;
                    font-size: 11px;
                }

                .tableGridView tr th {
                    background: url(../../images/bg_header.jpg) #cae8ea no-repeat;
                }

            .HeaderStyle12 {
                border: 1px solid #C1C4C8;
                border-bottom: none;
            }
        </style>
}

<div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="height: 8px;"></div>
            <span style="padding-left: 20px;">Association Resignation Form </span>
</div>
@* Error Panel *@
<div id="errorpanel" style="width:100%; display:none;">
    <table width="100%" border="0" cellspacing="0" cellpadding="0">
        <tr id="tr_ErrorRow">
            <td style="padding:5px 2px;">
                <div id="pnlErrorHeader" style="background-color:#ED243B; width:100%;" class="roundedPanel">
                    <div style="padding-left:6px;">
                        <div id="pnlError" style="background-color:#ffeaea; width:99%;" class="roundedPanel">
                            <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                <tr>
                                    <td style="padding:2px 5px; color:Black;">
                                        @* Hidden textbox (if needed) *@
                                        @Html.TextBox("txtup", null, new { style = "width:0px; border:none;" })

                                        @* Status label *@
                                        <span id="status" style="font-size:13px; font-family:'Trebuchet MS';">
                                            @ViewBag.Status
                                        </span>

                                        @* Hidden field for REGID_ECODE *@
                                        <input type="hidden" id="hdn_ResigID" name="hdn_ResigID" value="@ViewBag.ResigID" />
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
    </table>
</div>
<div style="padding: 5px;"> 
    <div style="border-radius:6px; border:1px solid #ccc; padding:10px;">
        <div style="background-color:white; width:100%;" id="Panel3" class="roundedPanel">
            <div style="padding-left: 6px; padding-right: 6px;">
                <div style="background-color:white; width:100%;" id="Panel1" class="roundedPanel">
                    <table class="table table-bordered table-condensed table-striped table-responsive" style="border-color: #CCDCE0; border-width: 1px; border-style: solid; margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;"
                           cellpadding="0"
                           cellspacing="0" width="100%">
                        <thead>
                            <tr class="HeaderStyle123">
                                <td colspan="4">
                                    My Detail's
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr id="tr_1" runat="server" class="row1" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    Name :-
                                </td>
                                <td class="smalltext" style="width: 30%; color: #6299c5; vertical-align: top; text-align: left;">
                                    <label id="lbl_assname" class="lblcss">@Model.EmpDtlsViewModel?.lbl_assname</label>[<label id="lbl_assecode" class="lblcss">@Model.EmpDtlsViewModel?.lbl_assecode</label>]
                                </td>
                                <td style="width: 20%; text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    Joining Date :-
                                </td>
                                <td class="smalltext" style="width: 25%; color: #6299c5; vertical-align: top; text-align: left;">
                                    <label id="lbl_joindate" class="lblcss">@Model.EmpDtlsViewModel?.lbl_joindate</label>
                                </td>
                            </tr>
                            <tr class="row2" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    Designation :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    <label id="lbl_desg" class="lblcss">@Model.EmpDtlsViewModel?.lbl_desg</label>
                                </td>
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    Func. Designation :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    <label id="lbl_fundesg" class="lblcss">@Model.EmpDtlsViewModel?.lbl_fundesg</label>
                                </td>
                            </tr>
                            <tr class="row1" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    Operation :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    <label id="lbl_op" class="lblcss">@Model.EmpDtlsViewModel?.lbl_op</label>
                                </td>
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    Division :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    <label id="lbl_div" class="lblcss">@Model.EmpDtlsViewModel?.lbl_div</label>
                                </td>
                            </tr>
                            <tr class="row2" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    Department :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    <label id="lbl_dept" class="lblcss">@Model.EmpDtlsViewModel?.lbl_dept</label>
                                </td>
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    Section :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    <label id="lbl_sec" class="lblcss">@Model.EmpDtlsViewModel?.lbl_sec</label>
                                </td>
                            </tr>
                            <tr class="row1" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    Site :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;" colspan="3">
                                    <label id="lbl_site" class="lblcss">@Model.EmpDtlsViewModel?.lbl_site</label>
                                </td>

                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-bordered table-condensed table-striped table-responsive" style="border-color: #CCDCE0; border-width: 1px; border-style: solid; margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;"
                           cellpadding="0"
                           cellspacing="0" width="100%">
                        <thead>
                            <tr class="HeaderStyle123">
                                <td colspan="4">
                                    Resignation Details
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="row2" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    Subject :-<span class="mandatory">*</span>
                                </td>
                                <td colspan="3" style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                                    <input type="text" id="txt_subject" name="txt_subject"
                                           class="form-control"
                                           style="max-width:530px; height:25px; border-color:#888888;font-weight:bold;"
                                           maxlength="200" 
                                           value="@Model.ResignationDataViewModel?.txt_subject" />
                                </td>
                            </tr>
                            <tr class="row1" style="line-height: 25px;font-weight:bold;">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    Body :-<span class="mandatory">*</span>
                                </td>
                                <td colspan="3" style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                                    <textarea id="txt_body" name="txt_body"
                                              class="form-control"
                                              style="max-width:530px; height:60px; border-color:#888888;font-weight:bold;"
                                              onkeypress="return (this.value.length < 500);"
                                              onpaste="return false">@Model.ResignationDataViewModel?.txt_body</textarea>
                                </td>
                            </tr>
                            <tr class="row2" style="line-height: 25px;font-weight:bold;">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    Latest Address(With Tel.No/Mobile No)<br />
                                    for payment of full and final amount:-<span class="mandatory">*</span>
                                </td>
                                <td colspan="3" style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                                    <textarea id="txt_latestaddress" name="txt_latestaddress"
                                              class="form-control"
                                              style="max-width:530px; height:60px; border-color:#888888;font-weight:bold;"
                                              onkeypress="return (this.value.length < 500);"
                                              onpaste="return false">@Model.ResignationDataViewModel?.txt_latestaddress</textarea>
                                </td>
                            </tr>
                            <tr class="row1" style="line-height: 25px;font-weight:bold;">
                                <td style="width: 33%; text-align: right; vertical-align: top;" class="font12">
                                    Relieving Date :-<span class="mandatory">*</span>
                                </td>
                                <td colspan="3" class="smalltext" style="width: 30%; color: #6299c5; vertical-align: top; text-align: left;">
                                    @Html.DropDownListFor(m => m.ResignationDataViewModel.SelectedOptDay, Model.DateSelectionViewModel.Days,
                                             new { @id = "optDay", @class = "swiftselect", style = "font-size:8pt;font-weight:bold;", onchange = "return cclick()" })

                                    @Html.DropDownListFor(m => m.ResignationDataViewModel.SelectedOptMonth, Model.DateSelectionViewModel.Months,
                                             new { @id = "optMonth", @class = "swiftselect", style = "font-size:8pt;font-weight:bold;", onchange = "return cclick()" })

                                    @Html.DropDownListFor(m => m.ResignationDataViewModel.SelectedOptYear, Model.DateSelectionViewModel.Years,
                                             new { @id = "optYear", @class = "swiftselect", style = "font-size:8pt;font-weight:bold;", onchange = "return cclick()" })
                                </td>
                            </tr>
                            <tr class="row2">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    Approving Authority :-<span class="mandatory">*</span>
                                </td>
                                <td colspan="3" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    <label id="lbl_appauth" class="swifttext" Style="width: 250px; margin-left: 4px!Important; background-color: #F6F8FA; color: Gray; padding: 0px 0px!Important;">@Model.APPAUTHDetailsViewModel?.lbl_appauth</label>
                                    <input type="hidden" id="hdauthlevel" name="hdauthlevel" value="@Model.APPAUTHDetailsViewModel?.hdauthlevel" />
                                    <input type="hidden" id="hdauthcode" name="hdauthcode" value="@Model.APPAUTHDetailsViewModel?.hdauthcode" />
                                    <input type="hidden" id="hdauthemailid" name="hdauthemailid" />
                                    <input type="hidden" id="hdauthname" name="hdauthname" />
                                </td>
                            </tr>

                    </table>

                    <table class="table table-bordered table-condensed table-striped table-responsive">
                        <tr class="HeaderStyle123">
                            <td colspan="4">
                                Oath of Secrecy
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4" style="font-size:12px;font-weight:bold;">
                                <ul style="margin-left: 21px; line-height: 19px; color:darkslateblue; font-size: 1em; list-style-image: url('../../images/arrow_n.gif');">
                                    <li>
                                        I hereby affirm that I have returned all confidential and other documents & material,
                                        which were in my possession to the company.
                                    </li>
                                    <li>
                                        I further undertake & promise to keep all information relating to HMSI business
                                        operations, projects, plans etc. secret and will not disclose the same to any third
                                        party at any point of time in future.
                                    </li>
                                </ul>
                                <input type="checkbox" id="cb_agree" checked="checked" name="cb_agree" style="margin-left:20px; font-weight:bold;" />
                                <label for="cb_agree">&nbsp; I agree to above mentioned terms and conditions.</label>
                            </td>
                        </tr>
                        <tr class="row1">
                            <td class="buttonwrapper" align="center" colspan="4">
                                <button type="button" id="cmdSubmit" style="font-weight:bold;" class="yellowbuttonbig">Submit</button>
                                &nbsp;
                                <a style="text-align: center;width:100px;display: inline-block;font-weight:bold;" href="@Url.Action("MyResignationRequest", "Separation")"
                                   class="yellowbuttonbig">Cancel</a>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <br />
</div>

<div class="clear"></div>
<table cellspacing="0" cellpadding="0" style="margin-left: 7px;" width="99%" border="0"
       class="backrow_grey">
    <tbody>
        <tr>
            <td style="height:24px; width:20px; padding-left:2px;" valign="middle" align="right">
                <a title="Back" href="@Url.Action("MyResignationRequest", "Separation")">
                    <img src="../../images/icon_back.gif" height="16" width="16" alt="Back" />
                </a>
            </td>
            <td style="height:24px; padding-left:4px;font-size:14px;" align="left">
                <a title="Back" href="@Url.Action("MyResignationRequest", "Separation")">Back</a>
            </td>
        </tr>
    </tbody>
</table>
<br />
<div class="clear"></div>

@section Scripts {
 <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
     $(document).ready(function () {
        //DATE VALIDATION
        function cclick() {
                var month = document.getElementById("optMonth").value;
                var day = document.getElementById("optDay").value;
                var year = document.getElementById("optYear").value;

                // February check
                if (month == 2) {
                    if (day > 28) {
                        if (day == 29 && (year == 2008 || year == 2012 || year == 2016 || year == 2020 || year == 2024 || year == 2028)) {
                            // valid leap year date
                        } else {
                            document.getElementById("errorpanel").style.display = "inline";
                            document.getElementById("status").innerHTML = "Invalid date! please select valid date.";
                            document.getElementById("optDay").value = 28; // reset to 28
                        }
                    }
                }

                // April, June, September, November check
                if (month == 4 || month == 6 || month == 9 || month == 11) {
                    if (day > 30) {
                        document.getElementById("errorpanel").style.display = "inline";
                        document.getElementById("status").innerHTML = "Invalid date! please select valid date.";
                        document.getElementById("optDay").value = 30; // reset to 30
                    }
                }
            }
        $("#cmdSubmit").click(function () {
                var data = {
                    SelectedDay: $("#optDay").val(),
                    SelectedMonth: $("#optMonth").val(),
                    SelectedMonthText: $("#optMonth option:selected").text(),
                    SelectedYear: $("#optYear").val(),
                    Subject: $("#txt_subject").val(),
                    Body: $("#txt_body").val(),
                    hdauthcode: $("#hdauthcode").val(),
                    AgreeTerms: $("#cb_agree").is(":checked"),
                    ResigID: $("#hdn_ResigID").val(),
                    latestaddress: $("#txt_latestaddress").val(),
                };

                $.ajax({
                    url: '@Url.Action("SubmitEditAssociateResignationForm", "Separation")',
                    type: 'POST',
                    data: data,
                    success: function (response) {
                        if (response.success) {
                            window.location.href = response.redirectUrl;
                        } else {
                            if (response.showErrorPanel === true) {
                                $("#errorpanel").show();
                            }
                            else if (response.showErrorPanel === false) {
                                $("#errorpanel").hide();
                            }
                            $("#status").text(response.message);
                            if (response.focusId) {
                                $("#" + response.focusId).focus();
                            }
                        }
                    },
                    error: function () {
                        alert("An error occurred while submitting.");
                    }
                });
            });
     });
  
 </script>
}
