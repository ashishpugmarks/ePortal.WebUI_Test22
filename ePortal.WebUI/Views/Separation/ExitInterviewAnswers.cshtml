@model ePortal.ViewModels.APPX.Separation.ExitInterviewAnswersModel

@{
    ViewBag.Title = "ExitInterviewAnswers";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}

@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table, td, tr, th {
            border: none;
        }

        textarea {
