            background-image: url("../../images/ItemBackgroundSelected.gif");
            font-size: 0.9em;
        }

        .nextbottom {
            padding: 5px;
            text-align: center;
            margin-top: 10px;
            border-top: 1px solid gray;
        }

        .exitint_menu #Master_InnerContent_menu_exitinterview a:hover {
            cursor: pointer;
            padding: 7px 33px 6px 14px;
            line-height: 32px;
            background-color: rgb(208, 212, 212);
            color: rgb(0, 0, 0);
            text-decoration: none;
            background-image: url("../../images/ItemBackgroundHover.gif");
            font-size: 0.9em;
        }

        .exitint_menu .menucurrents {
            cursor: pointer;
            padding: 7px 33px 6px 14px;
            line-height: 32px;
            background-color: rgb(208, 212, 212);
            color: rgb(0, 0, 0);
            text-decoration: none;
            background-image: url("../../images/ItemBackgroundHover.gif");
