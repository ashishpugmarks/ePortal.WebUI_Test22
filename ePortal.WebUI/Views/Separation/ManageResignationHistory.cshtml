@section Scripts {
    <script src="../js/jquery.dataTables.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        $(document).ready(function () {
            initializeTables();
            $('.historyLink').on('click', function (e) {
                e.preventDefault();
                var resignId = $(this).data('resignid');
                var ecode = $(this).data('ecode');
                var histype = $(this).data('histype');
                var url = '@Url.Action("ViewHistory", "Separation")'
                          + '?History=' + histype + '&ResignID=' + resignId + '&ECODE=' + ecode;
                openDialog(url, 810, 420);
            });

             $('.deactivateLink').on('click', function (e) {
                e.preventDefault();
                var resignid = $(this).data('resigid');
                var ecode = $(this).data('empcode');
                var statusid = $(this).data('status');
                var stgid = $(this).data('stg');

                // var targetUrl = "/admin/separate/IRClearanceDeactivation.aspx"
                // + "?empcode=" + encodeURIComponent(ecode)
                // + "&ResigID=" + encodeURIComponent(resignId)
                // + "&Status=" + encodeURIComponent(status)
                // + "&Stg=" + encodeURIComponent(Stg);

                //var url = "/TokenBridge/RedirectToOldApp?target=" + encodeURIComponent(targetUrl);

                var url = '@Url.Action("IRClearanceDeactivation", "Separation")'
                          + '?empcode=' + ecode + '&ResigID=' + resignid + '&Status=' + statusid + '&Stg=' + stgid;
                openDialog(url, 810, 420);
            });
        });
        function initializeTables() {
                var $resignapp = $('#grdresignapp');
                if ($.fn.DataTable.isDataTable($resignapp)) $resignapp.DataTable().destroy();
                $resignapp.DataTable({ pageLength: 20, lengthChange: false, bFilter: false });

                var $pendclrform = $('#grdpendclrform');
                if ($.fn.DataTable.isDataTable($pendclrform)) $pendclrform.DataTable().destroy();
                $pendclrform.DataTable({ pageLength: 20, lengthChange: false, bFilter: false });

                var $manageclrheader = $('#grdmanageclrheader');
                if ($.fn.DataTable.isDataTable($manageclrheader)) $manageclrheader.DataTable().destroy();
                $manageclrheader.DataTable({ pageLength: 20, lengthChange: false, bFilter: false });

                var $deptclrform = $('#grddeptclrform');
                if ($.fn.DataTable.isDataTable($deptclrform)) $deptclrform.DataTable().destroy();
                $deptclrform.DataTable({ pageLength: 20, lengthChange: false, bFilter: false });

        }

         function openDialog(strOpenUrl, width, height) {
                openPopupwithScrol(strOpenUrl, width, height);
            }
         function openPopupwithScrol(strOpenUrl, width, height) {
                var winTop = (screen.height - height) / 2;
                var winLeft = (screen.width - width) / 2;
                var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
                windowFeatures = windowFeatures + ",left = " + winLeft + ",";
                windowFeatures = windowFeatures + "top=" + winTop + ",resizable" + ",scrollbars";
                window.open(strOpenUrl, "mywindow", windowFeatures);
            }
             
    </script>

}