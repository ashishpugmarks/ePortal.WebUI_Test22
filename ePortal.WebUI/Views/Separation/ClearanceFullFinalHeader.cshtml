@model ePortal.ViewModels.APPX.Separation.ClearanceFullFinalHeaderModel
@{
    ViewBag.Title = "ClearanceFullFinalHeader";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";   
}

@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .Head_1 {
        background-color: #2D5094;
        line-height: 25px;
        text-align: center;
        font-weight: bold;
        color: White;
        }

        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
        line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
        font-size: 11px;
        border-collapse: collapse;
        color: #000000;
        font-family: Verdana, Tahoma;
        }

        .tableMainInner tr td {
        border: solid 1px #CCDCE0;
        padding: 0;
        }

        .tableMainInner tr td.heading {
        text-align: right;
        }

        .oneRow {
        white-space: nowrap;
        padding: 0 2px 0 2px;
        }

        .tableGridView {
        border-collapse: collapse;
        }

        .tableGridView tr th, .tableGridView tr td {
        border: 1px solid Silver;
        line-height: 24px;
        font-family: Verdana, Arial, Helvetica;
        font-size: 11px;
        }

        .tableGridView tr th {
        background: url(../../images/bg_header.jpg) #cae8ea no-repeat;
        }

        .HeaderStyle12 {
        border: 0px solid #C1C4C8;
        border-bottom: none;
        }

        .lblcss {
        color: #6299C5 !important;
        }

        .subheaderstyle {
        padding: 2px 2px 2px 5px;
        font-size: 12px;
        background-color: #DBDBDB;
        line-height: 21px;
        font-weight: bold;
        width: 748px;
        border: 1px solid #C0C0C0;
        border-bottom: none;
        }


        #grid_headerdetails {
        border-collapse: collapse; 
        width: 100%;
        }

        #grid_headerdetails th,
        #grid_headerdetails td {
        border: 1px solid #ccc; 
        padding: 8px; 
        font-size: 12px; 
        }

        #grid_headerdetails tbody tr:nth-child(odd) {
        background-color: #EBF5F5;
        }

        #grid_headerdetails tbody tr:nth-child(even) {
        background-color: #f9f9f9;
        }

    </style>
}
<div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
    <div style="height: 8px;"></div>
    <span style="padding-left: 20px;">Clearance Approval Form </span>
</div>
<table class="table table-responsive">
    <tr>
        <td>
            <div id="errorpanel" style="width:100%; display:none;">
                <table class="table table-bordered table-condensed table-striped table-responsive">
                    <tr id="tr_ErrorRow">
                        <td style="padding-top: 5px; padding-bottom: 2px; padding-left: 2px; padding-right: 2px;">
                            <div id="pnlErrorHeader" style="background-color:#ED243B; width:100%;" class="roundedPanel">
                                <div style="padding-left: 6px;">
                                    <div style="background-color:#ffeaea; width:99%;" id="pnlError" class="roundedPanel">
                                        <table class="table table-bordered table-condensed table-striped table-responsive">
                                            <tr>
                                                <td style="padding: 2px; padding-left: 5px; color: Black;">
                                                    @Html.TextBox("txtup", null, new { style = "width:0px; border:none;" })
                                                    <label id="status" style="font-size:13px; font-family:'Trebuchet MS';"></label>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </td>
    </tr>
</table>
<div id="divToPrint">
    <div style="padding: 5px;">
        <div style="background-color:white; width:100%;border:1px solid #ccc; border-radius:6px; padding:10px;" id="Panel3" class="roundedPanel">
            <div style="padding-left: 6px; padding-right: 6px;">
                <div style="background-color:white; width:100%;" BackColor="white" id="Panel1" class="roundedPanel">
                    <table class="table table-bordered table-condensed table-striped table-responsive" width="100%" style="padding: 2px 1px 2px 1px; border-collapse: collapse; border-color: Silver; font-size: 11px; font-family: Verdana;"
                    border="1" cellspacing="0"
                    cellpadding="0">
                        <thead>
                            <tr class="HeaderStyle123">
                                <td colspan="4">
                                    <b>&nbsp;&nbsp;Associate's Detail</b>
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="row1" style="line-height: 20px;">
                                <td style="text-align: right; vertical-align: top; width: 20%;font-weight:bold;" class="font12">
                                    &nbsp;Name :-
                                </td>
                                <td class="smalltext" style="width: 30%; color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_assname" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_assname</label>&nbsp;[<label id="lbl_assecode" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_assecode</label>
                                    ]
                                </td>
                                <td style="width: 20%; text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    &nbsp;Joining Date :-
                                </td>
                                <td class="smalltext" style="width: 25%; color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_joindate" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_joindate</label>
                                </td>
                            </tr>
                            <tr class="row2" style="line-height: 20px;">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    &nbsp;Designation :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_desg" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_desg</label>
                                </td>
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    &nbsp;Func. Designation :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_fundesg" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_fundesg</label>
                                </td>
                            </tr>
                            <tr class="row1">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    <span class="smalltext">Mobile Number :-</span>
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_phone" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_phone</label>
                                </td>
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    Email Id :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_emailid" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_emailid</label>
                                </td>
                            </tr>
                            <tr class="row2" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    &nbsp;Operation :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_op" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_op</label>
                                </td>
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    &nbsp;Division :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_div" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_div</label>
                                </td>
                            </tr>
                            <tr class="row1" style="line-height: 25px;font-weight:bold;">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    &nbsp;Department :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_dept" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_dept</label>
                                </td>
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    &nbsp;Section :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_sec" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_sec</label>
                                </td>
                            </tr>
                            <tr class="row2" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    &nbsp;Site :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_site" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_site</label>
                                </td>
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    &nbsp;Resignation Date :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_applydate" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_applydate</label>
                                </td>
                            </tr>
                            <tr class="row1">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    &nbsp;Relieving Date (Associate) :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_reldate"  class="lblcss"></label>
                                </td>
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    &nbsp;Final Relieving Date :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;<label id="lbl_deptreldate" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_deptreldate</label>
                                </td>
                            </tr>
                            <tr class="row2" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    &nbsp;Subject :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                                colspan="3">
                                    &nbsp;<label id="lbl_subject" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_subject</label>
                                </td>
                            </tr>
                            <tr class="row1" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                    &nbsp;Body :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                                colspan="3">
                                    &nbsp;<label id="lbl_reason" class="lblcss">@Model.ClrFullFinalHeaderEmpDtlsViewModel?.lbl_reason</label>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <br />
                    @foreach (var header in Model.ClrFullFinalHeaderViewModel)
                    {           
                        bool showSubmitButton = header.SubHeaderDetails.Any() && header.SubHeaderDetails.All(s => (s.STATUS ?? "").Trim() == "1");

                        <div class="panel" style="border:1px solid #ccc; background-color:#fff;">
                            <div class="panel-header HeaderStyle123"
                            style="height:30px; display:flex; align-items:center; padding-left:10px; background-color:#D3E3F2; font-weight:bold;">
                                &nbsp;&nbsp;Clearance Form Detail
                            </div>
                            <div class="panel-body" style="padding:10px;">
                                <div style="background-color:#D3E3F2;">
                                    <div style="padding: 2px 2px 2px 5px;color:black;">
                                        <div class="subheaderstyle" style="background-color:#DBDBDB;height:22pt;">
                                            <strong>@header.DESCRIPTION</strong>
                                        </div>

                                        <input id="hd_detailhdid" type="hidden" value="@header.CLEAHEADRDETAILID" />

                                        <table id="grid_headerdetails" style="font-size:12px;" class="table table-bordered table-condensed table-striped table-responsive" width="98%">
                                            <thead>
                                                <tr>
                                                    <th style ="background-color:#CAE8EA;">Description</th>
                                                    <th style="background-color:#CAE8EA;">Amount</th>
                                                    <th style="background: linear-gradient(to right, #CAE8EA 50%, white 50%);">Remarks</th>
                                                    <th style="background-color:white;">Submit By</th>
                                                    <th style="background-color:white;">Submit Date</th>
                                                    <th style="background-color:white;">Status</th>
                                                    <th style="background-color:white;">Attachment</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (header.SubHeaderDetails != null && header.SubHeaderDetails.Any())
                                                {
                                                    foreach (var sub in header.SubHeaderDetails)
                                                    {
                                                        <tr>
                                                            <td><b>@sub.DESCRIPTION</b></td>
                                                            <td>@sub.Amount</td>
                                                            <td>@sub.REMARKS</td>
                                                            <td>@sub.SUBMITBY</td>
                                                            <td>@sub.SUBMITTEDATE</td>
                                                            <td>
                                                                @if (sub.STATUS == "0")
                                                                {
                                                                    <span style="color:red">Pending</span>
                                                                }
                                                                else
                                                                {
                                                                    <span style="color:green">Completed</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(sub.ATTACHDOCUMENT))
                                                                {
                                                                    <a href="@Url.Content("../../Uploads/Separation/" + sub.ATTACHDOCUMENT)" target="_blank">
                                                                        <img alt="Doc" width="15" src="~/Images/icon_document.gif" />
                                                                    </a>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="7" style="color:red; font-weight:bold;">No Approval Found</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <table id="tblheader" border="1" cellpadding="0" cellspacing="0" width="100%"
                                    style="background-color: White; border-collapse: collapse; margin-top: 3px;">
                                        <tr>
                                            <td width="100px" align="right" valign="top">
                                                <b style="font-family: Verdana; font-size: 11px;color: black;">Remarks:-</b>
                                            </td>
                                            <td>
                                                <textarea id="tb_remarks" style="margin-left: 5px; margin-right: 5px;font-size:12px;font-weight:bold;color: black;"
                                                rows="3" cols="60"
                                                @(header.status == "0" ? "" : "disabled")>@header.remarks?.Trim()</textarea>
                                            </td>
                                            <td align="center">                                               
                                                @if (showSubmitButton)
                                                    {
                                                    <button type="button" id="cmdSubmit" class="bluebutton">Submit</button>
                                                    }          
                                    </td>
                                   </tr>
                                  </table>
                              </div>
                            </div>
                        </div>
                        <br />
                    }
                  
                </div>
            </div>
        </div>
        <br />
    </div>
</div>
<center style="background-color: White;">
    <input id="printbtn"  type="button" class="bluebutton" value="Print"/>
</center>
<br />
<table cellspacing="0" cellpadding="0" style="margin-left: 7px;" width="99%" border="0"
       class="backrow_grey">
    <tbody>
        <tr>
            <td style="height:24px; width:20px; padding-left:2px;" valign="middle" align="right">
                <a title="Back" href="@Url.Action("ManageResignationRequest", "Separation")">
                    <img src="../../images/icon_back.gif" height="16" width="16" alt="Back" />
                </a>
            </td>
            <td style="height:24px; padding-left:4px;font-size:14px;" align="left">
                <a title="Back" href="@Url.Action("ManageResignationRequest", "Separation")">Back</a>
            </td>
        </tr>
    </tbody>
</table>
<br />
<div class="clear">
</div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        $(document).ready(function () {
            function ShowHideTestCases() {
                var link = document.getElementById('linkTestCases');
                var s = document.getElementById("divTestCases");
                if (s.style.display == 'block') {
                    s.style.display = 'none';
                    link.innerHTML = 'Show';
                }
                else {
                    s.style.display = 'block';
                    link.innerHTML = 'Hide';
                }
            }

            $("#printbtn").click(function () {
                var e = document.getElementById("divToPrint"); e.getElementsByTagName("table").display = "none";
                var t = window.open("", "_blank", "scrollbars=1,center=yes,resizable=no,STATUS=no,Width=850px,Height=550px,top=110px,left=260px"); t.document.open(); t.document.write("<html><body onload='window.print()'>" + e.innerHTML + "</html>");
                var n = t.document.getElementById("Master_InnerContent_grid_headerdetails_ctl02_tblheader");
                if (t.document.getElementById("Master_InnerContent_grid_headerdetails_ctl02_tblheader") != "undefined") { t.document.getElementById("Master_InnerContent_grid_headerdetails_ctl02_tblheader").style.display = "none" }
                if (t.document.getElementById("Master_InnerContent_grid_headerdetails_ctl03_tblheader") != "undefined") { t.document.getElementById("Master_InnerContent_grid_headerdetails_ctl03_tblheader").style.display = "none" } t.document.close()
            });

            $("#cmdSubmit").click(function () {
                var data = {
                    detailId: $("#hd_detailhdid").val(),
                    remarks: $("#tb_remarks").val()
                };

                $.ajax({
                    url: '@Url.Action("SubmitClrFullFinalHeader", "Separation")',
                    type: 'POST',
                    data: data,
                    success: function (response) {
                        if (response.success) {
                            $("#tb_remarks").prop("disabled", true);
                            $("#cmdSubmit").hide();
                            sweetAlert("", response.message, "success");
                        } else {
                            sweetAlert("", response.message, "error");
                            // if (response.showErrorPanel === true) {
                            //     $("#errorpanel").show();
                            // }
                            // else if (response.showErrorPanel === false) {
                            //     $("#errorpanel").hide();
                            // }
                            // if (response.focusId) {
                            //     $("#" + response.focusId).focus();
                            // }
                        }
                    },
                    error: function (xhr) {
                        alert("An error occurred while submitting.");
                    }
                });
            });
        });

    </script>
}


