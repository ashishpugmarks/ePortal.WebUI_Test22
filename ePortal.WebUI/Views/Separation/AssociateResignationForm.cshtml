@model ePortal.ViewModels.APPX.Separation.AssociateResignationFormModel
@{
    ViewBag.Title = "AssociateResignationForm";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .fnt {
            font-family: Arial !important;
        }

        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
            line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
            font-size: 11px;
            border-collapse: collapse;
            color: #000000;
            font-family: Verdana, Tahoma;
        }

            .tableMainInner tr td {
                border: solid 1px #CCDCE0;
                padding: 0;
            }

                .tableMainInner tr td.heading {
                    text-align: right;
                }

        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
        }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                line-height: 24px;
                font-family: Verdana, Arial, Helvetica;
                font-size: 11px;
            }

            .tableGridView tr th {
                background: url(../../assets/images/bg_header.jpg) #cae8ea no-repeat;
            }
    </style>
}

<div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
    <div style="height: 8px;"></div>
    <span style="padding-left: 20px;">Resignation Form </span>
</div>
<table cellspacing="0" cellpadding="1" width="100%" border="0">
    <tr>
        <td>
            <div id="errorpanel" style="width:100%; display:none;">
                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr id="tr_ErrorRow" >
                        <td style="padding-top: 5px; padding-bottom: 2px; padding-left: 2px; padding-right: 2px;">
                            <div id="pnlErrorHeader" style="background-color:#ED243B; width:100%;" class="roundedPanel">
                                <div style="padding-left: 6px;">
                                    <div id="pnlError" style="background-color:#ffeaea; width:99%;" class="roundedPanel">
                                        <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                            <tr>
                                                <td style="padding: 2px; padding-left: 5px; color: Black;">
                                                    @* Hidden textbox (if needed) *@
                                                    @Html.TextBox("txtup", null, new { style = "width:0px; border:none;" })

                                                    @* Status label *@
                                                    <span id="status" style="font-size:13px; font-family:'Trebuchet MS';">
                                                        @ViewBag.Status
                                                    </span>

                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </td>
    </tr>
</table>
<div class="headmain">
    <div style="padding-left: 6px; padding-right: 6px; text-align: center">
        <table class="table table-responsive  table-bordered table-condensed table-striped" style="border-color: #CCDCE0; border-width: 1px; border-style: solid; margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;"
               cellpadding="0"
               cellspacing="0" width="100%">

            <tr class="HeaderStyle123">
                <td colspan="4">
                    My Detail&#39;s
                </td>
            </tr>
            <tr id="tr_1"  style="line-height: 25px;">
                <td style="text-align: right; vertical-align: top;" class="font12">
                    Name :-
                </td>
                <td class="smalltext" style="width: 30%; color: #6299c5; vertical-align: top; text-align: left;">
                    <label ID="lbl_assname" class="lblcss">@Model.AssRegFromEmpDtlsViewModel?.lbl_assname</label>
                    [
                    <label ID="lbl_assecode" class="lblcss">@Model.AssRegFromEmpDtlsViewModel?.lbl_assecode</label>
                    ]
                </td>
                <td style="width: 20%; text-align: right; vertical-align: top;" class="font12">
                    Joining Date :-
                </td>
                <td class="smalltext" style="width: 25%; color: #6299c5; vertical-align: top; text-align: left;">
                    <label ID="lbl_joindate" class="lblcss">@Model.AssRegFromEmpDtlsViewModel?.lbl_joindate</label>
                </td>
            </tr>
            <tr style="line-height: 25px;">
                <td style="text-align: right; vertical-align: top;" class="font12">
                    Designation :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                    <label ID="lbl_desg" class="lblcss">@Model.AssRegFromEmpDtlsViewModel?.lbl_desg</label>
                </td>
                <td style="text-align: right; vertical-align: top;" class="font12">
                    Func. Designation :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                    <label ID="lbl_fundesg" class="lblcss">@Model.AssRegFromEmpDtlsViewModel?.lbl_fundesg</label>
                </td>
            </tr>
            <tr style="line-height: 25px;">
                <td style="text-align: right; vertical-align: top;" class="font12">
                    Operation :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                    <label ID="lbl_op" class="lblcss">@Model.AssRegFromEmpDtlsViewModel?.lbl_op</label>
                </td>
                <td style="text-align: right; vertical-align: top;" class="font12">
                    Division :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                    <label ID="lbl_div" class="lblcss">@Model.AssRegFromEmpDtlsViewModel?.lbl_div</label>
                </td>
            </tr>
            <tr style="line-height: 25px;">
                <td style="text-align: right; vertical-align: top;" class="font12">
                    Department :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                    <label ID="lbl_dept" class="lblcss">@Model.AssRegFromEmpDtlsViewModel?.lbl_dept</label>
                </td>
                <td style="text-align: right; vertical-align: top;" class="font12">
                    Section :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                    <label ID="lbl_sec" class="lblcss">@Model.AssRegFromEmpDtlsViewModel?.lbl_sec</label>
                </td>
            </tr>
            <tr style="line-height: 25px;">
                <td style="text-align: right; vertical-align: top;" class="font12">
                    Site :-
                </td>
                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;" colspan="3">
                    <label ID="lbl_site" class="lblcss">@Model.AssRegFromEmpDtlsViewModel?.lbl_site</label>
                </td>

            </tr>

        </table>
        <table class="table table-responsive table-bordered table-condensed table-striped"
               style="border-color: #CCDCE0; border-width: 1px; border-style: solid; margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;"
               width="100%">
            <tbody>
                <tr>
                    <td class="HeaderStyle123" colspan="2">
                        Resignation Detail&#39;s
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top; width: 25%;" class="font12">
                        Subject :-<span class="mandatory">*</span>
                    </td>
                    <td style="color: #6299c5; vertical-align: top; text-align: left;">
                        <input type="text" id="txt_subject" name="txt_subject"
                               class="form-control"
                               style="max-width:530px; height:25px; border-color:#888888;font-weight:bold;"
                               maxlength="200"
                               value="@Model.AssRegFromResignationDataViewModel?.txt_subject" />
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        Body :-<span class="mandatory">*</span>
                    </td>
                    <td style="color: #6299c5; vertical-align: top; text-align: left;">
                        <textarea id="txt_body" name="txt_body"
                                  class="form-control"
                                  style="max-width:530px; height:60px; border-color:#888888;font-weight:bold;"
                                  onkeypress="return (this.value.length < 500);"
                                  onpaste="return false">@Model.AssRegFromResignationDataViewModel?.txt_body</textarea>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        Latest Address(With Tel.No/Mobile No)<br />
                        for payment of full and final amount:-<span class="mandatory">*</span>
                    </td>
                    <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                        <textarea id="txt_latestaddress" name="txt_latestaddress"
                                  class="form-control"
                                  style="max-width:530px; height:60px; border-color:#888888;font-weight:bold;"
                                  onkeypress="return (this.value.length < 500);"
                                  onpaste="return false">@Model.AssRegFromResignationDataViewModel?.txt_latestaddress</textarea>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        Relieving Date :-<span class="mandatory">*</span>
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        @Html.DropDownListFor(m => m.AssRegFromResignationDataViewModel.SelectedOptDay, Model.AssRegFromDateSelectionViewModel.Days,
                                 new { @id = "optDay", @class = "swiftselect", style = "font-size:8pt;font-weight:bold;", onchange = "return cclick()" })

                        @Html.DropDownListFor(m => m.AssRegFromResignationDataViewModel.SelectedOptMonth, Model.AssRegFromDateSelectionViewModel.Months,
                                 new { @id = "optMonth", @class = "swiftselect", style = "font-size:8pt;font-weight:bold;", onchange = "return cclick()" })

                        @Html.DropDownListFor(m => m.AssRegFromResignationDataViewModel.SelectedOptYear, Model.AssRegFromDateSelectionViewModel.Years,
                                 new { @id = "optYear", @class = "swiftselect", style = "font-size:8pt;font-weight:bold;", onchange = "return cclick()" })
                    </td>
                </tr>
                <tr>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        Approving Authority :-<span class="mandatory">*</span>
                    </td>
                    <td style="color: #6299c5; vertical-align: top; text-align: left;">
                        <label id="lbl_appauth" class="swifttext" Style="width: 250px; margin-left: 4px!Important; background-color: #F6F8FA; color: Gray; padding: 0px 0px!Important;">@Model.AssRegFromAPPAUTHDetailsViewModel?.lbl_appauth</label>
                        <input type="hidden" id="hdauthlevel" name="hdauthlevel" value="@Model.AssRegFromAPPAUTHDetailsViewModel?.hdauthlevel" />
                        <input type="hidden" id="hdauthcode" name="hdauthcode" value="@Model.AssRegFromAPPAUTHDetailsViewModel?.hdauthcode"/>
                        <input type="hidden" id="hdauthemailid" name="hdauthemailid" value="@Model.AssRegFromAPPAUTHDetailsViewModel?.hdauthemailid" />
                        <input type="hidden" id="hdauthname" name="hdauthname" value="@Model.AssRegFromAPPAUTHDetailsViewModel?.hdauthname" />
                    </td>
                </tr>
        </table>

        <table class="table table-responsive table-bordered table-condensed table-striped"
               style="border-color: #CCDCE0; border-width: 1px; border-style: solid; margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px; width: 100%;">
            <tr>
                <td class="HeaderStyle123" colspan="4">Oath of Secrecy</td>
            </tr>
            <tr style="background-color: #FFFDF1;">
                <td colspan="4" style="text-align: left;font-size:12px;font-weight:bold;">
                    <ul style="margin-left: 21px; line-height: 19px; font-size: 1em; list-style-image: url('../../assets/images/arrow_n.gif');">
                        <li>
                            I hereby affirm that I have returned all confidential and other documents &amp;
                            material, which were in my possession to the company.
                        </li>
                        <li>
                            I further undertake &amp; promise to keep all information relating to HMSI business
                            operations, projects, plans etc. secret and will not disclose the same to any
                            third party at any point of time in future.
                        </li>
                    </ul>
                    <input type="checkbox" id="cb_agree" name="cb_agree" style="margin-left:20px; font-weight:bold;" />
                    <label for="cb_agree">&nbsp; I agree to above mentioned terms and conditions.</label>
                </td>
            </tr>
            <tr>
                <td class="buttonwrapper" align="center" colspan="4">
                    <button type="button" id="cmdSubmit" class="yellowbuttonbig" >Submit</button>
                    &nbsp;
                    <a style="text-align: center;width:100px;display: inline-block;" href="@Url.Action("Home", "Home")"
                       class="yellowbuttonbig">Cancel</a>
                </td>
            </tr>

        </table>

    </div>

</div>
<table cellspacing="0" cellpadding="0" style="margin-left: 7px;" width="99%" border="0"
       class="backrow_grey">
    <tbody>
        <tr>
            <td style="height:24px; width:20px; padding-left:2px;" valign="middle" align="right">
                <a title="Back" href="@Url.Action("Home", "Home")">
                    <img src="../../images/icon_back.gif" height="16" width="16" alt="Back" />
                </a>
            </td>
            <td style="height:24px; padding-left:4px;font-size:14px;" align="left">
                <a title="Back" href="@Url.Action("Home", "Home")">Back</a>
            </td>
        </tr>
    </tbody>
</table>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">

      $(document).ready(function () {        
         $('#cmdSubmit').on('click', function () {
                     var data = {
                         SelectedDay: $("#optDay").val(),
                         SelectedMonth: $("#optMonth").val(),
                         SelectedMonthText: $("#optMonth option:selected").text(),
                         SelectedYear: $("#optYear").val(),
                         Subject: $("#txt_subject").val(),
                         Body: $("#txt_body").val(),
                         hdauthcode: $("#hdauthcode").val(),
                         hdauthlevel: $("#hdauthlevel").val(),
                         hdauthemailid: $("#hdauthemailid").val(),
                         AgreeTerms: $("#cb_agree").is(":checked"),
                         ResigID: $("#hdn_ResigID").val(),
                         latestaddress: $("#txt_latestaddress").val(),
                         lbl_appauth: $("#lbl_appauth").val(),
                         hdauthname: $("#hdauthname").val(),
                         lbl_assname: $("#lbl_assname").val(),
                         lbl_assecode: $("#lbl_assecode").val(),
                     };

                         $.ajax({
                         url: '@Url.Action("SubmitAssociateResignationForm", "Separation")',
                         type: 'POST',
                         data: data,
                         success: function (response) {
                             if (response.success) {
                                 window.location.href = response.redirectUrl;
                             } else {
                                 if (response.showErrorPanel === true) {
                                     $("#errorpanel").show();
                                 }
                                 else if (response.showErrorPanel === false) {
                                     $("#errorpanel").hide();
                                 }
                                 $("#status").text(response.message);
                                 if (response.focusId) {
                                     $("#" + response.focusId).focus();
                                 }
                             }
                         },
                         error: function () {
                             alert("An error occurred while submitting.");
                         }
                     });
          });

        //DATE VALIDATION
        function cclick() {
                 var month = document.getElementById("optMonth").value;
                 var day = document.getElementById("optDay").value;
                 var year = document.getElementById("optYear").value;

                 // February check
                 if (month == 2) {
                     if (day > 28) {
                         if (day == 29 && (year == 2008 || year == 2012 || year == 2016 || year == 2020 || year == 2024 || year == 2028)) {
                             // valid leap year date
                         } else {
                             document.getElementById("errorpanel").style.display = "inline";
                             document.getElementById("status").innerHTML = "Invalid date! please select valid date.";
                             document.getElementById("optDay").value = 28; // reset to 28
                         }
                     }
                 }

                 // April, June, September, November check
                 if (month == 4 || month == 6 || month == 9 || month == 11) {
                     if (day > 30) {
                         document.getElementById("errorpanel").style.display = "inline";
                         document.getElementById("status").innerHTML = "Invalid date! please select valid date.";
                         document.getElementById("optDay").value = 30; // reset to 30
                     }
                 }
             }
      });
    </script>
}

