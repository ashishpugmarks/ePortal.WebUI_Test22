@model ePortal.ViewModels.APPX.Separation.ClearanceFullFinalformModel
@{
    ViewBag.Title = "ClearanceFullFinalform";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
            line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
            font-size: 11px;
            border-collapse: collapse;
            color: #000000;
            font-family: Verdana, Tahoma;
        }

            .tableMainInner tr td {
                border: solid 1px #CCDCE0;
                padding: 0;
            }

                .tableMainInner tr td.heading {
                    text-align: right;
                }

        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
        }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                line-height: 24px;
                font-family: Verdana, Arial, Helvetica;
                font-size: 11px;
            }

            .tableGridView tr th {
                background: url(../images/bg_header.jpg) #cae8ea no-repeat;
            }

        .HeaderStyle12 {
            border: 1px solid #C1C4C8;
            border-bottom: none;
        }

        textarea {
            overflow: hidden;
        }

        .tcat {
            font-weight: bold;
            padding: 5px 0px 5px 0px;
        }

        #gridrescleardetails tbody tr:nth-child(odd) {
            background-color: #e6f2ff;
        }

        #gridrescleardetails tbody tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .no-interaction {
            pointer-events: none;
            background-color: #e9ecef; /* Optional: gray out */
        }
    </style>
}
<div style="height: 2.2em; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
    <div style="height: 8px;"></div>
    <span style="padding-left: 20px;">Clearance Full and Final Form  </span>
</div>
<table>
    <tr>
        <td>
            <div id="errorpanel" style="width:100%; display:none;">
                <table class="table table-bordered table-condensed table-striped table-responsive">
                    <tr id="tr_ErrorRow">
                        <td style="padding-top: 5px; padding-bottom: 2px; padding-left: 2px; padding-right: 2px;">
                            <div id="pnlErrorHeader" style="background-color:#ED243B; width:100%;" class="roundedPanel">
                                <div style="padding-left: 6px;">
                                    <div id="pnlError" style="background-color:#ffeaea; width:99%;" class="roundedPanel">
                                        <table class="table table-bordered table-condensed table-striped table-responsive">
                                            <tr>
                                                <td style="padding: 2px; padding-left: 5px; color: Black;">
                                                    <label id="status" style="font-size:13px; font-family:'Trebuchet MS';"></label>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>

            </div>
        </td>
    </tr>
</table>
<div style="padding: 0px;">
    <div style="padding-left: 6px; padding-right: 6px;padding-top:10px;">
        <div id="Panel1" style="background-color:white; width:100%;" class="roundedPanel">
            <form id="clearanceForm">
            <table class="table table-bordered table-condensed table-striped table-responsive">
                <thead>
                    <tr class="HeaderStyle123">
                        <td colspan="4">
                            &nbsp;Associate Details
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <tr id="tr_1" runat="server" class="row1" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Name :-
                        </td>
                        <td class="smalltext" style="width: 30%; color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;<label id="lbl_assname" name="lbl_assname" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_assname</label>&nbsp;[<label id="lbl_assecode" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_assecode</label>]
                        </td>
                        <td style="width: 20%; text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Joining Date :-
                        </td>
                        <td class="smalltext" style="width: 25%; color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;<label ID="lbl_joindate" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_joindate</label>
                        </td>
                    </tr>
                    <tr class="row2" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Designation :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;<label id="lbl_desg" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_desg</label>
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Func. Designation :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;<label id="lbl_fundesg" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_fundesg</label>
                        </td>
                    </tr>
                    <tr class="row1">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            <span class="smalltext">Mobile Number :-</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;<label id="lbl_phone" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_phone</label>
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            Email Id :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label id="lbl_emailid" name="lbl_emailid" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_emailid</label>
                        </td>
                    </tr>

                    <tr class="row2" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Operation :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;<label id="lbl_op" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_op</label>
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Division :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;<label id="lbl_div" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_div</label>
                        </td>
                    </tr>
                    <tr class="row1" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Department :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;<label id="lbl_dept" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_dept</label>
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Section :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;<label id="lbl_sec" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_sec</label>
                        </td>
                    </tr>
                    <tr class="row2" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Site :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;<label id="lbl_site" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_site</label>
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Resignation  Date :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;<label id="lbl_applydate" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_applydate</label>
                        </td>

                    </tr>
                    <tr class="row1">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Relieving Date (Associate) :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;<label id="lbl_reldate" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_reldate</label>
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;Final Relieving Date :-</td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">&nbsp;<label id="lbl_deptreldate" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_deptreldate</label></td>
                    </tr>

                    <tr class="row2" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Basic Salary :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;" colspan="3">
                            &nbsp;<label id="lbl_basicsal" class="lblcss">@Model.ClearFullFinalEmpDtlsViewModel?.lbl_basicsal</label>
                        </td>

                    </tr>

                </tbody>

            </table>

            <table class="table table-bordered table-condensed table-striped table-responsive">
                <tr class="HeaderStyle123">
                    <td colspan="3">&nbsp;Clearance Details</td>
                </tr>
            </table>

            <div style="border: 1px solid #C0C0C0; border-top: none; text-align:center">
                <table id="gridrescleardetails" style="font-size:12px;" 
                       class="table table-bordered table-hover table-condensed table-striped table-responsive">
                    <thead>
                        <tr style="background-color:#4884D9; color:white;">
                            <th>Description</th>
                            <th>Amount (If any)</th>
                            <th>Remarks</th>
                            <th>Status</th>
                            <th>Attachment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.ClearanceDetailViewModel == null || !Model.ClearanceDetailViewModel.Any())
                        {
                            <tr>
                                <td colspan="5">No Detail Found.</td>
                            </tr>
                        }
                        else
                        {
                                for (int i = 0; i < Model.ClearanceDetailViewModel.Count; i++)
                                {
                                    var item = Model.ClearanceDetailViewModel[i];
                                    <tr style="text-align:left;">
                                    <td>
                                            <input type="hidden" name="model[@i].CLEARENCEHEADERID" value="@item.CLEARENCEHEADERID" />
                                        <label style="font-weight:bold; color:gray;">@item.DESCRIPTION</label>
                                    </td>
                                        <td>
                                            <input id="txt_amt" type="number" name="model[@i].AMOUNT" value="@item.AMOUNT"
                                                   maxlength="10" style="border-color:Gray;border-width:1px;border-style:solid;width:130px;font-weight:bold;color:black;"
                                                   data-ctrl="txt_amt"
                                                   @(item.STATUS == 1 ? "readonly" : "") />
                                    </td>
                                    <td>
                                            <textarea id="txt_remarks" name="model[@i].REMARKS"
                                                      style="border-color:gray; height:40px; width:200px;font-weight:bold;color:black; background-color:white;"
                                                  maxlength="200" data-ctrl="txt_remarks"
                                            @(item.STATUS == 1 ? "readonly" : "")>@item.REMARKS</textarea>
                                    </td>
                                    <td>
                                            <select id="ddl_status" name="model[@i].STATUS" class="@(item.STATUS == 1 ? "no-interaction" : "")"
                                                style="border-color:gray; width:100px;font-weight:bold;color:black; background-color:white;"
                                           >
                                                <option value="0" selected="@(item.STATUS == 0)">Pending</option>
                                                <option value="1" selected="@(item.STATUS == 1)">Completed</option>

                                        </select>

                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ATTACHDOCUMENT))
                                        {
                                            <input type="hidden" id="attchDoc" name="model[@i].ATTACHDOCUMENT" value="@item.ATTACHDOCUMENT" />
                                            <a id="linkAttachment" target="_blank"
                                               href="../Uploads/Separation/@item.ATTACHDOCUMENT"
                                               >
                                                <br />
                                                <img alt="Doc" width="15" src="../../Images/icon_document.gif" />
                                            </a>
                                        }
                                        else
                                        {
                                            @if (item.STATUS != 1) 
                                            {
                                                    <input id="fileupload" type="file" name="model[@i].FileUpload" style="width:210px;color:black;" />
                                            }
                                        }
                                    </td>
                                </tr>
                                 }
                        }
                    </tbody>
                </table>
                @* <asp:HiddenField ID="HDATTCHDOC" runat="server" /> *@
                <button type="button" id="btn_Submit" style="margin-top: 5px; margin-bottom: 5px;" class="bluebutton">Submit</button>

            </div>
            </form>
        </div>
    </div>

</div>
<div class="clear"></div>
<table cellspacing="0" cellpadding="0" style="margin-left: 7px;" width="99%" border="0"
       class="backrow_grey">
    <tbody>
        <tr>
            <td style="height:24px; width:20px; padding-left:2px;" valign="middle" align="right">
                <a title="Back" href="@Url.Action("ManageResignationRequest", "Separation")">
                    <img src="../../images/icon_back.gif" height="16" width="16" alt="Back" />
                </a>
            </td>
            <td style="height:24px; padding-left:4px;font-size:14px;" align="left">
                <a title="Back" href="@Url.Action("ManageResignationRequest", "Separation")">Back</a>
            </td>
        </tr>
    </tbody>
</table>
<br />
<div class="clear"></div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        $(document).ready(function () {
           $("#btn_Submit").click(function () {
                var formData = new FormData($("#clearanceForm")[0]);
                formData.append("lbl_emailid", $("#lbl_emailid").text());
                formData.append("lbl_assname", $("#lbl_assname").text());
                    $.ajax({
                        url: '/Separation/SubmitDetails',  
                        type: 'POST',
                        data: formData,
                        processData: false,  
                        contentType: false, 
                        success: function (response) {
                            if (response.success) {
                                 window.location.href = response.redirectUrl;
                            } else {
                            if (response.showErrorPanel === true) {
                                $("#errorpanel").hide();
                                sweetAlert("", response.message, "error");
                                
                            }
                            else if (response.showErrorPanel === false) {
                                $("#errorpanel").hide();
                            }
                               $("#status").text(response.message);
                            }
                        },
                        error: function (xhr, status, error) {
                            alert("Unexpected error: " + error);
                        }
                    });
                });
        });
    </script>
}