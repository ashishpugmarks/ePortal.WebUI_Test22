@model ePortal.ViewModels.APPX.Separation.CancellationResignationModel
@{
    ViewBag.Title = "CancellationResignation";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
            line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
            font-size: 11px;
            border-collapse: collapse;
            color: #000000;
            font-family: Verdana, Tahoma;
        }

            .tableMainInner tr td {
                border: solid 1px #CCDCE0;
                padding: 0;
            }

                .tableMainInner tr td.heading {
                    text-align: right;
                }

        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
        }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                line-height: 24px;
                font-family: Verdana, Arial, Helvetica;
                font-size: 11px;
            }

            .tableGridView tr th {
                background: url(../../images/bg_header.jpg) #cae8ea no-repeat;
            }

        .HeaderStyle12 {
            border: 1px solid #C1C4C8;
            border-bottom: none;
        }

        textarea {
            border: 1px solid gray;
            width: 500px;
        }

        .roundedPanel {
            background-color: white;
            width: 100%;
            border-radius: 6px; /* same as Radius="6" */
            padding: 10px;
        }

    </style>
}
<div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
    <div style="height: 8px;"></div>
    <span style="padding-left: 20px;">Withdraw Resignation </span>
</div>
<table class="table table-responsive">
    <tr>
        <td>
            <div id="errorpanel" style="width:100%; display:none;">
                <table class="table table-bordered table-condensed table-striped table-responsive">
                    <tr id="tr_ErrorRow" runat="server">
                        <td style="padding-top: 5px; padding-bottom: 2px; padding-left: 2px; padding-right: 2px;">
                            <div style="background-color:#ED243B; width:100%;" id="pnlErrorHeader" class="roundedPanel">
                                <div style="padding-left: 6px;">
                                    <div style="background-color:#ffeaea; width:99%;" id="pnlError" class="roundedPanel">
                                        <table class="table table-bordered table-condensed table-striped table-responsive">
                                            <tr>
                                                <td style="padding: 2px; padding-left: 5px; color: Black;">
                                                    <label id="status" style="font-size:13px; font-family:'Trebuchet MS';"></label>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>

            </div>
        </td>
    </tr>
</table>
<div style="padding: 5px;">
    <div style="background-color:white; width:100%;" id="Panel3" class="roundedPanel">
        <div style="padding-left: 6px; padding-right: 6px;">
            <div style="background-color:white; width:100%;" id="Panel1" class="roundedPanel">
                <table class="table table-responsive table-bordered table-condensed table-striped" style="border-color: #CCDCE0; border-width: 1px; border-style: solid; margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;"
                       cellpadding="0" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <td class="HeaderStyle123" style="padding: 0px 0px 0px 0px;" colspan="4">
                                &nbsp;Associate Detail&#39;s
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="tr_1" runat="server" class="row1" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top; font-weight:bold;" class="font12">
                                &nbsp;Name :-
                            </td>
                            <td class="smalltext" style="width: 30%; color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label id="lbl_assname" class="lblcss">@Model.CanResigFillEmpDtlsViewModel?.lbl_assname</label>&nbsp;[<label id="lbl_assecode" class="lblcss">@Model.CanResigFillEmpDtlsViewModel?.lbl_assecode</label>
                                ]
                            </td>
                            <td style="width: 20%; text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                &nbsp;Joining Date :-
                            </td>
                            <td class="smalltext" style="width: 25%; color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label id="lbl_joindate" class="lblcss">@Model.CanResigFillEmpDtlsViewModel?.lbl_joindate</label>
                            </td>
                        </tr>
                        <tr class="row2" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                &nbsp;Designation :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label id="lbl_desg" class="lblcss">@Model.CanResigFillEmpDtlsViewModel?.lbl_desg</label>
                            </td>
                            <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                &nbsp;Func. Designation :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label id="lbl_fundesg" class="lblcss">@Model.CanResigFillEmpDtlsViewModel?.lbl_fundesg</label>
                            </td>
                        </tr>
                        <tr class="row1" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                &nbsp;Operation :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label id="lbl_op" class="lblcss">@Model.CanResigFillEmpDtlsViewModel?.lbl_op</label>
                            </td>
                            <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                &nbsp;Division :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label id="lbl_div" class="lblcss">@Model.CanResigFillEmpDtlsViewModel?.lbl_div</label>
                            </td>
                        </tr>
                        <tr class="row2" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                &nbsp;Department :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label id="lbl_dept" class="lblcss">@Model.CanResigFillEmpDtlsViewModel?.lbl_dept</label>
                            </td>
                            <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                &nbsp;Section :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label id="lbl_sec" class="lblcss">@Model.CanResigFillEmpDtlsViewModel?.lbl_sec</label>
                            </td>
                        </tr>
                        <tr class="row1" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                &nbsp;Site :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label id="lbl_site" class="lblcss">@Model.CanResigFillEmpDtlsViewModel?.lbl_site</label>
                            </td>
                            <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                &nbsp;Relieving Date :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<label id="lbl_reldate" class="lblcss">@Model.CanResigFillEmpDtlsViewModel?.lbl_reldate</label>
                            </td>

                        </tr>
                        <tr class="row2" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                &nbsp;Subject :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;" colspan="3">
                                &nbsp;<label id="lbl_subject" class="lblcss">@Model.CanResigFillEmpDtlsViewModel?.lbl_subject</label>
                            </td>

                        </tr>
                        <tr class="row1" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;font-weight:bold;" class="font12">
                                &nbsp;Body :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;" colspan="3">
                                &nbsp;<label ID="lbl_reason" class="lblcss">@Model.CanResigFillEmpDtlsViewModel?.lbl_reason</label>
                            </td>

                        </tr>
                    </tbody>

                </table>
                <table class="table table-bordered table-condensed table-striped table-responsive" style="border-color: #CCDCE0; border-width: 1px; border-style: solid; margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;"
                       cellpadding="0" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <td class="HeaderStyle123" style="padding: 0px 0px 0px 0px;" colspan="4">
                                &nbsp; Withdraw Reason
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="row1" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top; width: 25%;" class="font12">
                                &nbsp;Body :-<span class="mandatory">*</span>
                            </td>
                            <td style="color: #6299c5; vertical-align: top; text-align: left;" colspan="3">
                                &nbsp;@* <asp:TextBox ID="txt_remarks" onKeyPress="return ( this.value.length < 200);"
                                                   onpaste="return false" TextMode="MultiLine" runat="server" Height="70px" CssClass="form-control" Style="max-width:530px"></asp:TextBox> *@
                                <textarea id="txt_remarks" name="txt_remarks"
                                          class="form-control"
                                          style="max-width:530px; height:70px;font-weight:bold;"
                                          onkeypress="return (this.value.length < 200);"
                                          onpaste="return false"></textarea>
                                <input type="hidden" id="hdn_REGID" name="hdn_REGID" value="@ViewBag.ResigID" />
                            </td>
                        </tr>

                        <tr class="row2">
                            <td align="center" colspan="4">
                                <button type="button" id="cmdSubmit" style="font-weight:bold;" class="yellowbuttonbig">Submit</button>
                                &nbsp;
                                <a style="text-align: center;width:100px;display: inline-block;font-weight:bold;" href="@Url.Action("MyResignationRequest", "Separation")"
                                   class="yellowbuttonbig">Cancel</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <br />
</div>
<div class="clear"></div>
<table cellspacing="0" cellpadding="0" style="margin-left: 7px;" width="99%" border="0"
       class="backrow_grey">
    <tbody>
        <tr>
            <td style="height:24px; width:20px; padding-left:2px;" valign="middle" align="right">
                <a title="Back" href="@Url.Action("MyResignationRequest", "Separation")">
                    <img src="../../images/icon_back.gif" height="16" width="16" alt="Back" />
                </a>
            </td>
            <td style="height:24px; padding-left:4px;font-size:14px;" align="left">
                <a title="Back" href="@Url.Action("MyResignationRequest", "Separation")">Back</a>
            </td>
        </tr>
    </tbody>
</table>
<br />
<div class="clear"></div>
@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        $(document).ready(function () {
            $("#cmdSubmit").click(function () {
                var data = {
                    Rmks: $("#txt_remarks").val(),
                    ResigID: $("#hdn_REGID").val(),
                };

                $.ajax({
                    url: '@Url.Action("SubmitCancellationResignation", "Separation")',
                    type: 'POST',
                    data: data,
                    success: function (response) {
                        if (response.success) {
                            window.location.href = response.redirectUrl;
                        } else {
                            sweetAlert("", response.message, "error");
                        }
                    },
                    error: function () {
                        alert("An error occurred while submitting.");
                    }
                });
            });
        });
       
    </script>

}