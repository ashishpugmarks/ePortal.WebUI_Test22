@model ePortal.ViewModels.APPX.Separation.ViewClearanceDetailsModel
@{
    ViewBag.Title = "ViewClearanceDetails";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}

@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .maincontainer {
            /*width: 800px;*/
            border: 0px solid gray;
            height: auto;
            padding: 2px;
            background-color: White;
            margin-left: 5px;
            margin-right: 5px;
        }

        .mainhead {
            background-image: url( '../../images/box_top_m.gif' );
            background-repeat: repeat-x;
            line-height: 25px;
            text-align: left;
            padding-left: 10px;
            color: White;
            font-weight: bold;
            margin-bottom: 5px;
            font-size: 0.9em;
        }

        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
            line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
            font-size: 11px;
            border-collapse: collapse;
            color: #000000;
            font-family: Verdana, Tahoma;
        }

            .tableMainInner tr td {
                border: solid 1px #CCDCE0;
                padding: 0;
            }

                .tableMainInner tr td.heading {
                    text-align: right;
                }

        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
        }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                line-height: 24px;
                font-family: Verdana, Arial, Helvetica;
                font-size: 11px;
            }

            .tableGridView tr th {
                background: url(../../images/bg_header.jpg) #cae8ea no-repeat;
            }

        .HeaderStyle12 {
            border: 1px solid #C1C4C8;
            border-bottom: none;
        }

        .frmtable .inputtxtcss {
            border: 1px solid gray !important;
            width: 168px !important;
            height: 20px;
            padding-left: 3px;
        }

        .DET_1 {
            width: 100%;
            height: auto;
        }

        .Head_1 {
            background-color: #2D5094;
            line-height: 25px;
            text-align: center;
            font-weight: bold;
            color: White;
        }

        .pendingspan {
            color: Red;
            font-weight: bold;
        }

        .completedspan {
            color: Green;
            font-weight: bold;
        }

        .holdspan {
            color: Orange;
            font-weight: bold;
        }

        .lblcss {
            color: #6299C5 !important;
        }
    </style>
}

<div class="maincontainer" id="maincontainer" runat="server">
    <div style="border: 1px solid #6393DF; margin-bottom: 20px; clear: both;">
        <div class="HeaderStyle123" style="height: 2.2em;">
            <div style="height: 8px;"></div>
            <span style="padding-left: 20px;">Associate Details</span>
        </div>
        <table class="table table-bordered table-condensed table-striped table-responsive" width="100%">
            <tbody>
                <tr id="tr_1" runat="server" class="info" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Name :-
                    </td>
                    <td class="smalltext" style="width: 30%; color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_assname" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_assname</label>&nbsp;[<label id="lbl_assecode" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_assecode</label>]
                    </td>
                    <td style="width: 20%; text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Joining Date :-
                    </td>
                    <td class="smalltext" style="width: 25%; color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_joindate" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_joindate</label>
                    </td>
                </tr>
                <tr class="active" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Designation :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_desg" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_desg</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Func. Designation :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_fundesg" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_fundesg</label>
                    </td>
                </tr>
                <tr class="info">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        <span class="smalltext">Mobile Number :-</span>
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_phone" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_phone</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        Email Id :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_emailid" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_emailid</label>
                    </td>
                </tr>

                <tr class="active" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Operation :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_op" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_op</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Division :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_div" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_div</label>
                    </td>
                </tr>
                <tr class="info" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Department :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_dept" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_dept</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Section :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_sec" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_sec</label>
                    </td>
                </tr>
                <tr class="active" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Site :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_site" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_site</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Resignation  Date :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_applydate" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_applydate</label>
                    </td>

                </tr>
                <tr class="info">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Relieving Date (Associate) :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_reldate" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_reldate</label>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Final Relieving Date :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;<label id="lbl_deptreldate" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_deptreldate</label>
                    </td>
                </tr>

                <tr class="active" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Subject :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;" colspan="3">
                        &nbsp;<label id="lbl_subject" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_subject</label>
                    </td>

                </tr>
                <tr class="info" style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        &nbsp;Body :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;" colspan="3">
                        &nbsp;<label id="lbl_reason" class="lblcss">@Model.ClearanceDetailsViewModel?.lbl_reason</label>
                    </td>

                </tr>
            </tbody>
        </table>
    </div>
    @foreach (var header in Model.ResignationDetailViewModel)
    {
        <div style="border: 1px solid #6393DF; margin-bottom: 20px; clear: both;">

            <div class="HeaderStyle123" style="height: 2.2em;">
                <div style="height: 8px;"></div>
                <span style="padding-left: 20px;">@header.Description</span>
            </div>

            <table class="table table-bordered table-condensed table-striped table-responsive">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Amount</th>
                        <th>Remarks</th>
                        <th>Checked By</th>
                        <th>Checked Date</th>
                        <th>Status</th>
                        <th><img src="~/Images/icons/attachment.gif" /></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in header.SubHeaderDetails)
                    {
                        <tr>
                            <td>@sub.Description</td>
                            <td>@sub.Amount</td>
                            <td>@sub.Remarks</td>
                            <td>@sub.SubmitBy</td>
                            <td>@sub.SubmittedDate</td>
                            <td>
                                @if (sub.Status == "0")
                                {
                                    <span class="pendingspan">Pending</span>
                                }
                                else if (sub.Status == "1")
                                {
                                    <span class="completedspan">Completed</span>
                                }
                                else if (sub.Status == "2")
                                {
                                    <span class="holdspan">Hold</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(sub.AttachDocument))
                                {
                                    <a href="~/Uploads/Separation/@sub.AttachDocument" target="_blank" onclick="open(this.href, this.target, 'width=800, height=550, top=90, left=200'); return false;">
                                        <img alt="Doc" width="15" src="~/Images/icon_document.gif" />
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <table class="table table-bordered table-condensed table-striped table-responsive" style="border-top: 1px solid Gray; border-bottom: 1px solid Gray;">
                <tr class="info" style="background-color: #F2F2F2;">
                    <td width="200px"><b style="color: Black;">APPROVED BY</b></td>
                    <td width="75px"></td>
                    <td width="250px" align="center">@header.Remarks</td>
                    <td width="120px" align="center">@header.Ename (@header.SubmitBy)</td>
                    <td width="100px" align="center">@header.SubmittedDate</td>
                    <td width="90px" align="center">
                        @if (header.Status == "0")
                        {
                            <span class="pendingspan">Pending</span>
                        }
                        else if (header.Status == "1")
                        {
                            <span class="completedspan">Completed</span>
                        }
                        else if (header.Status == "2")
                        {
                            <span class="holdspan">Hold</span>
                        }
                    </td>
                </tr>
            </table>
        </div>
    }
</div>