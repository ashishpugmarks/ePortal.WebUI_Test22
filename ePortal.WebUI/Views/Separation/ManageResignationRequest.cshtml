                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {

                if (!data || data.length === 0) {
                    alert("No data to export");
                    return;
                }

                const columnOrder = [
                    "RESIGNATIONID",
                    "ADEMPCODE",
                    "EMPNAME",
                    "DEPARTMENT",
                    "OPERATION",
                    "SECTION",
                    "DIVISION",
                    "FNDESIG",
                    "DOJ",
                    "BASICSALARYAMT",
                    "EMAILID",
                    "RESIG_SUBJECT",
                    "RESIG_REASON",
                    "RESIG_FOR_DESC",
                    "DESCRIP",
                    "RESIGNED_DATE",
                    "RESIGNATION_STATUS",
                    "RELIEVING_DATE_SELF",
                    "RELIEVING_DATE_AUTH",
                    "REQUEST_STATUS"
                ];

                let table = "<table border='1'><tr>";
                columnOrder.forEach(col => {
                    table += `<th>${col}</th>`;
                });
                table += "</tr>";

                data.forEach(row => {
                    table += "<tr>";
                    columnOrder.forEach(col => {
                        let val = row[col];
                        table += `<td>${val ?? ""}</td>`;
                    });
                    table += "</tr>";
                });

                table += "</table>";

                let blob = new Blob([table], { type: "application/vnd.ms-excel" });
                let url = URL.createObjectURL(blob);

                let a = document.createElement("a");
                a.href = url;
                a.download = "ClearanceFormData.xls";
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            })
            .catch(err => {
                console.error("Export failed", err);
                alert("Error while exporting data");
            });
        }
        //Added by Aumento :: SR107848
    </script>

}
