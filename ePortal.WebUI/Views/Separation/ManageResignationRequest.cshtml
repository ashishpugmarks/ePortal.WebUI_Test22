            //Added By Aumento :: SR107848 

            var searchBtn = document.getElementById("btnSearch");
            var searchTxt = document.getElementById("txtSearch");
            var pageSize = document.getElementById("ddlPageSize");

            function redirect() {
                var search = searchTxt ? searchTxt.value : "";
                var size = pageSize ? pageSize.value : 10;

                var url = new URL(window.location.href);
                url.searchParams.set("txtSearch", search);
                url.searchParams.set("ddlPageSize", size);

                window.location.href = url.toString();
            }

            if (searchBtn) {
                if(searchTxt == "" && searchTxt == undefined)
                {
                    alert("Please add Search string..");
                }
                searchBtn.addEventListener("click", redirect);
            }

            if (pageSize) {
                pageSize.addEventListener("change", redirect);
            }

            if (searchTxt) {
                searchTxt.addEventListener("keypress", function (e) {
                    if (e.key === "Enter") {
                        redirect();
                    }
                });
            }

             $(document).on("click", "a#RegPendClearForm", function () {
                var table = $('#gridresclearform').DataTable();
                var currentPage = table.page(); 
                sessionStorage.setItem("ClearanceGridPage", currentPage);
            });

