@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Previous Employer : Overview";
}
@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    .loader {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
        opacity: .7;
    }
</style>
}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">
            Previous Employer : Overview
        </div>
    </div>
    <div id="div_message" style="margin:5px 10px; vertical-align: middle;"></div>

    <div class="panel-group" style="margin:10px;">
        <div class="panel panel-primary">
            <div class="panel-heading">
                Previous Employers List of
                <span id="lblfullname" style="font-weight:bold;">@Model.FullName</span>
                <input id="txtpersonelnumber" type="text"
                       value="@Model.PersonnelNumber"
                       class="form-control"
                       style="border:none; font-weight:bold;"
                       disabled hidden />
            </div>
            <div class="panel-body">
                @if (Model.PreviousEmployers == null || !Model.PreviousEmployers.Any())
                {
                    <span style="color:red;">No Record Available</span>
                }
                else
                {
                    <table id="GridView1" class="table table-striped table-bordered table-hover text-center">
                        <thead>
                            <tr>
                                <th>Employed From</th>
                                <th>Employed To</th>
                                <th>Employer</th>
                                <th class="hidden-sm hidden-xs">City</th>
                                <th>Job</th>
                                <th>Industry</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Model.PreviousEmployers)
                            {
                                <tr>
                                    <td>@emp.ValidBegin.ToString("yyyy-MM-dd")</td>
                                    <td>@emp.ValidEnd.ToString("yyyy-MM-dd")</td>
                                    <td>@emp.EmployerName</td>
                                    <td class="hidden-sm hidden-xs">@emp.City</td>
                                    <td>@emp.JobName</td>
                                    <td>@emp.IndustryName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

</div>
<div class="well well-sm">
    <table border="0" style="width: 100%;">
        <tr>
            <td style="height: 20px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td style="width: 20px; vertical-align: middle; text-align: center;" align="left">
                                <a title="Back" href="../../Home/Home">
                                    <img src="../../images/icon_back.gif" border="0" alt="" />
                                </a>
                            </td>
                            <td style="vertical-align: middle; font-size: 15px;">
                                <span><a title="Back" href="../../Home/Home">Back</a></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>
<div id="ajaxLoader"></div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $('.homeContent').removeClass('homeContent');

    </script>
}