@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Family Member/Dependents : Overview";
}
@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    .loader {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
        opacity: .7;
    }
</style>
}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">
            Family Member/Dependents : Overview
        </div>
    </div>
    <div id="div_message" style="margin: 5px 10px; vertical-align: middle;"></div>

    <div class="panel-group" style="margin: 10px;">
        <!-- Associate Name Panel -->
        <div class="panel panel-primary" style="background-color: #edf6ff;">
            <div class="panel-body">
                <div class="row">
                    <div class="col-xs-6 col-md-3 col-lg-5 text-end">
                        <span>Associate Name:</span>
                    </div>
                    <div class="col-xs-6 col-md-3 col-lg-5 text-start">
                        <span id="lblfullname" style="font-weight:bold;">@Model.FullName</span>
                        <input id="txtpersonelnumber" type="text"
                               value="@Model.PersonnelNumber"
                               class="form-control"
                               style="border:none; font-weight:bold;"
                               hidden />
                    </div>
                </div>
            </div>
        </div>

        <!-- Grid Panel -->
        <div class="panel panel-info">
            <div class="panel-body">
                @if (Model.Records == null || !Model.Records.Any())
                {
                    <span id="noRecord" style="color: Red; font-size: medium;">No Record Available</span>
                }
                else
                {
                    <table id="GridView1" class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Valid From</th>
                                <th>End Date</th>
                                <th>Name</th>
                                <th class="hidden-sm hidden-xs">Date Of Birth</th>
                                <th>Member Type</th>
                                <th>SubType</th>
                                <th>Objectid</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model.Records)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@record.Objectid">
                                            <img src="~/assets/images/icon_ticketbullet.gif" alt="Edit" />
                                        </a>
                                    </td>
                                    <td>@record.ValidBegin.ToString("yyyy-MM-dd")</td>
                                    <td>@record.ValidEnd.ToString("yyyy-MM-dd")</td>
                                    <td>@record.FirstName</td>
                                    <td class="hidden-sm hidden-xs">@record.DateOfBirth.ToString("yyyy-MM-dd")</td>
                                    <td>@record.MemberType</td>
                                    <td>@record.SubType</td>
                                    <td>@record.Objectid</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

</div>
<div class="well well-sm">
    <table border="0" style="width: 100%;">
        <tr>
            <td style="height: 20px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td style="width: 20px; vertical-align: middle; text-align: center;" align="left">
                                <a title="Back" href="../../Home/Home">
                                    <img src="../../images/icon_back.gif" border="0" alt="" />
                                </a>
                            </td>
                            <td style="vertical-align: middle; font-size: 15px;">
                                <span><a title="Back" href="../../Home/Home">Back</a></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>
<div id="ajaxLoader"></div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $('.homeContent').removeClass('homeContent');

    </script>
}