                            <td style="vertical-align: middle;" colspan="2">
                                <span class="text-info font-weight-bold">@Model.FullName</span>
                            <input id="txtpersonelnumber" asp-for="PersonnelNumber" class="form-control font-weight-bold" type="hidden" />
                            </td>
                        </tr>

                        <tr>
                            <td style="text-align: right; vertical-align: middle; width: 25%;">
                                Date:
                            </td>
                            <td style="text-align: left; vertical-align: middle; width: 35%;">                          
                                <div class="col-xs-10 col-sm-6 col-md-6 col-lg-5" style="padding: 0px;">
                                   <input asp-for="FromDate" id="txtFromDate" type="text" class="form-control" />
                                </div>
                                &nbsp;<img id="S1" alt="Pick From Date" src="~/images/Calendar_scheduleHS.png" class="calendar-icon" />
                                &nbsp;<img id="R1" alt="Remove From Date" src="~/images/eraser.png" class="eraser-icon" data-action="removefromdate" />
                                @* &nbsp;<img id="S1" alt="Pick From Date" src="~/images/Calendar_scheduleHS.png" *@
                                @*            onclick="var cal1 = new CalendarPopup();cal1.select(document.getElementById('FromDate'),'S1','dd-MMM-yyyy');return false;" /> *@
                                @* &nbsp;<img id="R1" alt="Remove From Date" src="~/images/eraser.png" onclick="removefromdate();" /> *@                            
                            </td>
                            <td style="text-align: left; vertical-align: middle; width: 40%;">
                            <input type="radio" id="RadioButton1" name="ReportType" value="Access" checked class="form-check-input" />
                            <label class="form-check-label" for="RadioButton1">
                                Access Report (Not for Attendance Regularization)
                            </label>
                            </td>
                        </tr>

                        <tr>
                            <td style="text-align: right; vertical-align: middle;">
                                Employee:
                            </td>
                            <td style="text-align: left;">
                                <div class="col-xs-6 col-sm-5 col-md-6 col-lg-5" style="padding: 0px;">
                                <select id="cmbemp" asp-for="cmbemp" asp-items="Model.EmployeeList" class="form-control"></select>
                                </div>
                            </td>
                            <td style="text-align: left; vertical-align: middle;">
                            <input type="radio" id="RadioButton2" name="ReportType" value="Punch" checked class="form-check-input" />
                                <label class="form-check-label">Punch Report</label>
                            </td>
                        </tr>

                        <tr>
                            <td style="text-align: center;" colspan="3">
                            <input id="hdtotalvalue" type="hidden" asp-for="TotalValue" />
                                <button id="Button1" type="submit" class="btn btn-default active">Display</button>
                            </td>
                        </tr>
                      @*  @if (Model.ShowSummary)
                        {
                            <tr class="row1" style="background-color: #f2f7ff;">
                                <td style="text-align: left;" colspan="3">*@
                                    @* <span class="text-danger" style="font-size: large;"> *@
                                    @*     Total Associate :- *@
                                    @*     <asp:Label ID="lbltotal" runat="server"></asp:Label> *@
                                    @*     &nbsp;	&nbsp;||	&nbsp;	&nbsp;  Associate Office Access :- *@
                                    @*     <asp:Label ID="lblasspunch" runat="server"></asp:Label> *@
                                    @* </span> *@
                    @* <span class="text-danger" style="font-size: large;">
                                        Total Associate :- <span id="lbltotal">@Model.TotalAssociates</span>
                                        &nbsp;&nbsp;||&nbsp;&nbsp; Associate Office Access :-<span id="lblasspunch">@Model.AssociatePunch</span>
                                    </span>
                                    <br />
                                </td>
                            </tr>
                    }*@
                        @*SR89259 Start*@
                        <tr>
                            <td style="text-align: left;" colspan="3">
                                @* <asp:Label ID="lblNote" runat="server" Text="" CssClass="text-warning" Font-Bold="true" Visible="false"></asp:Label> *@
                            @* <span id="lblNote" class="text-warning fw-bold"> *@
                            @*     @Model.NoteMessage *@
                            @* </span> *@
                            @if (!string.IsNullOrEmpty(Model.NoteMessage))
                            {
                                <div id="lblNote" class="text-warning fw-bold">@Model.NoteMessage</div>
                            }
                            </td>
                        </tr>
                        @* @*SR89259 End*@
                    </table>

                <div id="div_append"></div>
                <div id="ajaxLoader"></div>
            </div>

           

        </div>

        <div style="margin-left: 0.2em; margin-right: 0.2em;" class="well well-sm">
            <table border="0" style="width: 100%;">
                <tr>
                    <td style="height: 20px;">
                        <table style="width: 100%;">
                            <tbody>
                                <tr>
                                    <td style="width: 20px; vertical-align: middle; text-align: center;" align="left">
                                        <a title="Back" href="../../ESS/EssDetail">
                                            <img src="../../images/icon_back.gif" border="0" alt="" />
                                        </a>
                                    </td>
                                    <td style="vertical-align: middle; font-size: 15px;">
                                        <span><a title="Back" href="../../ESS/EssDetail">Back</a></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </div>
   
</div>
@section Scripts {
        <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $('.homeContent').removeClass('homeContent');
                $('#txtFromDate').datepicker({ format: "dd-M-yyyy", // shows 12-Aug-2023 
                autoclose: true, todayHighlight: true });
                $("#S1").click(function () 
                { 
                    $('#txtFromDate').datepicker('show');
                });

           function GetReportList(crnt) {
                var fromDate = $('#txtFromDate').val();
                if (fromDate === "") {
                    sweetAlert("", "Please select date", "error");
                    return;
                }
                var emp = $('#cmbemp').val();
                $('#txtpersonelnumber').val(emp);
                var reportType = $('input[name="ReportType"]:checked').val();

                var dateObj = new Date(fromDate); // Add 1 day 
                dateObj.setDate(dateObj.getDate() + 1);

                var data = {
                        PersonnelNumber: $('#txtpersonelnumber').val(),
                        ReportType: reportType,
                        FromDate: dateObj
                };
                $.ajax({
                    type: "POST",
                        url: "/ESS/RealtimeAccess_PunchReportClick",
                        data: JSON.stringify(data),
                        contentType: "application/json; charset=utf-8",
                        dataType: "html",
                        beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    success: function (data) {
                        $('#div_append').html(data);
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                });
            }
            document.getElementById("R1").addEventListener("click", removefromdate);
            function removefromdate() {
                document.getElementById("txtFromDate").value = "";
            }
    </script>
    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#Button1').on('click', function (event) {
                event.preventDefault();
                GetReportList($(this));
            });
        });
    </script>
}
