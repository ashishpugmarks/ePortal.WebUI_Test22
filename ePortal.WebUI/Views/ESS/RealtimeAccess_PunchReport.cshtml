@using ePortal.ViewModels.APPX
@model EssViewModel.PunchReportViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "RealTime Access Report: Detail";
}
@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

    </style>
}
<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">
            Realtime Access Report: Detail
        </div>
    </div>

    <div class="body-content" style="overflow-x:auto!important;">
        <div class="panel-group">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title">
                        <strong>Use selection criteria to view date wise Access report</strong>
                    </h2>
                </div>
                 <table style="margin-bottom: 0px;" class="table table-bordered table-condensed table-hover">
                        <tr>
                            <td style="text-align: right; vertical-align: middle;">
