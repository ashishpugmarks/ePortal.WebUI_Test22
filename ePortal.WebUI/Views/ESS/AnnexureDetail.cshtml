@using ePortal.ViewModels.APPX
@model EssViewModel
@{
    Layout = null;
    ViewBag.Title = "AnnexureDetail - Test";
}
<div>
    <table width="99%" cellpadding="0" cellspacing="0" style="border: solid 1px #6B6B6B; margin-top: 2px;">
        <tr>
            <td align="center" style="background-color:#FECA45;height:40px;">
                <span style="font-family: Calibri; font-size: 18px; font-weight:bold;">
                    Honda Motorcycle & Scooter India Pvt. Ltd.
                </span><br />
                <span style="font-family: Calibri; font-size: 16px; font-weight:bold;">
                    Compensation Structure Details - w.e.f.
                    <span id="ltrdate">@Model?.EffectiveDateText</span>
                </span>
            </td>
        </tr>
    </table>
</div>
<div>
    <table width="100%" cellpadding="0" cellspacing="0">
        <tr>
            <td align="center">
                <table width="99%" cellpadding="0" cellspacing="0" style="border: solid 1px #6B6B6B; margin-top: 2px;">
                    <tr>
                        <td colspan="2">
                            <table width="100%" cellpadding="1" cellspacing="1" style="font-family: Calibri; font-size: 12px;">
                                <tr>
                                    <td style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B; background-color:#ededed;width:17%; font-size: 10pt; height: 20px;" align="right">
                                        Employee Code &nbsp;
                                    </td>
                                    <td style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B; padding: 2px;width:30%; font-size: 10pt; height: 20px;" align="left">
                                        &nbsp;<span id="lblEmpcode">@Model?.EmpCode</span>
                                    </td>
                                    <td style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B; background-color:#ededed;width:15%; font-size: 10pt; height: 20px;" align="right">
                                        Name &nbsp;
                                    </td>
                                    <td style="border-bottom: solid 1px #6B6B6B; padding: 2px;width:28%; font-size: 10pt; height: 20px;" align="left">
                                        &nbsp;<span id="lblEmpName">@Model?.EmpName</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B; padding: 2px;background-color:#ededed; font-size: 10pt; height: 20px;" align="right">
                                        Operation &nbsp;
                                    </td>
                                    <td style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B; padding: 2px; font-size: 10pt; height: 20px;" align="left">
                                        &nbsp;<span id="lblOperation">@Model?.Operation</span>
                                    </td>
                                    <td style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B;padding: 2px;background-color:#ededed; font-size: 10pt; height: 20px;" align="right">
                                        Division &nbsp;
                                    </td>
                                    <td style="border-bottom: solid 1px #6B6B6B; font-size: 10pt; padding: 2px; height: 20px;" align="left">
                                        &nbsp;<span id="lblDivision">@Model?.Division</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-right: solid 1px #6B6B6B; font-size: 10pt; padding: 2px;background-color:#ededed; height: 20px;" align="right">
                                        Department &nbsp;
                                    </td>
                                    <td style="border-right: solid 1px #6B6B6B;padding: 2px; font-size: 10pt; height: 20px;" align="left">
                                        &nbsp;<span id="lblDepartment">@Model?.Department</span>
                                    </td>
                                    <td style="border-right: solid 1px #6B6B6B; padding: 2px;background-color:#ededed; font-size: 10pt; height: 20px;" align="right">
                                        Designation &nbsp;
                                    </td>
                                    <td style="padding: 2px; font-size: 10pt; height: 20px;" align="left">
                                        &nbsp;<span id="lblDesignation">@Model?.Designation</span>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>
<div>
    <table width="100%" cellpadding="0" cellspacing="0">
        <tr>
            <td align="center">
                <table width="99%" cellpadding="0" cellspacing="0" style="border: solid 1px #6B6B6B; margin-top: 2px;">
                    <tr>
                        <td colspan="4">
                            <table width="100%" cellpadding="0" cellspacing="0" style="font-family: Calibri; font-size: 12px;">
                                <tr style="background-color:#edcd90">
                                    <td id="tdComponents" style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B; padding: 2px; height: 20px; font-size: 12pt;" align="left" colspan="2" width="52%">
                                        &nbsp;<b>Components</b>
                                    </td>
                                    <td id="tdNotes" style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B; padding: 2px; height: 20px; font-size: 12pt;" align="left" width="20%">
                                        &nbsp;<b>Notes</b>
                                    </td>
                                    <td id="tdAmount" style="border-bottom: solid 1px #6B6B6B; height: 20px; font-size: 12pt;" align="right" width="28%">
                                        <b>Amount(Rs./Annum)</b>&nbsp;
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>                   
                    
                    @if (Model?.TFIComponentsItems != null && Model.TFIComponentsItems.Any())
                    {
                        @foreach (var item in Model.TFIComponentsItems)
                        {
                            <tr> 
                                <td style="border-bottom:1px solid #6B6B6B; border-right:1px solid #6B6B6B; padding:2px; font-size:10pt; height:20px;" align="left" colspan="2" width="40%"> 
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;@item.Description 
                                </td>
                                <td id="tdNotes" style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B; padding: 2px; font-size: 10pt; height: 20px;" align="left" width="25%">
                                    @* &nbsp;*&nbsp; *@
                                </td>
                                <td style="border-bottom:1px solid #6B6B6B; padding:2px; font-size:10pt;" align="right" width="35%">
                                    &nbsp;&nbsp;@string.Format("{0:#,##0}", item.Amount * 12) &nbsp;&nbsp; 
                                </td> 
                            </tr>
                        }
                    }
                    <tr style="background-color:#c4c2c2;">
                        <td style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B; padding: 2px;
                                            height: 20px; font-size: 12pt;" align="left" colspan="3" width="75%">
                            <b>&nbsp;Total TFI [A]</b>
                        </td>
                        <td style="border-bottom: solid 1px #6B6B6B;  padding: 2px;
                                            height: 20px;" align="right" width="25%">
                            &nbsp;&nbsp; <b>
                                @* <%=(totalSumA).ToString("#,##0")%> *@
                                @string.Format("{0:#,##0}", Model?.TotalSumA)
                            </b>&nbsp;&nbsp;
                        </td>
                    </tr>                  
                    
                    @if (Model?.PerquisitesItems != null && Model.PerquisitesItems.Any())
                    {
                        @foreach (var item in Model.PerquisitesItems)
                        {
                            <tr>
                                <td style="border-bottom:1px solid #6B6B6B; border-right:1px solid #6B6B6B; padding:2px; font-size:10pt; height:20px;" align="left" colspan="2" width="40%">
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;@item.Description
                                </td>
                                <td id="tdNotes" style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B; padding: 2px; font-size: 10pt; height: 20px;" align="left" width="25%">
                                    @* &nbsp;**&nbsp; *@
                                </td>
                                <td style="border-bottom:1px solid #6B6B6B; padding:2px; font-size:10pt;" align="right" width="35%">
                                    &nbsp;&nbsp;@string.Format("{0:#,##0}", item.Amount) &nbsp;&nbsp;
                                </td>
                            </tr>
                        }
                    }  
                   
                    <tr style="background-color:#c4c2c2;">
                        <td id="tdPerquisitesLabel" style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B; padding: 2px;
                          height: 20px; font-size: 12pt;" align="left" colspan="3" width="75%">
                            <b>&nbsp;Total Perquisites [B]</b>
                        </td>
                        <td id="tdPerquisitesAmount" style="border-bottom: solid 1px #6B6B6B; padding: 2px;
                          height: 20px;" align="right" width="25%">
                            &nbsp;&nbsp;<b>@string.Format("{0:#,##0}", Model?.TotalPerquisitesB)</b>&nbsp;&nbsp;
                        </td>
                    </tr> 
                   
                   @if (Model?.CompanyItems != null && Model.CompanyItems.Any())
                    {
                        @foreach (var item in Model.CompanyItems)
                        {
                            <tr>
                                <td style="border-bottom:1px solid #6B6B6B; border-right:1px solid #6B6B6B; padding:2px; font-size:10pt; height:20px;" align="left" colspan="2" width="40%">
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;@item.Description
                                </td>
                                <td id="tdNotes" style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B; padding: 2px; font-size: 10pt; height: 20px;" align="left" width="25%">
                                    @* &nbsp;***&nbsp; *@
                                </td>
                                <td style="border-bottom:1px solid #6B6B6B; padding:2px; font-size:10pt;" align="right" width="35%">
                                    &nbsp;&nbsp;@string.Format("{0:#,##0}", item.Amount) &nbsp;&nbsp;
                                </td>
                            </tr>
                        }
                    }
                    <tr style="background-color:#c4c2c2;">
                        <td id="tdCTCLabel" style="border-bottom: solid 1px #6B6B6B; border-right: solid 1px #6B6B6B; padding: 2px;
                          height: 20px; font-size: 12pt;" align="left" colspan="3" width="75%">
                            <b>&nbsp;Cost To Company [A+B+C]</b>
                        </td>
                        <td id="tdCTCAmount" style="border-bottom: solid 1px #6B6B6B; padding: 2px;
                          height: 20px;" align="right" width="25%">
                            &nbsp;&nbsp;<b>@string.Format("{0:#,##0}", (Model?.TotalSumA ?? 0) + (Model?.TotalPerquisitesB ?? 0) + (Model?.TotalSumC ?? 0))</b>&nbsp;&nbsp;
                        </td>
                    </tr>

                    <tr>
                        <td id="tdSpacer" colspan="4" width="99%" style="border-bottom: solid 1px #6B6B6B;
                       padding: 2px; height: 20px; font-size: 12pt;" align="left">
                        </td>
                    </tr>

                    <tr class="trhd">
                        <td id="tdNotesHeader" colspan="4" width="99%" style="border-bottom: solid 1px #6B6B6B;
                       height: 20px; font-size: 12pt;" align="left">
                            <b>&nbsp;Notes</b>
                        </td>
                    </tr>

                    <tr class="tr12">
                        <td id="tdNote1" colspan="4" width="99%" style="border-bottom: solid 1px #6B6B6B; white-space:nowrap; padding-bottom:2px; height:20px;
                          font-size: 10pt;" align="left">
                            &nbsp;All entitlements are as per company policies currently in force and may vary
                            from time to time.
                        </td>
                    </tr>

                    <tr class="tr12">
                        <td id="tdNote2" colspan="4" width="99%" style="border-bottom: solid 1px #6B6B6B; white-space:nowrap; height:20px;
                          font-size: 10pt;" align="left">
                            &nbsp;Payment of all entitlements are subject to the Taxes as per the Tax Laws applicable
                            in India.
                        </td>
                    </tr>

                    <tr class="tr13">
                        <td id="tdNote1" colspan="4" width="99%"
                            style="border-bottom: solid 1px #6B6B6B; height:20px; vertical-align:middle; font-size: 10pt;" align="justify">
                            @* Note1 *@                            
                                &nbsp;*&nbsp;  Gratuity is payable under the Payment of Gratuity Act, 1972 on separation from the Company after completion of 5 years or more
                                of continuous service or on retirement from the Company services.                           
                        </td>
                    </tr>
                    <tr class="tr13">
                        <td id="tdNote2" colspan="4" width="99%"
                            style="border-bottom: solid 1px #6B6B6B; height:20px; vertical-align:middle; font-size: 10pt;" align="justify">
                            @* Note2 *@
                           &nbsp;**&nbsp; You will also be covered under Company’s Group Personal Accident Insurance Policy.
                        </td>
                    </tr>
                    <tr class="tr13">
                        <td id="tdNote3" colspan="4" width="99%"
                            style="border-bottom: solid 1px #6B6B6B; height:20px; vertical-align:middle; font-size: 10pt;" align="justify">
                            @* Note3 *@
                            &nbsp;***&nbsp;The amount of variable shown is equivalent to one month of your TFI and is payable twice in a financial year. The variable
                            payment amount may vary depending upon company & your Individual performance.
                        </td>
                    </tr>
                    @* <tr class="tr13">
                        <td id="tdNote4" colspan="4" width="100%"
                            style="border-bottom: solid 1px #6B6B6B; padding:2px; height:20px; font-size:10pt;" align="left">
                            &nbsp;****&nbsp;
                        </td>
                    </tr>
                    <tr class="tr13">
                        <td id="tdNote5" colspan="4" width="100%"
                            style="border-bottom: solid 1px #6B6B6B; padding:2px; height:20px; font-size:10pt;" align="left">
                            &nbsp;*****&nbsp;
                        </td>
                    </tr>
                    <tr class="tr13">
                        <td id="tdNote6" colspan="4" width="100%"
                            style="border-bottom: solid 1px #6B6B6B; padding:2px; height:20px; font-size:10pt;" align="left">
                            &nbsp;******&nbsp; 
                        </td>
                    </tr>
                    <tr class="tr13">
                        <td id="tdNote7" colspan="4" width="99%"
                            style="border-bottom: solid 1px #6B6B6B; padding:2px; height:20px; font-size:10pt;" align="left">
                            &nbsp;*******&nbsp; 
                        </td>
                    </tr>
                    <tr class="tr13">
                        <td id="tdNote8" colspan="4" width="100%"
                            style="border-bottom: solid 1px #6B6B6B; padding:2px; height:20px; font-size:10pt;" align="left">
                            &nbsp;********&nbsp; 
                        </td>
                    </tr>
                    *@
                </table>
            </td>
        </tr>
    </table>
</div>

