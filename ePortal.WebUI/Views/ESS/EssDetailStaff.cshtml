@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Employee Portal - Employee Self Service :: Honda Motorcycle & Scooter India Pvt. Ltd.";
}
@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    .loader {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
        opacity: .7;
    }
</style>
}

<div class="row">
