@using ePortal.ViewModels.APPX
@model List<EssViewModel.EmpUnBlockProcessModel.EmpUnBlockProcessRecords>
@{
    Layout = null;
}
@section Styles {
    <style nonce="@Context.Items["StyleNonce_1"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .radio-label-small {
            font-size: 0.89rem; /* adjust as needed */
        }       
    </style>
}
<div class="panel-group" style="margin:10px;">
    <div class="panel panel-info">
        @if (Model != null)
        {
            <table id="tblDetail" class="table table-bordered table-condensed table-hover">
                <thead class="bg-info">
                    <tr>
                        <th>Employee Code</th>
                        <th>Block Date</th>
                        <th>Status</th>
                        <th>Reason</th>
                        @* <th>Action</th> *@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>@emp.ADEMPCODE</td>
                            <td>@emp.CREATED_ON</td>
                            <td>@emp.UNBSTATUS</td>
                            <td>@emp.Reason</td>
                            @* <td>
                                <!-- Edit button -->
                                <form method="post" asp-page-handler="Edit" asp-route-id="@emp.ADEMPCODE">
                                    <button type="submit" class="btn btn-sm btn-primary">Edit</button>
                                </form>
                            </td> *@
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <span style="color:red; font-size:medium;">No Record Available</span>
        }
    </div>
</div>

@section Scripts {
    <script nonce="@Context.Items["ScriptNonce_5"]">
        $(document).ready(function(){
            $('.homeContent').removeClass('homeContent');
        });
    </script>

}
