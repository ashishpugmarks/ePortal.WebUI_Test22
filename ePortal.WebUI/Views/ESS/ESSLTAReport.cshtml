@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Employee Portal - Home :: Honda Motorcycle & Scooter India Pvt. Ltd.";
}
@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    .loader {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
        opacity: .7;
    }
</style>
}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">
            LTA (Leave Travel Allowance) Summary
        </div>
        <div class="panel-body">
            <div class="row" style="vertical-align: middle; padding: 0px;">
                <!-- Opening Balance -->
                <div class="col-xs-6 col-md-3 col-lg-2 text-center">
                    <div class="mainlta">
                        <div class="ltaheading" style="height: 2em; padding-top: 6px; background-color: #43CACA;">
                            <a data-toggle="tooltip" title="Last year carry forward LTA balance"
                               style="color: white; text-decoration: underline;">Opening Balance</a>
                        </div>
                        <div style="padding-top: 1em;">
                            <span id="lblopeningbal" class="ltaval">@Model.OpeningBalance</span>
                        </div>
                    </div>
                </div>

                <div class="col-xs-7 col-md-3 col-lg-1" style="padding-top: 1em;">
                    <img src="~/images/plus_new.png" />
                </div>

                <!-- Current Year Eligibility -->
                <div class="col-xs-6 col-md-3 col-lg-2 text-center">
                    <div class="mainlta">
                        <div class="ltaheading" style="height: 2em; padding-top: 6px; background-color: #99C038;">
                            <a data-toggle="tooltip" title="12% of Basic"
                               style="color: white; text-decoration: underline;">Current Year Eligibility</a>
                        </div>
                        <div style="padding-top: 1em;">
                            <span id="lblcuryearbal" class="ltaval">@Model.CurrentYearEligibility</span>
                        </div>
                    </div>
                </div>

                <div class="col-xs-7 col-md-3 col-lg-1" style="padding-top: 1em;">
                    <img src="~/images/minus_new.png" />
                </div>

                <!-- Availed -->
                <div class="col-xs-6 col-md-3 col-lg-2 text-center">
                    <div class="mainlta">
                        <div class="ltaheading" style="height: 2em; padding-top: 6px; background-color: #F7B40E;">
                            <a data-toggle="tooltip" title="LTA claimed during current year"
                               style="color: white; text-decoration: underline;">Availed</a>
                        </div>
                        <div style="padding-top: 1em;">
                            <span id="lblavailaed" class="ltaval">@Model.Availed</span>
                        </div>
                    </div>
                </div>

                <div class="col-xs-7 col-md-3 col-lg-1" style="padding-top: 1em;">
                    <img src="~/images/equal_new.png" />
                </div>

                <!-- Balance -->
                <div class="col-xs-6 col-md-3 col-lg-2 text-center">
                    <div class="mainlta">
                        <div class="ltaheading" style="height: 2em; padding-top: 8px; background-color: #F34C49;">
                            <a style="color: white; text-decoration: underline;">Balance</a>
                        </div>

    </div>
   </div>
            </div>
   </div>
   </div>
<div class="row" style="vertical-align: top; margin-left: 10px; margin-right: 10px;">
    <!-- LTA Payment Details -->
    <div class="col-xs-12 col-md-3 col-lg-4 text-center">
        <div class="panel-group">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h2 class="panel-title">LTA Payment Details (till date)</h2>
                </div>
                <div class="panel-body" style="padding-bottom:0px;">
                    @if (Model.LtaPayments == null || !Model.LtaPayments.Any())
                    {
                        <div class="alert alert-info">No LTA have been claimed till date</div>
                    }
                    else
                    {
                        <table class="table table-bordered table-condensed table-hover">
                            <thead>
                                <tr>
                                    <th>S.No.</th>
                                    <th>Date (mm.yyyy)</th>
                                    <th>Amount (Rs.)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.LtaPayments.Count; i++)
                                {
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@Model.LtaPayments[i].Date.ToString("MM.yyyy")</td>
                                        <td>@Model.LtaPayments[i].Amount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- LTA Request Details -->
    <div class="col-xs-12 col-md-3 col-lg-6 text-center">
        <div class="panel-group">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h2 class="panel-title">LTA Request Details (till date)</h2>
                </div>
                <div class="panel-body" style="padding-bottom:0px;">
                    @if (Model.LtaRequests == null || !Model.LtaRequests.Any())
                    {
                        <div class="alert alert-info">No LTA request found till date</div>
                    }
                    else
                    {
                        <table class="table table-bordered table-condensed table-hover">
                            <thead>
                                <tr>
                                    <th>S.No.</th>
                                    <th>LTA Type</th>
                                    <th>Applied Year</th>
                                    <th class="hidden-xs">Leave Period</th>
                                    <th>Applied By</th>
                                    <th class="hidden-xs">Applied Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.LtaRequests.Count; i++)
                                {
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@Model.LtaRequests[i].LTATYPEDES</td>
                                        <td>@Model.LtaRequests[i].APPLIED_YEAR</td>
                                        <td class="hidden-xs">@Model.LtaRequests[i].LEAVEPERIOD</td>
                                        <td>@Model.LtaRequests[i].APPLYBY</td>
                                        <td class="hidden-xs">@Model.LtaRequests[i].DATEAPPLIED.ToString("dd-MM-yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</div>
<div class="well well-sm">
    <table border="0" style="width: 100%;">
        <tr>
            <td style="height: 20px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td style="width: 20px; vertical-align: middle; text-align: center;" align="left">
                                <a title="Back" href="../../Home/Home">
                                    <img src="../../images/icon_back.gif" border="0" alt="" />
                                </a>
                            </td>
                            <td style="vertical-align: middle; font-size: 15px;">
                                <span><a title="Back" href="../../Home/Home">Back</a></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>
<div id="ajaxLoader"></div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $('.homeContent').removeClass('homeContent');

    </script>
}