@using ePortal.ViewModels.APPX
@model EssViewModel.EmployeeAccountStatementViewModel

@{
    Layout = null;
}
<div class="panel-group" style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
@if (ViewBag.div_main_travel == true)
{
    <div class="table-responsive" id="div_main_travel">
        <table id="tbl_travel" class="table table-bordered table-condensed" style="margin-bottom:0px;">
            <thead>
                <tr>
                    <td style="vertical-align: middle;">
                        <div class="panel panel-primary">
                            <div class="panel-heading">
                                <div class="row">
                                    <div class="col-xs-6 col-md-3 col-lg-9" style="text-align: left; vertical-align: middle;">
                                        <h2 class="panel-title">Tour & Travel</h2>
                                    </div>
                                    <div class="col-xs-6 col-md-3" style="text-align: right;">
                                        @* <asp:Label ID="lbltravelrecordcnt" runat="server" CssClass="badge"></asp:Label> *@
                                        <label class="badge">Total Record Found: @Model.TravelRecords.Count</label>
                                        @* <asp:ImageButton ID="travelexcelbtn" runat="server" CssClass="btn" ImageUrl="../../images/Excel.png" OnClick="travelexcelbtn_Click" /> *@  
                                        <img id="travelexcelbtn" src="~/images/Excel.png" alt="Export to Excel" />                                         
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            </thead>
            <tr>
                <td> 
                        @* <div id="div_travel" runat="server"> *@
                        <div id="div_travel">
                            <table class="table table-bordered table-hover table-condensed" style="margin-bottom:0px;">
                                <tr class="bg-info" style="font-weight: bold;">
                                    <th width="8%">Status</th>
                                    <th width="10%">Posting Date</th>
                                    <th width="14%">Tour Period</th>
                                    <th width="10%">
                                        Advance /<br />
                                        Payments
                                    </th>
                                    <th width="10%">Advance Settled</th>
                                    <th width="10%">Cumulative Balance</th>
                                    <th width="13%">Particulars</th>
                                    <th width="25%">Remarks</th>
                                </tr>
                                <tbody>                                           
                                    @for (int i = 0; i < Model?.TravelRecords?.Count; i++)
                                    {
                                        var item = Model.TravelRecords[i];
                                        var rowClass = i % 2 == 0 ? "active" : "";
                                        <tr class="@rowClass">
                                            <td width="8%">@item.STATUS</td>
                                            <td width="10%">@item.PSTNG_DATE</td>
                                            <td width="14%">@item.ALLOC_NMBR</td>
                                            <td width="10%">@item.DEBIT</td>
                                            <td width="10%">@item.CREDIT</td>
                                            <td width="10%">@item.CUMULATIVE_BALANCE</td>
                                            <td width="13%">@item.PARTICULAR</td>
                                            <td width="25%">@item.ITEM_TEXT</td>
                                        </tr>
                                    }                                            
                                </tbody>
                                @* <asp:Repeater ID="Rep_Travel" runat="server"> *@
                                @*     <ItemTemplate> *@
                                @*         <tr class="active"> *@
                                @*             <td width="8%"><%# Eval("STATUS")%></td> *@
                                @*             <td width="10%"><%# Eval("PSTNG_DATE")%></td> *@
                                @*             <td width="14%"><%# Eval("ALLOC_NMBR")%></td> *@
                                @*             <td width="10%"><%# Eval("DEBIT")%></td> *@
                                @*             <td width="10%"><%# Eval("CREDIT")%></td> *@
                                @*             <td width="10%"><%# Eval("CUMULATIVE_BALANCE")%></td> *@
                                @*             <td width="13%"><%# Eval("PARTICULAR")%></td> *@
                                @*             <td width="25%"><%# Eval("ITEM_TEXT")%></td> *@
                                @*         </tr> *@
                                @*     </ItemTemplate> *@
                                @*     <AlternatingItemTemplate> *@
                                @*         <tr> *@
                                @*             <td width="8%"><%# Eval("STATUS")%></td> *@
                                @*             <td width="10%"><%# Eval("PSTNG_DATE")%></td> *@
                                @*             <td width="14%"><%# Eval("ALLOC_NMBR")%></td> *@
                                @*             <td width="10%"><%# Eval("DEBIT")%></td> *@
                                @*             <td width="10%"><%# Eval("CREDIT")%></td> *@
                                @*             <td width="10%"><%# Eval("CUMULATIVE_BALANCE")%></td> *@
                                @*             <td width="13%"><%# Eval("PARTICULAR")%></td> *@
                                @*             <td width="25%"><%# Eval("ITEM_TEXT")%></td> *@
                                @*         </tr> *@
                                @*     </AlternatingItemTemplate> *@
                                @* </asp:Repeater> *@
                            </table>
                        </div>                               
                </td>
        </tr>
    </table>
</div>
}
@* <%----------------------------------------------End - Travel-----------------------------------------%> *@

@* <%----------------------------------------------Start - Advance-Travel Ticket-----------------------------------------%> *@
    @if (ViewBag.div_main_ticket == true)
{
  <div class="table-responsive" id="div_main_ticket">
    <table id="tbl_ticket" class="table table-bordered table-condensed" style="margin-bottom:0px;">
        <thead>
            <tr>
                <td style="vertical-align: middle;">
                    <div class="panel panel-primary">
                        <div class="panel-heading">
                            <div class="row">
                                <div class="col-xs-6 col-md-3 col-lg-9" style="text-align: left; vertical-align: middle;">
                                    <h2 class="panel-title">Ticket Settlement</h2>
                                </div>
                                <div class="col-xs-6 col-md-3" style="text-align: right;">
                                            <label class="badge">@ViewBag.lblticketrecordcnt</label>
                                            <img id="ticketexcelbtn" src="~/images/Excel.png" alt="Export to Excel" />
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        </thead>
        <tr>
            <td>
                @if (ViewBag.Nodatadiv_Ticket == true)
                {
                    <div class="label label-default">No Data Available</div>
                }

                @if (ViewBag.div_ticket == true)
                {
                    <div id="div_ticket" class="@ViewBag.div_ticket_class">
                        <table class="table table-bordered table-hover table-condensed" style="margin-bottom:0px;">
                            <tr class="bg-info" style="font-weight: bold;">
                                <th width="8%">Status</th>
                                <th width="10%">Posting Date</th>
                                <th width="14%">Ticket No.</th>
                                <th width="10%">Ticket Fare</th>
                                <th width="10%">Ticket Settled</th>
                                <th width="10%">Cumulative Balance</th>
                                <th width="13%">Particulars</th>
                                <th width="25%">Remarks</th>
                            </tr>
                            <tbody>
                                @if (Model?.TicketList != null)
                                {
                                    @for (int i = 0; i < Model.TicketList.Count; i++)
                                    {
                                        var ticket = Model.TicketList[i];
                                        var rowClass = i % 2 == 0 ? "active" : "";
                                        <tr class="@rowClass">
                                            <td width="8%">@ticket.STATUS</td>
                                            <td width="10%">@ticket.PSTNG_DATE</td>
                                            <td width="14%">@ticket.ALLOC_NMBR</td>
                                            <td width="10%">@ticket.DEBIT</td>
                                            <td width="10%">@ticket.CREDIT</td>
                                            <td width="10%">@ticket.CUMULATIVE_BALANCE</td>
                                            <td width="13%">@ticket.PARTICULAR</td>
                                            <td width="25%">@ticket.ITEM_TEXT</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </td>
        </tr>
    </table>
</div>
}
@* <%----------------------------------------------End - Advance-Travel Ticket-----------------------------------------%> *@

