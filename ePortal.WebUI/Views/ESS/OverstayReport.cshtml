<div id="ajaxLoader"></div>
@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $('.homeContent').removeClass('homeContent');

         function GetReportList(crnt) {
                var month = $('#cmbmonth').val();
                var year = $('#cmbyear').val();

                // Validation: check if month is selected
                if (!month) {
                    sweetAlert("", "Please select month from the dropdown.", "warning");
                    return;
                }

                // Validation: check date against 01-Oct-2013
                var validationDate = new Date(2013, 9, 1); // months are 0-based (9 = October)
                var currDate = new Date(year, parseInt(month) - 1, 1);

                if (currDate < validationDate) {
                    sweetAlert("", "Date must be greater than 01-Oct-2013.", "warning");
                    return; 
                }

            var data = {
                PersonnelNumber: $('#txtpersonelnumber').val(),
                FullName: $('#cmbemp').val(),//$('#lblfullname').text(),
                cmbmonth : month,
                cmbyear : year,
                ReportOption: $('input[name="ReportOption"]:checked').val(),
                CurrDate : currDate,
                ValidationDate : validationDate
                }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/ESS/OverstayReport",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    // alert("+++++++++HI" + data);
                    $('#div_append').html(data);
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                    error: function (xhr, status, error) {
                // Show raw error info
                sweetAlert("Oops...",
                    "Status: " + status + "\nError: " + error + "\nResponse: " + xhr.responseText,
                    "error");
                // error: function () {
                //     sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

    </script>

    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#Button1').on('click', function (event) {
                event.preventDefault();
                GetReportList($(this));
            });
        });
    </script>
}
