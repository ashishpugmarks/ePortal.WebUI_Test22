    </div>
    <div id="div_append_error"></div>
    <div id="div_append"></div>
</div>
<div id="ajaxLoader"></div>
@section Scripts {
    <script src="~/js/jquery.dataTables.js"></script>
    <script nonce="@Context.Items["ScriptNonce_4"]">
        $('.homeContent').removeClass('homeContent');

          function EmpBlockProcessSave(crnt) {
            var strecode1 = $('#txtEmployeeCode').val();
            var Reason = $('#txtBlockReason').val();

            if (strecode1 === "") {
               sweetAlert("", "Please Enter Employee Code.", "warning");
                return;
            }
            if (!Reason.trim()) {
               sweetAlert("", "Please enter a reason to Block.", "warning");
               return;
            }

            var data = {
                EmpCode: strecode1,
                BlockReason: Reason
            };

            $.ajax({
                type: "POST",
                url: "/ESS/EmployeeBlockProcess",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                dataType: "json",   // <-- expect JSON now
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                success: function (response) {
                    if (response.flag === 1) {
                       sweetAlert("", "Blocked Successfully.", "success");
                    } else if (response.flag === 2) {
                       sweetAlert("", "Blocked Failed.", "error");
                    } else {
                       sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                   sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
        function initializeTables() {
            var $tblDetail = $('#tblDetail');
            if ($.fn.DataTable.isDataTable($tblDetail)) $tblDetail.DataTable().destroy();

            $tblDetail.DataTable({
              pageLength: 10,
              lengthChange: false,
              searching: true,
              order: [[1, 'desc']],
              columnDefs: [{
                targets: 1,
                render: function (data, type, row) {
                  if (type === 'sort' || type === 'type') {
                    var m = moment(data, 'DD-MMM-YYYY', true);
                    return m.isValid() ? m.format('YYYY-MMM-DD') : data;
                  }
                  return data;
                }
              }]
            });
        }
        function GetEmpBlockGetails() {
            $.ajax({
                type: "GET",
                url: "/ESS/EmployeeBlockProcessDetail",
                dataType: "html", 
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                success: function (data) {
                    $('#div_append').html(data);
                    initializeTables();
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                   sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function DownloadFile() {
            $.ajax({
                type: "GET",
                url: "/ESS/DownloadFile",
                xhrFields: { responseType: 'blob' },
                success: function (data) {
                    if (data.flag == 1) {

                    }else if(data.flag == -1) {
                        sweetAlert("", "File not found.", "warning");
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "File not found.!", "warning");
                }
            });
        }

        function UploadFile() {
            $('#div_append_error').html('');
            var fileInput = document.getElementById("FileUpload1");

            if (!fileInput) {
                sweetAlert("", "Please select a file to upload.", "warning");
                return;
            }

            var file = fileInput.files.length > 0 ? fileInput.files[0] : null;

            if (!file || file.size === 0) {
                sweetAlert("", "Please select a file to upload.", "warning");
                return;
            }

            var formData = new FormData();
            formData.append("file", file);

            $.ajax({
                type: "POST",
                url: "/ESS/EmployeeBlockProcessUploadFile",
                data: formData,
                processData: false,
                contentType: false,
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                success: function (data) {
                    if (data.status == 'success') {
                        sweetAlert("", data.message, "success");
                    }
                    else{
                        $('#div_append_error').html(data.message);
                    }
                    GetEmpBlockGetails();
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        // document.querySelectorAll('input[name="Options"]').forEach(rb => {
        //     rb.addEventListener('change', function() {
        //         document.getElementById('EmployeeCodePanel').style.display = this.value === 'Single' ? 'block' : 'none';
        //         document.getElementById('DownloadPanel').style.display = this.value === 'Multiple' ? 'block' : 'none';
        //     });
        // });
        document.querySelectorAll('input[name="Options"]').forEach(rb => {
            rb.addEventListener('change', function() {
                const employeePanel = document.getElementById('EmployeeCodePanel');
                const downloadPanel = document.getElementById('DownloadPanel');

                if (employeePanel) {
                    employeePanel.style.display = this.value === 'Single' ? 'block' : 'none';
                }
                if (downloadPanel) {
                    downloadPanel.style.display = this.value === 'Multiple' ? 'block' : 'none';
                }
            });
        });
    </script>

    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#Button1').on('click', function (event) {
                event.preventDefault();
                //validateForm();
                EmpBlockProcessSave();
            });
             $('#Button3').on('click', function (event) {
               GetEmpBlockGetails();
            });
            $('#UploadButton').on('click', function (event) {
               UploadFile();
            });
        });
    </script>
}
