                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right">
                                <span id="lblattireallowance">@Model.AttireAllowance</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">
                                Total of any other exemption u/s 10:
                            </td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right">
                                <span id="lbltotalanyexemption">@Model.TotalAnyOtherExemption</span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">
                                Total of exemption : {Total of exemption u/s 10 + Total of any other exemption u/s 10}
                            </td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lbltotexemption">@Model.TotalExemption</span>
                            </td>
                        </tr>

