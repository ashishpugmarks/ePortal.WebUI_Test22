                                <span id="lblhrareceived">@Model.HRAReceived</span><br />
                                <span id="lblrentbasic">@Model.RentBasic</span><br />
                                <span id="lblrentmetro">@Model.RentMetro</span>
                            </td>
                            <td colspan="3" style="font-family: Calibri; font-size: 10px; text-align:right">
                                <span id="lblfinalhra">@Model.FinalHRA</span>
