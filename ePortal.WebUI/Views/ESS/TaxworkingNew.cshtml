                                <tr>
                                    <td colspan="5" style="font-family:Calibri; font-size:10px;">@item.Header</td>
                                    <td></td>
                                    <td colspan="2" style="font-family:Calibri; font-size:10px;">@item.Proposed</td>
                                    <td colspan="2" style="font-family:Calibri; font-size:10px;">@item.Actual</td>
