                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">
                                Income (or admissible loss) from House Property
                            </td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lblhouseproperty">@Model.HouseProperty</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">
                                Income from Other Sources
                            </td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lblincomeothsources">@Model.IncomeOtherSources</span>
                            </td>
                        </tr>

