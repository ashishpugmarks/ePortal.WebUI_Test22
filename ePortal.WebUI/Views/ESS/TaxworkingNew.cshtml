                                <span id="lblpempsalary">@Model.PreviousEmploymentSalary</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="14" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;"></td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">
                                Gross Salary
                            </td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right">
                                <span id="lblgrosssalary">@Model.GrossSalary</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="14" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">
                                Less Allowance exempt u/s 10
                            </td>
                        </tr>

                        <tr>
                            <td colspan="5" style="font-family: Calibri; font-size: 10px;">
                                Rent Details &nbsp;&nbsp;&nbsp;<span id="lblrentdtl">@Model.RentDetails</span>
                            </td>
                            <td colspan="4" style="font-family: Calibri; font-size: 10px;">
                                Location :- <span id="lblrentlocation">@Model.RentLocation</span>
                            </td>
                            <td colspan="5" style="font-family: Calibri; font-size: 10px;">
                                <span id="lblrentamt">@Model.RentAmount</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="2" style="font-family: Calibri; font-size: 10px;">HRA</td>
                            <td colspan="2" style="font-family: Calibri; font-size: 10px;">Least is Exempt</td>
                            <td colspan="5" style="font-family: Calibri; font-size: 10px;">
                                1. HRA Received<br />
                                2. Rent Paid-10% of Basic Salary<br />
                                3. 40% or 50% of Basic (50% for Metro & 40% for non metro)
                            </td>
