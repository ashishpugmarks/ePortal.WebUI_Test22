                                <span id="lbltotalexemption">@Model.TotalExemption</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="14" style="font-family: Calibri; font-size: 10px;">Any other exemption u/s 10:</td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; font-size: 10px;">
                                Education Allow: Exempt upto Rs 100 Per Month Per Child (Upto 2 Children)
                            </td>
                            <td colspan="2" style="font-family: Calibri; font-size: 10px; text-align:right">
                                <span id="lbleducationallow">@Model.EducationAllowance</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">
                                Attire Allowance :
