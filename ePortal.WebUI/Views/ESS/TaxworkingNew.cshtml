                                <span id="lbltaxwithsurcharge">@Model.TaxWithSurcharge</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">Tax deducted By Previous Employer</td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lbltaxdedpe">@Model.TaxDedPE</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">Tax deducted on Other Sources</td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lbltaxdedothsources">@Model.TaxDedOtherSources</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">Tax deducted by HMSI</td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lbltaxdedhmsi">@Model.TaxDedHMSI</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">YTD Tax Paid till Previous Month</td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lblytdtax">@Model.YTDTax</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">Balance tax Payable</td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lblblancetax">@Model.BalanceTax</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">Tax for current month</td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lbltaxcorrmonth">@Model.TaxCurrentMonth</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">Tax Liability With Surcharge on one Time Payment</td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lbltaxliabiltyonetime">@Model.TaxLiabilityOneTime</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">Tax on Current And Projected Month (System Generated)</td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lbltaxprojmonth">@Model.TaxProjectedMonth</span>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

        </table>
    </div>
</body>
</html>