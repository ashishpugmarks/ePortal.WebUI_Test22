                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family:Calibri; font-size:10px;">One Time Payment :</td>
                            <td colspan="2" style="font-family:Calibri; font-size:10px; text-align:right;">
                                <span id="lblonetimepayment">@Model.OneTimePayment</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family:Calibri; font-size:10px;">Tax Thereon :</td>
                            <td colspan="2" style="font-family:Calibri; font-size:10px; text-align:right;">
                                <span id="lbltaxthereon">@Model.TaxThereon</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">Tax Liability for full year</td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lbltaxliability">@Model.TaxLiability</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="14" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">Rebate under section 87A</td>
