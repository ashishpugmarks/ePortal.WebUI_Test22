                                <span id="lblptaxded">@Model.ProfessionalTaxDeduction</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; font-size: 10px;">Entertainment Allowance</td>
                            <td colspan="2" style="font-family: Calibri; font-size: 10px; text-align:right;">
                                <span id="lblentallowance">@Model.EntertainmentAllowance</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; border-top: solid 1px gray; font-size: 10px;">
                                Total deduction u/s 16
                            </td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; border-top: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lbltotalded16">@Model.TotalDeduction16</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">
                                Income chargeable under the head Salaries
