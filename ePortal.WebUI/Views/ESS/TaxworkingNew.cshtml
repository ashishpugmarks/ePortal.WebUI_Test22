                            </td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lblsurcharge">@Model.Surcharge</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">
                                @* TO BE CHECK Health & Education Cess @ 4% *@
                                Health & Education Cess 4%
                            </td>
                            <td colspan="2" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px; text-align:right;">
                                <span id="lblhealtcess">@Model.HealthCess</span>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="12" style="font-family: Calibri; border-bottom: solid 1px gray; font-size: 10px;">Taxability with Surcharge and Health & Education Cess</td>
