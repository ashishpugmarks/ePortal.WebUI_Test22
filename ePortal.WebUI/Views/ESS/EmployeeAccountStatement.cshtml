    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#searchbtn').on('click', function () {
                 //searchbtn_Click($(this));
                GetReportList($(this));
                return false;
            });
              $(document).on('click', '#travelexcelbtn', function (e) {
                    e.preventDefault();
                    travelexcelbtn($(this));
              });
                $(document).on('click', '#ticketexcelbtn', function (e) {
                    e.preventDefault();
                    ticketexcelbtn($(this));
                });
                $(document).on('click', '#productloanexcelbtn', function (e) {
                    e.preventDefault();
                    productloanexcelbtn($(this));
                });
                $(document).on('click', '#medicallloanexcelbtn', function (e) {
                    e.preventDefault();
                    medicallloanexcelbtn($(this));
                });
                $(document).on('click', '#Imprestexcelbtn', function (e) {
