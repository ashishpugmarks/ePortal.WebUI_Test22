@using ePortal.ViewModels.APPX
@model EssViewModel.HLISubsidyStatementViewModel

@{
    Layout = null;
}
   
<div class="panel-group" style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
    <div class="panel panel-info" style="height: 300px; overflow-y: auto;">
        <table class="table table-bordered table-condensed table-hover" id="tbHLIReport">
            @if (Model?.HLISubsidyRecords != null && Model.HLISubsidyRecords.Any())
            {
                <thead class="bg-info text-center">
                    <tr>
                        <th>Employee Code</th>
                        <th>Name Of Employee</th>
                        <th>Designation</th>
                        <th>Bank Name</th>
                        <th>Loan Against Property</th>
                        <th>Loan Sanction Period (in Months)</th>
                        <th>Calculation Date</th>
                        <th>Installment</th>
                        <th>Interest Rate</th>
                        <th>Principal Beginning Balance</th>
                        <th>Monthly Interest</th>
                        <th>Monthly Principal</th>
                        <th>EMI</th>
                        <th>Principal Ending Balance</th>
                        <th>50% Interest Subsidy Paid as per SBI Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.HLISubsidyRecords)
                    {
                        <tr class="text-center">
                            <td>@item.KONTRH</td>
                            <td style="white-space: nowrap;">@item.NAME</td>
                            <td>@item.BU_SORT1</td>
                            <td>@item.ZUOND</td>
                            <td>@item.LOANPROPADD</td>
                            <td>@item.REFER</td>
                            <td>@item.DVALUT.ToString("dd-MM-yyyy")</td>
                            <td>@item.DVALUT1</td>
                            <td>@item.PKOND</td>
                            <td>@item.BBASIS</td>
                            <td>@item.MI</td>
                            <td>@item.MP</td>
                            <td>@item.EMI</td>
                            <td>@item.PEB</td>
                            <td>@item.INT_SUB</td>
                        </tr>
                    }
                </tbody>
            }
            else
            {
                <thead>
                    <tr>
                        <th colspan="15" class="text-center" style="color:red; font-size:medium;">
                            No Record Available
                        </th>
                    </tr>
                </thead>
            }
        </table>
    </div>
</div>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
    $('.homeContent').removeClass('homeContent');

    $(document).ready(function () {
                 $("#tbHLIReport").DataTable({
                     "bFilter": false,
                     "bLengthChange": false,
                     "order": [[4, 'asc']], 
                     "columnDefs": [
                         {
                             "searchable": false,
                             "orderable": true,
                             "targets": 6, 
                             "type": 'date'
                         },
                         {
                             "orderable": true,
                             "render": $.fn.dataTable.render.number(',', '', 0, '', ''),
                             "targets": [5]
                         }
                     ]
                 });
             });
</script>