@using ePortal.ViewModels.APPX
@model EssViewModel.PunchReportViewModel

@{
    Layout = null;
}

    <div class="panel-group" style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
        <div class="panel panel-info">
            <table class="table table-bordered table-condensed table-hover">
                <thead class="bg-info text-center">
                    <tr>
                        <th>Action</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Payment Date</th>
                        <th>Payroll Type</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.RemunerationResults != null && Model.RemunerationResults.Count > 0)
                {
                    foreach (var record in Model.RemunerationResults)
                    {                          
                        <tr class="text-center hover-highlight">
                            <td>
                                <button type="button"
                                        class="btn btn-link payslipRowEditing"
                                        data-rowindex="@record.SequenceNumber"
                                        data-seqno="@record.SequenceNumber"
                                        data-paydate="@record.PayDate.ToString("dd/MM/yyyy")">
                                    <img src="~/images/icon_ticketbullet.gif" alt="Payslip" />
                                </button>
                                    @* <form method="post" asp-page-handler="Edit">  *@

                                    @*     <input type="hidden" name="id" value="@record.SequenceNumber" />  *@
                                    @*     <button type="submit" class="btn btn-link">  *@
                                    @*         <img src="~/images/icon_ticketbullet.gif" alt="Payslip" />  *@
                                    @*     </button>  *@
                                    @* </form>  *@
                                </td>
                                <td>@record.FpBegin.ToString("dd.MM.yyyy")</td> 
                                <td>@record.FpEnd.ToString("dd.MM.yyyy")</td> 
                                <td>@record.PayDate.ToString("dd.MM.yyyy")</td> 
                                <td>@record.PayTypeText</td> 
                            </tr>
                        } 
                    } 
                    else 
                    { 
                        <tr> 
                            <td colspan="5" class="text-center text-danger" style="font-size: medium;"> 
                                No Record Available 
                            </td> 
                        </tr> 
                    } 
                    
                </tbody>
            </table>

