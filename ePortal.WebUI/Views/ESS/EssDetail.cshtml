@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Employee Portal - Employee Self Service :: Honda Motorcycle & Scooter India Pvt. Ltd.";
}
@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    .loader {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
        opacity: .7;
    }
</style>
}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">
            Employee Self Service(ESS)
        </div>
    </div>
    <div class="body-content" style="overflow-x:auto!important;">
        <div class="row content" style="margin-left: 5px; margin-right: 10px; margin-top: 10px;">
                        <div class="col-sm-3">
                            <div class="panel-group">
                                <div class="panel panel-primary">
                                    <div class="panel-heading">
                                        <h2 class="panel-title">
                                            <strong>Personal Detail</strong>
                                        </h2>
                                    </div>
                                    <div class="panel-body">
                                        <div class="row">


                                            <div class="col-xs-6 col-sm-5 col-md-5" style="text-align: center;">
                                                <a href="EmployeeAccountStatement" class="thumbnail">
                                                    <img src="../../images/ESS/EMPLOYEE_ACC_STATEMENT.png" alt="Employee Account Statement">
                                                    <h3>Emp. Acct. Statement</h3>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="panel-group">
                                <div class="panel panel-primary">
                                    <div class="panel-heading">
                                        <h2 class="panel-title">
                                            <strong>Tax Details</strong>
                                        </h2>
                                    </div>
                                    <div class="panel-body" style="text-align:center;">
                                        <div class="row">
                                            <div class="col-xs-12 col-md-5 col-lg-5" style="text-align: center;">
                                                <a href="Form16details" class="thumbnail">
                                                    <img src="../../images/ESS/Form16_1.png" alt="Form16">
                                                    <h3>Form 16</h3>
                                                </a>
                                            </div>
                                            <div class="col-xs-12 col-md-5 col-lg-5" style="text-align: center;">

                                                <a href="TaxworkingDetails" class="thumbnail" >
                                                    <img src="../../images/ESS/TAX.png" alt="Tax Working Report">
                                                    <h3>Tax Working Report</h3>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="panel-group">
                                <div class="panel panel-primary">
                                    <div class="panel-heading">
                                        <h2 class="panel-title">
                                            <strong>Remuneration Detail</strong>
                                        </h2>
                                    </div>
                                    <div class="panel-body">
                                        <div class="row">
                                            <div class="col-xs-6 col-md-3 col-lg-3"style="text-align: center;">
                                                <a href="SalarySlipAnnexure" class="thumbnail">
                                                    <img src="../../images/ESS/CTCICON.png" alt="CTC">
                                                    <h3>CTC Details</h3>
                                                </a>
                                            </div>
                                            <div class="col-xs-6 col-md-3 col-lg-3" style="text-align: center;">
                                                <a href="Remuneration" class="thumbnail">
                                                    <img src="../../images/ESS/SALARY.png" alt="Salary">
                                                    <h3>Salary Details</h3>
                                                </a>
                                            </div>


                                            <div class="col-xs-6 col-md-3 col-lg-3" style="text-align: center;">
                                                <a href="RealtimeAccess_PunchReport" class="thumbnail">
                                                    <img src="../../images/ESS/cardpunch1.png" alt="Salary">
                                                    <h3>Access/Punch Report</h3>
                                                </a>
                                            </div>
                                            @* <%--Change done by aumento as on 30092023 for SR54909-----------------------%> *@
                                            <div class="col-xs-6 col-md-3 col-lg-3" style="text-align: center;">
                                                <a href="HLISubsidyStatement" class="thumbnail">
                                                    <img src="../../images/ESS/Home.png" alt="Home Loan Interest Subsidy Report">
                                                    <h3>HLI Subsidy</h3>
                                                </a>
                                            </div>
                                            @* <%--------------------------------------------------------------------------%> *@
                                        </div>
                                        @* <%--START :: ADDED BY AUMENTO :: SR90701-----------------------%> *@
                                        <div class="row">
                                            <div class="col-xs-6 col-md-3 col-lg-3" style="text-align: center;">
                                                <a href="OverstayReport" class="thumbnail">
                                                    <img src="../../images/ESS/ATTENDANCE.png" alt="Salary">
                                                    <h3>Attendance Report</h3>
                                                </a>
                                            </div>
                                        </div>
                                        @* <%--END :: ADDED BY AUMENTO :: SR90701----------------------------%> *@
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
    </div>
</div>
<div class="alert alert-info" style="margin-left: .5em; margin-right: 1em;">
    <span class="glyphicon glyphicon-info-sign" style="vertical-align: middle; font-size: 12px;" aria-hidden="true"></span>
    <span class="sr-only">Info:</span>
    <span style="vertical-align: middle; font-size: 12px;">        
        Tax Working Report is not available for period 22nd to 28th of every month.
    </span>
</div>
<div style="margin-left: .5em; margin-right: 1em;" class="well well-sm">
    <table border="0" style="width: 100%;">
        <tr>
            <td style="height: 20px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td style="width: 20px; vertical-align: middle; text-align: center;" align="left">
                                <a title="Back" href="../../Home/Home">
                                    <img src="../../images/icon_back.gif" border="0" alt="" />
                                </a>
                            </td>
                            <td style="vertical-align: middle; font-size: 15px;">
                                <span><a title="Back" href="../../Home/Home">Back</a></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>
<div id="ajaxLoader"></div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');

    </script>
}