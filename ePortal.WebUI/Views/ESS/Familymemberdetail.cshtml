@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Family Member : Details";
}
@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    .loader {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
        opacity: .7;
    }
</style>
}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">
            Family Member/Dependent : Details
        </div>
    </div>
    <div id="div_message" style="margin:5px 10px; vertical-align: middle;"></div>

    <div class="panel-group" style="margin:10px;">
        <div class="panel panel-primary" style="background-color: #edf6ff;">
            <div class="panel-body">
                <div class="row">
                    <div class="col-xs-6 col-md-3 col-lg-5 text-end">
                        <span>Associate Name:</span>
                    </div>
                    <div class="col-xs-6 col-md-3 col-lg-5 text-start">
                        <span id="lblfullname" style="font-weight:bold;">@Model.FullName</span>
                        <input id="txtpersonelnumber" type="text"
                               value="@Model.PersonnelNumber"
                               class="form-control"
                               style="font-weight:bold; border:none;"
                               disabled hidden />
                    </div>
                </div>
            </div>

            <div class="panel panel-info">
                <div class="panel-body">
                    <table class="table table-bordered table-hover">
                        <tr class="active">
                            <td style="text-align: right; width: 5em;">Member Type</td>
                            <td style="text-align: left;">
                                <span id="lblfamilymember" class="text-primary">@Model.MemberType</span>
                            </td>
                        </tr>
                        <tr class="info">
                            <td style="text-align: right; width: 10em;">First Name</td>
                            <td style="text-align: left;">
                                <span id="lblfirstname" class="text-primary">@Model.FirstName</span>
                            </td>
                        </tr>
                        <tr class="active">
                            <td style="text-align: right; width: 10em;">Last Name</td>
                            <td style="text-align: left;">
                                <span id="lbllastname" class="text-primary">@Model.LastName</span>
                            </td>
                        </tr>
                        <tr class="info">
                            <td style="text-align: right; width: 10em;">Gender</td>
                            <td style="text-align: left;">
                                <span id="lblgender" class="text-primary">@Model.Gender</span>
                            </td>
                        </tr>
                        <tr class="active">
                            <td style="text-align: right; width: 10em;">Date Of Birth</td>
                            <td style="text-align: left;">
                                <span id="lbldateofbirth" class="text-primary">@Model.DateOfBirth.ToString("yyyy-MM-dd")</span>
                            </td>
                        </tr>
                        <tr class="info">
                            <td style="text-align: right; width: 10em;">City Of Birth</td>
                            <td style="text-align: left;">
                                <span id="lblcityofbirth" class="text-primary">@Model.CityOfBirth</span>
                            </td>
                        </tr>
                        <tr class="active">
                            <td style="text-align: right; width: 10em;">Nationality</td>
                            <td style="text-align: left;">
                                <span id="lblnationality" class="text-primary">@Model.Nationality</span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<<div class="well well-sm">
    <table border="0" style="width: 100%;">
        <tr>
            <td style="height: 20px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td style="width: 20px; vertical-align: middle; text-align: center;" align="left">
                                <a title="Back" href="../../Home/Home">
                                    <img src="../../images/icon_back.gif" border="0" alt="" />
                                </a>
                            </td>
                            <td style="vertical-align: middle; font-size: 15px;">
                                <span><a title="Back" href="../../Home/Home">Back</a></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>
<div id="ajaxLoader"></div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $('.homeContent').removeClass('homeContent');

    </script>
}