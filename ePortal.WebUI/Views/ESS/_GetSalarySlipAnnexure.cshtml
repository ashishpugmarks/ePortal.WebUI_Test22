        <table id="tbl_SalaryAdvance" style="width:100%">
            <tr id="tr_EportalDetail">
                <td colspan="2" style="width:100%;">
                    <table class="table table-bordered table-condensed table-hover">
                    @if (Model?.SalaryRows?.Count == null)
                        {
                            <tr style="color:#274D14;background-color:#F5FFF0;font-family:Calibri;height:20px;">
                                <td>No compensation structure exist in selected Ki</td>
                            </tr>
                        }
                        else
                        { 
                            <thead class="bg-info text-center">
                                <tr >
                                    <th>View</th>
                                    <th>From Date</th>
                                    <th>To Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < (Model?.SalaryRows?.Count ?? 0); i++)
                                {
                                    var row = Model.SalaryRows[i];
                                    <tr class="active hover-row">
                                        <td class="text-center">
                                            <button type="button"
                                                    class="btn btn-link salaryRowEditing"
                                                    data-rowindex="@i">
                                                <img src="~/images/icon_ticketbullet.gif" alt="View" />
                                            </button>
                                        </td>
                                        <td class="hover-cell">@row.StartDate</td>
                                        <td>@row.EndDate</td>
                                        <td>@row.ActionDesc</td>
                                    </tr>
                                }
                            </tbody>
                       
                        }
                    </table>
                </td>
            </tr>
        </table>
