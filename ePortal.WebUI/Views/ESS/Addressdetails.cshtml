@using ePortal.ViewModels.APPX
@model EssViewModel.AddressdetailsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Address : Details";
}
@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    .loader {
    position: fixed;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    z-index: 9999;
    background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
    opacity: .7;
    }

</style>
}
<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">
            Address : View Detail
        </div>
    </div>

    <div class="body-content" style="overflow-x:auto!important;"> 

<div id="div_message" style="margin:10px; vertical-align:middle;"></div>

<div class="panel-group" style="margin:10px;">
    <div class="panel panel-primary">
        <div class="panel-body">
                    <table class="table table-bordered table-hover" style="width: 100%;">
                        <tr class="active">
                            <td style="text-align: right;">Full Name</td>
                            <td style="text-align: left;">
                                <span id="lblfullname" class="text-primary font-weight-bold">@Model.FullName</span>
                                <input id="txtpersonelnumber" asp-for="PersonalNumber" class="form-control"
                                       hidden disabled />
                            </td>
                            <td style="text-align: right;">C/O</td>
                            <td style="text-align: left;">
                                <span id="lblco" class="text-primary font-weight-bold">@Model.Co</span>
                            </td>
                        </tr>
                        <tr class="info">
                            <td style="text-align: right;">Valid From</td>
                            <td style="text-align: left;">
                                <span id="lblvaildfrom" class="text-primary font-weight-bold">
                                    @Model.ValidFrom?.ToString("dd-MMM-yyyy")
                                </span>
                            </td>
                            <td style="text-align: right;">Valid To</td>
                            <td style="text-align: left;">
                                <span id="lblendfrom" class="text-primary font-weight-bold">
                                    @Model.ValidTo?.ToString("dd-MMM-yyyy")
                                </span>
                            </td>
                        </tr>
                        <tr class="active">
                            <td style="text-align: right;">Street/House No.</td>
                            <td style="text-align: left;" colspan="3">
                                <span id="lblstreetno" class="text-primary font-weight-bold">@Model.StreetNo</span>
                            </td>
                        </tr>
                        <tr class="info">
                            <td style="text-align: right;">City</td>
                            <td style="text-align: left;">
                                <span id="lblcity" class="text-primary font-weight-bold">@Model.City</span>
                            </td>
                            <td style="text-align: right;">Postal Code</td>
                            <td style="text-align: left;">
                                <span id="lblpostalcode" class="text-primary font-weight-bold">@Model.PostalCode</span>
                            </td>
                        </tr>
                        <tr class="active">
                            <td style="text-align: right;">District</td>
                            <td style="text-align: left;">
                                <span id="lbldirstrict" class="text-primary font-weight-bold">@Model.District</span>
                            </td>
                            <td style="text-align: right;">State</td>
                            <td style="text-align: left;">
                                <span id="lblstate" class="text-primary font-weight-bold">@Model.State</span>
                            </td>
                        </tr>
                        <tr class="info">
                            <td style="text-align: right;">Country</td>
                            <td style="text-align: left;">
                                <span id="lblcountry" class="text-primary font-weight-bold">@Model.Country</span>
                            </td>
                            <td style="text-align: right;">Telephone No.</td>
                            <td style="text-align: left;">
                                <span id="lbltelephoneno" class="text-primary font-weight-bold">@Model.TelephoneNo</span>
                            </td>
                        </tr>
                    </table>
              </div>
    </div>
</div>       
    <div style="margin-left: 1em; margin-right: 1em;" class="well well-sm">
        <table border="0" style="width: 100%;">
            <tr>
                <td style="height: 20px;">
                    <table style="width: 100%;">
                        <tbody>
                            <tr>
                                <td style="width: 20px; vertical-align: middle; text-align: center;" align="left">
                                    <a title="Back" href="../../ESS/EssDetail">
                                        <img src="../../images/icon_back.gif" border="0" alt="" />
                                    </a>
                                </td>
                                <td style="vertical-align: middle; font-size: 15px;">
                                    <span><a title="Back" href="../../ESS/EssDetail">Back</a></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </table>
    </div>
    </div>
</div>

@section Scripts {
    <script>
        $('.homeContent').removeClass('homeContent');          
    </script>
}
