
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "PdfMergeFile";
}
@section Styles{
<style>
    .loader {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
        opacity: .7;
    }

</style>
}

<div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                Image Compress Tool
            </div>
        </div>
        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Image</strong>
                        </h2>
                    </div>
                    <div class="panel-body" style="padding:5px;">
                        <div class="row" style="padding:4px;">
                            @Html.Label("Upload Image", "Upload Image", new { @class = "control-label text-right col-md-1", @style = "width:140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                <input type="file" id="File2" accept="image/jpeg,image/png,application/jpg">
                            </div>

                            @*@Html.Label("DOcument 2nd", new { @class = "control-label text-right col-md-1", @style = "width:140px;margin-top: 7px;" })
                        <div class="col-md-2 col-lg-2" style="width:20.66%;">
                        <input type="file" id="File2" />
                        </div>*@


                        </div>
                    </div>
                    <div class="row" style="padding:2px;">
                        <div class="col-md-12 col-lg-12 text-center">
                            <button id="btnSubmit" onclick="ImageCompress()" class="btn btn-success btn-sm">Compress</button>
                            <button id="btnSubmit" class="btn btn-danger btn-sm"><a href="/PDFMerge/ImageCompressor" style="color:white;">Refresh</a></button>
                        </div>
                        <div class="col-lg-12 col-md-12" style="margin-left:15px;">
                            <b>Note:</b>
                            <ol>
                                <li>1. The maximum compression rate achievable is 90%.</li>

                                <li>2. Only JPG,JPEG and PNG image extensions are allowed for compression.</li>

                                <li>3. The output file generated after compression will be in JPEG format.</li>

                                <li>4. Tool may not be able to compress already compressed files.</li>

                            </ol>
                            <br />
                        </div>
                    </div>
                    @*<div style="padding:2px;">
