         function ImageCompress() {
            //var fileInput = document.getElementById('File1');
          /*  var formdata = new FormData();*/
            //for (var i = 0; i < fileInput.files.length; i++) {
            //    formdata.append(fileInput.files[i].name, fileInput.files[i]);
            //}
             var fileInput = document.getElementById('File2');
             if (fileInput.files.length < 1 || fileInput.files.length == null) {
                 sweetAlert("Oops..", "Kindly upload the document.", "error");
                 return false;
             }

            var formdata = new FormData();
            for (var i = 0; i < fileInput.files.length; i++) {
                formdata.append("Files", fileInput.files[i]);
            }

            $.ajax({
                type: "POST",
                url: "/PDFMerge/ImageCompressor",
                data: formdata,
                contentType: false,
                processData: false,
                dataType: "json",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                success: function (data) {
                    if (data == 1) {
                        sweetAlert("","Image Compressed Successfully.", "success");
                            window.location.href = "@Url.RouteUrl(new { Controller = "PDFMerge", Action = "DownloadImage" })";
                        }
                        else if (data == 0) {
                            sweetAlert("Oops..", "No Record Found.", "error");
                        }
                    },
                    complete: function () {
        @*window.location.href = "@Url.RouteUrl(new { Controller = "PDFMerge", Action = "DeletePdf" })";*@
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
        }
