<div id="ajaxLoader"></div>
@section Scripts {
    <script>
        $('.homeContent').removeClass('homeContent');

        var formdata = new FormData(); //FormData object
        $(document).ready(function () {

            $("#File1").on("change", function () {
                //debugger;
                var fileInput = document.getElementById('File1');
                //Iterating through each files selected in fileInput
                var count = 0;
                for (i = 0; i < fileInput.files.length; i++) {
                    var sfilename = fileInput.files[i].name;
                    var result = sfilename.substring(sfilename.length - 3);
                    if (result != 'pdf' ) {
                        sweetAlert("Oops..", "Only Pdf is allowed.","error");
                        return;
                    }
                    let srandomid = Math.random().toString(36).substring(7);

                    formdata.append(sfilename, fileInput.files[i]);
                    //count += 1;
                    var markup = "<tr id='" + srandomid + "'><td>" + count + "</td> <td>" + sfilename.toString() + "</td> <td><a href='#' onclick='DeleteFile(\"" + srandomid + "\",\"" + sfilename +
                        "\")'><span class='glyphicon glyphicon-remove red'></span></a></td></tr>"; // Binding the file name
                    $("#FilesList tbody").append(markup);
                }
                $('tr').each(function () {
                    var fiTD = $(this).find('td:first');
                    if (fiTD[0] != null) {
                        count += 1
                        fiTD[0].innerText = count;
                        console.log(fiTD[0].innerHTML)
                    }
                });
                chkatchtbl();
            });
        });




        function PdfToDocs() {
            debugger;
            //var fileInput = document.getElementById('File1');
          /*  var formdata = new FormData();*/
            //for (var i = 0; i < fileInput.files.length; i++) {
            //    formdata.append(fileInput.files[i].name, fileInput.files[i]);
            //}
            $.ajax({
                type: "POST",
                url: "/PDFMerge/PDFToDocsConvertor",
                data: formdata,
                contentType: false,
                processData: false,
                dataType: "json",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                success: function (data) {
                    if (data == 1) {
                        sweetAlert("","Converted Successfully.", "success");
                            window.location.href = "@Url.RouteUrl(new { Controller = "PDFMerge", Action = "DownloadPDF" })";
                        }
                        else if (data == 0) {
                            sweetAlert("Oops..", "No Record Found.", "error");
                        }
                    },
                    complete: function () {
        @*window.location.href = "@Url.RouteUrl(new { Controller = "PDFMerge", Action = "DeletePdf" })";*@
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
        }
