@model ePortal.ViewModels.PresidentMsgAPP_TRNViewModel

<!DOCTYPE html>
<html>
<head>
    <script src="~/js/jquery.validate.min.js" nonce="@Context.Items["ScriptNonce_6"]"></script>
    <script src="~/js/jquery.validate.unobtrusive.min.js" nonce="@Context.Items["ScriptNonce_7"]"></script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        $(document).ready(function () {
            $('#btnReject').click(function () {
                debugger;
                var cnfrm = confirm('Are you sure want to reject?');
                if (cnfrm != true) {
                    return false;
                }

            })
        });

    </script>
</head>
<body>
    <div class="body-content">

        @using (Html.BeginForm(new { @onsubmit = "return false" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal" style="width:100%">
                @*<h4>PresidentMsgAPP_TRNViewModel</h4>
                    <hr />*@
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group hidden">
                    @*@Html.LabelFor(model => model.MESSAGEAPP_ID, htmlAttributes: new { @class = "control-label col-md-2" })*@
                    <div class="col-md-10">
                        @Html.HiddenFor(model => model.MESSAGEAPP_ID, new { htmlAttributes = new { @class = "form-control" } })
                        @*@Html.ValidationMessageFor(model => model.MESSAGEAPP_ID, "", new { @class = "text-danger" })*@
                    </div>
                </div>

                <div class="form-group hidden">
                    @*@Html.LabelFor(model => model.PRESIDENTMSG_ID, htmlAttributes: new { @class = "control-label col-md-2" })*@
                    <div class="col-md-10">
                        @Html.HiddenFor(model => model.PRESIDENTMSG_ID, new { htmlAttributes = new { @class = "form-control" } })
                        @*@Html.ValidationMessageFor(model => model.PRESIDENTMSG_ID, "", new { @class = "text-danger" })*@
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.PRESIDENT_TITLE, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.PRESIDENT_TITLE, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        @Html.ValidationMessageFor(model => model.PRESIDENT_TITLE, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.PRESIDENT_NAME, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.PRESIDENT_NAME, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        @Html.ValidationMessageFor(model => model.PRESIDENT_NAME, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.BRIEF, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.BRIEF, new { @class = "form-control", @rows = "2", @readonly = "readonly", style = "max-width:358px" })
                        @Html.ValidationMessageFor(model => model.BRIEF, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.MESSAGE, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.MESSAGE, new { @class = "form-control", @rows = "3", @readonly = "readonly", style = "max-width:358px" })
                        @Html.ValidationMessageFor(model => model.MESSAGE, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.INITIATOR_REMARKS, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.INITIATOR_REMARKS, new { @class = "form-control", @rows = "3", @readonly = "readonly", style = "max-width:358px" })
                        @Html.ValidationMessageFor(model => model.INITIATOR_REMARKS, "", new { @class = "text-danger" })
                    </div>
                </div>
                @*<div class="form-group">
                        @Html.LabelFor(model => model.STATUS, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.STATUS, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.STATUS, "", new { @class = "text-danger" })
                        </div>
                    </div>*@

                @*<div class="form-group">
                        @Html.LabelFor(model => model.INITIATOR_REMARKS, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.INITIATOR_REMARKS, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.INITIATOR_REMARKS, "", new { @class = "text-danger" })
                        </div>
                    </div>*@
                <div class="form-group">
                    @Html.Label("Attachment", "Attachment", htmlAttributes: new { @class = "control-label col-md-4" })
                    @if (Model.ATTACHMENT_NAME != null)
                    {
                        <div class="col-md-8 Attachment">
                            <div class="col-md-11" style="padding:2px; overflow:hidden; vertical-align:middle">
                                <span style="font-weight:bold; font-variant-caps:all-small-caps; color:navy; vertical-align:middle" title="@Html.DisplayFor(model => model.ATTACHMENT_NAME)"> @Html.DisplayFor(model => model.ATTACHMENT_NAME)</span>
                            </div>
                            <div class="col-md-1 pull-right" style="padding:0px">
                                @*<button class="btn btn-sm" title="Click to Remove Existing Document"> @Html.ActionLink(" ", "DeleteDocument", "CorporateNews", new { id = Model.ATTACHMENTID, type = "BANNER" }, new { @class = "glyphicon glyphicon-remove text-primery" })</button>*@
                                <i class="btn-xs" title="Click to DownLoad Existing Document"> @Html.ActionLink(" ", "Download", "PresidentDesk", new { id = Model.PRESIDENTMSG_ID, @onsubmit = "return false" }, new { @class = "glyphicon glyphicon-download text-primery" })</i>
                            </div>
                        </div>
                    }
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.APPAUTH_REMARKS, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.APPAUTH_REMARKS, new { @class = "form-control", style = "max-width:358px" })
                        @Html.ValidationMessageFor(model => model.APPAUTH_REMARKS, "", new { @class = "text-danger" })
                    </div>
                </div>


                <div class="form-group">
                    <div class="col-md-offset-2 col-md-8 text-center">
                        <input type="submit" name="submit" value="Approve" class="btn btn-success" />
                        <input type="submit" name="submit" value="Reject" id="btnReject" class="btn btn-danger" />
                        <input type="button" class="btn btn-secondry" data-dismiss="modal" value="Cancel" />
                    </div>
                </div>
            </div>
        }
    </div>
</body>
</html>
