@model ePortal.ViewModels.PresidentDesk_MSTViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <script src="~/js/jquery.validate.min.js" nonce="@Context.Items["ScriptNonce_6"]"></script>
    <script src="~/js/jquery.validate.unobtrusive.min.js" nonce="@Context.Items["ScriptNonce_7"]"></script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        $(document).ready(function () {
            //debugger;
            $("#Upload_Banner").change(function () {
                var _URL = window.URL || window.webkitURL;
                var file = $(this)[0].files[0];
                var image = new Image();
                image.src = _URL.createObjectURL(file);
                var extension = $(this).val().split('.').pop().toLowerCase();
                var validFileExtensions = ['png', 'jpg', 'jpeg'];
                if ($.inArray(extension, validFileExtensions) == -1) {
                    alert("Sorry!! Upload only 'png', 'jpg', 'jpeg' file")
                    $(this).replaceWith($(this).val('').clone(true));
                    $('#Apply').prop('disabled', true);
                } else {
                    if ($(this).get(0).files[0].size > (131072)) {
                        alert("Sorry!! Max. allowed file size is 128 kb");
                        $(this).replaceWith($(this).val('').clone(true));
                        $('#Apply').prop('disabled', true);
                    }
                    image.onload = function () {
                        var height = this.height;
                        var width = this.width;
                        if (height != 68 && width != 67) {
                            alert("Sorry!! Width and Height must not exceed 67px X 68px");
                            $("#Upload_Banner").replaceWith($("#Upload_Banner").val('').clone(true));
                        }
                        else {
                            $('#Apply').prop('disabled', false);
                        }
                    };
                }
            });

            $('#ACTIVE_FROM').datepicker({
                //format: "yyyy/mm/dd",
                format: 'dd-M-yyyy',
                //todayBtn: "linked",
                startDate: '+0d',
                autoclose: true,
                todayHighlight: true
            });
            $('#ACTIVE_TO').datepicker({
                format: 'dd-M-yyyy',
                //todayBtn: "linked",
                startDate: '+0d',
                autoclose: true,
                todayHighlight: true
            });

            //if (ViewBag.AlertMessage != null) {
            //    alert(ViewBag.AlertMessage);
            //    return false;
            //}
        });


    </script>
</head>
<body>
    <div class="body-content">
        @using (Html.BeginForm("CreatePresident", "PresidentDesk", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @*<h4>PresidentDesk_MSTViewModel</h4>
                    <hr />*@
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @*<div class="form-group">
                        @Html.LabelFor(model => model.PRESIDENT_ID, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.PRESIDENT_ID, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.PRESIDENT_ID, "", new { @class = "text-danger" })
                        </div>
                    </div>*@

                <div class="form-group">
                    @Html.LabelFor(model => model.PRESIDENT_TITLE, htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-5">
                        @*@Html.EditorFor(model => model.PRESIDENT_TITLE, new { htmlAttributes = new { @class = "form-control" } })*@
                        @Html.DropDownListFor(model => model.PRESIDENT_TITLE,
