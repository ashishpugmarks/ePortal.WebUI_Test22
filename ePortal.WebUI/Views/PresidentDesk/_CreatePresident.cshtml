                <div class="form-group">
                    @Html.LabelFor(model => model.PRESIDENT_PHOTO, htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @*<input id="Upload_Banner" type="file" name="file" class="form-control" />*@
                        @Html.TextBoxFor(model => model.PostedFile, new { type = "file", @name = "file", @class = "form-control", @id = "Upload_Banner" })
                        @*@Html.EditorFor(model => model.PRESIDENT_PHOTO, new { htmlAttributes = new { @class = "form-control" } })*@
                        @*@Html.ValidationMessageFor(model => model.PRESIDENT_PHOTO, "", new { @class = "text-danger" })*@
                        @Html.ValidationMessageFor(model => model.PostedFile, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-8 text-center">
                        <input type="submit" value="Create" id="btnSubmit" class="btn btn-success" />
