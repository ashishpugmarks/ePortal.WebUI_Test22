@model ePortal.ViewModels.PresidentDesk_TRNViewModel

<!DOCTYPE html>
<html>
<head>
    <script src="~/js/jquery.validate.min.js" nonce="@Context.Items["ScriptNonce_6"]"></script>
    <script src="~/js/jquery.validate.unobtrusive.min.js" nonce="@Context.Items["ScriptNonce_7"]"></script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        $(document).ready(function () {
            $("#Upload_Banner").change(function () {
                debugger;
                var extension = $(this).val().split('.').pop().toLowerCase();
                var validFileExtensions = ['png', 'jpg', 'jpeg', 'pdf', 'doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx', 'mp4'];

                if ($.inArray(extension, validFileExtensions) == -1) {
                    alert("Sorry!! Upload only 'png', 'jpg', 'jpeg','pdf','doc','docx', 'xls','xlsx','ppt','pptx', 'mp4' file")
                    $(this).replaceWith($(this).val('').clone(true));
                    $('#Apply').prop('disabled', true);
                }
                else {
                    if (extension == "mp4" && $(this).get(0).files[0].size > (32000000)) {
                        alert("Sorry!! Max allowed file size is 30 MB");
                        $(this).replaceWith($(this).val('').clone(true));
                        $('#Apply').prop('disabled', true);
                    }
                    else if ($(this).get(0).files[0].size > (3000000) && extension != "mp4") {
                        alert("Sorry!! Max allowed file size is 3 MB");
                        $(this).replaceWith($(this).val('').clone(true));
                        $('#Apply').prop('disabled', true);
                    } else {
                        $('#Apply').prop('disabled', false);
                    }
                }
            });

            $('#VALID_FROM').datepicker({
                //format: "yyyy/mm/dd",
                format: 'dd-M-yyyy',
                //todayBtn: "linked",
                startDate: '+0d',
                autoclose: true,
                todayHighlight: true
            });
            $('#VALID_TO').datepicker({
                format: 'dd-M-yyyy',
                //todayBtn: "linked",
                startDate: '+0d',
                autoclose: true,
                todayHighlight: true
            });

            $("#btnPreview").on("click", function(){
                openPreview();
            });
        });

        function readBannerURL(input) {
            debugger;
            if (input.files && input.files[0]) {
                //reader.onload = function (e) {
                $('#dwnlink').text(input.files[0].name);
                //};
                //reader.readAsDataURL(input.files[0]);
            }

        }

        function openPreview() {
            var brief = $('#BRIEF').val();
            var Message = $('#MESSAGE').val();
            $('#popsubjectre').html(brief);
            $('#popdescriptionre').text(Message);
            $('#myPresidentModal').modal({ backdrop: "static" });
        }

        $("#pMClose").click(function () {
            $('#myPresidentModal').modal('hide');
        });
    </script>
</head>
<body>
    <div class="body-content" style="padding:0px !important">
        @*<div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
                <div style="padding:8px;">Add New President Message</div>
            </div>*@
        @*<div style="padding-top:20px;">*@
        @using (Html.BeginForm("CreatePresidentMessages", "PresidentDesk", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @*<h4>PresidentDesk_TRNViewModel</h4>
                    <hr />*@
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group">
                    @Html.Label("President:", "President:", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-4">
                        @Html.DropDownListFor(model => model.PRESIDENT_ID, new SelectList(@ViewBag.presidentList, "PRESIDENT_ID", "PRESIDENT_NAME"), "----------- Select -----------", new { @class = "form-control" })
                        @*@Html.EditorFor(model => model.PRESIDENTMSG_ID, new { htmlAttributes = new { @class = "form-control" } })*@
                        @Html.ValidationMessageFor(model => model.PRESIDENT_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Brief:", "Brief:", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.BRIEF, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.BRIEF, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Message:", "Message:", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.MESSAGE, new { @class = "form-control", @rows = "4", @style = "max-width:369px" })
                        @Html.ValidationMessageFor(model => model.MESSAGE, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Valid From:", "Valid From:", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.VALID_FROM, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        @Html.ValidationMessageFor(model => model.VALID_FROM, "", new { @class = "text-danger" })
                    </div>
                    @Html.Label("Valid To:", "Valid To:", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-3">
                        @Html.EditorFor(model => model.VALID_TO, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        @Html.ValidationMessageFor(model => model.VALID_TO, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Remarks:", "Remarks:", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.TextAreaFor(model => model.INITIATOR_REMARKS, new { @class = "form-control", @rows = "3", @style = "max-width:369px" })
                        @Html.ValidationMessageFor(model => model.INITIATOR_REMARKS, "", new { @class = "text-danger" })
                    </div>
                </div>
                @*<div class="form-group">
                        @Html.LabelFor(model => model.STATUS, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-6">
                            <div class="checkbox">
                                @Html.EditorFor(model => model.STATUS)
                                @Html.ValidationMessageFor(model => model.STATUS, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>*@
                <div class="form-group">
                    @Html.Label("Attachment", "Attachment", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        <input id="Upload_Banner" type="file" name="file" class="form-control" onchange="readBannerURL(this);" />
                        @Html.ValidationMessageFor(model => model.ATTACHMENT, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-8 text-center">
                        <input type="submit" value="Create" id="btnSubmit" class="btn btn-success" />
                        <button type="button" class="btn btn-primary" id="btnPreview">Preview</button>
                        <input type="button" class="btn btn-secondry" data-dismiss="modal" value="Cancel" />
                    </div>
                </div>
            </div>
        }
    </div>
    <!-- Read More President modal start -->
    <div id="myPresidentModal" class="modal fade" role="dialog" style="width:100%">
        <div class="modal-dialog" style="font-size:15px !important;">
            <div class="modal-content">
                <div class="modal-header" style="background-image:url('/images/announcements_overlay_header_bg.png')">

                    <img src="~/images/icon_fdelete.gif" alt="close" id="pMClose" title="close" class="close-readmore-modal" />
                    <h2 style="text-align:left; padding:20px">President Message</h2>
                </div>
                <div class="modal-body">
                    <div class="modal-left-content hidden-xs">
                        @*<span><img id="banner-img" alt="President Message" title="President Message image" class="left-content-img" /></span>*@
                        <div id="dwnlinkPres" class="download-links" style="color:black;">
                            <h6>Download :</h6>
                            <span id="dwnlink" style="font-size:12px; text-decoration: underline; color:dodgerblue"></span>
                        </div>
                    </div>
                    <div class="modal-right-content">
                        <h3 id="popsubjectre">Loading please wait....</h3>
                        <div id="modal-scroll">
                            <p style="white-space:pre-wrap" id="popdescriptionre">Loading please wait.....</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Read More President modal end -->
</body>

</html>

@*<div>
        @Html.ActionLink("Back to List", "Index")
    </div>*@
