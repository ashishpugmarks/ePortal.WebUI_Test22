@model IEnumerable<ePortal.ViewModels.PresidentDesk_TRNViewModel>
@using Newtonsoft.Json
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .scrollit {
            overflow-y: scroll;
            height: 100px;
        }
    </style>
}

    <div class="row">
        <div style="height: 2.2em; padding-top: 10px; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <span style="padding-left: 8px;">President Desk Messages Details</span>
        </div>
        <div class="body-content" style="overflow-x:auto !important">
            <table id="tblPresedentMessageDetails" class="table table-bordered table-responsive">
                <thead>
                    <tr class="info">
                        <td colspan="9">
                            <b class="pull-left">
                                President Messages List
                            </b>
                            <b class="pull-right">
                            <button class="btn btn-primary btn-xs" id="createNew">Create New</button>
                                @*@Html.ActionLink("Create New", "CreatePresidentMessages", null, new { @style = "color:white" })*@
                            </b>
                        </td>
                    </tr>
                    <tr>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.PRESIDENTMSG_ID)
                        </th>
                        @*<th>
                                @Html.DisplayName("#")

                            </th>*@
                        <th>
                            @Html.DisplayNameFor(model => model.BRIEF)
                            @*@Html.DisplayName("Brief")*@
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.MESSAGE)
                            @*@Html.DisplayName("Message" , new { @class= "scrollit" })*@
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.VALID_FROM)
                            @*@Html.DisplayName("ValidFrom")*@
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.VALID_TO)
                            @*@Html.DisplayName("ValidTo")*@
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.STATUS)
                            @*@Html.DisplayName("Status")*@
                        </th>
                        @*<th>
                                @Html.DisplayNameFor(model => model.CREATED_DATE)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.MODIFIED_DATE)
                            </th>*@
                        @*<th>
                                @Html.DisplayNameFor(model => model.ATTACHMENT_CONTENTTYPE)
                            </th>*@
                        <th>
                            @Html.DisplayNameFor(model => model.ATTACHMENT_NAME)
                            @*@Html.DisplayName("AttachmentName")*@
                        </th>
                        <th class="text-center">@Html.DisplayName("Action")</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowNo = 0;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                @(rowNo += 1)
                                @Html.HiddenFor(modelItem => item.PRESIDENTMSG_ID)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.BRIEF)
                            </td>
                            <td style="max-width:600px">
                                <div style="overflow-y:auto; max-height:70px">
                                    @Html.DisplayTextFor(modelItem => item.MESSAGE)
                                </div>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.VALID_FROM)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.VALID_TO)
                            </td>
                            <td class="text-center">
                                @if (@item.STATUS == 2)
                                {
                                    <span class="label-warning  btn-xs">WIP</span>
                                }
                                else if (@item.STATUS == 1)
                                {
                                    <span class="label-success btn-xs">Active</span>
                                }
                                else if (@item.STATUS == 0)
                                {
                                    <span class="label-danger  btn-xs">Deactive</span>
                                }
                                else if (@item.STATUS == 3)
                                {
                                    <span class="label-danger  btn-xs">Rejected</span>
                                }

                                @*@Html.DisplayFor(modelItem => item.STATUS)*@
                            </td>
                            @*<td>
                                    @Html.DisplayFor(modelItem => item.CREATED_DATE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MODIFIED_DATE)
                                </td>*@
                            @*<td>
                                    @Html.DisplayFor(modelItem => item.ATTACHMENT_CONTENTTYPE)
                                </td>*@
                            <td>
                                @Html.DisplayFor(modelItem => item.ATTACHMENT_NAME)
                            </td>
                            <td style="width:8%" class="text-center">
                                @if (item.STATUS == 1)
                                {
                                    <button class="btn glyphicon glyphicon-remove btn-xs text-danger" title="Click to Deactive" @{
                                        if (item.STATUS == 0 || item.STATUS == 3)
                                        {
                                            @: disabled="disabled"
                                        }
                                } id="@item.PRESIDENTMSG_ID" data-id="@item.PRESIDENTMSG_ID" data-ctrl="edit-booking-btn"></button>
                                }
                                <button class="btn glyphicon glyphicon-edit btn-xs text-primary" title="Click to Edit" @{
                                    if (item.STATUS == 0 || item.STATUS == 3)
                                    {
                                        @: disabled="disabled"
                                    }
                                }
                                    id="@item.PRESIDENTMSG_ID" data-id="@item.PRESIDENTMSG_ID" @{
                                    if (item.STATUS == 0 || item.STATUS == 1 || item.STATUS == 3)
                                    {
                                        @: style=" display:none;"
                                    }
                            } data-ctrl="edit-booking-btn"></button>
                            <button class="btn glyphicon glyphicon-eye-open btn-xs text-info" title="Click to View Detail" id="@item.PRESIDENTMSG_ID" data-ctrl="view-booking-btn" data-id="@item.PRESIDENTMSG_ID"></button>
                                @*@Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ })*@

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="myModal" class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <div id="myModelHeader"></div>
                    </div>
                    @*<label id="closbtn" class="modal-close" for="modal-toggle">&#x2715;</label>*@
                    <div class="modal-body">
                        <div id="myModalContent"></div>
                    </div>
                </div>
            </div>
        </div>
</div>

@section Scripts{
   
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    //debugger;
    $(document).ready(function () {
        $('#tblPresedentMessageDetails').DataTable({
            //"scrollY": "300px",
            //"scrollCollapse": true,
            "pagingType": "full_numbers",
            "bPaginate": true,
            "bInfo": false,
            "bFilter": true,
            "bLengthChange": false,
            "iDisplayLength": 4,
        });
        $('.dataTables_length').addClass('bs-select');
        $('.input-sm').removeClass('input-sm');
        $(".homeContent").removeClass("homeContent");
        //$(".container-fluid").removeClass("container-fluid");

            $("#createNew").on("click", function(){
                    openCreatePopup();
                });


                       $(document).on('click', '[data-ctrl="edit-booking-btn"]', function () {
                        var id = $(this).data('id');
                                openEditPopup(id);
                    });


                        $(document).on('click', '[data-ctrl="view-booking-btn"]', function () {
                    var id = $(this).data('id');
                        openDetailPopup(id);
                });
    });

          function openCreatePopup() {
                    
                    $.ajax({
                        type: "GET",
                        url: "/PresidentDesk/CreatePresidentMessages",
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (data) {
                            var headerHtml = '<div class="pull-left"><h5 class="modal-title">Add New President Message</h5></div><div class="pull-right"><button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px"><span aria-hidden="true">&times;</span></button></div>'
                            $('#myModelHeader').html(headerHtml);
                            $('#myModalContent').html(data);
                            //$('#myModal').modal(options);
                            $('#myModal').modal({ backdrop: "static" });
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }
                function openEditPopup(id) {
                   
                    $.ajax({
                        type: "GET",
                        url: "/PresidentDesk/EditPresidentMessages",
                        data: {
                            PresidentMsgId: id,
                        },
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (data) {
                            var headerHtml = '<div class="pull-left"><h5 class="modal-title">Edit President Message</h5></div><div class="pull-right"><button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px"><span aria-hidden="true">&times;</span></button></div>'
                            $('#myModelHeader').html(headerHtml);
                            $('#myModalContent').html(data);
                            //$('#myModal').modal(options);
                            $('#myModal').modal({ backdrop: "static" });
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }

                function openDetailPopup(id) {
                  
                    $.ajax({
                        type: "GET",
                        url: "/PresidentDesk/GetPresidentDeskDetails",
                        data: {
                            id: id,
                            TransactionType: "PresidentDeskTRN"
                        },
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (data) {
                            var headerHtml = '<div class="pull-left"><h5 class="modal-title">President Message Details</h5></div><div class="pull-right"><button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px"><span aria-hidden="true">&times;</span></button></div>'
                            $('#myModelHeader').html(headerHtml);
                            $('#myModalContent').html(data);
                            //$('#myModal').modal(options);
                            $('#myModal').modal({ backdrop: "static" });
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }
                function openImagePopup(current) {
                    var $buttonClicked = $(this);
                    //var options = {
                    //    "backdrop": "static",
                    //    keyboard: true
                    //};
                    $('#myModalContent').html('<img src="' + current.id + '" />');
                    //$('#myModal').modal(options);
                    $('#myModal').modal('show');
                }
                $("#closbtn").click(function () {
                    $('#myModal').modal('hide');
                });
</script>
      
        @if (TempData["AlertMessage"] != null)
        {
        <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">

            debugger;
                var alertMessage = @Html.Raw(JsonConvert.SerializeObject(TempData["AlertMessage"]));

                if (alertMessage == 1) {
                    sweetAlert(" ", "Record saved successfully", "success");
                }
                else if (alertMessage == -1) {
                    sweetAlert(" ", "Record not saved", "warning");
                }
                else {
                    sweetAlert("",alertMessage,"warning");
                }
            </script>
        }

}