@model ePortal.ViewModels.PresidentDeskViewModel


<!DOCTYPE html>
<html>
<head>

    @* <script src="~/js/jquery.3.6.3.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.min.js"></script> *@
    @*<script type="text/javascript">
            $(document).ready(function () {
                $("#Upload_Banner").change(function () {
                    var extension = $(this).val().split('.').pop().toLowerCase();
                    var validFileExtensions = ['png', 'jpg', 'jpeg', 'pdf', 'doc', 'docx', 'xls', 'ppt'];
                    if ($.inArray(extension, validFileExtensions) == -1) {
                        alert("Sorry!! Upload only 'png', 'jpg', 'jpeg', 'pdf', 'doc', 'docx', 'xls', 'ppt' file")
                        $(this).replaceWith($(this).val('').clone(true));
                        $('#Apply').prop('disabled', true);
                    } else {
                        if ($(this).get(0).files[0].size > (131072)) {
                            alert("Sorry!! Max allowed file size is 128 kb");
                            $(this).replaceWith($(this).val('').clone(true));
                            $('#Apply').prop('disabled', true);
                        } else {
                            $('#Apply').prop('disabled', false);
                        }
                    }
                });
        </script>*@
</head>
<body>
    <div class="body-content">

        <dl class="dl-horizontal" style="width:100%">
            @if (Model.PresidentDetail != null)
            {
                foreach (var TransactionItem in Model.PresidentDetail)
                {
                    <dt>
                        @Html.DisplayNameFor(model => TransactionItem.PRESIDENT_TITLE)
                        <br />
                        @Html.DisplayNameFor(model => TransactionItem.PRESIDENT_NAME)
                    </dt>
                    <dd>
                        <div class="col-xs-12 col-sm-12 col-md-12" style="padding:0px">
                            <div class="col-xs-12 col-sm-12 col-md-8" style="padding:0px">
                                @Html.DisplayFor(model => TransactionItem.PRESIDENT_TITLE)
                                <br />
                                @Html.DisplayFor(model => TransactionItem.PRESIDENT_NAME)
                            </div>
                            <div class="col-xs-4 col-sm-3 col-md-3" style="padding:0px">
                                @{
                                    var base64 = Convert.ToBase64String(TransactionItem.PRESIDENT_PHOTO);
                                    var imgSrc = String.Format("data:image/jpg;base64,{0}", base64);
                                }
                                <img src='@imgSrc' class="pull-right" style="width:80px; height:80px" />
                            </div>
                        </div>
                    </dd>
                    <hr />
                    <dt>
                        @Html.DisplayNameFor(model => TransactionItem.ACTIVE_FROM)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => TransactionItem.ACTIVE_FROM)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => TransactionItem.ACTIVE_TO)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => TransactionItem.ACTIVE_TO)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(modelItem => TransactionItem.STATUS)
                    </dt>
                    <dd>
                        @if (TransactionItem.STATUS == 0)
                        {
                            <span class="label-warning">Deactive</span>
                        }
                        else if (TransactionItem.STATUS == 1)
                        {
                            <span class="label-success">Active</span>
                        }
                    </dd>
                    <hr />
                    <dt>
                        @Html.DisplayNameFor(model => TransactionItem.REMARKS)
                    </dt>
                    <dd style="overflow-y:auto; max-height:100px">
                        @Html.DisplayFor(model => TransactionItem.REMARKS)
                    </dd>
                    <hr />

                }
            }
            @if (Model.President_TRNDTL != null)
            {
                foreach (var TransactionItem in Model.President_TRNDTL)
                {
                    @*<dt>
                            @Html.DisplayNameFor(model => TransactionItem.PRESIDENTMSG_ID)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => TransactionItem.PRESIDENTMSG_ID)
                        </dd>*@

                    <dt>
                        @Html.DisplayNameFor(model => TransactionItem.PRESIDENT_NAME)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => TransactionItem.PRESIDENT_NAME)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => TransactionItem.BRIEF)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => TransactionItem.BRIEF)
                    </dd>

                    <dt>
                        @Html.DisplayNameFor(model => TransactionItem.MESSAGE)
                    </dt>

                    <dd style="overflow-y:auto; max-height:100px">
                        @Html.DisplayFor(model => TransactionItem.MESSAGE)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => TransactionItem.ATTACHMENT_NAME)
                    </dt>

                    <dd>
                        @if (TransactionItem.ATTACHMENT_NAME != null)
                        {
                            @Html.ActionLink("Download", "Download", "PresidentDesk", new { id = TransactionItem.PRESIDENTMSG_ID }, null)
                            @*<a id="@Model.ATTACHMENTID" name="Attachment2" onclick="DownloadFile(this);">Download</a>*@
                            <span>(@Html.DisplayFor(model => TransactionItem.ATTACHMENT_NAME))</span>
                        }
                        else
                        {
                            <span>N/A</span>
                        }
                    </dd>

                    <hr />
                    <dt>
                        @Html.DisplayNameFor(model => TransactionItem.VALID_FROM)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => TransactionItem.VALID_FROM)
                    </dd>

                    <dt>
                        @Html.DisplayNameFor(model => TransactionItem.VALID_TO)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => TransactionItem.VALID_TO)
                    </dd>

                    <dt>
                        @Html.DisplayNameFor(model => TransactionItem.STATUS)
                    </dt>

                    <dd>
                        @if (TransactionItem.STATUS == 0)
                        {
                            <span class="label-danger">Deactive</span>
                        }
                        else if (TransactionItem.STATUS == 1)
                        {
                            <span class="label-success">Active(After Approval)</span>
                        }
                        else if (TransactionItem.STATUS == 2)
                        {
                            <span class="label-warning">Pending for Approval</span>
                        }
                        else if (TransactionItem.STATUS == 3)
                        {
                            <span class="label-danger btn-xs">Rejected By Approval Authority </span>
                        }
                    </dd>

                    <hr />
                    <dt>
                        @Html.DisplayNameFor(model => TransactionItem.CREATED_BY_NAME)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => TransactionItem.CREATED_BY_NAME)
                    </dd>

                    <dt>
                        @Html.DisplayNameFor(model => TransactionItem.CREATED_DATE)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => TransactionItem.CREATED_DATE)
                    </dd>
                    <dt>
                        @Html.DisplayName("Remarks")
                    </dt>

                    <dd style="overflow-y:auto; max-height:100px">
                        @Html.DisplayFor(model => TransactionItem.INITIATOR_REMARKS)
                    </dd>
                    <hr />


                    @*<dt>
                                @Html.DisplayNameFor(model => TransactionItem.MODIFIED_DATE)
                            </dt>

                            <dd>
                                @Html.DisplayFor(model => TransactionItem.MODIFIED_DATE)
                            </dd>*@
                    @*<dt>
                                @Html.DisplayNameFor(model => TransactionItem.ATTACHMENT)
                            </dt>

                            <dd>
                                @Html.DisplayFor(model => TransactionItem.ATTACHMENT)
                            </dd>*@
                }
            }

            @if (Model.PresidentMsgApp_TRNDTL != null)
            {
                foreach (var TrnApprovalItem in Model.PresidentMsgApp_TRNDTL)
                {
                    <dt>
                        @Html.DisplayNameFor(model => TrnApprovalItem.INITIATOR_NAME)
                    </dt>
                    <dd>
                        @Html.DisplayFor(modelItem => TrnApprovalItem.INITIATOR_NAME)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => TrnApprovalItem.INITIATOR_REMARKS)
                    </dt>
                    <dd style="overflow-y:auto; max-height:100px">
                        @Html.DisplayFor(modelItem => TrnApprovalItem.INITIATOR_REMARKS)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => TrnApprovalItem.CREATED_DATE)
                    </dt>
                    <dd>
                        @Html.DisplayFor(modelItem => TrnApprovalItem.CREATED_DATE)
                    </dd>
                    <hr />
                    <dt>
                        @Html.DisplayNameFor(model => TrnApprovalItem.PRESIDENT_TITLE)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => TrnApprovalItem.PRESIDENT_TITLE)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => TrnApprovalItem.PRESIDENT_NAME)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => TrnApprovalItem.PRESIDENT_NAME)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => TrnApprovalItem.BRIEF)
                    </dt>
                    <dd>
                        @Html.DisplayFor(modelItem => TrnApprovalItem.BRIEF)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => TrnApprovalItem.MESSAGE)
                    </dt>
                    <dd style="overflow-y:auto; max-height:100px">
                        @Html.DisplayFor(modelItem => TrnApprovalItem.MESSAGE)
                    </dd>
                    <hr />
                    <dt>
                        @Html.DisplayNameFor(model => TrnApprovalItem.APPROVED_BY_NAME)
                    </dt>
                    <dd>
                        @Html.DisplayFor(modelItem => TrnApprovalItem.APPROVED_BY_NAME)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => TrnApprovalItem.APPROVED_DATE)
                    </dt>
                    <dd>
                        @Html.DisplayFor(modelItem => TrnApprovalItem.APPROVED_DATE)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => TrnApprovalItem.STATUS)
                    </dt>
                    <dd>
                        @if (@TrnApprovalItem.STATUS == 1)
                        {
                            <span class="label-warning btn-xs">Pending for Approval</span>
                        }
                        else if (@TrnApprovalItem.STATUS == 2)
                        {
                            <span class="label-success btn-xs">Approved </span>
                        }
                        else if (@TrnApprovalItem.STATUS == 3)
                        {
                            <span class="label-warning btn-xs">Cancelled By User</span>
                        }
                        else if (@TrnApprovalItem.STATUS == 4)
                        {
                            <span class="label-danger btn-xs">Rejected by Approval Authority</span>
                        }
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => TrnApprovalItem.APPAUTH_REMARKS)
                    </dt>
                    <dd style="overflow-y:auto; max-height:100px">
                        @Html.DisplayFor(modelItem => TrnApprovalItem.APPAUTH_REMARKS)
                    </dd>
                    <hr />
                }
            }

        </dl>
    </div>
</body>
</html>
