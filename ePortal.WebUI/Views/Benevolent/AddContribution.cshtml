@model ePortal.ViewModels.BENEVOLENT_DT

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    @*   @Styles.Render("~/bundle/css")
    @Scripts.Render("~/bundles/js")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval") *@
    @* Bundle CSS files  *@
    <link rel="stylesheet" href="~/css/style.min.css"  />

    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .row {
            display: flex;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
    </style>

    <link href="~/css/jquery-ui.css" rel="stylesheet"  />

    <link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet"  />


    <title>AddBenevolentMST</title>

</head>
<body>
    <div class="panel-group">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h2 class="panel-title" style="padding-left: 10px;">
                    <strong>Contribution</strong>
                </h2>
            </div>
            <div class="container panel-body" style="font-size:12px;height:440px;">
                @using (Html.BeginForm())
                {
                    <div>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    </div>
                    <div class="row" style="margin-top:10px;margin-left:40px;">
                        <div>
                            <label><u>Deceased's Detail</u></label>
                        </div>
                    </div>
                    <div class="row" style="padding:4px;margin-left:50px;">
                        @Html.Label("", "Employee Code", new { @class = "control-label text-right col-md-1", @style = "width:140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.Hidden("ASR_BENEVOLENTID")
                            @* <input type="hidden" id="ASR_BENEVOLENTID" value="@ViewBag.id" /> *@
                            @Html.TextBox("EmpID", "", new { @Value = ViewBag.id, @class = "form-control", @disabled = "disabled" })
                        </div>

                        @Html.Label("", "Employee Name", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextBox("txtEmpName", "", new { @value = "", @class = "form-control", @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row" style="padding:4px;margin-left:50px;">
                        @Html.Label("", "Operation", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextBox("txtOpration", "", new { @value = "", @class = "form-control", @disabled = "disabled" })
                        </div>

                        @Html.Label("", "Division", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">

                            @Html.TextBox("txtDivision", "", new { @value = "", @class = "form-control", @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row" style="padding:4px;margin-left:50px;">
                        @Html.Label("", "Department", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextBox("txtDepartment", "", new { @value = "", @class = "form-control", @disabled = "disabled" })
                        </div>

                        @Html.Label("", "Section", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">

                            @Html.TextBox("txtSection", "", new { @value = "", @class = "form-control", @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row" style="padding:4px;margin-left:50px;">
                        @Html.Label("", "Demise Day", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextBox("txtDemiseDay", "", new { @class = "form-control", placeholder = "Demise Date", @disabled = "disabled" })
                            @*@Html.ValidationMessageFor(a => a.DEMISEDATE, "", new { @class = "text-danger", @disabled = "disabled" })*@
                        </div>

                        @Html.Label("", "Demise Reason ", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextArea("txtDemiseReason", "", new { @class = "form-control", placeholder = "Demise Reasone", @disabled = "disabled", @rows = "3" })
                        </div>
                    </div>
                    <div class="row" style="padding:4px;margin-left:50px;">
                        @Html.Label("", "From Date", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextBox("txtFrom_DT", "{0:dd-MM-yyyy}", new { @class = "form-control", placeholder = "From Date", @disabled = "disabled" })
                        </div>

                        @Html.Label("", "To Date ", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextBox("txtTo_Date", "", new { @class = "form-control", placeholder = "To Date", @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row" style="margin-top:10px;margin-left:40px;">
                        <div>
                            <label><u>Constribution</u></label>
                        </div>
                    </div>
                    <div class="row" style="padding:4px;">
                        @Html.Label("", "Predefined Amount", new { @class = "control-label text-right col-md-1", @style = "width: 200px;margin-top: 7px;" })
                        <div class="col-md-1 col-lg-1">
                            <button class="btn btn-default" type="button" id="btn1000" value="1000">1000</button>
                        </div>
                        <div class="col-md-1 col-lg-1">
                            <button class="btn btn-default" type="button" id="btn1500" value="1500">1500</button>
                        </div>
                        <div class="col-md-1 col-lg-1">
                            <button class="btn btn-default" type="button" id="btn2000" value="2000">2000</button>
                        </div>
                        <div class="col-md-1 col-lg-1">
                            <button class="btn btn-default" type="button" id="btnAmount">Other Amount</button>
                        </div>
                        <div class="col-md-3 col-lg-3" style="margin-left:50px">
                            @Html.TextBoxFor(model => model.AMOUNT, new { @type = "number", @class = "form-control", placeholder = "Amount", @disabled = "disabled", @maxlength = "11", @style = "width: 195px;" })
                            <span id="spn_auth_msg" style="color:#a94442;font-weight:600;"></span>
                        </div>
                    </div>
                    @*<div class="row" style="padding:4px;margin-top:7px;">
                            @Html.Label("", "Amount", new { @class = "control-label text-right col-md-1", @style = "width: 200px;margin-top: 7px;" })
                            <div class="col-md-3 col-lg-3">
                                @Html.TextBoxFor(model => model.AMOUNT, new { @class = "form-control", placeholder = "Amount", @disabled = "disabled" })
                            </div>
                        </div>*@
                    <br />
                    <div class="form-group" style="margin-left:60px;">
                        <div class="col-md-offset-4 col-md-8">
                            <input type="button" value="Save" class="btn btn-success" id="btnSave" />
                            <button id="btnCncl" type="button" class="btn btn-default">Cancel</button>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div id="ajaxLoader"></div>
    </div>
    @* Bundle JS files  *@
    <script src="~/js/jquery.min.js"  ></script>
    <script src="~/js/layout.min.js"  ></script>
    <script src="~/js/jquery-ui.js" ></script>
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js" ></script>
    <script src="~/js/moment.min.js" ></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
        @* CSP 3.0 Compliant changes *@
            $("#btnCncl").on('click', function () {
                    CloseFancyBox();
            });
            $("#btnSave").on('click', function () {
                    SaveData();
            });
        @* CSP 3.0 Compliant changes *@

            $("#ASR_BENEVOLENTID").val(@ViewBag.id)
            $("#AMOUNT").on("keypress keyup blur paste", function (event) {
                var that = this;

                //paste event
                if (event.type === "paste") {
                    setTimeout(function () {
                        $(that).val($(that).val().replace(/[^\d].+/, ""));
                    }, 100);
                } else {

                    if (event.which < 48 || event.which > 57) {
                        event.preventDefault();
                    } else {
                        $(this).val($(this).val().replace(/[^\d].+/, ""));
                    }
                }

            });

            $("#btn1000").click(function () {
                $("#AMOUNT").val(1000);
                $("#AMOUNT").attr('disabled', 'disabled');
            });

            $("#btn1500").click(function () {
                $("#AMOUNT").val(1500);
                $("#AMOUNT").attr('disabled', 'disabled');
            });

            $("#btn2000").click(function () {
                $("#AMOUNT").val(2000);
                $("#AMOUNT").attr('disabled', 'disabled');
            });

            $("#btnAmount").click(function () {
                $("#AMOUNT").val('');
                $("#AMOUNT").removeAttr('disabled');
                $("#AMOUNT").focus();
            });

            var id = $("#ASR_BENEVOLENTID").val();
            if (id != "" && id != null) {
                $.ajax({
                    type: "GET",
                    url: "/Benevolent/DemiseEmpDetail/" + id,
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    //data: id,
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        var record = JSON.parse(data);
                        console.log(record);
                        $("#EmpID").val(record.t1.EMPLOYEECODE);
                        $('#txtEmpName').val(record.t2.EmpName);
                        $('#txtOpration').val(record.t2.Opration);
                        $('#txtDivision').val(record.t2.Division);
                        $('#txtDepartment').val(record.t2.Department);
                        $('#txtSection').val(record.t2.Section);

                        $('#txtDemiseDay').val(moment(record.t1.DEMISEDATE).format('DD-MMM-YYYY'));
                        $('#txtDemiseReason').val(record.t1.DEMISEREASONE);
                        $('#txtFrom_DT').val(moment(record.t1.FROM_DT).format('DD-MMM-YYYY'));
                        $('#txtTo_Date').val(moment(record.t1.TO_DT).format('DD-MMM-YYYY'));
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }

        });
        function CloseFancyBox() {
            parent.$.fancybox.close();
        }


        function SaveData() {
            var isFormVaildation = CheckFormValidation();
            //var isFormVaildation = true;
            if (isFormVaildation) {
                //$("#btnSave").attr("disabled", true);
                var data = {
                    ASR_BENEVOLENTID: $("#ASR_BENEVOLENTID").val(),
                    AMOUNT: $('#AMOUNT').val(),
                    STATUS: 1

                }
                //alert(JSON.stringify(data));

                $.ajax({
                    type: "POST",
                    url: "/Benevolent/AddContributionData",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: JSON.stringify(data),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        alert("Contribution has been updated successfully.");
                        CloseFancyBox();
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function CheckFormValidation() {
            var isVailed = true;
            $('#spn_auth_msg').text('');
            $('#AMOUNT').removeClass('validationError');
            if ($('#AMOUNT').val() == "") {
                $('#AMOUNT').addClass('validationError');
                $('#spn_auth_msg').text('Please Enter Amount.');
                isVailed = false;
            }
            else if ($('#AMOUNT').val() < 100) {
                $('#AMOUNT').addClass('validationError');
                $('#spn_auth_msg').text('Min. amount would be 100 Rs.');
                isVailed = false;
            }
            else {
                var code = $("#AMOUNT").val();
                if (isNaN(code)) {
                    $('#AMOUNT').addClass('validationError');
                    $('#spn_auth_msg').text('Please Enter only Digit.');
                    isVailed = false;
                }
            }

            return isVailed;
        }

    </script>
</body>
</html>
