@model IEnumerable<ePortal.ViewModels.BenevolentViewModel>
@{
    Layout = null;
}

<style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    select.input-sm {
        line-height: 10px !important;
    }
</style>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">


    //$('.homeContent').removeClass('homeContent');
    $(document).ready(function () {
    @* CSP 3.0 Compliant changes *@
            $('[data-ctrl="ancEdit"]').on('click', function () {
                let bnvlntId = $(this).data("bnvlntid");
                edit(bnvlntId);
            });
    @* CSP 3.0 Compliant changes *@

        //$.fn.dataTable.moment("DD/MM/YYYY HH:mm a");


        $("#tbRequestReport").dataTable({
            //"bFilter": false,
            "bLengthChange": false,
            "order": [[3, 'desc']],
            "columnDefs": [
                {
                    "searchable": false,
                    "orderable": true,
                    "targets": 3,
                    "type": 'date'
                }
            ]
            //"columnDefs": [//date-fields
            //                 {
            //                     "searchable": false,
            //                     "orderable": true,
            //                     "targets": 4,
            //                     "type": 'date'
            //                 },
            //                 { "orderable": true,
            //                     "render": $.fn.dataTable.render.number( ',', '', 0, '','' ),
            //                     "targets":[5],
            //                 }
            //              ],
        });
    });

    function edit(id) {
        $.fancybox.open({
            href: '../Benevolent/EditBenevolentMST/' + id,
            type: 'iframe',
            padding: 5,
            maxWidth: 1000,
            maxHeight: 485,
            fitToView: false,
            width: '1000px',
            height: '485px',
            autoSize: false,
            closeClick: true,
            openEffect: 'elastic',
            openSpeed: 120,
            closeEffect: 'elastic',
            closeSpeed: 100,
            helpers:
            {
                overlay: { closeClick: false }
            },
            afterClose: function () {
                // $("#btnSubmit").trigger("click");
                GetReportList();
            }
        });
    }


</script>

<div class="panel-group">
    <div class="panel panel-primary">
        <div class="panel-heading">
            <table style="width:100%;">
                <tr>
                    <td>
                        <h2 class="panel-title">
                            <strong>Demised List</strong>
                        </h2>
                    </td>

                </tr>
            </table>
        </div>
        <div class="panel-body">
            <table class="table table-bordered table-hover table-responsive" id="tbRequestReport">
                <thead>
                    <tr>
                        <th class="text-center">
                            @Html.DisplayName("Emp Code")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Emp Name")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Demise Reason")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Demise Date")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("From Date")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("To Date")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Action")
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.EMPLOYEECODE)
                            </td>
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.EmpName)
                            </td>
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.DEMISEREASONE)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.DEMISEDATE)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.FROM_DT)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.TO_DT)
                            </td>
                            <td class="text-center">
                                <a id="edit" data-ctrl="ancEdit" data-bnvlntid="@item.ASR_BENEVOLENTID" class="btn bg-primary"><span class="glyphicon glyphicon-pencil"></span></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
