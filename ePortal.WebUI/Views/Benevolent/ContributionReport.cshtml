@model ePortal.ViewModels.SearchBenevolent

@{
    ViewBag.Title = "ContributionReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    @*     <link href="~/fancybox/jquery.fancybox.css" rel="stylesheet" />

    <script src="~/fancybox/jquery.fancybox.js"></script> *@
    @* Bundle CSS files  *@
    @* <link rel="stylesheet" href="~/css/style.min.css" /> *@
    <link href="~/css/jquery-ui.css" rel="stylesheet"  />
    <link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .form-control {
            height: 28px;
            padding: 3px 3px;
            font-size: 13px;
        }
    </style>

}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">
            Contribution Report
        </div>
    </div>

    <div class="body-content" style="overflow-x:auto!important;">
        <div class="panel-group">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title">
                        <strong>Search</strong>
                    </h2>
                </div>
                <div class="panel-body" style="padding:5px;">
                    <div class="row" style="padding:4px;">
                        @Html.LabelFor(model => model.DemiseEmpCode, new { @class = "control-label text-right col-md-1", @style = "width:220px;margin-top: 7px;" })
                        <div class="col-md-2 col-lg-2">
                            @Html.TextBoxFor(model => model.DemiseEmpCode, new { @value = "", @class = "form-control", @style = "width: 150px;" })
                        </div>

                        @Html.LabelFor(model => model.From_Dt, new { @class = "control-label text-right col-md-1", @style = "width: 100px;margin-top: 7px;" })
                        <div class="col-md-2 col-lg-2" style="width:10.66%;">
                            @Html.TextBoxFor(model => model.From_Dt, new { @value = "", @class = "form-control", @style = "width: 150px;" })
                        </div>

                        @Html.LabelFor(model => model.To_Dt, new { @class = "control-label text-right col-md-1", @style = "width: 100px;margin-top: 7px;" })
                        <div class="col-md-2 col-lg-2" style="width:10.66%;">
                            @Html.TextBoxFor(model => model.To_Dt, new { @value = "", @class = "form-control", @style = "width: 150px;" })
                        </div>



                    </div>
                    <div class="row" style="padding:4px;">
                        @Html.LabelFor(model => model.ContEmpCode, new { @class = "control-label text-right col-md-1", @style = "width: 220px;margin-top: 7px;" })
                        <div class="col-md-2 col-lg-2">
                            @Html.TextBoxFor(model => model.ContEmpCode, new { @type = "number", @value = "", @class = "form-control", @style = "width: 150px;" })
                        </div>
                    </div>

                    <div class="row" style="padding:8px;">
                        <div class="col-md-12 col-lg-12 text-center">
                            <button id="btnSubmit" class="btn btn-success btn-sm">Search</button>
                            <button id="btnExcel" class="btn btn-primary btn-sm">Export To Excel</button>
                            <input id="btnReset" type="button" value="Reset" class="btn btn-default btn-sm" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="ajaxLoader"></div>

        <div id="div_append"></div>
    </div>
</div>

