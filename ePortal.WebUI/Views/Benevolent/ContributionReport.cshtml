@section Scripts {
    <script src="~/js/jquery-ui.js" ></script>
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js" ></script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
        @* CSP 3.0 Compliant changes *@
            $("#btnSubmit").on('click', function (event) {
                    GetReportList($(this)[0]);
                     event.preventDefault();
            });
            $("#btnExcel").on('click', function (event) {
                    GetExcel($(this)[0]);
                     event.preventDefault();
            });
            $("#btnReset").on("click", function () {
                window.location.href = '@Url.Action("ContributionReport", "Benevolent")';
            });
        @* CSP 3.0 Compliant changes *@

            $('#txtEmpCode').val('');
            $('#From_Dt,#To_Dt').datepicker({
                format: "dd-M-yy",
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top'
            });

            // $("#btnSubmit").click();
            GetReportList();
        });


        function GetReportList(crnt) {
            var data = {
                DemiseEmpCode: $('#DemiseEmpCode').val()==""?0:$('#DemiseEmpCode').val(),
                From_Dt: $('#From_Dt').val(),
                To_Dt: $('#To_Dt').val(),
                ContEmpCode: $('#ContEmpCode').val()==""?0:$('#ContEmpCode').val()
            }
            console.log(data);
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/Benevolent/ContributionReport",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#div_append').html(data);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function GetExcel(crnt) {
            var data = {
                DemiseEmpCode: $('#DemiseEmpCode').val()==""?0:$('#DemiseEmpCode').val(),
                From_Dt: $('#From_Dt').val(),
                To_Dt: $('#To_Dt').val(),
                ContEmpCode: $('#ContEmpCode').val()==""?0:$('#ContEmpCode').val()
            }

            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/Benevolent/ExportToExcelUser",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "Benevolent", Action = "DownloadExcelUser" })";
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        //function OpenDoc(current) {
        //    var _pdfName = $(current).attr('data-name');
        //    var width = screen.width - 100;
        //    var height = screen.height - 100;
        //    var winTop = 50;
        //    var winLeft = 50;
        //    var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
        //    windowFeatures = windowFeatures + ",left = " + winLeft + ",";
        //    windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
        //    window.open("../../../Uploads/PR/" + _pdfName, "Approved PR", windowFeatures);
        //};
    </script>
        }
