
@model IEnumerable<ePortal.ViewModels.BenevolentViewModel>
@{
    Layout = null;
}

<style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
    #edit[disabled] {
        pointer-events: none;
    }
    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    select.input-sm {
        line-height: 10px !important;
    }
</style>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    $('.homeContent').removeClass('homeContent');
    $(document).ready(function () {
    @* CSP 3.0 Compliant changes *@
            $('[data-ctrl="ancEdit"]').on('click', function () {
                let bnvlntId = $(this).data("bnvlntid");
                edit(bnvlntId);
            });
    @* CSP 3.0 Compliant changes *@
        $("#tbRequestReport").dataTable({
            "bFilter": false,
            "bLengthChange": false,
            "order": [[4, 'desc']],
            "columnDefs": [
                {
                    "searchable": false,
                    "orderable": true,
                    "targets": 4,
                    "type": 'date'
                }
            ]

        });
        $("a.data").mouseover(function () {
            var id = parseInt($(this).text());
            $.fancybox.open({
                href: '../Benevolent/GetDemiseEmployeeDetail/' + id,
                type: 'iframe',
                padding: 5,
                maxWidth: 600,
                maxHeight: 700,
                fitToView: false,
                width: '80%',
                height: '100%',
                autoSize: true,
                closeClick: true,
                openEffect: 'elastic',
                openSpeed: 120,
                closeEffect: 'elastic',
                closeSpeed: 100,
                helpers:
                {
                    overlay: { closeClick: false }
                },
                afterClose: function () {
                    //$("#btnSubmit").trigger("click");
                }
            });
        });

    });

    //element = document.getElementById('lbl');
    //element.addEventListener("mouseover", function () {

    //});



    function edit(id) {
        $.fancybox.open({
            href: '../Benevolent/AddContribution/' + id,
            type: 'iframe',
            padding: 5,
            maxWidth: 1200,
            maxHeight: 1200,
            fitToView: false,
            width: '80%',
            height: '100%',
            autoSize: true,
            closeClick: true,
            openEffect: 'elastic',
            openSpeed: 120,
            closeEffect: 'elastic',
            closeSpeed: 100,
            helpers:
            {
                overlay: { closeClick: false }
            },
            afterClose: function () {
                // $("#btnSubmit").trigger("click");
                 GetReportList()
            }
        });
    }

    //function ContDetail(id) {
    //    $.fancybox.open({
    //        href: '../Benevolent/GetDemiseEmployeeDetail/' + id,
    //        type: 'iframe',
    //        padding: 5,
    //        maxWidth: 600,
    //        maxHeight: 700,
    //        fitToView: false,
    //        width: '80%',
    //        height: '100%',
    //        autoSize: true,
    //        closeClick: true,
    //        openEffect: 'elastic',
    //        openSpeed: 120,
    //        closeEffect: 'elastic',
    //        closeSpeed: 100,
    //        helpers:
    //        {
    //            overlay: { closeClick: false }
    //        },
    //        afterClose: function () {
    //            //$("#btnSubmit").trigger("click");
    //        }
    //    });
    //}

</script>
<div class="panel-group">
    <div class="panel panel-primary">
        <div class="panel-heading">
            <table style="width:100%;">
                <tr>
                    <td>
                        <h2 class="panel-title">
                            <strong>Add. Benevolent Deduction</strong>
                        </h2>
                    </td>

                </tr>
            </table>
        </div>
        <div class="panel-body">

            <table class="table table-bordered table-hover table-responsive" id="tbRequestReport">
                <thead>
                    <tr>
                        <th class="text-center">
                            @Html.DisplayName("Emp Code")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Emp Name")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Opration")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Demise Reason")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Demise Date")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("From Date")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("To Date")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Action")
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <a href="#" class="data">@item.EMPLOYEECODE</a>
                                @*@Html.DisplayFor(modelItem => item.EMPLOYEECODE)*@
                            </td>
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.EmpName)
                            </td>
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.Opration)
                            </td>
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.DEMISEREASONE)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.DEMISEDATE)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.FROM_DT)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.TO_DT)
                            </td>
                            <td class="text-center">
                                @*<a id="edit" href="javascript:ContDetail(@item.ASR_BENEVOLENTID)" class="btn btn-success"><span class="glyphicon glyphicon-info-sign"></span></a>*@
                                @if (item.STATUS == 0)
                                {
                                    <a id="edit" data-ctrl="ancEdit" data-bnvlntid="@item.ASR_BENEVOLENTID" class="btn bg-primary"><span class="glyphicon glyphicon-pencil"></span></a>
                                }
                                else
                                {
                                    @* <a id="edit" disabled="disabled" href="javascript:edit(@item.ASR_BENEVOLENTID)" class="btn bg-primary"><span class="glyphicon glyphicon-pencil"></span></a> *@
                                    <a id="edit" data-ctrl="ancEdit" data-bnvlntid="@item.ASR_BENEVOLENTID" disabled="disabled" class="btn bg-primary"><span class="glyphicon glyphicon-pencil"></span></a>
                                }
                                @*<a href="javascript:edit(@item.ASR_BENEVOLENTID)">edit</a>*@
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
