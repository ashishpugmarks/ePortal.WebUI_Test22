@model ePortal.ViewModels.BENEVOLENT_MST

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    @*   @Styles.Render("~/bundle/css")
    @Scripts.Render("~/bundles/js")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval") *@

    @* Bundle CSS files  *@
    <link rel="stylesheet" href="~/css/style.min.css"  />
    <link href="~/css/jquery-ui.css" rel="stylesheet"  />
    <link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet"  />
    <style nonce="@Context.Items["StyleNonce_1"]">
        .ui-autocomplete {
            max-height: 200px;
            overflow-y: auto;
            /* prevent horizontal scrollbar */
            overflow-x: hidden;
            /* add padding to account for vertical scrollbar */
            padding-right: 20px;
        }
    </style>
    <title>AddBenevolentMST</title>

</head>
<body>
    <div class="panel-group">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h2 class="panel-title" style="padding-left: 10px;">
                    <strong>Add Employee for Additional Benevolent Fund Deduction</strong>
                </h2>
            </div>
            <div class="container" style="font-size:12px;height:422px;">
                @using (Html.BeginForm())
                {
                    <br />
                    <div>
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    </div>
                    <div class="row" style="padding:4px;margin-left:50px">
                        @Html.Label(" ", "Employee Code", new { @class = "control-label text-right col-md-1 required", @style = "width:140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextBoxFor(model => model.EMPLOYEECODE, new { @value = "", @class = "form-control", placeholder = "Employee Code" })
                            <span id="spn_auth_msg" style="color:#a94442;font-weight:600;"></span>
                        </div>

                        @Html.Label("", "Employee Name", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextBox("txtEmpName", "", new { @value = "", @class = "form-control", @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row" style="padding:4px;margin-left:50px">
                        @Html.Label("", "Operation", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextBox("txtOpration", "", new { @value = "", @class = "form-control", @disabled = "disabled" })
                        </div>

                        @Html.Label("", "Division", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">

                            @Html.TextBox("txtDivision", "", new { @value = "", @class = "form-control", @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row" style="padding:4px;margin-left:50px">
                        @Html.Label("", "Department", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextBox("txtDepartment", "", new { @value = "", @class = "form-control", @disabled = "disabled" })
                        </div>

                        @Html.Label("", "Section", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">

                            @Html.TextBox("txtSection", "", new { @value = "", @class = "form-control", @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row" style="padding:4px;margin-left:50px">
                        @Html.Label("", "Demise Date", new { @class = "control-label text-right col-md-1 required", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextBoxFor(a => a.DEMISEDATE, new { @class = "form-control", placeholder = "Demise Date" })
                            @*@Html.ValidationMessageFor(a => a.DEMISEDATE, "", new { @class = "text-danger" })*@
                            <span id="spn_auth_msg1" style="color:#a94442;font-weight:600;"></span>
                        </div>

                        @Html.Label("", "Demise Reason ", new { @class = "control-label text-right col-md-1 required", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextAreaFor(a => a.DEMISEREASONE, new { @class = "form-control", placeholder = "Demise Reasone", @maxlength = "400", @rows = "3" })
                            @*@Html.ValidationMessageFor(a => a.DEMISEREASONE, "", new { @class = "text-danger" })*@
                            <span id="spn_auth_msg2" style="color:#a94442;font-weight:600;"></span>
                        </div>
                    </div>
                    <div class="row" style="padding:4px;margin-top:5px;margin-left:50px">
                        <div>
                            <label><u>Contribution Period</u></label>
                        </div>
                    </div>
                    <div class="row" style="padding:4px;margin-left:50px">
                        @Html.Label("", "From Date", new { @class = "control-label text-right col-md-1 required", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextBoxFor(a => a.FROM_DT, new { @class = "form-control", placeholder = "From Date" })
                            @*@Html.ValidationMessageFor(a => a.FROM_DT, "", new { @class = "text-danger" })*@
                            <span id="spn_auth_msg3" style="color:#a94442;font-weight:600;"></span>
                        </div>

                        @Html.Label("", "To Date ", new { @class = "control-label text-right col-md-1 required", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-3 col-lg-3">
                            @Html.TextBoxFor(a => a.TO_DT, new { @class = "form-control", placeholder = "To Date" })
                            @*@Html.ValidationMessageFor(a => a.TO_DT, "", new { @class = "text-danger" })*@
                            <span id="spn_auth_msg4" style="color:#a94442;font-weight:600;"></span>
                        </div>
                    </div>
                    <br />
                    <div class="form-group" style="margin-left:60px">
                        <div class="col-md-offset-4 col-md-8">
                            <input type="button" value="Save" class="btn btn-success" id="btnSave" />
                            <button id="btnCncl" type="button" class="btn btn-default">Cancel</button>
                        </div>
                    </div>
                    <br />
                    @*</div>*@
                }
            </div>
        </div>
        <div id="ajaxLoader"></div>
    </div>

    @* Bundle JS files  *@
    <script src="~/js/jquery.min.js" ></script>
    <script src="~/js/layout.min.js" ></script>
    <script src="~/js/jquery-ui.js" ></script>
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js" ></script>
    <script src="~/js/moment.min.js" ></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
        @* CSP 3.0 Compliant changes *@
            $("#btnCncl").on('click', function () {
                    CloseFancyBox();
            });
            $("#btnSave").on('click', function () {
                    SaveData();
            });
        @* CSP 3.0 Compliant changes *@

            $('#DEMISEDATE').datepicker({
                format: "dd-M-yy",
                //startDate: new Date(),
                endDate: new Date(),
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top'
            });

            $('#DEMISEDATE').change(function () {
                //const moment = require('moment');
                $('#FROM_DT').datepicker({
                    format: "dd-M-yy",
                    startDate: $("#DEMISEDATE").val(),
                    todayHighlight: true,
                    autoclose: true,
                    toolbarplacement: 'top'
                });
            });
            //dateCon()


            $('#FROM_DT').change(function () {
                //$('#TO_DT').datepicker("destroy");
                $('#TO_DT').datepicker({
                    format: "dd-M-yy",
                    startDate: $("#FROM_DT").val(),
                    todayHighlight: true,
                    autoclose: true,
                    toolbarplacement: 'top'
                });
            });

            $('#FROM_DT').click(function () {
                var date = $("#DEMISEDATE").val();
                if (date == "") {
                    alert("Please enter demise date");
                    $("#DEMISEDATE").focus();
                }
            });
            $('#TO_DT').click(function () {
                var date = $("#DEMISEDATE").val();
                if (date == "") {
                    alert("Please enter demise date");
                    $("#DEMISEDATE").focus();
                }
                else {
                    var from = $("#FROM_DT").val();
                    if (from == "") {
                        alert("Please enter from date");
                        $("#FROM_DT").focus();
                    }
                }
            });

            $("#EMPLOYEECODE").blur(function () {
                //var str = $("#EMPLOYEECODE").val().split('-');
                var id = EmpCode($("#EMPLOYEECODE").val());
                if (id != "" && id != null && !isNaN(id)) {

                    $.ajax({
                        type: "POST",
                        url: "/Benevolent/GetEmpCode/" + id,
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        //data: id,
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (data) {

                            if (data == '0') {
                                $.ajax({
                                    type: "POST",
                                    url: "/Benevolent/GetEmpDetail/" + id,
                                    beforeSend: function () {
                                        $("#ajaxLoader").addClass('loader');
                                    },
                                    //data: id,
                                    contentType: "application/json; charset=utf-8",
                                    datatype: "json",
                                    success: function (data) {
                                        if (data != 'null') {
                                            var d1 = JSON.parse(data);
                                            $('#txtEmpName').val(d1.EmpName);
                                            $('#txtOpration').val(d1.Opration);
                                            $('#txtDivision').val(d1.Division);
                                            $('#txtDepartment').val(d1.Department);
                                            $('#txtSection').val(d1.Section);
                                        }
                                        else {
                                            $("#EMPLOYEECODE").val("");
                                            alert("Please Enter Valid Employee Code");
                                        }
                                    },
                                    complete: function () {
                                        $("#ajaxLoader").removeClass('loader');
                                    },
                                    error: function () {
                                        sweetAlert("Oops...", "Something went wrong!", "error");
                                    }
                                });
                            }
                            else {
                                $("#EMPLOYEECODE").val("");
                                alert("Entered employee already exist in the Demised List.");
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });

                }

            });
        });

        function EmpCode(id) {
            var str = id.split('-');
            var id = parseInt(str[0]);
            return id;
        }

        function CloseFancyBox() {
            parent.$.fancybox.close();
        }

        function dateCon(date) {
            //var date = '01-Dec-20222';
            var finalDate;
            var array = date.split('-');
            var month;
            var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            for (var i = 0; i <= monthNames.length; i++) {

                if (monthNames[i] == array[1]) {
                    var number = i + 1;
                    month = "" + number + "";
                    if (month.length == 1) {
                        month = "0" + number;
                    }
                }
            }
            finalDate = array[0] + "-" + month + "-" + array[2];
            return new Date(array[2], month-1, array[0]);
            //return finalDate;

        }
        $(function () {
            $("input#EMPLOYEECODE").autocomplete({
                source: "/Benevolent/AutocompleteSuggestions",
                minLength: 2,
                //scroll:true,
                select: function (event, ui) {
                    if (ui.item) {

                        var strArray = ui.item.value.split('-');
                        if (strArray != null) {
                            $("#EMPLOYEECODE").val(strArray[0]);
                            $("#searchTerm").val(strArray[0]);
                            var strSubArray = strArray[1].split(',');

                            if (strSubArray != null) {
                                //this.value = strArray[0];
                            }
                        }
                    }
                },
                open: function () { $('.ui-menu').width(280).height(200); }
            });
        });
       function getLocalISOString(dateStr) {
            let date = new Date(dateStr);
            date.setMinutes(date.getMinutes() - date.getTimezoneOffset());
            return date.toISOString();
        }
        function SaveData() {
            var isFormVaildation = CheckFormValidation();
            //var isFormVaildation = true;
            if (isFormVaildation) {
                //$("#btnSave").attr("disabled", true);
                var data = {
                    EMPLOYEECODE: EmpCode($("#EMPLOYEECODE").val()),
                     DEMISEDATE: getLocalISOString($('#DEMISEDATE').val()),
                     DEMISEREASONE: $('#DEMISEREASONE').val(),
                     TO_DT: getLocalISOString($('#TO_DT').val()),
                     FROM_DT: getLocalISOString($('#FROM_DT').val()),
                    STATUS: 1

                }
                //alert(JSON.stringify(data));

                $.ajax({
                    type: "POST",
                    url: "/Benevolent/AddBenevolentMS",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: JSON.stringify(data),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data == 0) {
                            alert("Entry is added successfully.");
                            CloseFancyBox();
                        }
                        else {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }

                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }

        }

        function CheckFormValidation() {
            var isVailed = true;
            $('#spn_auth_msg').text('');
            $('#EMPLOYEECODE').removeClass('validationError');
            if ($('#EMPLOYEECODE').val() == "") {
                $('#EMPLOYEECODE').addClass('validationError');
                $('#spn_auth_msg').text('Please Enter Employee code.');
                isVailed = false;
            }
            else {
                var code = EmpCode($("#EMPLOYEECODE").val());
                if (isNaN(code)) {
                    $('#EMPLOYEECODE').addClass('validationError');
                    $('#spn_auth_msg').text('Please Enter only Digit.');
                    isVailed = false;
                }
            }
            $('#DEMISEDATE').removeClass('validationError');
            if ($('#DEMISEDATE').val() == "") {
                $('#DEMISEDATE').addClass('validationError');
                $('#spn_auth_msg1').text('Please Enter Demise Date.');
                isVailed = false;
            }
            else {
                $('#DEMISEDATE').removeClass('validationError');
                $('#spn_auth_msg1').text('');

            }
            $('#DEMISEREASONE').removeClass('validationError');
            if ($('#DEMISEREASONE').val() == "") {
                $('#DEMISEREASONE').addClass('validationError');
                $('#spn_auth_msg2').text('Please Enter Demise Reasone.');
                isVailed = false;
            }
            else if ($('#DEMISEREASONE').val().length < 4)
            {
                var len = $('#DEMISEREASONE').val().length;
                if (len < 40) {
                    $('#spn_auth_msg2').text('Minimum 40 charchaters requied for demise reasone.');
                    isVailed = false;
                }
            }
            else {
                $('#DEMISEREASONE').removeClass('validationError');
                $('#spn_auth_msg2').text('');

            }

            $('#FROM_DT').removeClass('validationError');
            if ($('#FROM_DT').val() == "") {
                $('#FROM_DT').addClass('validationError');
                $('#spn_auth_msg3').text('Please Enter From Date.');
                isVailed = false;
            }
            $('#TO_DT').removeClass('validationError');
            if ($('#TO_DT').val() == "") {
                $('#TO_DT').addClass('validationError');
                $('#spn_auth_msg4').text('Please Enter To Date.');
                isVailed = false;
            }

            if ($('#FROM_DT').val() != "") {
                var demise = $('#DEMISEDATE').val()
                if (demise > $('#FROM_DT').val()) {
                    $('#FROM_DT').addClass('validationError');
                    $('#spn_auth_msg3').text('Contribution period shoud start after Demise date');
                    isVailed = false;
                }
            }

            if ($('#TO_DT').val() != "") {
                var from = dateCon($('#FROM_DT').val());
                var to = dateCon($('#TO_DT').val());
                if (to < from) {
                    $('#TO_DT').addClass('validationError');
                    $('#spn_auth_msg4').text('To date shoud start after From date.');
                    isVailed = false;
                }
                else {
                    $('#spn_auth_msg4').text('');
                }
            }

            //$('#EMPLOYEECODE').removeClass('validationError');
            //if ($('#EMPLOYEECODE').val() == "" || $('#EMPLOYEECODE').val() == "0") {
            //    $('#EMPLOYEECODE').addClass('validationError');
            //    isVailed = false;
            //}


            return isVailed;
        }
    </script>
</body>
</html>
