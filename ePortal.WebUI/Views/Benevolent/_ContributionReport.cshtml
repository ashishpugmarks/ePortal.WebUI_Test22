@model IEnumerable<ePortal.ViewModels.BenevolentViewModel>
@{
    Layout = null;
}

<style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    select.input-sm {
        line-height: 10px !important;
    }
</style>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    $('.homeContent').removeClass('homeContent');
    $(document).ready(function () {
    @* CSP 3.0 Compliant changes *@
            $('[data-ctrl="ancEdit"]').on('click', function () {
                let bnvlntId = $(this).data("bnvlntid");
                ContDetail(bnvlntId);
            });
    @* CSP 3.0 Compliant changes *@

        //$.fn.dataTable.moment('dd-M-yyyy');
        $("#tbRequestReport").dataTable({
            "bFilter": false,
            "bLengthChange": false,
            "order": [[2, 'desc']],
            "columnDefs": [
                {
                    "searchable": false,
                    "orderable": true,
                    "targets": 2,
                    "type": 'date'
                }
            ]

        });
    });

    function ContDetail(id)
    {
        $.fancybox.open({
            href: '../Benevolent/GetContributionReportDetail/' + id,
            type: 'iframe',
            padding: 5,
            maxWidth: 600,
            maxHeight: 700,
            fitToView: false,
            width: '80%',
            height: '100%',
            autoSize: true,
            closeClick: true,
            openEffect: 'elastic',
            openSpeed: 120,
            closeEffect: 'elastic',
            closeSpeed: 100,
            helpers:
            {
                overlay: { closeClick: false }
            },
            afterClose: function () {
                //$("#btnSubmit").trigger("click");
            }
        });
    }
</script>

<div class="panel-group">
    <div class="panel panel-primary">
        <div class="panel-heading">
            <table style="width:100%;">
                <tr>
                    <td>
                        <h2 class="panel-title">
                            <strong>Contribution List</strong>
                        </h2>
                    </td>
                </tr>
            </table>
        </div>
        <div class="panel-body">
            <table class="table table-bordered table-hover table-responsive" id="tbRequestReport">
                <thead>
                    <tr>
                        @*<th class="text-center">
                            @Html.DisplayName("PR No")
                        </th>*@
                        <th class="text-center" style="width:130px;">
                            @Html.DisplayName("Employee Code (Demise)")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Employee Name (Demise)")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Employee Demise Date")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Employee Code(Contribute)")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Employee Name")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Operation")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Contribution Period")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Amount")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("View")
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.EMPLOYEECODE)
                            </td>
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.EmpName)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.DEMISEDATE)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.CONSENTBYEMPLOYEE)
                            </td>
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.CONSENTBYEmpName)
                            </td>
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.Opration)
                            </td>
                            <td class="text-center" style="font-size:12px;">
                                @Html.DisplayFor(modelItem => item.ContributionPeriod)
                            </td>
                            <td class="text-right">
                                @Html.DisplayFor(modelItem => item.AMOUNT)
                            </td>
                            <td class="text-center">
                                <a id="edit" data-ctrl="ancEdit" data-bnvlntid="@item.ASR_BENEVOLENT_DTID" class="btn bg-primary"><span class="glyphicon glyphicon-info-sign"></span></a>
                                @*<a href="javascript:ContDetail(@item.ASR_BENEVOLENT_DTID)" id="btnContri">Detail</a>*@
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

