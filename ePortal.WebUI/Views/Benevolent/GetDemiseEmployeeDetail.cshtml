@model ePortal.ViewModels.BenevolentViewModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    @*@Styles.Render("~/bundle/css")
    @Scripts.Render("~/bundles/js")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")*@

    @* Bundle CSS files  *@
    <link rel="stylesheet" href="~/css/style.min.css"  />
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
    </style>

    <link href="~/css/jquery-ui.css" rel="stylesheet"  />

    <link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet"  />


    <title>AddBenevolentMST</title>
  
</head>
<body>
    <div class="panel-group">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h2 class="panel-title" style="padding-left: 10px;">
                    <strong>Demise Employee Detail</strong>
                </h2>
            </div>
            <br />
            <table style="width:100%;" class="table table-striped table-condensed">
                @*<tr class="HeaderStyle123">
                    <td colspan="3" style="height:25px;">
                        <h3 style="font-weight: bold;">Employee Detail's</h3>
                    </td>
                </tr>*@
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Employee Code:</span>
                    </td>
                    <td style="width: 220px; color: #2683D4;">
                        <b><label >@Html.DisplayFor(a => a.EMPLOYEECODE, new { @class = "control-label text-right col-md-1" })</label></b>
                    </td>
                    <td rowspan="4" align="center" valign="middle">
                        <table border="1" style="border-right: #cccccc thin solid; border-top: #cccccc thin solid; border-left: #cccccc thin solid; border-bottom: #cccccc thin solid">
                            <tr>
                                <td>
                                    <div>
                                        <img src="@ViewBag.img" height="130" width="110"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Employee Name:</span>
                    </td>
                    <td style="width: 220px; color: #2683D4;">
                        <label >@Html.DisplayFor(a => a.EmpName, new { @class = "control-label text-right col-md-1" })</label>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Operation:</span>
                    </td>
                    <td style="width: 220px; color: #2683D4;">
                        <label >@Html.DisplayFor(a => a.Opration, new { @class = "control-label text-right col-md-1" })</label>
                    </td>
                </tr>

                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right; height: 24px;">
                        <span>Division:</span>
                    </td>
                    <td style="width: 220px; height: 24px; color: #2683D4;">
                        <label >@Html.DisplayFor(a => a.Division, new { @class = "control-label text-right col-md-1" })</label>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right; height: 24px;">
                        <span>Department:</span>
                    </td>
                    <td colspan="2" style="height: 24px; color: #2683D4;">
                        <label >@Html.DisplayFor(a => a.Department, new { @class = "control-label text-right col-md-1" })</label>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Section:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <label >@Html.DisplayFor(a => a.Section, new { @class = "control-label text-right col-md-1" })</label>
                    </td>
                </tr>
                @*<tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Demise Date:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <label >@Html.DisplayFor(a => a.DEMISEDATE, new { @class = "control-label text-right col-md-1"})</label>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Demise Reason:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <label >@Html.DisplayFor(a => a.DEMISEREASONE, new { @class = "control-label text-right col-md-1" })</label>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Contribution Period:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <label style="">@Html.DisplayFor(a => a.ContributionPeriod, new { @class = "control-label text-right col-md-4" })</label>
                    </td>
                </tr>*@
                @*<tr>
                    <td colspan="3" align="center">
                        <div class="col-md-4 col-md-8">
                            <button type="button" class="btn btn-default" onclick="CloseFancyBox()">Close</button>
                        </div>
                    </td>
                </tr>*@

            </table>
            <div class="form-group">
                
            </div>

        </div>
        <div id="ajaxLoader"></div>
    </div>
    @* Bundle JS files  *@
    <script src="~/js/jquery.min.js"  ></script>
    <script src="~/js/layout.min.js"  ></script>
    <script src="~/js/jquery-ui.js" ></script>
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js" ></script>
    <script src="~/js/moment.min.js" ></script>

    <script nonce="@Context.Items["ScriptNonce_4"]">
        function CloseFancyBox() {
            parent.$.fancybox.close();
        }
    </script>

</body>
</html>
