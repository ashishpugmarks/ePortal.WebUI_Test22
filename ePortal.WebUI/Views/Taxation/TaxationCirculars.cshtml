@model IEnumerable<ePortal.ViewModels.TaxationViewModel>

@{
    ViewBag.Title = "Employee Portal - Taxation :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
        /* .Headerpad { */
        /*     padding: left 20px; */
        /* } */
    </style>
}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">Taxation Circulars</div>
    </div>
    <div class="body-content" style="overflow-x:auto!important;">
        @*<%--   <asp:Panel BackColor="#F7E9E9" ID="Panel3" runat="server" Width="100%" CssClass="roundedPanel">
                <div style="padding-left: 6px;">
                    <asp:Panel BackColor="#f7faff" ID="Panel4" runat="server" Width="99%" CssClass="roundedPanel">
                        --%>*@
        @*<asp:GridView ID="grdTCS" runat="server" AutoGenerateColumns="False" CssClass="table table-bordered table-hover table-responsive"
                                        Width="100%" OnRowDataBound="grdTCS_RowDataBound" Style="padding: 5px;"
                                        AllowPaging="True" OnPageIndexChanging="grdTCS_PageIndexChanging"
                                        PageSize="15">
                            <PagerStyle CssClass="PagerStyle" />
                            <HeaderStyle CssClass="grdHeader" Height="25px" />
                            <RowStyle CssClass="grdrow" Height="20px" />
                            <EmptyDataRowStyle BackColor="#F5FFF0" Height="20px" Font-Names="Calibri" ForeColor="#274D14" />
                            <AlternatingRowStyle BackColor="White" ForeColor="#5D838C" Height="20px" />
                            <Columns>
                                <asp:TemplateField HeaderText="&#160;S.No." HeaderStyle-CssClass="Headerpad">
                                    <ItemStyle HorizontalAlign="Left" VerticalAlign="Middle" Width="8%" />
                                    <HeaderStyle HorizontalAlign="Left" VerticalAlign="Middle" Width="8%" />
                                    <ItemTemplate>
                                        <asp:Label ID="lblsno" Style="padding: 8px;" runat="server" Text='<%# Container.DataItemIndex +1%>'></asp:Label>
                                    </ItemTemplate>
                                </asp:TemplateField>
                                <asp:TemplateField HeaderText="&#160;Series">
                                    <ItemStyle HorizontalAlign="Left" VerticalAlign="Middle" Width="50%" />
                                    <HeaderStyle HorizontalAlign="Left" VerticalAlign="Middle" Width="50%" />
                                    <ItemTemplate>
                                        <%-- <asp:LinkButton ID="lbseries" runat="server"></asp:LinkButton>--%>
                                        <asp:HyperLink ID="hlseries" Style="padding: 8px;" runat="server"></asp:HyperLink>
                                        <%-- <a ID="aseries" runat="server"></a>--%>
                                    </ItemTemplate>
                                </asp:TemplateField>
                                <asp:TemplateField HeaderText="&#160;Release Date">
                                    <ItemStyle HorizontalAlign="Left" VerticalAlign="Middle" Width="20%" />
                                    <HeaderStyle HorizontalAlign="Left" VerticalAlign="Middle" Width="20%" />
                                    <ItemTemplate>
                                        <asp:Label ID="lblreleasedate" Style="padding: 8px;" runat="server"></asp:Label>
                                    </ItemTemplate>
                                </asp:TemplateField>
                            </Columns>
                        </asp:GridView>
                        *@
        @* <%--
                    </asp:Panel>
                </div>
            </asp:Panel>
            <ajaxToolkit:RoundedCornersExtender ID="RoundedCornersExtender3" runat="server" BehaviorID="RoundedCornersBehavior_Panel3"
                                                TargetControlID="Panel3" Radius="6" Corners="All" />
            <ajaxToolkit:RoundedCornersExtender ID="RoundedCornersExtender4" runat="server" BehaviorID="RoundedCornersBehavior_Panel4"
                            TargetControlID="Panel4" Radius="6" Corners="All" />--%>*@

        <table id="grdTCS" class="table table-bordered table-hover table-responsive" style="padding:5px; width:100%">
            <thead class="grdHeader" style="height:25px;">
                <tr>
                    <th style="width:8%">S.No.</th>
                    <th style="width:50%">Series</th>
                    <th style="width:20%">Release Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    var sno = 1;
                    foreach (var item in Model)
                    {
                        <tr class="@(sno % 2 == 0 ? "grdrow" : "altRow")" style="height:20px;">
                            <td>
                                <span id="lblsno" style="padding:8px;">@sno</span>
                            </td>
                            <td>
                                <a id="hlseries"
                                   href="javascript:WindowSettings_WithoutMenu('../../Uploads/Taxation/TaxationCirculars/@item.ATTECHMENT','test')"
                                   style="padding:8px;">
                                    @item.Series
                                </a>
                            </td>
                            <td>
                                <span id="lblreleasedate" style="padding:8px;">
                                    @item.ReleaseDate.ToString("dd-MMM-yyyy")
                                </span>
                            </td>
                        </tr>
                        sno++;
                    }
                }
                else
                {
                    <tr style="background-color:#F5FFF0; height:20px; color:#274D14; font-family:Calibri;">
                        <td colspan="3">No records found</td>
                    </tr>
                }
            </tbody>
        </table>
        <table class="table table-bordered table-hover table-responsive">
            <tbody>
                <tr>
                    <td style="height: 24px; width: 20px; padding-left: 2px;" valign="middle" align="right">
                        <a title="Back" href="Home/Home">
                            <img src="../images/icon_back.gif" height="16px" width="16px" alt="" border="0" />
                        </a>
                    </td>
                    <td style="height: 24px; padding-left: 4px;" align="left">
                        <a title="Back" href="/Home/Home">Back</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div id="ajaxLoader"></div>

@section Scripts {

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
         $('.homeContent').removeClass('homeContent');

        function WindowSettings_WithoutMenu(str1, str2) {
            var winTop = (screen.height / 2) - 325;
            var winLeft = (screen.width / 2) - 425;
            var windowFeatures = "location=no,status=no,width=790,height=550";
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable" + ",scrollbars";
            window.open(str1, str2, windowFeatures);
        }

    </script>
}

