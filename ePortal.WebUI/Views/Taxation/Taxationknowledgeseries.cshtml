@model IEnumerable<ePortal.ViewModels.TaxationViewModel>

@{
    ViewBag.Title = "Employee Portal - Taxation :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .Headerpad {
            padding: left 20px;
        }
    </style>
}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">Taxation Awareness Series</div>
    </div>
    <div class="body-content" style="overflow-x:auto!important;">
        <table id="grdTAS" class="table table-bordered table-hover table-responsive" style="padding:5px; width:100%">
            <thead class="grdHeader" style="height:25px;">
                <tr>
                    <th style="width:8%">S.No.</th>
                    <th style="width:50%">Series</th>
                    <th style="width:20%">Release Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    var sno = 1;
                    foreach (var item in Model)
                    {
                        <tr class="@(sno % 2 == 0 ? "grdrow" : "altRow")" style="height:20px;">
                            <td>
                                <span id="lblsno" style="padding:8px;">@sno</span>
                            </td>
                            <td>
                                <a id="hlseries"
                                   href="javascript:WindowSettings_WithoutMenu('../../Uploads/Taxation/@item.ATTECHMENT','test')"
                                   style="padding:8px;">
                                    @item.Series
                                </a>
                            </td>
                            <td>
                                <span id="lblreleasedate" style="padding:8px;">
                                    @item.ReleaseDate.ToString("dd-MMM-yyyy")
                                </span>
                            </td>
                        </tr>
                        sno++;
                    }
                }
                else
                {
                    <tr style="background-color:#F5FFF0; height:20px; color:#274D14; font-family:Calibri;">
                        <td colspan="3">No records found</td>
                    </tr>
                }
            </tbody>
        </table>
        <table class="table table-bordered table-hover table-responsive">
            <tbody>
                <tr>
                    <td style="height: 24px; width: 20px; padding-left: 2px;" valign="middle" align="right">
                        <a title="Back" href="Home/Home">
                            <img src="../images/icon_back.gif" height="16px" width="16px" alt="" border="0" />
                        </a>
                    </td>
                    <td style="height: 24px; padding-left: 4px;" align="left">
                        <a title="Back" href="/Home/Home">Back</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div id="ajaxLoader"></div>

@section Scripts {

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
         $('.homeContent').removeClass('homeContent');

        function WindowSettings_WithoutMenu(str1, str2) {
            var winTop = (screen.height / 2) - 325;
            var winLeft = (screen.width / 2) - 425;
            var windowFeatures = "location=no,status=no,width=790,height=550";
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable" + ",scrollbars";
            window.open(str1, str2, windowFeatures);
        }

    </script>
}

