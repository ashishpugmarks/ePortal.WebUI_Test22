@model Tuple<string, IReadOnlyList<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>>
@{
    var title = Model.Item1;
    var rows = Model.Item2 ?? Array.Empty<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>();
}
@* <table class="table-bordered" cellspacing="1" cellpadding="4" border="0" id="ctl00_InnerContent_GridView3" style="color:#333333;width:100%;">
    <tr class="contenttableborder" style="color:Black;background-color:White;height:20px;width:100%;">
        <td colspan="8">No record found.</td>
    </tr>
</table> *@
<table>
    <tr style="color:Black;background-color:White;height:20px;width:100%;">
        <td>
            <table class="table-bordered">

                <thead >
                    @if (rows.Count == 0)
                    {
                        
                    }
                    else
                    {
                        <tr>
                            <th>App Date</th>
                            <th>Leave From</th>
                            <th>Leave To</th>
                            <th>Days</th>
                            <th>Purpose</th>
                            <th>Recommended By</th>
                            <th>Sanctioned By</th>
                            <th>P/U</th>
                        </tr>
                    }
                </thead>
                <tbody>
                    @if (rows.Count == 0)
                    {
                        <tr>
                            <td colspan="8">No record found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var r in rows)
                        {
                            <tr>
                                <td>@r.AppDate</td>
                                <td>@r.LeaveFrom</td>
                                <td>@r.LeaveTo</td>
                                <td>@r.Days</td>
                                <td>@r.Purpose</td>
                                <td>@r.RecommendedBy</td>
                                <td>@r.SanctionedBy</td>
                                <td>@r.PlanPU</td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </td>
    </tr>
</table>

