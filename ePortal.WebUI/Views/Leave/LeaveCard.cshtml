@model ePortal.ViewModels.APPX.Leave.LeaveCardViewModel

@{
    ViewBag.Title = "Leave";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/leave/css/leave_card_new.css" rel="stylesheet" asp-append-version="true" />
}

<div id="ctl00_InnerContent_upPnl_LC">

    <div class="row content" style="margin-left: 5px; margin-right: 10px; margin-top: 5px;">
        <table cellpadding="5" cellspacing="0" align="left" style="width: 100%">
            <tr>
                <td style="padding-left: 5px; padding-right: 5px;">

                    <div class="specs">
                        <div class="inner">
                            <h2>Employee Details</h2>
                            <div class="clearer">
                            </div>
                            <div class="row">
                                <div class="col-xs-6 col-md-3 col-lg-6">
                                    <table>
                                        <tbody>
                                            <tr>
                                                <td style="text-align: right; font-weight: bold;">
                                                    <b>Year :- </b>
                                                </td>
                                                <td style="text-align: left; color: #C77F20; font-weight: bold;">
                                                    <span id="ctl00_InnerContent_lbl_Year">@Model.Year</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="text-align: right; font-weight: bold;">
                                                    <b>Operation :- </b>
                                                </td>
                                                <td style="text-align: left; color: #C77F20; font-weight: bold;">
                                                    <span id="ctl00_InnerContent_lbl_Operation">@Model.Operation</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="text-align: right; font-weight: bold;">
                                                    <b>Department :- </b>
                                                </td>
                                                <td style="text-align: left; color: #C77F20; font-weight: bold;">
                                                    <span id="ctl00_InnerContent_lbl_Department">@Model.Department</span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-xs-6 col-md-3 col-lg-6">
                                    <table>
                                        <tbody>
                                            <tr>
                                                <td style="text-align: right; font-weight: bold;">
                                                    <b>Name :- </b>
                                                </td>
                                                <td style="text-align: left; color: #C77F20; font-weight: bold;">
                                                    <span id="ctl00_InnerContent_lbl_Employee">@Model.Employee</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="text-align: right; font-weight: bold;">
                                                    <b>Division :- </b>
                                                </td>
                                                <td style="text-align: left; color: #C77F20; font-weight: bold;">
                                                    <span id="ctl00_InnerContent_lbl_Division">@Model.Division</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="text-align: right; font-weight: bold;">
                                                    <b>Section :- </b>
                                                </td>
                                                <td style="text-align: left; color: #C77F20; font-weight: bold;">
                                                    <span id="ctl00_InnerContent_lbl_Section">@Model.Section</span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="clearer">
                            </div>
                        </div>
                        <div class="inner" style="margin-top: 5px;">
                            <h2>Leave Balance As On Today</h2>
                            <div class="clearer">
                            </div>
                            <div class="row">
                                <div class="col-xs-6 col-md-3 col-lg-6">
                                    <table>
                                        <tbody>
                                            <tr>
                                                <td style="text-align: right; font-weight: bold; width: 110px;">
                                                    &nbsp;<span id="ctl00_InnerContent_lblSL">Sick Leave</span>
                                                    :-&nbsp;
                                                </td>
                                                <td style="text-align: left; color: #C77F20;">
                                                    <span id="ctl00_InnerContent_SL">@Model.SL_Availed</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="text-align: right; font-weight: bold; width: 110px;">
                                                    &nbsp;<span id="ctl00_InnerContent_lblCL">Casual Leave</span>
                                                    :-&nbsp;
                                                </td>
                                                <td style="text-align: left; color: #C77F20;">
                                                    <span id="ctl00_InnerContent_CL">@Model.CL_Availed</span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-xs-6 col-md-3 col-lg-6">
                                    <table>
                                        <tbody>
                                            <tr>
                                                <td style="text-align: right; font-weight: bold; width: 150px;">
                                                    &nbsp;<span id="ctl00_InnerContent_lblEL">Earned Leave</span>
                                                    :-&nbsp;
                                                </td>
                                                <td style="text-align: left; color: #C77F20;">
                                                    <span id="ctl00_InnerContent_EL">@Model.EL_Availed</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="text-align: right; font-weight: bold; width: 150px;">
                                                    &nbsp;<span id="ctl00_InnerContent_lblCO">Compensatory Off (HRS)</span>
                                                    :-&nbsp;
                                                </td>
                                                <td style="text-align: left; color: #C77F20;">
                                                    <span id="ctl00_InnerContent_CompOff">@Model.CO_Availed</span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="clearer">
                            </div>

                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td style="padding: 5px;">

                    <table style="width: 100%; margin-bottom: 5px; margin-top: 5px;" class="table table-bordered table-condensed">
                        <tbody>
                            <tr class="HeaderStyle12">
                                <td style="padding-bottom: 5px; padding-right: 5px;">
                                    <h4 style="color">Sick Leave Records</h4>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div>
                                        @Html.Partial("_LeaveSection", new Tuple<string, IReadOnlyList<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>>(
                                                 "Sick Leave Records", Model.SickRows ?? new List<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>()))

                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </td>
            </tr>
            <tr>
                <td style="padding: 5px;">

                    <table style="width: 100%; margin-bottom: 5px; margin-top: 5px;" class="table table-bordered table-condensed">
                        <tbody>
                            <tr class="HeaderStyle12">
                                <td style="padding-bottom: 5px; padding-right: 5px;">
                                    <h4>Casual Leave Records</h4>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div>
                                        @Html.Partial("_LeaveSection", new Tuple<string, IReadOnlyList<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>>(
                                                 "Casual Leave Records", Model.CasualRows ?? new List<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>()))

                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </td>
            </tr>
            <tr>
                <td style="padding: 5px;">

                    <table style="width: 100%; margin-bottom: 5px; margin-top: 5px;" class="table table-bordered table-condensed">
                        <tbody>
                            <tr class="HeaderStyle12">
                                <td style="padding-bottom: 5px; padding-right: 5px;">
                                    <h4>Earn Leave Records</h4>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div>
                                        @Html.Partial("_LeaveSection", new Tuple<string, IReadOnlyList<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>>(
                                                 "Earn Leave Records", Model.EarnedRows ?? new List<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>()))

                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </td>
            </tr>
            <tr>
                <td style="padding: 5px;">

                    <table style="width: 100%; margin-bottom: 5px; margin-top: 5px;" class="table table-bordered table-condensed">
                        <tbody>
                            <tr class="HeaderStyle12">
                                <td style="padding-bottom: 5px; padding-right: 5px;">
                                    <h4>Compensatory Off</h4>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div>
                                        @Html.Partial("_LeaveSection", new Tuple<string, IReadOnlyList<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>>(
                                                 "Compensatory Off", Model.CompOffRows ?? new List<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>()))

                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </td>
            </tr>
            <tr>
                <td style="padding: 5px;">

                    <table style="width: 100%; margin-bottom: 5px; margin-top: 5px;" class="table table-bordered table-condensed">
                        <tbody>
                            <tr class="HeaderStyle12">
                                <td style="padding-bottom: 5px; padding-right: 5px;">
                                    <h4>Leave Without Pay</h4>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div>
                                        @Html.Partial("_LeaveSection", new Tuple<string, IReadOnlyList<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>>(
                                                 "Leave Without Pay", Model.LwpRows ?? new List<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>()))

                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </td>
            </tr>

            <tr>
                <td style="padding: 5px;">

                    <table style="width: 100%; margin-bottom: 5px; margin-top: 5px;" class="table table-bordered table-condensed">
                        <tbody>
                            <tr class="HeaderStyle12">
                                <td style="padding-bottom: 5px; padding-right: 5px;">
                                    <h4>Relocation Leave</h4>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div>
                                        @Html.Partial("_LeaveSection", new Tuple<string, IReadOnlyList<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>>(
                                                 "Relocation Leave", Model.RelocationRows ?? new List<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>()))

                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </td>
            </tr>
            <tr>
                <td style="padding: 5px;">

                    <table style="width: 100%; margin-bottom: 5px; margin-top: 5px;" class="table table-bordered table-condensed">
                        <tbody>
                            <tr class="HeaderStyle12">
                                <td style="padding-bottom: 5px; padding-right: 5px;">
                                    <h4>Advance Earned Leave</h4>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div>
                                        @Html.Partial("_LeaveSection", new Tuple<string, IReadOnlyList<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>>(
                                                 "Advance Earned Leave", Model.AdvanceEarnedRows ?? new List<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>()))

                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </td>
            </tr>
            <tr>
                <td style="padding: 5px;">

                    <table style="width: 100%; margin-bottom: 5px; margin-top: 5px;" class="table table-bordered table-condensed">
                        <tbody>
                            <tr class="HeaderStyle12">
                                <td style="padding-bottom: 5px; padding-right: 5px;">
                                    <h4>Special Leave</h4>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div>
                                        @Html.Partial("_LeaveSection", new Tuple<string, IReadOnlyList<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>>(
                                                 "Special Leave", Model.SpecialLeaveRows ?? new List<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>()))

                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </td>
            </tr>
            
            @if (Model.ShowMaternity)
            {
                <tr>
                    <td style="padding: 5px;">

                        <table style="width: 100%; margin-bottom: 5px; margin-top: 5px;" class="table table-bordered table-condensed">
                            <tbody>
                                <tr class="HeaderStyle12">
                                    <td style="padding-bottom: 5px; padding-right: 5px;">
                                        <h4>Maternity Leave</h4>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div>
                                            @Html.Partial("_LeaveSection", new Tuple<string, IReadOnlyList<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>>(
                                                     "Maternity Leave", Model.MaternityRows ?? new List<ePortal.ViewModels.APPX.Leave.LeaveDetailRow>()))

                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                    </td>
                </tr>
            }

        </table>
    </div>

</div>
<div style="margin-left: 0.8em; margin-right: 0.8em; padding:4px;" class="well well-sm">
    <table border="0" style="width: 100%;">
        <tr>
            <td style="height: 20px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td style="width: 20px; vertical-align: middle; text-align: center;" align="left">
                                <a title="Back" href="/Leave/Leave_Card_New">
									<img src="~/images/icon_back.gif" border="0" alt="" />									
                                </a>
                            </td>
                            <td style="vertical-align: middle; font-size: 15px;">
                                <span><a title="Back" href="/Leave/Leave_Card_New">Back</a></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>

    <div id="ajaxLoader"></div>

@section Scripts{
    <script src="~/app/leave/js/leave_card_new.js" asp-append-version="true"></script>
}
