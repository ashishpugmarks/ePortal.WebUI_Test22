@model List<ePortal.ViewModels.APPX.Leave.EmployeeLeaveRow>


@* @{
    var year = ViewData["Year"]?.ToString() ?? DateTime.Now.Year.ToString();
}
 *@

<table class="tbl_new" border="0">
    <tbody>
        <tr>
            <td style="width:28%;">My Detail's</td>
            <td style="color:#447059;width:38%;font-weight:Bold;">Leaves Availed</td>
            <td style="color:#BD6706;width:32%;font-weight:Bold;">Leaves Balance</td>
        </tr>

    </tbody>
</table>

<table class="grd_new" cellspacing="0" rules="all" border="1" style="border-width:1px;border-style:solid;border-collapse:collapse;">
    <thead>
        <tr class="grd_new_headerstyle" align="left">
            <th><b>ECode</b></th>
            <th><b>Name</b></th>
            <th><b>SL</b></th>
            <th><b>CL</b></th>
            <th><b>EL</b></th>
            <th><b>C-Off</b></th>
            <th><b> </b></th>
            <th><b>SL</b></th>
            <th><b>CL</b></th>
            <th><b>EL</b></th>
            <th><b>C-Off</b></th>
            <th><b> </b></th>
        </tr>
    </thead>
    <tbody>
      
@foreach (var r in Model)
{


            var encryptedEcode = ePortal.Shared.Encryption.Encrypt(r.ECode);

            <tr>
                <td>
                    @Html.ActionLink(
                             linkText: r.ECode,                 // clickable employee code
                             actionName: "LeaveCard",           // your action
                             controllerName: "Leave",           // your controller
                             routeValues: new
                             {
                                 ed = ViewData["Year"],   // first value: selected Year from main view
                                 eid = encryptedEcode        // second value (example: encrypted ecode)
                             },
                             htmlAttributes: null
                             )
                </td>


        <td style="color:#000000;width:200px;"><span>@r.EName</span></td>
        <td style="color:#206B44;width:80px;"><span>@(r.SL_Availed?.ToString() ?? "0")</span></td>
        <td style="color:#206B44;width:80px;"><span>@(r.CL_Availed?.ToString() ?? "0")</span></td>
        <td style="color:#206B44;width:80px;"><span>@(r.EL_Availed?.ToString() ?? "0")</span></td>
        <td style="color:#206B44;width:80px;"><span>@(r.COff_Availed ?? "0")</span></td>
        <td style="color:#206B44;width:150px;">&nbsp;</td>
        <td style="color:#BD6706;width:80px;"><span>@(r.SL_Balance?.ToString() ?? "0")</span></td>
        <td style="color:#BD6706;width:80px;"><span>@(r.CL_Balance?.ToString() ?? "0")</span></td>
        <td style="color:#BD6706;width:80px;"><span>@(r.EL_Balance?.ToString() ?? "0")</span></td>
               <td style="color:#BD6706;width:80px;"><span>@(r.COff_Balance ?? "0")</span></td>
        <td style="color:#BD6706;width:80px;">&nbsp;</td>
    </tr>
}
    </tbody>
</table>
