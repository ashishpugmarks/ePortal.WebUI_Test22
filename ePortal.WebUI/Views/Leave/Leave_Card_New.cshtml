@model ePortal.ViewModels.APPX.Leave.LeaveViewModel


@{
	ViewBag.Title = "Leave";
	Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";

	// Make the selected Year available to partials
	ViewData["Year"] = Model.Year;
}


@section Styles {
	<link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
	<link href="~/app/leave/css/leave_card_new.css" rel="stylesheet" asp-append-version="true" />
}




<div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
	<span style="padding-left: 10px;">Leave Card</span>
</div>
	<div class="body-content">
	
		<div id="Leave_Card">

			<div class="row content" style="margin-left: 5px; margin-right: 10px; margin-top: 5px;">
				<table class="basePanel" style="width:100%;">
					<tbody>
						<tr>
							<td class="HeaderStyle12" colspan="4" style="color: #4A97C7; font-size: 14px; height: 2em; vertical-align: middle;">
								SEARCH
							</td>
						</tr>

						<tr>
							<td style="width: 10%;" align="right" valign="middle">
								Year <span style="font-weight: bold; color: Black;"> :-</span>
							</td>
							<td style="width: 40%; border-right: dotted 1px #C3D5ED;">
								@Html.DropDownListFor(m => m.Year, Model.FromYears, new { @class = "form-select", id = "ddlYear" })
							</td>

							<td style="width: 10%;" align="right" valign="middle">
								Operation <span style="font-weight: bold; color: Black;"> :-</span>
							</td>
							<td style="width: 40%;" valign="middle">

								@Html.DropDownListFor(
																	m => m.OperationId,
																	Model.Operations,
																	new
																	{
																		@class = "form-select",
																		id = "ddlOperation",
																		disabled = Model.OperationDisabled ? "disabled" : null
																	})
							</td>
						</tr>

						<tr><td colspan="4" class="fieldSectionSeparator">&nbsp;</td></tr>

						<tr>
							<td style="width: 10%;" align="right" valign="middle">
								Division <span style="font-weight: bold; color: Black;"> :-</span>
							</td>
							<td style="width: 40%; border-right: dotted 1px #C3D5ED;">

								@Html.DropDownListFor(
																	m => m.DivisionId,
																	Model.Divisions,
																	new
																	{
																		@class = "form-select",
																		id = "ddlDivision",
																		disabled = Model.DivisionDisabled ? "disabled" : null
																	})
							</td>
							<td style="width: 10%;" align="right" valign="middle">
								Department <span style="font-weight: bold; color: Black;"> :-</span>
							</td>
							<td style="width: 40%;" valign="middle">

								@Html.DropDownListFor(
																	m => m.DepartmentId,
																	Model.Departments,
																	new
																	{
																		@class = "form-select",
																		id = "ddlDepartment",
																		disabled = Model.DepartmentDisabled ? "disabled" : null
																	})
							</td>
						</tr>

						<tr><td colspan="4" class="fieldSectionSeparator">&nbsp;</td></tr>

						<tr>
							<td style="width: 10%;" align="right" valign="middle">
								Section <span style="font-weight: bold; color: Black;"> :-</span>
							</td>
							<td style="width: 40%; border-right: dotted 1px #C3D5ED;">
								@Html.DropDownListFor(
																	m => m.SectionId,
																	Model.Sections,
																	new
																	{
																		@class = "form-select",
																		id = "ddlSection",
																	    disabled = Model.SectionDisabled ? "disabled" : null
																	})
							</td>
							<td style="width: 10%;" align="right" valign="middle">
								Employee <span style="font-weight: bold; color: Black;"> :-</span>
							</td>
							<td style="width: 40%;" valign="middle">

								@Html.DropDownListFor(
																	m => m.EmployeeId,
																	Model.Employees,
																	new
																	{
																		@class = "form-select",
																		id = "ddlEmployee",
																		disabled = Model.EmployeeDisabled ? "disabled" : null
																	})
							</td>
						</tr>
					</tbody>
				</table>

				<table class="someCss" style="width: 100%; border: solid 1px #FFD152;">
					<tbody>
						<tr>
							<td><b>SL :- Sick Leave</b></td>
							<td><b>CL :- Casual Leave</b></td>
							<td><b>EL :- Earned Leave</b></td>
							<td><b>C-Off :- Compensatory Off</b></td>
						</tr>
						<tr>
							<td colspan="5" style="padding-top: 5px; color: #BD6706;">
								<span style="color: Red; font-weight: bold;">Note :-</span>
								To view the leave detail of a particular employee, click on the employee code.
							</td>
						</tr>
						<tr>
							<td colspan="5" style="padding-top: 5px; color: #BD6706;">
								<span style="color: Red; font-weight: bold;">**</span>&nbsp;
								Earned Leave &amp; Compensatory Off are shown for current year only.
							</td>
						</tr>
					</tbody>
				</table>

				<div id="gridHolder">


					<div id="gridSelf">
						@Html.Partial("_LeaveGrid", Model.selfGrid)
					</div>


					@* if (Model.Grid != null && Model.Grid.Count > 1) *@
					@* { *@
					<div id="gridAll" style="display:@(Model.gridall ? "none" : "block");">
						@Html.Partial("_LeaveGrid", Model.Grid)
					</div>
					@* } *@
				</div>

			</div>
		</div>

	<div style="margin-left: 0.8em; margin-right: 0.8em;" class="well well-sm">
		<table border="0" style="width: 100%;">
			<tr>
				<td style="height: 20px;">
					<table style="width: 100%;">
						<tbody>
							<tr>
								<td style="width: 20px; vertical-align: middle; text-align: center;" align="left">
									<a title="Back" href="/Home/Home">
										<img src="~/images/icon_back.gif" border="0" alt="" />
									</a>
								</td>
								<td style="vertical-align: middle; font-size: 15px;">
									<span><a title="Back" href="/Home/Home">Back</a></span>
								</td>
							</tr>
						</tbody>
					</table>
				</td>
			</tr>
		</table>
	</div>
	</div>



<div id="ajaxLoader"></div>

@section Scripts {
	@* <script src="~/app/leave/js/leave_card_new.js" asp-append-version="true"></script> *@

	<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
		 const $year = $('#ddlYear');
				const baseUrl = '/Leave';

			$(document).ready(function () {

				 $('#ddlOperation, #ddlDivision, #ddlDepartment, #ddlSection, #ddlEmployee')
				.on('change', function () {
					// keep the same reloadGrids()
					reloadGrids();
				});


				$year.on('change', reloadGrids);

			});


			function reloadGrids() {
					const year = $year.val();

					// Refresh ALL grid with current filters from the dropdowns
					const op = $('#ddlOperation').val() || '0';
					const div = $('#ddlDivision').val() || '0';
					const dep = $('#ddlDepartment').val() || '0';
					const sec = $('#ddlSection').val() || '0';
					const emp = $('#ddlEmployee').val() || '0';

					// 1) All-filter grid
					$.get(`${baseUrl}/GetLeaveGrid`, {
						year: year,
						operationIds: op,
						divisionIds: div,
						departmentIds: dep,
						sectionIds: sec,
						employeeIds: emp
					}).done(function (html) {
						$('#gridAll').html(html);
					}).fail(function () {
						console.error('Failed to load All grid');
					});

					// 2) Self grid (current user)
					$.get(`${baseUrl}/GetSelfGrid`, { year: year })
					 .done(function (html) {
						$('#gridSelf').html(html);
					 }).fail(function () {
						console.error('Failed to load Self grid');
					 });
				}




