
@model ePortal.ViewModels.APPX.Leave.ManageAprAuthViewModel

@{
    ViewBag.Title = "Leave";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}

@section Styles {
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/leave/css/leave_card_new.css" rel="stylesheet" asp-append-version="true" />
}
<div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
    <span style="padding-left: 10px;">Manage Associates Leave Approval Authorities</span>
</div>
<div class="row content" style="margin-left: 10px; margin-right: 10px; margin-top: 5px; margin-bottom: 10px;">
    <div style="padding: 5px; margin-bottom: 5px;" class="text-warning info">
        You can update the leave approval authorities of following associates by clicking on
        <mark>Edit</mark> button.
    </div>

    <style>
        .tab {
            overflow: hidden;
            font-weight: 600;
        }

            .tab input[type=button] {
                background-color: #f5bfbf;
                float: left;
                outline: none;
                cursor: pointer;
                padding: 6px 20px;
                border: none;
            }

                .tab input[type=button]:hover {
                    background-color: dimgrey;
                    color: white;
                }

        .bg-color {
            background-color: #b34c4c !important;
            color: white !important;
        }

        .tabcontent {
            display: none;
            padding: 6px 12px;
            border: 1px solid #ccc;
            border-top: none;
        }
    </style>

    <div class="tab">
        <input type="button" id="btnJE" class="tablinks" value="JE &amp; above"  />
        <input type="button" id="btnStaff" class="tablinks" value="Staff &amp; Line Associate" />
    </div>

    <!-- Grid 1: JE & above -->
    <div id="div_grid1">
        <div id="ctl00_InnerContent_pnl_Grd">
            <div>
                @Html.Partial("_ManageAprAuthGrid", new Tuple<ePortal.ViewModels.APPX.Leave.ManageAprGridVm, string>(Model.JeAndAbove, "ctl00_InnerContent_GridView1"))
            </div>
        </div>
    </div>

    <!-- Grid 2: Staff & Line Associate -->
    <div id="div_grid2">
        <div id="ctl00_InnerContent_pnl_Grd2">
            <div>
                @Html.Partial("_ManageAprAuthGrid", new Tuple<ePortal.ViewModels.APPX.Leave.ManageAprGridVm, string>(Model.StaffAndLine, "ctl00_InnerContent_GridView2"))
            </div>
        </div>
    </div>
</div>

<div style="margin-left: 0.8em; margin-right: 0.8em;" class="well well-sm">
    <table border="0" style="width: 100%;">
        <tr>
            <td style="height: 20px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td style="width: 20px; vertical-align: middle; text-align: center;">
                                <a title="Back" href="/TokenBridge/RedirectToOldApp?target=/Home/Home">
                                    <img src="~/images/icon_back.gif" alt="" />
                                </a>
                            </td>
                            <td style="vertical-align: middle; font-size: 15px;">
                                <span>
                                    <a title="Back" href="/TokenBridge/RedirectToOldApp?target=/Home/Home">
                                        Back
                                    </a>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>
<div id="ajaxLoader"></div>

@section Scripts {

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

         $(document).ready(function () {
               $('#btnJE').on('click',   function(){ openauthorities('JE'); });
          $('#btnStaff').on('click',function(){ openauthorities('staff'); });
          openauthorities('JE');
         });

      

        function openauthorities(which) {
          var isJE    = which === 'JE';
          var isStaff = which === 'staff';

          // Show/hide grids
          document.getElementById('div_grid1').style.display = isJE    ? 'block' : 'none';
          document.getElementById('div_grid2').style.display = isStaff ? 'block' : 'none';

          // Toggle active button style
          var btnJE    = document.getElementById('btnJE');
          var btnStaff = document.getElementById('btnStaff');

          if (btnJE && btnStaff) {
            if (isJE) {
              btnJE.classList.add('bg-color');
              btnStaff.classList.remove('bg-color');
            } else if (isStaff) {
              btnStaff.classList.add('bg-color');
              btnJE.classList.remove('bg-color');
            }
          }
        }

        // Initial state on load: show JE by default (change if you prefer staff)
        document.addEventListener('DOMContentLoaded', function () {
          openauthorities('JE'); // or 'staff'
        });
    </script>

}
