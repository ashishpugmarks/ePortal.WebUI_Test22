@model ePortal.ViewModels.ISMSMasterViewModel

<html>
    <head>
    <style type="text/css" nonce="@Context.Items["StyleNonce_9"]">
        .scrollit {
            overflow-y: auto;
            max-height: 100px;
        }
    </style>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">

        function WindowSettings_WithoutMenu(str1, str2) {
            var winTop = (screen.height / 2) - 325;
            var winLeft = (screen.width / 2) - 425;
            var windowFeatures = "location=no,status=no,width=800,height=550";
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable" + ",scrollbars";
            window.open(str1, str2, windowFeatures);
        }
    </script>
    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
        $(document).ready(function () {
            $('[data-ctrl="anc-open-doc"]').on('click', function () {
                WindowSettings_WithoutMenu('../Uploads/ASR/Calendar/@Model.ISMS_UPLOAD', 'test');
            });
        });
    </script>
    </head>

<body>
<div>
    <dl class="dl-horizontal">
        <br />
        <dt>
            @Html.DisplayNameFor(model => model.ISMS_UPLOAD)
        </dt>

        <dd>
            @if (!string.IsNullOrEmpty(Model.ISMS_UPLOAD))
            {
            @Html.DisplayFor(model => model.ISMS_UPLOAD)
                    <a data-ctrl="anc-open-doc" title="Click to open document" data-cal-upload="@Model.ISMS_UPLOAD">
                <i class="glyphicon glyphicon-new-window" style="cursor:pointer;"></i>
            </a>
            }
            else
            {
            <span>N/A</span>
            }
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.APP_AUTH1)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.APP_AUTH1_NAME)
            <b>@Html.DisplayFor(model => model.APPAUTH1_REMARKS)</b>
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.APP_AUTH2)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.APP_AUTH2_NAME)
            <b>@Html.DisplayFor(model => model.APPAUTH2_REMARKS)</b>
        </dd>
        <hr />
        <dt>
            @Html.DisplayNameFor(model => model.CREATED_DATE)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.strCREATED_DATE)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.CREATED_BY)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.CREATED_BY)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.STATUS)
        </dt>

        <dd>
            @if (Model.STATUS == 1)
            {
            <button class="btn btn-success btn-xs" style="cursor: text !important;">Active</button>
            }
            else if (Model.STATUS == 2)
            {
            <button class="btn btn-warning btn-xs" style="cursor: text !important">WIP (Pending for Approval)</button>
            }
            else if (Model.STATUS == 0)
            {
            <button class="btn btn-danger btn-xs" style="cursor: text !important;">Deactive</button>
            }
            else if (Model.STATUS == 3)
            {
            <button class="btn btn-danger btn-xs" style="cursor: text !important;">Rejected By Approval Authority</button>
            }
        </dd>

        <hr />
    </dl>
</div>
</body>
</html>