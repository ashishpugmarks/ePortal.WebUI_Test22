        }  */
    </style>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
        GetPDF($("#iomPDF"));
        });

        function SaveData(current) {
            var _IsValid = CheckValidation(current);
            if (!_IsValid) {
                return;
            }

            $(".action-btn").attr("disabled", true);
            var iomId = $(current).attr('data-id');
            var approvalData = {
                IOMID: $(current).attr('data-id'),
                ApprovalStatus: $(current).attr('data-status'),
                ApprovalRemark: $("#txtRemarks").val(),
            }

            $.ajax({
                type: "POST",
                beforeSend: function() {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/PIOM/PIOMApproval",
                data: JSON.stringify(approvalData),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function(data) {
                    if (data == 1) {
                        // GetNext($(current).attr('data-id'));
                        //window.location.href = "/ASPXView/ManageApproval.aspx";
                        swal({
                            title: "",
                            text: "Record saved successfully.",
                            type: "success",
                        }, function(isConfirm) {
                            if (isConfirm) {
                                window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx";
                            }
                        });
                        //function (isConfirm) {
                        //    if (isConfirm) {
                        //        window.location.href = "/Home/Home";
                        //    }
                        //});
                    } else if (data == 2) {
                        sweetAlert("", "You don’t have permission to perform this action.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    } else if (data == 0 || data == -1) {
                        sweetAlert("", "Record not saved", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                },
                complete: function() {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function() {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function CheckValidation(current) {
            var isVailed = true;

            $('#txtRemarks').removeClass('validationError');

            // if ($('#txtRemarks').val() == "" && $(current).attr('data-status') != "1") {
            if ($('#txtRemarks').val() == "") {

                $('#txtRemarks').addClass('validationError');

                isVailed = false;

            }

            return isVailed;

        }

                function GetPDF(current) {
            var _pdfName = $(current).attr('data-id');
            if (_pdfName != "") {
                $.ajax({
                    type: "GET",
                    url: "/IOM/GetPDF",
                    beforeSend: function() {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: {
                        fileName: _pdfName
                    },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function(data) {
                        if (data.FILEPATH != "") {
                            document.getElementById("append_pdf").innerHTML = data.FILEPATH;
                        } else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function() {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function() {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function openInfo(url) {
            window.open(url, 'mywin', 'width=800,height=600');
        }

        function CancelClick() {
            window.location.href = "/Home/Home";
        }

        function ddApprovalStatus(current) {
            if ($(current).val() == "2" || $(current).val() == "3" || $(current).val() == "5") { //Aumento 13072024 - 5 also added in required
                $("#lblRemark").addClass('required');
            } else {
                $("#lblRemark").removeClass('required');
            }
        }
               function OpenConfirModel() {
            var chked_count = 0;
            var IsEnableForApp = document.getElementById("hdappaction").value;
            if (IsEnableForApp == 0) {
                swal({
                        title: "",
                        text: "You have already taken the action on this request.",
                        type: "info",
                        showCancelButton: false,
                        confirmButtonClass: "btn-info",
                        confirmButtonText: "OK",
                        cancelButtonText: "No",
                        closeOnConfirm: true,
                        closeOnCancel: true
                    },
                    function(isConfirm) {
                        if (isConfirm) {
                            window.location.href = "/Home/Home";
                        } else {

                        }
                    });
            } else {
                GetPDF($("#iomPDF"));
            }
        }

        function OpenDoc(current) {
            var _pdfPath = $(current).attr('data-path');
            var _pdfName = $(current).attr('data-name');
            var width = screen.width - 100;
            var height = screen.height - 100;
            var winTop = 50;
            var winLeft = 50;
            var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
            window.open(_pdfPath, _pdfName, windowFeatures);
        };

        function GetNext(IOMID_V) {
            var IOMIDCURR = IOMID_V;
            debugger;
            if (IOMIDCURR != "") {
                $.ajax({
                    type: "GET",
                    url: "/PIOM/PIOMNextApproval",
                    beforeSend: function() {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: {
                        IOMID_PARAM: IOMIDCURR
                    },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function(data) {
                        if (data != "") {
                            window.location.href = "/PIOM/PIOMApproval?id=" + data;
                        } else {
                            window.location.href = "/ASPXView/ManageApproval.aspx";
                        }
                    },
                    complete: function() {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function() {
                        window.location.href = "/ASPXView/ManageApproval.aspx";
                    }
                });
            }
        }

        function GetIOMNewLayoutData() {
            let isNewLayout = true;
            var loginUser = document.getElementById("h_adempcode").value;
            var jsonData = localStorage.getItem("IOMLayout");
            if (jsonData) {
                var data = JSON.parse(jsonData);
                if (data.ADEMPCODE === loginUser) {
                    isNewLayout = data.IsNewLayout;
                } else {
                    isNewLayout = false;
                }
            }
            return isNewLayout;
        }


        $('#reqDetails,#appNoteDetails,#documentDetail,#approvalHistory,#approverAction').on('show.bs.collapse', function () {

            $(this).prev('.panel-heading').find('.caret-color').removeClass('fa-caret-down').addClass('fa-caret-right');

        });



        $('#reqDetails,#appNoteDetails,#documentDetail,#approvalHistory,#approverAction').on('hide.bs.collapse', function () {

            $(this).prev('.panel-heading').find('.caret-color').removeClass('fa-caret-right').addClass('fa-caret-down');

        });

    </script>


    @* CSP 3.0 Compliant changes *@

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">

        document.addEventListener('DOMContentLoaded', function () {

            OpenConfirModel();

        });

        $(document).ready(function () {

            $('#ddApprovalStatus').on('change', function () {

                ddApprovalStatus($(this)[0]);

            });

            $('#btnNext').on('click', function () {

                GetNext('@Model.IOMHEADERID');

            });

            $('#btnCancel').on('click', function () {

                CancelClick();

            });

            $('.action-btn').on('click', function () {

                SaveData($(this)[0]);

            });

            $('[data-ctrl="ancOpenDoc"]').on('click', function () {

                OpenDoc($(this)[0]);

            });

            $('[data-ctrl="getpdf"]').on('click', function () {

                GetPDF($(this)[0]);

            });

            $('[data-ctrl="ancOpenDoc_1"]').on('click', function () {

                OpenDoc($(this)[0]);

            });

            $('[data-ctrl="iomPDF"]').on('click', function () {

                GetPDF($(this)[0]);

            });



            $('#chkLayout').on('change', function () {

                let isOldLayout = $(this).is(':checked');

                let isNewLayout = !isOldLayout;

                onChangechkLayout(isNewLayout);

            });

        });


    </script>
</head>
<body>
    <!-- new design-->


    <div class="app-header">

        <div>Approval Note Request</div>

        <div class="pull-right"><span style="color:#e6dede91">Home <i class="fa fa-angle-right"></i> </span>Approval Note Request</div>

    </div>

    <input type="hidden" id="hdappaction" value="@Model.ISENABLE" />

    <input type="hidden" id="h_adempcode" value="@loginUser" />

    <div class="panel panel-shadow">

        <div class="panel-heading" data-toggle="collapse" data-target="#reqDetails">

            <span class="panel-title">

                <i class="fa fa-caret-right caret-color"></i>Requester's Details

            </span>

        </div>

        <div id="reqDetails" class="panel-body panel-collapse collapse in">

