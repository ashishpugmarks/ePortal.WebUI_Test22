@model ePortal.ViewModels.IOMPHeaderViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewBag.Title = "IOMApproval";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _path = "../../../Uploads/DGIT_IOM/";
    var userIdStr = Context.Session.GetString("userID");
    var loginUser = string.IsNullOrEmpty(userIdStr) ? 0 : Convert.ToInt64(userIdStr);
}
<link rel="stylesheet" href="~/css/PIOMApproval.css" />
<html>
<head>
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">


        /*------------- Approvel HIstory Code Css ------------ */
