                                    <a id="iomPDF" style="cursor: pointer;">View Approval Note</a>
                                }
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <table class="table table-responsive approval-table table-curved">
                            <tr>
                                <th width="15%">Document Comparison</th>
                                <td width="35%">
                                    @{
                                        var urlstr = "/PIOM/PIOMMultiDocsView?id=" + Model.IOMHEADERID;
                                        var urlstr1 = "/PIOM/PIOMTwoDocsView?id=" + Model.IOMHEADERID;
                                    }
                                    <a href="@urlstr1" target="_blank" class="btn btn-md btn-doc-view">2 Document View</a>
                                    <a href="@urlstr" target="_blank" class="btn btn-md btn-doc-view">4 Document View</a>
                                </td>
                                <th width="15%">@Html.LabelFor(model => model.IOMDesc, htmlAttributes: new { @class = "control-label" })</th>
                                <td width="75%">@Html.DisplayFor(model => model.IOMDesc)</td>

                                @* <td style="padding:0px"> *@
                                @*     <table class="table table-responsive approval-table"> *@
                                @*         <tr> *@
                                @*             <th width="30%">@Html.LabelFor(model => model.IOMDesc, htmlAttributes: new { @class = "control-label" })</th> *@
                                @*             <td width="70%">@Html.DisplayFor(model => model.IOMDesc)</td> *@
                                @*         </tr> *@
                                @*     </table> *@
                                @* </td> *@
                            </tr>

                        </table>



                    </tr>

                    @* @if (Model.IOMCATMSTID == 4)
                    {
                        <tr>
                            <th>@Html.LabelFor(model => model.ARIBARFPID, htmlAttributes: new { @class = "control-label" })</th>
                            <td>@Html.DisplayFor(model => model.ARIBARFPID)</td>
                            <th></th>
                            <td></td>
                        </tr>
                    } *@
                </tbody>
            </table>


            <div id="new_layout">

                <div id="append_pdf"></div> @* Changed by TTL on 18th July 2025 against SR101913 > CR6738 *@

            </div>
        </div>

    </div>


    <!-- Documents Detail -->

    <div class="panel panel-shadow">

        <div class="panel-heading" data-toggle="collapse" data-target="#documentDetail">

            <span class="panel-title"><i class="fa fa-caret-right caret-color"></i>Documents Detail</span>

        </div>

        <div id="documentDetail" class="panel-body  panel-collapse collapse in">

            <table class="table table-responsive approval-table table-curved" id="tbDocDtl">

                <thead>

                    <tr>

                        <th class="text-center">

                            @Html.DisplayNameFor(model => model.iompDetail[0].IOMDTL_ID)

                        </th>

                        <th class="text-center">

                            @Html.DisplayNameFor(model => model.iompDetail[0].DOC_TYPE)

                        </th>

                        <th class="text-center">

                            @Html.DisplayNameFor(model => model.iompDetail[0].FILENAME)

                        </th>

                        <th class="text-center">

                            @Html.DisplayNameFor(model => model.iompDetail[0].ADDITIONAL_INFO)

                        </th>

                    </tr>

                </thead>

                <tbody>



                    @if (Model.iompDetail != null && Model.iompDetail.Where(x => x.DOC_TYPE != "IOM").Count() > 0)

                    {
                        var doc_row_No = 0;

                        foreach (var item in Model.iompDetail.Where(x => x.DOC_TYPE != "IOM" && x.DOC_TYPE != "IOMA").OrderBy(x => x.ADDEDDATE).ToList())

                        {


                            var _fname = _path + item.FILENAME;

                            var _extension = item.FILENAME.Substring((item.FILENAME.LastIndexOf('.') + 1));

                            <tr>

                                <td class="text-center">

                                    @(doc_row_No += 1)

                                    @Html.HiddenFor(modelItem => item.IOMDTL_ID)

                                </td>

                                <td class="text-center">

                                    @Html.HiddenFor(modelItem => item.IOMHEADERID)

                                    @Html.DisplayFor(modelItem => item.DOC_TYPE)

                                </td>

                                <td class="text-center">

                                    @if (_extension.ToLower() == "pdf")

                                    {

                                        <a id=iomPDF_@item.IOMDTL_ID data-id="@item.FILENAME" style="cursor: pointer;margin-right: 10px;" data-ctrl="getpdf">View Document</a>

                                        <a data-ctrl="ancOpenDoc" data-path="@_fname" data-name="SD" title="Click to open document">

                                            <i class="fa fa-external-link" style="cursor:pointer;"></i>

                                        </a>

                                    }

                                    else

                                    {

                                        <a href="@Url.Action("DownloadAttachment", "IOM" , new { fileName=item.FILENAME })" title="Click to download document">Download Document</a>

                                    }

                                </td>

                                <td class="text-center">

                                    @Html.DisplayFor(modelItem => item.ADDITIONAL_INFO)

                                </td>

                            </tr>

                        }

                    }

                    else

                    {

                        <tr style="background-color:white;">

                            <td class="text-center" colspan="4">

                                No Record Found.

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- Approval History -->

    <div class="panel panel-shadow">

        <div class="panel-heading approval-type-chk" data-toggle="collapse" data-target="#approvalHistory">

            <div class="panel-title">

                <span><i class="fa fa-caret-right caret-color"></i>Approval History</span>

                @{

                    string str1 = "", str2 = ""; string strdivfxhdn = "", strdivothhdn = "";

                }

                @if (Model.APP_TYPE == 1) { str1 = "checked=checked"; strdivothhdn = "hidden"; } else { str2 = "checked=checked"; strdivfxhdn = "hidden"; }


            </div>

        </div>

        <div id="approvalHistory" class="panel-body  panel-collapse collapse in">

            @foreach (var stage in Model.StageHis)
            {
                <div class="Group-heading">
                    <div class="Stage-box">
                        <div class="Group-name">
                            Stage : @stage.StageName
                        </div>
                        @foreach (var parallelGroups in stage.ParallelGroups)
                        {
                            <div class="outer-table-data">
                                <div class="Stage-name">

                                    Approval Group : @parallelGroups.GroupName

                                </div>

                                <table class="table table-responsive approval-table table-curved" id="tbApprovalHis" style="margin-bottom: 0px;">
                                    <thead>
                                        <tr class="bg-info2">
                                            <th class="text-center  Approval-Date">
                                                @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                {
                                                    @Html.DisplayNameFor(model => model.iompAppHis[0].IOMAPPHISTORY_ID)
                                                }
                                                else
                                                {
                                                    <text>SNo</text>
                                                }
                                            </th>
                                            <th class="text-left">
                                                @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                {
                                                    @Html.DisplayNameFor(model => model.iompAppHis[0].EmpName)
                                                }
                                                else
                                                {
                                                    <text>Employee Name</text>
                                                }
                                            </th>
                                            <th class="text-center Approval-Date">
                                                @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                {
                                                    @Html.DisplayNameFor(model => model.iompAppHis[0].ApprovalStatus)
                                                }
                                                else
                                                {
                                                    <text>Status</text>
                                                }
                                            </th>
                                            <th class="text-center Approval-Date">
                                                @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                {
                                                    @Html.DisplayNameFor(model => model.iompAppHis[0].ApprovalDate)
                                                }
                                                else
                                                {
                                                    <text>Approval Date</text>
                                                }
                                            </th>
                                            <th class="text-left Approval-Date">
                                                @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                {
                                                    @Html.DisplayNameFor(model => model.iompAppHis[0].ApprovalRemark)
                                                }
                                                else
                                                {
                                                    <text>Remarks</text>
                                                }
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (parallelGroups.Approvers != null && parallelGroups.Approvers.Any())
                                        {
                                            int row_No = 0;
                                            Int16 strapptype = 0;

                                            foreach (var approver in parallelGroups.Approvers.OrderBy(a => a.APP_SEQ))  // Sequential order
                                            {
                                                // Fetch ALL matching history records for this approver from stage history (priority)
                                                // Sorted by ID/date for chronological view
                                                var approverHistories = stage.StageHistory
                                                .Where(h => h.EmpCode == approver.ADEMPCODE && h.Seq_id == approver.IOMAPPAUTH_ID)
                                                .OrderBy(h => h.IOMAPPHISTORY_ID)  // Or OrderBy(h => h.AddedDate) if date-based
                                                .ToList();

                                                // Fallback: If no exact match, fetch by EmpCode only (for dummies/old data)
                                                if (!approverHistories.Any())
                                                {
                                                    approverHistories = stage.StageHistory
                                                    .Where(h => h.EmpCode == approver.ADEMPCODE)
                                                    .OrderBy(h => h.IOMAPPHISTORY_ID)
                                                    .ToList();
                                                }

                                                // If still empty, fallback to global
                                                if (!approverHistories.Any() && Model.iompAppHis != null)
                                                {
                                                    approverHistories = Model.iompAppHis
                                                    .Where(h => h.EmpCode == approver.ADEMPCODE && h.Seq_id == approver.IOMAPPAUTH_ID)
                                                    .OrderBy(h => h.IOMAPPHISTORY_ID)
                                                    .ToList();
                                                }

                                                if (strapptype != 0 && strapptype != approver.APPTYPE)
                                                {
                                                    <tr>
                                                        <td class="text-center" colspan="5">
                                                            <b>Approval Note Extended on </b> @approver.ADDEDDATE.ToString("dd-MMM-yyyy")
                                                        </td>
                                                    </tr>
                                                }
                                                strapptype = approver.APPTYPE;

                                                // Loop over ALL histories for this approver (shows multiple if exist)
                                                if (approverHistories.Any())
                                                {
                                                    foreach (var approvalHistory in approverHistories)
                                                    {
                                                        <tr>
                                                            <td class="text-center">
                                                                @(++row_No)
                                                            </td>
                                                            <td class="text-left" style="padding-left: 10px;">
                                                                @Html.HiddenFor(modelItem => approver.IOMID)
                                                                @approvalHistory.EmpName
                                                            </td>
                                                            <td class="text-center" style="padding-left: 10px;">
                                                                @{
                                                                    string statusMsg = "Pending";
                                                                    bool isDummy = (approvalHistory.IOMAPPHISTORY_ID == 0);
                                                                    switch (approvalHistory.ApprovalStatus)
                                                                    {
                                                                        case 1: statusMsg = "Approved"; break;
                                                                        case 2: statusMsg = "Send back"; break;
                                                                        case 3: statusMsg = "Rejected"; break;
                                                                        case 0: statusMsg = "Pending"; break;
                                                                        case 5: statusMsg = "Hold"; break;
                                                                        default: statusMsg = "Pending"; break;
                                                                    }
                                                                }
                                                                <span>@statusMsg</span>
                                                            </td>
                                                            <td class="text-center">
                                                                @(approvalHistory.ApprovalDate.HasValue
                                                                    ? approvalHistory.ApprovalDate.Value.ToString("dd-MMM-yyyy HH:mm")
                                                                    : "-")
                                                            </td>
                                                            <td class="text-left" style="padding-left: 10px;">
                                                                @approvalHistory.ApprovalRemark
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    // If no history at all, show single pending row for approver
                                                    <tr>
                                                        <td class="text-center">
                                                            @(++row_No)
                                                        </td>
                                                        <td class="text-left" style="padding-left: 10px;">
                                                            @Html.HiddenFor(modelItem => approver.IOMID)
                                                            @approver.ADEMPNAME
                                                        </td>
                                                        <td class="text-center" style="padding-left: 10px;">
                                                            <span style="font-style: italic; color: #888;">Pending (No History)</span>
                                                        </td>
                                                        <td class="text-center">-</td>
                                                        <td class="text-left" style="padding-left: 10px;">-</td>
                                                    </tr>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td class="text-center" colspan="5">
                                                    No approvers or history available for this group.
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                            </div>
                        }

                    </div>


                </div>
            }

        </div>

    </div>

    <!-- Approver Action-->
    @{

        var IsEnableForApp = @Model.iompAppHis.Any(a => a.EmpCode == loginUser && (a.ApprovalStatus == 0 || a.ApprovalStatus == 5)); //Added by Aumento 13072024

        <div class="panel panel-shadow">

            <div class="panel-heading" data-toggle="collapse" data-target="#approverAction">

                <span class="panel-title"><i class="fa fa-caret-right caret-color"></i>Approval</span>

            </div>

            <div id="approverAction" class="panel-body panel-collapse collapse in">

                <div class="remarks-box">

                    @if (IsEnableForApp)

                    {

                        <div class="text-center pnl-btn hold_Approve_btn">

                            <!-- <button type="button" class="btn action-btn btn-md reject" data-id="@Model.IOMHEADERID" data-status="3"><i class="fa fa-times-circle-o"></i>REJECT</button> -->

                            <button type="button" class="btn action-btn btn-md hold" data-id="@Model.IOMHEADERID" data-status="5"><i class="fa fa-pause"></i>HOLD</button>

                            <!-- <button type="button" class="btn action-btn btn-md sendback" data-id="@Model.IOMHEADERID" data-status="2"><i class="fa fa-undo"></i>SEND BACK</button> -->

                            <button type="button" class="btn action-btn btn-md approve" data-id="@Model.IOMHEADERID" data-status="1"><i class="fa fa-check-circle-o"></i>APPROVE</button>

                        </div>

                        <div>

                            <div class="well">

                                <textarea id="txtRemarks" class="form-control " placeholder="Enter Remarks."></textarea>

                            </div>

                        </div>

                    }

                    <div class="text-center pnl-btn skip_back_btn">

                        <a title="Back" class="btn back" href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx"><i class="fa fa-arrow-left"></i>BACK</a>
                        <button id="btnNext" class="btn skip"  data-header-id="@Model.IOMHEADERID"><i class="fa fa-step-forward"></i>SKIP</button>

                    </div>

                </div>

            </div>

        </div>

    }

    <div id="ajaxLoader"></div>

</body>
</html>
