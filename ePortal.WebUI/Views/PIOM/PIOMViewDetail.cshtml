@model ePortal.ViewModels.IOMPHeaderViewModel

@{
    ViewBag.Title = "PIOMViewDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _path = "../../../Uploads/DGIT_IOM/";
}

<html>
<head>
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">


        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 3px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        table.dataTable {
            clear: both;
            margin-top: 0px !important;
            margin-bottom: 0px !important;
            max-width: none !important;
            border-collapse: separate !important;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../assets/images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        #msform {
            /*text-align: center;*/
            position: relative;
        }

            #msform fieldset {
                background: #fff;
                border: 0 none;
                border-radius: 0px;
                box-shadow: 0 0 1px 1px #337ab7;
                /*padding: 8px 0px;*/
                box-sizing: border-box;
                width: 100%;
                position: relative;
            }

            #msform input, #msform textarea, #msform select {
                padding: 5px;
                border: 1px solid #ccc;
                border-radius: 0px;
                margin-bottom: 8px;
                /*width: 100%;*/
                box-sizing: border-box;
                font-family: arial;
                color: #000;
                font-size: 12px;
            }

        .panel-heading {
            padding: 8px 15px !important;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .div-heading {
            text-align: left;
            height: 2.2em;
            font-weight: bold;
            background-color: #91b4ff;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

            .div-heading div {
                padding: 8px;
            }

        #iom_div {
            border: 1px solid #ccc;
            padding: 8px;
            /*margin-left: 10px;*/
            border-radius: 5px;
            background-color: #eee;
            overflow: auto;
            min-height: 35px;
            max-height: 92px;
            /*width: 73.30%;*/
        }



        /*------------- Approvel HIstory Code Css ------------ */
        .approvel-heading {
            background: #91b4ff;
            border-radius: 5px 5px 0px 0px;
            padding: 12px 10px;
            font-weight: 600;
            font-size: 14px;
        }

        .Approval-History {
            border-radius: 5px;
        }

            .Approval-History .panel-body {
                background: #efefef;
                border-radius: 5px;
            }

        .Stage-box {
            background: #fff;
            border-radius: 5px;
        }

        .Group-name {
            background: #91b4ff;
            padding: 8px 10px;
            border-radius: 5px 5px 0 0;
            font-weight: 600;
        }

        .Stage-name {
            font-weight: 600;
            font-size: 13px;
            background: #337ab71a;
            margin: 13px 15px 10px 13px;
            border-radius: 4px;
            padding: 10px 15px;
            border-left: 4px solid #91b4ff;
        }

        .table-theme {
            padding: 0 15px 15px 15px;
            margin: 0 0 15px 0;
        }

            .table-theme .table > tbody > tr > td, .table-theme .table > tbody > tr > th, .table-theme .table > tfoot > tr > td, .table-theme.table > tfoot > tr > th, .table-theme .table > thead > tr > td, .table-theme .table > thead > tr > th {
                padding: 5px;
                line-height: 1.0;
                vertical-align: middle;
                font-family: "Helvetica Neue", Helvetica, Arial;
                border: 1px solid #8ac2de !important;
            }

        .Approval-Date {
            width: 250px;
        }

        .footer span {
            display: block;
        }

        .footer {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .Approval-note {
            border-left: 6px solid #c9c9c9;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #fffffff0;
            padding: 9px 5px;
            margin: 0 0 10px 0;
            color: #333;
            border-radius: 3px;
            border-right: 6px solid #c9c9c9;
            font-weight: 600;
        }

            .Approval-note span {
                font-weight: 400;
                margin-left: 5px;
            }
    </style>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            GetPDF($("#iomPDF"));
        });

        function GetPDF(current) {
            var _pdfName = $(current).attr('data-id');
            if (_pdfName != "") {
                $.ajax({
                    type: "GET",
                    url: "/PIOM/GetPDF",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { fileName: _pdfName },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.FILEPATH != "") {
                            document.getElementById("append_pdf").innerHTML = data.FILEPATH;
                        }
                        else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function CancelClick() {
            window.location.href = "/Home/Home";
        }

        function OpenDoc(current) {
            var _pdfPath = $(current).attr('data-path');
            var _pdfName = $(current).attr('data-name');
            var width = screen.width - 100;
            var height = screen.height - 100;
            var winTop = 50;
            var winLeft = 50;
            var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
            window.open(_pdfPath, _pdfName, windowFeatures);
        };
    </script>

    @* CSP 3.0 Compliant Changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#ancOpenDoc').on('click', function () {
                OpenDoc($(this)[0]);
            });
            $('[data-ctrl="getpdf"]').on('click', function () {
                GetPDF($(this)[0]);
            });
            $('#ancOpenDoc_1').on('click', function () {
                OpenDoc($(this)[0]);
            });
            $('#iomPDF').on('click', function () {
                GetPDF($(this)[0]);
            });
        });
    </script>
</head>

<body>
    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Approval Note Detail</div>
        </div>
        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Request Detail</strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <div id="msform">
                            <div class="form-group">
                                <fieldset>
                                    <div class="div-heading">
                                        <div>Requestor Detail's</div>
                                    </div>
                                    <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Emp Code") :-  @Model.Emp_Detail._ECode
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Employee Name") :-  @Model.Emp_Detail._EName
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Operation") :-  @Model.Emp_Detail._OpDesc
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Division") :-  @Model.Emp_Detail._DivDesc
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Department") :-  @Model.Emp_Detail._DepDesc
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Section") :-  @Model.Emp_Detail._SecDescrip
                                        </div>
                                    </div>
                                </fieldset>
                            </div>

                            <div class="form-group" style="box-shadow: 0 0 1px 1px #337ab7;">
                                <div class="div-heading">
                                    <div class="col-sm-3 col-md-3 col-lg-3"> Approval Note Detail's</div>
                                    <div class="col-sm-3 col-md-3 col-lg-3" style="width:35%;">

                                        <span class="pull-right">
                                            Document Comparison:
                                            @{
                                                var urlstr = "/PIOM/PIOMMultiDocsView?id=" + Model.IOMHEADERID;
                                                var urlstr1 = "/PIOM/PIOMTwoDocsView?id=" + Model.IOMHEADERID;
                                            }
                                            <a href="@urlstr1" target="_blank">
                                                2 Document View
                                            </a>
                                        </span>
                                    </div>
                                    <div class="col-sm-3 col-md-3 col-lg-3" style="width:12%;">
                                        <span class="pull-right">
                                            <a href="@urlstr" target="_blank">
                                                4 Document View
                                            </a>
                                        </span>
                                    </div>
                                    <div class="col-sm-3 col-md-3 col-lg-3">
                                        <span class="pull-right">
                                            <i class="glyphicon glyphicon-new-window"></i>
                                            &nbsp;&nbsp;Click to open document in new window
                                        </span>
                                    </div>
                                </div>
                                <div class="panel-body">
                                    <table class="table table-bordered table-hover table-responsive" style="margin-bottom: 0px;">
                                        <tbody>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.IOMDesc, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.IOMDesc)
                                                </td>
                                                <td rowspan="4" id="append_pdf" width="60%;"></td>
                                            </tr>
                                            <tr>
                                                <td style="width:8%;">
                                                    @Html.LabelFor(model => model.IOMATTACHMENT, htmlAttributes: new { @class = "control-label text-right" })
                                                </td>
                                                <td>
                                                    @{
                                                        var _poAtt = Model.iompDetail.FirstOrDefault(x => x.DOC_TYPE == "IOM");
                                                        <span>
                                                            @if (_poAtt != null)
                                                            {
                                                                var fullPath = _path + _poAtt.FILENAME;
                                                                <a id="iomPDF" data-id="@_poAtt.FILENAME" style="cursor: pointer;margin-right:10px;border: solid 1px;border-radius: 3px;padding: 1px;background-color: aliceblue;" title="Document preview">View Approval Note</a>
                                                                <a id="ancOpenDoc_1" data-path="@fullPath" data-name="@_poAtt.FILENAME" title="Click to open document">
                                                                    <i class="glyphicon glyphicon-new-window" style="cursor:pointer;"></i>
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <a style="cursor: pointer;">View Approval Note</a>
                                                            }
                                                        </span>
                                                    }
                                                </td>
                                            </tr>

                                            <tr>
                                                <td colspan="2" style="vertical-align:top;">
                                                    <div class="" style="box-shadow: 0 0 1px 1px #337ab7;">
                                                        <div class="div-heading">
                                                            <div>Document Detail's</div>
                                                        </div>
                                                        <div class="panel-body">
                                                            <table class="table table-bordered table-hover table-responsive" id="tbDocDtl" style="margin-bottom: 0px;">
                                                                <thead>
                                                                    <tr class="bg-info">
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.iompDetail[0].IOMDTL_ID)
                                                                        </th>
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.iompDetail[0].DOC_TYPE)
                                                                        </th>
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.iompDetail[0].FILENAME)
                                                                        </th>
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.iompDetail[0].ADDITIONAL_INFO)
                                                                        </th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @{
                                                                        int _row_No = 0;
                                                                    }
                                                                    @if (Model.iompDetail != null)
                                                                    {
                                                                        foreach (var item in Model.iompDetail.Where(x => x.DOC_TYPE != "IOM").OrderBy(x => x.ADDEDDATE).ToList()) // {OrderBy(x=>x.ADDEDDATE)}Updated by Aumento 13072024
                                                                        {
                                                                            var _fname = _path + item.FILENAME;
                                                                            var _extension = item.FILENAME.Substring((item.FILENAME.LastIndexOf('.') + 1));
                                                                            <tr>
                                                                                <td class="text-center">
                                                                                    @(_row_No += 1)
                                                                                    @Html.HiddenFor(modelItem => item.IOMDTL_ID)
                                                                                </td>
                                                                                <td class="text-center" style="padding-left: 10px;">
                                                                                    @Html.HiddenFor(modelItem => item.IOMHEADERID)
                                                                                    @Html.DisplayFor(modelItem => item.DOC_TYPE)
                                                                                </td>
                                                                                <td class="text-center" style="padding-left: 10px;">
                                                                                    @if (_extension.ToLower() == "pdf")
                                                                                    {
                                                                                        <a id="iomPDF_@item.IOMDTL_ID" data-id="@item.FILENAME" style="cursor: pointer;margin-right: 10px;" data-ctrl="getpdf">View Document</a>
                                                                                        <a id="ancOpenDoc" data-path="@_fname" data-name="SD" title="Click to open document">
                                                                                            <i class="glyphicon glyphicon-new-window" style="cursor:pointer;"></i>
                                                                                        </a>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <a href="@Url.Action("DownloadAttachment", "IOM" , new { fileName=item.FILENAME })" title="Click to download document">Download Document</a>
                                                                                    }
                                                                                </td>
                                                                                <td class="text-left">
                                                                                    @Html.DisplayFor(modelItem => item.ADDITIONAL_INFO)
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="form-group Approval-History">

                                <div class="approvel-heading">
                                    Approval History
                                </div>

                                <div class="panel-body">
                                    @{
                                        int row_No = 0; Int16 strapptype = 0;
                                    }

                                    @foreach (var stage in Model.StageHis)
                                    {
                                        if (strapptype != 0 && strapptype != stage.AdditinalType)
                                        {

                                            <div class="Approval-note">Approval Note Extended on <span>@stage.ParallelGroups[0].Approvers[0].ADDEDDATE.ToString("dd-MMM-yyyy")</span> </div>

                                        }
                                        strapptype = stage.AdditinalType;
                                        <div class="Group-heading">
                                            <div class="Stage-box">
                                                <div class="Group-name">
                                                    @stage.StageName
                                                </div>
                                                @foreach (var parallelGroups in stage.ParallelGroups)
                                                {
                                                    <div class="Stage-name">

                                                        @parallelGroups.GroupName

                                                    </div>
                                                    <div class="table-theme">
                                                        <table class="table table-bordered table-hover table-responsive" id="tbApprovalHis" style="margin-bottom: 0px;">
                                                            <thead>
                                                                <tr class="bg-info">
                                                                    <th class="text-center Approval-Date">
                                                                        @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                                        {
                                                                            @Html.DisplayNameFor(model => model.iompAppHis[0].IOMAPPHISTORY_ID)
                                                                        }
                                                                        else
                                                                        {
                                                                            <text>SNo</text>
                                                                        }
                                                                    </th>
                                                                    <th class="text-left">
                                                                        @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                                        {
                                                                            @Html.DisplayNameFor(model => model.iompAppHis[0].EmpName)
                                                                        }
                                                                        else
                                                                        {
                                                                            <text>Employee Name</text>
                                                                        }
                                                                    </th>
                                                                    <th class="text-center Approval-Date">
                                                                        @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                                        {
                                                                            @Html.DisplayNameFor(model => model.iompAppHis[0].ApprovalStatus)
                                                                        }
                                                                        else
                                                                        {
                                                                            <text>Status</text>
                                                                        }
                                                                    </th>
                                                                    <th class="text-center Approval-Date">
                                                                        @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                                        {
                                                                            @Html.DisplayNameFor(model => model.iompAppHis[0].ApprovalDate)
                                                                        }
                                                                        else
                                                                        {
                                                                            <text>Approval Date</text>
                                                                        }
                                                                    </th>
                                                                    <th class="text-left Approval-Date">
                                                                        @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                                        {
                                                                            @Html.DisplayNameFor(model => model.iompAppHis[0].ApprovalRemark)
                                                                        }
                                                                        else
                                                                        {
                                                                            <text>Remarks</text>
                                                                        }
                                                                    </th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @if (parallelGroups.Approvers != null && parallelGroups.Approvers.Any())
                                                                {

                                                                    foreach (var approver in parallelGroups.Approvers.OrderBy(a => a.APP_SEQ))  // Sequential order
                                                                    {
                                                                        // Fetch ALL matching history records for this approver from stage history (priority)
                                                                        // Sorted by ID/date for chronological view
                                                                        var approverHistories = stage.StageHistory
                                                                        .Where(h => h.EmpCode == approver.ADEMPCODE && h.Seq_id == approver.IOMAPPAUTH_ID)
                                                                        .OrderBy(h => h.IOMAPPHISTORY_ID)  // Or OrderBy(h => h.AddedDate) if date-based
                                                                        .ToList();

                                                                        // Fallback: If no exact match, fetch by EmpCode only (for dummies/old data)
                                                                        if (!approverHistories.Any())
                                                                        {
                                                                            approverHistories = stage.StageHistory
                                                                            .Where(h => h.EmpCode == approver.ADEMPCODE)
                                                                            .OrderBy(h => h.IOMAPPHISTORY_ID)
                                                                            .ToList();
                                                                        }

                                                                        // If still empty, fallback to global
                                                                        if (!approverHistories.Any() && Model.iompAppHis != null)
                                                                        {
                                                                            approverHistories = Model.iompAppHis
                                                                            .Where(h => h.EmpCode == approver.ADEMPCODE && h.Seq_id == approver.IOMAPPAUTH_ID)
                                                                            .OrderBy(h => h.IOMAPPHISTORY_ID)
                                                                            .ToList();
                                                                        }

                                                                        // Loop over ALL histories for this approver (shows multiple if exist)
                                                                        if (approverHistories.Any())
                                                                        {
                                                                            foreach (var approvalHistory in approverHistories)
                                                                            {
                                                                                <tr>
                                                                                    <td class="text-center">
                                                                                        @(++row_No)
                                                                                    </td>
                                                                                    <td class="text-left" style="padding-left: 10px;">
                                                                                        @Html.HiddenFor(modelItem => approver.IOMID)
                                                                                        @approvalHistory.EmpName
                                                                                    </td>
                                                                                    <td class="text-center" style="padding-left: 10px;">
                                                                                        @{
                                                                                            string statusMsg = "Pending";
                                                                                            bool isDummy = (approvalHistory.IOMAPPHISTORY_ID == 0);
                                                                                            switch (approvalHistory.ApprovalStatus)
                                                                                            {
                                                                                                case 1: statusMsg = "Approved"; break;
                                                                                                case 2: statusMsg = "Send back"; break;
                                                                                                case 3: statusMsg = "Rejected"; break;
                                                                                                case 0: statusMsg = "Pending"; break;
                                                                                                case 5: statusMsg = "Hold"; break;
                                                                                                default: statusMsg = "Pending"; break;
                                                                                            }
                                                                                        }
                                                                                        <span>@statusMsg</span>
                                                                                    </td>
                                                                                    <td class="text-center">
                                                                                        @(approvalHistory.ApprovalDate.HasValue
                                                                                            ? approvalHistory.ApprovalDate.Value.ToString("dd-MMM-yyyy HH:mm")
                                                                                            : "-")
                                                                                    </td>
                                                                                    <td class="text-left" style="padding-left: 10px;">
                                                                                        @approvalHistory.ApprovalRemark
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        }
                                                                        else
                                                                        {
                                                                            // If no history at all, show single pending row for approver
                                                                            <tr>
                                                                                <td class="text-center">
                                                                                    @(++row_No)
                                                                                </td>
                                                                                <td class="text-left" style="padding-left: 10px;">
                                                                                    @Html.HiddenFor(modelItem => approver.IOMID)
                                                                                    @approver.ADEMPNAME
                                                                                </td>
                                                                                <td class="text-center" style="padding-left: 10px;">
                                                                                    <span style="font-style: italic; color: #888;">Pending (No History)</span>
                                                                                </td>
                                                                                <td class="text-center">-</td>
                                                                                <td class="text-left" style="padding-left: 10px;">-</td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <tr>
                                                                        <td class="text-center" colspan="5">
                                                                            No approvers or history available for this group.
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }

                                            </div>




                                        </div>
                                    }

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="ajaxLoader"></div>

</body>

</html>
