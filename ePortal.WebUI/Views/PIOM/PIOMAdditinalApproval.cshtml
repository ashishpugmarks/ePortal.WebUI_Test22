         //parallel submit
          function submitPIOMForm() {

             var iomDesc = $("#txtIOMDesc").val().trim();
             var iomId = $("#hfIOMHeaderId").val();
             var appType = $("input[name='rdbFO']:checked").val();
             var stages = gatherApprovalData();

             if (!iomDesc) {
                 sweetAlert("", "Please enter IOM Description.", "warning");
                 return;
             }

             if (!stages || stages.length === 0) {
                 sweetAlert("", "Please select approval stages.", "warning");
                 return;
             }

             $('#myPreviewModel').modal('hide');

             var data = {
                 IOMHEADERID: iomId,
                 IOMDesc: iomDesc,
                 STATUS: 1,
                 PROCESS_STATUS: 1,
                 IsFinalSubmit: 1,
                 iomAppHeaderList: mainHeaderArray,
                 APP_TYPE: appType,
                 Stages: stages
             };

             $.ajax({
                 type: "POST",
                 url: "/PIOM/PIOMRequest",
                 beforeSend: function () {
                     $("#ajaxLoader").addClass('loader');
                     $("#btnSave").attr("disabled", true);
                     $("#btnPreview").attr("disabled", true);
                 },
                 data: JSON.stringify(data),
                 contentType: "application/json; charset=utf-8",
                 datatype: "json",
                 success: function (data) {
                     if (data == 1) {
                         swal({
                             title: "",
                             text: "Record saved successfully.",
                             type: "success",
                         }, function (isConfirm) {
                             if (isConfirm) {
                                window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                             }
                         });
                     } else if (data == 2) {
                         sweetAlert("", "Kindly add other director of same operation.", "warning");
                     } else if (data == -3) {
                         sweetAlert("", "Please upload approval note attachment.", "warning");
                     } else {
                         sweetAlert("", "Record not saved.", "warning");
                     }
                 },
                 complete: function () {
                     $("#ajaxLoader").removeClass('loader');
                     $("#btnSave").attr("disabled", false);
                     $("#btnPreview").attr("disabled", false);
                 },
                 error: function () {
                     sweetAlert("Oops...", "Something went wrong!", "error");
                     $("#ajaxLoader").removeClass('loader');
                     $("#btnSave").attr("disabled", false);
                     $("#btnPreview").attr("disabled", false);
                 }
             });
         }


