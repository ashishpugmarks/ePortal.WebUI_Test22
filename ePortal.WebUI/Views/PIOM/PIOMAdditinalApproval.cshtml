        function submitForm() {
            // Hide modal
            $('#myPreviewModel').modal('hide');
            $('#txtEmpcode').removeClass('validationError');

            // Collect approval data
            var stages = gatherApprovalData();

            // Validate form
            var isFormValid = CheckParallelFormValidation();
            if (!isFormValid) {
                $('#div_valid_msg').removeClass('hidden');
                return;
            }

            // Check if stages are selected
            if (!stages || stages.length === 0) {
                sweetAlert("", "Please select approval stages.", "warning");
                return;
            }

            // Disable buttons
            $("#btnSave, #btnPreview").attr("disabled", true);

            // Prepare request data
            var data = {
                IOMHEADERID: $("#hfIomHeaderId").val(),
                Stages: stages
            };

            // AJAX Call
            $.ajax({
                type: "POST",
                url: "/PIOM/PIOMAdditinalApproval",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(data),
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                success: function (response) {
                    debugger;

                    switch (response) {
                        case 1:
                            swal({
                                title: "",
                                text: "Record saved successfully.",
                                type: "success"
                            }, function (isConfirm) {
                                if (isConfirm) {
                                    window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                                }
                            });
                            break;

                        case -2:
                            sweetAlert("", "Added Additional authority already exists in approval.", "warning");
                            break;

                        case 2:
                            sweetAlert("", "This approval note request already processed.", "warning");
                            break;

                        case -3:
                            sweetAlert("", "Please upload approval note attachment.", "warning");
                            break;

                        default:
                            sweetAlert("", "Record not saved.", "warning");
                            break;
                    }

                    // Re-enable buttons after each response
                    $("#btnSave, #btnPreview").attr("disabled", false);
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                    $("#btnSave, #btnPreview").attr("disabled", false);
                    $("#ajaxLoader").removeClass('loader');
                }
            });
        }


         function ParallelPreview() {
             $('#myPreviewModel').modal('hide');
             var stages = gatherApprovalData();
             var isFormValidation = CheckParallelFormValidation();
             if (!isFormValidation) {
                 $('#div_valid_msg').removeClass('hidden');
                 return;
             }

             // Document verification check
             var docTr = $("#append_docRow .tr_doc");
             if (docTr.length > 0) {
                 for (var i = 0; i < docTr.length; i++) {
                     var row = docTr[i];
                     if (row) {
                         var verificationText = row.cells[3].innerHTML.trim();
                         if (verificationText == "Not Verified") {
                             sweetAlert("", "Document not verified. Please open all documents & verify.", "warning");
                             return;
                         }
                     }
                 }
             }

             $('#txtEmpcode').removeClass('validationError');
             var _iomFile = $("#hfIOMAttachment").val();
             if (!_iomFile) {
                 sweetAlert("", "IOM attachment not found. Please upload again.", "warning");
                 return;
             }

             // Check approval authority
             // if (typeof arrayList === 'undefined' || arrayList == null || arrayList.length == 0) {
             //     $('#txtEmpcode').addClass('validationError');
             //     sweetAlert("", "Please add approval authority.", "warning");
             //     return;
             // }

             $("#btnPreview").attr("disabled", true);
             var data = {
                 IOMHEADERID: $("#hfIomHeaderId").val(),
                 Stages: stages,
                 IOMATTACHMENT: _iomFile
             };

             $.ajax({
                 type: "POST",
                 url: "/PIOM/PreviewPIOM",
                 beforeSend: function () {
                     $("#ajaxLoader").addClass('loader');
                 },
                 data: JSON.stringify(data),
                 contentType: "application/json; charset=utf-8",
                 datatype: "json",
                 success: function (data) {
                     if (data.FILEPATH != "") {
                         document.getElementById("IOM_attachment").innerHTML = data.FILEPATH;
                         $('#myPreviewModel').modal({ backdrop: "static" });
                     }
                 },
                 complete: function () {
                     $("#ajaxLoader").removeClass('loader');
                     $("#btnPreview").attr("disabled", false);
                 },
                 error: function () {
                     sweetAlert("Oops...", "Something went wrong!", "error");
                     $("#btnPreview").attr("disabled", false);
                     $("#ajaxLoader").removeClass('loader');
                 }
             });
         }

        function Reset() {
            window.location.href = "/ASPXView/ManageRequestHistory.aspx?id=IOMDOCRequest";
        }
            //else {
            //    $('#div_valid_msg').removeClass('hidden');
            //}
        //}

    </script>

    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#btnSave').on('click', function () {
                submitForm();
            });
            $('#btnPreview').on('click', function () {
               ParallelPreview();
            });
            $('#btnReset').on('click', function () {
                Reset();
            });
            $('#btnOadd').on('click', function () {
                AddOAuthority();
            });
            $('#btnAdd').on('click', function () {
                AddAuthority();
            });
            $('[data-ctrl="opendoc"]').on('click', function () {
                OpenDoc($(this)[0]);
            });
            $('[data-ctrl="getpdf"]').on('click', function () {
                GetPDF($(this)[0]);
            });
            $('[data-ctrl="opendoc_1"]').on('click', function () {
                OpenDoc($(this)[0]);
            });
            $('[data-ctrl="getpdf_1"]').on('click', function () {
                GetPDF($(this)[0]);
            });
        });
    </script>
</head>

<body>
    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Approval Note Detail</div>
        </div>
        @if (Model.IOMHEADERID == 0)
        {
            <script type="text/javascript">
                //sweetAlert("", "Please upload approval note attachment.", "warning");
                swal({
                    title: "",
                    text: "Unauthorized Access.",
                    type: "error",
                }, function (isConfirm) {
                    if (isConfirm) {
                        window.location.href = "/ASPXView/ManageRequestHistory.aspx?id=IOMDOCRequest";
                    }
                });
            </script>
        }
        else
        {
            <div class="body-content" style="overflow-x:auto!important;">
                <div class="panel-group">
                    <div class="panel panel-primary">
                        <div class="panel-heading">
                            <h2 class="panel-title">
                                <strong>Request Detail</strong>
                            </h2>
                        </div>
                        <div class="panel-body">
                            <div id="msform">
                                <div class="form-group">
                                    <fieldset>
                                        <div class="div-heading">
                                            <div>Requestor Detail's</div>
                                        </div>
                                        <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                            <div class="col-sm-4 col-md-4 col-lg-4">
                                                @Html.Label("Emp Code") :-  @Model.Emp_Detail._ECode
                                            </div>
                                            <div class="col-sm-4 col-md-4 col-lg-4">
                                                @Html.Label("Employee Name") :-  @Model.Emp_Detail._EName
                                            </div>
                                            <div class="col-sm-4 col-md-4 col-lg-4">
                                                @Html.Label("Operation") :-  @Model.Emp_Detail._OpDesc
                                            </div>
                                        </div>
                                        <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                            <div class="col-sm-4 col-md-4 col-lg-4">
                                                @Html.Label("Division") :-  @Model.Emp_Detail._DivDesc
                                            </div>
                                            <div class="col-sm-4 col-md-4 col-lg-4">
                                                @Html.Label("Department") :-  @Model.Emp_Detail._DepDesc
                                            </div>
                                            <div class="col-sm-4 col-md-4 col-lg-4">
                                                @Html.Label("Section") :-  @Model.Emp_Detail._SecDescrip
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>

                                <div class="form-group" style="box-shadow: 0 0 1px 1px #337ab7;">
                                    <div class="div-heading">
                                        <div class="col-sm-6 col-md-8 col-lg-9"> Approval Note Detail's</div>
                                        <div class="col-sm-6 col-md-4 col-lg-3">
                                            <span class="pull-right">
                                                <i class="glyphicon glyphicon-new-window"></i>
                                                &nbsp;&nbsp;Click to open document in new window
                                            </span>
                                        </div>
                                    </div>
                                    <div class="panel-body">
                                        <table class="table table-bordered table-hover table-responsive" style="margin-bottom: 0px;">
                                            <tbody>
                                                <tr>
                                                    <td>
                                                        @Html.HiddenFor(model => model.IOMHEADERID, new { @id = "hfIomHeaderId" })
                                                        @Html.LabelFor(model => model.IOMDesc, htmlAttributes: new { @class = "control-label" })

                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(model => model.IOMDesc)
                                                    </td>
                                                    <td rowspan="4" id="append_pdf" width="60%;"></td>
                                                </tr>
                                                <tr>
                                                    <td style="width:8%;">
                                                        @Html.LabelFor(model => model.IOMATTACHMENT, htmlAttributes: new { @class = "control-label text-right" })
                                                    </td>
                                                    <td>
                                                        @{
                                                            var _poAtt = Model.iompDetail.FirstOrDefault(x => x.DOC_TYPE == "IOM");
                                                            <span>
                                                                @if (_poAtt != null)
                                                                {
                                                                    var fullPath = _path + _poAtt.FILENAME;
                                                                    <a id="iomPDF" data-id="@_poAtt.FILENAME" style="cursor: pointer;margin-right:10px;border: solid 1px;border-radius: 3px;padding: 1px;background-color: aliceblue;" title="Document preview" data-ctrl="getpdf_1">View Approval Note</a>
                                                                    <a data-ctrl="opendoc_1" data-path="@fullPath" data-name="@_poAtt.FILENAME" title="Click to open document">
                                                                        <i class="glyphicon glyphicon-new-window" style="cursor:pointer;"></i>
                                                                    </a>
                                                                    <input type="hidden" id="hfIOMAttachment" value="@_poAtt.FILENAME" />
                                                                }
                                                                else
                                                                {
                                                                    <a id="iomPDF" style="cursor: pointer;">View Approval Note</a>
                                                                }
                                                            </span>
                                                        }
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td colspan="2" style="vertical-align:top;">
                                                        <div class="" style="box-shadow: 0 0 1px 1px #337ab7;">
                                                            <div class="div-heading">
                                                                <div>Document Detail's</div>
                                                            </div>
                                                            <div class="panel-body">
                                                                <table class="table table-bordered table-hover table-responsive" id="tbDocDtl" style="margin-bottom: 0px;">
                                                                    <thead>
                                                                        <tr class="bg-info">
                                                                            <th class="text-center">
                                                                                @Html.DisplayNameFor(model => model.iompDetail[0].IOMDTL_ID)
                                                                            </th>
                                                                            <th class="text-center">
                                                                                @Html.DisplayNameFor(model => model.iompDetail[0].DOC_TYPE)
                                                                            </th>
                                                                            <th class="text-center">
                                                                                @Html.DisplayNameFor(model => model.iompDetail[0].FILENAME)
                                                                            </th>
                                                                            <th class="text-center">
                                                                                @Html.DisplayNameFor(model => model.iompDetail[0].ADDITIONAL_INFO)
                                                                            </th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @{
                                                                            int _row_No = 0;
                                                                        }
                                                                        @if (Model.iompDetail != null)
                                                                        {
                                                                            foreach (var item in Model.iompDetail.Where(x => x.DOC_TYPE != "IOM").OrderBy(x => x.ADDEDDATE).ToList()) /*Aumento 12072024*/
                                                                            {
                                                                                var _fname = _path + item.FILENAME;
                                                                                var _extension = item.FILENAME.Substring((item.FILENAME.LastIndexOf('.') + 1));
                                                                                <tr>
                                                                                    <td class="text-center">
                                                                                        @(_row_No += 1)
                                                                                        @Html.HiddenFor(modelItem => item.IOMDTL_ID)
                                                                                    </td>
                                                                                    <td class="text-center" style="padding-left: 10px;">
                                                                                        @Html.HiddenFor(modelItem => item.IOMHEADERID)
                                                                                        @Html.DisplayFor(modelItem => item.DOC_TYPE)
                                                                                    </td>
                                                                                    <td class="text-center" style="padding-left: 10px;">
                                                                                        @if (_extension.ToLower() == "pdf")
                                                                                        {
                                                                                            <a id="iomPDF_@item.IOMDTL_ID" data-id="@item.FILENAME" style="cursor: pointer;margin-right: 10px;" data-ctrl="getpdf">View Document</a>
                                                                                            <a data-ctrl="opendoc" data-path="@_fname" data-name="SD" title="Click to open document">
                                                                                                <i class="glyphicon glyphicon-new-window" style="cursor:pointer;"></i>
                                                                                            </a>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <a href="@Url.Action("DownloadAttachment", "IOM", new { fileName = item.FILENAME })" title="Click to download document">Download Document</a>
                                                                                        }
                                                                                    </td>
                                                                                    <td class="text-left">
                                                                                        @Html.DisplayFor(modelItem => item.ADDITIONAL_INFO)
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div class="form-group Approval-History">

                                    <div class="approvel-heading">
                                        Approval History
                                    </div>

                                    <div class="panel-body">

                                        @foreach (var stage in Model.StageHis)
                                        {
                                            <div class="Group-heading">
                                                <div class="Stage-box">
                                                    <div class="Group-name">
                                                        @stage.StageName
                                                    </div>
                                                    @foreach (var parallelGroups in stage.ParallelGroups)
                                                    {
                                                        <div class="Stage-name">

                                                            @parallelGroups.GroupName

                                                        </div>
                                                        <div class="table-theme">
                                                            <table class="table table-bordered table-hover table-responsive" id="tbApprovalHis" style="margin-bottom: 0px;">
                                                                <thead>
                                                                    <tr class="bg-info">
                                                                        <th class="text-center Approval-Date">
                                                                            @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                                            {
                                                                                @Html.DisplayNameFor(model => model.iompAppHis[0].IOMAPPHISTORY_ID)
                                                                            }
                                                                            else
                                                                            {
                                                                                <text>SNo</text>
                                                                            }
                                                                        </th>
                                                                        <th class="text-left">
                                                                            @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                                            {
                                                                                @Html.DisplayNameFor(model => model.iompAppHis[0].EmpName)
                                                                            }
                                                                            else
                                                                            {
                                                                                <text>Employee Name</text>
                                                                            }
                                                                        </th>
                                                                        <th class="text-center Approval-Date">
                                                                            @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                                            {
                                                                                @Html.DisplayNameFor(model => model.iompAppHis[0].ApprovalStatus)
                                                                            }
                                                                            else
                                                                            {
                                                                                <text>Status</text>
                                                                            }
                                                                        </th>
                                                                        <th class="text-center Approval-Date">
                                                                            @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                                            {
                                                                                @Html.DisplayNameFor(model => model.iompAppHis[0].ApprovalDate)
                                                                            }
                                                                            else
                                                                            {
                                                                                <text>Approval Date</text>
                                                                            }
                                                                        </th>
                                                                        <th class="text-left Approval-Date">
                                                                            @if (Model.iompAppHis != null && Model.iompAppHis.Any())
                                                                            {
                                                                                @Html.DisplayNameFor(model => model.iompAppHis[0].ApprovalRemark)
                                                                            }
                                                                            else
                                                                            {
                                                                                <text>Remarks</text>
                                                                            }
                                                                        </th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (parallelGroups.Approvers != null && parallelGroups.Approvers.Any())
                                                                    {
                                                                        int row_No = 0;
                                                                        Int16 strapptype = 0;

                                                                        foreach (var approver in parallelGroups.Approvers.OrderBy(a => a.APP_SEQ))  // Sequential order
                                                                        {
                                                                            // Fetch ALL matching history records for this approver from stage history (priority)
                                                                            // Sorted by ID/date for chronological view
                                                                            var approverHistories = stage.StageHistory
                                                                            .Where(h => h.EmpCode == approver.ADEMPCODE && h.Seq_id == approver.IOMAPPAUTH_ID)
                                                                            .OrderBy(h => h.IOMAPPHISTORY_ID)  // Or OrderBy(h => h.AddedDate) if date-based
                                                                            .ToList();

                                                                            // Fallback: If no exact match, fetch by EmpCode only (for dummies/old data)
                                                                            if (!approverHistories.Any())
                                                                            {
                                                                                approverHistories = stage.StageHistory
                                                                                .Where(h => h.EmpCode == approver.ADEMPCODE)
                                                                                .OrderBy(h => h.IOMAPPHISTORY_ID)
                                                                                .ToList();
                                                                            }

                                                                            // If still empty, fallback to global
                                                                            if (!approverHistories.Any() && Model.iompAppHis != null)
                                                                            {
                                                                                approverHistories = Model.iompAppHis
                                                                                .Where(h => h.EmpCode == approver.ADEMPCODE && h.Seq_id == approver.IOMAPPAUTH_ID)
                                                                                .OrderBy(h => h.IOMAPPHISTORY_ID)
                                                                                .ToList();
                                                                            }

                                                                            if (strapptype != 0 && strapptype != approver.APPTYPE)
                                                                            {
                                                                                <tr>
                                                                                    <td class="text-center" colspan="5">
                                                                                        <b>Approval Note Extended on </b> @approver.ADDEDDATE.ToString("dd-MMM-yyyy")
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                            strapptype = approver.APPTYPE;

                                                                            // Loop over ALL histories for this approver (shows multiple if exist)
                                                                            if (approverHistories.Any())
                                                                            {
                                                                                foreach (var approvalHistory in approverHistories)
                                                                                {
                                                                                    <tr>
                                                                                        <td class="text-center">
                                                                                            @(++row_No)
                                                                                        </td>
                                                                                        <td class="text-left" style="padding-left: 10px;">
                                                                                            @Html.HiddenFor(modelItem => approver.IOMID)
                                                                                            @approvalHistory.EmpName
                                                                                        </td>
                                                                                        <td class="text-center" style="padding-left: 10px;">
                                                                                            @{
                                                                                                string statusMsg = "Pending";
                                                                                                bool isDummy = (approvalHistory.IOMAPPHISTORY_ID == 0);
                                                                                                switch (approvalHistory.ApprovalStatus)
                                                                                                {
                                                                                                    case 1: statusMsg = "Approved"; break;
                                                                                                    case 2: statusMsg = "Send back"; break;
                                                                                                    case 3: statusMsg = "Rejected"; break;
                                                                                                    case 0: statusMsg = "Pending"; break;
                                                                                                    case 5: statusMsg = "Hold"; break;
                                                                                                    default: statusMsg = "Pending"; break;
                                                                                                }
                                                                                            }
                                                                                            <span>@statusMsg</span>
                                                                                        </td>
                                                                                        <td class="text-center">
                                                                                            @(approvalHistory.ApprovalDate.HasValue
                                                                                                ? approvalHistory.ApprovalDate.Value.ToString("dd-MMM-yyyy HH:mm")
                                                                                                : "-")
                                                                                        </td>
                                                                                        <td class="text-left" style="padding-left: 10px;">
                                                                                            @approvalHistory.ApprovalRemark
                                                                                        </td>
                                                                                    </tr>
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                // If no history at all, show single pending row for approver
                                                                                <tr>
                                                                                    <td class="text-center">
                                                                                        @(++row_No)
                                                                                    </td>
                                                                                    <td class="text-left" style="padding-left: 10px;">
                                                                                        @Html.HiddenFor(modelItem => approver.IOMID)
                                                                                        @approver.ADEMPNAME
                                                                                    </td>
                                                                                    <td class="text-center" style="padding-left: 10px;">
                                                                                        <span style="font-style: italic; color: #888;">Pending (No History)</span>
                                                                                    </td>
                                                                                    <td class="text-center">-</td>
                                                                                    <td class="text-left" style="padding-left: 10px;">-</td>
                                                                                </tr>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <tr>
                                                                            <td class="text-center" colspan="5">
                                                                                No approvers or history available for this group.
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }

                                                </div>




                                            </div>
                                        }

                                    </div>
                                </div>

                                <div class="panel-group Approval-History">
                                    <div class="panel panel-primary">
                                        <div class="panel-heading">
                                            <h2 class="panel-title">
                                                <div class="one-block">
                                                    <strong>Approval Type</strong>
                                            </h2>
                                        </div>

                                        <div class="panel-body Parallel-type-box" id="parallelapproval">
                                            <div class="form-group addStage row">

                                                <div class="col-xs-12 outer-box">
                                                    <label for="txtStageName" class="control-label">
                                                        Stage Name:
                                                    </label>
                                                    <input type="text" class="form-control input-sm"
                                                           id="txtStageName" placeholder="Enter Stage Name"
                                                           style="display:inline-block; width:250px;" />
                                                    <div class="approve-btn-list">
                                                        <input type="button" class="btn btn-primary btn-sm"
                                                               value="Add Stage" id="btnOStage" style="width:150px;" />
                                                    </div>
                                                </div>

                                            </div>

                                            <div id="stageContainer">
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group text-center">
                                        <input type="button" class="cancel btn btn-dark" value="Cancel" id="btnReset" />
                                        <input type="button" value="Submit" class="btn btn-success" id="btnPreview" />
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div id="myPreviewModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog" style="width: 900px;">
            <div class="modal-content">
                <div class="modal-header" style="padding:10px!important;">
                    <div class="pull-left">
                        <h5 class="modal-title"><span>Preview</span></h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body" style="padding:10px!important;">
                    <div id="IOM_attachment"></div>
                    <div class="form-group" style="margin-top:10px;font-size:13px;">
                        <table class="table table-bordered table-hover table-responsive">
                            <tr style="background-color: antiquewhite;">
                                <td colspan="4">
                                    <span style="color: blue;">
                                        <strong> Note:- </strong>Incase approval Authority box is not fitting on the page, that is due to earlier approvals utilizes the space.Hence continue with existing approval or else proceed with fresh approval of the document.
                                    </span>
                                    <br />
                                    <br />
                                </td>
                            </tr>

                        </table>
                    </div>
                    <div class="form-group text-center" style="margin-top:10px;">
                        <input type="button" name="cancel" class="btn btn-dark" value="Cancel" data-dismiss="modal" aria-label="Close" />
                        <input type="button" value="OK" class="submit btn btn-success" id="btnSave" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="ajaxLoader"></div>
</body>

</html>
