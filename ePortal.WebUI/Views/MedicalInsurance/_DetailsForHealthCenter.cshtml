@model ePortal.ViewModels.MedicalInsuranceViewModel
@{
    ViewBag.Title = "Details";
}

    <style type="text/css" nonce="@Context.Items["StyleNonce_2"]">
        .span-heading {
            font-size: 18px;
            font-weight: bold;
            color: #337ab7;
            margin-left: 10px;
        }

            .span-heading > i {
                margin-right: 10px;
            }

        .detail-div {
            background-color: #ecf3f9;
            border-radius: 4px;
            height: 130px;
            margin-top: 6px;
        }

        .div-padding > div {
            padding-top: 12px;
            margin-left: 12px;
        }

        .dep-Div {
            background-color: #ecf3f9;
            border-radius: 4px;
            width: 100%;
            height: 260px;
            margin-top: 6px;
        }

        /*.strong-margin > div {
                    margin-left: 2.3em;
                }*/

        .vertical-middle {
            vertical-align: middle;
        }

        .highlight {
            color: #f1B835;
        }
    </style>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        $(document).ready(function () {
            $('.homeContent').removeClass('homeContent');
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
   
    

    @if (Model.NomineeDetail.Nominee_Status == 2 || Model.Dependents.Where(m => m.Status == 2).Count() > 0)
    {
        <div class="row">
            <div class="body-content" style="overflow-x:auto!important;padding-top: 0px!important;padding-bottom: 0px!important">
