                        @if (Model.Emp_Status == 2)
                        {
                            <span class="badge">Detail Modified</span>
                        }
                        @*<hr />*@
                        @{string styleclass = ""; string title = ""; }
                        <div class="detail-div">
                            <div class="row">
                                <div class="col-xs-6 col-sm-5 col-md-5 col-lg-5 div-padding strong-margin">
                                    <div><strong>Emp Code</strong></div>
                                </div>
                                <div class="col-xs-6 col-sm-7 col-md-7 col-lg-7 div-padding">
                                    <div>@Model.EmpCode</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-xs-6 col-sm-5 col-md-5 col-lg-5 div-padding strong-margin">
                                    <div><strong>Name</strong></div>
                                </div>
                                <div class="col-xs-6 col-sm-7 col-md-7 col-lg-7 div-padding">
