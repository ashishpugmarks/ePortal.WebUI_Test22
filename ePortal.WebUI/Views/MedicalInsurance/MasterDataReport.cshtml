@model ePortal.ViewModels.MasterReportViewModel

@{
    ViewBag.Title = "Master Data Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.7;
            background: #eee;
            color: black;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../assets/images/loadingcircle.gif') 50% 50% no-repeat #ffffff;
            opacity: .9;
        }
    </style>
}
@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $("#ajaxLoader").addClass('loader');
        $(document).ready(function () {
            $('.homeContent').removeClass('homeContent');
            $("#tbMasterReport").dataTable(
                {
                    "lengthMenu": [[100, 200, -1], [100, 200, "All"]],
                    "paging": false,
                });
            $('.dpDOB').datepicker({
                format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top'
            });
            $('#btnSearch').on('click', function(){
                PagerClick(1, 'search');
            });
             $('#btnReset').on('click', function(){
                 //onclick="ResetForm();"
                 ResetForm();
            });
             $('#btnExcel').on('click', function(){
                 PagerClick(1, 'excel');
            });
            //data-ctrl-id="hrfPager"
            $('[data-ctrl-id="hrfPager"]').on('clic', function(){
           // PagerClick($[this][0], 'search');
            Paging($[this][0]);
            });
        });
        $(window).load(function () {
            $("#ajaxLoader").removeClass('loader');
        });
        function Paging(current){
            var id=$(current).attr('data-id');
            PagerClick(id, 'search')
        }
        function PagerClick(index, command) {
            document.getElementById("hfCommand").value = command;
            document.getElementById("hfPlantId").value = $('#Plant').val() == "" ? 0 : $('#Plant').val();
            document.getElementById("hfCurrentPageIndex").value = index;
            document.getElementById("hfApprovalDateFrom").value = $('#ApprovalDateFrom').val();
            document.getElementById("hfApprovalDateTo").value = $('#ApprovalDateTo').val();
            document.getElementById("hfReqDateFrom").value = $('#ReqDateFrom').val();
            document.getElementById("hfReqDateTo").value = $('#ReqDateTo').val();
            document.forms[0].submit();
        }

        function ResetForm() {
            window.location.href = "/MedicalInsurance/MasterDataReport"
        }
    </script>
}    
    


    <div class="row">
        <div id="ajaxLoader" class="loader"></div>

        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Master Report</div>
        </div>
        <div class="body-content">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="panel-group">
                    <div class="panel panel-primary">
                        <div class="panel-heading">
                            <span class="panel-title">
                                <strong>Record List</strong>
                            </span>
                        </div>
                        <div class="panel-body" style="overflow:auto">
                            <div class="row">
                                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding-bottom: 8px;">
                                    <div class="col-xs-12 col-sm-8 col-md-6 col-lg-6">
                                        <div class="col-xs-4 col-sm-4 col-md-4 col-lg-4 text-right" style="margin-top:10px;font-size:14px;font-weight:bold;">
                                            @Html.DisplayName("Request Date")
                                        </div>
                                        <div class="col-xs-4 col-sm-4 col-md-4 col-lg-4">
                                            <input type="hidden" id="hfReqDateFrom" name="ReqFrom" />
                                            @Html.TextBoxFor(model => model.ReqDateFrom, new { @id = "ReqDateFrom", @class = "form-control dpDOB text-center", placeholder = "From", @readonly = "readonly" })
                                        </div>
                                        <div class="col-xs-4 col-sm-4 col-md-4 col-lg-4">
                                            <input type="hidden" id="hfReqDateTo" name="ReqTo" />
                                            @Html.TextBoxFor(model => model.ReqDateTo, new { @id = "ReqDateTo", @class = "form-control dpDOB text-center", placeholder = "To", @readonly = "readonly" })
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
                                        <div class="col-xs-4 col-sm-4 col-md-4 col-lg-4 text-right" style="margin-top:10px;font-size:14px;">
                                            @Html.LabelFor(model => model.PlantID, new { @class = "lbl-padding" })
                                        </div>
                                        <div class="col-xs-8 col-sm-8 col-md-8 col-lg-8">
                                            <input type="hidden" id="hfPlantId" name="PlantId" />
                                            @if (Model.PlantID != 0)
                                            {
                                                @Html.DropDownListFor(model => model.PlantID, new SelectList(ViewBag.SYPlant.Items, "SYPLANTID", "PLANTNAME"), new { @class = "form-control div_disable", @id = "Plant" })
                                            }
                                            else
                                            {
                                                @Html.DropDownListFor(model => model.PlantID, new SelectList(ViewBag.SYPlant.Items, "SYPLANTID", "PLANTNAME"), "--Select Plant--", new { @class = "form-control", @id = "Plant" })
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding-bottom: 8px;">
                                    <div class="col-xs-12 col-sm-8 col-md-6 col-lg-6">
                                        <div class="col-xs-4 col-sm-4 col-md-4 col-lg-4 text-right" style="margin-top:10px;font-size:14px;font-weight:bold;">
                                            @Html.DisplayName("Approval Date")
                                        </div>
                                        <div class="col-xs-4 col-sm-4 col-md-4 col-lg-4">
                                            <input type="hidden" id="hfApprovalDateFrom" name="ApprovalFrom" />
                                            @Html.TextBoxFor(model => model.ApprovalDateFrom, new { @id = "ApprovalDateFrom", @class = "form-control dpDOB text-center", placeholder = "From", @readonly = "readonly" })
                                        </div>
                                        <div class="col-xs-4 col-sm-4 col-md-4 col-lg-4">
                                            <input type="hidden" id="hfApprovalDateTo" name="ApprovalTo" />
                                            @Html.TextBoxFor(model => model.ApprovalDateTo, new { @id = "ApprovalDateTo", @class = "form-control dpDOB text-center", placeholder = "To", @readonly = "readonly" })
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4 text-right" style="padding-right: 30px;">
                                        <input type="hidden" id="hfCommand" name="Command" />
                                        <button type="button" id="btnSearch" class="btn btn-success btn-sm" >Search</button>
                                        <button type="button" id="btnReset" class="btn btn-default btn-sm" >Reset</button>
                                        <button type="button" id="btnExcel" class="btn btn-primary btn-sm" >Export To Excel</button>
                                    </div>
                                </div>
                            </div>

                            <div style="overflow-x:auto!important; height:300px; font-size:11px!important;">
                                <table class="table table-bordered table-hover table-responsive" id="tbMasterReport" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th class="text-center">
                                                @Html.DisplayName("SNo")
                                            </th>
                                            <th class="text-center">
                                                @Html.DisplayName("Request Type")
                                            </th>
                                            <th class="text-center">
                                                @Html.DisplayName("ECode")
                                            </th>
                                            <th class="text-left">
                                                @Html.DisplayName("Requestor Name")
                                            </th>
                                            <th class="text-center">
                                                @Html.DisplayName("Designation")
                                            </th>
                                            <th class="text-center" style="width: 32px;">
                                                @Html.DisplayName("DOJ")
                                            </th>
                                            <th class="text-center">
                                                @Html.DisplayName("Mobile")
                                            </th>
                                            <th class="text-left">
                                                @Html.DisplayName("Name")
                                            </th>
                                            <th class="text-center">
                                                @Html.DisplayName("Gender")
                                            </th>
                                            <th class="text-center" style="width: 32px;">
                                                @Html.DisplayName("DOB")
                                            </th>
                                            <th class="text-center">
                                                @Html.DisplayName("Age")
                                            </th>
                                            <th class="text-center">
                                                @Html.DisplayName("Relationship")
                                            </th>
                                            <th class="text-center">
                                                @Html.DisplayName("Type")
                                            </th>
                                            <th class="text-center">
                                                @Html.DisplayName("Change Type")
                                            </th>
                                            <th class="text-center">
                                                @Html.DisplayName("Paid Type")
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.MRVMList != null)
                                    {
                                        int rowNo = 0;
                                        foreach (var item in Model.MRVMList)
                                        {
                                                <tr>
                                                    <td class="text-center">
                                                        @(rowNo += 1)
                                                    </td>
                                                    <td class="text-center">
                                                        @(item.REQUESTTYPE)
                                                    </td>
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.EMP_CODE)
                                                    </td>
                                                    <td class="text-left">
                                                        @Html.DisplayFor(modelItem => item.ENAME)
                                                    </td>
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.DESIGNATION)
                                                    </td>
                                                    <td class="text-center">
                                                        @if (item.DOJ != null)
                                                    {
                                                        if (item.DOJ.ToString() != "01-Jan-1900 00:00:00")
                                                        {
                                                                @Html.DisplayFor(modelItem => item.DOJ)
                                                        }
                                                    }
                                                    </td>
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.TMOBILE)
                                                    </td>
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.PERNAME)
                                                    </td>
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.GENDER)
                                                    </td>
                                                    <td class="text-center">
                                                        @if (item.DOB != null)
                                                    {
                                                        if (item.DOB.ToString() != "01-Jan-1900 00:00:00")
                                                        {
                                                                @Html.DisplayFor(modelItem => item.DOB)
                                                        }
                                                    }
                                                    </td>
                                                    <td class="text-center">
                                                        @if (item.DOB != null)
                                                    {
                                                        if (item.DOB.ToString() != "01-Jan-1900 00:00:00")
                                                        {
                                                                @Html.DisplayFor(modelItem => item.AGE)
                                                        }
                                                    }
                                                    </td>
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.RELATIONSHIP)
                                                    </td>
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.RECTYPE)
                                                    </td>
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.CHANGETYPE)
                                                    </td>
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.PAIDTYPE)
                                                    </td>
                                                </tr>
                                        }
                                    }
                                    </tbody>
                                </table>
                            </div>
                            <table cellpadding="0" cellspacing="0" style="border: 1px solid #ccc;border-collapse:collapse;background-color:#fff;float:right;">
                                <tr>
                                    @for (int i = 1; i <= Model.PageCount; i++)
                                    {
                                        <td style="padding: 5px;border: 1px solid #ccc;">
                                            @if (i != Model.CurrentPageIndex)
                                            {
                                               @*  <a href="javascript:PagerClick(@i, 'search');">@i</a> *@
                                            <a data-ctrl-id="hrfPager" data-id="@i">@i</a>
                                            }
                                            else
                                            {
                                                <span>@i</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            </table>
                            <input type="hidden" id="hfCurrentPageIndex" name="currentPageIndex" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

