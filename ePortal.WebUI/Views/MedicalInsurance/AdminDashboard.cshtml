@model ePortal.ViewModels.MedicalInsuranceViewModel
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //var isExist = ViewBag.IsExist;
    var isRenewal = ViewBag.IsRenewal;
    //var CompanyPaid_Cnt = ViewBag.CompanyPaid_Cnt;
    //var AssociatedPaid_Cnt = ViewBag.AssociatedPaid_Cnt;
    //var TotalCompanyPaid = ViewBag.TotalCompanyPaid;
    //var TotalAssociatedPaid = ViewBag.TotalAssociatedPaid;
    var PlantLocation = ViewBag.PlantLocation;
}

@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .panel-brown {
            border-color: #ce972b;
        }

            .panel-brown > .panel-heading {
                color: #fff;
                background-color: #ce972b;
                border-color: #ce972b;
            }

        .panel-pink {
            border-color: #d67596;
        }

            .panel-pink > .panel-heading {
                color: #fff;
                background-color: #d67596;
                border-color: #d67596;
            }

        .pull-left {
            float: left !important;
            font-weight: bold;
        }
    </style>
}
  
@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('.homeContent').removeClass('homeContent');
            $('#btnNewJoineeOtherAssociate').on('click', function(){
            CheckApprovalStatus('/MedicalInsurance/NewJoineeOtherAssociate');
            });
             $('#btnRenewalOtherAssociate').on('click', function(){
            CheckApprovalStatus('/MedicalInsurance/RenewalOtherAssociate');
            });
            $('#btnMidTermOtherAssociate').on('click', function(){
           CheckApprovalStatus('/MedicalInsurance/MidTermOtherAssociate');
            });

             $('#btnHealthCenterApproval').on('click', function(){
           CheckApprovalStatus('/MedicalInsurance/HealthCenterApproval');
            });
             $('[data-view-ctrl="btviewdt"]').on('click', function () {
                 GetDetails($(this)[0]);
               
            });
        });

        function CheckApprovalStatus(current) {
            var strplnt = '@ViewBag.PlantLocation';
            if (strplnt == "") {
                sweetAlert("", "Policy Location is not mapped, please contact to health center department", "warning");
                return;
            }
            else {
                window.location.href = current;
            }
        @*if (@ViewBag.ApprovalStatus == 0) {
                window.location.href = current;
            }
            else{
                sweetAlert("", "1 Request is already in progress so you can not raise another.", "error");
            }*@
        }
        function GetDetails(current) {
           
            var $buttonClicked = $(this);
            var Id=$(current).attr('data-id');
            $.ajax({
                type: "GET",
                url: "/MedicalInsurance/DetailsHealthCenter",
                data: { id: Id },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#myDetailModalContent').html(data);
                        $('#myDetailsModel').modal({ backdrop: "static" });
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
    </script>
}   

    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Admin Dashboard</div>
        </div>
        <div class="body-content" style="overflow-x:auto!important;">
            <div class="row">
                <div class="col-lg-4 col-md-4">
                    <div class="panel panel-success">
                        <div class="panel-heading" style="padding: 49px;">
                            <div class="row">
                                <div class="col-xs-3">
                                    <i class="glyphicon glyphicon-user" style="font-size:50px;"></i>
                                </div>
                                <div class="col-xs-9 text-right">
                                    <div style="font-size: 20px;font-weight: bold;margin-bottom:10px;">New Joinee</div>
                                    @*<div class="huge" style="font-size: 12px;font-weight: bold;text-decoration:underline;margin-bottom:5px;">Location</div>
                                        <div class="huge">@PlantLocation</div>*@
                                </div>
                            </div>
                        </div>
                        <a id="btnNewJoineeOtherAssociate" >
                            <div class="panel-footer" style="cursor: pointer;">
                                <span class="pull-left">Click to new joinee form</span>
                                <span class="pull-right"><i class="glyphicon glyphicon-chevron-right"></i></span>
                                <div class="clearfix"></div>
                            </div>
                        </a>
                    </div>
                </div>

                @if (isRenewal == 1)
                {
                    <div class="col-lg-4 col-md-4">
                        <div class="panel panel-danger">
                            <div class="panel-heading" style="padding: 44px;">
                                <div class="row">
                                    <div class="col-xs-3">
                                        <i class="glyphicon glyphicon-edit" style="font-size:50px;"></i>
                                    </div>
                                    <div class="col-xs-9 text-right">
                                        <div style="font-size: 20px;font-weight: bold;margin-bottom:10px;">Renewal</div>
                                        @*<div class="huge" style="font-size: 12px;font-weight: bold;text-decoration:underline;margin-bottom:5px;">Location</div>
                                            <div class="huge" style="margin-bottom:10px;">@PlantLocation</div>*@
                                        <div class="huge" style="font-size: 12px;font-weight: bold;text-decoration:underline;margin-bottom:5px;">Renewal Period</div>
                                        <div class="huge">
                                            <span>(@ViewBag.Renewal_StartDate</span> to <span>@ViewBag.Renewal_EndDate)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <a id="btnRenewalOtherAssociate" >
                                <div class="panel-footer" style="cursor: pointer;">
                                    <span class="pull-left">Click to renewal form</span>
                                    <span class="pull-right"><i class="glyphicon glyphicon-chevron-right"></i></span>
                                    <div class="clearfix"></div>
                                </div>
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-lg-4 col-md-4">
                        <div class="panel panel-primary">
                            <div class="panel-heading" style="padding: 49px;">
                                <div class="row">
                                    <div class="col-xs-3">
                                        <i class="glyphicon glyphicon-tasks" style="font-size:50px;"></i>
                                    </div>
                                    <div class="col-xs-9 text-right">
                                        <div style="font-size: 20px;font-weight: bold;margin-bottom:10px;">Mid Term</div>
                                        @*<div class="huge" style="font-size: 12px;font-weight: bold;text-decoration:underline;margin-bottom:5px;">Location</div>
                                            <div class="huge">@PlantLocation</div>*@
                                    </div>
                                </div>
                            </div>
                            <a id="btnMidTermOtherAssociate" >
                                <div class="panel-footer" style="cursor: pointer;">
                                    <span class="pull-left">Click to mid term form</span>
                                    <span class="pull-right"><i class="glyphicon glyphicon-chevron-right"></i></span>
                                    <div class="clearfix"></div>
                                </div>
                            </a>
                        </div>
                    </div>
                }
                <div class="col-lg-4 col-md-4">
                    <div class="panel panel-brown">
                        <div class="panel-heading" style="padding: 41px;">
                            <div class="row">
                                <div class="col-xs-3">
                                    <i class="glyphicon glyphicon-list-alt" style="font-size:50px;"></i>
                                </div>
                                <div class="col-xs-9 text-right">
                                    <div style="font-size: 20px;font-weight: bold;margin-bottom:10px;">Pending Request</div>
                                    <div class="huge" style="font-size: 32px;font-weight: bold;text-decoration:underline;margin-bottom:5px;">@ViewBag.MIVMList.Count</div>
                                </div>
                            </div>
                        </div>
                        <a id="btnHealthCenterApproval" >
                            <div class="panel-footer" style="cursor: pointer;">
                                <span class="pull-left">Click to health center approval</span>
                                <span class="pull-right"><i class="glyphicon glyphicon-chevron-right"></i></span>
                                <div class="clearfix"></div>
                            </div>
                        </a>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-lg-6 col-md-6">
                    <div class="panel panel-pink">
                        <div class="panel-heading">
                            <h2 class="panel-title">
                                <span>Pending Request</span>
                                @*@if (isExist != 0 && Model.EmpCode > 0)
                                    {
                                        var RequestDetailUrl = "/MedicalInsurance/RequestDetails?id=" + ViewBag.UserId;
                                        <a href="@RequestDetailUrl"><span class="btn btn-default btn-xs pull-right">Request Detail</span></a>
                                    }*@
                            </h2>
                        </div>
                        <div class="panel-body" style="height:330px;background-color: #f6e7f9;padding:15px; overflow-y:auto;">
                            @if (ViewBag.MIVMList.Count > 0)
                            {
                                <div class="row" style="margin-top:5px;font-size:17px;">
                                    <div class="col-md-12">
                                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2 text-center" style="color:#d67596">
                                            Emp Code
                                        </div>
                                        <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3 text-center" style="color:#d67596">
                                            Request Date
                                        </div>
                                        <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3 text-center" style="color:#d67596">
                                            Request For
                                        </div>
                                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2 text-center" style="color:#d67596">
                                            Status
                                        </div>
                                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2 text-center" style="color:#d67596">

                                        </div>
                                    </div>
                                </div>

                                foreach (var item in ViewBag.MIVMList)
                                {
                                    <div class="row" style="margin-top:10px;font-size:14px;">
                                        <div class="col-md-12">
                                            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2 text-center" style="color:#d67596; padding-top: 5px;">
                                                @item.EmpCode
                                            </div>
                                            <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3 text-center" style="color:#d67596; padding-top: 5px;">
                                                @item.CreatedDate
                                            </div>
                                            <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3 text-center" style="color:#d67596; padding-top: 5px;">
                                                @if (item.RequestType == 1)
                                                {
                                                    <p>New Joinee</p>
                                                }
                                                else if (item.RequestType == 2)
                                                {
                                                    <p>Mid Term</p>
                                                }
                                                else if (item.RequestType == 3)
                                                {
                                                    <p>Renewal</p>
                                                }
                                            </div>
                                            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2 text-center" style="color:#d67596;padding-top: 5px;">
                                                @if (item.Approval_Status == 0 && item.RequestType > 0)
                                                {
                                                    <p>Pending</p>
                                                }
                                                else if (item.Approval_Status == 1)
                                                {
                                                    <p>Approved</p>
                                                }
                                                else if (item.Approval_Status == 3)
                                                {
                                                    <p>Send back</p>
                                                }
                                                else if (item.Approval_Status == 4)
                                                {
                                                    <p>Rejected</p>
                                                }
                                            </div>
                                            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2 text-center" style="color:#d67596">
                                                @{
                                                    if (item.Approval_Status != 3)
                                                    {
                                                    <button type="button" data-view-ctrl="btviewdt" data-id="@item.EmpCode" class="btn btn-info btn-xs glyphicon glyphicon-tasks" title="Click to view detail" ></button>
                                                    }
                                                    else if (item.RequestType == 1 && item.Approval_Status == 3)
                                                    {
                                                        using (Html.BeginForm())
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            @Html.HiddenFor(m => m.SearchEmpCode, new { Value = item.EmpCode })
                                                            <input type="submit" formaction="NewjoineeOtherAssociate" name="btnEdit" value="Modify" title="Click to modify detail" class="btn btn-warning btn-xs glyphicon glyphicon-edit" />
                                                        }
                                                    }
                                                    @*else if ((item.RequestType == 2 || item.RequestType == 3))
                                                    {
                                                        var reqUrl = item.RequestType == 2 ? "/MedicalInsurance/MidTermOtherAssociate" : item.RequestType == 3 ? "/MedicalInsurance/RenewalOtherAssociate" : "/MedicalInsurance/NewjoineeOtherAssociate";
                                                        <a href=@reqUrl class="btn btn-warning btn-xs glyphicon glyphicon-edit" title="Click to update request"></a>
                                                    }*@
                                                }
                                            </div>
                                        </div>
                                    </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="row" style="margin-top:25px;">
                                                            <div class="col-md-12">
                                                                <div class="col-xs-12 col-sm-6 col-md-4 col-lg-4" style="color:#d67596">
                                                                    No pending request.
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-6">
                    <div class="panel panel-info">
                        <div class="panel-heading">
                            Instruction
                        </div>
                        <div class="panel-body" style="height:330px;overflow-y:auto;">
                            <p style="line-height: 16px;"><img src="~/assets/images/next22.png" height="10px" />&nbsp;<span style="font-family:'Courier New';font-size:12px;font-weight:bold;color:brown;">Once policy for the year started after that addition can be done only in case of New  marriage and Child Birth.</span></p>
                            <p style="line-height: 16px;"><img src="~/assets/images/next22.png" height="10px" />&nbsp;<span style="font-family:'Courier New';font-size:12px;font-weight:bold;color:brown;">Company pays for the coverage of 3 dependents only.( Dependents mean wife /Husband, Children, Mother  & Father Only.)</span></p>
                            <p style="line-height: 16px;"><img src="~/assets/images/next22.png" height="10px" />&nbsp;<span style="font-family:'Courier New';font-size:12px;font-weight:bold;color:brown;">For additional Coverage (More then 3 dependent) associate has to pay himself.(Self paid policy applicable for two dependents only).</span></p>
                            <p style="line-height: 16px;"><img src="~/assets/images/next22.png" height="10px" />&nbsp;<span style="font-family:'Courier New';font-size:12px;font-weight:bold;color:brown;">New born baby  name for coverage should be submitted  from 0 to 90 days. ( If name is given after 90 days of birth the name can be added at the time of policy renewal only .  The associates has to give written information with recent photograph of new member to health centre at the time of policy renewal.)</span></p>
                            <p style="line-height: 16px;"><img src="~/assets/images/next22.png" height="10px" />&nbsp;<span style="font-family:'Courier New';font-size:12px;font-weight:bold;color:brown;">In Case of marriage name need to be submitted within 30 days from the date of marriage.( If name is given after 30 days from the date of marriage, the name can be added at the time of policy renewal only .The associates has to give written information with recent photograph of new member to health centre at the time of policy renewal.)</span></p>
                            <p style="line-height: 16px;"><img src="~/assets/images/next22.png" height="10px" />&nbsp;<span style="font-family:'Courier New';font-size:12px;font-weight:bold;color:brown;">Day one coverage of newborn applicable only for reimbursements. To Cover the day one complications in case of new born baby the name need to be submitted with in 10 days from the date of birth.</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="myDetailsModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="pull-left">
                        <h5 class="modal-title">Policy Details</h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body">
                    <div id="myDetailModalContent" style="font-size:14px;"></div>
                </div>
            </div>
        </div>
    </div>
