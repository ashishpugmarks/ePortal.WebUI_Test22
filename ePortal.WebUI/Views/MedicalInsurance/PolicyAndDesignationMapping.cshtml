@model ePortal.ViewModels.PolicyMappingViewModal

@{
    ViewBag.Title = "PolicyAndDesignationMapping";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/lib/bootstrap/css/bootstrap-multiselect.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .scrollit {
            overflow-y: auto;
            max-height: 100px;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .lbl-padding {
            padding: 4px;
        }
    </style>
   @*  <link href="~/lib/bootstrap/css/bootstrap-multiselect.css" rel="stylesheet" /> *@
}
   @section Scripts{
    <script src="~/lib/bootstrap/js/bootstrap.js"></script>
    @* <script src="~/lib/bootstrap/js/bootstrap-multiselect.js"></script> *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {

            $("#tbPolicyDesMapping").dataTable();
            $('.homeContent').removeClass('homeContent');

            $('.Designation').multiselect({
                nonSelectedText: '-- Select Designation --',
                includeSelectAllOption: true,
                maxHeight: 250,
                dropUp: false,
                buttonWidth: 195,
                enableFiltering: true
            });
            $('#btnSave').on('click', function(){
            SaveMappingDetail();
            });
             $('#btnUpdate').on('click', function(){
             SaveMappingDetail();
            });
             $('#reset').on('click', function(){
            ResetForm();
            });
            $('#Plant').on('change', function(){
            Plantchange();
            });
            
        });

        function Plantchange() {
            //$.post("/MedicalInsurance/GetPlantChange");
            window.location.href = "/MedicalInsurance/GetPlantChange?Plantid=" + $("#Plant").val();
        };

        function SaveMappingDetail() {
            var arrayList = new Array;
            var elName = document.getElementsByName("DIVTRANS");
            for (i = 0; i < elName.length; i++) {
                var objControls = elName[i];
                GPA_ROW = {
                    PlantId: $("#Plant").val(),
                    PolicyTypeId: $("#hfPolicyTypeId_" + (i + 1)).attr("data-pid"),
                    DesignationIds: $("#ddDesignation_" + (i + 1)).val(),
                    CompanyPaid_Cnt: ($("#CompanyPaid_" + (i + 1)) == null || $("#CompanyPaid_" + (i + 1)).val() === undefined) ? 0 : $("#CompanyPaid_" + (i + 1)).val(),
                    AssociatedPaid_Cnt: ($("#AssociatedPaid_" + (i + 1)) == null || $("#AssociatedPaid_" + (i + 1)).val() === undefined) ? 0 : $("#AssociatedPaid_" + (i + 1)).val(),
                }
                arrayList.push(GPA_ROW);               
            }

           
            var data = {
                PPVM: arrayList
            }
             console.log(JSON.stringify(data));

            $.ajax({
                type: "POST",
                url: "/MedicalInsurance/PolicyAndDesignationMapping",
                data: data,
                //contentType: "application/json",
                 /* contentType: "appli cation/json; charset=utf-8",*/
                 // datatype: "json",
                success: function (res) {
                    if (res == 1) {
                        swal({
                            title: "Information",
                            text: "Data Saved Successfully",
                            type: "success"
                        }, function () {
                            window.location.href = "/MedicalInsurance/PolicyAndDesignationMapping";
                        });
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        };

        function ResetForm() {
            window.location.href = "/MedicalInsurance/PolicyAndDesignationMapping";
        }
    </script>
   }
    

