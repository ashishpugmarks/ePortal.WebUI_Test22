@model ePortal.ViewModels.MedicalInsuranceViewModel
@{
    ViewBag.Title = "EditForHealthCenter";
}

    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .span-heading {
            font-size: 18px;
            font-weight: bold;
            color: #337ab7;
            margin-left: 10px;
        }

            .span-heading > i {
                margin-right: 10px;
            }

        .div-padding > div {
            padding-top: 12px;
        }

        /*.strong-margin > div {
                    margin-left: 2.3em;
                }*/

        .vertical-middle {
            vertical-align: middle;
        }

        .highlight {
            color: #f1B835;
        }
    </style>


    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
        $(document).ready(function () {
            $('.homeContent').removeClass('homeContent');
            $('[data-toggle="tooltip"]').tooltip();
            $('#btnApprove').on('click', function(){
            //onclick="UpdateStatus(this);"
            UpdateStatus($(this)[0]);
            });
             $('#btnSendBack').on('click', function(){
            //onclick="UpdateStatus(this);"
            UpdateStatus($(this)[0]);
            });
             $('#btnReject').on('click', function(){
            //onclick="UpdateStatus(this);"
            UpdateStatus($(this)[0]);
            });
        });
    </script>
  
    

    <div class="row">
        <div class="body-content" style="overflow-x:auto!important;padding-top: 0px!important;padding-bottom: 0px!important">
            <div class="row">
                <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6" style="margin-bottom: 20px;">
                    <span class="span-heading"><i class="glyphicon glyphicon-user"></i>Self</span>
                    @*<hr />*@
                    @{string styleclass = ""; string title = ""; }
                    <div class="detail-div">
                        <div class="col-xs-5 col-sm-5 col-md-5 col-lg-5 div-padding strong-margin">
                            <div><strong>Emp Code</strong></div>
                            <div><strong>Name</strong></div>
                            <div><strong>Gender</strong></div>
                            <div><strong>D.O.B</strong></div>
                        </div>
                        <div class="col-xs-7 col-sm-7 col-md-7 col-lg-7 div-padding">
                            <input type="hidden" value="@Model.EmpCode" id="hfMIEmpId" />
                            <div>@Model.EmpCode</div>
                            @{if (!string.IsNullOrEmpty(Model.PREVIOUS_EMP_NAME) && Model.PREVIOUS_EMP_NAME != Model.Name) { styleclass = "highlight"; title = Model.PREVIOUS_EMP_NAME; } else { styleclass = ""; title = ""; } }
                            <div data-toggle="tooltip" title=@title class=@styleclass>@Model.Name</div>
                            <div>@Model.Gender</div>
                            @{if (!string.IsNullOrEmpty(Model.PREVIOUS_EMPDOB) && Model.PREVIOUS_EMPDOB != Model.DOB) { styleclass = "highlight"; title = Model.PREVIOUS_EMPDOB; } else { styleclass = ""; title = ""; } }
                            <div data-toggle="tooltip" title="@title" class=@styleclass>@Model.DOB</div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6" style="margin-bottom: 20px;">
                    <span class="span-heading"><i class="glyphicon glyphicon-share"></i>Nominee</span>
                    @*<hr />*@
                    <div class="detail-div">
                        <div class="col-xs-5 col-sm-5 col-md-5 col-lg-5 div-padding strong-margin">
                            <div><strong>Nominee</strong></div>
                            <div><strong>Relation</strong></div>
                            <div><strong>Gender</strong></div>
                            <div><strong>D.O.B</strong></div>
                        </div>
                        <div class="col-xs-7 col-sm-7 col-md-7 col-lg-7 div-padding">
                            @{if (!string.IsNullOrEmpty(Model.NomineeDetail.PREVIOUS_NOMINEE_NAME) && Model.NomineeDetail.NomineeName != Model.NomineeDetail.PREVIOUS_NOMINEE_NAME) { styleclass = "highlight"; title = Model.NomineeDetail.PREVIOUS_NOMINEE_NAME; } else { styleclass = ""; title = ""; } }
                            <div data-toggle="tooltip" title="@title" class=@styleclass>@Model.NomineeDetail.NomineeName</div>
                            @{if (!string.IsNullOrEmpty(Model.NomineeDetail.PREVIOUS_NOMINEE_RELATION) && Model.NomineeDetail.NomineeRelation != Model.NomineeDetail.PREVIOUS_NOMINEE_RELATION) { styleclass = "highlight"; title = Model.NomineeDetail.PREVIOUS_NOMINEE_RELATION; } else { styleclass = ""; title = ""; } }
                            <div data-toggle="tooltip" title="@title" class=@styleclass>@Model.NomineeDetail.NomineeRelation</div>
                            @{if (!string.IsNullOrEmpty(Model.NomineeDetail.PREVIOUS_NOMINEE_GENDER) && Model.NomineeDetail.NomineeGender != Model.NomineeDetail.PREVIOUS_NOMINEE_GENDER) { styleclass = "highlight"; title = Model.NomineeDetail.PREVIOUS_NOMINEE_GENDER; } else { styleclass = ""; title = ""; } }
                            <div data-toggle="tooltip" title="@title" class=@styleclass>@Model.NomineeDetail.NomineeGender</div>
                            @{if (!string.IsNullOrEmpty(Model.NomineeDetail.PREVIOUS_NOMINEE_DOB) && Model.NomineeDetail.NomineeDOB != Model.NomineeDetail.PREVIOUS_NOMINEE_DOB) { styleclass = "highlight"; title = Model.NomineeDetail.PREVIOUS_NOMINEE_DOB; } else { styleclass = ""; title = ""; } }
                            <div data-toggle="tooltip" title="@title" class=@styleclass>@Model.NomineeDetail.NomineeDOB</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <span class="span-heading"><i class="glyphicon glyphicon-list-alt"></i>Dependent</span>
                    <table style="width:100%; margin-top:3px;">
                        <thead>
                            <tr style="height:30px;">
                                <th style="width:4%;" class="text-center vertical-middle">#</th>
                                <th class="vertical-middle">Type</th>
                                <th class="vertical-middle">Name</th>
                                <th class="text-center vertical-middle">Relation</th>
                                <th class="text-center vertical-middle">D.O.B</th>
                                <th class="text-center vertical-middle">Gender</th>
                                <th class="text-center vertical-middle">Policy Type</th>
                                @if (Model.RequestType == 2)
                                {
                                    <th class="text-center vertical-middle">Proof</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Dependents)
                            {
                                <tr style="height:30px;">
                                    <td style="width:4%;" class="text-center">@item.Sno</td>
                                    <td>@(item.DepChangeType == 1 ? "Added" : (item.DepChangeType == 2 ? "Modified" : "Deleted"))</td>
                                    @{if (!string.IsNullOrEmpty(item.PREVIOUS_DEP_NAME) && item.DepName != item.PREVIOUS_DEP_NAME) { styleclass = "highlight"; title = item.PREVIOUS_DEP_NAME; } else { styleclass = ""; title = ""; } }
                                    <td><span data-toggle="tooltip" title="@title" class=@styleclass>@item.DepName</span></td>
                                    @{if (!string.IsNullOrEmpty(item.PREVIOUS_DEP_RELATION) && item.DepRelation != item.PREVIOUS_DEP_RELATION) { styleclass = "highlight"; title = item.PREVIOUS_DEP_RELATION; } else { styleclass = ""; title = ""; } }
                                    <td class="text-center"><span data-toggle="tooltip" title="@title" class=@styleclass>@item.DepRelation</span></td>
                                    @{if (!string.IsNullOrEmpty(item.PREVIOUS_DEP_DOB) && item.DepDOB != item.PREVIOUS_DEP_DOB) { styleclass = "highlight"; title = item.PREVIOUS_DEP_DOB; } else { styleclass = ""; title = ""; } }
                                    <td class="text-center"><span data-toggle="tooltip" title="@title" class=@styleclass>@item.DepDOB</span></td>
                                    @{if (!string.IsNullOrEmpty(item.PREVIOUS_DEP_GENDER) && item.DepGender != item.PREVIOUS_DEP_GENDER) { styleclass = "highlight"; title = item.PREVIOUS_DEP_GENDER; } else { styleclass = ""; title = ""; } }
                                    <td class="text-center"><span data-toggle="tooltip" title="@title" class=@styleclass>@item.DepGender</span></td>
                                    <td class="text-center">@item.DepPolicyType</td>
                                    <td class="text-center">
                                        @if (item.DepChangeType == 3 && Model.RequestType == 2)
                                        {
                                            @Html.ActionLink("Proof", "DownloadProof", "MedicalInsurance", new { id = item.DepItemId, empCode = Model.EmpCode }, null)
                                            @*var imgSrc = String.Format("data:" + item.Doc_ContentType + ";base64,{0}", item.Doc_fileString);
                                                <img src="@imgSrc" id="proof_doc" alt="proof" title="Proof document" class="" />*@
                                        }
                                    </td>
                                </tr>
                                        }
                        </tbody>
                    </table>
                </div>
            </div>
            <br />
            <div class="row">
                @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "control-label t text-right col-md-2" })
                <div class="col-md-9" style="margin-top: 3px;">
                    @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control", @rows = "3", @id = "txtremark" })
                    @Html.ValidationMessageFor(model => model.Remarks, "", new { @class = "text-danger", @id = "lblMessage" })
                </div>
            </div>
            <div class="row" style="margin-top:10px;">
                <div class="col-md-offset-4 col-md-8">
                    <button type="button" class="btn btn-success" id="btnApprove" data-id="@Model.EmpCode" data-ReqType="@Model.RequestType" data-status="1" >Approve</button>
                    @if (Model.RequestType == 1)
                    {
                        <button type="button" class="btn btn-warning" id="btnSendBack" data-id="@Model.EmpCode" data-ReqType="@Model.RequestType" data-status="3" >Send Back</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-danger" id="btnReject" data-id="@Model.EmpCode" data-ReqType="@Model.RequestType" data-status="4" >Reject</button>
                    }
                    <button type="button" class="btn btn-secondary" id="Close" data-dismiss="modal" aria-label="Close">Cancel</button>
                </div>
            </div>
        </div>
    </div>
