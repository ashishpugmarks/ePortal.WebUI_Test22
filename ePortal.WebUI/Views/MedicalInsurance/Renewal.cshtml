        function AddRecord()
        {

           var DeletedArrayList = new Array, ItemId = 0;
            $("#span-errorMsg").text("");
            var isFormVaildation = CheckDepValidation();

            if (!isFormVaildation) {
                $("#span-errorMsg").text("All fields are mandatory.");                
                return false;
            }
            var RecordIsExist;
            if($("#txtDepRelation").val() == "Child"){
                RecordIsExist = arrayList.filter(function (entry) { return entry.DepName == $('#txtDepName').val() });
            }
            else{
                RecordIsExist = arrayList.filter(function (entry) { return entry.DepRelation == $('#txtDepRelation').val() });
            }
            if(RecordIsExist.length == 0)
            {
                var PaidType_Cnt = arrayList.filter(function (entry) { return entry.DepPolicyType == $("input:radio:checked").val() });
                var TotalPaidCnt = $("input:radio:checked").val() == "Associate Paid" ? @ViewBag.TotalAssociatedPaid : @ViewBag.TotalCompanyPaid;
                if(PaidType_Cnt.length < TotalPaidCnt){
                    ////if(arrayList == null || arrayList.length == 0){
                    ////    arrayList = new Array;
                    ////    ItemId = ItemId + 1
                    ////}
                    //////else{
                    //////    ItemId=arrayList[arrayList.length-1].DepItemId+1;
                    //////}
                    var data = {
                        DepItemId: ItemId,
                        DepName: $('#txtDepName').val(),
                        DepRelation: $("#txtDepRelation").val(),
                        DepDOB: $("#txtDepDOB").val(),
                        DepGender: $("#ddDepGender").val(),
                        ////DepRequestType: $('#ddDepRequestType').val(),
                        DepPolicyType: $("input:radio:checked").val(), // Company Paid, Associate Paid
                        DepChangeType: 1, // addition
                        //DepImgString: $('#Dep-img')[0].src,
                        //DepPhotoContype: "Image/" + $('#DepContentType').val(),
                    }
                    arrayList.push(data);
                    BindData(arrayList);
                    $("#btnSubmit").attr("disabled", false)
                }
                else{
                    sweetAlert("", "You can add maximum " + TotalPaidCnt + " " + $("input:radio:checked").val() + " dependent.", "warning");
                }
            }
            else{
                sweetAlert("", "Dependent already added", "warning");
            }
            ResetDepForm();
        }

        function BindData(arrayList) {
            var rows = "", rowId = 0, depPolicyType = "", depGender = "";
            if(arrayList != null){
                $.each(arrayList, function (i, item) {
                    rowId = i + 1;
                    rows += "<tr><td class='text-center'>" + rowId + "</td><td class='text-center'><span style='margin-left:7px; vertical-align:top;'>" + item.DepName + "</span></td><td class='text-center'>" + item.DepRelation + "</td>"
                    rows += "<td class='text-center'>" + item.DepDOB + "</td><td class='text-center hidden-xs hidden-sm'>" + item.DepGender + "</td><td class='text-center'>" + item.DepPolicyType + "</td>"
                    rows += "<td class='text-center'><i class='glyphicon glyphicon-trash cursor' title='Click to delete' data-ctrl-id='bt-delete-dt' data-id='"+ item.DepItemId +"'  data-depname='" + item.DepName + "' data-relation='" + item.DepRelation + "'   style='color:#d43f3a;'></i>&nbsp; &nbsp;"
                    rows += "<i class='glyphicon glyphicon-edit cursor' title='Click to update' data-ctrl-id='bt-edit-dt' data-id='"+ item.DepItemId +"'  data-depname='" + item.DepName + "' data-relation='" + item.DepRelation + "' ></i></td></tr>"
                });
                //<img src='"+ item.DepImgString +"' style='width: 30px;height: 30px; border-radius: 8px;' />
                document.getElementById("append_row").innerHTML = rows;
            }
            return;
        }

        function EditItem(current) {
            var dep_name = $(current).attr('data-depname');
            var dep_rel = $(current).attr('data-relation');
            var dep_id = $(current).attr('data-id');
           
            ////// current detail ///////
            var CurrentDetail = arrayList.filter(function (entry) { return entry.DepItemId == dep_id && entry.DepName == dep_name && entry.DepRelation == dep_rel });
          
            $('#crt-name').text(CurrentDetail[0].DepName);
            $("#crt-relation").text(CurrentDetail[0].DepRelation);
            $("#crt-dob").text(CurrentDetail[0].DepDOB);
            $("#crt-gender").text(CurrentDetail[0].DepGender);
            /////// sap Detail
            var SAPDetail;
            if(CurrentDetail[0].DepRelation == "Child"){
                SAPDetail = SAPDependentList.filter(function (entry) { return entry.DepName == CurrentDetail[0].DepName });
               
                if(SAPDetail == null && SAPDetail.length == 0){
                    sweetAlert("", "In case of child name change first delete the record and add new record.", "warning");
                    return;
                }
            }
            else{
                SAPDetail = SAPDependentList.filter(function (entry) { return entry.DepRelation == CurrentDetail[0].DepRelation });                 
            }
           
            if(SAPDetail.length > 0){
                // Remove highlight
                $('#crt-name').removeClass('highlight');
                $('#sap-name').removeClass('highlight');
                $('#crt-dob').removeClass('highlight');
                $('#sap-dob').removeClass('highlight');
                $('#crt-relation').removeClass('highlight');
                $('#sap-relation').removeClass('highlight');
                $('#crt-gender').removeClass('highlight');
                $('#sap-gender').removeClass('highlight');

                $('#sap-name').text(SAPDetail[0].DepName);
                $("#sap-relation").text(SAPDetail[0].DepRelation);
                $("#sap-dob").text(SAPDetail[0].DepDOB);
                $("#sap-gender").text(SAPDetail[0].DepGender);
                // highlight for update
                if(CurrentDetail[0].DepName != SAPDetail[0].DepName){
                    $('#crt-name').addClass('highlight');
                    $('#sap-name').addClass('highlight');
                }
                if(CurrentDetail[0].DepDOB != SAPDetail[0].DepDOB){
                    $('#crt-dob').addClass('highlight');
                    $('#sap-dob').addClass('highlight');
                }
                if(CurrentDetail[0].DepRelation != SAPDetail[0].DepRelation){
                    $('#crt-relation').addClass('highlight');
                    $('#sap-relation').addClass('highlight');
                }
                if(CurrentDetail[0].DepGender != SAPDetail[0].DepGender){
                    $('#crt-gender').addClass('highlight');
                    $('#sap-gender').addClass('highlight');
                }
                // set paid type
                if(CurrentDetail[0].DepPolicyType == "Company Paid"){
                    $("#rbCompanyPaid").prop("checked", true);
                }
                if(CurrentDetail[0].DepPolicyType == "Associate Paid"){
                    $("#rbAssociatePaid").prop("checked", true);
                }
                $('#myEditModel').modal({ backdrop: "static" });
            }
            else if(SAPDetail.length == 0){
                sweetAlert("", "Record not updated in SAP. Kindly update the record in SAP.", "warning");
            }
        }

        function DeleteItem(current) {
            $('#lbl-msg').text('');
            var dep_name = $(current).attr('data-depname');
            var dep_rel = $(current).attr('data-relation');
            var dep_id = $(current).attr('data-id');
            var DeletedItem= $.grep(arrayList, function (e) {
                return e.DepItemId == dep_id && e.DepName == dep_name && e.DepRelation == dep_rel;
            })
            $('#crt-id').val(DeletedItem[0].DepItemId);
            $('#crt-hfName').val(DeletedItem[0].DepName);
            $('#crt-hfRel').val(DeletedItem[0].DepRelation);
            $('#crt-Depname').text(DeletedItem[0].DepName);
            $("#crt-Deprelation").text(DeletedItem[0].DepRelation);
            $("#crt-Depdob").text(DeletedItem[0].DepDOB);
            $("#crt-Depgender").text(DeletedItem[0].DepGender);
            $("#crt-Deppaid").text(DeletedItem[0].DepPolicyType);
            $('#myDeleteModel').modal({ backdrop: "static" });
        }
        function ConfirmDeleteItem() {
            var DeletedItem = $.grep(arrayList, function (e) {
                return e.DepItemId == $('#crt-id').val() && e.DepName == $('#crt-hfName').val() && e.DepRelation == $('#crt-hfRel').val()
            });
            var DeletedData = {
                DepItemId: DeletedItem[0].DepItemId,
                DepName: DeletedItem[0].DepName,
                DepRelation: DeletedItem[0].DepRelation,
                DepDOB: DeletedItem[0].DepDOB,
                DepGender: DeletedItem[0].DepGender,
                DepPolicyType: DeletedItem[0].DepPolicyType,
            }
            DeletedArrayList.push(DeletedData);

            //// Delete item remove in array list
            if(DeletedData.DepRelation == "Child"){
                arrayList = arrayList.filter(function (entry) { return entry.DepName != DeletedData.DepName });
            }
            else{
                arrayList = arrayList.filter(function (entry) { return entry.DepRelation != DeletedData.DepRelation });
            }

            BindData(arrayList);
            $("#btnSubmit").attr("disabled", false)
            $('#myDeleteModel').modal("hide");
        }


