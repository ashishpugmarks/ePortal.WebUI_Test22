        function GetByDepName(current) {
            var selectedVal = $('#txtDepName').val();
            var filteredDep = SAPDependentList.filter(function(obj) {
                return (obj.DepName === selectedVal);
            });
            $("#txtDepRelation").val(filteredDep[0].DepRelation);
            $("#txtDepDOB").val(filteredDep[0].DepDOB);
            $("#ddDepGender").val(filteredDep[0].DepGender);
        }

        function SaveMedicalInfo(){
            var isMedicalFormVaildation = CheckMedicalFormValidation();
            if(!isMedicalFormVaildation){
                sweetAlert(" ", "Please enter nominee details and dependents details", "warning");
                return;
            }

            var Nominee = {
                NomineeName: $('#txtNomineeName').val(),
                NomineeRelation: $('#ddNomineeRelation').val(),
                NomineeGender: $('#ddNomineeGender').val(),
                NomineeDOB: $('#txtNomineeDOB').val(),
                //NomineeImgString: $('#Nominee-img')[0].src,
                //NomineePhotoContype: "Image/" + $('#NomineeContentType').val(),
            };
            var MedicalViewModel = {
                EmpCode: $('#EmpCode').val(),
                Name: $('#Name').val(),
                Gender: $('#ddGender').val(),
                DOB: $('#DOB').val(),
                NomineeDetail : Nominee,
                Dependents : arrayList,
                DeleteDependentList : DeletedArrayList,
            }
            $.ajax({
                type: "POST",
                url: "/MedicalInsurance/Renewal",
                data: JSON.stringify(MedicalViewModel),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if(data == 1){
                        swal({
                            title: "",
                            text: "Record saved successfully",
                            type: "success",
                        }, function (isConfirm) {
                            if (isConfirm) {
                                window.location.href = "/MedicalInsurance/Dashboard";
                            }
                        });
                    }
                    else if(data == 0 || data == -1){
                        sweetAlert("", "Record not saved", "warning");
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function isButtonCheck(){
            var PaidType_Cnt = arrayList.filter(function (entry) { return entry.DepPolicyType == $("input:radio:checked").val() });
            var TotalPaidCnt = $("input:radio:checked").val() == "Associate Paid" ? @ViewBag.TotalAssociatedPaid : @ViewBag.TotalCompanyPaid;
            if(PaidType_Cnt.length < TotalPaidCnt){
                return;
            }
            else{
                $('#myEditModel').modal("hide");
                sweetAlert("", "You can add maximum " + TotalPaidCnt + " " + $("input:radio:checked").val() + " dependent.", "warning");
                return;
            }
        }

        function UpdateDependentDetail(){
                var SAPDetail, CurrentDetail, relation;
                relation = $("#crt-relation").text();
                if(relation == 'Child'){
                    SAPDetail = SAPDependentList.filter(function (entry) { return entry.DepName == $("#crt-name").text() });
                    CurrentDetail = arrayList.filter(function (entry) { return entry.DepName == $("#crt-name").text() });
                    arrayList = arrayList.filter(function (entry) { return entry.DepName != $("#crt-name").text() });
                }
                else{
                    SAPDetail = SAPDependentList.filter(function (entry) { return entry.DepRelation == relation });
                    CurrentDetail = arrayList.filter(function (entry) { return entry.DepRelation == relation });
                    arrayList = arrayList.filter(function (entry) { return entry.DepRelation != relation });
                }
                var updateddata = {
                    DepItemId: CurrentDetail[0].DepItemId,
                    DepName: SAPDetail[0].DepName,
                    DepRelation: SAPDetail[0].DepRelation,
                    DepDOB: SAPDetail[0].DepDOB,
                    DepGender: SAPDetail[0].DepGender,
                    DepPolicyType: $("input:radio[name=paidtype]:checked").val(), // Company Paid, Associate Paid
                    DepChangeType: 2, // modification
                    //DepImgString: CurrentDetail[0].DepImgString,
                    //DepPhotoContype: CurrentDetail[0].DepPhotoContype,
                }
                arrayList.push(updateddata);
                BindData(arrayList);
                $('#myEditModel').modal("hide");
                $("#btnSubmit").attr("disabled", false)
        }

        function CancelDependentDetail(){
            $('#myEditModel').modal("hide");
        }
        function CancelDeleteDependentDetail(){
            $('#myDeleteModel').modal("hide");
        }
    </script>
