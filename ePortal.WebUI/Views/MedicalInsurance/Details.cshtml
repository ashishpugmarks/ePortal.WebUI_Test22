@model ePortal.ViewModels.MedicalInsuranceViewModel
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .span-heading {
            font-size: 18px;
            font-weight: bold;
            color: #337ab7;
            margin-left: 10px;
        }

            .span-heading > i {
                margin-right: 10px;
            }

        .detail-div {
            background-color: #ecf3f9;
            border-radius: 10px;
            height: 166px;
            margin-top: 10px;
        }

        .div-padding > div {
            padding: 12px;
        }

        .strong-margin > div {
            margin-left: 2.3em;
        }

        .vertical-middle {
            vertical-align: middle;
        }
    </style>
}
@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('.homeContent').removeClass('homeContent');
        });
    </script>
}   
   

    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Policy Details</div>
        </div>
        <div class="body-content" style="overflow-x:auto!important;">
            <div class="row">
                <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6" style="margin-bottom: 20px;">
                    <span class="span-heading"><i class="glyphicon glyphicon-user"></i>Self</span>
                    @*<hr />*@
                    <div class="col-md-12 detail-div">
                        <div class="col-xs-6 col-sm-6 col-md-6 col-lg-6 div-padding strong-margin">
                            <div><strong>Emp Code</strong></div>
                            <div><strong>Name</strong></div>
                            <div><strong>Gender</strong></div>
                            <div><strong>D.O.B</strong></div>
                        </div>
                        <div class="col-xs-6 col-sm-6 col-md-6 col-lg-6 div-padding">
                            <div>@Model.EmpCode</div>
                            <div>@Model.Name</div>
                            <div>@Model.Gender</div>
                            <div>@Model.DOB</div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6" style="margin-bottom: 20px;">
                    <span class="span-heading"><i class="glyphicon glyphicon-share"></i>Nominee</span>
                    @*<hr />*@
                    <div class="col-md-12 detail-div">
                        <div class="col-xs-6 col-sm-6 col-md-6 col-lg-6 div-padding strong-margin">
                            <div><strong>Nominee Name</strong></div>
                            <div><strong>Relation</strong></div>
                            <div><strong>Gender</strong></div>
                            <div><strong>D.O.B</strong></div>
                        </div>
                        <div class="col-xs-6 col-sm-6 col-md-6 col-lg-6 div-padding">
                            <div>@Model.NomineeDetail.NomineeName</div>
                            <div>@Model.NomineeDetail.NomineeRelation</div>
                            <div>@Model.NomineeDetail.NomineeGender</div>
                            <div>@Model.NomineeDetail.NomineeDOB</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <span class="span-heading"><i class="glyphicon glyphicon-list-alt"></i>Dependent</span>
                    @*<hr />*@
                    <div style="background-color: #ecf3f9;border-radius: 10px;width:100%; height:300px;margin-bottom:15px;">
                        <table style="width:100%;margin-top:10px;">
                            <thead>
                                <tr style="height:50px;">
                                    <th style="width:7%;" class="text-center vertical-middle">#</th>
                                    <th class="text-center vertical-middle">Name</th>
                                    <th class="text-center vertical-middle">Relation</th>
                                    <th class="text-center vertical-middle">D.O.B</th>
                                    <th class="text-center vertical-middle">Gender</th>
                                    <th class="text-center vertical-middle">Policy Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Dependents)
                                {
                                    <tr style="height:30px;">
                                        <td style="width:7%;" class="text-center">@item.Sno</td>
                                        <td class="text-center">@item.DepName</td>
                                        <td class="text-center">@item.DepRelation</td>
                                        <td class="text-center">@item.DepDOB</td>
                                        <td class="text-center">@item.DepGender</td>
                                        <td class="text-center">@item.DepPolicyType</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <p>
                @Html.ActionLink("Back to Dashboard", "Dashboard")
            </p>
        </div>
    </div>
