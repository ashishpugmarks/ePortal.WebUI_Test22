@model ePortal.ViewModels.FoundationDayBookingTrnViewModel

@{
    ViewBag.Title = "Foundation Day Leave";
    Layout = "~/Views/Shared/_Layout.cshtml";
    long Issitexist = ViewBag.site_id;

}
@section Styles {
    @* <link href="~/assets/css/jquery-ui.css" rel="stylesheet" /> *@

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .table > tbody > tr:nth-of-type(even) {
            background: #d9edf7;
        }

        .table > thead > tr > th {
            padding: 6px 10px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            padding: 5px;
            line-height: 1.2;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        .table > tbody > tr > td {
            padding: 4px 6px;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../assets/images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .alert-error {
            background-color: antiquewhite;
            margin-left: 15px;
            margin-right: 15px;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .highlightBackground {
            background-color: #8bb55a !important;
            color: white;
        }

        .card-body {
            flex: 1 1 auto;
            padding: 0.2rem 0.2rem;
            height: auto;
            background-color: burlywood;
        }

        .card-title {
            margin-bottom: 0.3rem;
            font-weight: 600;
        }

        .card-text {
            font-size: small;
            line-height: normal;
        }

        .h-100 {
            height: 100% !important;
        }

        .ui-widget {
            overflow-y: scroll !important;
            max-height: 200px !important;
            min-height: 25px !important;
            width: 37.5% !important;
        }

        .ui-autocomplete {
            font-size: 15px !important;
            background-color: wheat !important;
        }

        .disableCSS {
            cursor: not-allowed !important;
            pointer-events: none;
            opacity: 0.7;
        }
    </style>
}


<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">
            Foundation Day Booking
        </div>
    </div>

    <div class="body-content" style="overflow-x:auto!important;">
        <div class="panel-group">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title">
                        <strong>Booking Detail's</strong>
                        <strong class="pull-right">
                            <input type="button" class="btn btn-default btn-xs" onclick="BookingHistory(this)" value="Booking History" />
                        </strong>
                    </h2>
                </div>
                <div class="panel-body">
                    <div class="col-md-7">
                        <table class="table table-bordered">
                            <tbody>
                                @* #Upgrade Aumento Start :: CR7504 *@
                                @*
                                <tr>
                                    <th class="text-right">
                                        @Html.LabelFor(model => model.MEAL_BOOKED_DATE, new { @class = "control-label", @style = "margin-top: 7px;padding-bottom: 5px;" })
                                    </th>
                                    <th colspan="2">
                                        @Html.TextBoxFor(model => model.strBOOKED_DATE, new { @class = "form-control", @style = "width: 40%;", @name = "BookingDate", @id = "txtBookingDate", @readonly = "readonly", @placeholder = "Booking Date" })
                                        <input type="hidden" value="@ViewBag.BookingID" id="hdnbookingid" />
                                    </th>
                                </tr>
                                <tr>
                                *@
                                <tr>
                                    <th style="width: 25%;">
                                        @Html.LabelFor(model => model.MEAL_BOOKED_DATE,
                                        new { @class = "control-label", @style = "margin-top: 7px; padding-bottom: 5px;" })

                                        @Html.TextBoxFor(model => model.strBOOKED_DATE,
                                                                                new
                                                                                {
                                                                                    @class = "form-control",
                                                                                    @style = "width: 25%; display:inline-block;",
                                                                                    @name = "BookingDate",
                                                                                    @id = "txtBookingDate",
                                                                                    @readonly = "readonly",
                                                                                    @placeholder = "Booking Date"
                                                                                })
                                        <input type="hidden" value="@ViewBag.BookingID" id="hdnbookingid" />
                                    </th>

                                </tr>

                                <tr>
                                    <th colspan="2">
                                        <div style="display: flex; justify-content: space-between; align-items: center;">

                                            <div style="display: flex; align-items: center; gap: 10px; width: 48%;">
                                                <label style="white-space: nowrap;">WhatsApp No. <span style="color: red;">*</span></label>
                                                <input type="text" class="form-control" placeholder="Enter WhatsApp Number" id="whatsappno" style="width:60%;" required />
                                            </div>

                                            <div style="display: flex; align-items: center; gap: 10px; width: 48%;">
                                                <label style="white-space: nowrap;">Personal Email <span style="color: red;">*</span></label>
                                                <input type="email" class="form-control" placeholder="Enter Personal Email" id="personalemail" style="width: 70%;" required />
                                            </div>
                                        </div>
                                    </th>
                                </tr>
                                @* #Upgrade Aumento End :: CR7504*@
                                <tr style="background-color: antiquewhite;">
                                    @*<th colspan="4" style="color: blue;">Note :-</th>*@
                                    <th colspan="4" style="color: blue;">HMSI Foundation Day</th>
                                </tr>
                                <tr style="background-color: white;">
                                    <td colspan="4">
                                        <p style="color:#a94442;">
                                            We are thrilled to invite you to join us for Foundation Day Celebration of Honda Motorcycle and Scooter India Pvt Ltd.
                                            <br />This remarkable milestone wouldn’t have possible without the support and dedication of each of you.
                                            <br />Join us with your family for the day of celebration, reflection and sharing of our journey over the pass years.
                                            <br />Your presence will make this occupation even more special
                                            <br />
                                            <br />
                                            <b>Note :-</b><br />
                                            <b>1.</b> Married Associates can bring Spouse, Children and Parents.<br />
                                            <b>2.</b> Unmarried Associate can bring Parents only. <br />
                                            <b>3.</b> I hereby giving my consent for my WhatsApp number and personal email to be used solely for the purpose of receiving invitations related to Foundation Day events.<br />  @* #Upgrade Aumento Added :: CR7504*@
                                        </p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-5">
                        <div class="form-group" style="margin-bottom: 0px;">
                            <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;" id="tbFamily">
                                <thead>
                                    <tr class="bg-info">
                                        <th class="text-center" style="width:15%;">SNo.</th>
                                        <th style="width:45%;">Member Name</th>
                                        <th class="text-center" style="width:20%;">Relation</th>
                                        <th class="text-center">Booking</th>
                                        <th class="text-center"></th>
                                    </tr>
                                </thead>
                                <tbody id="append_docRow">
                                    @{
                                        int rowNo = 0;
                                        if (Model.MEALBOOKING_DTL != null)
                                        {
                                            foreach (var item in Model.MEALBOOKING_DTL)
                                            {
                                                var bgColor = item.RELATION_TYPE.ToUpper() == "SELF" ? "background-color: rgb(245, 222, 179);" : "";
                                                <tr class="row_data" style="@bgColor">
                                                    <td class="text-center">@(rowNo += 1)</td>
                                                    <td>@item.MEMBER_NAME</td>
                                                    <td class="text-center">@item.RELATION_TYPE</td>
                                                    <td class="text-center">
                                                        @if (item.RELATION_TYPE.ToUpper() == "SELF")
                                                        {
                                                            @Html.CheckBox("ChkSelect", new { @checked = "checked", @class = "disableCSS", @style = "width:20px; height:20px;", @onclick = "ChkClick(this);" })
                                                        }
                                                        else
                                                        {
                                                            @Html.CheckBox("ChkSelect", new { @style = "width:20px; height:20px;", @onclick = "ChkClick(this);" })
                                                        }
                                                    </td>
                                                    <td class="text-center"></td>
                                                </tr>
                                            }
                                        }
                                        <tr class="add_row" style="background-color: #c5f7c5 !important;height: 68px;">
                                            <th class="text-right">Add More Member</th>
                                            <td colspan="2">
                                                @Html.TextBox("MEMBERNAME", "", new { @class = "form-control", @id = "txtMemberName", @placeholder = "Enter Member Name" })
                                            </td>
                                            <td class="text-center">
                                                @Html.DropDownList("RELATIONTYPE", new SelectList(ViewBag.TypeList.Items, "Value", "Text"), new { @class = "form-control", @id = "ddlRelationType" })
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-success glyphicon glyphicon-plus" title="Click here to add member" onclick="AddRow(this);"></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                @*Added by Bhupesh NTT*@
                                @{
                                    if (Issitexist == 1)
                                    {
                                        <tr class="add_row">
                                            <td colspan="5">
                                                <br />
                                                <p style="color:#a94442;"><strong> Treavel By Own Transport and Company Transport:</strong></p>
                                            </td>
                                        </tr>
                                        <tr class="add_row">
                                            <td>Transport Type:</td>
                                            <td colspan="1">
                                                <select id="IsTransportType" class="form-control" onchange="toggleVehicleTypeOptions()">
                                                    <option value="0">Select Travel Type</option>
                                                    <option value="1">Own Vehicle</option>
                                                    <option value="2">Company Vehicle</option>
                                                </select>
                                            </td>
                                            <td id="messager" colspan="3"><span id="spn_valid_msg" style="color:#a94442;"></span></td>
                                        </tr>

                                        <tr class="add_row" id="VehicleTypeRow" style="display:none">
                                            <td colspan="1">Vehicle Type:</td>
                                            <td>
                                                <select id="VehicleType" class="form-control">
                                                    <option value="0">Select Vehicle</option>
                                                    <option value="1">Two Wheeler</option>
                                                    <option value="2">Four Wheeler</option>
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                }
                                @*Added by Bhupesh NTT*@
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group text-center">
            <input type="button" id="btnSubmit" class="btn btn-success" value="Submit" onclick="SaveData(this);" />
            <input type="button" value="Reset" class="btn btn-default" onclick="location.href='@Url.Action("FoundationDayBooking", "FoundationDayBooking")'" />
        </div>

        <div class="form-group">
            <div class="col-md-12 bg-info" style="border: 1px solid #61c0ed;border-radius: 0.25em;padding:8px;">
                <span>
                    <a title="Back" href="/FoundationDayBooking/ManageFamilyVisitBooking">
                        <img src="~/assets/images/icon_back.gif" border="0" alt="">
                        Back
                    </a>
                </span>
            </div>
        </div>

    </div>
</div>

<div id="ajaxLoader"></div>

@section Scripts {
    @*<script src="~/assets/js/jquery-ui.js"></script> *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        var arrayBookList = new Array, TotalRowCount = 0, TotalBookCount = 0, _type = 0;
        $(document).ready(function () {

            if ("@ViewBag.BOOKING_ALLOWED" == "0") {
                swal({
                    title: "",
                    text: "Foundation Day booking window closed.",
                    type: "info",
                    showCancelButton: false,
                    confirmButtonClass: "btn-info",
                    confirmButtonText: "OK",
                    cancelButtonText: "No",
                    closeOnConfirm: true,
                    closeOnCancel: true
                },
                function (isConfirm) {
                    if (isConfirm) {
                        window.location.href = "/Home/Home";
                    }
                    else {

                    }
                });
            }
            if ("@ViewBag.BOOKING_ALLOWED" == "2") {
                swal({
                    title: "",
                    text: "Foundation Day booking window not open.",
                    type: "info",
                    showCancelButton: false,
                    confirmButtonClass: "btn-info",
                    confirmButtonText: "OK",
                    cancelButtonText: "No",
                    closeOnConfirm: true,
                    closeOnCancel: true
                },
                function (isConfirm) {
                    if (isConfirm) {
                        window.location.href = "/Home/Home";
                    }
                    else {

                    }
                });
            }
        });

        function datediff(first, second) {
            return Math.round((second - first) / (1000 * 60 * 60 * 24));
        }

        function ChkClick(crnt) {
            var _row = $(crnt).closest("tr")[0];
            if (crnt.checked) {
                //$(_row.cells[3].firstElementChild).removeClass('disableCSS');
                _row.style.backgroundColor = "#f5deb3";
                TotalBookCount += 1;
                //AddRecord(crnt);
            }
            else {
                if (TotalBookCount > 0) {
                    //$(_row.cells[3].firstElementChild).addClass('disableCSS');
                    _row.style.backgroundColor = "";
                    TotalBookCount = TotalBookCount - 1;
                    //DeleteItem(crnt);
                }
            }
        }

        function AddArrayItem() {            
            arrayBookList = new Array;
            var rowLength = $('#tbFamily').find('.row_data').length;
            var rows = $('#tbFamily').find('.row_data');
            for (var i = 0; i < rowLength; i += 1) {
                var row = rows[i];
                if (row != undefined) {
                    //$(row.cells[3].firstElementChild).removeClass('validationError');
                    if ($(row).find('input:checkbox')[0].checked) {
                        //if (row.cells[3].firstElementChild.value == "") {
                        //    sweetAlert("", "Please select meal type.", "warning");
                        //    $(row.cells[3].firstElementChild).addClass('validationError');
                        //    return;
                        //}
                        var data = {
                            MEMBER_NAME: row.cells[1].innerText,
                            RELATION_TYPE: row.cells[2].innerText,
                            MEALTYPEID: 0, //row.cells[3].firstElementChild.value,
                            MEALS_AVAILABILITY_ID: 0 //row.cells[4].firstChild.firstElementChild.value,
                        }
                        arrayBookList.push(data);
                    }
                }
            }
            return arrayBookList;
        }

        function SaveData(current) {
             // #Upgrade Aumento Start :: CR7504
            const whatsappNo = document.getElementById("whatsappno").value.trim();
            const personalEmail = document.getElementById("personalemail").value.trim();

            if (isNaN(whatsappNo) || whatsappNo.trim() === "" || personalEmail === "") {
                sweetAlert("","WhatsApp number and Personal Email Both are mandatory fields. Any one or Both are missing, please enter proper details.", "warning");
                return false;
            }

            if (whatsappNo.length !== 10) {
                sweetAlert("","WhatsApp number must be exactly 10 digits and only numbers.", "warning");
                return false;
            }

            var emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            if (!emailPattern.test(personalEmail)) {
                sweetAlert("", "Please enter a valid email address.", "warning");
                return false;
            }

            if (whatsappNo.length !== 10) {
                sweetAlert("", "WhatsApp number must be exactly 10 digits and only numbers.", "warning");
                return false;
            }
            // #Upgrade Aumento End :: CR7504
            var arrayItem = AddArrayItem();
            if (arrayItem.length == 0) {
                sweetAlert("", "Please select family member before submission.", "warning");
                return;
            }

            var ItemExist = $.grep(arrayBookList, function (e) {
                return e.RELATION_TYPE == "Self";
            });
            if (ItemExist.length == 0) {
                sweetAlert("", "Associate self booking mandatory.", "warning");
                return;
            }
            $("#btnSubmit").attr("disabled", true);
            if (@Issitexist ==1)
            {
                if ($('#IsTransportType').val() == 0)
                {
                    sweetAlert("", "Kindly select Transport Type.", "warning");
                    $("#btnSubmit").attr("disabled", false);
                    return false;
                }
                else  if ($('#VehicleType').val() == 0 && $('#IsTransportType').val() == 1)
                {
                    sweetAlert("", "Kindly select Vehicle Type.", "warning");
                    $("#btnSubmit").attr("disabled", false);
                    return false;
                }
            }
            const bookingDate = $('#txtBookingDate').val(); // "31-07-2025"
            const parsedDate = moment(bookingDate, "DD-MM-YYYY").toDate();
            var data =
                {
                    MEAL_BOOKED_DATE:parsedDate,
                    strBOOKED_DATE: $('#txtBookingDate').val(),
                    MEALBOOKING_DTL: arrayBookList,
                    TRANSPORT_TYPE:@Issitexist==0?'0':$('#IsTransportType').val(),
                    VEHICLE_TYPE:@Issitexist==0?'0': $('#VehicleType').val(),
                    lngbookingid:parseFloat($('#hdnbookingid').val()),
                    WHATSAPPNUMBER: $('#whatsappno').val(),  //  #Upgrade Aumento Added :: CR7504
                    PERSONALEMAIL: $('#personalemail').val() // #Upgrade Aumento Added :: CR7504
                }

            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/FoundationDayBooking/FoundationDayBooking",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {                    
                    if (data.val == 1) {
                        swal({ title: "", text: "Foundation day booking done successfully.", type: "success" },
                        function (isConfirm) {
                            if (isConfirm) {
                                window.location.href = "/FoundationDayBooking/ManageFoundationBooking";
                            }
                        });
                    }
                    else if (data.val == 2) {
                        //sweetAlert("", "Family visit is already booked for " + data.msg + ".", "warning");
                        sweetAlert("", "Foundation Day booking is already done.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data.val == 0 || data.val == -1) {
                        sweetAlert("", "Foundation Day booking not done, Please try again.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function BookingHistory(current) {
            window.location.href = "/FoundationDayBooking/ManageFoundationBooking";
        }

        function AddRow(crnt) {
            var isValid = true;
            $('#txtMemberName').removeClass('validationError');
            if ($('#txtMemberName').val() == '') {
                $('#txtMemberName').addClass('validationError');
                isValid = false;
            }
            $('#ddlRelationType').removeClass('validationError');
            if ($('#ddlRelationType').val() == '' || $('#ddlRelationType').val() == null || $('#ddlRelationType').val() == "null") {
                $('#ddlRelationType').addClass('validationError');
                isValid = false;
            }

            var rows = "", rowId = 0;
            if (isValid) {
                rowId = $('#tbFamily').find('.row_data').length + 1;
                rows += '<tr class="row_data" style="background-color: rgb(245, 222, 179);"><td class="text-center">' + rowId + '</td><td>' + $('#txtMemberName').val() + '</td><td class="text-center">' + $('#ddlRelationType').val() + '</td>';
                rows += '<td class="text-center">@Html.CheckBox("ChkSelect", new { @style = "width:20px; height:20px;", @checked = "checked", @onclick = "ChkClick(this);" })</td><td class="text-center"></td></tr>'
                //rows += '<td class="text-center"></td><td></td><td class="text-center">'+$('#ddlRelationType').val()+'</td></tr>'
                $("#tbFamily #append_docRow tr:last").before(rows);
                TotalBookCount += 1;

                $('#txtMemberName').val('');
                $('#ddlRelationType').val('');
            }
        }
        //Added by Bhupesh NTT
        function toggleVehicleTypeOptions() {
            validationMsg = "";
            const transportType = document.getElementById("IsTransportType").value;
            const vehicleTypeRow = document.getElementById("VehicleTypeRow");
            const MessageTypeRow = document.getElementById("messager");
            if ($('#IsTransportType').val() == 1)
            {
                vehicleTypeRow.style.display = "table-row";
                validationMsg = "";
                $('#spn_valid_msg').text(validationMsg);
            }
            else if ($('#IsTransportType').val() == 2)
            {
                validationMsg = "Will be provided to registered transport users based on transport request or nomination.";
                $('#spn_valid_msg').text(validationMsg);
                vehicleTypeRow.style.display = "none";
            }
            else
            {
                validationMsg = "";
                $('#spn_valid_msg').text(validationMsg);
                vehicleTypeRow.style.display = "none";
            }
        }
    </script>
}
