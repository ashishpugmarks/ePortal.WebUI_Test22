@model IEnumerable<ePortal.ViewModels.FoundationDayBookingTrnViewModel>

@{
    ViewBag.Title = "Foundation Day Booking Status";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var imgSrc1 = "";
}

@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 6px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../assets/images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .card-title {
            margin-bottom: 0.2rem;
            font-weight: 600;
        }

        .card-text {
            font-size: small;
            line-height: normal;
        }
    </style>
}
 



    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                Foundation Day Booking Status
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>List of Booking</strong>
                            <strong class="pull-right">
                                <input type="button" class="btn btn-success btn-xs" onclick="MealReservation(this)" value="Booking" />
                            </strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <table class="table table-bordered table-hover table-responsive" id="tbManageFamilyVisitBooking">
                            <thead>
                                <tr class="bg-info">
                                    <th class="text-center" style="width:7%;">
                                        @Html.DisplayNameFor(model => model.BC_FAMILY_BOOKINGID)
                                    </th>
                                    <th class="text-center" style="width:15%;">
                                        @Html.DisplayNameFor(model => model.MEAL_BOOKED_DATE)
                                    </th>
                                    <th class="text-center" style="width:15%;">
                                        @Html.DisplayNameFor(model => model.ADDEDDATE)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayName("No of Member")
                                    </th>
                                    <th class="text-center" style="width:12%;">
                                        @Html.DisplayNameFor(model => model.MEAL_STATUS)
                                    </th>
                                    <th class="text-center" style="width:12%;">
                                        @Html.DisplayNameFor(model => model.TRANSPORT_TYPE)
                                    </th>
                                    <th class="text-center" style="width:10%;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rowNo = 0; }
                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        var NoOfGuest = item.MEALBOOKING_DTL.Count();
                                        <tr>
                                            <td class="text-center">
                                                @(rowNo += 1)
                                                @Html.HiddenFor(modelItem => item.BC_FAMILY_BOOKINGID)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.MEAL_BOOKED_DATE)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.ADDEDDATE)
                                            </td>
                                            <td class="text-center">
                                                @NoOfGuest
                                            </td>
                                            <td class="text-center">
                                                @if (item.MEAL_STATUS == 1)
                                                {
                                                    <button class="btn btn-success btn-xs" style="cursor: text !important">Booked</button>
                                                }
                                                else if (item.MEAL_STATUS == 2)
                                                {
                                                    <button class="btn btn-danger btn-xs" style="cursor: text !important">Cancelled</button>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (item.TRANSPORT_TYPE == 1)
                                                {
                                                    <button class="btn btn-success btn-xs" style="cursor: text !important">Own Vehicle</button>
                                                }
                                                else if (item.TRANSPORT_TYPE == 2)
                                                {
                                                    <button class="btn btn-danger btn-xs" style="cursor: text !important">Company Vehicle</button>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-info btn-xs glyphicon glyphicon-tasks" title="Click here to view detail" onclick="ViewDetail(@item.BC_FAMILY_BOOKINGID);"></button>
                                                @if (item.MEAL_STATUS == 1 && item.IsEnableCancel)
                                                {
                                                    <button class="btn btn-danger btn-xs glyphicon glyphicon-remove" title="Click here to cancel" onclick="CancelBooking(@item.BC_FAMILY_BOOKINGID);"></button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-12 bg-info" style="border: 1px solid #61c0ed;border-radius: 0.25em;padding:8px;">
                    <span>
                        <a title="Back" href="/Home/Home">
                            <img src="~/assets/images/icon_back.gif" border="0" alt="">
                            Back
                        </a>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div id="ajaxLoader"></div>

@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $("#tbManageFamilyVisitBooking").dataTable({
                "bFilter": true,
                "bLengthChange": true
            });

            $('.datepic').datepicker({
                format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top',

            });

            @*$("#ddlMealType").val('@ViewBag.mealType');
            $("#txtBookingFrom").val('@ViewBag.strFromDate');
            $("#txtBookingTo").val('@ViewBag.strToDate');*@

        });

        function ViewDetail(id) {
            window.location.href = "/FoundationDayBooking/FoundationBookingDetail?id=" + id;
        }

        function GetRecord(current) {
            if ($("#ddlMealType").val() != "") {
                $('#hfMealTypeId').val($("#ddlMealType").val());
            }
            if ($("#txtBookingFrom").val() != "") {
                $('#hfFromDate').val($("#txtBookingFrom").val());
            }
            if ($("#txtBookingTo").val() != "") {
                $('#hfToDate').val($("#txtBookingTo").val());
            }
            $('#_form').submit();
        }

        function CancelBooking(row_id) {
            swal({
                title: "Do you want to cancel the booking ?",
                text: "Rebooking will be done as per availability.",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, cancel it!",
                cancelButtonText: "No",
                closeOnConfirm: false,
                closeOnCancel: true
            },
            function (isConfirm) {
                if (isConfirm) {
                    var Fdata = {
                id:parseFloat(row_id),
            }

                    $.ajax({
                             type: "POST",
                             url: "/FoundationDayBooking/CancelFoundationDayBooking",
                             data: { id: row_id }, // Send as form data
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        success: function (data) {
                            if (data == 1) {
                                swal({
                                    title: "",
                                    text: "Booking cancelled successfully.",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                        window.location.href = "/FoundationDayBooking/ManageFoundationBooking";
                                    }
                                });
                            }
                            else {
                                sweetAlert("", "Booking not cancelled, Please try again.", "warning");
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }
            });
        }

        function MealReservation(current) {
            window.location.href = "/FoundationDayBooking/FoundationDayBooking";
        }
    </script>
}
