@model ePortal.ViewModels.SearchIndentUser
@{
    ViewBag.Title = "PRReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .form-control {
            height: 28px;
            padding: 3px 3px;
            font-size: 13px;
        }
    </style>
}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">
            PR Dashboard (Request Related with IP)
        </div>
    </div>

    <div class="body-content" style="overflow-x:auto!important;">
        <div class="panel-group">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title">
                        <strong>Search</strong>
                    </h2>
                </div>
                <div class="panel-body" style="padding:5px;">
                    <div class="row" style="padding:4px;">
                        @Html.LabelFor(model => model.kicode, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-xs-8 col-sm-2 col-md-2 col-lg-2" style="width:20.66%;">
                            @*@Html.DropDownListFor(model => model.kicode, new SelectList(ViewBag.KICodeList.Items, "SYKIID", "KICODE"), new { @id = "ddlkicode", @onchange = "BindOperation(this, 1);", @class = "form-control" })*@
                            @Html.DropDownListFor(model => model.kicode, new SelectList(ViewBag.KICodeList.Items, "SYKIID", "KICODE"), new { @id = "ddlkicode", @class = "form-control" })
                        </div>
                        @Html.LabelFor(model => model.ecode, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-2 col-lg-2">
                            @Html.TextBoxFor(model => model.ecode, new { @type = "number", @value = "", @id = "txtEmpCode", @class = "form-control", @style = "width: 110px;" })
                        </div>
                        @Html.LabelFor(model => model.PRStatus, new { @class = "control-label text-right col-md-2", @style = "width: 183px;margin-top: 7px;" })
                        <div class="col-md-1 col-lg-1" style="width:20.66%;">
                            @Html.DropDownListFor(model => model.PRStatus, new List<SelectListItem>
                            {
                                new SelectListItem { Text = "-- ALL --", Value = "-1" },
                                                        new SelectListItem { Text = "PR Pending", Value = "1" },
                                                        new SelectListItem { Text = "PO Creation Pending", Value = "3" },
                                                        new SelectListItem { Text = "PO Approval WIP", Value = "5" },
                                                        new SelectListItem { Text = "PO Approval Done", Value = "7" },
                                                        }, new { @class = "form-control", @id = "ddlPrStatus" })
                        </div>

                    </div>
                    <div class="row" style="padding:4px;">
                        @* @Html.Label("Request Date", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" }) *@
                        @Html.Label("Request Date", "Request Date", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-1 col-lg-1">
                            <input id="txtStartdate" class="form-control datepic" style="width: 100px;" name="Startdate" type="text" value="" readonly="readonly" placeholder="From Date" />
                        </div>
                        @*@Html.LabelFor(model => model.ENDDATE, new { @class = "control-label text-right col-md-1", @style = "width: 190px;margin-top: 7px;" })*@
                        <div class="col-lg-1 col-md-1" style="margin-left: 10px;">
                            <input id="txtENDDATE" class="form-control datepic" style="width: 100px;" name="ENDDATE" type="text" value="" readonly="readonly" placeholder="To Date" />
                        </div>
                        @*------------SR52365---------------------------------------------------*@
                        @Html.LabelFor(model => model.IndentNo, new { @class = "control-label text-right col-md-1", @style = "width:140px;margin-top: 7px;" })
                        <div class="col-md-2 col-lg-2" style="width:20.66%;">
                            @Html.TextBoxFor(model => model.IndentNo, new { @value = "", @id = "txtIndentNo", @class = "form-control", @style = "width: 150px;" })
                        </div>
                        @*---------------------------------------End Changes------------------------------------------------*@
                        @* @Html.Label("Remark", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" }) *@
                        @Html.Label("Remark", "Remark", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-1 col-lg-1">
                            <input id="txtremark" class="form-control" style="width: 300px;" name="txtremark" type="text" value="" placeholder="Enter Remark" />
                        </div>
                    </div>
                    <div class="row" style="padding:2px;">
                        <div class="col-md-12 col-lg-12 text-center">
                            @*<button id="btnSubmit" onclick="GetReportList(this); return false" class="btn btn-success btn-sm">Search</button>*@
                            <button id="btnSubmit" class="btn btn-success btn-sm">Search</button>
                            @*<input type="button" value="Reset" class="btn btn-default btn-sm" onclick="location.href='@Url.Action("PRPIUserReport", "PR")'" />*@
                            <input type="button" value="Reset" class="btn btn-default btn-sm" data-ctrl="report-btn" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="ajaxLoader"></div>
        <div id="div_append"></div>
    </div>
</div>
<div id="myCreateModel" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="padding:10px!important;">
                <div class="pull-left">
                    <h5 class="modal-title"><span id="sp_type"></span></h5>
                </div>
                <div class="pull-right">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
            <div class="modal-body" style="padding:10px!important;">
                <div id="myCreateModelContent"></div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $('.datepic').datepicker({
                format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top'
            });

           // $("#btnSubmit").click();
        });

        function GetReportList(crnt) {
            var data = {
                IndentNo: $('#txtIndentNo').val(),
                ecode: $('#txtEmpCode').val() == "" ? 0 : $('#txtEmpCode').val(),
                Startdate: new Date($('#txtStartdate').val() + " 12:00:00"),
                ENDDATE: new Date($('#txtENDDATE').val() + " 12:00:00"),
                PRStatus: $('#ddlPrStatus').val(),
                ITEM_DETAIL: $('#txtremark').val()
                }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/PR/PRPIUserReport",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#div_append').html(data);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function GetExcel(crnt) {
            var data = {
                IndentNo: $('#txtIndentNo').val(),
                ecode: $('#txtEmpCode').val() == "" ? 0 : $('#txtEmpCode').val(),
                Startdate: $('#txtStartdate').val(),
                ENDDATE: $('#txtENDDATE').val(),
                PRStatus: $('#ddlPrStatus').val(),
                ITEM_DETAIL: $('#txtremark').val()
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/PR/ExportToExcelUser",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "PR", Action = "DownloadExcelUser" })";
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
    </script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {

            // Submit button event handler
            $('#btnSubmit').on('click', function () {
                GetReportList($(this)[0]);
                return false;
            });

            // Reset button event handler
            $('[data-ctrl="report-btn"]').on('click', function () {
                window.location.href = '@Url.Action("PRPIUserReport", "PR")';
            });

            // Dropdown change event handler
            $('#ddlkicode').on('change', function () {
                BindOperation($(this)[0], 1);
            });

        });
    </script>

}
