        /* Changed by TTL on 21-May-2025 against SR99119 > CR6335 - Start */
        function onChangechkLayout(isNewLayout) {
            SetPRLayoutData(isNewLayout);
            EnablePRLayout(isNewLayout);
        }

        function DefaultLoadPRLayout() {
            var checkbox = $('#chkLayout');
            var isNewLayout = GetPRNewLayoutData();

            if (isNewLayout === false) {
                checkbox.prop('checked', true);
            }
            EnablePRLayout(isNewLayout);
        }

        function EnablePRLayout(isNewLayout) {
            if (isNewLayout) {
                $('#new_layout').css('display', 'contents');
                $('#old_layout').css('display', 'none');
                $('#toggleLabelText').text('Switch to classic view');
            } else {
                $('#new_layout').css('display', 'none');
                $('#old_layout').css('display', 'contents');
                $('#toggleLabelText').text('Switch to classic view');
            }
            GetPDF($("#poPDF"));
        }

        function SetPRLayoutData(isNewLayout) {
            var loginUser = document.getElementById("h_adempcode").value;
            var data = {
                'ADEMPCODE': loginUser,
                'IsNewLayout': isNewLayout
            };
            localStorage.setItem("PRLayout", JSON.stringify(data));
        }

        function GetPRNewLayoutData() {

            let isNewLayout = true;

            var loginUser = document.getElementById("h_adempcode").value;
            var jsonData = localStorage.getItem("PRLayout");
            if (jsonData) {
                var data = JSON.parse(jsonData);

                if (data.ADEMPCODE === loginUser) {
                    isNewLayout = data.IsNewLayout;
                } else {

                    //isNewLayout = false;
                    isNewLayout = true;
                }

            }
            return isNewLayout;
        }

        /* Changed by TTL on 21-May-2025 against SR99119 > CR6335 - End */
