        function UpdateCategory(){
            var isVailed = true;
            $('#ddlCategory').removeClass('validationError');
            if ($('#ddlCategory').val() == "") {
                $('#ddlCategory').addClass('validationError');
                isVailed = false;
                $("#validationMsg").text("Please select category");
            }

            if(isVailed){
                var row_id = $("#hfCatPRHId").val();
                var ddCat = $("#ddlCategory").val();
                $('#categoryModel').modal('hide');
                $.ajax({
                    type: "POST",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    url: "/PR/ChangeCategory",
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    data: JSON.stringify({ id: row_id, selectedCategory: ddCat }),
                    success: function (data) {
                        if (data == 1) {
                            swal({
                                title: "",
                                text: "Category changed successfully.",
                                type: "success",
                            }, function (isConfirm) {
                                if (isConfirm) {
                                    var _row = $("#tbRequestReport tbody").find("#tr_" + row_id);
                                    $(_row).addClass('row-highlight');
                                    $(_row).attr('title', 'You have already taken action on this row.');

                                    $(_row).find("button").attr('disabled', 'disabled');
                                    $(_row).find("button").attr('title', 'You have already taken action on this row.');
                                    //$("#btnSubmit").click();
                                }
                            });
                        }
                        else {
                            sweetAlert("", "Category not changed.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

