        };

        function GetDashboardData(crnt) {
            var data = {
                OperationID: $('#ddlOp').val() == "" ? 0 : $('#ddlOp').val(),
                DivisionID: $('#ddlDiv').val() == "" ? 0 : $('#ddlDiv').val(),
                DEPTID: $('#ddlDep').val() == "" ? 0 : $('#ddlDep').val(),
                SECID: $('#ddlSec').val() == "" ? 0 : $('#ddlSec').val(),
                IndentNo: $('#txtIndentNo').val(),
                ecode: $('#txtEmpCode').val() == "" ? 0 : $('#txtEmpCode').val(),
                Startdate: new Date($('#txtStartdate').val()),
                ENDDATE: new Date($('#txtENDDATE').val()),
                PRStatus: $('#ddlPrStatus').val(),
                PlantID: $('#ddlPlant').val() == "" ? 0  : $('#ddlPlant').val(),
                CATID: @_cat,
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/PR/PRAllocationDashboard",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#div_append').html(data);
                        if ('@ViewBag.ISAUTHORISED_USER' == '0') {
                            $(".td_action").addClass('hidden');
                        }
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function (error) {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function GetExcel(crnt) {
            var data = {
                OperationID: $('#ddlOp').val() == "" ? 0 : $('#ddlOp').val(),
                DivisionID: $('#ddlDiv').val() == "" ? 0 : $('#ddlDiv').val(),
                DEPTID: $('#ddlDep').val() == "" ? 0 : $('#ddlDep').val(),
                SECID: $('#ddlSec').val() == "" ? 0 : $('#ddlSec').val(),
                IndentNo: $('#txtIndentNo').val(),
                ecode: $('#txtEmpCode').val() == "" ? 0 : $('#txtEmpCode').val(),
                Startdate: new Date($('#txtStartdate').val()),
                ENDDATE: new Date($('#txtENDDATE').val()),
                PRStatus: $('#ddlPrStatus').val(),
                PlantID: $('#ddlPlant').val() == "" ? 0  : $('#ddlPlant').val(),
                CATID: @_cat,
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/PR/PRAllocationExportToExcel",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "PR", Action = "PRAllocationDownloadExcel" })";
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function AssignBuyer(row_id) {
            $.ajax({
                type: "GET",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/PR/AssignBuyer",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                data: { id: row_id, GPType: '@ViewBag.GP_TYPE', OrgLvlId: $("#ddlOp").val() },
                success: function (data) {
