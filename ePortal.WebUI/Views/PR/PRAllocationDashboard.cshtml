        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .form-control {
            height: 28px;
            padding: 3px 3px;
            font-size: 13px;
        }

        .row-highlight {
            background-color: lightgray !important;
        }

        .validationError {
            border: 1px solid #a94442;
        }
    </style>
}

