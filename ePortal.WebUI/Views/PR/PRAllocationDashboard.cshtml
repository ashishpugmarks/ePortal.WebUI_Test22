        ////======== Bind Division========////
        function BindDivision(crnt, call) {
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            /// --- Clear Dropdown --- ///
            var depSelect = $("#ddlDep");
            depSelect.empty();
            depSelect.append($('<option/>', {
                value: 0,
                text: "--No record--"
            }));

            var secSelect = $("#ddlSec");
            secSelect.empty();
            secSelect.append($('<option/>', {
                value: 0,
                text: "--No record--"
            }));

            $.getJSON("/PR/BindDivisionByOperationId", { id: dID },
                   function (data) {
                       var select = $("#ddlDiv");
                       select.empty();
                       if (data.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.Value,
                               text: itemData.Text
                           }));
                       });
                       if ('@Model.DivisionID' != '' && call == 1) {
                           $("#ddlDiv").val('@Model.DivisionID');
                       }
                   });
        }

        ////======== Bind Department========////
        function BindDepartment(crnt, call) {
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
