@section Scripts {
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    var current_fs, next_fs, previous_fs; //fieldsets
    var left, opacity, scale; //fieldset properties which we will animate
    var animating; //flag to prevent quick multi-click glitches
    var arrayList = new Array, attachmentArray = new Array, mappingArray = new Array, strPRno = [], TotalRowCount = 0, IsUploadAttachment = false;
    $('.homeContent').removeClass('homeContent');

    $(document).ready(function () {

        $('.dpDate').datepicker({
            format: "dd-M-yyyy",
            todayHighlight: true,
            autoclose: true,
            // toolbarplacement: 'top'
        });

        //----- Bind Authority grid -----//
        BindData(arrayList);

        $('input[type=number]').keyup(function () {
            this.value = this.value.replace(/[^0-9\.]/g, '');
        });

        $(".next").click(function () {
            var isFormVaildation = CheckFormValidation();
            if (!isFormVaildation) {
                $('#div_valid_msg').removeClass('hidden');
                return;
            }

            if (animating) return false;
            animating = true;
            current_fs = $(this).parent();
            next_fs = $(this).parent().next();

            //activate next step on progressbar using the index of next_fs
            $("#progressbar li").eq($("fieldset").index(next_fs)).addClass("active");
            //show the next fieldset
            next_fs.show();
            //hide the current fieldset with style
            current_fs.animate({ opacity: 0 }, {
                step: function (now, mx) {
                    //as the opacity of current_fs reduces to 0 - stored in "now"
                    //1. scale current_fs down to 80%
                    scale = 1 - (1 - now) * 0.2;
                    //2. bring next_fs from the right(50%)
                    left = (now * 50) + "%";
                    //3. increase opacity of next_fs to 1 as it moves in
                    opacity = 1 - now;
                    current_fs.css({
                        'transform': 'scale(' + scale + ')',
                        'position': 'absolute'
                    });
                    next_fs.css({ 'left': left, 'opacity': opacity });
                },
                duration: 300,
                complete: function () {
                    current_fs.hide();
                    animating = false;
                },
            });
        });

        //SIS PR Change - Start
        //$("#chkITServiceMatSISAppStatus").click(function(){
        //    if($('#chkITServiceMatSISAppStatus')[0].checked == true)
        //    {
        //        $('#chkNonITServiceMatDeclaration')[0].checked = false;
        //        $('#chkNonITServiceMatDeclaration').attr('disabled', true);
        //    }
        //    else
        //    {
        //        $('#chkNonITServiceMatDeclaration').attr('disabled', false);
        //    }
        //});

        //$("#chkNonITServiceMatDeclaration").click(function(){
        //    if($('#chkNonITServiceMatDeclaration')[0].checked == true)
        //    {
        //        $('#chkITServiceMatSISAppStatus')[0].checked = false;
        //        $('#chkITServiceMatSISAppStatus').attr('disabled', true);
        //    }
        //    else
        //    {
        //        $('#chkITServiceMatSISAppStatus').attr('disabled', false);
        //    }
        //});
        //SIS PR Change - End

        $(".previous").click(function () {
            if (animating) return false;
            animating = true;

            current_fs = $(this).parent();
            previous_fs = $(this).parent().prev();

            //de-activate current step on progressbar
            $("#progressbar li").eq($("fieldset").index(current_fs)).removeClass("active");

            //show the previous fieldset
            previous_fs.show();
            //hide the current fieldset with style
            current_fs.animate({ opacity: 0 }, {
                step: function (now, mx) {
                    //as the opacity of current_fs reduces to 0 - stored in "now"
                    //1. scale previous_fs from 80% to 100%
                    scale = 0.8 + (1 - now) * 0.2;
                    //2. take current_fs to the right(50%) - from 0%
                    left = ((1 - now) * 50) + "%";
                    //3. increase opacity of previous_fs to 1 as it moves in
                    opacity = 1 - now;
                    current_fs.css({ 'left': left });
                    previous_fs.css({ 'transform': 'scale(' + scale + ')', 'position': 'relative', 'opacity': opacity });
                },
                duration: 300,
                complete: function () {
                    current_fs.hide();
                    animating = false;
                },
                //this comes from the custom easing plugin
                ////easing: 'easeInOutBack'
            });
        });

    });

    function nextBtnClick() {
        var isFormVaildation = CheckFormValidation();
        if (!isFormVaildation) {
            $('#div_valid_msg').removeClass('hidden');
            return;
        }

        var data = {
            PRHEADERID: $("#hfPrHeaderId").val() == "" ? 0 :  $("#hfPrHeaderId").val(),
            IndentNo: $("#txtINo").val(),
            IndentDate: new Date($("#txtIndentDate").val()),
            IndentAmount: $("#txtIAmount").val(),
            ItemDetail: $("#txtItemDetail").val(),
            PRTYPE: $("#ddPRType").val(),
            CATID: $("#ddCategory").val(),
            ARIBARFPID: $("#txtAribaID").val(),
            //Added by aumento for the SR73841============
            ARIBASRNO: $("#txtAribaSRNo").val(),
            //============================================
            ARIBASTATUS: $("#ddARIBASTATUS").val(),
            ARIBABuyer_ECODE: $("#ddBuyer").val() == "" ? 0 : $("#ddBuyer").val(),
            REMARK: "",
            STATUS: 1,
            PROCESS_STATUS: 0,
            IsFinalSubmit: 0,
            ITServiceMatSISAppStatus: $('#chkITServiceMatSISAppStatus')[0].checked, //SIS PR Change
            NonITServiceMatDeclaration: $('#chkNonITServiceMatDeclaration')[0].checked, //SIS PR Change
            IPServiceMatDeclaration: $('#chkIPServiceMatSISAppStatus')[0].checked,
            PR_ReleaseLocation : $('#ddPR_ReleaseLocation').val(), // Added by Aumento ::  SR68003
            SLA_Category : $('#ddPR_Category').val() // Added by ttl ::  SR108972 > CR7273
        }
        $.ajax({
            type: "POST",
            url: "/PR/SavePRDetail",
            beforeSend: function () {
                $("#ajaxLoader").addClass('loader');
            },
            data: JSON.stringify(data),
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            success: function (data) {
                if (data.res == 1 && data.poId > 0) {
                    $("#hfPrHeaderId").val(data.poId);
                    arrayList = data.SEQ_LIST;
                    BindData(arrayList);
                    $(".next").click();
                }
                else if (data.res == 2) {
                    sweetAlert("", "PR detail already exist.", "warning");
                    $("#txtPRFile").val('');
                }
                else if (data.res == 3) {
                    sweetAlert("", "PR attachement is invalid.Please refer user manual for extracting PR pdf from SAP.", "warning");
                    $("#txtPRFile").val('');
                }
                else if (data.res == 4) {
                    sweetAlert("", "PO already created, so you can not raise request.", "warning");
                    $("#txtPRFile").val('');
                }
                else if (data.res == 5) {
                    sweetAlert("", "This Indent Number pending at Buyer, so you can not raise request.", "warning");
                    $("#txtPRFile").val('');
                }
                else {
                    sweetAlert("", "PR detail not saved.", "warning");
                    $("#txtPRFile").val('');
                }
            },
            complete: function () {
                $("#ajaxLoader").removeClass('loader');
            },
            error: function () {
                sweetAlert("Oops...", "Something went wrong!", "error");
                $("#txtPRFile").val('');
            }
        });
    }

    function readBackupFile(input) {
        var _URL = window.URL || window.webkitURL;
        var file = input.files[0];
        var image = new Image();
        image.src = _URL.createObjectURL(file);
        var extension = $(input).val().split('.').pop().toLowerCase();
        var validFileExtensions = ['pdf'];
        if ($.inArray(extension, validFileExtensions) == -1) {
            var _msg = "Sorry! Upload only 'pdf' file";
            sweetAlert(" ", _msg, "warning");
            $(input).replaceWith($(input).val('').clone(true));
        }
        if (file.size > (5e+6)) {
            sweetAlert(" ", "Sorry! Max allowed file size is 5 mb", "warning");
            $(input).replaceWith($(input).val('').clone(true));
            return;
        }
        else {
            IsUploadAttachment = false;
        }
    }

    function CheckAttachmentsValidation() {
        var isVailed = true;
        $('#txtFile').removeClass('validationError');
        if ($('#txtFile').val() == "") {
            $('#txtFile').addClass('validationError');
            isVailed = false;
        }

        $("#ddDocType").removeClass('validationError');
        if ($('#ddDocType').val() == "") {
            $("#ddDocType").addClass('validationError');
            isVailed = false;
        }
        return isVailed;
    }

    function UploadPRAttachment(input) {
        var _URL = window.URL || window.webkitURL;
        var file = input.files[0];
        var image = new Image();
        image.src = _URL.createObjectURL(file);
        var extension = $(input).val().split('.').pop().toLowerCase();
        var validFileExtensions = ['pdf'];
        if ($.inArray(extension, validFileExtensions) == -1) {
            var _msg = "Sorry! Upload only 'pdf' file";
            sweetAlert(" ", _msg, "warning");
            $(input).replaceWith($(input).val('').clone(true));
            return;
        }
        if (file.size > (5e+6)) {
            sweetAlert(" ", "Sorry! Max allowed file size is 5 mb", "warning");
            $(input).replaceWith($(input).val('').clone(true));
            return;
        }
        var formData = new FormData();
        formData.append("FILE", document.getElementById("txtPRFile").files[0]);
        formData.append("DOC_TYPE", "PR");
        formData.append("PRNo", $("#txtINo").val());
        $.ajax({
            type: "POST",
            url: "/PR/UploadPR",
            data: formData,
            datatype: "json",
            contentType: false,
            processData: false,
            success: function (data) {
                if (data.res == 1) {
                    alert("PR Attachment uploaded successfully.");
                    //$("#spn_valid_msg").text('PO Attachment uploaded successfully. ');
                    //$("#div_valid_msg").css('color', 'green').show().delay(5000).fadeOut();
                }
                else if (data.res == 0 || data.res == -1) {
                    alert("PR Attachment not uploaded, Please try again.");
                    //$("#spn_valid_msg").text('PO Attachment not uploaded, Please try again. ');
                    //$("#div_valid_msg").css('color', '#a94442').show().delay(5000).fadeOut();
                    $("#txtPRFile").val('');
                }
            },
            error: function (e) {
                debugger
                alert("Oops... Something went wrong!." + e.message);
                //$("#spn_valid_msg").text('Oops... Something went wrong!. ');
                //$("#div_valid_msg").css('color', '#a94442').show().delay(5000).fadeOut();
                $("#txtPRFile").val('');
            }
        });
    }

    function UploadAttachment() {
        var IsAttachmentsValidation = CheckAttachmentsValidation();
        if (!IsAttachmentsValidation) {
            return;
        }
        $("#btnUpload").attr("disabled", true);
        var formData = new FormData();
        formData.append("FILE", document.getElementById("txtFile").files[0]);
        formData.append("DOC_TYPE", $("#ddDocType").val());
        formData.append("ADDITIONAL_INFO", $("#txtAddInfo").val());
        formData.append("PRNo", $("#txtINo").val());
        formData.append("PRHEADERID", $("#hfPrHeaderId").val());
        $.ajax({
            type: "POST",
            url: "/PR/UploadAttachment",
            data: formData,
            datatype: "json",
            contentType: false,
            processData: false,
            success: function (data) {
                if (data.res == 1) {
                    attachmentArray = data.attachmentList;
                    if (attachmentArray != null) {
                        if (attachmentArray.length > 0) {
                            BindDocument(attachmentArray);
                        }
                        $("#span-attachmentMsg").text('Attachment uploaded successfully. ').css('color', 'green').show().delay(5000).fadeOut();
                        IsUploadAttachment = true;
                        $("#txtFile").val('');
                        $("#ddDocType").val('');
                        $("#txtAddInfo").val('');
                    }
                }
                else if (data.res == 0 || data.res == -1) {
                    $("#span-attachmentMsg").text('Attachment not uploaded, Please try again. ').css('color', '#a94442').show().delay(5000).fadeOut();
                }
                $("#btnUpload").attr("disabled", false);
            },
            error: function () {
                $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                $("#btnUpload").attr("disabled", false);
            }
        });
    }
    function ARIBASTATUSChange(crnt) {
        if (crnt.value == "1") {

            $("#txtAribaID").attr("readonly", false);
            //$("#ddBuyer").attr("readonly", false); //Commented By Aumento :: SR80255
            $("#ddBuyer").prop("disabled", false); //Added By Aumento :: SR80255
            //Added by aumento for the SR73841============
            $("#txtAribaSRNo").attr("readonly", false);
