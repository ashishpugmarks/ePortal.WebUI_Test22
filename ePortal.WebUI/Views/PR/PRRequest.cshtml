    function BindDocument(attList) {
        var rows = "", rowId = 0;
        if (attList != null) {
            if (attList.length > 0) {
                $.each(attList, function (i, item) {
                    rowId = i + 1;
                    var additionalInfo = item.ADDITIONAL_INFO == null ? "" : item.ADDITIONAL_INFO;
                    rows += "<tr class='tr_doc'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.DOC_TYPE + "</td>"
                    rows += "<td class='text-left'><a style='cursor: pointer;' data-ctrl='getpdf-btn' data-id='" + item.FILENAME + "'>" + item.FILENAME + "</a></td>"
                    rows += "<td class='text-center' style='color:#a94442'>Not Verified</td><td class='text-left'>" + additionalInfo + "</td>"
                    rows += "<td class='text-center'><a data-name='" + item.FILENAME + "' data-type='" + item.DOC_TYPE + "' data-id='" + item.PRHEADERID + "' style='cursor: pointer;' data-ctrl='deletedoc-btn' >Delete</a></td>"
                    rows += "</tr>"
                });
                document.getElementById("append_docRow").innerHTML = rows;

                //CSP 3.0 Compliant changes
                $("[data-ctrl='getpdf-btn']").on('click', function () {
                    GetPDF($(this)[0]);
                });

                $("[data-ctrl='deletedoc-btn']").on('click', function () {
                    DeleteDoc($(this)[0]);
                });


            }
            else {
                var _row = "<tr><th colspan='6' class='text-center'>No record found.</th></tr>"
                document.getElementById("append_docRow").innerHTML = _row;
            }
        }
    }

    function GetPDF(current) {
        var _pdfName = $(current).attr('data-id');
        $(current).parent().next()[0].textContent = "verified";
        $(current).parent().next().css("color", "green");
        if (_pdfName != "") {
            $.ajax({
                type: "GET",
                url: "/PR/GetPDF",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: { fileName: _pdfName },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.FILEPATH != "") {
                        document.getElementById("myCreateModelContent").innerHTML = data.FILEPATH;
                        $('#myCreateModel').modal({ backdrop: "static" });
                    }
                    else {
                        sweetAlert("", "File not found.", "warning");
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
    }

    function DeleteDoc(crnt) {
        var fileName = $(crnt).attr('data-name');
        var docType = $(crnt).attr('data-type');
        var prHeaderId = $(crnt).attr('data-id');
        $.ajax({
            type: "Delete",
            url: "/PR/DeleteAttachment",
            beforeSend: function () {
                $("#ajaxLoader").addClass('loader');
            },
            data: JSON.stringify({ fileName: fileName, docType: docType, prHeaderId: prHeaderId }),
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            success: function (data) {
                if (data.res == 1) {
                    attachmentArray = data.attachmentList;
                    sweetAlert("", "Document deleted successfully.", "success");
                }
                else {
                    sweetAlert("", "Document not deleted, Please try again.", "warning");
                }
            },
            complete: function () {
                BindDocument(attachmentArray);
                $("#ajaxLoader").removeClass('loader');
            },
            error: function () {
                sweetAlert("Oops...", "Something went wrong!", "error");
            }
        });
    }

    function AddAuthority() {
        $('#spn_auth_msg').text('');
        $('#ddDesignation').removeClass('validationError');
        if ($('#ddDesignation').val() == "") {
            $('#ddDesignation').addClass('validationError');
            $('#spn_auth_msg').text('Please select designation.');
            return;
        }
        $('#txtEmpcode').removeClass('validationError');
        if ($('#txtEmpcode').val() == "") {
            $('#txtEmpcode').addClass('validationError');
            $('#spn_auth_msg').text('Please enter employee code.');
            return;
        }
        if (arrayList.length > 0) {
            var itemArray = $.grep(arrayList, function (e) {
                return e.ADEMPCODE == $('#txtEmpcode').val();
            });
            if (itemArray.length > 0) {
                $('#txtEmpcode').addClass('validationError');
                $('#spn_auth_msg').text('This approval authority already added.');
                return;
            }

            var itemArray2 = $.grep(arrayList, function (e) {
                return e.APP_SEQ == $('#ddDesignation').val();
            });
            if (itemArray2.length > 0) {
                $('#ddDesignation').addClass('validationError');
                $('#spn_auth_msg').text('This designation already added.');
                return;
            }
        }
        $.ajax({
            type: "GET",
            url: "/PR/GetAppAuthority",
            beforeSend: function () {
                $("#ajaxLoader").addClass('loader');
            },
            data: { eCode: $('#txtEmpcode').val(), designationId: $("#ddDesignation").val(), designation: $('#ddDesignation option:selected').text() },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            success: function (data) {
                //if(data.FNDESID == 2 || data.FNDESID == 3){
                if (data.ECODE > 0 && data.ENAME != "") {
                    //AddRecord(data);
                    arrayList = data.SEQ_LIST;
                    $('#txtEmpcode').val('');
                    $("#ddDesignation").val('');
                }
                else {
                    $('#spn_auth_msg').text('Record not found.');
                }
                //}
                //else{
                //    $('#spn_auth_msg').text('Only add Dept. Mgr and Div. Head authority.');
                //}
            },
            complete: function () {
                BindData(arrayList);
                $("#ajaxLoader").removeClass('loader');
            },
            error: function () {
                sweetAlert("Oops...", "Something went wrong!", "error");
            }
        });
    }

