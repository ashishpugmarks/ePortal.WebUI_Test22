    function submitForm() {
        $('#txtEmpcode').removeClass('validationError');
        var isFormVaildation = CheckFormValidation();
        //SIS PR Change
        if ($('#chkITServiceMatSISAppStatus')[0].checked == false && $('#chkNonITServiceMatDeclaration')[0].checked == false) {
            sweetAlert("", "Please accept declaration", "warning");
            return;
        }
        var IPDocuemntrequired = $('#chkIPServiceMatSISAppStatus')[0].checked;
        var IPDocCount = 0;
        if (isFormVaildation) {
            var docTr = $("#append_docRow .tr_doc");
            if (docTr.length > 0) {
                for (var i = 0; i < docTr.length; i += 1) {
                    var row = docTr[i];
                    if (row != undefined) {
                        var varificationText = row.cells[3].innerHTML.trim();
                        var documentType = row.cells[1].innerHTML.trim();
                        if (varificationText == "Not Verified") {
                            sweetAlert("", "Document not verified. Please open all document & verified", "warning");
                            return;
                        }
                        if (documentType == "IPCHECKLIST") { IPDocCount = 1; }
                    }
                }
            }
            else {
                sweetAlert("", "Please upload documents.", "warning");
                return;
            }
            if (IPDocuemntrequired && IPDocCount == 0) {
                sweetAlert("", "Please upload IP Checklist documents.", "warning");
                return;
            }

            if (arrayList == null || arrayList.length == 0) {
                $('#txtEmpcode').addClass('validationError');
                sweetAlert("", "Please add approval authority.", "warning");
                return;
            }
            else {
                $("#btnSave").attr("disabled", true);
                var data = {
                    PRHEADERID: $("#hfPrHeaderId").val(),
                    REMARK: $("#txtRemark").val(),
                    STATUS: 1,
                    PROCESS_STATUS: 1,
                    IsFinalSubmit: 1,
                    prAuthSeq: arrayList,
                    ITServiceMatSISAppStatus: $('#chkITServiceMatSISAppStatus')[0].checked, //SIS PR Change
                    NonITServiceMatDeclaration: $('#chkNonITServiceMatDeclaration')[0].checked, //SIS PR Change
                    IPServiceMatDeclaration: $('#chkIPServiceMatSISAppStatus')[0].checked
                }
                $.ajax({
                    type: "POST",
                    url: "/PR/PRRequest",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: JSON.stringify(data),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data == 1) {
                            swal({
                                title: "",
                                text: "Record saved successfully.",
                                type: "success",
                            }, function (isConfirm) {
                                if (isConfirm) {
                                    //window.location.href = "/ASPXView/ManageRequest.aspx";
                                      window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                                }
                            });
                        }
                        else if (data == 2) {
                            sweetAlert("", "This PR request already processed.", "warning");
                            $("#btnSave").attr("disabled", false);
                        }
                        else if (data == 3) {
                            sweetAlert("", "Please upload PR document", "warning");
                            $("#btnSave").attr("disabled", false);
                        }
                        else {
                            sweetAlert("", "Record not saved.", "warning");
                            $("#btnSave").attr("disabled", false);
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                        $("#btnSave").attr("disabled", false);
                    }
                });
            }
        }
        else {
            $('#div_valid_msg').removeClass('hidden');
        }
    }

