    function BindData(arrayList) {
        var rows = "", rowId = 0;
        if (arrayList != null) {
            if (arrayList.length > 0) {
                for (var i = 0; i < arrayList.length; i += 1) {
                    debugger;
                    var item = arrayList[i];
                    rowId = rowId + 1;
                    if (item.ISPARALELLAPP == 1) {
                        var arrayListBySeq = $.grep(arrayList, function (e) {
                            return e.APP_SEQ == item.APP_SEQ;
                        });
                        if (arrayListBySeq.length > 0) {
                            var subRows = "";
                            rows += "<tr><td class='text-center'>" + rowId + "</td><td colspan='4'><table class='table table-bordered table-responsive' style='margin-bottom: 0px!important;width: 100%;'>"
                            $.each(arrayListBySeq, function (j, itemObj) {
                                subRows += "<tr><td class='text-center' style='width:12.8%;'>" + itemObj.ADEMPCODE + "</td><td class='text-left' style='width:27.3%;'>"
                                    + itemObj.ADEMPNAME

                                //SIS PR Change
                                if (itemObj.APP_TYPEINFO != null) {
                                    subRows += " - <b>" + itemObj.APP_TYPEINFO + "</b>"
                                }
                                subRows += "</td><td class='text-center' style='width: 27.4%;'>" + itemObj.ADDESIGNATION + "</td>"

                                if (j == 0) {
                                    subRows += "<td rowspan='" + arrayListBySeq.length + "' class='text-left'>Any one can approve</td>"
                                }
                                subRows += "</tr>"
                            });
                            rows += subRows;
                            rows += "</table></td></tr>"
                        }
                        i = i + (arrayListBySeq.length - 1);
                    }
                    else {
                        rows += "<tr><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.ADEMPCODE + "</td>"
                        rows += "<td class='text-left'>" + item.ADEMPNAME

                        //SIS PR Change
                        if (item.APP_TYPEINFO != null) {
                            rows += " - <b>" + item.APP_TYPEINFO + "</b>"
                        }
                        rows += "</td><td class='text-center'>" + item.ADDESIGNATION + "</td>"

                        rows += "<td class='text-center'></td>"
                        //rows += "<td class='text-center'>" + item.APP_SEQ + "</td>"
                        //rows += "<td class='text-center'><a id='" + item.ADEMPCODE + "' style='cursor: pointer;' onclick='DeleteItem(this)'>Skip</a></td>"
                        rows += "</tr>"
                    }
                }
            }
            else {
                rows += "<tr id='div-table'><td colspan='5' class='text-center'>No record found.</td></tr>"
            }
            document.getElementById("append_row").innerHTML = rows;
        }
    }
    function validateString(input) {
        // Check if the string has exactly 13 characters
        if (input.length !== 13) {
            return false;
        }

        // Check if the first 3 characters are alphanumeric
        for (let i = 0; i < 3; i++) {
            if (!/[a-zA-Z]/.test(input[i])) {
                return false;
            }
        }

        // Check if the rest 10 characters are numeric
        for (let i = 3; i < 13; i++) {
            if (!/[0-9]/.test(input[i])) {
                return false;
            }
        }

        return true;
    }

    //Added by aumento for the SR73841===========================================================
    function validateAribaSRNoString(input) {

        // Check if the string has exactly 12 characters
        if (input.length !== 12) {
            return false;
        }

        // Check if the first 3 characters are alphanumeric
        for (let i = 0; i < 2; i++) {
            if (!/[a-zA-Z]/.test(input[i])) {
                return false;
            }
        }

        // Check if the rest 10 characters are numeric
        for (let i = 2; i < 12; i++) {
            if (!/[0-9]/.test(input[i])) {
                return false;
            }
        }

        return true;
    }
