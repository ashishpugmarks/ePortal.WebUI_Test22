                                                    @Html.DisplayNameFor(model => model.prAppHis[0].APPROVALDATE)
                                                </th>
                                                <th class="text-left">
                                                    @Html.DisplayNameFor(model => model.prAppHis[0].APPROVAL_REMARK)
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{ int row_No = 0, app_seq = -1, app_status = -1, rowcnt = 0; string remark_msg = ""; bool isRowSpan = false; bool newRow = false;  }
                                            @if (Model.prAppHis != null)
                                            {
                                                //foreach (var item in Model.prAppHis)
                                                for (int i = 0; i < Model.prAppHis.Count; i++)
                                                {
                                                    newRow = false; //New added
                                                    remark_msg = "";
                                                    rowcnt = 0;
                                                    var item = Model.prAppHis[i];

                                                    //New added
                                                    int appSeqNo = 1;
                                                    for (int k = 1; k <= 10; k++)
                                                    {
                                                        if (Model.prAppHis.Count > (i + k))
                                                        {
                                                            if (Model.prAppHis[i + k].APP_SEQ == item.APP_SEQ)
                                                            {
                                                                appSeqNo++;
                                                            }
                                                            else
                                                            {
                                                                break;
                                                            }
                                                        }
                                                        else
                                                        {
                                                            break;
                                                        }
                                                    }


                                                    <tr>
                                                        @if (item.PRAPPHISTORY_ID != 0 && item.APPROVAL_STATUS != 0 && isRowSpan != true)
                                                        {
                                                            newRow = true; //New added
                                                            rowcnt = 1;
                                                            row_No += 1;
                                                            <td class="text-center">
                                                                @row_No
                                                                @Html.HiddenFor(modelItem => item.PRAPPHISTORY_ID)
                                                            </td>
                                                        }

                                                        @if (item.PRAPPHISTORY_ID != 0 && app_status != item.APPROVAL_STATUS && item.APPROVAL_STATUS == 0)
                                                        {
                                                            newRow = true; //New added
                                                                           //rowcnt = Model.prAppHis.Where(m => (m.APPROVAL_STATUS == 0 || m.APPROVAL_STATUS == 4) && m.PRAPPHISTORY_ID != 0).Count(); ////New added at 26-July-2024
                                                            rowcnt = Model.prAppHis.Where(m => m.APPROVAL_STATUS == 0 && m.PRAPPHISTORY_ID != 0).Count(); ////New added at 26-July-2024
                                                                                                                                                          //rowcnt = Model.prAppHis.Where(m => (m.APPROVAL_STATUS == 0 || m.APP_TYPEINFO == item.APP_TYPEINFO) && m.PRAPPHISTORY_ID != 0).Count(); ////New added at 26-July-2024
