                                    data: JSON.stringify(data),
                                    contentType: "application/json; charset=utf-8",
                                    datatype: "json",
                                    success: function (data) {
                                        if (data == 0) {
                                            alert("Changes has been completed successfully . ");
                                            $("#btnSearch").trigger("click");
                                        }
                                        else {
                                            sweetAlert("", "An error occurred while processing your request.", "error");
                                        }
                                    },
                                    complete: function () {
                                        $("#ajaxLoader").removeClass('loader');
                                    },
                                    error: function () {
                                        sweetAlert("Oops...", "Something went wrong!", "error");
                                    }
                                });
                            }
                        }
                        //hidden.value = JSON.stringify(hot.getData());
                    } else {
                        alert("please enter the value in red marked cell..");
                        //e.preventDefault();
                    }
                })
            }
            else {
                alert("please enter org level or org Unit..");
            }



        }

    </script>

