@model ePortal.ViewModels.SearchIndentUser
@{
    ViewBag.Title = "PRReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .form-control {
            height: 28px;
            padding: 3px 3px;
            font-size: 13px;
        }
    </style>
    }
    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                PR Dashboard
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Search</strong>
                        </h2>
                    </div>
                    <div class="panel-body" style="padding:5px;">
                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.IndentNo, new { @class = "control-label text-right col-md-1", @style = "width:140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.TextBoxFor(model => model.IndentNo, new { @value = "", @id = "txtIndentNo", @class = "form-control", @style = "width: 150px;" })
                            </div>
                            @Html.HiddenFor(model => model.OperationID, new { @id = "ddlOp" })

                            @Html.LabelFor(model => model.DivisionID, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.DivisionID, new SelectList(ViewBag.DivList.Items, "Value", "Text"), "- Select -", new { @id = "ddlDiv", @class = "form-control" })
                            </div>
                            @Html.LabelFor(model => model.DEPTID, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.DEPTID, new SelectList(ViewBag.DepList.Items, "Value", "Text"), "- Select -", new { @id = "ddlDep", @class = "form-control" })
                            </div>

                        </div>
                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.SECID, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.SECID, new SelectList(ViewBag.SecList.Items, "Value", "Text"), "- Select -", new { @id = "ddlSec", @class = "form-control" })
                            </div>

                            @Html.LabelFor(model => model.ecode, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2">
                                @Html.TextBoxFor(model => model.ecode, new { @type = "number", @value = "", @id = "txtEmpCode", @class = "form-control", @style = "width: 110px;" })
                            </div>
                        </div>
                        <div class="row" style="padding:4px;">
                            @* @Html.Label("Request Date", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" }) *@
                            @Html.Label("Request Date", "Request Date", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-1 col-lg-1">
                                <input id = "txtStartdate" class="form-control datepic" style="width: 100px;" name="Startdate" type="text" value="" readonly="readonly" placeholder="From Date" />
                            </div>
                            @*@Html.LabelFor(model => model.ENDDATE, new { @class = "control-label text-right col-md-1", @style = "width: 190px;margin-top: 7px;" })*@
                            <div class="col-lg-1 col-md-1" style="margin-left: 10px;">
                                <input id="txtENDDATE" class="form-control datepic" style="width: 100px;" name="ENDDATE" type="text" value="" readonly="readonly" placeholder="To Date" />
                            </div>
                            @Html.LabelFor(model => model.PRStatus, new { @class = "control-label text-right col-md-2", @style = "width: 183px;margin-top: 7px;" })
                            <div class="col-md-1 col-lg-1" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.PRStatus, new List<SelectListItem>
                                    {
                                       new SelectListItem{ Text="-- ALL --", Value = "-1" },
                                       new SelectListItem{ Text="PR Pending", Value = "1" },
                                       new SelectListItem{ Text="PO Creation Pending", Value = "3" },
                                       new SelectListItem{ Text="PO Approval WIP", Value = "5" },
                                       new SelectListItem{ Text="PO Approval Done", Value = "7" },
                                       new SelectListItem{ Text="PR Rejected By Buyer", Value = "8" },
                           }, new { @class = "form-control", @id = "ddlPrStatus" })
                            </div>
                            @*------------SR52365---------------------------------------------------*@
                            @Html.LabelFor(model => model.kicode, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-xs-8 col-sm-2 col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.kicode, new SelectList(ViewBag.KICodeList.Items, "SYKIID", "KICODE"), new { @id = "ddlkicode", @class = "form-control" })
                            </div>
                            @*---------------------------------------End Changes------------------------------------------------*@
                        </div>

                        <div class="row" style="padding:4px;">
                            @* @Html.Label("Remark", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" }) *@
                            @Html.Label("Remark", "Remark", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-1 col-lg-1">
                                <input id="txtremark" class="form-control" style="width: 300px;" name="txtremark" type="text" value="" placeholder="Enter Remark" />
                            </div>
                        </div>

                        <div class="row" style="padding:2px;">
                            <div class="col-md-12 col-lg-12 text-center">
                                <button id="btnSubmit" class="btn btn-success btn-sm">Search</button>
                                <button id="btnExcel" class="btn btn-primary btn-sm">Export To Excel</button>
                                <input type="button" value="Reset" class="btn btn-default btn-sm" id="btnReset" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="ajaxLoader"></div>
            <div id="div_append"></div>
        </div>
    </div>
    <div id="myCreateModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="padding:10px!important;">
                    <div class="pull-left">
                        <h5 class="modal-title"><span id="sp_type"></span></h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body" style="padding:10px!important;">
                    <div id="myCreateModelContent"></div>
                </div>
            </div>
        </div>
    </div>
@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $('.datepic').datepicker({
                format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top'
            });


            /// Division
            if ('@Model.DivisionID' != '0') {
                $("#ddlDiv").addClass('div_disable');
            }
            else {
                $("#ddlDiv").removeClass('div_disable');
            }

            /// Department
            if ('@Model.DEPTID' != '0') {
                $("#ddlDep").addClass('div_disable');
            }
            else {
                $("#ddlDep").removeClass('div_disable');
            }
            /// Section
            if ('@Model.SECID' != '0') {
                $("#ddlSec").addClass('div_disable');
            }
            else {
                $("#ddlSec").removeClass('div_disable');
            }
            /// Department
            if ('@Model.ISPUR' == '0') {
                $('#txtEmpCode').val('@Model.ecode');
                $("#txtEmpCode").attr('readonly', 'true');
            }
            else {
                $("#txtEmpCode").removeAttr('readonly');
                $('#txtEmpCode').val('');
            }
           // $("#btnSubmit").click();
        });

        ////======== SR52365 change start=====////
        ////======== Bind Department========////
        function BindDepartment(crnt, call) {
            debugger;
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            var kiID = $("#ddlkicode").val();
            BindDepartmentByDivKI(dID, "#ddlkicode", call);
        }

        ////======== Bind Section========////
        function BindSection(crnt, call) {
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            var kiID = $("#ddlkicode").val();
            $.getJSON("/PR/BindSectionByDeptKI", { id: dID, ki: kiID },
                   function (data) {
                       var select = $("#ddlSec");

                       select.empty();
                       if (data.iList.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data.iList, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.Value,
                               text: itemData.Text
                           }));
                       });
                       if (data.secID != '' && call == 1) {
                           $("#ddlSec").val(data.secID);
                       }
                   });
        }

        ////======== Bind Division========////
        function BindDivision(crnt, call) {
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            $.getJSON("/PR/BindDivisionByKI", { id: dID },
                   function (data) {
                       var select1 = $("#ddlOp");
                       var select = $("#ddlDiv");
                       select1.empty();
                       select.empty();
                       if (data.iList.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data.iList, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.Value,
                               text: itemData.Text
                           }));
                       });

                       var select2 = $("#ddlDep");
                       select2.empty();
                       if (data.iList.length > 0) {
                           select2.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select2.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }

                       var select3 = $("#ddlSec");
                       select3.empty();
                       if (data.iList.length > 0) {
                           select3.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select3.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }

                       if (data.opID != '') {
                           $("#ddlOp").val(data.opID);
                       }
                       if (data.divID != '' && call == 1) {
                           $("#ddlDiv").val(data.divID);
                           BindDepartmentByDivKI(data.divID, crnt, call);
                       }
                   });
        }

        ////======== Bind Department By Division ID and KI========////
        function BindDepartmentByDivKI(divID, crnt, call) {
            var KI = $(crnt).val();
            if (KI == "") {
                KI = 0;
            }
            $.getJSON("/PR/BindDepartmentByDivKI", { id: divID, ki: KI },
                   function (data) {
                       debugger;
                       var select = $("#ddlDep");
                       select.empty();
                       if (data.iList.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data.iList, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.Value,
                               text: itemData.Text
                           }));
                       });
                       if (data.deptID != '' && call == 1) {
                           $("#ddlDep").val(data.deptID);
                       }
                   });
        }
        ////======== SR52365 change end=====////

        function GetReportList(crnt) {
            var data = {
                OperationID: $('#ddlOp').val() == "" ? 0 : $('#ddlOp').val(),
                DivisionID: $('#ddlDiv').val() == "" ? 0 : $('#ddlDiv').val(),
                DEPTID: $('#ddlDep').val() == "" ? 0 : $('#ddlDep').val(),
                SECID: $('#ddlSec').val() == "" ? 0 : $('#ddlSec').val(),
                IndentNo: $('#txtIndentNo').val(),
                ecode: $('#txtEmpCode').val() == "" ? 0 : $('#txtEmpCode').val(),
                Startdate: $('#txtStartdate').val(),
                ENDDATE: $('#txtENDDATE').val(),
                PRStatus: $('#ddlPrStatus').val(),
                ITEM_DETAIL: $('#txtremark').val()
                }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/PR/PRUserReport",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#div_append').html(data);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function GetExcel(crnt) {
            var data = {
                OperationID: $('#ddlOp').val() == "" ? 0 : $('#ddlOp').val(),
                DivisionID: $('#ddlDiv').val() == "" ? 0 : $('#ddlDiv').val(),
                DEPTID: $('#ddlDep').val() == "" ? 0 : $('#ddlDep').val(),
                SECID: $('#ddlSec').val() == "" ? 0 : $('#ddlSec').val(),
                IndentNo: $('#txtIndentNo').val(),
                ecode: $('#txtEmpCode').val() == "" ? 0 : $('#txtEmpCode').val(),
                Startdate: $('#txtStartdate').val(),
                ENDDATE: $('#txtENDDATE').val(),
                PRStatus: $('#ddlPrStatus').val(),
                ITEM_DETAIL: $('#txtremark').val()
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/PR/ExportToExcelUser",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "PR", Action = "DownloadExcelUser" })";
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
        function GetPRAgeing(strindentno) {
            var data = {
                IndentNo: strindentno.toString(),
                }
            $.ajax({
                type: "POST",
                url: "/PR/PRAgeing",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                //dataType: "json",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#sp_type').html("PO Ageing History");
                        $('#myCreateModelContent').html(data);
                        $('#myCreateModel').modal({ backdrop: "static" });
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
    </script>

    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#ddlkicode').on('change', function () {
                BindDivision($(this)[0], 1);
            });
            $('#ddlDep').on('change', function () {
                BindSection($(this)[0], 0);
            });
            $('#ddlDiv').on('change', function () {
                BindDepartment($(this)[0], 0);
            });
            $('#btnReset').on('click', function () {
                location.href = '@Url.Action("PRUserReport", "PR")';
            });
            $('#btnExcel').on('click', function () {
                GetExcel($(this));
                return false;
            });
            $('#btnSubmit').on('click', function () {
                GetReportList($(this));
                return false;
            });

        });
    </script>
    }