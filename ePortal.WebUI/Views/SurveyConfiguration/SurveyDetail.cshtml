                            @Html.DropDownListFor(model => model.LOCATION, new MultiSelectList(ViewBag.SYSITE.Items, "SYSITEID", "DESCRIP"), new { @id = "Site", @class = "multiSelectDrop", @multiple = "multiple", @disabled = "disabled" })
