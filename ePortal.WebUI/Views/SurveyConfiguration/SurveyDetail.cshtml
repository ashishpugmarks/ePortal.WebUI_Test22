                <div class="form-group">
                    <div class="row">
                        @Html.LabelFor(model => model.PASSINGPERCENTAGE, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            @Html.TextBoxFor(model => model.PASSINGPERCENTAGE, new { @class = "form-control", @type = "number" })
                            @Html.ValidationMessageFor(model => model.PASSINGPERCENTAGE, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>


            </div>

            <div class="form-horizontal tab">
                <div class=" form-group">
                    <div class="row">
                        @Html.Label("Survey Name : ", "Survey Name : ", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-8">
                            <label id="lblServer_Desc"></label><br />
                        </div>
                        @*<table class="table table-bordered table-responsive body-content" style="width:100%" id="_tbl">
                                <thead>
                                    <tr class="info">
                                        <td colspan="10">
                                            <b class="pull-left">
                                                Question List
                                            </b>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>
                                            Sl
                                        </th>
                                        <th>Question</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="tblQuestionlist"></tbody>
                            </table>*@
                    </div>
                </div>
            </div>

            <div class="form-horizontal tab">
                <div class=" form-group">
                    <div class="row">
                        @Html.LabelFor(model => model.HRSURVEYDESC, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-8">
                            <label id="lblSelectedServer_Desc"></label>
                        </div>
                    </div>
                    @*<table class="table table-bordered" id="_tbl2">
                            <thead>
                                <tr>
                                    <th>
                                        Sl
                                    </th>
                                    <th>Selected Question</th>
                                </tr>
                            </thead>
                            <tbody id="tblQuestionlist2"></tbody>
                        </table>*@
