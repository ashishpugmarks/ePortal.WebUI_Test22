            <div style="float:right;">
                <button class="btn btn-primary" type="button" id="prevBtn" >Previous</button>
                <button class="btn btn-primary" type="button" id="nextBtn" >Next</button>
            <input type="button" id="_btn" data-id="@Model.HRSECURITYSURVEYID" value="Submit" class="btn btn-primary" />
            </div>
        </div>
    </div>
    <div class="body-content" style="overflow-x:auto!important" id="_tbl">
        <table class="table table-bordered table-responsive">
            <thead>
                <tr class="info">
                    <td colspan="3">
                        <b class="pull-left">
                            Question List
                        </b>
                    </td>
                </tr>
            </thead>
            <tbody id="tblQuestionlist"></tbody>
        </table>
    </div>
    <div class="body-content" style="overflow-x:auto!important" id="_tbl2">
        <table class="table table-bordered table-responsive">
            <thead>
                <tr class="info">
                    <td colspan="3">
                        <b class="pull-left">
                            Selected Questions
                        </b>
                        <b class="pull-right">
                            <input type="button" id="btnAddQues" value="Add Question" class="btn btn-primary btn-xs" />
                        </b>
                    </td>
                </tr>
            </thead>
            <tbody id="tblQuestionlist2"></tbody>
        </table>
    </div>
    <div id="myModal" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div id="myModelHeader"></div>
                </div>
                <div class="modal-body">
                    <div id="myModalContent"></div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts{
    <script src="~/lib/bootstrap/js/bootstrap-multiselect.js"></script>


    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        var currentTab = 0;
        //var QArray = new Array();
          var _quesArray, _selectedQuestion = new Array();
        _quesArray=@Html.Raw(JsonSerializer.Serialize(Model.Questionlist));
        debugger;
        $(document).ready(function () {
            showTab(currentTab);
            $("._date").datepicker({
                format: "dd-M-yyyy",
                startDate: "today",
                autoclose: true,
                toolbarplacement: 'top'
            });

            BindQuestion(_quesArray);

                    $("#prevBtn").on("click", function(){
                       nextPrev(-1);
        });

        $("#nextBtn").on("click", function(){
                       nextPrev(1);
        });

        $("#btnAddQues").on("click", function(){
                       AddQuestionPopup();
        });

        $("#_btn").on("click", function(){
         var id = $(this).data('id');
                       _FinalfromSubmit(id);
        });


         $(document).on('click', '[data-ctrl="sel-ques"]', function () {
            var id = $(this).data('id');
                    SelectedQuestion(id);
        });

        });

        function CloseModalPopup() {
            $("#myModal").modal('hide');
        }
        function showTab(n) {
            var x = document.getElementsByClassName("tab");
            x[n].style.display = "block";
            if (n == 0) {
                document.getElementById("prevBtn").style.display = "none";
                $("#nextBtn").show();
                $("#_tbl").hide();
                $("#_tbl2").hide();
            } else {
                document.getElementById("prevBtn").style.display = "inline";
                $("#_tbl").show();
                $("#_tbl2").hide();
                $("#nextBtn").show();
            }
            if (n == (x.length - 1)) {
                document.getElementById("nextBtn").innerHTML = "Submit";
                $("#nextBtn").addClass("_submit");
                $("#nextBtn").show();
                $("#_btn").show();
                $("#nextBtn").hide();
                $("#_tbl").hide();
                $("#_tbl2").show();

            } else {
                document.getElementById("nextBtn").innerHTML = "Next";
                $("#nextBtn").removeClass('_submit');
                $("#_btn").hide();
            }
            fixStepIndicator(n)
        }

        function nextPrev(n) {

            var x = document.getElementsByClassName("tab");
            x[currentTab].style.display = "none";
            currentTab = currentTab + n;
            if (currentTab >= x.length) {
                return false;
            }
            $('#lblServer_Desc').text($("#HRSURVEYDESC").val());
            $('#lblSelectedServer_Desc').text($("#HRSURVEYDESC").val());
            showTab(currentTab);
            BindSelectedQuestion(_selectedQuestion);
        }

        function fixStepIndicator(n) {
            var i, x = document.getElementsByClassName("step");
            for (i = 0; i < x.length; i++) {
                x[i].className = x[i].className.replace(" active", "");
            }

        }

        function BindQuestion(questionlist) {
            var html = '';
            var Sl =1;
            $.each(questionlist, function (key, item) {
                html += '<tr>';
                html += '<td>' + Sl++;  + '</td>';
                html += '<td>' + item.QUSDESCRIPTION + '</td>';
                html += '<td><input type="checkbox" id="chk_'+item.QusId+'" data-ctrl="sel-ques" data-id="'+item.QusId+'" ></td>';
                html += '</tr>'
                $('table #tblQuestionlist').html(html);
            });
        }

        function SelectedQuestion(id)
        {
            debugger;
            var chk = $('#chk_'+ id)[0].checked;
            $.each(_quesArray, function (key, item) {
                if(item.QusId == id )
                {
                    if(chk == false){
                        _selectedQuestion=  $.grep(_selectedQuestion, function(e) {
                            return e.QusId != id;
                        });
                    }
                    if(chk == true){
                        _selectedQuestion.push(item);
                    }
                }
            });
        }

        function BindSelectedQuestion(questionlist) {
            var html = '';
            var Sl =1;
            if(questionlist != null || questionlist != undefined){
                $.each(questionlist, function (key, item) {
                    html += '<tr>';
                    html += '<td>' + Sl++;  + '</td>';
                    html += '<td>' + item.QUSDESCRIPTION + '</td>';
                    html += '</tr>'
                });
            }
            else{
                html += '<tr><td> No record found.</td></tr>';
            }
            $('table #tblQuestionlist2').html(html);
        }

        function AddQuestionPopup(current) {            
            $.ajax({
                type: "GET",
                url: "/SurveyConfiguration/AddQuestion",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        var headerHtml = '<div class="pull-left"><h5 class="modal-title">Add Question</h5></div><div class="pull-right"><button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px"><span aria-hidden="true">&times;</span></button></div>'
                        $('#myModelHeader').html(headerHtml);
                        $('#myModalContent').html(data);
                        $('#myModal').modal({ backdrop: "static" });
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        };

        var number = 0;
        function _fromSubmit() {
            debugger;
            var _QsId = $("#_hfQusId").val();
            number = _QsId > 0 ? _QsId : _selectedQuestion.length == 0 ? _selectedQuestion.length + 1 : Math.max.apply(Math, _selectedQuestion.map(function (o) { return o.QusId })) + 1;
            var result = {
                QusId: number,
                QUSDESCRIPTION: $("#QUSDESCRIPTION").val(),
                MappingList: arrayList,
            }
            $.ajax({
                type: "POST",
                url: "/SurveyConfiguration/AddQuestion",
                data: JSON.stringify(result),
                dataType: "json",
                contentType: "application/json",
                success: function (data) {
                    $('#myModal').modal('hide');
                    debugger;
                    _selectedQuestion.push(result);
                    BindSelectedQuestion(_selectedQuestion);
                    //$.each(_quesArray, function (key, item) {
                    //    (SelectedQuestion(item.QusId), item.QUSDESCRIPTION);
                    //});
                    //$.each(data, function (key, item) {
                        //var html = '';
                        //html += '<tr>';
                        //html += '<td>' + result.QUSDESCRIPTION + '</td>';
                        //html += '</tr>'
                        //$('table #tblQuestionlist2').append(html);
                    //});
                },
                error: function () {
                }
            });
            return false;
        };

        function _FinalfromSubmit(id) {
            debugger;
            var result = {
                HRSURVEYDESC: $("#HRSURVEYDESC").val(),
                HRSURVEYTITAL: $("#HRSURVEYTITAL").val(),
                HRSURVEYSTARTDATE: $("#HRSURVEYSTARTDATE").val(),
                HRSURVEYENDDATE: $("#HRSURVEYENDDATE").val(),
                FUNCTIONAL_DESIGNATION: $('#fnDesignation').val(),
                LOCATION: $('#Site').val(),
                ACTIVE: $('#ACTIVE')[0].checked,
                SURVEYRESULTMAIL: $('#SURVEYRESULTMAIL')[0].checked,
                FEEDBACKSTATUS: $('#FEEDBACKSTATUS')[0].checked,
                PASSINGPERCENTAGE : $("#PASSINGPERCENTAGE").val(),
            }
            $.ajax({
                type: "POST",
                url: '/SurveyConfiguration/SurveyDetail/' + id,
                data: JSON.stringify(result),
                dataType: "json",
                contentType: "application/json",
                success: function (data) {
                    if (data == 1) {
                        window.location.href = "/SurveyConfiguration/SurveyList";
                    }
                },
                error: function () {
                }
            });
            return false;
        }

        $('#fnDesignation').multiselect({
            includeSelectAllOption: true,
            maxHeight: 180,
            buttonWidth: 250,
            dropUp: true,
            enableFiltering: true,
            enableCaseInsensitiveFiltering: true

        });

        $('#Site').multiselect({
            includeSelectAllOption: true,
            maxHeight: 180,
            buttonWidth: 250,
            dropUp: true,
            enableFiltering: true,
            enableCaseInsensitiveFiltering: true

        });

        if ($('#FUNCTIONAL_DESIGNATIONS').val() != null && $('#FUNCTIONAL_DESIGNATIONS').val() != "") {
            var fnDesignationArray = $('#FUNCTIONAL_DESIGNATIONS').val().split(",");
            $("#fnDesignation").val(fnDesignationArray);
            $("#fnDesignation").multiselect("refresh");
        }
        if ($('#LOCATIONS').val() != null && $('#LOCATIONS').val() != "") {
            var SiteArray = $('#LOCATIONS').val().split(",");
            $("#Site").val(SiteArray);
            $("#Site").multiselect("refresh");
        }
    </script>

   
    }


 



