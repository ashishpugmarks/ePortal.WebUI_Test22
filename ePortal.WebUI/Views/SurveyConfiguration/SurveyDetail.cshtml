                </div>
                <div class="form-group">
                    <div class="row">
                        @Html.LabelFor(model => model.ACTIVE, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-1">
                            @{
                                bool isSurveyActive = Model.ACTIVE.HasValue && Model.ACTIVE == 1 ? true : false;
                            }
                            <input type="checkbox" name="ACTIVE" id="ACTIVE" @(isSurveyActive ? "checked" : "") disabled />
                            @*@Html.CheckBoxFor(model => model.ACTIVE, new { @disabled = "disabled" })*@
                            @Html.ValidationMessageFor(model => model.ACTIVE, "", new { @class = "text-danger" })
                        </div>

                        @Html.LabelFor(model => model.SURVEYRESULTMAIL, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-1">
                            @Html.CheckBoxFor(model => model.SURVEYRESULTMAIL, new { @disabled = "disabled" })
                            @Html.ValidationMessageFor(model => model.SURVEYRESULTMAIL, "", new { @class = "text-danger" })
                        </div>

                        @Html.LabelFor(model => model.FEEDBACKSTATUS, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-1">
                            @Html.CheckBoxFor(model => model.FEEDBACKSTATUS, new { @disabled = "disabled" })
                            @Html.ValidationMessageFor(model => model.FEEDBACKSTATUS, "", new { @class = "text-danger" })
                        </div>

