        function showTab(n) {
            var x = document.getElementsByClassName("tab");
            x[n].style.display = "block";
            if (n == 0) {
                document.getElementById("prevBtn").style.display = "none";
                $("#nextBtn").show();
                $("#_tbl").hide();
                $("#_tbl2").hide();
            } else {
                document.getElementById("prevBtn").style.display = "inline";
                $("#_tbl").show();
                $("#_tbl2").hide();
                $("#nextBtn").show();
            }
            if (n == (x.length - 1)) {
                filterTempData(_selectedQuestion);
                document.getElementById("nextBtn").innerHTML = "Submit";
                $("#nextBtn").addClass("_submit");
                $("#nextBtn").show();
                $("#_btn").show();
                $("#nextBtn").hide();
                $("#_tbl").hide();
                $("#_tbl2").show();
                $("#surveyPreviewButton").show();
            } else {
                document.getElementById("nextBtn").innerHTML = "Next";
                $("#nextBtn").removeClass('_submit');
                $("#_btn").hide();
                $("#surveyPreviewButton").hide();
            }
            fixStepIndicator(n)
        }

        function nextPrev(n) {
            if (n == 1) {
                $("#lblPercentage").text('');
                if ($("#txtPercentage").val() == "") {
                    $("#lblPercentage").text('Passing percentage(%) is required');
                    $("#txtPercentage").focus();
                    return false;
                }
            }

            var x = document.getElementsByClassName("tab");
            x[currentTab].style.display = "none";
            currentTab = currentTab + n;
            if (currentTab >= x.length) {
                return false;
            }
            $('#lblServer_Desc').text($("#HRSURVEYDESC").val());
            $('#lblSelectedServer_Desc').text($("#HRSURVEYDESC").val());
            showTab(currentTab);
            BindSelectedQuestion(_selectedQuestion);
        }

        function fixStepIndicator(n) {
            var i, x = document.getElementsByClassName("step");
            for (i = 0; i < x.length; i++) {
                x[i].className = x[i].className.replace(" active", "");
            }

        }

        function BindQuestion(questionlist) {
            var html = '';
            var slNo = 1;
            $.each(questionlist, function (key, item) {

                if (item.ISSUBQUESTION == '0') {
                    html += '<tr class="parent-row" data-id="' + item.QusId + '">';
                    html += '<td data-ctrl="tog-btn" data-id="'+ item.QusId +'">';
                    if (item.isChildPresent == '1') {
                        html += '<i class="fa fa-chevron-down toggle-icon" style="cursor:pointer;"></i>'; // Right arrow (collapsed)
                    } else {
                        html += '';
                    }
                    html += (slNo++) + '</td>';  // Sl.No
                    html += '<td>' + (item.QUSDESCRIPTION || '') + '</td>';
                    html += '<td>' + (item.QUSDESCRIPTIONHINDI || '') + '</td>';
                    html += '<td>' + (item.QUSDESCRIPTIONKANNADA || '') + '</td>';
                    html += '<td>' + (item.QUSDESCRIPTIONGUJARATI || '') + '</td>';
                    html += '<td>' + (item.QUSDESCRIPTIONJAPANESE || '') + '</td>';
                    html += '<td class="text-center" style="align-content:center;">' + (item.ISSUBQUESTION == '1' ? '<p class="btn btn-success btn-xs">True</p>' : '<p class="btn btn-danger btn-xs">False</p>') + '</td>';
                    html += '<td><input type="checkbox" id="chk_' + item.QusId + '" data-ctrl="btn-sel-ques" data-id="' + item.QusId + '"></td>';
                    html += '</tr>';
                }
            });

            $('table #tblQuestionlist').html(html);

            $.each(questionlist, function (index, item) {
                if (item.ISSUBQUESTION == '1') {
                    var subQuestionHtml = '';
                    var parentSlNo = $('tr[data-id="' + item.SUBQUESTIONPARENTID + '"]').find('td:first').text();
                    var subQuestionSlNo = parentSlNo + '.' + 1;
                    subQuestionHtml += '<tr class="subquestion-row" data-parent-id="' + item.SUBQUESTIONPARENTID + '" style="display: table-row;">'; // Hidden by default
                    subQuestionHtml += '<td>' + subQuestionSlNo + '</td>';
                    subQuestionHtml += '<td>' + (item.QUSDESCRIPTION || '') + '</td>';
                    subQuestionHtml += '<td>' + (item.QUSDESCRIPTIONHINDI || '') + '</td>';
                    subQuestionHtml += '<td>' + (item.QUSDESCRIPTIONKANNADA || '') + '</td>';
                    subQuestionHtml += '<td>' + (item.QUSDESCRIPTIONGUJARATI || '') + '</td>';
                    subQuestionHtml += '<td>' + (item.QUSDESCRIPTIONJAPANESE || '') + '</td>';
                    subQuestionHtml += '<td class="text-center" style="align-content:center;">' + (item.ISSUBQUESTION == '1' ? '<p class="btn btn-success btn-xs">True</p>' : '<p class="btn btn-success btn-xs">False</p>') + '</td>';
                    subQuestionHtml += '<td><input type="checkbox" id="chk_' + item.QusId + '" data-ctrl="btn-sel-ques" data-id="' + item.QusId + '"></td>';
                    subQuestionHtml += '</tr>';

                    $('tr[data-id="' + item.SUBQUESTIONPARENTID + '"]').after(subQuestionHtml);
                }
            });
        }

        //toggle the subquestion row
        function toggleSubquestions(parentId) {
            var subquestions = $("tr.subquestion-row[data-parent-id='" + parentId + "']");

