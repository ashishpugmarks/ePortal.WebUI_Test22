                                html += '<td>' + (subItem.QUSDESCRIPTIONHINDI || '') + '</td>';
                                html += '<td>' + (subItem.QUSDESCRIPTIONKANNADA || '') + '</td>';
                                html += '<td>' + (subItem.QUSDESCRIPTIONGUJARATI || '') + '</td>';
                                html += '<td>' + (subItem.QUSDESCRIPTIONJAPANESE || '') + '</td>';
                                html += '<td class="text-center" style="align-content:center;">' + (subItem.ISSUBQUESTION == '1' ? '<p class="btn btn-success btn-xs">True</p>' : '<p class="btn btn-success btn-xs">False</p>') + '</td>';
                                html += '<td><input class="btn btn-warning btn-xs glyphicon glyphicon-edit" style="cursor: pointer;" type=button data-ctrl="edit-ques-btn" data-id="'+subItem.QusId+'" data-parentid="'+subItem.SUBQUESTIONPARENTID+'" value=Edit>' + ((subItem.ISSUBQUESTION == '1' || subItem.isChildPresent == '1') ? '' : '<input class="btn btn-warning btn-xs" style="cursor: pointer;margin: 5px;" type=button data-ctrl="addsub-ques-btn" data-id="'+subItem.QusId+'" value="Add SubQuestion">') + '</td>';
                                html += '</tr>';
                            }
                        });
                    }
                });
            }
            else {
                html += '<tr><td> No record found.</td></tr>';
            }
            $('table #tblQuestionlist2').html(html);
        }

