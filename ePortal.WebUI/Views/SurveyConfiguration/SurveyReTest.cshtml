        function BindDivision(crnt, call) {
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            var myData = {
                OPERATION: dID,
            };
            $.ajax({
                type: "POST",
                url: "/SurveyConfiguration/BindDivisionByOperationId",
                data: JSON.stringify(myData),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                processdata: true,
                traditional: true,
                success: function (data) {
                    var select = $("#fnDivision");
                    select.empty();
                    if (data.length == 0) {
                        select.append($('<option/>', {
                            value: 0,
                            text: "--No record--"
                        }));
                    }
                    $.each(data, function (index, itemData) {
                        select.append($('<option/>', {
                            value: itemData.ADDIVISIONID,
                            text: itemData.DESCRIP
                        }));
                    });
                    select.multiselect('rebuild');

                    if ($('#DIVISION_VALUE').val() != null && $('#DIVISION_VALUE').val() != "") {
                        var DivisionArray = $('#DIVISION_VALUE').val().split(",");
                        $("#fnDivision").val(DivisionArray);
                        $("#fnDivision").multiselect("refresh");
                    }
                }
            });
        }

