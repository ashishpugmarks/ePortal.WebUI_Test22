                        //html += '<td><input class="btn btn-warning btn-xs glyphicon glyphicon-edit" style="cursor: pointer;" type=button onClick=EditQuestionPopup(' + item.QusId + ') value=Edit></td>';
                        html += '<td><input class="btn btn-warning btn-xs glyphicon glyphicon-edit" style="cursor: pointer;" type=button data-ctrl="edit-ques-btn" data-id="'+item.QusId+'" data-parentid="'+item.SUBQUESTIONPARENTID+'" value=Edit>' + ((item.ISSUBQUESTION == '1' || item.isChildPresent == '1') ? '' : '<input class="btn btn-warning btn-xs" style="cursor: pointer;margin: 5px;" type=button data-ctrl="addsub-ques-btn" data-id="'+item.QusId+'" value="Add SubQuestion">') + '</td>';
