@model ePortal.ViewModels.InfoSecuReportViewModel


<div style="width: 97%;">
    @if (Model.SummaryList != null && Model.SummaryList.Count > 0)
    {                                       
                                            <table id="summaryTable" class="table table-bordered table-hover table-responsive" cellpadding="0" cellspacing="0" style="width: 97%;">
                                                <thead>
                                                    <tr>
                                                        <th>S.No.</th>
                                                        <th>ECode</th>
                                                        <th>Name</th>
                                                        <th>Avg. Score(%)</th>
                                                        <th>Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>

                @foreach (var entry in Model.SummaryList.Select((item, index) => new { item, index }))
                {
                                                            <tr>
                                                                <td>@(entry.index + 1)</td>
                                                                <td>@entry.item.Ecode</td>
                                                                <td>@entry.item.Name</td>
                                                                <td>@entry.item.AVGPER</td>
                                                                <td>
                            <a class="btn btn-edit"
                                                                            data-id="@entry.item.Ecode"
                                                                            data-name="@entry.item.Name"
                                                                            data-perc="@entry.item.AVGPER"
                                                                            data-ctrl="edit-survey-btn">

                                <span class="fa fa-lg fa-eye"></span>
                                                                    </a>
                                                                </td>
                                                            </tr>
                }
                                                </tbody>
                                            </table>
    }
    else
    {
        <h4 class="mt-4">No Record Found.</h4>
    }

                                    <br />
                                    <br />
                                    <h4 style="padding-top: 10px; font-weight: bold; padding-bottom: 10px; background-color: #cfdccd; width: 99%;">Percentage wise Result of Survey </h4>
    @if (Model.DetailList != null && Model.DetailList.Count > 0)
    {                                       
                                            <table id="detailTable" class="table table-bordered table-hover table-responsive" cellpadding="0" cellspacing="0" style="width: 97%;">
                                                <thead>
                                                    <tr>
                                                        <th>Level</th>
                                                        <th>Total Associate</th>
                                                    </tr>
                                                </thead>
                                                <tbody>

                @foreach (var item in Model.DetailList)
                {
                                                            <tr>
                                                                <td>@item.Level</td>
                                                                <td>@item.TotalAssociate</td>
                                                            </tr>
                }
                                                </tbody>
                                            </table>
    }
    else
    {
                                            <br />
        <h4 class="mt-4">No Record Found.</h4>
    }

                                </div>

