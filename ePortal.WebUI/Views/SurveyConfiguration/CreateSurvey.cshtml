@model ePortal.ViewModels.SurveyViewModel

@{
    ViewBag.Title = "Create Survey";
    Layout = "~/Views/Shared/_LayoutSurvey.cshtml"; // Added by Aumento on 02-07-2024
}

@section Styles{
    <link href="~/lib/bootstrap/css/bootstrap-multiselect.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .subquestion-row {
            display: none;
        }
        /*Survey enhancement start*/
        .links a + .tooltip > .tooltip-inner {
            background-color: #f9fff2;
            color: #000000;
            border: 1px solid #3fb3fe;
            padding: 5px;
            font-size: 12px;
            font-weight: bold;
        }
        /*Survey enhancement end*/

        label#lblServer_Desc {
            font-size: 14px;
            margin-top: 10px;
        }

        button#nextBtn {
            margin-right: 20px;
        }

        input#_btn {
            margin-right: 13px;
        }

        .tab {
            display: none;
        }

        .step {
            height: 15px;
            width: 15px;
            margin: 0 2px;
            background-color: #bbbbbb;
            border: none;
            border-radius: 50%;
            display: inline-block;
            opacity: 0.5;
        }

            .step.active {
                opacity: 1;
            }

            .step.finish {
                background-color: #4CAF50;
            }

        #tblQuestionlist tr td:nth-child(2),
        #tblQuestionlist tr td:nth-child(3),
        #tblQuestionlist tr td:nth-child(4),
        #tblQuestionlist tr td:nth-child(5),
        #tblQuestionlist tr td:nth-child(6) {
            word-wrap: break-word;
            min-width: 200px;
            max-width: 300px;
        }

        #tblQuestionlist tr td:nth-child(1),
        #tblQuestionlist tr td:nth-child(7) {
            vertical-align: middle;
            text-align: center
        }

        #loadingmodal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 9999;
        }

        .lodingModalCenter {
            text-align: center;
        }

            .lodingModalCenter img {
                width: 50px;
                height: 50px;
            }
    </style>
}

    <div class="row">
