                    subQuestionHtml += '<td>' + subQuestionSlNo +'</td>';
                    subQuestionHtml += '<td>' + (item.QUSDESCRIPTION || '') + '</td>';
                    subQuestionHtml += '<td>' + (item.QUSDESCRIPTIONHINDI || '') + '</td>';
                    subQuestionHtml += '<td>' + (item.QUSDESCRIPTIONKANNADA || '') + '</td>';
                    subQuestionHtml += '<td>' + (item.QUSDESCRIPTIONGUJARATI || '') + '</td>';
                    subQuestionHtml += '<td>' + (item.QUSDESCRIPTIONJAPANESE || '') + '</td>';
                    subQuestionHtml += '<td class="text-center" style="align-content:center;">' + (item.ISSUBQUESTION == '1' ? '<p class="btn btn-success btn-xs">True</p>' : '<p class="btn btn-success btn-xs">False</p>') + '</td>';
                    // subQuestionHtml += '<td><input class="btn btn-warning btn-xs glyphicon glyphicon-edit" style="cursor: pointer;" type=button onClick="EditQuestionPopup(' + item.QusId + ', ' + item.SUBQUESTIONPARENTID + ')"value=Edit>' + ((item.ISSUBQUESTION == '1' || item.isChildPresent == '1') ? '' : '<input class="btn btn-warning btn-xs" style="cursor: pointer;margin: 5px;" type=button onClick=AddSubQuestionPopup(' + item.QusId + ') value="Add SubQuestion">') + '</td>';

                       subQuestionHtml += '<td><input class="btn btn-warning btn-xs glyphicon glyphicon-edit" style="cursor: pointer;" type=button data-ctrl="edit-ques-btn" data-id="'+item.QusId+'" data-parentid="'+item.SUBQUESTIONPARENTID+'" value=Edit>' + ((item.ISSUBQUESTION == '1' || item.isChildPresent == '1') ? '' : '<input class="btn btn-warning btn-xs" style="cursor: pointer;margin: 5px;" type=button data-ctrl="addsub-ques-btn" data-id="'+item.QusId+'" value="Add SubQuestion">') + '</td>';
                    subQuestionHtml += '</tr>';
                    $('tr[data-id="' + item.SUBQUESTIONPARENTID + '"]').after(subQuestionHtml);
                }
            });
