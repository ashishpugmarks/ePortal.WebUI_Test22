            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            var myData = {
                OPERATION: dID,
            };
            $.ajax({
                type: "POST",
                url: "/SurveyConfiguration/BindDivisionByOperationId",
                data: JSON.stringify(myData),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                processdata: true,
                traditional: true,
                success: function (data) {
                    var select = $("#fnDivision");
                    select.empty();
                    if (data.length == 0) {
                        select.append($('<option/>', {
                            value: 0,
                            text: "--No record--"
                        }));
                    }
                    $.each(data, function (index, itemData) {
                        select.append($('<option/>', {
                            value: itemData.ADDIVISIONID,
                            text: itemData.DESCRIP
                        }));
                    });
                    select.multiselect('rebuild');
                    $('.multiselect-container').css('max-height', '180');
                    $('.multiselect-container').css('margin-top', '-213');
                }
            });
        }

        function openSurveyPreview() {
            if ($('table #tblQuestionlist tr').length == 0) {
                sweetAlert("", "Please add at least one question.", "warning");
                return;
            }
            if ($('#surveyId').val() == -1) {
                sweetAlert("", "Something went wrong.", "warning");
                return;
            }
            var surveyId = $('#surveyId').val();
            var url = '@Url.Action("SurveyPreview", "SurveyConfiguration", new { id = "__surveyId__" })';
            url = url.replace('__surveyId__', surveyId);
            $.fancybox.open({
                href: url,
                type: 'iframe',
                padding: 2,
                //maxWidth: 600,
                maxHeight: 500,
                fitToView: false,
                width: '80%',
                height: '800',
                autoSize: false,
                closeClick: true,
                openEffect: 'elastic',
                openSpeed: 120,
                closeEffect: 'elastic',
                closeSpeed: 100,
                helpers: {
                    overlay: { closeClick: false }
                },
                afterLoad: function () {
                    var iframe = this.content[0]; // Get the iframe element from fancybox content

                    var iframeDocument = iframe.contentWindow.document;

                    $(iframeDocument).ready(function () {
                        $('.back-button-container', iframeDocument).hide();
                    });
                }
            });
        }
    </script>
    }
