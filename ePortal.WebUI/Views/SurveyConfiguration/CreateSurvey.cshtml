        function validateForm() {
            valid = true;
            $("#lblDesc").text('');
            $("#lblDescHindi").text('');
            $("#lblDescKannada").text('');
            $("#lblDescGujarati").text('');
            $("#lblDescJapanese").text('');

            if ($("#EnglishSurveyHeaderCheckbox").is(":checked")) {
                if ($("#HRSURVEYDESC").val() == "") {
                    $("#lblDesc").text('Survey Name is required');
                    $("#HRSURVEYDESC").focus();
                    valid = false;
                }
            }
            if ($("#HindiSurveyHeaderCheckbox").is(":checked")) {
                if ($("#HRSURVEYDESCHINDI").val() == "") {
                    $("#lblDescHindi").text('Survey Name is required');
                    $("#HRSURVEYDESCHINDI").focus();
                    valid = false;
                }
            }
            if ($("#KannadaSurveyHeaderCheckbox").is(":checked")) {
                if ($("#HRSURVEYDESCKANNADA").val() == "") {
                    $("#lblDescKannada").text('Survey Name is required');
                    $("#HRSURVEYDESCKANNADA").focus();
                    valid = false;
                }
            }
            if ($("#GujaratiSurveyHeaderCheckbox").is(":checked")) {
                if ($("#HRSURVEYDESCGUJARATI").val() == "") {
                    $("#lblDescGujarati").text('Survey Name is required');
                    $("#HRSURVEYDESCGUJARATI").focus();
                    valid = false;
                }
            }
            if ($("#JapaneseSurveyHeaderCheckbox").is(":checked")) {
                if ($("#HRSURVEYDESCJAPANESE").val() == "") {
                    $("#lblDescJapanese").text('Survey Name is required');
                    $("#HRSURVEYDESCJAPANESE").focus();
                    valid = false;
                }
            }

            $("#lblStart").text('');
             if ($("#HRSURVEYSTARTDATE_STRING").val() == "") {
                $("#lblStart").text('Start Date is required');
                valid = false;
            }
             if ($("#HRSURVEYSTARTDATE_STRING").val() == Date.now()) {
                $("#lblStart").text('Selected date must be greater than today date');
                valid = false;
            }
            $("#lblEnd").text('');
            if ($("#HRSURVEYENDDATE").val() == "") {
                $("#lblEnd").text('End Date is required');
                valid = false;
            }
            if (valid == true) {
                $("#HRSURVEYDESC").removeClass('field-validation-valid text-danger');
                 $("#HRSURVEYSTARTDATE_STRING").removeClass('field-validation-valid text-danger');
                 $("#HRSURVEYENDDATE_STRING").removeClass('field-validation-valid text-danger');
            }
            return valid;
        }

        function showTab(n) {
            var x = document.getElementsByClassName("tab");
            x[n].style.display = "block";
            if (n == 0) {
                document.getElementById("prevBtn").style.display = "none";
                $("#_back").show();
                $("#nextBtn").show();
                $("#_tbl").hide();
                //$("#previewButton").hide();
            } else {
                document.getElementById("prevBtn").style.display = "inline";
            }
            if (n == (x.length - 1)) {

                document.getElementById("nextBtn").innerHTML = "Submit";
                $("#nextBtn").addClass("_submit");
                $("#nextBtn").show();
                $("#_btn").show();
                $("#nextBtn").hide();
                $("#_tbl").show();
                $("#_back").hide();
                $("#surveyPreviewButton").show();
            } else {
                document.getElementById("nextBtn").innerHTML = "Save & Next";
                $("#nextBtn").removeClass('_submit');
                $("#_btn").hide();
                $("#surveyPreviewButton").hide();
            }
            fixStepIndicator(n)
        }

