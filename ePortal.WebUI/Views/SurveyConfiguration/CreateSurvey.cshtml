                                            <img src="~/images/1252993713_information-balloon.png" data-toggle="tooltip" title="In result based survey, result will send to participants over email." />
                                            Result based survey &nbsp;
                                            @Html.RadioButtonFor(model => model.HRSURVEYMODULETYPE, "RBS", new { @name = "rbtnSurveyModuleType", @style = "transform: scale(1.5);" })
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
