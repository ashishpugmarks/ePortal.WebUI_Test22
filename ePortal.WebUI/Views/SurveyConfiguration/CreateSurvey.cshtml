                                <table style="width:100%; height:30px; text-align:left;" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td style="padding-left:20px; font-weight:bold;">
                                            <img src="~/images/1252993713_information-balloon.png" data-toggle="tooltip" title="In feedback based survey, result will not be send to participants on email." />
                                            Feedback based survey &nbsp;
                                            @Html.RadioButtonFor(model => model.HRSURVEYMODULETYPE, "FBS", new { @name = "rbtnSurveyModuleType", @checked = "checked", @style = "transform: scale(1.5);" })
