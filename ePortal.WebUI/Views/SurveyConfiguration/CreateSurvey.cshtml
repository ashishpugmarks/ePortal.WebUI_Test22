        function BindQuestion(questionlist) {
            var html = '';

            $.each(questionlist, function (key, item) {
                var _status = item.Status == 1 ? '<p class="btn btn-success btn-xs">Active</p>' : '<p class="btn btn-danger btn-xs">De-active</p>';

                  if (item.ISSUBQUESTION == '0') {
                     html += '<tr class="parent-row" data-id="' + item.QusId + '">';
                     html += '<td onclick="toggleSubquestions(' + item.QusId + ')">';
                     if (item.isChildPresent == '1') {
                         html += '<i class="fa fa-chevron-down toggle-icon" style="cursor:pointer;"></i>'; // Right arrow (collapsed)
                     } else {
                         html += '';
                     }
                     html += (key + 1) + '</td>';  // Sl.No
                     html += '<td>' + (item.QUSDESCRIPTION || '') + '</td>';
                     html += '<td>' + (item.QUSDESCRIPTIONHINDI || '') + '</td>';
                     html += '<td>' + (item.QUSDESCRIPTIONKANNADA || '') + '</td>';
                     html += '<td>' + (item.QUSDESCRIPTIONGUJARATI || '') + '</td>';
                     html += '<td>' + (item.QUSDESCRIPTIONJAPANESE || '') + '</td>';
                     html += '<td class="text-center" style="align-content:center;">' + (item.ISSUBQUESTION == '1' ? '<p class="btn btn-success btn-xs">True</p>' : '<p class="btn btn-danger btn-xs">False</p>') + '</td>';
                     //html += '<td><input class="btn btn-warning btn-xs glyphicon glyphicon-edit" style="cursor: pointer;" type=button onClick="EditQuestionPopup(' + item.QusId + ', ' + item.SUBQUESTIONPARENTID + ')"value=Edit>' + ((item.ISSUBQUESTION == '1' || item.isChildPresent == '1') ? '' : '<input class="btn btn-warning btn-xs" style="cursor: pointer;margin: 5px;" type=button onClick=AddSubQuestionPopup(' + item.QusId + ') value="Add SubQuestion">') + '</td>'; //CR6927 : SR104766
                      //html += '<td><input class="btn btn-warning btn-xs glyphicon glyphicon-edit" style="cursor: pointer;" type=button onClick="EditQuestionPopup(' + item.QusId + ', ' + item.SUBQUESTIONPARENTID + ')"value=Edit> <input class="btn btn-warning btn-xs glyphicon glyphicon-edit" style="cursor: pointer;" type=button onClick="RemoveQuestion(' + item.QusId + ')" value=Delete> ' + ((item.ISSUBQUESTION == '1' || item.isChildPresent == '1') ? '' : '<input class="btn btn-warning btn-xs" style="cursor: pointer;margin: 5px;" type=button onClick=AddSubQuestionPopup(' + item.QusId + ') value="Add SubQuestion">') + '</td>'; //CR6927 : SR104766
                      html += '<td><input class="btn btn-warning btn-xs glyphicon glyphicon-edit" style="cursor: pointer;" type=button data-ctrl="edit-ques-btn" data-id="'+item.QusId+'" data-parentid="'+item.SUBQUESTIONPARENTID+'" value=Edit> <input class="btn btn-warning btn-xs glyphicon glyphicon-edit" style="cursor: pointer;" type=button data-ctrl="rem-ques-btn" data-id="'+item.QusId+'" value=Delete> ' + ((item.ISSUBQUESTION == '1' || item.isChildPresent == '1') ? '' : '<input class="btn btn-warning btn-xs" style="cursor: pointer;margin: 5px;" type=button data-ctrl="addsub-ques-btn" data-id="'+item.QusId+'" value="Add SubQuestion">') + '</td>'; //CR6927 : SR104766
                     html += '</tr>';
                 }
            });                 

            $('table #tblQuestionlist').html(html);

            $.each(questionlist, function (index, item) {
                if (item.ISSUBQUESTION == '1') {
                    var subQuestionHtml = '';
                    var parentSlNo = $('tr[data-id="' + item.SUBQUESTIONPARENTID + '"]').find('td:first').text();
                    var subQuestionSlNo = parentSlNo + '.' + 1;
