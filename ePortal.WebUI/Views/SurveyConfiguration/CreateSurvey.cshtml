                var japaneseText = $("#HRSURVEYDESCJAPANESE").val();

                var targetTextboxes = [];
                var selectedLanguages = [];
                if ($("#EnglishSurveyNameCheckbox").is(":checked")) {
                    selectedLanguages.push('en');
                    targetTextboxes.push({ lang: 'en', id: 'HRSURVEYDESC' });
                }
                if ($("#HindiSurveyNameCheckbox").is(":checked")) {
                    selectedLanguages.push('hi');
                    targetTextboxes.push({ lang: 'hi', id: 'HRSURVEYDESCHINDI' });
