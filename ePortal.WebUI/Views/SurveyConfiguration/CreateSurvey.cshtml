                if ($("#GujaratiSurveyNameCheckbox").is(":checked")) {
                    selectedLanguages.push('gu');
                    targetTextboxes.push({ lang: 'gu', id: 'HRSURVEYDESCGUJARATI' });
                }
                if ($("#JapaneseSurveyNameCheckbox").is(":checked")) {
                    selectedLanguages.push('ja');
