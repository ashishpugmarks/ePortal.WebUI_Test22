	<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
		var sessionTimeoutWarning = "1";
		var sessionTimeout = @idleTimeoutMinutes;
		var timeOnPageLoad = new Date();
		var sessionWarningTimer = null;
		var redirectToWelcomePageTimer = null;

		//For warning
		var sessionWarningTimer = setTimeout('SessionWarning', (parseInt(sessionTimeout) - parseInt(sessionTimeoutWarning))* 60 * 1000);

		//Session Warning
		function SessionWarning() {
			//minutes left for expiry
			var cTime = new Date();
			var minutesForExpiry =  (parseInt(sessionTimeout) - parseInt(sessionTimeoutWarning));
			var message = "Your session will expire in another " + sessionTimeoutWarning + " min(s) from now ie. "+ cTime.toLocaleString() +" . Do you want to extend the session?";
			answer = confirm(message);
			if(answer)
			{
				var currentTime = new Date();
				var timeForExpiry = timeOnPageLoad.setMinutes(timeOnPageLoad.getMinutes() + parseInt(sessionTimeout));
				if(Date.parse(currentTime) > timeForExpiry)
				{
					// swal({
					//     title: "",
					//     text: "Session expired",
					//     type: "warning",
					// });

					 swal({ title: "", text: "Sorry, Your session has expired. Please login again", type: "warning", },
						function (isConfirm) {
							if (isConfirm) { window.location='/TokenBridge/OldLogin'; }
						});
				}
				else
				{
					var img = new Image(1, 1);
					//img.src = '@Url.Content("~/aspxview/KeepSessionAlive.aspx")' + '?date='+ escape(new Date());
					 img.src = '@Url.Action("KeepSessionAlive", "Home")' + '?date=' + encodeURIComponent(new Date());
					timeOnPageLoad =  new Date();
					sessionWarningTimer = setTimeout('SessionWarning()', (parseInt(sessionTimeout) - parseInt(sessionTimeoutWarning))* 60 * 1000);
				}
			}
			else
			{
				//if the session time is over. Then exit the session.
				var currentTime = new Date();
				var timeForExpiry = timeOnPageLoad.setMinutes(timeOnPageLoad.getMinutes() + parseInt(sessionTimeout));
				if(Date.parse(currentTime) > timeForExpiry)
				{
					// swal({
					//     title: "",
					//     text: "Session expired",
					//     type: "warning",
					// });

					 swal({ title: "", text: "Sorry, Your session has expired. Please login again", type: "warning", },
						function (isConfirm) {
							if (isConfirm) { window.location='/TokenBridge/OldLogin'; }
						});
				}
			}
		}

		$(document).ready(function () {
			$('.parentquestionchange').change(function () {				
				var selectedValue = $(this).val();
				var triggerId = $(this).data('trigger-id');
				var nextQuestionId = $(this).data('id');
				var questionId = $(this).data('question-id');

				triggerId = String(triggerId);
				var triggerIdsArray = triggerId.split(',');

				var shouldShow = false;

				// Check if any of the selected options match the trigger options
				triggerIdsArray.forEach(function (triggerOptionId) {
					if ($('.parentquestionchange[value="' + triggerOptionId + '"]:checked').length > 0) {
						shouldShow = true;
					}
				});

				if (shouldShow) {
					$('#' + nextQuestionId).removeClass('hidden');
					$('#h_' + nextQuestionId).val('ml-30');
				} else {
					$('#' + nextQuestionId).addClass('hidden');
					$('#h_' + nextQuestionId).val('hidden ml-30');

					// Clear selections if subquestion is hidden
					$('#' + nextQuestionId).find('input[type="radio"]:checked, input[type="checkbox"]:checked').prop('checked', false);
				}
			});

			// Trigger the change event for all elements to initialize visibility and selection on page load
			$('.parentquestionchange').each(function () {
				$(this).change();
			});
		});


	</script>
