	@using (Html.BeginForm("InformationSecuritySurvey", "SurveyConfiguration", FormMethod.Post, new { @onsubmit = "pleaseWait();", @id = "FormSurvey" }))
	{
		@Html.AntiForgeryToken()

		<div class="container">
			<div class="flex-row">
				<span for="language" class="mr-2">Preferred survey language:</span>
				<div class="card tabs">
					@if (!string.IsNullOrEmpty(Model.SurveyHeading))
					{
						<input id="tab-1" type="radio" class="tab tab-selector" name="tab" data-lan-value="English" />
						<label for="tab-1" class="tab tab-primary">English</label>
					}
					@if (!string.IsNullOrEmpty(Model.SurveyHeadingHindi))
					{
						<input id="tab-2" type="radio" class="tab tab-selector" name="tab" data-lan-value="Hindi" />
						<label for="tab-2" class="tab tab-success">Hindi</label>
					}
					@if (!string.IsNullOrEmpty(Model.SurveyHeadingKannada))
					{
						<input id="tab-3" type="radio" class="tab tab-selector" name="tab" data-lan-value="Kannada" />
						<label for="tab-3" class="tab tab-default">Kannada</label>
					}
					@if (!string.IsNullOrEmpty(Model.SurveyHeadingGujarati))
					{
						<input id="tab-4" type="radio" class="tab tab-selector" name="tab" data-lan-value="Gujarati" />
						<label for="tab-4" class="tab tab-warning">Gujarati</label>
					}
					@if (!string.IsNullOrEmpty(Model.SurveyHeadingJapanese))
					{
						<input id="tab-5" type="radio" class="tab tab-selector" name="tab" data-lan-value="Japanese" />
						<label for="tab-5" class="tab tab-warning">Japanese</label>
					}

				</div>

			</div>

			<div class="survey">
				@*Added against CR6225 - BY TTL*@
				@{
					string heading = Model.SurveyHeading ?? "";
					string pattern = @"(http[s]?://[^\s]+)";
					string linkedHeading = Regex.Replace(heading, pattern, "<a href=\"$1\" target=\"_blank\">$1</a>");
					string description = Model.SurveyDescription ?? "";
					@* Changed by TTl on 04-June-2025 against CR6478 - START *@
					string linkedDescription = Regex.Replace(description, pattern, "<a href=\"$1\" target=\"_blank\">$1</a>")
					.Replace("\r\n", "<br />")
					.Replace("\n", "<br />");
					//string linkedDescription = Regex.Replace(description, pattern, "<a href=\"$1\" target=\"_blank\">$1</a>");
					@* Changed by TTl on 04-June-2025 against CR6478 - END *@
				}
				@*Added against CR6225 - BY TTL*@
				<center><h2><b id="SurveyHeading">@Html.Raw(linkedHeading)</b></h2></center> @*Edited against CR - BY TTL - 01-05-2025*@
				<p style="font-weight:400;font-size:large" id="SurveyDescription">@Html.Raw(linkedDescription)</p> @*Added against CR - BY TTL - 01-05-2025*@
				@* Changed by TTl on 02-July-2025 against CR6641 - START *@
				<input type="hidden" name="SurveyHeading" value="@WebUtility.UrlEncode(Model.SurveyHeading)" />
				<input type="hidden" name="SurveyHeadingHindi" value="@WebUtility.UrlEncode(Model.SurveyHeadingHindi)" />
				<input type="hidden" name="SurveyHeadingKannada" value="@WebUtility.UrlEncode(Model.SurveyHeadingKannada)" />
				<input type="hidden" name="SurveyHeadingGujarati" value="@WebUtility.UrlEncode(Model.SurveyHeadingGujarati)" />
				<input type="hidden" name="SurveyHeadingJapanese" value="@WebUtility.UrlEncode(Model.SurveyHeadingJapanese)" />
				<input type="hidden" name="SurveyDescription" value="@WebUtility.UrlEncode(Model.SurveyDescription)" />
				<input type="hidden" name="SurveyDescriptionHindi" value="@WebUtility.UrlEncode(Model.SurveyDescriptionHindi)" />
				<input type="hidden" name="SurveyDescriptionKannada" value="@WebUtility.UrlEncode(Model.SurveyDescriptionKannada)" />
				<input type="hidden" name="SurveyDescriptionGujarati" value="@WebUtility.UrlEncode(Model.SurveyDescriptionGujarati)" />
				<input type="hidden" name="SurveyDescriptionJapanese" value="@WebUtility.UrlEncode(Model.SurveyDescriptionJapanese)" />
				@* Changed by TTl on 02-July-2025 against CR6641 - END *@
				@{
					var parentQuestions = Model.Questions.ToList();
				}
				@{
					var slno = 1;
					var previousParentSlNo = 0;
					var subQuestionCounter = 1;
				}

				@foreach (var parentQuestion in parentQuestions)
				{
					@*Added against CR6225 - BY TTL*@
					string questionDescription = parentQuestion.Description ?? "";
					string linkedQuestionDescription = Regex.Replace(questionDescription, pattern, "<a href=\"$1\" target=\"_blank\">$1</a>");
					@*Added against CR6225 - BY TTL*@

					var display = @parentQuestion.IsSubQuestion == 1 ? "hidden ml-30" : "";
					<div class="question @parentQuestion.IsVisible" id="@parentQuestion.Id" data-id="@parentQuestion.Id">
						@if (@parentQuestion.IsSubQuestion == 0)
						{
							previousParentSlNo = slno;
							@*<p class="sr-no question-description" data-slno="@slno">@slno. <b>@Html.Raw(parentQuestion.Description)</b></p>*@
							<p class="sr-no question-description" data-slno="@slno">@slno. <b>@Html.Raw(linkedQuestionDescription)</b></p> @*Edited against CR6225 - BY TTL on 01-05-2025*@
							slno++;
							subQuestionCounter = 1;
						}
						else
						{
							@*<p class="sr-no question-description" data-slno="@previousParentSlNo.@subQuestionCounter">@previousParentSlNo.@subQuestionCounter  <b>@Html.Raw(parentQuestion.Description)</b></p>*@
							<p class="sr-no question-description" data-slno="@previousParentSlNo.@subQuestionCounter">@previousParentSlNo.@subQuestionCounter  <b>@Html.Raw(linkedQuestionDescription)</b></p> @*Edited against CR6225 - BY TTL on 01-05-2025*@
							subQuestionCounter++;
						}
						<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].Id" value="@parentQuestion.Id" />

						<!-- Question description details -->
						<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].Description" value="@parentQuestion.Description" />
						<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].DescriptionHindi" value="@parentQuestion.DescriptionHindi" />
						<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].DescriptionKannada" value="@parentQuestion.DescriptionKannada" />
						<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].DescriptionGujarati" value="@parentQuestion.DescriptionGujarati" />
						<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].DescriptionJapanese" value="@parentQuestion.DescriptionJapanese" />

						<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].OptionType" value="@parentQuestion.OptionType" />
						<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].TriggerOptionIds" value="@parentQuestion.TriggerOptionIds" />
						<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].IsSubQuestion" value="@parentQuestion.IsSubQuestion" />
						<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].SubQuestionParentId" value="@parentQuestion.SubQuestionParentId" />
						<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].IsVisible" value="@parentQuestion.IsVisible" id="h_@parentQuestion.Id" />
						@foreach (var option in parentQuestion.Options)
						{
							var optionId = "q_" + parentQuestions.IndexOf(parentQuestion).ToString() + "_option_" + parentQuestion.Options.IndexOf(option);

							<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].Options[@parentQuestion.Options.IndexOf(option)].ANSDESCRIPTION" value="@option.ANSDESCRIPTION" />
							<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].Options[@parentQuestion.Options.IndexOf(option)].ANSDESCRIPTIONHINDI" value="@option.ANSDESCRIPTIONHINDI" />
							<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].Options[@parentQuestion.Options.IndexOf(option)].ANSDESCRIPTIONKANNADA" value="@option.ANSDESCRIPTIONKANNADA" />
							<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].Options[@parentQuestion.Options.IndexOf(option)].ANSDESCRIPTIONGUJARATI" value="@option.ANSDESCRIPTIONGUJARATI" />
							<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].Options[@parentQuestion.Options.IndexOf(option)].ANSDESCRIPTIONJAPANESE" value="@option.ANSDESCRIPTIONJAPANESE" />
							<input type="hidden" name="Questions[@parentQuestions.IndexOf(parentQuestion)].Options[@parentQuestion.Options.IndexOf(option)].HRSECURITYANSLISTID" value="@option.HRSECURITYANSLISTID" />

							<label for="@optionId" data-id="@option.HRSECURITYANSLISTID" class="option" style="margin-left:5px; font-weight:100;font-family:Verdana, Geneva, Tahoma, sans-serif;">
								@if (parentQuestion.OptionType == "1") // Radio Button
								{

									if (parentQuestion.SelectedOption == @option.HRSECURITYANSLISTID)
									{
										<input type="radio" id="@optionId" data-question-id="@parentQuestion.Id" data-id="@parentQuestion.SubQuestionParentId" data-trigger-id="@parentQuestion.TriggerOptionIds" name="Questions[@parentQuestions.IndexOf(parentQuestion)].SelectedOption" value="@option.HRSECURITYANSLISTID" checked="checked" data-isfamilydec="@option.ISFAMILYDECREQ" class="Rdbclass parentquestionchange" data-trigger="@parentQuestion.TriggerOptionIds" />
									}
									else
									{
										<input type="radio" id="@optionId" data-question-id="@parentQuestion.Id" data-id="@parentQuestion.SubQuestionParentId" data-trigger-id="@parentQuestion.TriggerOptionIds" name="Questions[@parentQuestions.IndexOf(parentQuestion)].SelectedOption" value="@option.HRSECURITYANSLISTID" data-isfamilydec="@option.ISFAMILYDECREQ" class="Rdbclass parentquestionchange" data-trigger="@parentQuestion.TriggerOptionIds" />
									}

								}
								else if (parentQuestion.OptionType == "2") // Checkbox
								{
									if (parentQuestion.SelectedOptions != null && parentQuestion.SelectedOptions.Contains(@option.HRSECURITYANSLISTID))
									{
										<input type="checkbox" id="@optionId" data-question-id="@parentQuestion.Id" data-id="@parentQuestion.SubQuestionParentId" data-trigger-id="@parentQuestion.TriggerOptionIds" name="Questions[@parentQuestions.IndexOf(parentQuestion)].SelectedOptions" value="@option.HRSECURITYANSLISTID" checked="checked" data-isfamilydec="@option.ISFAMILYDECREQ" class="Rdbclass parentquestionchange" data-trigger="@parentQuestion.TriggerOptionIds" />
									}
									else
									{
										<input type="checkbox" id="@optionId" data-question-id="@parentQuestion.Id" data-id="@parentQuestion.SubQuestionParentId" data-trigger-id="@parentQuestion.TriggerOptionIds" name="Questions[@parentQuestions.IndexOf(parentQuestion)].SelectedOptions" value="@option.HRSECURITYANSLISTID" data-isfamilydec="@option.ISFAMILYDECREQ" class="Rdbclass parentquestionchange" data-trigger="@parentQuestion.TriggerOptionIds" />
									}
								}
								else
								{
									if (parentQuestion.SelectedOption == @option.HRSECURITYANSLISTID)
									{
										<input type="radio" id="@optionId" data-question-id="@parentQuestion.Id" data-id="@parentQuestion.SubQuestionParentId" data-trigger-id="@parentQuestion.TriggerOptionIds" name="Questions[@parentQuestions.IndexOf(parentQuestion)].SelectedOption" value="@option.HRSECURITYANSLISTID" checked="checked" data-isfamilydec="@option.ISFAMILYDECREQ" class="Rdbclass parentquestionchange" data-trigger="@parentQuestion.TriggerOptionIds" />
									}
									else
									{
										<input type="radio" id="@optionId" data-question-id="@parentQuestion.Id" data-id="@parentQuestion.SubQuestionParentId" data-trigger-id="@parentQuestion.TriggerOptionIds" name="Questions[@parentQuestions.IndexOf(parentQuestion)].SelectedOption" value="@option.HRSECURITYANSLISTID" data-isfamilydec="@option.ISFAMILYDECREQ" class="Rdbclass parentquestionchange" data-trigger="@parentQuestion.TriggerOptionIds" />
									}
								}
								<label class="option-description" data-option-id="@option.HRSECURITYANSLISTID">@Html.Raw(option.ANSDESCRIPTION)</label>
							</label>

							<br />
						}
					</div>
				}
				<div class="remarks">
					<label id="lblremark" name="lblremark" style="font-weight:bold;font-family:Verdana, Geneva, Tahoma, sans-serif;">Any other feedback/remarks/improvement/change point to be mentioned</label>
				</div>
				<div class="remarks">
					<textarea id="txtremark" name="remark" onkeypress="return(this.value.length < 2000);" style="border-width:1px;border-style:solid;height:50px;width:500px;"></textarea>
				</div>
				<input type="hidden" id="hdSurveyNumber" name="SurveyNumber" value="@Model.SurveyNumber" />
				<input type="hidden" id="hdskipcount" name="skipcount" value="@Model.skipcount" />
				<input type="hidden" id="hdremarksstatus" name="FEEDBACKSTATUS" value="@Model.FEEDBACKSTATUS" />@*remarksstatus*@
				<input type="hidden" id="hdemailstatus" name="SURVEYRESULTMAIL" value="@Model.SURVEYRESULTMAIL" />@*emailstatus*@
				<input type="hidden" id="hdemailack" name="SURVEYACKMAIL" value="@Model.SURVEYACKMAIL" />@*emailack*@
				<input type="hidden" id="hdisremekmand" name="ISREMARKSMANDATORY" value="@Model.ISREMARKSMANDATORY" />@*isremekmand*@
				@*<center>@Html.ValidationSummary(true, "", new { @class = "text-danger" })</center>*@  <!-- Commented by Aumento as on 19-06-2024 -->
				<div class="buttons">
					<input type="button" id="btnSave" value="Submit">
					<input type="button" id="btnSkip" value="Skip">
				</div>
			</div>
			<div class="footer">
				<p>Copyright © 2018 Honda Motorcycle & Scooter India Pvt. Ltd. All rights reserved</p>
