		function AddMember() {

			var familyName = $('#txtFamilyName').val();
			var familyRelation = $('#txtFamilyRelation').val();
			var isPastOrCurrent = $('#ddliscurr').val();

			if (familyName === "" || familyRelation === "" || isPastOrCurrent === "") {
				swal("",'Employee Name, Relationship, and past or present status are mandatory.',"error");
				return false;
			}

			var data = {
				FamilyName: familyName,
				RelationShip: familyRelation,
				ISPastorCurrent: isPastOrCurrent
			};

			$.ajax({
				type: "POST",
				url: "/SurveyConfiguration/AddFamilyMember",
				contentType: "application/json; charset=utf-8",
				dataType: "json",
				data: JSON.stringify(data),
				success: function (response) {
					$('#txtFamilyName').val('');
					$('#txtFamilyRelation').val('');
					$('#ddliscurr').val('');
					var resData = JSON.parse(response);
					$("#divfamilydtl").empty();
					debugger;
					$.each(resData.data, function(index, item) {
						var row = `<tr>
									<td class="text-center">${item.FAMILYASSOCIATE_ID}</td>
									<td class="text-center">${item.FamilyName}</td>
									<td class="text-center">${item.RelationShip}</td>
									<td class="text-center">${item.ISPastorCurrent == 1 ? 'Present' : 'Past'}</td>
									<td class="text-center"><button type="button" class="btn btn-danger btn-sm" data-name="${item.addedby}" data-id="${item.FAMILYASSOCIATE_ID}" data-ctrl="rem-fam-mem" >Remove</button></td>
									</tr> `;
						$("#divfamilydtl").append(row);
					});
					swal('Added','Record Added Successfully.',"success");
				},
				error: function (xhr, status, error) {
					swal('Oops.', 'Something went wrong! ' + (xhr.responseText || error,"error"));
