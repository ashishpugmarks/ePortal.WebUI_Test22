<div id="ajaxLoader"></div>

@section Scripts {

	<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">

		$(document).ready(function ()
		{
			 initializeTables();

				 $(document).on('click', '[data-ctrl="edit-survey-btn"]', function (e) {
					 e.preventDefault();
						var id = $(this).data('id');
						var name = $(this).data('name');
						var perc = $(this).data('perc');
								openDetailPopup(id,name,perc);
					});


					$(document).on('click', '#quesReport', function () {
					 exportReport();
					});


					 $(document).on('click', '#cmdExport', function (e) {
						 e.preventDefault();



					  var formData = $('#searchForm').serialize();

			// Create a temporary form to trigger file download
			var $form = $('<form>', {
				action: '@Url.Action("ExportToExcel", "SurveyConfiguration")',
				method: 'POST'
			}).appendTo('body');

			// Add all filter inputs as hidden fields
			formData.split('&').forEach(function (param) {
				var pair = param.split('=');
				$('<input>').attr({
					type: 'hidden',
					name: decodeURIComponent(pair[0]),
					value: decodeURIComponent(pair[1])
				}).appendTo($form);
			});

			$form.submit();
			$form.remove();
					});


					$('#searchForm').on('submit', function (e) {
			e.preventDefault();

			$.ajax({
				url: '@Url.Action("InfoSecuReport", "SurveyConfiguration")',
				beforeSend: function () {
					$("#ajaxLoader").addClass('loader');
				},
				type: 'POST',
				data: $(this).serialize(),
				success: function (result) {
					$('#resultContainer').html(result);
					   initializeTables();
				},
				complete: function () {
					$("#ajaxLoader").removeClass('loader');
				},
				error: function () {
					alert('Something went wrong during search.');
				}
			});
		});

		});

		function initializeTables() {
			var $summary = $('#summaryTable');
			var $details = $('#detailTable');

			if ($.fn.DataTable.isDataTable($summary)) $summary.DataTable().destroy();
			if ($.fn.DataTable.isDataTable($details)) $details.DataTable().destroy();

			$summary.DataTable({ pageLength: 10,lengthChange: true,bFilter: true });
			$details.DataTable({ lengthChange: false,bFilter: false });
		}

		function exportReport() {
			strSurveyHeaderID = $('#SurveyId').val();
			 strLableText = $('#lblPleaseWait');

			if (strSurveyHeaderID == "0") {
				strLableText.show();
				strLableText.text("Kindly Select Survey For download the Report");
			}
			else {
				strLableText.show();
				strLableText.text("Survey Report Export in Progress");
				window.location = '/SurveyConfiguration/ExportSurveyReport?strSurveyHeaderID=' + strSurveyHeaderID;
				strLableText.text("Survey result report generated and saved in downloads folder in your system.");
			}
		}

		function openDetailPopup(id,name,perc) {
			debugger;
			var surveyId= $('#SurveyId').val();

					$.ajax({
						type: "GET",
						url: "/SurveyConfiguration/GetSurveyResult",
						data: {
							eCode: id,
							surveyId:surveyId
						},
						dataType: "json",
						success: function (data) {

							debugger;
		// Get values from UI
				// const associateName = $('#txtAssociateName').val();
				// const avgResult = $('#txtAvgResult').val();

				// Build the model object
				const model = {
					AssociateName: name,
					AvgResult: perc,
					QuestionList: data.map((row, index) => ({
						ROWNUM: row.ROWNUM || index + 1,
						QUSDESCRIPTION: row.QUSDESCRIPTION,
						SCORE: row.SCORE
					}))
				};

				// Populate the table
				let tableBody = '';

				$('#txtAssociate').html(name);
				$('#txtAvgResult').html(perc);

				if (model.QuestionList.length > 0) {
					model.QuestionList.forEach(item => {
						tableBody += `
							<tr>
								<td>${item.ROWNUM}</td>
								<td>${item.QUSDESCRIPTION}</td>
								<td>${item.SCORE}</td>
							</tr>`;
					});
				} else {
					tableBody = `<tr><td colspan="3" class="contenttableborder">No Record Found.</td></tr>`;
				}

				$('#modelBodyData').html(tableBody);
				$('#pnlBooking').show(); // Show the modal or panel


							$('#editModal').modal({ backdrop: "static" });
						},

		error: function (xhr, status, error) {
				console.error("AJAX Error:", status, error);
				console.log("Response Text:", xhr.responseText);
				sweetAlert("Oops...", "Something went wrong!", "error");
			}


					});
				}

		$(function () {

			// Load Divisions when Operation changes
			$('#ddlOperation').change(function () {
				var opId = $(this).val();
				$.getJSON('/SurveyConfiguration/GetDivisions', { operationId: opId }, function (data) {
					bindDropdown('#ddlDivision', data);
					// bindDropdown('#ddlDepartment', []);
					// bindDropdown('#ddlSection', []);
				});
			});

			// Load Departments when Division changes
			$('#ddlDivision').change(function () {
				var divId = $(this).val();
				$.getJSON('/SurveyConfiguration/GetDepartments', { divisionId: divId }, function (data) {
					bindDropdown('#ddlDepartment', data);
					// bindDropdown('#ddlSection', []);
				});
			});

			// Load Sections when Department changes
			$('#ddlDepartment').change(function () {
				var deptId = $(this).val();
				$.getJSON('/SurveyConfiguration/GetSections', { departmentId: deptId }, function (data) {
					bindDropdown('#ddlSection', data);
				});
			});

			function bindDropdown(selector, list) {
				debugger;
				var $ddl = $(selector);
				$ddl.empty();
				// $ddl.append($('<option/>').val('0').text('Select'));
				$.each(list, function (i, item) {
					$ddl.append($('<option/>').val(item.Value).text(item.Text));
				});
			}

		});
	</script>
}
