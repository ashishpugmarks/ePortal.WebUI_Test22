@model IEnumerable<ePortal.ViewModels.SurveyViewModel>

@{
    ViewBag.Title = "SurveyList";
    Layout = null;
}
<html>
<head>
    <style>

    </style>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        var arrayList = new Array();
        $(document).ready(function(){
            $("#tbGroupList").dataTable({
                "bFilter": true,
                "bLengthChange": true
            });
        })

    </script>
</head>
<body>
    <table id="tbGroupList" class="table table-bordered table-hover table-striped table-responsive" style="width:100%">
        <thead>
            <tr>
                <th class="text-center">
                    @Html.DisplayNameFor(model => model.HRSECURITYSURVEYID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.HRSURVEYDESC)
                </th>
                <th style="min-width:180px;">
                    Available Survey Language
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.HRSURVEYSTARTDATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.HRSURVEYENDDATE)
                </th>
                @*Survey enhancement start*@
                <th class="text-center">Status</th>
                @*Survey enhancement end*@
                <th class="text-center">
                    @Html.DisplayNameFor(model => model.RETEST)
                </th>
                <th class="text-center">@Html.DisplayName("Action")</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">
                        @i
                        @{
                            i++;
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.HRSURVEYDESC)
                    </td>
                    <td>
                        <div class="label-container">
                            @if (!string.IsNullOrEmpty(item.HRSURVEYDESC))
                            {
                                <span class="labelText">English</span>
                            }
                            @if (!string.IsNullOrEmpty(item.HRSURVEYDESCHINDI))
                            {
                                <span class="labelText">Hindi</span>
                            }
                            @if (!string.IsNullOrEmpty(item.HRSURVEYDESCKANNADA))
                            {
                                <span class="labelText">Kannada</span>
                            }
                            @if (!string.IsNullOrEmpty(item.HRSURVEYDESCGUJARATI))
                            {
                                <span class="labelText">Gujarati</span>
                            }
                            @if (!string.IsNullOrEmpty(item.HRSURVEYDESCJAPANESE))
                            {
                                <span class="labelText">Japanese</span>
                            }
                        </div>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.HRSURVEYSTARTDATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.HRSURVEYENDDATE)
                    </td>
                    @*Survey enhancement start*@
                    <td class="text-center">
                        @{
                            if (item.ACTIVE == 1)
                            {
                                <span style="color: white; background: #0f940d; border-radius: 20px; padding: 3px 20px;">Active</span>
                            }
                            else if (item.ACTIVE == 0)
                            {
                                <span style="color: white; background: #f17373; border-radius: 20px; padding: 3px 20px; ">Inactive</span>
                            }
                            else
                            {
                                <span style="color: white; background: #3498db; border-radius: 20px; padding: 3px 20px;">Draft</span>
                            }
                        }
                    </td>
                    @*Survey enhancement end*@
                    <td style="width:8%" class="text-center">                     


                        @if (item.HRSURVEYENDDATE >= DateTime.Now.Date)
                        {
                            @* <button class="btn btn-default btn-xs glyphicon glyphicon-eye-open _disble" title="Survey end date is greater then or equal to today so you can not initiate re-test." onClick="window.location.href = '#'"></button> *@
                            <button class="btn btn-default btn-xs glyphicon glyphicon-eye-open _disble" title="Survey end date is greater then or equal to today so you can not initiate re-test."></button>

                        }
                        else if (item.RETEST != 1 && item.HRSURVEYENDDATE < DateTime.Now.Date)
                        {
                            @*<button class="btn btn-default btn-xs glyphicon glyphicon-eye-open" title="Click to view" onClick="window.location.href = '@Url.Action("SurveyReTest", "SurveyConfiguration", new { id = item.HRSECURITYSURVEYID })'"></button>*@
                            <button class="btn btn-default btn-xs glyphicon glyphicon-eye-open" data-ctrl="view-booking-btn" data-id="@item.HRSECURITYSURVEYID" title="Click to view"></button>
                        }
                        else
                        {
                            <button class="btn btn-success btn-xs" style="cursor: text !important">ReTest Complete</button>
                        }
                    </td>
                    <td style="width:8%" class="text-center">                    

                        @if (item.RETEST == 1)
                        {
                            <button class="btn btn-warning btn-xs glyphicon glyphicon-edit _disble" data-ctrl="edit-booking-btn" data-id="@item.HRSECURITYSURVEYID"></button>
                            <button class="btn btn-info btn-xs glyphicon glyphicon-list-alt" data-ctrl="preview-booking-btn" data-id="@item.HRSECURITYSURVEYID"></button>
                        }
                        else
                        {
                            <button class="btn btn-warning btn-xs glyphicon glyphicon-edit" data-ctrl="edit-booking-btn" data-id="@item.HRSECURITYSURVEYID"></button>
                            <button class="btn btn-info btn-xs glyphicon glyphicon-list-alt" data-ctrl="preview-booking-btn" data-id="@item.HRSECURITYSURVEYID"></button>
                        }
                    </td>
                </tr>
            }
        </tbody>

    </table>
</body>
</html>
