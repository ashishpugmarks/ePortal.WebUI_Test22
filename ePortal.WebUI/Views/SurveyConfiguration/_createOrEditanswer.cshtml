		$('#collapseAnswerForm').on('show.bs.collapse', function () {
			$('#toggle-icon-answer').removeClass('glyphicon-chevron-down').addClass('glyphicon-chevron-up');
		});

		$('#collapseAnswerForm').on('hide.bs.collapse', function () {
			$('#toggle-icon-answer').removeClass('glyphicon-chevron-up').addClass('glyphicon-chevron-down');
		});
	</script>
</head>
<body>
	<div class="row">
		<div class="body-content">
			<div class="form-horizontal">
				@Html.ValidationSummary(true, "", new { @class = "text-danger" })
				@if (Model.ISSUBQUESTION == 1 && Model.SUBQUESTIONPARENTID != null)
				{
					@Html.HiddenFor(model => model.SUBQUESTIONPARENTID, htmlAttributes: new { @id = "_hfQusParentId" })
					@Html.HiddenFor(model => model.ISSUBQUESTION, htmlAttributes: new { @id = "ISSUBQUESTION" })
					<div class="panel panel-default">
						<div class="panel-heading">
							<h3 class="panel-title">
								Parent Question Descriptions
								<span class="pull-right">
									<a data-toggle="collapse" aria-expanded="true" href="#collapseParentQuestionForm" aria-controls="collapseParentQuestionForm">
										<i class="glyphicon glyphicon-chevron-down" id="toggle-icon-parentquestion"></i>
									</a>
								</span>
							</h3>
						</div>
						<div id="collapseParentQuestionForm" class="panel-collapse collapse in">
							<div class="panel-body">
								<div class="form-group">
									<div class="row">
										<label style="margin-left: 30px; font-weight: 100; font-family: Verdana, Geneva, Tahoma, sans-serif; padding-top: 10px; font-size: 20px; ">
											@Model.PARENTQUSDESCRIPTION
										</label>
									</div>
								</div>
								<div class="form-group">
									<div class="row">
										@{
											var triggerOptionIds = string.IsNullOrEmpty(Model.TRIGGEROPTIONIDS) ? new List<string>() : Model.TRIGGEROPTIONIDS.Split(',').Select(x => x.Trim()).ToList();
										}

										@for (int j = 0; j < Model.ParentMappingList.Count; j++)
										{
											var option = Model.ParentMappingList[j];
											bool isChecked = triggerOptionIds.Contains(option.AnsId.ToString());
											<div class="col-md-12">
												<label>
													<input type="checkbox" name="ParentOptions" value="@option.AnsId" style="margin: 10px 8px 0px 20px; transform: scale(1.5); " class="parent-option-checkbox" @if (isChecked)
													{
														<text> checked</text>
													} /> @option.ANSDESCRIPTION
												</label>
											</div>
										}
										<label class="text-danger" id="lblParentOpionValidationDesc" style="margin-left:30px; margin-top:10px;"></label>
									</div>
								</div>
							</div>
						</div>
					</div>
				}
				<div class="panel panel-default">
					<div class="panel-heading">
						<h3 class="panel-title">
							Question Descriptions
							<span class="pull-right">
								<a data-toggle="collapse" aria-expanded="true" href="#collapseQuestionForm" aria-controls="collapseQuestionForm">
									<i class="glyphicon glyphicon-chevron-down" id="toggle-icon-question"></i>
								</a>
							</span>
						</h3>
					</div>
					<div id="collapseQuestionForm" class="panel-collapse collapse in">
						<div class="panel-body">

							<div class="form-group">
								<div class="col-md-3" style="font-weight:bold;">Selected languages</div>
								<div class="col-md-9">
									<label><input type="checkbox" name="English" id="EnglishSurveyQuestionCheckbox" style="margin: 0px 10px; transform: scale(1.5);" disabled>English</label>
									<label><input type="checkbox" name="Hindi" id="HindiSurveyQuestionCheckbox" style="margin: 0px 10px; transform: scale(1.5);" disabled>Hindi</label>
									<label><input type="checkbox" name="Kannada" id="KannadaSurveyQuestionCheckbox" style="margin: 0px 10px; transform: scale(1.5);" disabled>Kannada</label>
									<label><input type="checkbox" name="Gujarati" id="GujaratiSurveyQuestionCheckbox" style="margin: 0px 10px; transform: scale(1.5);" disabled>Gujarati</label>
									<label><input type="checkbox" name="Japanese" id="JapaneseSurveyQuestionCheckbox" style="margin: 0px 10px; transform: scale(1.5);" disabled>Japanese</label>
									@if (ViewBag.IsActive != null ? ViewBag.IsActive : false)
									{
										<button class="btn btn-success" id="autoFillOtherSurveyQuestion" title="Convert" style="margin-left: 10px;">AutoFill</button>
									}
								</div>
							</div>

							<div class="form-group">
								<div class="row">
									@Html.LabelFor(model => model.QUSDESCRIPTION, htmlAttributes: new { @class = "control-label col-md-2" })
									<div class="col-md-10" style="padding-right:30px;">
										@Html.HiddenFor(model => model.QusId, htmlAttributes: new { @id = "_hfQusId" })
										@Html.TextAreaFor(model => model.QUSDESCRIPTION, new { @class = "form-control" })
										@Html.ValidationMessageFor(model => model.QUSDESCRIPTION, "", new { @class = "text-danger", @id = "lblQuestionDesc" })
									</div>
								</div>
							</div>
							<div class="form-group">
								<div class="row">
									<div class="col-md-6">
										@Html.LabelFor(model => model.QUSDESCRIPTIONHINDI, htmlAttributes: new { @class = "control-label col-md-4" })
										<div class="col-md-8">
											@*@Html.HiddenFor(model => model.QusId, htmlAttributes: new { @id = "_hfQusId" })*@
											@Html.TextAreaFor(model => model.QUSDESCRIPTIONHINDI, new { @class = "form-control" })
											@Html.ValidationMessageFor(model => model.QUSDESCRIPTIONHINDI, "", new { @class = "text-danger", @id = "lblQuestionDescHindi" })
										</div>
									</div>
									<div class="col-md-6">
										@Html.LabelFor(model => model.QUSDESCRIPTIONKANNADA, htmlAttributes: new { @class = "control-label col-md-4" })
										<div class="col-md-8">
											@*@Html.HiddenFor(model => model.QusId, htmlAttributes: new { @id = "_hfQusId" })*@
											@Html.TextAreaFor(model => model.QUSDESCRIPTIONKANNADA, new { @class = "form-control" })
											@Html.ValidationMessageFor(model => model.QUSDESCRIPTIONKANNADA, "", new { @class = "text-danger", @id = "lblQuestionDescKannada" })
										</div>
									</div>

								</div>
							</div>

							<div class="form-group">
								<div class="row">
									<div class="col-md-6">
										@Html.LabelFor(model => model.QUSDESCRIPTIONGUJARATI, htmlAttributes: new { @class = "control-label col-md-4" })
										<div class="col-md-8">
											@*@Html.HiddenFor(model => model.QusId, htmlAttributes: new { @id = "_hfQusId" })*@
											@Html.TextAreaFor(model => model.QUSDESCRIPTIONGUJARATI, new { @class = "form-control" })
											@Html.ValidationMessageFor(model => model.QUSDESCRIPTIONGUJARATI, "", new { @class = "text-danger", @id = "lblQuestionDescGujarati" })
										</div>
									</div>
									<div class="col-md-6">
										@Html.LabelFor(model => model.QUSDESCRIPTIONJAPANESE, htmlAttributes: new { @class = "control-label col-md-4" })
										<div class="col-md-8">
											@*@Html.HiddenFor(model => model.QusId, htmlAttributes: new { @id = "_hfQusId" })*@
											@Html.TextAreaFor(model => model.QUSDESCRIPTIONJAPANESE, new { @class = "form-control" })
											@Html.ValidationMessageFor(model => model.QUSDESCRIPTIONJAPANESE, "", new { @class = "text-danger", @id = "lblQuestionDescJapanese" })
										</div>
									</div>
								</div>
							</div>
							<div class="form-group">
								<div class="row">
									<div class="col-md-6">
										<div class="col-md-4">
											<label>Option type</label>
										</div>
										<div class="col-md-8">
											<input type="radio" name="option-type" value="radio" id="radio-option" style="margin:0px 5px; transform: scale(1.5);"> Radio
											<input type="radio" name="option-type" value="checkbox" id="checkbox-option" style="margin: 0px 5px; transform: scale(1.5);"> Checkbox
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="panel panel-default">
					<div class="panel-heading">
						<h3 class="panel-title">
							Answer Descriptions
							<span class="pull-right">
								<a data-toggle="collapse" aria-expanded="true" href="#collapseAnswerForm" aria-controls="collapseAnswerForm">
									<i class="glyphicon glyphicon-chevron-down" id="toggle-icon-answer"></i>
								</a>
							</span>
						</h3>
					</div>
					<div id="collapseAnswerForm" class="panel-collapse collapse in">
						<div class="panel-body">
							<div class="form-group">
								<div class="col-md-3" style="font-weight:bold;">Selected languages</div>
								<div class="col-md-9">
									<label><input type="checkbox" name="English" id="EnglishSurveyAnswerCheckbox" style="margin: 0px 10px; transform: scale(1.5);" disabled>English</label>
									<label><input type="checkbox" name="Hindi" id="HindiSurveyAnswerCheckbox" style="margin: 0px 10px; transform: scale(1.5);" disabled>Hindi</label>
									<label><input type="checkbox" name="Kannada" id="KannadaSurveyAnswerCheckbox" style="margin: 0px 10px; transform: scale(1.5);" disabled>Kannada</label>
									<label><input type="checkbox" name="Gujarati" id="GujaratiSurveyAnswerCheckbox" style="margin: 0px 10px; transform: scale(1.5);" disabled>Gujarati</label>
									<label><input type="checkbox" name="Japanese" id="JapaneseSurveyAnswerCheckbox" style="margin: 0px 10px; transform: scale(1.5);" disabled>Japanese</label>
									@if (ViewBag.IsActive != null ? ViewBag.IsActive : false)
									{
										<button class="btn btn-success" id="autoFillOtherSurveyAnswer" title="Convert" style="margin-left: 10px;">AutoFill</button>
									}
								</div>
							</div>
							<div class="form-group">
								<div class="row">
									@Html.LabelFor(model => model.ANSDESCRIPTION, htmlAttributes: new { @class = "control-label col-md-2" })
									<div class="col-md-10" style="padding-right:30px;">
										<input type="hidden" id="hfAnsId" value="0" />
										@Html.TextAreaFor(model => model.ANSDESCRIPTION, new { @class = "form-control" })
										@Html.ValidationMessageFor(model => model.ANSDESCRIPTION, "", new { @class = "text-danger", @id = "lblAnswerDesc" })
									</div>
								</div>
							</div>

							<div class="form-group">
								<div class="row">
									<div class="col-md-6">
										@Html.LabelFor(model => model.ANSDESCRIPTIONHINDI, htmlAttributes: new { @class = "control-label col-md-4" })
										<div class="col-md-8">
											@*@Html.HiddenFor(model => model.QusId, htmlAttributes: new { @id = "_hfQusId" })*@
											@Html.TextAreaFor(model => model.ANSDESCRIPTIONHINDI, new { @class = "form-control" })
											@Html.ValidationMessageFor(model => model.ANSDESCRIPTIONHINDI, "", new { @class = "text-danger", @id = "lblAnswerDescHindi" })
										</div>
									</div>
									<div class="col-md-6">
										@Html.LabelFor(model => model.ANSDESCRIPTIONKANNADA, htmlAttributes: new { @class = "control-label col-md-4" })
										<div class="col-md-8">
											@*@Html.HiddenFor(model => model.QusId, htmlAttributes: new { @id = "_hfQusId" })*@
											@Html.TextAreaFor(model => model.ANSDESCRIPTIONKANNADA, new { @class = "form-control" })
											@Html.ValidationMessageFor(model => model.ANSDESCRIPTIONKANNADA, "", new { @class = "text-danger", @id = "lblAnswerDescKannada" })
										</div>
									</div>

								</div>
							</div>

							<div class="form-group">
								<div class="row">
									<div class="col-md-6">
										@Html.LabelFor(model => model.ANSDESCRIPTIONGUJARATI, htmlAttributes: new { @class = "control-label col-md-4" })
										<div class="col-md-8">
											@*@Html.HiddenFor(model => model.QusId, htmlAttributes: new { @id = "_hfQusId" })*@
											@Html.TextAreaFor(model => model.ANSDESCRIPTIONGUJARATI, new { @class = "form-control" })
											@Html.ValidationMessageFor(model => model.ANSDESCRIPTIONGUJARATI, "", new { @class = "text-danger", @id = "lblAnswerDescGujarati" })
										</div>
									</div>
									<div class="col-md-6">
										@Html.LabelFor(model => model.ANSDESCRIPTIONJAPANESE, htmlAttributes: new { @class = "control-label col-md-4" })
										<div class="col-md-8">
											@*@Html.HiddenFor(model => model.QusId, htmlAttributes: new { @id = "_hfQusId" })*@
											@Html.TextAreaFor(model => model.ANSDESCRIPTIONJAPANESE, new { @class = "form-control" })
											@Html.ValidationMessageFor(model => model.ANSDESCRIPTIONJAPANESE, "", new { @class = "text-danger", @id = "lblAnswerDescJapanese" })
										</div>
									</div>

								</div>
							</div>

							<div class="form-group">
								<div class="row">
									<div class="col-md-12">
										@Html.LabelFor(model => model.ISCORRECT, htmlAttributes: new { @class = "control-label col-md-2" })
										<div class="col-md-1">
											@Html.CheckBox("ISCORRECT", new { @class = "form-control" })
											@Html.ValidationMessageFor(model => model.ISCORRECT, "", new { @class = "text-danger", @id = "lblAnswerDesc" })
											<img src="~/images/1252993713_information-balloon.png" data-toggle="tooltip" title="Tick for correct answer only" />
										</div>
										@Html.LabelFor(model => model.Status, htmlAttributes: new { @class = "control-label col-md-2" })
										<div class="col-md-1">
											@Html.CheckBox("Status", new { @class = "form-control", @checked = true })
											@Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger", @id = "lblAnswerDesc" })
											<img src="~/images/1252993713_information-balloon.png" data-toggle="tooltip" title="If you want to visible answer to participants then tick mark status" />
										</div>
										@{
											if (Model.ISHCGSURVEY)
											{
												@Html.LabelFor(model => model.ISFAMILYDECREQ, htmlAttributes: new { @class = "control-label col-md-4" })
												<div class="col-md-1">
													@Html.CheckBox("ISFAMILYDECREQ", new { @class = "form-control", @id = "ISFAMILYDECREQ" })
													<img src="~/images/1252993713_information-balloon.png" data-toggle="tooltip" title="Tick on check box if you want declaration of family member from associates." />

												</div>
											}
											else
											{
												@Html.LabelFor(model => model.ISFAMILYDECREQ, htmlAttributes: new { @class = "control-label col-md-4" })
												<div class="col-md-1">
													@Html.CheckBox("ISFAMILYDECREQ", new { @class = "form-control", @id = "ISFAMILYDECREQ", @disabled = "true" })
													<img src="~/images/1252993713_information-balloon.png" data-toggle="tooltip" title="It is disbled since in previous step you were not declared that it is HCG Survey." />

												</div>
											}
										}
									</div>
								</div>
							</div>

						</div>
					</div>
				</div>
			</div>

			<div class="form-group">
				<div class="row">
					<div class="col-md-12 text-center">
						<input type="submit" value="Add Answer" id="BtnClick" class="btn btn-success btn-xs" />
					</div>
				</div>
			</div>
			@*</div>*@

			<div style="overflow-x: auto;">
				<table class="table table-bordered table-responsive">
					@*id="_tbl"*@
					<thead>
						<tr class="info">
							<th colspan="10">
								<b class="pull-left">
									Answer List
								</b>
							</th>
						<tr>
							<th>
								S.No.
							</th>
							<th>
								Answer(English)
							</th>
							<th>
								Answer(Hindi)
							</th>
							<th>
								Answer(Kannada)
							</th>
							<th>
								Answer(Gujarati)
							</th>
							<th>
								Answer(Japanese)
							</th>
							<th>
								Status
							</th>
							<th>
								Is Correct
							</th>
							<th colspan="2">
								Is Family Decl. Req
							</th>
						</tr>
					</thead>
					<tbody id="tblQuestion"></tbody>
				</table>
			</div>

			<div class="row">
				<div class="col-md-12 text-center">
					@* <input type="button" onclick="_fromSubmit();" id="_btn" value="Submit" class="btn btn-primary _Submitform" /> *@
					<input type="button" id="btnSubmitCOE" value="Submit" class="btn btn-primary _Submitform" />
				</div>
			</div>
		</div>
	</div>
</body>
</html>
