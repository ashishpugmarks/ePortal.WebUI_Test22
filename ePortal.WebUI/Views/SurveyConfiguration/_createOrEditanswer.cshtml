			function translateText(inputText, sourceLang, targetTextboxes) {
				var elementMyModal = $("#myModal");
				var elementLoadingModal = $("#loadingModal");

				elementMyModal.css("z-index", 100);
				elementLoadingModal.css("background-color", "rgba(0, 0, 0, 0)");

				$("#loadingmodal").show();
				var totalRequests = targetTextboxes.length;
				var completedRequests = 0;

				targetTextboxes.forEach(function (textbox) {
					$.ajax({
						url: "/SurveyConfiguration/TextDataAutofill",
						data: { text: inputText, targetLang: textbox.lang },
						type: "POST",
						success: function (response) {
							var data = JSON.parse(response.translatedText);
							$(`#${textbox.id}`).val(data[0][0]);
						},
						error: function () {
							sweetAlert("Error while translating text.");
						},
						complete: function () {
							completedRequests++;

							if (completedRequests === totalRequests) {
								$("#loadingmodal").hide();
								elementMyModal.css("z-index", 99999);
								elementLoadingModal.css("background-color", "rgba(0, 0, 0, 0.5)");
							}
						}
					});
				});
			}

