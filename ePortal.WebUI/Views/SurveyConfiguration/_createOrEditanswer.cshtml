		function binddata() {
			var html = '';
			if(arrayList != null || arrayList != undefined){
				var Sl =1;
				$.each(arrayList, function (key, item) {
					// var _correct = item.ISCORRECT == true ? 1: 0;
					var _correct = item.ISCORRECT;
					var d= item.ISCORRECT == 1 ? '<p class="btn btn-success btn-xs">Correct</p>' : '<p class="btn btn-danger btn-xs">Wrong</p>';
					// var _status= item.Status == true ? '<p class="btn btn-success btn-xs">Active</p>' : '<p class="btn btn-danger btn-xs">De-active</p>';
					var _status= item.Status == 1 ? '<p class="btn btn-success btn-xs">Active</p>' : '<p class="btn btn-danger btn-xs">De-active</p>';
					var _FDec = item.ISFAMILYDECREQ == true ? '<p class="btn btn-success btn-xs">Yes</p>' : '<p class="btn btn-danger btn-xs">No</p>';
					var _ISFAMILYDECREQ = item.ISFAMILYDECREQ == true ? 1 : 0;
					html += '<tr>';
					html += '<td>' + Sl++;  + '</td>';
					html += '<td>' + (item.ANSDESCRIPTION || '') + '</td>';
					html += '<td>' + (item.ANSDESCRIPTIONHINDI || '') + '</td>';
					html += '<td>' + (item.ANSDESCRIPTIONKANNADA || '')+ '</td>';
					html += '<td>' + (item.ANSDESCRIPTIONGUJARATI || '')+ '</td>';
					html += '<td>' + (item.ANSDESCRIPTIONJAPANESE || '') + '</td>';
					html += '<td>' + _status + '</td>';
					html += '<td>' + d + '</td>';
					html += '<td>' + _FDec + '</td>';
					html += '<td>' + '<button class="btn btn-warning btn-xs glyphicon glyphicon-edit" title="Click to edit" data-defaultValue =' + _correct + '  data-name-english="' + (item.ANSDESCRIPTION || '') + '" data-name-hindi="' + (item.ANSDESCRIPTIONHINDI || '') + '" data-name-kannada="' + (item.ANSDESCRIPTIONKANNADA || '') + '" data-name-gujarati="' + (item.ANSDESCRIPTIONGUJARATI || '') + '" data-name-japanese="' + (item.ANSDESCRIPTIONJAPANESE || '') + '" data-id=' + item.AnsId + ' data-ctrl="edit-coe-btn" ' + 'data-ISFamilyDec =' + _ISFAMILYDECREQ + '></button>' + '</td>';
					html += '</tr>'
				});
				$('table #tblQuestion').html(html);
				$("#ANSDESCRIPTION").val('');
				$("#ANSDESCRIPTIONHINDI").val('');
				$("#ANSDESCRIPTIONKANNADA").val('');
				$("#ANSDESCRIPTIONGUJARATI").val('');
				$("#ANSDESCRIPTIONJAPANESE").val('');
				$("#ISCORRECT")[0].checked = false;
				$("#ISFAMILYDECREQ")[0].checked = false;
			}
		}

