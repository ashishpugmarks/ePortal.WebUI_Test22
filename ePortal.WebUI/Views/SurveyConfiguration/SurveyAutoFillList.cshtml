@model IEnumerable<ePortal.ViewModels.SurveyAutofillViewModel>
@{
	ViewBag.Title = "SurveyAutoFillList";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
	<link href="~/css/select2.min.css" rel="stylesheet" />
	<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
		table.dataTable thead th, table.dataTable thead td {
			padding: 8px 12px;
		}

		.table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
			line-height: 1.0;
			vertical-align: middle;
			font-family: "Helvetica Neue", Helvetica, Arial;
		}

		table.dataTable tbody td {
			padding: 4px 3px;
		}

		.table > tbody > tr:nth-of-type(even) {
			background: #e9e9e9;
		}

		#closeButton {
			float: right;
			font-size: 30px;
			font-weight: 700;
			line-height: 1;
			color: #000;
			text-shadow: 0 1px 0 #fff;
			opacity: .8
		}

		#spanDataFontSize {
			font-size: smaller;
		}

		#headerRow th {
			text-align: center;
		}

		/*#inputEmployeeDetail {
						max-height: 200px;*/ /* Limit the height */
		/*overflow-y: auto;*/ /* Enable vertical scrolling if options exceed max height */
		/*width: 100%;*/ /* Optional: Set the width to fit your needs */
		/*}*/

		/*    .select2-container--default .select2-dropdown {
						z-index: 9999999 !important;
					}


					#inputEmployeeDetail {
						width: 100%!important;
						z-index: 9999999 !important;
					}*/

		.select2-container--default .select2-results__option {
			font-size: 16px !important; /* Adjust the font size as per your requirement */
		}

		.select2-container {
			width: 100% !important;
			padding: 0;
		}



		@*<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />*@
	</style>
}


<div class="row">
	<div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
		<span style="padding-left: 10px;">Survey Autofill List</span>
	</div>

	<div class="body-content" style="overflow:auto!important">
		<table id="tbGroupList" class="table table-bordered table-hover table-striped table-responsive" style="width:100%">
			<thead>
				<tr class="info">
					<td colspan="5">
						<b class="pull-left">
							Survey Autofill List
						</b>
						<b class="pull-right">
							<button class="btn btn-primary btn-xs" id="btnMapNew">Map New User</button>
						</b>
					</td>
				</tr>
				<tr id="headerRow">
					<th class="text-center">
						@Html.DisplayNameFor(model => model.AUTOFILLID)
					</th>
					<th class="text-center">
						@Html.DisplayNameFor(model => model.EMPLOYEECODE)
					</th>
					<th class="text-center">
						@Html.DisplayNameFor(model => model.EMPLOYEENAME)
					</th>
					<th class="text-center"> @Html.DisplayNameFor(model => model.STATUS)</th>
					<th class="text-center">Action</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr id="row_@item.AUTOFILLID">
						<td class="text-center">
							@Html.DisplayFor(modelItem => item.AUTOFILLID)
						</td>
						<td class="text-center">
							@Html.DisplayFor(modelItem => item.EMPLOYEECODE)
						</td>
						<td class="text-center">
							@Html.DisplayFor(modelItem => item.EMPLOYEENAME)
						</td>
						<td class="text-center">
							<span id="statusText_@item.AUTOFILLID">@(item.STATUS == 1 ? "On" : "Off")</span>
							<select class="form-control" id="statusDropdown_@item.AUTOFILLID" style="display:none;">
								<option value="1" selected="@(item.STATUS == 1 ? "selected" : null)">On</option>
								<option value="0" selected="@(item.STATUS == 0 ? "selected" : null)">Off</option>

								@*  <option value="1" @(item.STATUS == '1' ? "selected" : "")>On</option>
                                <option value="0" @(item.STATUS == '0' ? "selected" : "")>Off</option> *@
							</select>
						</td>
						<td style="width:8%" class="text-center">
							<button class="btn btn-warning btn-xs glyphicon glyphicon-edit" data-ctrl="edit-btn" data-id="@item.AUTOFILLID"></button>
							<button class="btn btn-success btn-xs" style="display:none;" id="updateBtn_@item.AUTOFILLID" data-ctrl="upd-btn" data-id="@item.AUTOFILLID">Update</button>
							<button class="btn btn-danger btn-xs" style="display:none;" id="cancelBtn_@item.AUTOFILLID" data-ctrl="can-btn" data-id="@item.AUTOFILLID">Cancel</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<div id="mapNewUserModal" class="modal fade" role="dialog" tabindex="-1">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<button type="button" id="closeButton" data-dismiss="modal">&times;</button>
					<h4 class="modal-title">Add New User</h4>
				</div>
				<div class="modal-body">
					<div class="form-group row">
						<span id="spanDataFontSize" class="col-sm-6">Employee Detail</span>
						<div class="col-sm-6">
							<select id="inputEmployeeDetail" class="form-control select2">
								<option value="-1" selected>Select</option>
							</select>
						</div>
					</div>

					<div class="form-group row">
						<span id="spanDataFontSize" class="col-sm-6">Autofill Status</span>
						<div class="col-sm-6">
							<select id="inputAutofillStatus" class="form-control">
								<option value="-1" selected>Select</option>
								<option value="1">On</option>
								<option value="0">Off</option>
							</select>
						</div>
					</div>

					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-dismiss="modal" id="btnCloseModel">Close</button>
						<button type="button" class="btn btn-primary" id="btnAddUser">Add User</button>
					</div>
				</div>
			</div>
		</div>
	</div>

</div>

@section Scripts {
	@*<link href="/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />*@

	<script src="/lib/bootstrap/js/bootstrap.min.js"></script>
	<script src="~/js/select2.min.js"></script>


	@*<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>*@

	<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">

		$('.homeContent').removeClass('homeContent');
		$(document).ready(function () {
			$("._disble").attr('disabled', true);

			$("#tbGroupList").dataTable({
				"bFilter": true,
				"bLengthChange": true
			});

			//$('.select2').select2({
			//    placeholder: 'Select employees',
			//    allowClear: true
			//});
			//$('#mapNewUserModal').on('shown.bs.modal', function () {
			//    $('.select2').prop('disabled', false);
			//    $('.select2').select2({
			//        placeholder: 'Select an option',
			//        placeholderallowClear: true
			//    });
			//});

			$('#mapNewUserModal').on('shown.bs.modal', function () {
				$(window).trigger('resize');
			});
			$('.select2').select2({
				placeholder: 'Select an option',
				placeholderallowClear: true,
				dropdownParent: $('#mapNewUserModal')
			});




			$.ajax({
				url: '/SurveyConfiguration/GetHrSurveyEmployeeDetails',
				type: 'GET',
				success: function (data) {
					//console.log(data);
					if (data.success) {
						if (data.employeeDetails && data.employeeDetails.length > 0) {
							var dropdown = $('#inputEmployeeDetail');
							dropdown.empty();

							dropdown.append('<option value="-1" selected>Select</option>');

							data.employeeDetails.forEach(function (item) {
								var optionText = item.EMPLOYEEID + " (" + item.EMPLOYEENAME + ")";
								dropdown.append('<option value="' + item.EMPLOYEEID + '">' + optionText + '</option>');
							});
						}
					}

				},
				error: function (error) {
					console.error("Error fetching employee details: ", error);
				}
			});

					$("#btnMapNew").on("click", function(){
					   openMapNewUserModal();
		});

		$("#btnCloseModel").on("click", function(){
					   closeModal();
		});

		$("#btnAddUser").on("click", function(){
					   AddUserForAutoFill();
		});

		 $(document).on('click', '[data-ctrl="edit-btn"]', function () {
			var id = $(this).data('id');
					editRow(id);
		});

		 $(document).on('click', '[data-ctrl="upd-btn"]', function () {
			var id = $(this).data('id');
					updateRow(id);
		});


		 $(document).on('click', '[data-ctrl="can-btn"]', function () {
			var id = $(this).data('id');
					cancelEdit(id);
		});



		});

		function openMapNewUserModal() {
			$('#mapNewUserModal').modal('show');
			$('#inputEmployeeDetail').val('-1').trigger('change');
		}

		function closeModal() {
			$('#mapNewUserModal').modal('hide');
		}

		// Edit row and enable the status dropdown for editing
		var originalValue;
		function editRow(autoFillId) {
			//var statusCell = document.getElementById('status_' + autoFillId);

			//var statusValue = statusCell.innerText;
			//originalValue = statusValue;

			//// Make the status field editable
			//var dropdown = `<select class="form-control" id="statusDropdown_${autoFillId}">
			//            <option value="1" ${statusValue === '1' ? 'selected' : ''}>1</option>
			//            <option value="0" ${statusValue === '0' ? 'selected' : ''}>0</option>
			//        </select>`;

			//statusCell.innerHTML = dropdown;

			document.getElementById('statusText_' + autoFillId).style.display = 'none';
			document.getElementById('statusDropdown_' + autoFillId).style.display = 'inline-block';
			// Show Update and Cancel buttons
			document.getElementById('updateBtn_' + autoFillId).style.display = 'inline-block';
			document.getElementById('cancelBtn_' + autoFillId).style.display = 'inline-block';

			// Hide Edit button
			document.querySelector(`#row_${autoFillId} .glyphicon-edit`).style.display = 'none';
		}

		// Update the row when clicking the Update button
		function updateRow(autoFillId) {
			var status = document.getElementById('statusDropdown_' + autoFillId).value;
			var result = {
				autoFillId: autoFillId,
				status: status
			};
			//console.log(result);
			$.ajax({
				type: "POST",
				url: "/SurveyConfiguration/UpdateSurveyAutoFill",
				data: result,
				// dataType: "json",
				// contentType: "application/json",
				success: function (response) {
					//console.log(response);
					document.getElementById('statusDropdown_' + autoFillId).style.display = 'none';
					document.getElementById('statusText_' + autoFillId).style.display = 'inline-block';

					document.getElementById('updateBtn_' + autoFillId).style.display = 'none';
					document.getElementById('cancelBtn_' + autoFillId).style.display = 'none';
					document.querySelector(`#row_${autoFillId} .glyphicon-edit`).style.display = 'inline-block';
					document.getElementById('statusText_' + autoFillId).innerText = status == "1" ? "On" : "Off";
					sweetAlert("success", "Data Updated successfully", "success");
				},
				error: function (error) {
					sweetAlert("Oops...", "Something went wrong!", "error");
					document.getElementById('statusDropdown_' + autoFillId).style.display = 'none';
					document.getElementById('statusText_' + autoFillId).style.display = 'inline-block';
					document.getElementById('updateBtn_' + autoFillId).style.display = 'none';
					document.getElementById('cancelBtn_' + autoFillId).style.display = 'none';
					document.querySelector(`#row_${autoFillId} .glyphicon-edit`).style.display = 'inline-block';
				}
			});

			//// After update, revert the row back to the display mode
			//document.getElementById('status_' + autoFillId).innerText = status;

			//// Hide Update and Cancel buttons and show Edit button again
			//document.getElementById('updateBtn_' + autoFillId).style.display = 'none';
			//document.getElementById('cancelBtn_' + autoFillId).style.display = 'none';
			//document.querySelector(`#row_${autoFillId} .glyphicon-edit`).style.display = 'inline-block';
		}

		// Cancel the edit and revert back to original status
		function cancelEdit(autoFillId) {
			//var originalStatus = document.getElementById('status_' + autoFillId).innerText;

			//// Revert back the status to the original value (non-editable)
			//document.getElementById('status_' + autoFillId).innerText = originalStatus;

			document.getElementById('statusDropdown_' + autoFillId).style.display = 'none';
			document.getElementById('statusText_' + autoFillId).style.display = 'inline-block';

			// Hide Update and Cancel buttons and show Edit button again
			document.getElementById('updateBtn_' + autoFillId).style.display = 'none';
			document.getElementById('cancelBtn_' + autoFillId).style.display = 'none';
			document.querySelector(`#row_${autoFillId} .glyphicon-edit`).style.display = 'inline-block';
		}

		function AddUserForAutoFill() {
			var employeeDetail = document.getElementById('inputEmployeeDetail').value;
			var status = document.getElementById('inputAutofillStatus').value;
			var result = {
				employeeId: employeeDetail,
				status: status
			};
			if (employeeDetail != "-1" && status != "-1") {
				$.ajax({
					type: "POST",
					url: "/SurveyConfiguration/AddUserHrSurveyAutoFill",
					data: result,
					// dataType: "json",
					// contentType: "application/json",
					success: function (response) {
						console.log("res", response);
						$('#mapNewUserModal').modal('hide');
						document.getElementById('inputEmployeeDetail').value = "-1";
						document.getElementById('inputAutofillStatus').value = "-1";
						if (response.success) {
							if (response.errResult == "1") {
								sweetAlert({
									title: "Success",
									text: response.message,
									type: "success",
									showCancelButton: false,
									confirmButtonText: "OK",
									closeOnConfirm: true
								}, function () {
									location.reload();
								});
							} else {
								sweetAlert({
									title: "Warning",
									text: response.message,
									type: "warning",
									showCancelButton: false,
									confirmButtonText: "OK",
									closeOnConfirm: true
								});
							}

						} else {
							sweetAlert("", "Failed to add user", "error");
						}
					},
					error: function (error) {
						sweetAlert("Oops...", "Something went wrong!", "error");
					}
				})
			}
			else {
				$('#mapNewUserModal').modal('hide');
				document.getElementById('inputEmployeeDetail').value = "-1";
				document.getElementById('inputAutofillStatus').value = "-1";
				sweetAlert("", "Employee Detail/ Autofill Status are required!", "error");
			}

		}


	</script>

}