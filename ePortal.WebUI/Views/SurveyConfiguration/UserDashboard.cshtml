@model IEnumerable<ePortal.ViewModels.QuestionViewModel>

@{
    ViewBag.Title = "User Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="row">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Survey</span>
    </div>
    <div class="body-content" style="overflow-x:auto!important">
        <table id="tbGroupList" class="table table-bordered table-hover table-striped table-responsive" style="width:100%">

            <thead>
                <tr class="info">
                    <td colspan="10">
                        <b class="pull-left">
                            @Html.Label("Survey Name") :<span> &nbsp;</span>

                            @if (ViewBag.SurveyName != null)
                            {
                                <label>@ViewBag.SurveyName</label>
                            }
                        </b>
                    </td>
                </tr>
            </thead>

            @{
                int i = 1;
            }
            @foreach (var item in Model)
            {

                <tr>
                    <td>
                        @i
                        @{
                            i++;
                        }.
                        @Html.DisplayFor(model => item.QUSDESCRIPTION)
                    </td>
                </tr>


                <tr>
                    <td>
                        @foreach (var _ans in item.MappingList)
                        {
                            <span> &nbsp; &nbsp; &nbsp;</span>
                            @Html.RadioButtonFor(model => _ans.ANSDESCRIPTION, _ans.ANSDESCRIPTION) @Html.DisplayFor(model => _ans.ANSDESCRIPTION)
                            <span> &nbsp; &nbsp; &nbsp;</span>
                        }
                    </td>
                </tr>
            }
            <tr>
                <td style="text-align:center;">
                    <input type="button" id="_btn" onclick="_FinalfromSubmit(this);" value="Submit" class="btn btn-primary" />
                </td>
            </tr>
        </table>
    </div>
</div>
