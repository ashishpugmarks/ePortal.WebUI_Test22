    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_1"]">

        var UpdateandSubmitFinal = 0;
        var SubmitFinal = 0;

        $(document).ready(function () {

            var remarksstatus = parseInt($("#hdremarksstatus").val());
            if (remarksstatus == 1) {
                var isremekmand = parseInt($("#hdisremekmand").val());

                $("#txtremark").show();
                $("#lblremark").show();

            } else {
                $("#txtremark").hide();
                $("#lblremark").hide();
            }
            var surveyHeadings = {
                english: @Html.Raw(JsonSerializer.Serialize(Model.SurveyHeading)),
                hindi: @Html.Raw(JsonSerializer.Serialize(Model.SurveyHeadingHindi)),
                kannada: @Html.Raw(JsonSerializer.Serialize(Model.SurveyHeadingKannada)),
                gujarati: @Html.Raw(JsonSerializer.Serialize(Model.SurveyHeadingGujarati)),
                japanese: @Html.Raw(JsonSerializer.Serialize(Model.SurveyHeadingJapanese)),
            };

            var surveyDescriptions = {
                english: @Html.Raw(JsonSerializer.Serialize(Model.SurveyDescription)),
                hindi: @Html.Raw(JsonSerializer.Serialize(Model.SurveyDescriptionHindi)),
                kannada: @Html.Raw(JsonSerializer.Serialize(Model.SurveyDescriptionKannada)),
                gujarati: @Html.Raw(JsonSerializer.Serialize(Model.SurveyDescriptionGujarati)),
                japanese: @Html.Raw(JsonSerializer.Serialize(Model.SurveyDescriptionJapanese)),
            };

            //Added against CR6225 - BY TTL
            function linkify(text) {
                if (!text) return '';
                var urlPattern = /(\bhttps?:\/\/[^\s]+)/g;
                //Added against CR6478 - BY TTL
                return text.replace(urlPattern, '<a href="$1" target="_blank">$1</a>').replace(/\r\n|\n|\r/g, '<br />');
                //Added against CR6478 - BY TTL
            }
            //Added against CR6225 - BY TTL

            function getQuestionDescription(questionId, language) {
                var question = @Html.Raw(JsonSerializer.Serialize(Model.Questions)); // Convert Questions to JSON
                var questionData = question.find(q => q.Id == questionId);

                if (language === 'english') return questionData.Description;
                else if (language === 'hindi') return questionData.DescriptionHindi;
                else if (language === 'kannada') return questionData.DescriptionKannada;
                else if (language === 'gujarati') return questionData.DescriptionGujarati;
                else if (language === 'japanese') return questionData.DescriptionJapanese;
            }

            function getOptionDescription(questionId, optionId, language) {
                var question = @Html.Raw(JsonSerializer.Serialize(Model.Questions)); // Convert Questions to JSON
                var questionData = question.find(q => q.Id == questionId);

                if (!questionData) return '';

                var option = questionData.Options.find(o => o.HRSECURITYANSLISTID == optionId);

                if (!option) return '';

                if (language === 'english') return option.ANSDESCRIPTION;
                else if (language === 'hindi') return option.ANSDESCRIPTIONHINDI;
                else if (language === 'kannada') return option.ANSDESCRIPTIONKANNADA;
                else if (language === 'gujarati') return option.ANSDESCRIPTIONGUJARATI;
                else if (language === 'japanese') return option.ANSDESCRIPTIONJAPANESE;

                return '';
            }

            $('.tab-selector').on('click', function () {
                //var selectedLanguage = $(this).attr('id').replace('-tab', '');
                var selectedLanguage = $(this).attr('data-lan-value').toLowerCase();

                if (surveyHeadings[selectedLanguage] || surveyDescriptions[selectedLanguage]) {
                    //$('#SurveyHeading').text(surveyHeadings[selectedLanguage]);
                    //$('#SurveyDescription').text(surveyDescriptions[selectedLanguage]);
                    //Added against CR - BY TTL
                    $('#SurveyHeading').html(linkify(surveyHeadings[selectedLanguage]));
                    $('#SurveyDescription').html(linkify(surveyDescriptions[selectedLanguage]));
                    //Added against CR - BY TTL

                    var questionIndex = 0;
                    $('.question').each(function () {
                        var question = $(this);
                        var questionId = question.data('id');
                        var questionDescription = getQuestionDescription(questionId, selectedLanguage);
                        var currentDescription = question.find('.question-description').text();

                        if (questionDescription) {
                            var slno = question.find('.question-description').data('slno');
                            //question.find('.question-description').text(slno + ". " + questionDescription);
                            //Added against CR6225 - BY TTL
                            var fullDescription = slno + ". " + questionDescription;
                            question.find('.question-description').html(linkify(fullDescription));
                            //Added against CR6225 - BY TTL
                        } else {
                            //question.find('.question-description').text(currentDescription);
                            question.find('.question-description').html(linkify(currentDescription)); //Added against CR - BY TTL
                        }
                        question.find('.option').each(function () {
                            var option = $(this);
                            var optionId = option.data('id');
                            //option.find('.option-description').text(getOptionDescription(questionId, optionId, selectedLanguage));
                            var optionDescription = getOptionDescription(questionId, optionId, selectedLanguage);
                            var currentOptionDescription = option.find('.option-description').text();
                            if (optionDescription) {
                                option.find('.option-description').text(optionDescription);
                            } else {
                                option.find('.option-description').text(currentOptionDescription);
                            }
                        });

                        questionIndex++;
                    });

                } else {
                    sweetAlert("", `The selected ${selectedLanguage} language data is not present`, "warning");
                }

            });

            var firstVisibleRadio = $('input.tab-selector:visible').first();

            firstVisibleRadio.prop('checked', true);


            $('#surveyPreviewBackButton').on("click",function(){
                window.location.href='@Url.Action("SurveyList", "SurveyConfiguration")';
            });

        });

        $(document).ready(function () {
            $('.parentquestionchange').change(function () {
                var selectedValue = $(this).val();
                var triggerId = $(this).data('trigger-id');
                var nextQuestionId = $(this).data('id');
                var questionId = $(this).data('question-id');

                triggerId = String(triggerId);
                var triggerIdsArray = triggerId.split(',');

                var shouldShow = false;

                // Check if any of the selected options match the trigger options
                triggerIdsArray.forEach(function (triggerOptionId) {
                    if ($('.parentquestionchange[value="' + triggerOptionId + '"]:checked').length > 0) {
                        shouldShow = true;
                    }
                });

                if (shouldShow) {
                    $('#' + nextQuestionId).removeClass('hidden');
                    $('#h_' + nextQuestionId).val('ml-30');
                } else {
                    $('#' + nextQuestionId).addClass('hidden');
                    $('#h_' + nextQuestionId).val('hidden ml-30');

                    // Clear selections if subquestion is hidden
                    $('#' + nextQuestionId).find('input[type="radio"]:checked, input[type="checkbox"]:checked').prop('checked', false);
                }
            });
        });


    </script>
