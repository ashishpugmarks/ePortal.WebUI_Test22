@{
    ViewBag.Title = "View Chroncile Volume";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";
}

@section Styles {
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .ui-widget-content {
            max-height: 200px;
            overflow-y: auto;
            overflow-x: hidden;
        }
        .homeContent {
            padding: 0.52em 0.3em 0.78em !important;
        }

        label {
            font-weight: normal !important;
            font-size: 17px !important;
        }
    </style>
}

<div class="panel panel-primary top-margin-10">
    <div class="panel-heading">
        <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px;">View Chronicles Volume</h2>
        </div>
            <div class="panel-body">
                <div class="container-fluid">
                        @if (ViewBag.ImageType == "IMAGE")
                        {
                          <img src="@Url.Content("../Uploads/HR_CHRONICLES/" + ViewBag.Filename)" alt="Preview Image" class="preview-media" style="width:988px; height:400px;padding:10px;" />
                        }
                        else if (ViewBag.ImageType == "VIDEO")
                        {
                <video controls class="preview-media" style="width:988px; height:400px;padding:10px;">
                           <source src="@Url.Content("../Uploads/HR_CHRONICLES/" + ViewBag.Filename)" type="video/mp4" />
                                Your browser does not support the video tag.
                            </video>
                        }
                 </<div>
            </div>
        </div>

    </div>
    <div class="panel-body">
       
    </div>
</div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        $(document).ready(function () {
            $("#btnCancel").on("click", function () {
               parent.jQuery.fancybox.close();
            });
        });
    </script>
}