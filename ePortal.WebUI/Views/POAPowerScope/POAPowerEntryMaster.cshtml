@model ePortal.ViewModels.POAPowerScopeADPOWERMASTERViewModel

@{
    ViewBag.Title = "POAPowerEntryMaster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        /*table Css*/
        .table > thead > tr > th {
            padding: 6px 10px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            padding: 5px;
            line-height: 1.5;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
            border: 1px solid #8ac2de;
            font-size: 70% !important;
        }

        .table-bordered {
            border: 1px solid #8ac2de;
        }

        .table > tbody > tr > td {
            /*padding: 4px 3px;*/
            padding: 0px 3px !important;
        }

        .table > tbody > tr:nth-of-type(even) {
            background: #e9e9e9;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .validationBackground {
            background-color: #a94442 !important;
            color: white;
        }

        .highlightBackground {
            background-color: #8bb55a !important;
            color: white;
        }
        /*basic reset*/
        * {
            margin: 0;
            padding: 0;
        }

        html {
            height: 100%;
            background: white; /* fallback for old browsers */
            background: -webkit-linear-gradient(to left, #6441A5, #2a0845); /* Chrome 10-25, Safari 5.1-6 */
        }

        body {
            font-family: montserrat, arial, verdana;
            background: transparent;
        }

        /*form styles*/
        #msform {
            text-align: center;
            position: relative;
        }

            #msform fieldset {
                background: white;
                border: 0 none;
                border-radius: 0px;
                box-shadow: 0 0 15px 1px rgba(0, 0, 0, 0.4);
                padding: 8px 0px;
                box-sizing: border-box;
                width: 100%;
                position: relative;
            }

                /*Hide all except first fieldset*/
                #msform fieldset:not(:first-of-type) {
                    display: none;
                }

        /*headings*/
        .fs-title {
            font-size: 18px;
            text-transform: uppercase;
            color: #2C3E50;
            margin-bottom: 10px;
            letter-spacing: 2px;
            font-weight: bold;
        }

        .fs-subtitle {
            font-weight: normal;
            font-size: 13px;
            color: #666;
            margin-bottom: 20px;
        }

        /*progressbar*/
        #progressbar {
            margin-bottom: 20px;
            overflow: hidden;
            /*CSS counters to number the steps*/
            counter-reset: step;
        }

            #progressbar li {
                list-style-type: none;
                color: #6080dc;
                text-transform: uppercase;
                font-size: 9px;
                font-weight: 800;
                /*width: 33.33%;*/
                width: 50%;
                float: left;
                position: relative;
                letter-spacing: 1px;
            }

                #progressbar li:before {
                    content: counter(step);
                    counter-increment: step;
                    width: 40px;
                    height: 24px;
                    line-height: 26px;
                    display: block;
                    font-size: 12px;
                    color: #333;
                    background: #ccc;
                    border-radius: 25px;
                    margin: 0 auto 6px auto;
                }

                /*progressbar connectors*/
                #progressbar li:after {
                    content: '';
                    width: 100%;
                    height: 8px;
                    background: #ccc;
                    position: absolute;
                    left: -50%;
                    top: 8px;
                    z-index: -1; /*put it behind the numbers*/
                }

                #progressbar li:first-child:after {
                    /*connector not needed before the first step*/
                    content: none;
                }

                /*marking active/completed steps green*/
                /*The number of the step and the connector before it = green*/
                #progressbar li.active:before, #progressbar li.active:after {
                    background: #6080dc;
                    color: white;
                }


        /* Not relevant to this form */
        .dme_link {
            margin-top: 30px;
            text-align: center;
        }

            .dme_link a {
                background: #FFF;
                font-weight: bold;
                color: #6080dc;
                border: 0 none;
                border-radius: 25px;
                cursor: pointer;
                padding: 5px 25px;
                font-size: 12px;
            }

                .dme_link a:hover, .dme_link a:focus {
                    background: #C5C5F1;
                    text-decoration: none;
                }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .panel-heading {
            padding: 8px 15px;
        }

        #pr_div {
            border: 1px solid #ccc;
            padding: 8px; /*15px 0px 15px 0px;*/
            margin-left: 10px;
            border-radius: 5px;
            background-color: #eee;
            overflow: auto;
            min-height: 35px;
            max-height: 92px;
            width: 73.30%;
        }

        .alert-error {
            background-color: antiquewhite;
            margin-left: 15px;
            margin-right: 15px;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .required::after {
            content: "*";
            font-weight: 800;
            color: red;
            margin-left: 5px;
        }

        .ui-widget {
            font-family: Verdana,Arial,sans-serif;
            font-size: 0.6em !important;
            overflow: auto;
            max-height: 150px;
        }
    </style>
}

    <div class="panel-group" style="padding: 0px 8px 0px 8px;">

        <div class="panel panel-primary">
            <div class="panel-heading">
                <h2 class="panel-title" style="line-height:2.2;font-size:16px">
                    <strong>POA Power Entry Master</strong>
                </h2>
            </div>
            <div class="panel-body">
                <div class="form-group" style="padding-bottom: 30px;">
                    <div class="col-md-2 col-sm-3 col-xs-3 text-right">
                        @Html.LabelFor(model => model.POWERCODE, htmlAttributes: new { @class = "control-label required", @style = "margin-top: 10px;margin-right:10px;font-size:80%" })
                        @*@Html.LabelFor(model => model.ADEMPCODE, htmlAttributes: new { @class = "control-label required", @style = "margin-top: 10px;" })*@
                    </div>
                    <div class="col-md-2 col-sm-4 col-xs-5" style="padding-top:8px">
                        @*<input type="number" class="form-control" id="txtEmpcode" placeholder="Employee Code" style="width:145px" />*@
                        <input type="text" class="form-control" id="txtPowerCode" placeholder="Power Code" />
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-3 text-right">
                        @Html.LabelFor(model => model.POWERNAME, htmlAttributes: new { @class = "control-label required", @style = "margin-top: 10px;margin-right:10px;font-size:80%" })
                        @*@Html.LabelFor(model => model.ADEMPCODE, htmlAttributes: new { @class = "control-label required", @style = "margin-top: 10px;" })*@
                    </div>
                    <div class="col-md-3 col-sm-4 col-xs-5" style="padding-top:8px">
                        @*<input type="number" class="form-control" id="txtEmpcode" placeholder="Employee Code" style="width:145px" />*@
                        <input type="text" class="form-control" id="txtPowerName" placeholder="Power Name" />
                    </div>
                    <div class="col-md-1 col-sm-4 col-xs-5" style="padding-top:8px;padding-left:20px">
                        <input type="button" name="Save" class="btn btn-success" value="Save" id="Save" />
                    </div>

                </div>
            </div><br />
            <div class="panel-body">
                <div class="form-group" style="margin-bottom: 0px;">
                    <form id="myform">
                        <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                            <thead>
                                <tr class="bg-info">
                                    <th class="text-center">SNo.</th>
                                    <th class="text-center">PowerCode</th>
                                    <th class="text-center">PowerName</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="append_POARow">
                            </tbody>
                        </table>
                    </form>
                </div>

            </div>
        </div>
    </div>

@section Scripts {
    <script src="~/js/jquery-ui.js"></script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

        $(document).ready(function () {
            LoadData();

            $("#Save").click(function () {


                var PowerCode = $("#txtPowerCode").val().trim();
                var PowerName = $("#txtPowerName").val().trim();


        if (PowerCode === '' || PowerName === '') {
                    alert('Both input fields must have a value.');
                } else {
                   $.ajax({
                    type: "GET",
                    url: "/POAPowerScope/SavePower",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { PCODE: PowerCode, PNAME: PowerName },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data != null) {
                            swal({
                                title: "",
                                text: "Data Saved Successfully...!",
                                type: "success"
                            },
                               function () {
                                   location.reload();
                               }
                            );
                        }
                        //location.reload();
                    },
                    complete: function () {
                        //BindData(arrayList);
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
                }                               
            });

            $(document).on('click', '[data-ctrl="del-booking-btn"]', function () {
                        // var id = $(this).data('id');
                        // var id = $(this).data('id');
                                DeleteDoc(this);
                    });
        });


        function LoadData() {

            $.ajax({
                type: "POST",
                url: "/POAPowerScope/GetPowerMasterData",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data != "[]") {
                        // var Data1 = JSON.parse(data);
                        var Data1 = data;
                        //console.log(Data1);
                        $("#append_POARow").empty();
                        $.each(Data1, function (i, r) {
                            $("#append_POARow").append("<tr><td><center>" + (i + 1) + "</center></td><td>" + r.POWERCODE + "</td><td> " + r.POWERNAME + "</td><td class='text-center'><a data-name='" + r.POWERCODE + "' data-type='" + r.POWERNAME + "' data-id='" + (i + 1) + "'  style='cursor: pointer;color:red;' data-ctrl='del-booking-btn' ><span id='btnDelete' class='glyphicon glyphicon-trash '></span></a></td></tr>")

                        });
                    }

                    else {
                        $("#append_POARow").empty();
                        $("#append_POARow").append("<tr><td colspan='5' class='text-center'>No record found.</td></tr>")
                    }
                },
                complete: function () {

                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
              

        function DeleteDoc(crnt) {

            var POWERCODE = $(crnt).attr('data-name');
            var POWERNAME = $(crnt).attr('data-type');
            var SRNO = $(crnt).attr('data-id');

            $.ajax({
                type: "Delete",
                url: "/POAPowerScope/DeleteAttachment",
                data: JSON.stringify({ POWERCODE: POWERCODE, POWERNAME: POWERNAME, SRNO: SRNO }),
                contentType: "application/json; charset=utf-8",                
                success: function (data) {
                    if (data.res == 1) {
                        attachmentArray = data.attachmentList;
                        if (attachmentArray != null) {
                            if (attachmentArray.length > 0) {
                                BindDocument(attachmentArray);
                            }
                        }
                        sweetAlert("", "Document deleted successfully.", "success");
                        LoadData();
                    }
                    else {
                        sweetAlert("", "Document not deleted, Please try again.", "warning");
                        LoadData();
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

    </script>
}
