						var Attach;


						function Filevalidation() {
							var fi = document.getElementById('txtFile');

							// Check if any file is selected.

							if (fi.files.length > 0) {
								for (var i = 0; i <= fi.files.length - 1; i++) {

									var fsize = fi.files.item(i).size;
									var file = Math.round((fsize / 1024));
									// The size of the file.
									if (file >= 2048) {
										//alert("File too Big, please select a file less than 2mb");
										swal({
											title: "",
											text: "File size should not be more than 2mb",
											type: "error"
										}, function () {
											location.reload();
										}

										   );

									}

								}
							}
						}

						function UploadPOAAttachment(input) {
							debugger;
							var _URL = window.URL || window.webkitURL;
							var file = input.files[0];
							var image = new Image();
							image.src = _URL.createObjectURL(file);
							var extension = $(input).val().split('.').pop().toLowerCase();
							var validFileExtensions = ['pdf'];
							if ($.inArray(extension, validFileExtensions) == -1) {
								var _msg = "Sorry! Upload only 'pdf' file";
								sweetAlert(" ", _msg, "warning");
								$(input).replaceWith($(input).val('').clone(true));
								return;
							}

							if (file.size > (2e+6)) {
								sweetAlert(" ", "Sorry! Max allowed file size is 2 mb", "warning");
								$(input).replaceWith($(input).val('').clone(true));
								return;
							}
							var formData = new FormData();
							formData.append("FILE", document.getElementById("txtFile").files[0]);
							formData.append("ADEMPCODE", $('#txtEmpcode').val().split("-")[0].trim());
