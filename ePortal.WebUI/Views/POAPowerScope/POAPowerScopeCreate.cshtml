								processData: false,
								success: function (data) {
									debugger;


		if (data.success) {
							alert("POA Attachment uploaded successfully.");
				} else {
							 alert("ACR Attachment not uploaded, Please try again.");
												$("#txtAcrFile").val('');
				}



									// if (data.res == 1) {
									//     alert("POA Attachment uploaded successfully.");
									// }
