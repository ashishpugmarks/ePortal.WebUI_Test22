							//$(current).parent().next()[0].textContent = "Verified";
							//$(current).parent().next().css("color", "green");
							if (_pdfName != "") {
								$.ajax({
									type: "GET",
									url: "/POAPowerScope/GetPDF",
									beforeSend: function () {
										$("#ajaxLoader").addClass('loader');
									},
									data: { fileName: _pdfName, ADEMPCODE: ADEMPCODE },
									contentType: "application/json; charset=utf-8",
									datatype: "json",
									success: function (data) {
										if (data.FILEPATH != "") {
											//alert(data.FILEPATH);
											document.getElementById("myCreateModelContent").innerHTML = data.FILEPATH;

											// $('#sp_type').html("PO Detail's");
											// $('#myCreateModelContent').html(data);
											$('#myCreateModel').modal({ backdrop: "static" });
										}
										else {
											sweetAlert("", "File not found.", "warning");
										}
									},
									complete: function () {
										$("#ajaxLoader").removeClass('loader');
									},
									error: function () {
										sweetAlert("Oops...", "Something went wrong!", "error");
									}
								});
							}
						}


	</script>
    }

