@model ePortal.ViewModels.ADPOWERSCOPEMASTERViewModel

@{
    ViewBag.Title = "POAPowerScopeViewDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        /*table Css*/
        .table > thead > tr > th {
            padding: 6px 10px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            /*padding: 10px;*/
            padding: 5px;
            /*line-height: 1.2;*/
            line-height: 0.7;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
            border: 1px solid #8ac2de;
            align-content: center;
            font-size: 70% !important;
            /*font-size:83% !important;*/
        }

        .table-bordered {
            border: 1px solid #8ac2de;
        }

        .table > tbody > tr > td {
            /*padding: 4px 3px;*/
            /*padding: 0px 3px !important;*/
            padding: 8px 3px !important;
        }

        .table > tbody > tr:nth-of-type(even) {
            background: #e9e9e9;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .validationBackground {
            background-color: #a94442 !important;
            color: white;
        }

        .highlightBackground {
            background-color: #8bb55a !important;
            color: white;
        }
        /*basic reset*/
        * {
            margin: 0;
            padding: 0;
        }

        html {
            height: 100%;
            background: white; /* fallback for old browsers */
            background: -webkit-linear-gradient(to left, #6441A5, #2a0845); /* Chrome 10-25, Safari 5.1-6 */
        }

        body {
            font-family: montserrat, arial, verdana;
            background: transparent;
        }

        /*form styles*/
        #msform {
            text-align: center;
            position: relative;
        }

            #msform fieldset {
                background: white;
                border: 0 none;
                border-radius: 0px;
                box-shadow: 0 0 15px 1px rgba(0, 0, 0, 0.4);
                padding: 8px 0px;
                box-sizing: border-box;
                width: 100%;
                position: relative;
            }

                /*Hide all except first fieldset*/
                #msform fieldset:not(:first-of-type) {
                    display: none;
                }

        /*headings*/
        .fs-title {
            font-size: 18px;
            text-transform: uppercase;
            color: #2C3E50;
            margin-bottom: 10px;
            letter-spacing: 2px;
            font-weight: bold;
        }

        .fs-subtitle {
            font-weight: normal;
            font-size: 13px;
            color: #666;
            margin-bottom: 20px;
        }

        /*progressbar*/
        #progressbar {
            margin-bottom: 20px;
            overflow: hidden;
            /*CSS counters to number the steps*/
            counter-reset: step;
        }

            #progressbar li {
                list-style-type: none;
                color: #6080dc;
                text-transform: uppercase;
                font-size: 9px;
                font-weight: 800;
                /*width: 33.33%;*/
                width: 50%;
                float: left;
                position: relative;
                letter-spacing: 1px;
            }

                #progressbar li:before {
                    content: counter(step);
                    counter-increment: step;
                    width: 40px;
                    height: 24px;
                    line-height: 26px;
                    display: block;
                    font-size: 12px;
                    color: #333;
                    background: #ccc;
                    border-radius: 25px;
                    margin: 0 auto 6px auto;
                }

                /*progressbar connectors*/
                #progressbar li:after {
                    content: '';
                    width: 100%;
                    height: 8px;
                    background: #ccc;
                    position: absolute;
                    left: -50%;
                    top: 8px;
                    z-index: -1; /*put it behind the numbers*/
                }

                #progressbar li:first-child:after {
                    /*connector not needed before the first step*/
                    content: none;
                }

                /*marking active/completed steps green*/
                /*The number of the step and the connector before it = green*/
                #progressbar li.active:before, #progressbar li.active:after {
                    background: #6080dc;
                    color: white;
                }


        /* Not relevant to this form */
        .dme_link {
            margin-top: 30px;
            text-align: center;
        }

            .dme_link a {
                background: #FFF;
                font-weight: bold;
                color: #6080dc;
                border: 0 none;
                border-radius: 25px;
                cursor: pointer;
                padding: 5px 25px;
                font-size: 12px;
            }

                .dme_link a:hover, .dme_link a:focus {
                    background: #C5C5F1;
                    text-decoration: none;
                }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .panel-heading {
            padding: 8px 15px;
        }

        #pr_div {
            border: 1px solid #ccc;
            padding: 8px; /*15px 0px 15px 0px;*/
            margin-left: 10px;
            border-radius: 5px;
            background-color: #eee;
            overflow: auto;
            min-height: 35px;
            max-height: 92px;
            width: 73.30%;
        }

        .alert-error {
            background-color: antiquewhite;
            margin-left: 15px;
            margin-right: 15px;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .required::after {
            content: "*";
            font-weight: 800;
            color: red;
            margin-left: 5px;
        }

        .ui-widget {
            font-family: Verdana,Arial,sans-serif;
            font-size: 0.6em !important;
            overflow: auto;
            max-height: 150px;
        }
    </style>
}

    <div class="panel-group" style="padding: 0px 8px 0px 8px;">

        <div class="panel panel-primary">
            <div class="panel-heading">
                <h2 class="panel-title" style="line-height:2.2;font-size:16px">
                    <strong>POA Power Scope View Details Form</strong>
                </h2>
            </div>
            <div class="panel-body">
                <div class="form-group" style="padding-bottom: 30px;">
                    <div class="col-md-2 col-sm-3 col-xs-3 text-right">
                        @Html.LabelFor(model => model.ADEMPCODE, htmlAttributes: new { @class = "control-label required", @style = "margin-top: 10px;margin-right:10px;font-size:80%" })

                    </div>
                    <div class="col-md-2 col-sm-4 col-xs-5" style="padding-top:8px">

                        <input type="text" class="form-control" id="txtEmpcode" placeholder="Employee Code" />
                        <span id="OsearchTerm"></span>
                    </div>
                    <div class="col-md-1 col-sm-1 col-xs-3 text-right">
                        @Html.LabelFor(model => model.POWER, htmlAttributes: new { @class = "control-label required", @style = "margin-top: 10px;margin-right:10px;font-size:80%" })

                    </div>
                    <div class="col-md-2 col-sm-4 col-xs-5" style="padding-top:8px">

                        <input type="text" class="form-control" id="txtPower" placeholder="Power" />
                        <span id="searchTerm"></span>
                    </div>
                    <div class="col-md-3 col-sm-1 col-xs-1" style="padding-top:8px;padding-left:25px;">
                        <input type="button" class="btn btn-success btn-sm" value="Search" id="btnSearch" />
                        <input type="button" class="btn btn-primary btn-sm" value="Export To Excel" id="btnExcel" />
                        @*<button id="btnExcel" onclick="GetExcel()" class="btn btn-primary btn-sm">Export To Excel</button>*@
                    </div>

                    @*<div class="col-md-3 col-sm-3 col-xs-3" style="padding-left:5px">
                @Html.LabelFor(model => model.POWER, htmlAttributes: new { @class = "control-label required", @style = "margin-top: 10px;margin-right:10px;font-size:80%" })
            </div>
            <div class="col-md-3 col-sm-4 col-xs-5" style="padding-top:8px">

                <input type="text" class="form-control" id="txtPower" placeholder="Power" />
                <span id="OsearchTerm"></span>
            </div>*@




                </div>
            </div><br />
            <div class="panel-body">
                <div class="form-group" style="margin-bottom: 0px;">
                    <form id="myform">
                        <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                            <thead>
                                <tr class="bg-info">
                                    <th class="text-center">SNo.</th>
                                    <th class="text-center">ECode.</th>
                                    <th class="text-center">Power</th>
                                    <th class="text-center">Scope</th>
                                    <th class="text-center">Remarks</th>
                                </tr>
                            </thead>
                            <tbody id="append_POARow">
                                <tr><th colspan="5" class="text-center">No record found.</th></tr>
                            </tbody>
                        </table>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @section Scripts{
    <script src="~/js/jquery-ui.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">


                $(document).ready(function () {

                    LoadData();

            $(function () {
                $("input#txtEmpcode").autocomplete({
                    source: "/POAPowerScope/AutocompleteSuggestionsForPOA",
                    minLength: 2,
                    select: function (event, ui) {
                        if (ui.item) {
                            $("#OsearchTerm").val(ui.item.value);
                        }
                    }
                });
            });


            $(function () {

                $("input#txtPower").autocomplete({
                    source: "/POAPowerScope/AutocompleteSuggestionsForPOAPower",
                    minLength: 2,
                    select: function (event, ui) {
                        if (ui.item) {
                            $("#searchTerm").val(ui.item.value);


                        }

                    }
                });
            });

            $("#btnSearch").on("click", function(){
                BtnSearchData();
            });

            $("#btnExcel").on("click", function(){
                Export();
            });

        });


        function LoadData() {

            $.ajax({
                type: "POST",
                url: "/POAPowerScope/GetPowerScopeViewDetailAllData",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data != "[]") {
                        var Data1 = data;
                        console.log(Data1);
                        $("#append_POARow").empty();
                        $.each(Data1, function (i, r) {
                            if (r.Remarks == null)
                            {
                                r.Remarks = "";
                            }
                            $("#append_POARow").append("<tr><td><center>" + (i + 1) + "</center></td><td>" + r.ADEMPCODE_ + "</td><td> " + r.Power + "</td><td>" + r.Scope + "</td><td>" + r.Remarks+ "</td></tr>")
                        });
                    }

                    else {
                        $("#append_POARow").empty();
                        $("#append_POARow").append("<tr><td colspan='5' class='text-center'>No record found.</td></tr>")
                    }
                },
                complete: function () {

                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }


        function BtnSearchData() {

            var EmpCode = $("#txtEmpcode").val();
            var Power = $("#txtPower").val();

            if (EmpCode == "") {
                EmpCode = "0";

            }
            else {
                EmpCode = parseInt($('#txtEmpcode').val().split("-")[0].trim());
            }

            if (Power == "") {
                Power = "";
            }
            else {
                Power = $('#txtPower').val().split("-")[0].trim();
            }

            $.ajax({
                type: "GET",
                url: "/POAPowerScope/GetPowerScopeViewDetailByEmpCode",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: { eCode: EmpCode, Power: Power },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data != "[]") {
                        var Data1 = data;
                        console.log(Data1);
                        $("#append_POARow").empty();
                        $.each(Data1, function (i, r) {
                            if (r.Remarks == null) {
                                r.Remarks = "";
                            }
                            $("#append_POARow").append("<tr><td><center>" + (i + 1) + "</center></td><td>" + r.ADEMPCODE_ + "</td><td> " + r.Power + "</td><td>" + r.Scope + "</td><td>" + r.Remarks + "</td></tr>")

                        });
                    }

                    else {
                        $("#append_POARow").empty();
                        $("#append_POARow").append("<tr><td colspan='5' class='text-center'>No record found.</td></tr>")
                    }




                },
                complete: function () {

                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });



        }


        function Export() {

            var EmpCode = $("#txtEmpcode").val();
            var Power = $("#txtPower").val();

            if (EmpCode == "") {
                EmpCode = "0";

            }
            else {
                EmpCode = parseInt($('#txtEmpcode').val().split("-")[0].trim());
            }

            if (Power == "") {
                Power = "";
            }
            else {
                Power = $('#txtPower').val().split("-")[0].trim();
            }
            //alert(EmpCode);
            //alert(Power);
            var URL = '/POAPowerScope/ExportToExcelUser/?eCode=' + EmpCode + '&Power=' + Power;

            $.ajax({
                type: "POST",
                url: URL,
                //url: "/POAPowerScope/ExportToExcelUser",
                //data: { eCode: EmpCode, Power: Power },
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "POAPowerScope", Action = "DownloadExcelUser" })";
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });



        }

    </script>
    }

