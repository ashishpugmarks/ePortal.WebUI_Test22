                            //Added as on 09092024 for SR78412 Start
							/*
                            if (r.USERTYPE === 'Regular')
                            {
                                if (r.STATUS === 'Pending at Self') {
                                    table.row.add([
                                        r.ECODE,
                                        r.EMPLOYEE,
                                        r.LEVELDESC,
                                        r.DIVISION,
                                        r.DEPARTMENT,
                                        r.REVIEWERName,
                                        r.USERTYPE,
                                        "<a target='_blank' style='cursor: pointer;color:black;' onclick=window.location='/UAR/UARRegularRequestList?id=" + r.ECODE + "&Status=Pending&REVIEWER=" + r.REVIEWER + "'><span id='btnDelete' class='glyphicon glyphicon-eye-open center'></span></a>",
