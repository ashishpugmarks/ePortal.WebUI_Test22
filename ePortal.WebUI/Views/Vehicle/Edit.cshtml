@using System.Text.Json
@model ePortal.ViewModels.VehicleDTO.VehicleUpsertDto

@{
	ViewBag.Title = "VehiclePortal";
	Layout = "~/Views/Shared/_Layout.cshtml";
	<title>Edit</title>
var today = DateTime.Now.ToString("yyyy-MM-dd");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vehicle Documents</title>
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap-multiselect.css" rel="stylesheet" />
    <script src="~/js/jquery-ui.js"></script>
    <script src="~/js/jquery.validate.js"></script>
    <script src="~/js/jquery.validate.unobtrusive.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap-multiselect.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script>
    <script src="~/js/summernote.js"></script>
    <link href="~/css/summernote.css" rel="stylesheet" />
    <link href="~/css/vehicle/CreateVehicleDocs.css" rel="stylesheet" />
</head>
<script nonce='@Context.Items["ScriptNonce_3"]'>
    /* =========================================================
       VEHICLE MANAGEMENT SCRIPT — GLOBAL (NO LOGIC CHANGE)
       ========================================================= */

    /* ------------------ Global State ------------------ */
    const STATE = { editModel: null };

    /* ------------------ Init ------------------ */
    function initApp() {
        // SAFE JSON INIT
        const rawJson = `@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model))`;

        let parsed = null;
        try { parsed = JSON.parse(rawJson); } catch { parsed = null; }
        STATE.editModel = window.editModel || parsed;
        // console.log(parsed);

        uiInit();
        vehicleInit();
        documentsInit();
        eventsInit();

        editInit();
    }

    /* ------------------ Renumber blocks (kept global) ------------------ */
    function renumberVehicleBlocks() {
        $(".vehicle-block").each(function (i) {
            const $block = $(this);
            const newIndex = i;
            const newDisplay = i + 1;

            // ONLY main heading (direct child)
            const $mainHeading = $block.children(".panel-heading").first();
            $mainHeading.children("strong.panel-title").html(
                `<i class="fa fa-caret-right caret-color"></i> Vehicle Detail (${newDisplay})`
            );

            // ONLY main collapse body (direct child)
            const $collapse = $block.children(".panel-collapse").first();
            const newId = `vehicleDetails_${newIndex}`;
            $collapse.attr("id", newId);
            $mainHeading.attr("data-target", `#${newId}`).attr("aria-controls", newId);

            $block.attr("data-index", newIndex);
        });
    }

    /* ------------------ Utilities (global) ------------------ */
    function qs($scope, sel) { return $scope.find(sel); }
    function tbody($scope, cls) { return $scope.find(`${cls} tbody`); }

    function hasNoRecord($tbody) {
        return $tbody.find("td:contains('No record')").length > 0;
    }
    function clearNoRecord($tbody) { if (hasNoRecord($tbody)) $tbody.empty(); }
    function setNoRecord($tbody, colspan) {
        $tbody.html(`<tr><td colspan="${colspan}" class="text-center text-muted">No record found.</td></tr>`);
    }
    function rowCount($tbody) { return $tbody.find("tr").not(":has(td:contains('No record'))").length; }

    function lockFields($els, state) {
        $els.prop("disabled", !!state);
        $els.toggleClass("disabled-field", !!state);
    }
    function formatDateSafe(d) {
        if (!d) return "";
        const dt = new Date(d);
        if (isNaN(dt.getTime())) return "";
        return dt.toISOString().slice(0, 10);
    }

    function buildFileArray(fileList) {
        const arr = [];
        let html = "";

        for (const f of fileList) {
            const url = URL.createObjectURL(f);

            // Store REAL file object, NOT custom object
            arr.push(f);

            // But use URL for display
            html += `<a href="${url}" target="_blank" class="file-link">${f.name}</a><br>`;
        }

        return { arr, html };
    }
    function revokeRowPreviews($row) {
        const files = $row.data("files") || [];
        files.forEach(f => { try { URL.revokeObjectURL(f.url); } catch (_) { } });
    }
    function firstDataRow($scope, tableCls) {
        return tbody($scope, tableCls).find("tr").not(":has(td:contains('No record'))").first();
    }
    function appendFiles(fd, key, files) { files.forEach(f => { if (f?.file) fd.append(key, f.file); }); }

    function alertReq(msg) { sweetAlert("Required", msg, "warning"); }
    function alertErr(msg) { sweetAlert("Error", msg, "error"); }
    function alertWarn(t, m) { sweetAlert(t, m, "warning"); }
    function alertInfo(m) { sweetAlert("Info", m, "info"); }

    /* ------------------ Templates (global) ------------------ */
    const DocTemplate = {
        row(type, i, num, date, docType, html, driverName,isVehicleDL) {

            switch (type) {
                case "DL":
                const driverTd = isVehicleDL
                    ? ""
                    : `<td class="text-center dl-driver-cell">${driverName || "-"}</td>`;
                    return `
			  <tr>
				<td class="text-center">${i}</td>
				<td class="text-center">${num}</td>
				<td class="text-center">${date}</td>
				<td class="text-center">${docType || "-"}</td>
                ${driverTd}
				<td class="text-center attachment-cell">${html}</td>
				<td class="text-center"><button class="btn btn-danger btn-xs remove-doc">Remove</button></td>
			  </tr>`;
                case "RC":
                    return `
			  <tr>
				<td class="text-center">${i}</td>
				<td class="text-center">${num}</td>
				<td class="text-center">${date}</td>
				<td class="text-center" style="word-break:break-all;">${html}</td>
				<td class="text-center"><button class="btn btn-danger btn-xs remove-doc">Remove</button></td>
			  </tr>`;
                case "Insurance":
                case "PUC":
                    return `
			  <tr>
				<td class="text-center">${i}</td>
				<td class="text-center">${num}</td>
				<td class="text-center">${date}</td>
				<td class="text-center" style="word-break:break-all;">${html}</td>
				<td class="text-center"><button class="btn btn-danger btn-xs remove-doc">Remove</button></td>
			  </tr>`;
            }
        }
    };

    /* ------------------ API (global) ------------------ */
    function apiLoadEmployee(empCode, onOk, onNotFound) {
        $.ajax({
            url: "/Vehicle/GetEmployeeByCode",
            type: "GET",
            data: { empCode },
            success: function (data) {
                if (data.success && data.result) onOk?.(data.result);
                else {
                    onNotFound?.(data);
                    alert(data.Message || "Employee not found.");
                }
            },
            error: function () {
                onNotFound?.();
                alert("Error fetching employee details");
            }
        });
    }

    /* ------------------ UI ------------------ */
    function uiInit() {
        initEmployeeAutocomplete();
        attachUppercaseInputs();
        initCustodianAutocomplete($(".vehicle-custodian"));
        initCaretIcons();
    }

    function initEmployeeAutocomplete() {
        const $input = $("#txtOEmpcode");

        $input.autocomplete({
            source: "/IOM/AutocompleteSuggestions",
            minLength: 2,
            select: function (_e, ui) {
                if (!ui.item) return;
                const codeOnly = ui.item.value.split('-')[0].trim();
                apiLoadEmployee(codeOnly, fillEmployeeDetails);
            }
        });

        $input.on("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const typed = $input.val().trim();
                if (!typed) return;
                const codeOnly = typed.split('-')[0].trim();
                apiLoadEmployee(codeOnly, fillEmployeeDetails);
            }
        });
    }

    function fillEmployeeDetails(data) {
        $("#EmployeeName").val(data.FullName);
        $("#MobileNumber").val(data.MobileNumber);
        $("#Location").val(data.LocationName);
        $("#EmployeeDesignation").val(data.Designation);
        $("#EmployeeDepartment").val(data.Department);
    }

    function initCustodianAutocomplete($input) {
        $input.autocomplete({
            source: "/IOM/AutocompleteSuggestions",
            minLength: 2,
            select: function (_e, ui) {
                if (!ui.item) return;
                const codeOnly = ui.item.value.split('-')[0].trim();
                const $block = $(this).closest(".vehicle-block");
                apiLoadEmployee(codeOnly,
                    data => fillCustodianFields($block, data),
                    () => clearCustodianFields($block)
                );
            }
        });

        $input.on("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const typed = $(this).val().trim();
                if (!typed) return;
                const codeOnly = typed.split('-')[0].trim();
                const $block = $(this).closest(".vehicle-block");
                apiLoadEmployee(codeOnly,
                    data => fillCustodianFields($block, data),
                    () => clearCustodianFields($block)
                );
            }
        });
    }

    function fillCustodianFields($block, data) {
        $block.find(".cust-name").val(data.FullName);
        $block.find(".cust-dept").val(data.Department);
        $block.find(".cust-desig").val(data.Designation);
    }
    function clearCustodianFields($block) {
        $block.find(".cust-name, .cust-dept, .cust-desig").val("");
    }

    function attachUppercaseInputs() {
        $(document).on("input", ".dl-number, .rc-number, .ins-number, .vehicle-number, .puc-number", function () {
            this.value = this.value.toUpperCase().trim();
        });
    }

    function initCaretIcons() {
        $('#vehicleDetails_0, #vehicleDetails_1, #dl_detail, #emp_detail')
            .on('show.bs.collapse', function () {
                $(this).prev('.panel-heading').find('.caret-color')
                    .removeClass('fa-caret-right').addClass('fa-caret-down');
            })
            .on('hide.bs.collapse', function () {
                $(this).prev('.panel-heading').find('.caret-color')
                    .removeClass('fa-caret-down').addClass('fa-caret-right');
            });
    }


    function validateVehicleBlock($b, category) {
        // Basic fields
        const num = ($b.find(".vehicle-number").val() || "").trim();
        const fuel = ($b.find(".fuel-type").val() || "").trim();
        const year = ($b.find(".model-year").val() || "").trim();
        const ownerType = ($b.find(".owner-type").val() || "").trim();
        const ownerName = ($b.find(".owner-name").val() || "").trim();

        if (!num) return "Vehicle Number is required.";
        if (!fuel) return "Fuel Type is required.";
        if (!year) return "Model Year is required.";

        if (category !== "3") {
            if (ownerType === "") return "Owner Type is required.";
            if (ownerType !== "1" && !ownerName) return "Owner Name is required.";
        }

        // DL Check (company driver)
        if (category === "3") {
            const hasDL = $b.find(".dl-table tbody tr")
                .not(":has(td:contains('No record'))").length > 0;
            if (!hasDL) return "Driving License details are required.";
        }

        // RC
        const hasRC = $b.find(".rc-table tbody tr")
            .not(":has(td:contains('No record'))").length > 0;
        if (!hasRC) return "RC details are required.";

        // Insurance
        const hasIns = $b.find(".insurance-table tbody tr")
            .not(":has(td:contains('No record'))").length > 0;
        if (!hasIns) return "Insurance details are required.";

        // PUC (non-electric)
        if (fuel !== "3" && !isNewVehicle(year)) {
            const hasPUC = $b.find(".puc-table tbody tr")
                .not(":has(td:contains('No record'))").length > 0;
            if (!hasPUC) return "PUC details are required.";
        }

        return null;
    }


    /* ------------------ Vehicle (blocks, category, PUC) ------------------ */
    function vehicleInit() {
        bindCategoryChange();
        bindAddVehicle();
        bindRemoveVehicle();
        bindOwnerType();
        bindFuelTypePUC();
        updateVehicleNote();

        // Ensure initial block visibility on first load
        const $first = $(".vehicle-block").first();
        applyCategoryLogicToBlock($first, $("#VehicleCategory").val() || "");
        syncDLPanels($("#VehicleCategory").val(), $first);
    }

    function getVehicleLimit() {
        const category = $("#VehicleCategory").val();
        return category === "3" ? Infinity : 2;
    }

    function updateVehicleNote() {
        const category = $("#VehicleCategory").val();
        const count = $(".vehicle-block").length;
        const limit = getVehicleLimit();
        if (limit === Infinity) {
            $(".vehicle-note").html(`You can add unlimited vehicles. <span id="vehicleCount">${count}</span> added`);
        } else {
            $(".vehicle-note").html(`You can add a maximum of ${limit} vehicles. <span id="vehicleCount">${count}</span>/${limit} added`);
        }
    }

    function addFreshVehicleBlock() {
        let $original = $(".vehicle-block").first();

        if ($original.length === 0) {
            const html = $("#vehicleTemplate").html()
                .replace(/vehicle-block-template/g, "vehicle-block")
                .replace(/#index#/g, "0")
                .replace(/#INDEX#/g, "1");
            $("#vehicleContainer").html(html);
            $original = $(".vehicle-block").first();
        }

        if ($original.length === 0) { alertErr("Critical: Cannot find base vehicle block."); return; }

        const $new = $original.clone(true, true);
        $new.find("input, select, textarea").each(function () {
            const $el = $(this);
            if ($el.is(":file")) $el.val("");
            else if ($el.is(":checkbox,:radio")) $el.prop("checked", false);
            else $el.val("");
            $el.removeClass("disabled-field").prop("disabled", false);
        });

        setNoRecord(tbody($new, ".dl-table"), 6);
        setNoRecord(tbody($new, ".rc-table"), 5);
        setNoRecord(tbody($new, ".insurance-table"), 6);
        setNoRecord(tbody($new, ".puc-table"), 6);

        $("#vehicleContainer").empty().append($new);
        $("#vehicleCount").text("1");

        const category = $("#VehicleCategory").val();
        if (category === "3") {
            $new.find(".dl-panel-per-vehicle").show();
            $(".dl-global-panel").hide();
        } else {
            $new.find(".dl-panel-per-vehicle").hide();
            $(".dl-global-panel").show();
        }
        syncDLPanels(category, $new);
    }

    function applyCategoryLogicToBlock($block, category) {
        const isCompany = (category === "3");
        const isPersonal = (category === "1" || category === "2");
        const noCategory = (!category || category === "");

        const $ownerTypeLabel = $block.find("label:contains('Owner Type')");
        const $ownerTypeInput = $block.find(".owner-type").closest(".col-md-2");

        const $ownerNameLabel = $block.find("label:contains('Owner Name')");
        const $ownerNameInput = $block.find(".owner-name").closest(".col-md-2");

        const $custLabel = $block.find("label:contains('Vehicle Custodian')");
        const $custInput = $block.find(".vehicle-custodian").closest(".col-md-2");

        const $custWrapper = $block.find(".custodian-wrapper");
        const $ownerSection = $block.find(".owner-section");

        if (noCategory) {
            $ownerTypeLabel.show(); $ownerTypeInput.show();
            $ownerNameLabel.show(); $ownerNameInput.show();
            $custLabel.hide(); $custInput.hide();
            $custWrapper.hide();
            $ownerSection.show();
            return;
        }

        if (isPersonal) {
            $ownerTypeLabel.show(); $ownerTypeInput.show();
            $ownerNameLabel.show(); $ownerNameInput.show();
            $custLabel.hide(); $custInput.hide();
            $custWrapper.hide();
            $ownerSection.show();
            $block.find(".vehicle-custodian").val("");
            $block.find(".cust-name, .cust-dept, .cust-desig").val("");
            return;
        }

        if (isCompany) {
            $ownerTypeLabel.hide(); $ownerTypeInput.hide();
            $ownerNameLabel.hide(); $ownerNameInput.hide();
            $custLabel.show(); $custInput.show();
            $ownerSection.hide();
            $custWrapper.show();
        }
    }

    function syncDLPanels(category, $scope) {
        const isCompany = String(category) === "3";
        const $root = ($scope && $scope.length) ? $scope : $(document);

        if (isCompany) {
            $(".dl-global-panel").hide();
            $root.find(".dl-panel-per-vehicle").each(function () {
                $(this).show();
                const $collapse = $(this).find(".panel-collapse");
                if ($collapse.length) {
                    $collapse.addClass("in").attr("aria-expanded", "true").show();
                }
            });
        } else {
            $(".dl-global-panel").show();
            $root.find(".dl-panel-per-vehicle").hide();
        }
    }

    function bindCategoryChange() {
        $(document).on("change", "#VehicleCategory", () => {
            const category = $("#VehicleCategory").val();
            const isCompany = (category === "3");
            const isPersonal = (category === "1" || category === "2");

            addFreshVehicleBlock();
            const $block = $(".vehicle-block").first();

            applyCategoryLogicToBlock($block, category);

            if (isCompany) {
                $(".dl-global-panel").hide();
                $(".dl-container-panel").show();
                $(".dl-panel-per-vehicle").show();
            } else if (isPersonal) {
                $(".dl-global-panel").show();
                $(".dl-container-panel").show();
                $(".dl-panel-per-vehicle").hide();
            }

            const $globalDL = $(".dl-global-panel .dl-table tbody");
            setNoRecord($globalDL, 6);
            $(".dl-global-panel .dl-number, .dl-global-panel .dl-valid-till, .dl-global-panel .dl-type")
                .prop("disabled", false).removeClass("disabled-field");

            $block.find(
                ".dl-number, .dl-valid-till, .dl-type," +
                ".rc-number, .rc-valid-till," +
                ".ins-number, .ins-valid-till," +
                ".puc-number, .puc-valid-till"
            ).prop("disabled", false).removeClass("disabled-field");

            initCustodianAutocomplete($block.find(".vehicle-custodian"));
            updateVehicleNote();
            syncDLPanels(category, $block);
        });
    }

    function validateBeforeSubmit() {
        const category = $("#VehicleCategory").val();

        // Employee
        const rawEmp = $("#txtOEmpcode").val().trim();
        if (!rawEmp) return "Employee Code is required.";

        // Global DL (personal/self)
        if (category !== "3") {

            // 1. Ensure table has rows
            const $rows = $(".dl-global-panel .dl-table tbody tr")
                .not(":has(td:contains('No record'))");

            if ($rows.length === 0)
                return "Driving License details are required.";

            // 2. Read DL number from table, NOT input
            const num = $rows.first().find("td").eq(1).text().trim();

            if (!num)
                return "DL Number is required.";

            if (!DOC_REGEX.DL.test(num))
                return "Invalid DL Number format.";
        }

        // Every vehicle validation
        let error = null;

        $(".vehicle-block").each(function () {
            if (error) return;
            error = validateVehicleBlock($(this), category);
        });

        return error;
    }

    // Check if vehicle is new (model year current or next year)
    // function isNewVehicle(modelYearValue) {
    //     if (!modelYearValue) return false;
    //     const selectedYear = parseInt(modelYearValue.split('-')[0], 10);
    //     const currentYear = new Date().getFullYear();
    //     return selectedYear === currentYear || selectedYear === currentYear + 1;
    // }
    function isNewVehicle(modelYearValue) {
        if (!modelYearValue) return false;

        // "2025-04-01" → Date object
        const modelDate = new Date(modelYearValue);
        if (isNaN(modelDate)) return false;

        const today = new Date();

        // Model date + 1 year
        const oneYearLater = new Date(modelDate);
        oneYearLater.setFullYear(oneYearLater.getFullYear() + 1);

        return today >= modelDate && today <= oneYearLater;
    }

    // Apply PUC visibility for new vehicle rule
    function applyPUCVisibilityForNewVehicle($block) {
        const modelYear = $block.find(".model-year").val();
        const $pucPanel = $block.find('.panel-heading:contains("PUC Details")').closest('.panel');
        const $existingNotice = $block.find(".puc-new-vehicle-notice");

        if (isNewVehicle(modelYear)) {
            // Clear PUC if any data exists (only if not already cleared)
            const hasPuc = rowCount(tbody($block, ".puc-table")) > 0;
            if (hasPuc) {
                if (!confirm("PUC is not required for new vehicles (valid for one year from the date of purchase/registration).\nExisting PUC data will be removed. Continue?")) {
                    return;
                }
                $block.find(".puc-number, .puc-valid-till").val("");
                $block.find(".puc-file").val("");
                setNoRecord(tbody($block, ".puc-table"), 6);
            }

            $pucPanel.slideUp(400);
            if ($existingNotice.length === 0) {
                $pucPanel.before('<div class="alert alert-info puc-new-vehicle-notice puc-note mt-3"><strong>Note:</strong> PUC is not required for new vehicles (valid for one year from the date of purchase/registration).</div>');
            }
        } else {
            $pucPanel.slideDown(400);
            $existingNotice.remove();
        }
    }

    // Helper: Get all existing Vehicle Numbers (across all vehicle blocks)
    function getAllExistingVehicleNumbers() {
        const existing = new Set();
        $(".vehicle-block").each(function () {
            const vNum = $(this).find(".vehicle-number").val().trim().toUpperCase();
            if (vNum) existing.add(vNum);
        });
        return existing;
    }


    function bindAddVehicle() {
        $(document).on("click", "#btnAddVehicle", (e) => {
            const isUserClick = !!e.originalEvent;

            const limit = getVehicleLimit();
            const current = $(".vehicle-block").length;
            const category = $("#VehicleCategory").val();

            // ✅ validate only when user clicked, not during bootstrap
            if (isUserClick && current > 0) {
                const $prev = $(".vehicle-block").eq(current - 1); // previous filled block
                const msg = validateVehicleBlock($prev, category);
                if (msg) {
                    alertErr(msg);
                    return;
                }
            }

            if (current >= limit) {
                sweetAlert(
                    "Limit Exceeded",
                    limit === Infinity
                        ? "Unlimited vehicles allowed for Company Driver."
                        : `Maximum ${limit} vehicles allowed.`,
                    "warning"
                );
                return;
            }
            const $current = $(".vehicle-block").last();
            // ====== Vehicle Number duplicate check (fixed) ======
            const currentNum = $current.find(".vehicle-number").val().trim().toUpperCase();
            if (currentNum) {
                let duplicateFound = false;
                $(".vehicle-block").not($current).each(function () {
                    const otherNum = $(this).find(".vehicle-number").val().trim().toUpperCase();
                    if (otherNum === currentNum) {
                        duplicateFound = true;
                        return false; // loop break
                    }
                });

                if (duplicateFound) {
                    sweetAlert("Validation", "Duplicate Vehicle Number! This Vehicle Number is already used in another vehicle.", "warning");
                    return;
                }
            }
            // ==================================================

            // --- ADD NEW VEHICLE BLOCK ---
            const index = current;
            const html = $("#vehicleTemplate").html()
                .replace(/vehicle-block-template/g, "vehicle-block")
                .replace(/#index#/gi, index)       // case-insensitive
                .replace(/#INDEX#/g, index + 1);

            $("#vehicleContainer").append(html);

            const $newBlock = $("#vehicleContainer .vehicle-block").last();

            if (category === "3") $newBlock.find(".dl-panel-per-vehicle").show();
            else $newBlock.find(".dl-panel-per-vehicle").hide();

            $("#vehicleCount").text(index + 1);

            applyCategoryLogicToBlock($newBlock, category);
            initCustodianAutocomplete($newBlock.find(".vehicle-custodian"));

            updateVehicleNote();

            $(".vehicle-block").not(":last").find(".panel-collapse").collapse("hide");
            syncDLPanels(category, $newBlock);

            // Blank tables per vehicle
            setNoRecord(tbody($newBlock, ".dl-table"), 6);
            setNoRecord(tbody($newBlock, ".rc-table"), 5);
            setNoRecord(tbody($newBlock, ".insurance-table"), 6);
            setNoRecord(tbody($newBlock, ".puc-table"), 6);

            renumberVehicleBlocks();
        });

    }

    function bindRemoveVehicle() {
        $(document).on("click", ".remove-vehicle", (event) => {
            const $blk = $(event.currentTarget).closest(".vehicle-block");
            if ($(".vehicle-block").length <= 1) {
                alertWarn("Not Allowed", "At least one vehicle block is required.");
                return;
            }

            $blk.remove();
            $("#vehicleCount").text($(".vehicle-block").length);

            renumberVehicleBlocks();
            updateVehicleNote();
        });
    }

    function bindOwnerType() {
        $(document).on("change", ".owner-type", function () {
            const $block = $(this).closest(".vehicle-block");
            const $ownerName = $block.find(".owner-name");
            if ($(this).val() === "1") {
                $ownerName.val("").prop("disabled", true).addClass("disabled-field");
            } else {
                $ownerName.prop("disabled", false).removeClass("disabled-field");
            }
        });
    }

    function bindFuelTypePUC() {
        $(document).on("change", ".fuel-type", function () {
            const $block = $(this).closest(".vehicle-block");
            const fuel = $(this).val() || "";
            const $pucPanel = $block.find('.panel-heading:contains("PUC Details")').closest('.panel');

            if (fuel === "3") { // Electric
                const hasPuc = rowCount(tbody($block, ".puc-table")) > 0;
                if (hasPuc) {
                    if (!confirm("PUC is not required for Electric Vehicles.\nAll PUC data will be deleted. Do you want to continue?")) {
                        $(this).val(""); // revert
                        return;
                    }
                }
                $block.find(".puc-number, .puc-valid-till").val("");
                $block.find(".puc-file").val("");
                setNoRecord(tbody($block, ".puc-table"), 6);
                $pucPanel.slideUp(400);
                $block.find(".puc-new-vehicle-notice, .puc-electric-notice").remove();
                if (!$block.find(".puc-electric-notice").length) {
                    $pucPanel.before('<div class="alert alert-info puc-electric-notice puc-note mt-3"><strong>Note:</strong> PUC is not required for Electric Vehicles.</div>');
                }
            } else {
                // Non-electric: remove electric note + apply new vehicle rule
                $block.find(".puc-electric-notice").remove();
                applyPUCVisibilityForNewVehicle($block);
            }
        });

        // Page load pe initial check
        $(".vehicle-block").each(function () {
            const $block = $(this);
            const fuel = $block.find(".fuel-type").val();
            if (fuel === "3") {
                const $pucPanel = $block.find('.panel-heading:contains("PUC Details")').closest('.panel');
                $pucPanel.hide();
                if (!$block.find(".puc-electric-notice").length) {
                    $pucPanel.before('<div class="alert alert-info puc-electric-notice mt-3"><strong>Note:</strong> PUC is not required for Electric Vehicles.</div>');
                }
            } else {
                applyPUCVisibilityForNewVehicle($block);
            }
        });
    }

    $(document).on("change", ".model-year", function () {
        const $block = $(this).closest(".vehicle-block");
        const fuel = $block.find(".fuel-type").val() || "";

        if (fuel === "3") {
