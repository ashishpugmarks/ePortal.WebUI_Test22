    function normalizePath(url) {
        try {
            const u = new URL(url);
            return u.pathname.replace(/^\/+/, "");
        } catch {
            return url;  // if already relative
        }
    }

    function buildAndSend() {
        const rawEmp = $("#txtOEmpcode").val().trim();
        if (!rawEmp) return alertErr("Employee Code is required.");

        // ======  ======
        const allVehicleNumbers = getAllExistingVehicleNumbers();
        if (allVehicleNumbers.size !== $(".vehicle-block").length) {
            sweetAlert("Validation", "Duplicate Vehicle Number found! Each vehicle must have a unique Vehicle Number.", "warning");
            return;
        }
        // ============================================================

        const empCode = rawEmp.match(/^\d+/)?.[0] || "";
        const category = $("#VehicleCategory").val();

        const fd = new FormData();
        fd.append("EmpCode", empCode);
        fd.append("VehicleType", $("input[name='VehicleType']:checked").val());
        fd.append("VehicleCategory", category);

        /* --------------------------------------------------------
           GLOBAL DL (Self/Personal)
        ---------------------------------------------------------*/
        if (category !== "3") {

            const $rows = $(".dl-global-panel .dl-table tbody tr:not(:has(td:contains('No record')))");

            if ($rows.length) {

                // Metadata → always from FIRST row
                const $first = $rows.first();
                fd.append("DLNumber", $first.find("td:eq(1)").text().trim());
                fd.append("DLValidTill", $first.find("td:eq(2)").text().trim());
                fd.append("DLType", $first.find("td:eq(3)").text().trim());
                fd.append("DriverName", $first.find("td:eq(4)").text().trim());
                // STEP A — NEW files (REAL File objects only)
                const newFiles = [];
                $rows.each(function () {
                    const rowFiles = $(this).data("files");  // buildFileArray stores ONLY real File objects
                    if (Array.isArray(rowFiles) && rowFiles.length > 0) {
                        newFiles.push(...rowFiles);
                    }
                });

                // STEP B — OLD DL paths that still exist in UI
                const existingPathsStillPresent = [];

                $rows.each(function () {
                    $(this).find("td:eq(4) a.file-link").each(function () {
                        const linkPath = $(this).attr("href");

                        // OLD file = real URL (not blob)
                        if (linkPath && !linkPath.startsWith("blob:")) {
                            existingPathsStillPresent.push(normalizePath(linkPath));
                        }
                    });
                });

                // STEP C — Append OLD DL file paths
                for (const path of existingPathsStillPresent) {
                    fd.append("DLFilePaths", path);
                }

                // STEP D — Append NEW DL files
                for (const file of newFiles) {
                    fd.append("DLFiles", file);
                }
            }
        }

        /* --------------------------------------------------------
           VEHICLES LOOP START
        ---------------------------------------------------------*/
        $(".vehicle-block").each(function (i) {
            const $v = $(this);
            const prefix = `Vehicles[${i}]`;
            const custRaw = ($v.find(".vehicle-custodian").val() || "").toString().trim();
            const custExtract = custRaw.match(/^\d+/)?.[0] || "";
            fd.append(`${prefix}.Id`, $v.attr("data-detail-id") || 0);
            fd.append("VehicleId", STATE.editModel?.VehicleId || 0);
            fd.append(`${prefix}.VehicleNumber`,
                ($v.find(".vehicle-number").val() || "").toString().trim());
            fd.append(`${prefix}.VehicleCustodian`, custExtract);
            fd.append(`${prefix}.VehicleCategory`, category);
            fd.append(`${prefix}.FuelType`, $v.find(".fuel-type").val());
            fd.append(`${prefix}.ModelYear`, $v.find(".model-year").val());
            fd.append(`${prefix}.OwnerType`, $v.find(".owner-type").val());
            fd.append(`${prefix}.OwnerName`,
                ($v.find(".owner-name").val() || "").toString().trim());

            /* --------------------------------------------------------
               PER-VEHICLE DL (Company Driver)
            ---------------------------------------------------------*/
            if (category === "3") {
                const $rows = $v.find(".dl-panel-per-vehicle .dl-table tbody tr")
                    .not(":has(td:contains('No record'))");
                const $first = $rows.first();

                if ($first.length) {
                    const rowFiles = $first.data("files") || [];
                    const hasNew = rowFiles.length > 0;

                    fd.append(`${prefix}.DLNumber`, $first.find("td:eq(1)").text().trim());
                    fd.append(`${prefix}.DLValidTill`, $first.find("td:eq(2)").text().trim());
                    fd.append(`${prefix}.DLType`, $first.find("td:eq(3)").text().trim());

                    if (hasNew) {
                        $rows.each(function () {
                            appendFiles(fd,
                                `${prefix}.DLFiles`,
                                $(this).data("files") || []);
                        });
                    } else {
                        (STATE.editModel?.Vehicles?.[i]?.DLFilePaths || []).forEach(x => {
                            fd.append(`${prefix}.DLFilePaths`, x);
                        });
                    }
                }
            }

            /* --------------------------------------------------------
               RC
            ---------------------------------------------------------*/
            const $rcRows = $v.find(".rc-table tbody tr:not(:has(td:contains('No record')))");

            if ($rcRows.length) {

                // Metadata from first row
                const $first = $rcRows.first();
                fd.append(`Vehicles[${i}].RCNumber`, $first.find("td:eq(1)").text().trim());
                fd.append(`Vehicles[${i}].RCValidTill`, $first.find("td:eq(2)").text().trim());

                // STEP A — Collect NEW files
                const newFiles = [];
                $rcRows.each(function () {
                    const rowFiles = $(this).data("files");
                    if (Array.isArray(rowFiles) && rowFiles.length > 0) {
                        newFiles.push(...rowFiles);
                    }
                });

                // STEP B — Collect OLD paths that still exist in UI (multiple link support)
                const existingPathsStillPresent = [];
                $rcRows.each(function () {
                    $(this).find("td:eq(3) a.file-link").each(function () {
                        const linkPath = $(this).attr("href");
                        if (linkPath && !linkPath.startsWith("blob:")) {
                            existingPathsStillPresent.push(normalizePath(linkPath));
                        }
                    });
                });

                // STEP C — Append OLD file paths
                for (const path of existingPathsStillPresent) {
                    fd.append(`Vehicles[${i}].RCFilePaths`, path);
                }

                // STEP D — Append NEW file(s)
                for (const file of newFiles) {
                    fd.append(`Vehicles[${i}].RCFile`, file);
                }
            }




            /* --------------------------------------------------------
               INSURANCE
            ---------------------------------------------------------*/
            const $insRows = $v.find(".insurance-table tbody tr:not(:has(td:contains('No record')))");

            if ($insRows.length) {

                const $first = $insRows.first();
                fd.append(`${prefix}.InsuranceNumber`, $first.find("td:eq(1)").text().trim());
                fd.append(`${prefix}.InsuranceValidTill`, $first.find("td:eq(2)").text().trim());

                // NEW FILES
                const newFiles = [];
                $insRows.each(function () {
                    const rowFiles = $(this).data("files");
                    if (Array.isArray(rowFiles) && rowFiles.length > 0) {
                        newFiles.push(...rowFiles);
                    }
                });

                // OLD FILE PATHS (only the ones visible in UI)
                const existingPathsStillPresent = [];

                $insRows.each(function () {
                    $(this).find("td:eq(3) a.file-link").each(function () {
                        const linkPath = $(this).attr("href");
                        if (linkPath && !linkPath.startsWith("blob:")) {
                            existingPathsStillPresent.push(normalizePath(linkPath));
                        }
                    });
                });

                // Append OLD paths (all of them)
                for (const path of existingPathsStillPresent) {
                    fd.append(`${prefix}.InsuranceFilePaths`, path);
                }

                // Append NEW files
                for (const file of newFiles) {
                    fd.append(`${prefix}.InsuranceFile`, file);
                }
            }



            /* --------------------------------------------------------
               PUC (skip Electric)
            ---------------------------------------------------------*/
            const fuel = $v.find(".fuel-type").val();

            if (fuel !== "3") {

                const $pucRows = $v.find(".puc-table tbody tr:not(:has(td:contains('No record')))");

                if ($pucRows.length) {

                    // Metadata from first row
                    const $first = $pucRows.first();
                    fd.append(`Vehicles[${i}].PUCNumber`, $first.find("td:eq(1)").text().trim());
                    fd.append(`Vehicles[${i}].PUCValidTill`, $first.find("td:eq(2)").text().trim());

                    // STEP A — NEW files
                    const newFiles = [];
                    $pucRows.each(function () {
                        const rowFiles = $(this).data("files");
                        if (Array.isArray(rowFiles) && rowFiles.length > 0) {
                            newFiles.push(...rowFiles);
                        }
                    });

                    // STEP B — OLD visible paths (multi-link support)
                    const existingPathsStillPresent = [];
                    $pucRows.each(function () {
                        $(this).find("td:eq(3) a.file-link").each(function () {
                            const linkPath = $(this).attr("href");
                            if (linkPath && !linkPath.startsWith("blob:")) {
                                existingPathsStillPresent.push(normalizePath(linkPath));
                            }
                        });
                    });

                    // STEP C — Append OLD paths
                    for (const path of existingPathsStillPresent) {
                        fd.append(`Vehicles[${i}].PUCFilePaths`, path);
                    }

                    // STEP D — Append NEW files
                    for (const file of newFiles) {
                        fd.append(`Vehicles[${i}].PUCFile`, file);
                    }
                }
            }
        });

        /* --------------------------------------------------------
           FINAL SUBMIT
        ---------------------------------------------------------*/
        $.ajax({
            url: "/Vehicle/Edit",
            method: "POST",
            data: fd,
            processData: false,
            contentType: false,
            success: (res) => {

                if (res?.Success) {
                    swal({
                        title: "Success",
                        text: res.Message || "Vehicle updated successfully.",
                        type: "success"
                    }, function () {
                        window.location.href = `/Vehicle/myrequest`;
                    });
                } else {
                    sweetAlert("Error", res.Message || "Something went wrong.", "error");
                }
            },
            error: () => sweetAlert("Error", "Failed to update vehicle.", "error")
        });
    }

    /* ------------------ Edit Mode Bootstrap ------------------ */
    function editInit() {
        const editModel = STATE.editModel;
        if (!editModel || !editModel.Vehicles) return;

        const category = String(editModel.VehicleCategory || "");
        $("#VehicleCategory").val(category).prop("disabled", true);

        $("#vehicleContainer").empty();
        addFreshVehicleBlock();

        // Toggle DL panels top-level
        if (category === "3") {
            $(".dl-global-panel").hide();
            $(".dl-panel-per-vehicle").show();
        } else {
            $(".dl-global-panel").show();
            $(".dl-panel-per-vehicle").hide();
        }

        if (category === "2") {
            // $(".dl-driver-header").show();
            $(".driver-info-msg").show();
            $(".dl-driver-cell").show();
            $(".driver-name").show();
        } else {
            // $(".dl-driver-header").hide();
            $(".dl-driver-cell").hide();
            $(".dl-driver-name").val("");
            $(".driver-info-msg").hide();
            $(".driver-name").hide();
        }

        const total = editModel.Vehicles.length;
        for (let i = 1; i < total; i++) {
            $("#btnAddVehicle").trigger("click");
        }

        $(".vehicle-block").each(function (i) {
            const v = editModel.Vehicles[i];
            if (!v) return;
            const $b = $(this);

            $b.attr("data-detail-id", v.Id || 0);
            applyCategoryLogicToBlock($b, category);
            $b.find(".vehicle-number").val(v.VehicleNumber);
            $b.find(".fuel-type").val(String(v.FuelType));
            $b.find(".model-year").val(formatDateSafe(v.ModelYear));
            $b.find(".owner-type")
                .val(String(v.OwnerType))
                .trigger("change");
            $b.find(".owner-type").val(String(v.OwnerType));
            $b.find(".owner-name").val(v.OwnerName);
            $b.find(".vehicle-custodian").val(v.VehicleCustodian);
            $b.find(".cust-name").val(v.CustodianEmpName);
            $b.find(".cust-dept").val(v.CustodianDepartment);
            $b.find(".cust-desig").val(v.CustodianDesignation);

            $b.find(".cust-name, .cust-dept, .cust-desig")
                .prop("disabled", true)
                .addClass("disabled-field");

            initCustodianAutocomplete($b.find(".vehicle-custodian"));

            const fuel = String(v.FuelType);
            $b.find(".fuel-type").val(fuel).trigger("change");

            if (category === "3" && v.DLNumber) {
                insertDocumentRow($b, "DL", v,true);
                lockFields($b.find(".dl-number, .dl-valid-till, .dl-type, .dl-file"), true);
            }
            if (v.RCNumber) {
                insertDocumentRow($b, "RC", v);
                lockFields($b.find(".rc-number, .rc-valid-till, .rc-file"), true);
            }
            if (v.InsuranceNumber) {
                insertDocumentRow($b, "Insurance", v);
                lockFields($b.find(".ins-number, .ins-valid-till, .ins-file"), true);
            }
            if (String(v.FuelType) !== "3" && v.PUCNumber) {
                insertDocumentRow($b, "PUC", v);
                lockFields($b.find(".puc-number, .puc-valid-till, .puc-file"), true);
            }
        });

        if (category !== "3" && editModel.DLNumber) {
            const $panel = $(".dl-global-panel");
            insertDocumentRow($panel, "DL", {
                DLNumber: editModel.DLNumber,
                DLValidTill: editModel.DLValidTill,
                DLType: editModel.DLType,
                DLFilePaths: editModel.DLFilePaths ?? [],
                DriverName: editModel.DriverName,
            },false);
            lockFields($panel.find(".dl-number, .dl-valid-till, .dl-type, .dl-driver-name, .dl-file"), true);
        }

        syncDLPanels(category, $(".vehicle-block"));
        updateVehicleNote();
    }

    /* ------------------ Events ------------------ */
    function eventsInit() {
        bindSubmit();
        bindTypeChangeClear();
    }

    function bindSubmit() {
        $(document).on("click", "#submitbtn", function (e) {
            e.preventDefault();

            const msg = validateBeforeSubmit();
            if (msg) {
                alertErr(msg);
                return;
            }

            buildAndSend();
        });
    }

    function bindTypeChangeClear() {
        $(document).on("change", "input[name='VehicleType']", function () {
            let hasData = false;
            $(".vehicle-block").each(function () {
                $(this).find("input, select, textarea").each(function () {
                    const v = ($(this).val() || "").toString().trim();
                    if (v) { hasData = true; return false; }
                });
                if (hasData) return false;
            });

            if (hasData) {
                sweetAlert({
                    title: "Are you sure?",
                    text: "Changing Vehicle Type or Category will remove all entered vehicle details!",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#DD6B55",
                    confirmButtonText: "Clear All",
                    cancelButtonText: "Cancel",
                    closeOnConfirm: true,
                    closeOnCancel: true
                }, function (isConfirm) {
                    if (isConfirm) addFreshVehicleBlock();
                });
            } else {
                addFreshVehicleBlock();
            }
        });
    }

    /* ------------------ Bootstrap ------------------ */
    $(document).ready(() => initApp());

               document.addEventListener("DOMContentLoaded", function () {

            const vehicleTypeRadios = document.querySelectorAll("input[name='VehicleType']");
            const vehicleCategory = document.getElementById("VehicleCategory");

            vehicleTypeRadios.forEach(radio => {
                radio.addEventListener("change", function () {

                    if (this.value === "2") { // Four Wheeler
                        vehicleCategory.value = "1";     // Self Driver
                        vehicleCategory.disabled = true;
                    }
                    else {
                        vehicleCategory.disabled = false;
                        vehicleCategory.value = "";      // Reset selection
                    }
                });
            });

        });
</script>


