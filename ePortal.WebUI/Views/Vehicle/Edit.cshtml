    function addDocumentRow({
        $block,isVehicleDL = false, tableSelector, numSelector, dateSelector,
        typeSelector = null, fileSelector, label, max = 2, regex = null
    }) {
        const $tbody = $block.find(`${tableSelector} tbody`);
        const count = $tbody.find("tr").not(":has(td:contains('No record'))").length;

        if (count >= max) { alertWarn("Limit Reached!", `Maximum ${max} ${label} documents allowed.`); return false; }

        const $num = $block.find(numSelector);
        const $date = $block.find(dateSelector);
        const $type = typeSelector ? $block.find(typeSelector) : null;
        const $file = $block.find(fileSelector);

        let numVal = ($num.val() || "").toString().trim();
        let dateVal = ($date.val() || "").toString().trim();
        let typeVal = $type ? ($type.val() || "").toString().trim() : "";
        let driverName = "";
        if (label === "DL") {
            driverName = $(".dl-driver-name").val()?.trim() || "";
        }
        const files = $file[0].files;

        if (count === 0) {
            if (!numVal) return alertErr(`Please enter ${label} Number`);
            if (regex && !regex.test(numVal)) return alertErr(`Invalid ${label} Number`);
            if (label !== "RC" && !dateVal) return alertErr(`Please select ${label} Valid Till`);
            if (files.length === 0) return alertErr(`Please upload ${label} file`);

            if (label === "DL") {
                const category = $("#VehicleCategory").val();
                if (category === "2") { // Personal Driver
                    if (!driverName) return alertErr("Please enter Driver Name");
                }
            }

            // ====== Duplicate checks for RC, Insurance, PUC and DL ======
            const currentNum = numVal.trim().toUpperCase();

            if (label === "RC") {
                const existing = getAllExistingRCNumbers();
                if (existing.has(currentNum)) {
                    alertErr("Duplicate RC Number! This RC Number is already used in another vehicle.");
                    return false;
                }
            } else if (label === "Insurance") {
                const existing = getAllExistingInsuranceNumbers();
                if (existing.has(currentNum)) {
                    alertErr("Duplicate Insurance Number! This Insurance Number is already used in another vehicle.");
                    return false;
                }
            } else if (label === "PUC") {
                const existing = getAllExistingPUCNumbers();
                if (existing.has(currentNum)) {
                    alertErr("Duplicate PUC Number! This PUC Number is already used in another vehicle.");
                    return false;
                }
            } else if (label === "DL") {
                const existing = getAllExistingDLNumbers();
                if (existing.has(currentNum)) {
                    alertErr("Duplicate DL Number! This DL Number is already used.");
                    return false;
                }
            }
            // ===========================================================

            lockFields($num, true);
            lockFields($date, true);
            if ($type) lockFields($type, true);
        } else {
            if (files.length === 0) return alertErr(`Please upload ${label} file`);
            // reuse first locked values
            numVal = $num.val().trim().toUpperCase();
            dateVal = $date.val();
            typeVal = $type ? $type.val() : "";
        }

        const { arr, html } = buildFileArray(files);
        if ($tbody.find("td").text().includes("No record")) $tbody.empty();
        const rowHtml = DocTemplate.row(label, count + 1, numVal, dateVal, typeVal, html, driverName, isVehicleDL);
        const $row = $(rowHtml);
        $row.data("files", arr);
        $tbody.append($row);
        $file.val("");

        return true;
    }

    function insertDocumentRow($scope, kind, v,isVehicleDL) {
        const map = {
            DL: {
                table: ".dl-table",
                num: v.DLNumber,
                date: formatDateSafe(v.DLValidTill),
                type: v.DLType,
                file: v.DLFilePaths,
                drivername: v.DriverName,
            },
            RC: {
                table: ".rc-table",
                num: v.RCNumber,
                date: formatDateSafe(v.RCValidTill),
                file: v.RCFilePaths
            },
            Insurance: {
                table: ".insurance-table",
                num: v.InsuranceNumber,
                date: formatDateSafe(v.InsuranceValidTill),
                file: v.InsuranceFilePaths
            },
            PUC: {
                table: ".puc-table",
                num: v.PUCNumber,
                date: formatDateSafe(v.PUCValidTill),
                file: v.PUCFilePaths
            }
        };

        const cfg = map[kind];
        if (!cfg || !cfg.num) return;

        const $tbody = $scope.find(cfg.table + " tbody");
        clearNoRecord($tbody);

        let html = "";
        const baseUrl = window.location.origin; // http://localhost:44378

        if (cfg.file && Array.isArray(cfg.file)) {
            cfg.file.forEach(path => {
                if (!path) return;
                const fileName = path.split("/").pop();
               const fullUrl = `${baseUrl}/${path}`;   // ⭐ FINAL CORRECT URL
               // const fullUrl = `${encodeURIComponent(path)}`;
                html += `<a href="${fullUrl}" target="_blank" class="file-link">${fileName}</a><br>`;
            });
        }

        const rowHtml = DocTemplate.row(
            kind,
            rowCount($tbody) + 1,
            cfg.num,
            cfg.date || "",
            cfg.type || "",
            html,
            cfg.drivername || "-",
            isVehicleDL
        );

        const $row = $(rowHtml);
        $row.data("files", []);
        $tbody.append($row);
    }



