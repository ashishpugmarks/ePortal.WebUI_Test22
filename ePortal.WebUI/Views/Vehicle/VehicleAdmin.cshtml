        }

        .filter-section-outer {
            padding: 0 15px !important;
        }
    </style>
}

<div class="panel-group theme_inner-page" >

    <div class="panel panel-primary panel-2">
        <div class="align-items-center d-flex justify-content-between p10 panel-heading custom-panel-heading">
            <h2 class="panel-title">Admin Approvals</h2>
        </div>
        <!-- Summary Statistics -->
        <!-- Summary Statistics -->
        <div class="stats-container">
            <!-- Pehle ke 3 cards same rahenge -->
            <div class="stat-card">
                <div class="stat-number">@(Model.VehicleMaster?.Count ?? 0)</div>
                <div class="stat-label">Total Vehicles</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@(Model.PendingVehicles)</div>
                <div class="stat-label">Pending Vehicles</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@(Model.ApprovedVehicles)</div>
                <div class="stat-label">Approved Vehicles</div>
            </div>

            <!-- Total Parking Zone -->
            <div class="stat-card clickable-stat" data-target="totalZones">
                <div class="stat-number">@Model.TotalZones.Count()</div>
                <div class="stat-label">Total Parking Zone</div>
                <div class="detail-link">Click here for details</div>
            </div>

            <!-- Zone occupied -->
            <div class="stat-card clickable-stat" data-target="occupiedZones">
                <div class="stat-number">@Model.ZonesOccupied.Count()</div>
                <div class="stat-label">Zone occupied</div>
                <div class="detail-link">Click here for details</div>
            </div>

            <!-- Active/Inactive Zone -->
            <div class="stat-card clickable-stat" data-target="activeInactiveZones">
                <div class="stat-number">@Model.ActiveZones.Count() / @Model.InactiveZones.Count()</div>
                <div class="stat-label">Active / Inactive Zone</div>
                <div class="detail-link">Click here for details</div>
            </div>
        </div>
        

        <!-- Filter Section -->
        <div class="filter-section-outer">
        <div class="filter-section">
            @* <h5><i class="fas fa-filter"></i> Filter Items</h5> *@
            <form method="get" id="filterForm">
                <div class="filter-row">
                    <div class="filter-group">
                        <label for="vehicleStatus">Status</label>
                        <select id="vehicleStatus" name="vehicleStatus" class="form-control">
                            <option value="">All Status</option>
                            <option value="0">Pending Review</option>
                            <option value="1">Approved</option>
                            <option value="2">Send Back</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="status">Vehicle Category</label>
                        <select id="status" name="status" class="form-control">
                            <option value="">All Category</option>
                            <option value="1">Self Driver</option>
                            <option value="2">Personal Driver</option>
                            <option value="3">Company Driver</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="location">Location</label>
                        <select id="location" name="location" class="form-control">
                            <option value="">All Location</option>

                            @if (Model?.Location != null && Model.Location.Any())
                            {
                                foreach (var loc in Model.Location)
                                {
                                    <option value="@loc.Value">@loc.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="dateFrom">Date From</label>
                        <input type="date" id="dateFrom" name="dateFrom" class="form-control" />
                    </div>
                    <div class="filter-group">
                        <label for="dateTo">Date To</label>
                        <input type="date" id="dateTo" name="dateTo" class="form-control" />
                    </div>
                    <div class="filter-actions">
                        <button type="button" class="btn-filter" id="btnFilter">
                            <i class="fas fa-search"></i> Search
                        </button>
                        <button type="button" class="btn-clear" id="clearFiltersBtn">
                            <i class="fas fa-times"></i> Clear
                        </button>
                        <button type="button" class="btn-export" id="exportToExcel">
                            <i class="fas fa-times"></i> Export
                        </button>
                    </div>
                </div>
            </form>
        </div>
        </div>
        <div class="panel-body p15">
            @if (Model == null || !Model.VehicleMaster.Any())
            {
                <div class="empty-state">
                    <i class="fas fa-search"></i>
                    <h4>No Items Found</h4>
                    <p>There are currently no items to display.</p>
                </div>
            }
            else
            {
                <div class="table-container">

                    <div class="table-responsive">
                        <table class="table" id="myrequesttable">
                            <thead>
                                <tr>
                                    <th style="cursor: pointer;">
                                        <div class="header-flex">Sr No <i class="fa fa-sort"></i></div>
                                    </th>
                                    <th style="cursor: pointer;">
                                        <div class="header-flex">VehicleId <i class="fa fa-sort"></i></div>
                                    </th>
                                    <th style="cursor: pointer;">
                                        <div class="header-flex">VehicleCategory <i class="fa fa-sort"></i></div>
                                    </th>

                                    <th style="cursor: pointer;">
                                        <div class="header-flex">Created Date <i class="fa fa-sort"></i></div>
                                    </th>
                                    <th style="cursor: pointer;">
                                        <div class="header-flex">Status <i class="fa fa-sort"></i></div>
                                    </th>
                                    <th style="cursor: pointer;">
                                        <div class="header-flex">Location <i class="fa fa-sort"></i></div>
                                    </th>
                                    <th style="cursor: pointer;">
                                        <div class="header-flex">Employee <i class="fa fa-sort"></i></div>
                                    </th>
                                    <th style="cursor: pointer;">
                                        <div class="header-flex">Zone <i class="fa fa-sort"></i></div>
                                    </th>
                                    <th>View</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody id="tableBody">
                                @{
                                    int counter = 1;
                                }

                                @foreach (var item in Model.VehicleMaster)
                                {
                                    <tr>
                                        <td>@counter</td>

                                        <td>
                                            <strong>@item.VehicleId</strong>
                                        </td>

                                        <td>
                                            <span class="status-badge">
                                                @(((VehicleCategory)item.VehicleCategory).GetText())
                                            </span>
                                        </td>

                                        <td>@item.CreatedDate.ToString("MMM dd, yyyy")</td>

                                        @{
                                            var latest = item.VehicleHistory?
                                            .OrderByDescending(x => x.Id)
                                            .FirstOrDefault();

                                            var statusText = ((VehicleStatus)(latest?.AdminStatus ?? 0)).GetText();

                                            var sendBackRaw = ((VehicleSendBackType)(latest?.SendBackFor ?? 0)).GetText();
                                            var sendBackText = latest?.AdminStatus == 2
                                            ? $"({sendBackRaw})"
                                            : "";
                                        }
                                        <td>
                                            @statusText @sendBackText
                                        </td>

                                        <td>@(item.Location.Text)</td>
                                        <td>@(item.EmpCode) - @(item.EmpName)</td>
                                        <td>@(item.ParkingZone?.ZONE_NAME ?? "-")</td>
                                        <td class="view-icon">
                                            <a href="@Url.Action("Detail", "Vehicle", new { id = item.VehicleId })">
                                            <span class="glyphicon glyphicon-eye-open text-warning"></span>
                                            </a>
                                        </td>
                                        @{
                                            var previousZoneId = latest?.ParkingZoneId;
                                            var previousRemark = latest?.AdminRemark ?? "";
                                        }
                                        <td class="admin-actions">
                                            @if (item.VehicleHistory?.OrderByDescending(x => x.Id).FirstOrDefault()?.AdminStatus == 1)
                                             { 
                                                 <button class="btn-approve disabled" disabled>Approve</button> 
                                             } 
                                             else 
                                             {
                                                <button class="btn-approve"
                                                        data-item-id="@item.VehicleId"
                                                        data-previous-zone-id="@previousZoneId"
                                                        data-previous-remark="@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(previousRemark)">
                                                    Approve
                                                </button>
                                             } 
                                        </td>
                                        
                                    </tr>

                                    counter++;
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="text-center" >
                        <ul class="pagination justify-content-center" id="pagination"></ul>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Zone Details Modal -->
<div class="modal fade" id="zoneDetailsModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="zoneModalTitle">Zone Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead class="thead-light">
                            <tr>
                                <th>Sr No</th>
                                <th>Zone Name</th>
                                <th>Total Capacity</th>
                                <th>Assigned</th>
                                <th>Remaining</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="zoneDetailsTableBody">
                            <!-- Rows will be injected via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Approve Modal -->
<div class="modal fade approveModal" id="approveModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="approveModalLabel">Approve</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="stats-container">
                    <div class="stat-card">
                        <div class="stat-number">0</div>
                        <div class="stat-label">Total Parking Capacity</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">0</div>
                        <div class="stat-label">Assigned Parking Capacity</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">0</div>
                        <div class="stat-label">Remaining Parking Capacity</div>
                    </div>

                </div>

                <form id="approveForm">
                    <div class="form-group">
                        <label>Parking Zone</label>
                        <select id="zoneSelect" name="zoneSelect" class="form-control">
                            <option value="">Select Zone</option>
                        </select>
                    </div>

                    <input type="hidden" id="approveItemId" />
                    <div class="mb-3">
                        <label for="approveRemarks" class="form-label">Remarks </label>
                        <textarea class="form-control" id="approveRemarks" rows="3" placeholder="Please provide reason for approve..." required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="submitApproveBtn">Approve</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@Context.Items["ScriptNonce_1"]">

        var originalRows = [];
        var allRows = [];
        var currentPage = 1;
        var rowsPerPage = 20;

        $(document).ready(function () {
            initTable();
            bindFilters();
        });

        // ----------------------------------------------------
        // INIT TABLE
        // ----------------------------------------------------
        function initTable() {
            originalRows = $('#tableBody tr').toArray();
            allRows = [...originalRows];
            currentPage = 1;

            $("#myrequesttable th").off("click").on("click", function () {
                if (!$(this).find("i.fa-sort").length) return;

                var table = $(this).closest("table");
                var rows = table.find("tbody tr").toArray().sort(comparer($(this).index()));
                this.asc = !this.asc;

                if (!this.asc) rows.reverse();

                $('#tableBody').empty().append(rows);
                allRows = rows;
                showPage(1);
            });

            showPage(1);
        }

        // ----------------------------------------------------
        // FILTERS
        // ----------------------------------------------------
        function bindFilters() {

            $("#btnFilter").on("click", function () {
                var statusVal = $("#vehicleStatus").val().trim();
                var categoryVal = $("#status").val().trim();
                var fromDate = $("#dateFrom").val();
                var toDate = $("#dateTo").val();
                var locationVal = $("#location").val();

                var filtered = originalRows.filter(function (row) {
                    var r = $(row);
                    let rowStatus = r.find("td:nth-child(5)").text().trim();
                    rowStatus = rowStatus.replace(/\(.*?\)/g, "").trim();
                    var rowCategory = r.find("td:nth-child(3)").text().trim();
                    var rowDate = r.find("td:nth-child(4)").text().trim();
                    var rowLocation = r.find("td:nth-child(6)").text().trim();
                    

                    // Status match
                    if (statusVal && rowStatus !== getStatusText(statusVal)) return false;

                    //Location
                    if (locationVal && rowLocation !== $("#location option:selected").text()) return false;

                    // Category match
                    if (categoryVal && rowCategory !== getCategoryText(categoryVal)) return false;

                    // Date match
                    if (fromDate || toDate) {

                        var rowD = parseDate(rowDate);
                        if (!rowD) return false;

                        // Normalize all to 00:00:00 (important!)
                        rowD.setHours(0, 0, 0, 0);

                        if (fromDate) {
                            var fd = new Date(fromDate);
                            fd.setHours(0, 0, 0, 0);
                            if (rowD < fd) return false;
                        }

                        if (toDate) {
                            var td = new Date(toDate);
                            td.setHours(23, 59, 59, 999);
                            if (rowD > td) return false;
                        }
                    }

                    return true;
                });

                $('#tableBody').empty().append(filtered);
                allRows = [...filtered];
                showPage(1);
            });

            $("#clearFiltersBtn").on("click", function () {

                $("#vehicleStatus").val("");
                $("#status").val("");
                $("#dateFrom").val("");
                $("#dateTo").val("");

                $('#tableBody').empty().append(originalRows);
                allRows = [...originalRows];

                showPage(1);
            });
        }

        // ----------------------------------------------------
        // STATUS TEXT (MATCH HTML EXACTLY)
        // ----------------------------------------------------
        function getStatusText(val) {
            if (val === "0") return "Pending Review";
            if (val === "1") return "Approved";
            if (val === "2") return "Send Back";
            return "";
        }

        function getCategoryText(val) {
            if (val === "1") return "Self Driver";
            if (val === "2") return "Personal Driver";
            if (val === "3") return "Company Driver";
            return "";
        }

        // ----------------------------------------------------
        // DATE PARSER (MMM dd, yyyy SAFE PARSING)
        // ----------------------------------------------------
        function parseDate(text) {
            if (!text) return null;

            var parts = text.replace(",", "").split(" ");
            if (parts.length !== 3) return null;

            var month = new Date(Date.parse(parts[0] + " 1, 2000")).getMonth();
            var day = parseInt(parts[1]);
            var year = parseInt(parts[2]);

            return new Date(year, month, day);
        }

        $('#exportToExcel').on('click', function () {

            const payload = {
                Status: $('#vehicleStatus').val() !== ''
                    ? parseInt($('#vehicleStatus').val(), 10)
                    : null,

                VehicleCategory: $('#status').val() !== ''
                    ? parseInt($('#status').val(), 10)
                    : null,

                LocationId: $('#location').val() !== ''
                    ? parseInt($('#location').val(), 10)
                    : null,

                DateFrom: $('#dateFrom').val() || null,
                DateTo: $('#dateTo').val() || null
            };

            $.ajax({
                url: '/Vehicle/ExportAdminReportToExcel',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response && response.success === true) {
                        window.location.href = response.downloadUrl;
                    } else {
                        alert(response?.message || 'No data available for export.');
                    }
                },
                error: function (xhr) {
                    alert('Export failed. Please try again.');
                }
            });
        });



        // ----------------------------------------------------
        // SORTING
        // ----------------------------------------------------
        function comparer(index) {
            return function (a, b) {
                var valA = getCellValue(a, index);
                var valB = getCellValue(b, index);

                return $.isNumeric(valA) && $.isNumeric(valB)
                    ? valA - valB
                    : valA.toString().localeCompare(valB);
            };
        }

        function getCellValue(row, index) {
            return $(row).children("td").eq(index).text();
        }

        // ----------------------------------------------------
        // PAGINATION
        // ----------------------------------------------------
        function showPage(page) {
            currentPage = page;
            var startIndex = (page - 1) * rowsPerPage;
            var endIndex = startIndex + rowsPerPage;

            $('#tableBody tr').hide();

            for (var i = startIndex; i < endIndex && i < allRows.length; i++) {
                $(allRows[i]).show();
            }

            updatePagination();
        }

        function updatePagination() {
            var totalPages = Math.ceil(allRows.length / rowsPerPage);
            var pagination = $('#pagination');

            pagination.empty();

            if (totalPages <= 1) {
                pagination.hide();
                return;
            }

            pagination.show();

            if (currentPage > 1) {
                $('<li class="page-item"><a class="page-link" href="#">Previous</a></li>')
                    .click(() => showPage(currentPage - 1))
                    .appendTo(pagination);
            }

            for (let i = 1; i <= totalPages; i++) {
                let item = $('<li class="page-item"><a class="page-link" href="#">' + i + '</a></li>');
                if (i === currentPage) item.addClass("active");

                item.click(() => showPage(i));
                pagination.append(item);
            }

            if (currentPage < totalPages) {
                $('<li class="page-item"><a class="page-link" href="#">Next</a></li>')
                    .click(() => showPage(currentPage + 1))
                    .appendTo(pagination);
            }
        }

        //Approval Modal
        $(document).on('click', '.btn-approve', function () {
            const itemId = $(this).data('item-id');
            const previousZoneId = $(this).data('previous-zone-id'); 
            const previousRemark = $(this).data('previous-remark') || '';

            const row = $(this).closest('tr');
            const statusText = row.find('td:nth-child(5)').text().trim();
            const isSendBack = statusText.includes('Send Back');

            showApproveModal(itemId, previousZoneId, previousRemark, isSendBack);
        });

        function showApproveModal(itemId, previousZoneId = null, previousRemark = '', isSendBack = false) {
            $('#approveItemId').val(itemId);
            $('#approveRemarks').val('');
            $('#zoneSelect').val('');
            resetStatCards();

            $('#approveModal').off('shown.bs.modal');
            $('#approveModal').modal('show');

            $('#approveModal').on('shown.bs.modal', function () {
                loadZonesAndStats(itemId, previousZoneId, previousRemark, isSendBack);
            });
        }

        function loadZonesAndStats(itemId, previousZoneId, previousRemark, isSendBack) {
            $.ajax({
                url: `/Vehicle/ZoneStatistics?vehicleId=${itemId}`,
                type: "GET",
                success: function (zones) {
                    const ddl = $('#zoneSelect');
                    ddl.empty();
                    ddl.append('<option value="">Select Zone</option>');

                    zones.forEach(z => {
                        ddl.append(`<option value="${z.Id}">${z.ZoneName}</option>`);
                    });

                    window.__zonesCache = zones;

                    if (isSendBack && previousZoneId && zones.some(z => z.Id == previousZoneId)) {
                        // Previous zone select karo
                        ddl.val(previousZoneId);
                        const selectedZone = zones.find(z => z.Id == previousZoneId);
                        if (selectedZone) {
                            updateStatCards(selectedZone);
                        }

                        // Previous admin remark auto-fill (agar hai toh)
                        if (previousRemark && previousRemark.trim() !== '') {
                            $('#approveRemarks').val(previousRemark.trim());
                        } else {
                            $('#approveRemarks').val('Re-approving after send back.');
                        }
                    } else {
                        // Normal case: blank rakho
                        ddl.val('');
                        resetStatCards();
                        $('#approveRemarks').val('');
                    }
                },
                error: function () {
                    alert('Failed to load zones.');
                    resetStatCards();
                }
            });
        }

        // On zone change, update cards
        $(document).on('change', '#approveModal #vehicleStatus', function () {
            const selectedId = $(this).val();

            // If user selects "Select Zone" (empty value)
            if (!selectedId) {
                resetStatCards();
                return;
            }

            const zone = window.__zonesCache.find(z => String(z.Id) === String(selectedId));
            if (zone) updateStatCards(zone);
        });

        $(document).on('change', '#zoneSelect', function () {
            const selectedId = $(this).val();
            if (!selectedId) {
                resetStatCards();
                return;
            }
            const zone = window.__zonesCache.find(z => String(z.Id) === String(selectedId));
            if (zone) updateStatCards(zone);
        });

        function resetStatCards() {
            const modal = $('#approveModal');
            modal.find('.stat-card').eq(0).find('.stat-number').text(0);
            modal.find('.stat-card').eq(1).find('.stat-number').text(0);
            modal.find('.stat-card').eq(2).find('.stat-number').text(0);
        }   

        function updateStatCards(zone) {
            const modal = $('#approveModal');

            modal.find('.stat-card').eq(0).find('.stat-number').text(zone.TotalCount);
            modal.find('.stat-card').eq(1).find('.stat-number').text(zone.Assigned);
            modal.find('.stat-card').eq(2).find('.stat-number').text(zone.Remaining);
        }

        $(document).on('click', '#submitApproveBtn', function () {
            submitApprove();
        });

        function submitApprove() {

            const itemId = $('#approveItemId').val().trim();
            const zoneId = $('#zoneSelect').val();
            const remarks = $('#approveRemarks').val().trim();

            // Basic validation
            if (!itemId) {
                sweetAlert("Error", "Invalid Item ID.", "error");
                return;
            }

            if (!zoneId) {
                sweetAlert("Warning", "Please select a Zone.", "warning");
                return;
            }

            if (!remarks) {
                sweetAlert("Warning", "Remarks are required.", "warning");
                return;
            }

            const payload = {
                VehicleId: parseInt(itemId, 10),
                ZoneId: parseInt(zoneId, 10),
                Remark: remarks
            };


            // Confirm dialog
            sweetAlert({
                title: "Are you sure?",
                text: "Do you want to approve this item?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, Approve",
                closeOnConfirm: false
            }, function () {

                $.ajax({
                    url: "/Vehicle/ApproveAdminRequest",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),

                    success: function (res) {

                        if (res.Success) {

                            sweetAlert({
                                title: "Approved!",
                                text: "Vehicle has been approved successfully.",
                                type: "success"
                            });

                            $('#approveModal').modal('hide');

                            setTimeout(() => {
                                location.reload();
                            }, 1000);

                        } else {
                            sweetAlert("Error", res.Message || "Approve failed.", "error");
                        }
                    },

                    error: function (xhr) {
                        console.error(xhr.responseText);
                        sweetAlert("Error", "Something went wrong while approving.", "error");
                    }
                });

            });
        }


                // Store zone data from server for quick access
        var zoneData = {
            totalZones: @Html.Raw(Json.Serialize(Model.TotalZones)),
            occupiedZones: @Html.Raw(Json.Serialize(Model.ZonesOccupied)),
            activeZones: @Html.Raw(Json.Serialize(Model.ActiveZones)),
            inactiveZones: @Html.Raw(Json.Serialize(Model.InactiveZones))
        };

        // Click on stat card to show zone details
        $(document).on('click', '.clickable-stat', function () {
            var target = $(this).data('target');
            var zones = [];
            var title = '';

            if (target === 'totalZones') {
                zones = zoneData.totalZones;
                title = 'All Parking Zones';
            } else if (target === 'occupiedZones') {
                zones = zoneData.occupiedZones;
                title = 'Occupied Zones';
            } else if (target === 'activeInactiveZones') {
                // Combine active and inactive for one view
                zones = [...zoneData.activeZones, ...zoneData.inactiveZones];
                title = 'Active / Inactive Zones';
            }

            $('#zoneModalTitle').text(title);
            var tbody = $('#zoneDetailsTableBody');
            tbody.empty();

            if (zones.length === 0) {
                tbody.append('<tr><td colspan="7" class="text-center">No zones found</td></tr>');
            } else {
        zones.forEach((zone, index) => {
            var status = zone.IsActive
                ? '<span class="badge badge-success">Active</span>'
                : '<span class="badge badge-danger">Inactive</span>';

            var total = zone.TotalCapacity || 0;
            var remaining = zone.AvailableCapacity || 0; 
            var assigned = total - remaining;

            if (assigned < 0) {
                assigned = 0;
                remaining = total;
            }

            tbody.append(`
                <tr>
                    <td>${index + 1}</td>
                    <td>${zone.ZoneName || '-'}</td>
                    <td>${total}</td>
                    <td>${assigned}</td>
                    <td>${remaining}</td>
                    <td>${status}</td>
                </tr>
            `);
        });
            }

            $('#zoneDetailsModal').modal('show');
        });

    </script>
}