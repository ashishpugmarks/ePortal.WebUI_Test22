@section Scripts {
    <script nonce="@Context.Items["ScriptNonce_1"]">

        const rowsPerPage = 20;
        let originalRows = [];
        let allRows = [];
        let currentPage = 1;

        $(document).ready(() => {
            initTable();
            bindFilters();
            bindActionButtons();
        });

        // ============================
        // INIT TABLE
        // ============================
        function initTable() {
            originalRows = $('#tableBody tr').toArray();
            allRows = [...originalRows];
            currentPage = 1;

            $("#myrequesttable th").off("click").on("click", function () {
                if (!$(this).find("i.fa-sort").length) return;

                const index = $(this).index();
                const rows = $('#tableBody tr').toArray().sort(comparer(index));

                this.asc = !this.asc;
                if (!this.asc) rows.reverse();

                $('#tableBody').empty().append(rows);
                allRows = rows;

                showPage(1);
            });

            showPage(1);
        }

        // ============================
        // FILTERS
        // ============================
        function bindFilters() {

            $("#btnFilter").on("click", () => {

                const statusVal = $("#vehicleStatus").val().trim();
                const categoryVal = $("#status").val().trim();
                const fromDate = $("#dateFrom").val();
                const toDate = $("#dateTo").val();
                var locationVal = $("#location").val();

                const filtered = originalRows.filter(row => {
                    const r = $(row);

                    let rowStatus = r.find("td:nth-child(5)").text().trim();
                    rowStatus = rowStatus.replace(/\(.*?\)/g, "").trim();
                    const rowCategory = r.find("td:nth-child(3)").text().trim();
                    const rowDate = r.find("td:nth-child(4)").text().trim();
                    var rowLocation = r.find("td:nth-child(6)").text().trim();

                    if (statusVal && rowStatus !== getStatusText(statusVal)) return false;
                    if (locationVal && rowLocation !== $("#location option:selected").text()) return false;
                    if (categoryVal && rowCategory !== getCategoryText(categoryVal)) return false;

                    if (fromDate || toDate) {
                        const rd = parseDate(rowDate);
                        if (!rd) return false;

                        rd.setHours(0, 0, 0, 0);

                        if (fromDate) {
                            const fd = new Date(fromDate);
                            fd.setHours(0, 0, 0, 0);
                            if (rd < fd) return false;
                        }

                        if (toDate) {
                            const td = new Date(toDate);
                            td.setHours(23, 59, 59, 999);
                            if (rd > td) return false;
                        }
                    }

                    return true;
                });

                $('#tableBody').empty().append(filtered);
                allRows = [...filtered];
                showPage(1);
            });

            $("#clearFiltersBtn").on("click", () => {
                $("#vehicleStatus, #status, #dateFrom, #dateTo").val("");
                $('#tableBody').empty().append(originalRows);
                allRows = [...originalRows];
                showPage(1);
            });
        }

        $('#exportToExcel').on('click', function () {

            const payload = {
                Status: $('#vehicleStatus').val() !== ''
                    ? parseInt($('#vehicleStatus').val(), 10)
                    : null,

                VehicleCategory: $('#status').val() !== ''
                    ? parseInt($('#status').val(), 10)
                    : null,

                LocationId: $('#location').val() !== ''
                    ? Number($('#location').val())
                    : null,

                DateFrom: $('#dateFrom').val() || null,
                DateTo: $('#dateTo').val() || null
            };

            $.ajax({
                url: '/Vehicle/ExportSecurityReportToExcel',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response && response.success === true) {
                        window.location.href = response.downloadUrl;
                    } else {
                        alert(response?.message || 'No data available for export.');
                    }
                },
                error: function () {
                    alert('Export failed. Please try again.');
                }
            });
        });



        // ============================
        // TEXT MAPPERS
        // ============================
        const statusMap = {
            "0": "Pending Review",
            "1": "Approved",
            "2": "Send Back",
            "3": "Reject",
            "4": "Hold",
            "5": "Deactivated"
        };

        const categoryMap = {
            "1": "Self Driver",
            "2": "Personal Driver",
            "3": "Company Driver"
        };

        const getStatusText = val => statusMap[val] || "";
        const getCategoryText = val => categoryMap[val] || "";

        // ============================
        // DATE PARSER
        // ============================
        function parseDate(text) {
            if (!text) return null;

            const parts = text.replace(",", "").split(" ");
            if (parts.length !== 3) return null;

            const month = new Date(Date.parse(parts[0] + " 1, 2000")).getMonth();
            return new Date(parseInt(parts[2]), month, parseInt(parts[1]));
        }

        // ============================
        // SORTING
        // ============================
        const getCellValue = (row, index) =>
            $(row).children("td").eq(index).text();

        const comparer = index => (a, b) => {
            const A = getCellValue(a, index);
            const B = getCellValue(b, index);

            return $.isNumeric(A) && $.isNumeric(B)
                ? A - B
                : A.localeCompare(B);
        };

        // ============================
        // PAGINATION
        // ============================
        function showPage(page) {
            currentPage = page;
            const start = (page - 1) * rowsPerPage;
            const end = start + rowsPerPage;

            $('#tableBody tr').hide().slice(start, end).show();
            updatePagination();
        }

        function updatePagination() {
            const totalPages = Math.ceil(allRows.length / rowsPerPage);
            const container = $('#pagination');
            container.empty();

            if (totalPages <= 1) return container.hide();
            container.show();

            if (currentPage > 1)
                addPageButton("Previous", () => showPage(currentPage - 1));

            for (let i = 1; i <= totalPages; i++)
                addPageButton(i, () => showPage(i), i === currentPage);

            if (currentPage < totalPages)
                addPageButton("Next", () => showPage(currentPage + 1));
        }

        function addPageButton(text, handler, active = false) {
            const item = $(`<li class="page-item ${active ? "active" : ""}">
                                <a class="page-link" href="#">${text}</a>
                            </li>`);
            item.click(handler);
            $('#pagination').append(item);
        }

        // ============================
        // ACTION BUTTON EVENTS
        // ============================
        function bindActionButtons() {
            $(document)
                .on("click", ".btn-approve", function () {
                    openModal('#approveModal', '#approveItemId', $(this).data('item-id'));
                })
                .on("click", ".btn-sendback", function () {
                    openModal('#sendBackModal', '#sendBackItemId', $(this).data('item-id'));
                    $('#sendBackFor').val("");
                })
                .on("click", ".btn-hold", function () {
                    openModal('#holdModal', '#holdItemId', $(this).data('item-id'));
                })
                .on("click", ".deactivate-vehicle", function () {
                    openModal('#deactivateModal', '#deactivateItemId', $(this).data('item-id'));
                })
                .on("click", ".btn-reject", function () {
                    openModal('#rejectModal', '#rejectItemId', $(this).data('item-id'));
                });


            $("#submitApproveBtn").on("click", submitApprove);
            $("#submitsendBackBtn").on("click", submitSendBack);
            $("#submitRejectBtn").on("click", submitReject);
            $("#submitHoldBtn").on("click", submitHold);
            $("#submitDeactivateBtn").on("click", deactivateVehicle);
        }

        function openModal(modalId, inputId, itemId) {
            $(inputId).val(itemId);
            $(`${modalId} textarea`).val("");
            $(modalId).modal("show");
        }

        // ============================
        // ACTION SUBMITTERS
        // ============================
        function submitApprove() {
            const itemId = $("#approveItemId").val().trim();
            const remarks = $("#approveRemarks").val().trim();

            if (!itemId || !remarks)
                return sweetAlert("Warning", "Remarks are required.", "warning");

            sendVehicleAction({
                VehicleId: +itemId,
                Action: 1,
                Remark: remarks
            }, "approve", "#approveModal");
        }

        function deactivateVehicle() {
            const itemId = $("#deactivateItemId").val().trim();
            const remarks = $("#deactivateRemarks").val().trim();

            if (!itemId || !remarks)
                return sweetAlert("Warning", "Remark are required.", "warning");

            deactivate({
                VehicleId: Number(itemId),
                ActionByRole: 2,
                Remark: remarks
            }, "deactivate", "#deactivateModal");
        }

        function deactivate(payload, actionName, modalId) {

            sweetAlert({
                title: "Are you sure?",
                text: `Do you want to ${actionName} this Vehicle?`,
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes",
                closeOnConfirm: false
            }, () => {

                $.ajax({
                    url: "/Vehicle/DeactivateVehicle",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    processData: false,
                    data: JSON.stringify(payload),

                    success: res => {
                        const success = res.success ?? res.Success;
                        const message = res.message ?? res.Message;

                        if (success) {
                            sweetAlert("Success", message || "Action completed.", "success");
                            $(modalId).modal("hide");
                            setTimeout(() => location.reload(), 800);
                        } else {
                            sweetAlert("Error", message || "Action failed.", "error");
                        }
                    },


                    error: xhr => {
                        console.error(xhr.responseText);
                        sweetAlert("Error", "Server error.", "error");
                    }
                });


            });
        }

        function submitSendBack() {
            const itemId = $("#sendBackItemId").val().trim();
            const sendbackfor = $("#sendBackFor").val().trim();
            const remark = $("#sendBackRemarks").val().trim();

            if (!itemId || !remark)
                return sweetAlert("Warning", "Remark are required.", "warning");

            if (!sendbackfor)
                return sweetAlert("Warning", "Send back for are required.", "warning");

            sendVehicleAction({
                VehicleId: +itemId,
                Action: 2,
                Sendbackfor: +sendbackfor,
                Remark: remark
            }, "SendBack", "#sendBackModal");
        }

        function submitReject() {
            const itemId = $("#rejectItemId").val().trim();
            const remarks = $("#rejectRemarks").val().trim();

            if (!itemId || !remarks)
                return sweetAlert("Warning", "Remark are required.", "warning");

            sendVehicleAction({
                VehicleId: +itemId,
                Action: 3,
                Remark: remarks
            }, "reject", "#rejectModal");
        }

        function submitHold() {
            const itemId = $("#holdItemId").val().trim();
            const remarks = $("#holdRemarks").val().trim();

            if (!itemId || !remarks)
                return sweetAlert("Warning", "Remark are required.", "warning");

            sendVehicleAction({
                VehicleId: +itemId,
                Action: 4,
                Remark: remarks
            }, "hold", "#holdModal");
        }

        // ============================
        // SHARED AJAX HANDLER
        // ============================
        function sendVehicleAction(payload, actionName, modalId) {

            sweetAlert({
                title: "Are you sure?",
                text: `Do you want to ${actionName} this Vehicle?`,
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes",
                closeOnConfirm: false
            }, () => {

                $.ajax({
                    url: "/Vehicle/VehicleSecurityAction",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),

                    success: res => {
                        if (res.Success) {
                            sweetAlert("Success", `Vehicle ${actionName}ed successfully.`, "success");
                            $(modalId).modal("hide");
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            sweetAlert("Error", res.Message || `${actionName} failed.`, "error");
                        }
                    },

                    error: xhr => {
                        console.error(xhr.responseText);
                        sweetAlert("Error", "Something went wrong.", "error");
                    }
                });

            });
        }

    </script>
}
