				$("#addZoneModal").modal("show");
			});

			$(document).on("click", ".btn-deleteZone", function () {
				const id = $(this).data("id");
				if (!id) return;

						swal({
				title: "Are you sure?",
				text: "Do you really want to delete this zone?",
				type: "warning",
				showCancelButton: true,
				confirmButtonColor: "#DD6B55",
				confirmButtonText: "Yes, delete it!",
				cancelButtonText: "Cancel",
				closeOnConfirm: false,
				closeOnCancel: true
			}, function (isConfirm) {
				if (!isConfirm) return;

				fetch(`/Vehicle/DeleteZone?id=${id}`, { method: "POST" })
					.then(async res => {
						const data = await res.json();

						if (!res.ok || data.Success === false) {
							throw new Error(data.Message || "Failed to delete zone.");
						}

						swal({
							title: "Deleted!",
							text: data.Message || "Zone deleted successfully",
							type: "success"
						}, function () {
							location.reload();
						});
					})
					.catch(err => {
						swal("Error", err.message || "Failed to delete zone.", "error");
					});
			});
			});

			$(document).on("click", ".btn-editZone", async function () {
				const id = $(this).data("id");
				if (!id) return;

				try {
					const res = await fetch(`/Vehicle/GetZoneById?id=${id}`);
					if (!res.ok) throw new Error();

					const data = await res.json();

					$("#zoneId").val(data.Id);
					$("#zoneName").val(data.ZoneName);
					$("#zoneDescription").val(data.Description);
					$("#location").val(data.LocationId);
					$("#capacity").val(data.Capacity);
					$("#isActive").val(data.IsActive ? "true" : "false");

					$("#addZoneModal .modal-title").text("Update Parking Zone");
					$(".btn-saveZone").text("Update");

					$("#addZoneModal").modal("show");

				} catch {
					swal("Error", "Failed to fetch zone details", "error");
				}
			});


