@using static ePortal.ViewModels.VehicleDTO
@model List<ePortal.ViewModels.VehicleDTO.ParkingZoneDto>

@{
	ViewBag.Title = "VehiclePortal";
	Layout = "~/Views/Shared/_Layout.cshtml";
	var today = DateTime.Now.ToString("yyyy-MM-dd");
}
@section Styles
{
	<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">

		.empty-state {
			padding: 15px !important;
