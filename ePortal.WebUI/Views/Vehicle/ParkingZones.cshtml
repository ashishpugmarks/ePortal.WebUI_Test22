<div class="theme_inner-page">
<div class="panel-group">

	<div class="panel panel-primary panel-2">
		<div class="align-items-center d-flex justify-content-between p10 panel-heading custom-panel-heading">
			<h2 class="panel-title">Parking Zones</h2>
		</div>
		<!-- Filter Section -->
			<div class="filter-section-outer ">
		<div class="filter-section">
			@* <h5><i class="fas fa-filter"></i> Filter Items</h5> *@
			<form method="get" id="filterForm">
				<div class="filter-row">
					<div class="filter-group">
						<label for="itemType">Status</label>
						<select id="itemType" name="itemType" class="form-control">
							<option value="">All Status</option>
							<option value="1">Active</option>
							<option value="2">Inactive</option>
						</select>
					</div>
					<div class="filter-group">
						<label for="dateFrom">Date From</label>
						<input type="date" id="dateFrom" name="dateFrom" class="form-control" />
					</div>
					<div class="filter-group">
						<label for="dateTo">Date To</label>
						<input type="date" id="dateTo" name="dateTo" class="form-control" />
					</div>
					<div class="filter-actions">
						<button type="button" class="btn-filter" id="btnFilter">
							<i class="fas fa-search"></i> Search
						</button>
						<button type="button" class="btn-clear" id="clearFiltersBtn">
							<i class="fas fa-times"></i> Clear
						</button>
					</div>
				</div>
			</form>
		</div>
		</div>

		<div class="panel-body p15">
				<div class="createZone">
					<button class="btn btn-sm btn-success btn-createZone">
						Add Zone
					</button>
			</div>

			<div class="table-container">

				<div class="table-responsive">
					<table class="table" id="zoneTable">
						<thead>
							<tr>
								<th style="cursor: pointer;">
									<div class="header-flex">Sr No <i class="fa fa-sort"></i></div>
								</th>
								<th style="cursor: pointer;">
									<div class="header-flex">ZoneId <i class="fa fa-sort"></i></div>
								</th>
								<th style="cursor: pointer;">
									<div class="header-flex">ZoneName <i class="fa fa-sort"></i></div>
								</th>

								<th style="cursor: pointer;">
									<div class="header-flex">Total Parking Capacity <i class="fa fa-sort"></i></div>
								</th>
								<th style="cursor: pointer;">
									<div class="header-flex">Available Parking Capacity <i class="fa fa-sort"></i></div>
								</th>
								<th style="cursor: pointer;">
									<div class="header-flex">Location <i class="fa fa-sort"></i></div>
								</th>
								<th style="cursor: pointer;">
									<div class="header-flex">Status <i class="fa fa-sort"></i></div>
								</th>
								<th style="cursor: pointer;">
									<div class="header-flex">Created Date <i class="fa fa-sort"></i></div>
								</th>
								<th>Edit</th>
								<th>Delete</th>
							</tr>
						</thead>

						<tbody id="tableBody">
							@{
								var index = 1;
							}
							@foreach (var item in Model)
							{
								<tr>
									<td>@index</td>

									<td>@item.Id</td>
									<td>@item.ZoneName</td>

									<td>@item.Capacity</td>
									<td>@item.AvailableCapacity</td>
									<td>@item.LocationName</td>

									<td>
										@(item.IsActive ? "Active" : "Inactive")
									</td>

									<td>@item.CreatedAt.ToString("dd-MMM-yyyy HH:mm")</td>

									<td class="view-icon btn-editZone" style="cursor:pointer"
										data-id="@item.Id">
										<span class="glyphicon glyphicon-pencil text-primary"></span>
									</td>

									<td class="view-icon btn-deleteZone" style="cursor:pointer"
										data-id="@item.Id">
										<span class="glyphicon glyphicon-trash text-danger"></span>
									</td>
								</tr>

								index++;
							}
						</tbody>
					</table>
				</div>

				<div class="text-center">
					<ul class="pagination justify-content-center" id="pagination"></ul>
				</div>
			</div>
		</div>

	</div>
</div>
</div>

<!-- Add Zone Modal -->
<div class="modal fade" id="addZoneModal" tabindex="-1" role="dialog">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<input type="hidden" id="zoneId" />
			<div class="modal-header">
				<h4 class="modal-title">Add Parking Zone</h4>
				<button type="button" class="close" data-dismiss="modal">&times;</button>
				
			</div>

			<div class="modal-body">
				<form id="addZoneForm">

					<div class="form-group">
						<label>Zone Name</label>
						<input type="text" id="zoneName" class="form-control" placeholder="Enter zone name" required />
					</div>

					<div class="form-group">
						<label>Description</label>
						<input type="text" id="zoneDescription" class="form-control" placeholder="Enter zone description" required />
					</div>

					<div class="form-group">
						<label>Capacity</label>
						<input type="number" id="capacity" class="form-control" placeholder="Enter capacity" min="1" required />
					</div>

					<div class="form-group">
						<label>Location</label>
						<select id="location" class="form-control">
							<option value="">Select Location</option>
							@foreach (var loc in ViewBag.Locations as List<LocationDto>)
							{
								<option value="@loc.Id">@loc.Text</option>
							}
						</select>
					</div>

					<div class="form-group">
						<label>Status</label>
						<select id="isActive" class="form-control">
							<option value="true">Active</option>
							<option value="false">Inactive</option>
						</select>
					</div>

				</form>
			</div>

			<div class="modal-footer">
				<button class="btn btn-success btn-saveZone">Save</button>
				<button class="btn btn-secondary" data-dismiss="modal">Close</button>
			
			</div>

		</div>
	</div>
</div>



@section Scripts {
	<script nonce="@Context.Items["ScriptNonce_1"]">
			let originalData = [];
			let allData = [];
			let currentPage = 1;
			const rowsPerPage = 10;

			$(document).ready(function () {
					originalData = $('#tableBody tr').map(function () {
						const cells = $(this).find('td');
						const dateText = cells.eq(5).text().trim();
						const datePart = dateText.split(' ')[0];
						const [day, monthStr, year] = datePart.split('-');

						const monthMap = { Jan:0, Feb:1, Mar:2, Apr:3, May:4, Jun:5, Jul:6, Aug:7, Sep:8, Oct:9, Nov:10, Dec:11 };
						const realDate = new Date(parseInt(year), monthMap[monthStr], parseInt(day));

						realDate.setHours(0, 0, 0, 0);

						return {
							element: this,
							srNo: parseInt(cells.eq(0).text()),
							id: parseInt(cells.eq(1).text()),
							zoneName: cells.eq(2).text().trim(),
							capacity: parseInt(cells.eq(3).text()),
							status: cells.eq(4).text().trim(),
							createdDate: realDate
						};
					}).get();

					allData = [...originalData];
					renderTable();
					setupSorting();
					setupFilters();
				});

			function renderTable() {
				const start = (currentPage - 1) * rowsPerPage;
				const end = start + rowsPerPage;
				$('#tableBody').empty().append(allData.slice(start, end).map(x => x.element));
				updatePagination();
			}

			function setupSorting() {
				$('#zoneTable thead th').off('click').on('click', function () {
					const idx = $(this).index();
					if (idx >= 6) return;

					const keyMap = ['srNo', 'id', 'zoneName','zoneDescription', 'capacity', 'status', 'createdDate'];
					const key = keyMap[idx];
					const isAsc = $(this).hasClass('asc');

					allData.sort((a, b) => {
						let valA = a[key], valB = b[key];
						if (key === 'createdDate') return isAsc ? valA - valB : valB - valA;
						if (typeof valA === 'string') valA = valA.toLowerCase();
						if (typeof valB === 'string') valB = valB.toLowerCase();
						return isAsc ? (valA < valB ? -1 : 1) : (valA > valB ? -1 : 1);
					});

					$('#zoneTable thead th').removeClass('asc desc');
					$(this).addClass(isAsc ? 'desc' : 'asc');

					currentPage = 1;
					renderTable();
				});
			}

			function setupFilters() {
				$("#btnFilter").on("click", applyFilters);
				$("#clearFiltersBtn").on("click", function () {
					$("#itemType, #dateFrom, #dateTo").val("");
					allData = [...originalData];
					currentPage = 1;
					renderTable();
				});
			}

			function applyFilters() {
					let filtered = [...originalData];

					const statusVal = $("#itemType").val();
					if (statusVal) {
						const expected = statusVal === "1" ? "Active" : "Inactive";
						filtered = filtered.filter(x => x.status === expected);
					}

					const from = $("#dateFrom").val();
					const to = $("#dateTo").val();

					if (from || to) {
						filtered = filtered.filter(item => {
							const rowDate = item.createdDate;

							if (from) {
								const fromDate = new Date(from);
								fromDate.setHours(0, 0, 0, 0);
								if (rowDate < fromDate) return false;
							}
							if (to) {
								const toDate = new Date(to);
								toDate.setHours(23, 59, 59, 999);
								if (rowDate > toDate) return false;
							}
							return true;
						});
					}

					allData = filtered;
					currentPage = 1;
					renderTable();
				}

			function updatePagination() {
				const totalPages = Math.ceil(allData.length / rowsPerPage);
				const pagination = $('#pagination').empty();

				if (totalPages <= 1) { pagination.hide(); return; }
				pagination.show();

				if (currentPage > 1) {
					$('<li class="page-item"><a class="page-link" href="#">« Previous</a></li>')
						.on('click', () => { currentPage--; renderTable(); }).appendTo(pagination);
				}

				const startPage = Math.max(1, currentPage - 3);
				const endPage = Math.min(totalPages, startPage + 6);

				for (let i = startPage; i <= endPage; i++) {
					const active = i === currentPage ? 'active' : '';
					$('<li class="page-item ' + active + '"><a class="page-link" href="#">' + i + '</a></li>')
						.on('click', () => { currentPage = i; renderTable(); }).appendTo(pagination);
				}

				if (currentPage < totalPages) {
					$('<li class="page-item"><a class="page-link" href="#">Next »</a></li>')
						.on('click', () => { currentPage++; renderTable(); }).appendTo(pagination);
				}
			}

