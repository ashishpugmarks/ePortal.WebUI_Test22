		}

		.filter-section h5 {
			font-size: 16px;
		}

		.filter-section {
			padding: 15px !important;
		}

		.filter-group label {
			font-size: 14px;
			font-weight: 600;
			margin: 0 0 7px 0;
		}

		table thead tr th {
