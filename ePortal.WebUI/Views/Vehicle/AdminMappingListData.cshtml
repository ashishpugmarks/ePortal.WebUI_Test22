@model IEnumerable<ePortal.ViewModels.AdminLocationMapViewModel>

@section Styles {
    <style nonce="@Context.Items["StyleNonce_0"]">

        .table > thead > tr > th {
            padding: 6px 10px;
        }

        .table > tbody > tr > td,
        .table > tbody > tr > th,
        .table > tfoot > tr > td,
        .table > tfoot > tr > th,
        .table > thead > tr > td,
        .table > thead > tr > th {
            padding: 5px;
            line-height: 0.7;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
            border: 1px solid #8ac2de;
            font-size: 70% !important;
            text-align: center;
        }

        .table-bordered {
            border: 1px solid #8ac2de;
        }

        .table > tbody > tr:nth-of-type(even) {
            background: #e9e9e9;
        }

        .pagination {
            margin: 15px 0;
        }

            .pagination .page-link {
                display: block;
                padding: 0.5rem -0.25rem;
                font-size: 13px;
                color: #007bff;
                background-color: #fff;
                border: 1px solid #ddd;
            }

                .pagination .page-link:hover {
                    color: #0056b3;
                    background-color: #e9ecef;
                    border-color: #ddd;
                }
    </style>
}

<div class="panel-group" style="padding: 0px 8px 0px 8px;">

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">
                Admin Mapping
            </h2>
        </div>

        <div class="panel-body">
            <div class="row" style="margin-top:25px;">

                <div class="col-lg-3" style="margin-left: 17px;display: flex;">
                    <input type="text" class="form-control" placeholder="Search..." id="searchInput">
                    <button type="button" class="btn btn-primary" id="btnSearch" style="margin-left: -6px;">
                        <i class="fa fa-search"></i>
                    </button>
                </div>

                <div class="col-lg-3" style="margin-left: 17px;">
                    <a id="btnAdd" class="btn btn-success">
                        <i class="fa fa-plus"></i>&nbsp;Create Mapping
                    </a>
                </div>

            </div>
        </div>

        <br />

        <div class="panel-body">
            <div id="pagination-container" class="text-center">
                <table class="table table-bordered table-responsive" style="margin-bottom:0;">
                    <thead>
                        <tr class="bg-info">
                            <th>Actions <i class="fa fa-sort"></i></th>
                            <th>Site <i class="fa fa-sort"></i></th>
                            <th>Admin Name <i class="fa fa-sort"></i></th>
                            <th>Status <i class="fa fa-sort"></i></th>
                        </tr>
                    </thead>
                    <tbody id="append_Data">
                        <tr><td colspan="4" class="text-center">No record found.</td></tr>
                    </tbody>
                </table>
                <ul class="pagination"></ul>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script nonce="@Context.Items["ScriptNonce_0"]">

        $(document).ready(function () {

            // Sorting
            $("th").click(function () {
                var table = $(this).parents("table").eq(0)
                var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()))
                this.asc = !this.asc
                if (!this.asc) rows = rows.reverse()
                for (var i = 0; i < rows.length; i++) table.append(rows[i])
            });

            function comparer(index) {
                return function (a, b) {
                    var valA = getCellValue(a, index), valB = getCellValue(b, index)
                    return $.isNumeric(valA) && $.isNumeric(valB)
                        ? valA - valB
                        : valA.toString().localeCompare(valB)
                }
            }

            function getCellValue(row, index) {
                return $(row).children("td").eq(index).html()
            }

            $("#btnSearch").click(function () {
                PreLoadData(1, $("#searchInput").val().toLowerCase());
            });

            $("#btnAdd").click(function () {
                ADD();
            });

            $(document).on('click', '.edit-button', function () {
                Edit($(this).data('id'));
            });

            PreLoadData(1, "");
        });

        function PreLoadData(currentPage, value) {

            $.ajax({
                type: "GET",
                url: "/Vehicle/AdminMappingList",
                success: function (data) {

                    var parsed = JSON.parse(data);
                    var recordsPerPage = 20;
                    var startIndex = (currentPage - 1) * recordsPerPage;
                    var endIndex = startIndex + recordsPerPage;

                    var filtered = parsed.filter(function (r) {
                        var val = value.toLowerCase();
                        return (
                            r.SiteName.toLowerCase().includes(val) ||
                            r.AdminName.toLowerCase().includes(val) ||
                            r.IsActive.toString().includes(val)
                        );
                    });

                    var pageData = filtered.slice(startIndex, endIndex);

                    $("#append_Data").empty();

                    if (pageData.length === 0) {
                        $("#append_Data").append("<tr><td colspan='4' class='text-center'>No record found.</td></tr>");
                    } else {
                        $.each(pageData, function (i, r) {
                            $("#append_Data").append(
                                '<tr>' +
                                '<td><center><button class="btn btn-primary btn-xs edit-button" data-id="' + r.Id + '">' +
                                '<i class="fa fa-edit"></i></button></center></td>' +
                                '<td>' + r.SiteName + '</td>' +
                                '<td>' + r.AdminName + '</td>' +
                                '<td>' + (r.IsActive === 1 ? "Active" : "Inactive") + '</td>' +
                                '</tr>'
                            );
                        });
                    }

                    updatePagination(currentPage, Math.ceil(filtered.length / recordsPerPage));
                }
            });
        }

        function updatePagination(currentPage, totalPages) {
            var container = $('.pagination');
            container.empty();
            for (var i = 1; i <= totalPages; i++) {
                var li = $('<li/>')
                    .addClass('page-item')
                    .append(
                        $('<a/>').addClass('page-link').text(i).attr('data-page', i)
                    );

                if (i === currentPage) li.addClass('active');

                li.on('click', function () {
                    PreLoadData(parseInt($(this).find('a').attr('data-page')), "");
                });

                container.append(li);
            }
        }

        function ADD() {
            $.fancybox.open({
                    href: '/Vehicle/AddAdminMapping',   // 🔥 Add screen
                type: 'iframe',
                padding: 2,
                maxWidth: 1000,
                width: '800px',
                height: '600px',
                autoSize: true,
                afterClose: function () {
                    PreLoadData(1, "");
                }
            });
        }

        function Edit(id) {
            $.fancybox.open({
                href: '/Vehicle/EditAdminMapping?id=' + id,  // 🔥 Edit screen
                type: 'iframe',
                padding: 2,
                width: '800px',
                height: '600px',
                autoSize: true,
                afterClose: function () {
                    PreLoadData(1, "");
                }
            });
        }

    </script>
}
