@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Index";
}

@section Styles{

}

@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');

        document.getElementById("btnSubmit").addEventListener("click", GetList);

        $(document).ready(function () {
            GetList();
        });
        function GetList() {

            var data = {
                obj: $('#ddlOp').val() == "" ? 0 : $('#ddlOp').val(),
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SummerTraineeMaster/DashboardList",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#div_append').html(data);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        document.getElementById("btnAddNew").addEventListener("click", Add);

        function Add() {
            $.ajax({

                type: "GET",
                url: "/SummerTraineeMaster/Add",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.res == "error") {
                        sweetAlert("", "Document not deleted, Please try again.", "warning");
                    }
                    else {
                        $('#sp_type').html("Add Operation");
                        console.log(data);
                        $('#myCreateModelContent').html(data);
                        $('#myCreateModel').modal({ backdrop: "static" });
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });

        }
    </script>
}



<body>
    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                Summer Trainee Operation Master
            </div>
        </div>
        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Search</strong>
                        </h2>
                    </div>
                    <div class="panel-body" style="padding:5px;">
                        <div class="row" style="padding:4px;">
                            @Html.Label("Operation Name", null, new { @class = "control-label text-right col-md-1", @style = "width:150px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2">
                                @Html.DropDownList("ddlop", new SelectList(ViewBag.OpList.Items, "ADORGLEVELID", "LEVELDESCRIP"), "- Select -", new { @id = "ddlOp", @class = "form-control" })
                            </div>

                        </div>

                        <div class="row" style="padding:8px;">
                            <div class="col-md-12 col-lg-12 text-center">
                                <button id="btnSubmit" class="btn btn-success">Search</button>
                                <button id="btnAddNew" class="btn btn-info">Add Operation</button>
                                @*<a href='@Url.Action("AddTemplate", "Template")' onclick="" class="btn btn-info">Add New Template</a>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="ajaxLoader"></div>
        <div id="div_append">
        </div>
    </div>
    <div id="myCreateModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="padding:10px!important;">
                    <div class="pull-left">
                        <h5 class="modal-title"><span id="sp_type"></span></h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body" style="padding:10px!important;">
                    <div id="myCreateModelContent"></div>
                </div>
            </div>
        </div>
    </div>
</body>

