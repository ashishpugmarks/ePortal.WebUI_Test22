@model IEnumerable<ePortal.ViewModels.SummerTraineeViewModel>
@{
    Layout = null;
}

<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    select.input-sm {
        line-height: 10px !important;
    }

    .sweet-alert {
        z-index: 1000000;
        border: 1px solid;
    }
</style>
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    $('.homeContent').removeClass('homeContent');
    $(document).ready(function () {
        $("#tbDashboardList").dataTable({
            "bFilter": false,
            "bLengthChange": false,
            //"order": [[7, 'asc']],
            "columnDefs": [//date-fields
                {
                    "searchable": false,
                    "orderable": true,
                    "type": 'date'
                },
                //{
                //    "orderable": true,
                //    "render": $.fn.dataTable.render.number(',', '', 0, '', ''),
                //    "targets": [8],
                //}
            ],
        });
        
        $('#tbDashboardList').on('click', '.btn-delete', function () {
                Delete(this);
            });

    });
    

    debugger;
        function Delete(crnt) {
            var op_ID = ($(crnt).attr('opid'));
            
            //console.log(op_ID);
            debugger;
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SummerTraineeMaster/Delete",
                data: JSON.stringify({ opID: op_ID }),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 0) {
                        sweetAlert("Oops..", "No data Found.", "error");
                    }
                    else if (data == 1) {
                        sweetAlert("", "Operation Deleted Successfully.", "success");
                    }
                    else {
                        sweetAlert("Oops..", "Contact to IT.", "error");
                    }
                    GetList();
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
</script>
<body>
    <div class="panel-group">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h2 class="panel-title">
                    <strong>Operation List</strong>
                </h2>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover " id="tbDashboardList" style="font-size: medium;">
                        <thead>
                            <tr>
                                <th class="text-center">Sr. No.</th>
                                <th class="text-center">
                                    @Html.Label("Operation Name")
                                </th>
                                @*<th class="text-center">
                                        @Html.Label("Pending Count")
                                    </th>*@
                                <th>
                                    @Html.Label("Action")
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @{var count = 0;
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @{count = count + 1;}
                                            @count
                                        </td>
                                        <td>
                                            @item.OperationName
                                        </td>
                                        <td>
                                            @*<button id="btnDeleteNew" onclick="Delete(this)" opid="@item.OPID" class="btn btn-info">Delete</button>*@
                                            <button class="btn btn-info btn-delete" opid="@item.OPID">Delete</button>
                                        </td>
                                        
                                        

                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>