@model ePortal.ViewModels.APPX.TourRequest.TourBookingDetailViewModel
@{
    ViewBag.Title = "Tour Request Booking Detail";
    Layout = null;
}
@section Styles {
     <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
     <link href="~/css/NewAsset.css"  rel="stylesheet" asp-append-version="true" />
     <link href="~/css/font-awesome.min.css" rel="stylesheet" asp-append-version="true" />
     <style>
        .button {
            background-color: #4CAF50;
            border: none;
            color: white;
            padding: 4px 4px 4px 4px;
            text-align: center;
            text-decoration: none;
            display: inline-block;
            font-size: 12px;
            margin: 4px 2px;
            cursor: pointer;
        }
    </style>
}
<div style="background-color: White">
        <div class="headmain">
            <table cellspacing="0" cellpadding="0" width="100%" border="0" class="table table-bordered table-condensed table-striped">
                <tbody>
                    <tr> 
                    <span style="background-color: #5D7B9D; font-weight: bold; color: white;">
                        Tour Request Booking Detail
                    </span> 
                    @if (Model.gvDayWiseTourList != null && Model.gvDayWiseTourList.Any())
                        {
                        foreach (var item in Model.gvDayWiseTourList)
                            {
                         <table width="99%" cellpadding="0" cellspacing="0" style="border: 1px; border-style: solid; border-color: Gray; margin: 2px;">
                                            <tr class="row1">
                                                <td width="20%">&nbsp;Request Detail ID / リクエスト詳細ID:</td>
                                                <td colspan="3">@item.ADTOURREQDETAILID</td>
                                            </tr>
                                            <tr class="row2">
                                                <td width="20%">&nbsp;Travel Date / 旅行日:</td>
                                                <td width="25%">@item.TRAVELFROMDATE</td> 
                                                <td width="25%">Flight/Train Departure Time / 飛行機、電車の出発時間(例:10～11時→10B/W11 *特定のフライト、電車がある場合は、以下” [HH:24]:</td> 
                                                <td width="30%">@item.TRAVELTIME</td>
                                            </tr>
                                            <tr class="row1">
                                                <td>&nbsp;From City / 市内から:</td>
                                                <td>@item.FRMCITY</td>
                                                <td>To City / 都市へ:</td>
                                                <td>@item.TOCITY</td>
                                            </tr>
                                            <tr class="row2"> 
                                                <td>&nbsp;Travel Mode / 移動手段 ※タクシ 一手配は各事業所 GAにメールで申請:</td>
                                                <td>@item.TRAVELMODE</td>
                                                <td>Ticket Class / チケットクラス:</td>
                                                <td>@item.TICKETCLASS</td>
                                            </tr>
                                            <tr class="row1">
                                                <td>&nbsp;Flt/Train NO / フライト/列車番号:</td>
                                                <td>@item.FLIGHTTRAINNO</td>
                                                <td>Hotel Reservation / ホテルの予約:</td>
                                                <td>@item.HOTELRESERVATION</td>
                                            </tr>

                                            <tr class="row2">
                                                <td>&nbsp;Ticket By / チケット発行者:</td>
                                                <td><strong>@item.TICKETINGBY</strong></td>
                                                <td>PNR Number / PNR番号:</td>
                                                <td><strong>@item.PNRNO</strong></td>
                                            </tr>
                                            <tr class="row1">
                                                <td>&nbsp;Ticket Number / チケット番号:</td>
                                                <td><strong>@item.TICKETNO</strong></td>
                                                <td>Ticket Amount / チケット金額:</td>
                                                <td><strong>@item.TICKETAMOUNT</strong></td>
                                            </tr>
                                            <tr class="row2">
                                                <td>&nbsp;Hotel Name / ホテル名:</td>
                                                <td><strong>@item.BOOKEDHOTELNAME</strong></td>
                                                <td>Hotel Address / ホテルの住所:</td>
                                                <td><strong>@item.BOOKEDHOTELADDRESS</strong></td>
                                            </tr>
                                            <tr class="row1">
                                                <td>&nbsp;Check In Date / チェックインする日:</td>
                                                <td><strong>@item.CHECKINDATE</strong></td>
                                                <td>Check In Time / チェックイン時間[HH:24]:</td>
                                                <td><strong>@item.CHECKINTIME </strong></td>
                                            </tr>
                                            <tr class="row2">
                                                <td>&nbsp;Check Out Date / チェックアウト日:</td>
                                                <td><strong>@item.CHECKOUTDATE</strong></td>
                                                <td>Check Out Time / チェックアウト時間[HH:24]:</td>
                                                <td><strong>@item.CHECKOUTTIME</strong></td>
                                            </tr>
                                            <tr class="row1">
                                                <td>&nbsp;PickUp/Drop Details / ピックアップ/ドロップの詳細:</td>
                                                <td colspan="3"><strong>@item.PICKUPDROPDETAILS</strong></td>
                                            </tr>
                                            <tr class="row2">
                                                <td>&nbsp;Ticket Status(User End) / チケットステータス(ユーザー側):</td>
                                                <td><strong>@item.USERTICKETSTATUS</strong></td>
                                                <td>&nbsp;Ticket Status(Admin Dept) / チケットステータス(管理部門):</td>
                                                <td><strong>@item.TICKETSTATUS</strong></td>
                                            </tr>
                                            <tr class="row1">
                                                <td>&nbsp;Admin Remarks / 管理者のコメント:</td>
                                                <td><strong>@item.ADMINCACELLATIONREMARKS</strong></td>
                                                <td>&nbsp;GSTIN No / GSTIN いいえ:</td>
                                                <td><strong>@item.GSTINNO</strong></td> 
                                            </tr> 
                                            <tr class="row2">
                                               <td>&nbsp;Flight Ticket / 航空券:</td> 
                                                <td colspan="2"><b>&nbsp;</b></td>  
                                                <td>&nbsp;</td> 
                                            </tr>
                            </table>
                        }
                    }
                    </tr>
                </tbody>
            </table>
        </div>
</div>
<div id="ajaxLoader"></div>

@section Scripts {
}