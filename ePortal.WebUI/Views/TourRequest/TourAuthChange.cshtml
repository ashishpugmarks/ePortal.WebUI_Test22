@model ePortal.ViewModels.APPX.TourRequest.TourAuthChangeViewModel
@{
        ViewBag.Title = "Employee Portal  :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}

<div> 
     <table cellpadding="0" cellspacing="0" border="0" width="100%">
         <tr>
            <td>
            <div ID="errorpanel" Width="100%" >
            <table width="99%" style="margin-left: 5px; margin-top: 2px;" border="0" cellspacing="0"
                cellpadding="0">
                <tr>
                    <td align="left" valign="top">
                    <table cellpadding="3" cellspacing="0" border="0" width="100%" class="tborder">
                        <tbody>
                            <tr class="errorbox">
                                <td>
                                    <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                        <tr>
                                            <td width="16" align="left" valign="middle">
                                                <img src="../images/icon_error.gif" border="0" />
                                            </td>
                                            <td align="left" class="errorbox">
                                                <span class="smalltext">&nbsp;@Model.status </span>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    </td>
                </tr>
            </table>
            </div>
            </td>
        </tr>
     </table>
        <fieldset class="swiftfieldset" style="margin-left: 9px; margin-right: 6px;">
        <legend class="nfont">Tour Program</legend>
            <table cellspacing="1" cellpadding="2" width="100%"  border="0" style="text-align: left;line-height: 23px;">
            <tr>
                <td>
                     <table cellspacing="1" cellpadding="2" width="100%"  border="0" style="text-align: left;
                        line-height: 23px;">
                        <tbody>
                            <tr class ="row1">
                                <td class ="smalltext"  align="right">Request ID :&nbsp;</td>    
                                <td >&nbsp;
                                    @Model.lblPageRequestID
                                </td>
                                <td class ="smalltext"  align="right">Requested By :&nbsp;</td>    
                                <td >&nbsp;
                                    @Model.lblEmpName 
                                    @Html.HiddenFor(model => model.hfAuthType, new { id = "hfAuthType" })
                                </td>
                            </tr>
                            <tr class ="row2">
                                <td  class ="smalltext" align="right">Mobile No.:&nbsp;</td>    
                                <td>&nbsp;
                                    @Model.txtMobile
                                </td>
                                <td class ="smalltext"  align="right">Ext No.:&nbsp;</td>    
                                <td>&nbsp;
                                    @Model.txtExtension
                                </td>
                            </tr>
                            <tr class ="row1">
                                <td class ="smalltext"  align="right">Designation:&nbsp;</td>    
                                <td colspan="3">&nbsp;
                                    @Model.lblDesignation 
                                </td>
                            </tr>
                            <tr class ="row2">
                                <td  class ="smalltext" align="right">Operation:&nbsp;</td>    
                                <td>&nbsp;
                                    @Model.lblOperation 
                                </td>
                                <td class ="smalltext"  align="right">Division:&nbsp;</td>    
                                <td>&nbsp;
                                    @Model.lblDivision 
                                </td>
                            </tr>
                             <tr class ="row1">
                                <td  class ="smalltext" align="right">Department:&nbsp;</td>    
                                <td>&nbsp;
                                    @Model.lblDepartment
                                </td>
                                <td class ="smalltext"  align="right">Section:&nbsp;</td>    
                                <td>&nbsp;
                                    @Model.lblSection
                                </td>
                            </tr>
                            <tr class ="row2">
                                <td class ="smalltext"  align="right">Objective of Journey:&nbsp;</td>    
                                <td colspan="3">&nbsp;
                                    @Model.txtObjective
                                </td>
                            </tr>
                        </tbody>
                        </table>
                </td>
            </tr>
            <tr>
                <td colspan="2">    
                    <table class="tborder" id="gvList">
                        <thead>
                            <tr>
                                <th>&nbsp;Travel Date</th>
                                <th>&nbsp;Time</th>
                                <th>&nbsp;From Loc</th>
                                <th>&nbsp;To Loc</th> 
                                <th>&nbsp;Mode</th> 
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.gvList != null && Model.gvList.Any())
                            {
                                foreach (var item in Model.gvList)
                                {
                                    <tr style="background-color:#F7F6F3; color:#333333;">
                                        <td>@item.TRAVELFROMDATE</td>
                                        <td>@item.TRAVELTIME</td>
                                        <td>@item.FRMCITY</td>
                                        <td>@item.TOCITY</td>
                                        <td>@item.TRAVELMODE</td> 
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    
                    </td> 
            </tr>
            </table>
        </fieldset>
        <fieldset class="swiftfieldset" style="margin-left: 9px; margin-right: 6px;">
        <legend class="nfont">Tour Program Authority</legend>
            <table cellspacing="1" cellpadding="2" width="100%"  border="0" style="text-align: left;line-height: 23px;">
               <tr>
                  <td>
                      <table cellspacing="1" cellpadding="2" width="100%"  border="0" style="text-align: left;line-height: 23px;">
                        <tbody>
                            <tr id="tr_rec" style="display:@(Model.tr_rec ? "block" : "none")">
                                <td style="padding:0px;">
                                    <table cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #000080">
                                        <tr>
                                            <td style="padding:4px;" class ="smalltext" width="25%" align="right">Recommendation Authority:&nbsp;</td>    
                                            <td style="padding:4px;" width="28%">&nbsp;
                                                @Model.lblRecAuth
                                            </td>
                                            <td style="padding:4px;" class ="smalltext" width="20%" align="right">Recommendation Date:&nbsp;</td>    
                                            <td style="padding:4px;" width="27%">&nbsp;
                                                @Model.lblRecDate
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:4px;" class ="smalltext"  align="right">Recommendation Status:&nbsp;</td>    
                                            <td style="padding:4px;" colspan="3" >&nbsp;
                                                @Model.lblRecStatus
                                            </td>
                                        </tr>
                                        <tr id="tr_RecApp">
                                            <td style="padding:4px;" class ="smalltext"  align="right">Forwarded To(for Approval):<span style="color: #ff0000">*</span>&nbsp;</td>
                                            <td style="padding:4px;" colspan="3">&nbsp;                                                
                                @Html.DropDownListFor(
                                            model => model.cboRecAuthority,
                                            Model.cboRecAuthorityList,
                                            new
                                            {
                                                @class = "swiftselect",
                                                style = "width: 300px;", 
                                            })
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr><td style="padding:5px;"></td></tr>
                            <tr id="tr_App" style="display:@(Model.tr_App ? "block" : "none")">
                                <td style="padding:0px;">
                                    <table cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #000080">
                                        <tr width="25%">
                                            <td style="padding:4px;" class ="smalltext" align="right">Approval Authority:&nbsp;</td>    
                                            <td style="padding:4px;" width="28%">&nbsp;
                                                @Model.lblAppAuth
                                            </td>
                                            <td style="padding:4px;" class ="smalltext" width="20%"  align="right">Approval Date:&nbsp;</td>    
                                            <td style="padding:4px;" width="27%">&nbsp;
                                                @Model.lblAppDate
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:4px;" class ="smalltext"  align="right">Approval Status:&nbsp;</td>    
                                            <td style="padding:4px;" colspan="3" >&nbsp;
                                                @Model.lblAppStatus
                                            </td>
                                        </tr>
                                        <tr id="tr_AppAuth">
                                            <td style="padding:4px;" class ="smalltext"  align="right">Forwarded To(for Approval):<span style="color: #ff0000">*</span>&nbsp;</td>
                                            <td style="padding:4px;" colspan="3">&nbsp; 
                                                @* @Html.DropDownListFor(
                                                         model => model.cboAppAuthority,
                                                         Model.cboAppAuthorityList,
                                                         new
                                                         {
                                                             @class = "swiftselect",
                                                             style = "width: 300px;",
                                                         }) *@
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr><td style="padding:5px;"></td></tr>
                            <tr id="tr_SpApp" style="display:@(Model.tr_SpApp ? "block" : "none")">
                                <td style="padding:0px;">
                                    <table cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #000080">
                                        <tr style="padding:4px;">
                                            <td class ="smalltext" style="padding:4px;" width="25%"  align="right">Special Approval Authority:&nbsp;</td>    
                                            <td width="28%" style="padding:4px;">&nbsp;
                                                @Model.lblSplAppAuth
                                            </td>
                                            <td class ="smalltext" style="padding:4px;" width="20%"  align="right">Special Approval Date:&nbsp;</td>    
                                            <td width="27%" style="padding:4px;">&nbsp;
                                                @Model.lblSplAppDate
                                            </td>
                                        </tr>
                                        <tr style="padding:4px;">
                                            <td style="padding:4px;" class ="smalltext"  align="right">Special Approval Status:&nbsp;</td>    
                                            <td style="padding:4px;" colspan="3" >&nbsp;
                                                @Model.lblSpAppStatus
                                            </td>
                                        </tr>
                                        <tr style="padding:4px;" id="tr_SpAppAuth">
                                            <td style="padding:4px;" class ="smalltext"  align="right">Forwarded To(for Approval):<span style="color: #ff0000">*</span>&nbsp;</td>
                                            <td style="padding:4px;" colspan="3">&nbsp; 
                                                @* @Html.DropDownListFor(
                                                         model => model.cboSpAppAuthority,
                                                         Model.cboSpAppAuthorityList,
                                                         new
                                                         {
                                                             @class = "swiftselect",
                                                             style = "width: 300px;",
                                                         }) *@
                                            </td>
                                        </tr>
                                     </table>
                                </td>
                            </tr>
                            <tr><td style="padding:5px;"></td></tr>
                            <tr id="tr1"  style="display:@(Model.tr1 ? "block" : "none" )">
                                <td style="padding:0px;">
                                    <table cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #000080">
                                        <tr style="padding:4px;">
                                            <td style="padding:4px; width: 184px; vertical-align:top" class ="smalltext"  align="right">Remarks:&nbsp;</td>    
                                            <td style="padding:4px;" >&nbsp;
                                                @Html.TextArea(
                                                         "txtRemarks",
                                                         new
                                                         {
                                                             @class = "swifttext",
                                                             style = "width:504px;height:40px",
                                                             id = "txtRemarks",
                                                             maxlength = "500"
                                                         })

                                            </td>
                                        </tr>
                                     </table>
                                </td>
                            </tr>
                            <tr><td style="padding:5px;"></td></tr>
                            <tr class="row1">
                                <td style="padding:4px;" align="center">&nbsp;
                                    <button ID="btnSave" CssClass="bluebutton">Submit</button>&nbsp;
                                    <button ID="btnBack" CssClass="bluebutton">Back</button>
                                </td>
                            </tr>
                        </tbody>
                        </table>
                  </td>
               </tr>
            </table>
         </fieldset> 
</div>

<div id="ajaxLoader"></div>
@section Scripts {
    <script src="~/app/Tour/TourAuthChange.js"></script>
}


