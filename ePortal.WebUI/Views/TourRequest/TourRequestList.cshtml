@model ePortal.ViewModels.APPX.TourRequest.TourRequestListViewModel
@{
    ViewBag.Title = "Tour Request List";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles { 
}

 
    <table cellspacing="0" cellpadding="1" width="100%" border="0">
        <tbody>
            <tr>
                <td width="100%" colspan="8" height="3">
                    <img height="2" src="~/images/space.gif" alt="" width="1" />
                </td>
            </tr>
            <tr>
                <td>
                    <table width="100%" cellpadding="0">
                        <tr>
                            <td width="80%">&nbsp;</td>
                            <td align="right" style="padding-right:10px;">
                            <a href="/TourRequest/TourRequestDuplicateList">Duplicate Copy</a>
                            </td>
                        </tr>
                    </table>
                    <table cellspacing="0" cellpadding="2" width="100%" border="0" style="text-align: left;
                                line-height: 23px;" class="smalltext">
                        <tbody>
                            <tr>
                                <td>
                                    <fieldset class="swiftfieldset" style="margin-left: 9px; margin-right: 10px;">
                                        <legend class="nfont">Tour Request Report</legend>
                                                <table valign="top" style="margin-left: 2px; margin-top:12px; width:100%;" cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                            <td>
                                                                <div class="tcat" style="height: 23px; text-align: left;">
                                                                    <strong>&nbsp;Seacrh</strong>
                                                                </div>
                                                                <table class="row1" cellspacing="1" cellpadding="1" border="0" width="100%">
                                                                    <tbody>
                                                                        <tr class="row1">
                                                                            <td width="15%">Associate List:&nbsp;</td>
                                                                            <td colspan="3">

                                                    @Html.DropDownList(
                                                        "cboFilter",
                                                        new List<SelectListItem>
                                                        {
                                                        new SelectListItem { Text = "Department Wise", Value = "DPT" },
                                                        new SelectListItem { Text = "Operation Wise", Value = "OP" }
                                                        },
                                                        new { id = "cboFilter", @class = "swiftselect", style = "font-size: 8pt;", disabled = Model.cboFilter ? null : "disabled" }
                                                    )

                                                                    </td>
                                                                        </tr>
                                                                        <tr class="row2">
                                                                            <td width="15%">Request ID:&nbsp;</td>
                                                                            <td>
                                                                        @Html.TextBox("txtRequestID",null, new { @id = "txtRequestID", @class = "swifttext", style = "width:150px;", type = "number" })
                                                                            </td>
                                                                            <td>Request Status:&nbsp;</td>
                                                                            <td>
                                                                        @Html.DropDownList(
                                                                                 "cboStatus",
                                                                                 new List<SelectListItem>
                                                                        {
                                                                        new SelectListItem { Text = "- ALL -", Value = "" },
                                                                        new SelectListItem { Text = "Pending", Value = "0" },
                                                                        new SelectListItem { Text = "Approved", Value = "1", Selected = true },
                                                                        new SelectListItem { Text = "Rejected", Value = "2" }
                                                                        },
                                                                                 new { @id = "cboStatus", @class = "swiftselect", style = "width:150px;" }
                                                                                 )

                                                                            </td>
                                                                        </tr>
                                                                        <tr class="row1">
                                                                            <td>Hard Copy Status:&nbsp;</td>
                                                                            <td>
                                                                        @Html.DropDownList(
                                                                                 "cboHardCopy",
                                                                                 new List<SelectListItem>
                                                                        {
                                                                        new SelectListItem { Text = "- ALL -", Value = "" },
                                                                        new SelectListItem { Text = "Submitted", Value = "Y" },
                                                                        new SelectListItem { Text = "Not Submitted", Value = "N" }
                                                                        },
                                                                                 new { @id = "cboHardCopy", @class = "swiftselect", style = "width:150px;" }
                                                                                 )

                                                                            </td>
                                                                            <td>Advance Required:&nbsp;</td>
                                                                            <td>
                                                                        @Html.DropDownList(
                                                                                 "cboAdvance",
                                                                                 new List<SelectListItem>
                                                                        {
                                                                        new SelectListItem { Text = "- ALL -", Value = "" },
                                                                        new SelectListItem { Text = "Yes", Value = "1", Selected = true },
                                                                        new SelectListItem { Text = "No", Value = "0" }
                                                                        },
                                                                                 new { @id = "cboAdvance", @class = "swiftselect", style = "width:150px;" }
                                                                                 )

                                                                            </td>
                                                                        </tr>
                                                                        <tr class="row2">
                                                                            <td>From Date:&nbsp;</td>
                                                                            <td>
                                                                        @Html.TextBox(
                                                                                 "txtFromDate", null,
                                                                                 new { @id = "txtFromDate", @class = "swifttext", style = "width:150px;", @readonly = "readonly" }
                                                                                 )
                                                                                <a href="#"><img src="~/Images/Calendar_scheduleHS.png" width="16" height="16" border="0" alt="Pick From date" id="imgPickFromDate"></a>
                                                                        <a href="#"><img src="~/Images/eraser.png" width="16" height="16" border="0" alt="Remove date" id="imgRemoveFromDate"></a>
                                                                            </td>
                                                                            <td>Till Date:&nbsp;</td>
                                                                            <td>

                                                                        @Html.TextBox(
                                                                                 "txtToDate",null,
                                                                                 new { @id = "txtToDate", @class = "swifttext", style = "width:150px;", @readonly = "readonly" }
                                                                                 )

                                                                        <a href="#"><img src="~/Images/Calendar_scheduleHS.png" width="16" height="16" border="0" alt="Pick To date" id="imgPickToDate"></a>
                                                                        <a href="#"><img src="~/Images/eraser.png" width="16" height="16" border="0" alt="Remove date" id="imgRemoveToDate"></a>
                                                                            </td>
                                                                        </tr>
                                                                        <tr class="row1">
                                                                            <td width="15%">Employee Code:&nbsp;</td>
                                                                            <td> 
                                                                        @Html.TextBox("txtEmpCode", null,new { @id = "txtEmpCode", @class = "swifttext", style = "width:150px;", type = "number" })
                                                                            </td>
                                                                            <td width="15%">Employee Name:&nbsp;</td>
                                                                            <td> 
                                                                        @Html.TextBox(
                                                                                 "txtEmpName", null,
                                                                                 new { @id = "txtEmpName", @class = "swifttext", style = "width:150px;" }
                                                                                 )

                                                                            </td>
                                                                        </tr>
                                                                        <tr class="row2">
                                                                            <td valign="top" colspan="4" style="text-align: center">
                                                                        <button type="submit" class="yellowbutton" id="cmdSearch">Search</button>
                                                                            </td>
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                        <tr id="trGrid">
                                                            <td valign="top" class="contenttableborder">
                                                        <table class="tborder" style="width:100%;" ID="grdRequestList">
    <thead class="tcat">
        <tr>
            <th>Select</th>
            <th>ID</th>
            <th>ECode</th>
            <th>Employee Name</th>
            <th>Request Date</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Adv. Required</th>
            <th>Request Status</th>
            <th>Details</th>
            <th>Change Approval</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

                                                            </td>
                                                        </tr>
                                            <tr id="trPrint" class="row1">
                                                            <td align="center" style="padding-top:10px;">
                                                        <button type="submit" class="yellowbuttonbigbig" style="width:120px;" disabled id="cmdPrint">Print Selected</button>
                                                            </td>
                                                        </tr>
                                                        <tr class="row2">
                                                            <td align="left" style="padding-top:10px;">
                                                                Note :-Tourcoordinater no need to be submite hard copy in Finance Department
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                    </fieldset>
                                </td>
                            </tr>
                            <tr>
                                <td style="height: 1px;">
                                    <img alt="" height="1" src="~/images/space.gif" width="5" />
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <table cellpadding="0" cellspacing="0" border="0" style="margin-left: 9px;">
                                        <tr>
                                            <td align="left" valign="top" style="height: 24px;" class="tborder">
                                                <table cellspacing="0" cellpadding="0" width="100%" border="0" class="row3">
                                                    <tbody>
                                                        <tr>
                                                            <td style="height: 24px; width: 23px;" valign="middle" align="left">
                                                                <a title="Back" href="~/Home.aspx">
                                                                    <img src="~/images/icon_back.gif" border="0" alt="" />
                                                                </a>
                                                            </td>
                                                            <td style="height: 24px; width: 755px;" valign="middle">
                                                                <span class="smalltext"><a title="Back" href="~/Home.aspx">Back</a>&nbsp;</span>
                                                            </td>
                                                            <td style="height: 24px; padding-bottom: 2px;" valign="middle" align="right">
                                                                <button type="submit" class="swiftbutton" style="height:20px; display:none;" ID="cmdExport">Export to Excel</button>&nbsp;
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td align="right" valign="top" style="height: 2px;">
                                                <img height="2" src="~/images/space.gif" style="margin-top: 2px;" width="2" alt="" />
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table> 
<div id="ajaxLoader"></div>

@section Scripts {
    <script src="~/js/datetimepicker.js" asp-append-version="true"></script>
    <script src="~/app/Tour/tourrequestlist.js" asp-append-version="true"></script>
}
