@model ePortal.ViewModels.APPX.TourRequest.TourScheduleViewModel
@{
    ViewBag.Title = "Tour Schedule";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles {
    <link href="~/css/index.css" type="text/css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/NewAsset.css" type="text/css" rel="stylesheet" asp-append-version="true" />
}
    

    
     @*<%----------------------------------------------Heading Start-----------------------------------------%>*@
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="height: 8px;"></div>
            <span style="padding-left: 20px;">Tour Schedule </span>
        
        </div>
    @*<%----------------------------------------------Heading End-----------------------------------------%>*@ 
  <div class="headmain">
                <div  style="padding-left: 6px; padding-right: 6px;padding-top:6px;" >
    <table cellspacing="0" cellpadding="1" width="99%" border="0" class="table table-bordered table-condensed table-striped">
        <tbody>
                    <tr>
                        <td>
                            <table cellspacing="0" cellpadding="2" width="100%" border="0" style="text-align: left;
                                line-height: 23px;" >
                                <tbody>
                                    <tr>
                                        <td style="padding:5px;">
                                        
                                            <table valign="top" style="margin-left: 2px; width:99%;" cellspacing="0" cellpadding="0"  border="0" class="table table-bordered table-condensed table-striped">
                                            <tbody>
                                                <tr>
                                                    <td style="padding:4px;">
                                                    <div class="tcat" style="height: 23px; text-align: left;">
                                                        <strong>&nbsp;Seacrh</strong></div>
                                                        <table class="row1" cellspacing="1" cellpadding="1" border="0" width="90%">
                                                        <tbody>
                                                            <tr class="row2">
                                                                <td >Associate:&nbsp;</td>
                                                                <td> 
                                                                        @Html.DropDownListFor(
                                                                                 model => model.cboAssociate,
                                                                                 Model.cboAssociateList,
                                                                                 new
                                                                                 {
                                                                                     @class = "swiftselect",
                                                                                     style = "width: 200px;",
                                                                                 })
                                                                </td>
                                                                <td >Month:&nbsp;</td>
                                                                <td>
                                                                            @Html.DropDownListFor(
                                                                                     model => model.optMonth,
                                                                                     Model.optMonthList,
                                                                                     new
                                                                                     {
                                                                                         @class = "swiftselect",
                                                                                         style = "font-size: 8pt",
                                                                                     })
                                                                </td>
                                                                <td >Year:&nbsp;</td>
                                                                <td>
                                                                        @Html.DropDownListFor(
                                                                                 model => model.optYear,
                                                                                 Model.optYearList,
                                                                                 new
                                                                                 {
                                                                                     @class = "swiftselect",
                                                                                     style = "font-size: 8pt",
                                                                                 })
                                                                </td>
                                                                <td valign="top" style="text-align: right">
                                                                        <button class="assetbtn" id="cmdSearch">Search</button>
                                                                </td>
                                                                <td valign="top" style="text-align: right; padding-top:5px;">
                                                                        <button class="assetbtn" id="cmbMonthlyReport">Monthly Report</button>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td valign="top" style="padding:4px;">
                                                        <table ID="grdRequestList" CellPadding="4" CellSpacing="1" CssClass="tborder">
                                                            <thead>
                                                                <tr>
                                                                    <th Width="12%">&nbsp;Date</th>
                                                                    <th Width="10%">&nbsp;Day</th>
                                                                    <th Width="5%">&nbsp;Objective</th>
                                                                    <th Width="10%">&nbsp;From City</th>
                                                                    <th Width="10%">&nbsp;To City</th>
                                                                    <th Width="10%">&nbsp;Hotel StayCity</th>
                                                                    <th Width="7%">&nbsp;Mode</th>
                                                                    <th Width="7%">&nbsp;Class</th>
                                                                    <th Width="7%">&nbsp;FLT/TRN No.</th>
                                                                    <th Width="7%">&nbsp;Ticking By</th>
                                                        </thead>
                                                            <tbody></tbody>
                                                    </table>
                                                    </td>
                                                </tr>
                                            </tbody>
                                            </table>
                                         
                                        </td>
                                    </tr>
                                
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
    </table>
       </div>
    </div>
              @*<%----------------------------------------------Back Button Start-----------------------------------------%>*@        
        <div class="clear"></div>
        <div class="backrowdiv" width="98%"><a href="/Home/Home" title="Go to Home">Back</a></div>   
        <div class="clear"></div>
        @*<%----------------------------------------------Back Button End---------------------------------------------%>*@  
    

@section Scripts {
    <script src="~/js/datetimepicker.js" asp-append-version="true"></script>
    <script src="~/app/Tour/TourSchedule.js" asp-append-version="true"></script>
}
