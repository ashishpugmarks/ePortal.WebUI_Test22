@model ePortal.ViewModels.APPX.TourRequest.TourRequestViewModel
@{
    ViewBag.Title = "TourRequest";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles {
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/NewAsset.css" rel="stylesheet" asp-append-version="true" />
}


    @* <%-------------------------------------Heading Start-----------------------------%> *@
<div style="height: 2.2em; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
    <div style="height: 2px;"></div>
    <span style="padding-left: 20px;">Tour Request System </span>
    <span style="padding-left: 25%;" color="White">
        
            @Html.HiddenFor(model => model.hdnUserId, new { id = "hdnUserId" })            
            @Html.Hidden("SAVESTATUS", "", new { id = "SAVESTATUS" })

            <a name='top'></a>
        @Html.ActionLink("", "EditTourRequest", "TourRequest", routeValues: null, htmlAttributes: new { id = "ln" })
        <a id="lnkVisa"
           class="alertfont"
           style="color: white;"
           href="javascript:void(0);"
           data-url="@Url.Action("FlightSchedule", "TourDLGS")?Id=Visa"
           data-name="Visa Schedule"
           data-width="550"
           data-height="300">
            Visa Schedule
        </a>

        <a id="lnkFlight"
           class="alertfont"
           style="color: white;"
           href="javascript:void(0);"
           data-url="@Url.Action("FlightSchedule", "TourDLGS")?Id=Flight"
           data-name="Latest Flight Schedule"
           data-width="550"
           data-height="300">
            Latest Flight Schedule
        </a>
             <a href="@Url.Content("~/Uploads/TravelPolicy/Travel and Hotel Support Escalation Matrix.pdf")"  title="Domestic Travel-Travel Desk & Hotel Desk Escalation Matrix")" target="_blank"
                        class="alertfont" style="color: white;"><img src="~/images/pdf.png" alt="Domestic Travel-Travel Desk & Hotel Desk Escalation Matrix" style="width: 28px; height: 20px;">Domestic Travel-Travel Desk & Hotel Desk Escalation Matrix</a>
    </span>

</div>
    @* <%-------------------------------------Heading End-----------------------------%> *@
  <div id="errorpanel" Width="100%" style="display: none">
            <table width="100%" border="0" cellspacing="0" cellpadding="0">
                <tr id="tr_ErrorRow">
                    <td style="padding-top: 5px; padding-bottom: 2px; padding-left: 2px; padding-right: 2px;">
                        <div id="pnlErrorHeader" Width="100%" class="roundedPanel" style="background-color: #ED243B">
                            <div style="padding-left: 6px;">
                                <div id="pnlError" class="roundedPanel" style="width: 99%; background-color: #ffeaea">
                                    <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                        <tr>
                                            <td style="padding: 2px; padding-left: 5px; color: Black;">
                                                <input type="text" id="txtup" style="width: 0px; border:0px;" />
                                                <span id="status" style="font-size: 13px; font-family: Trebuchet MS"></span>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>

        <div class="headmain">
            <div style="padding-left: 6px; padding-right: 6px; padding-top: 6px;">
            <table class="tborder" style="color:#333333;width:100%;" cellspacing="0" cellpadding="0" border="0">
                    <thead>
                    <tr class="tcat" style="color:White;background-color:#5D7B9D;font-weight:bold;height:20px;">
                        <th style="text-align:left;">&nbsp;Request ID</th>
                            <th style="text-align:left;">&nbsp;Tour Objective</th>
                            <th style="text-align:left;">&nbsp;From Date</th>
                            <th style="text-align:left;">&nbsp;End Date</th>
                            <th style="text-align:right;">Tour Amount&nbsp;</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.grdPrevList != null && Model.grdPrevList .Any())
                        {
                            foreach (var item in Model.grdPrevList)
                            {
                            <tr style="background-color:#F7F6F3; color:#333333;">
                                    <td style="text-align:left;">@item.ADTOURREQUESTID</td>
                                    <td style="text-align:left;">@item.OBJOFJOURNEY</td>
                                    <td style="text-align:left;">@item.STARTDATE.ToString("dd/MM/yyyy")</td>
                                    <td style="text-align:left;">@item.ENDDATE.ToString("dd/MM/yyyy")</td>
                                    <td style="text-align:right;">@item.TOTALAMOUNT</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
         </div>

        <div class="headmain">
            <div style="padding-left: 6px; padding-right: 6px; padding-top: 6px;">
                <table cellspacing="1" cellpadding="2" width="99%" class="table table-bordered table-condensed table-striped" border="0" style="text-align: left; line-height: 23px;">
                    <tr>
                        @* <%--Below span added by aumento as on 12022024----------------------------------------------------%> *@
                        <td style="padding: 3px;" colspan="2" class="HeaderStyle12">
                            Tour Program Section <span class="alert" style="color: Red; font-size: small; margin-left: 44%;">
                                Helpline : Travel Desk + 91 9599813304, Hotel desk +91 9599813305
                            </span>
                        </td>
                    </tr>
                    <tr style="visibility: hidden">
                        <td>
                             @Html.Label(Model.TxnNumber, null, new { id = "lbltxnNumber", style = "display:none;" })
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <table cellspacing="1" cellpadding="2" width="100%" border="0" style="text-align: left; line-height: 23px;"
                                   class="table table-bordered table-condensed table-striped">
                                <tr>
                                    <td class="smalltext" align="right" width="23%">
                                        Tour Start Date / 出張開始日 : &nbsp;
                                    </td>
                                    @* <%--Japanes latter Modification By Sagar(Aumento) 04012024 --%> *@
                                    <td width="23%">
                                        <table cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td>
                                                    &nbsp; 
                                                        @Html.DropDownListFor(
                                                                 model => model.OptDayStart,
                                                                 Model.OptDayStartList,
                                                                 new { @class = "swiftselect", style = "font-size: 8pt;" }
                                                                 ) 
                                                        @Html.DropDownListFor(
                                                                 model => model.OptMonthStart,
                                                                 Model.OptMonthStartList,
                                                                 new { @class = "swiftselect", style = "font-size: 8pt;" }
                                                                 ) 
                                                        @Html.DropDownListFor(
                                                                 model => model.OptYearStart,
                                                                 Model.OptYearStartList,
                                                                 new { @class = "swiftselect", style = "font-size: 8pt;" }
                                                                 )
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td class="smalltext" align="right">
                                        Tour End Date / 出張終了日 :&nbsp;
                                    </td>
                                    @* <%--Japanes latter Modification By Sagar(Aumento) 04012024 --%> *@
                                    <td>
                                        <table cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td>
                                                    &nbsp; 
                                                    @Html.DropDownListFor(
                                                             model => model.OptDayEnd,
                                                             Model.OptDayEndList,
                                                             new { @class = "swiftselect", style = "font-size: 8pt;" }
                                                             ) 
                                                    @Html.DropDownListFor(
                                                             model => model.OptMonthEnd,
                                                             Model.OptMonthEndList,
                                                             new { @class = "swiftselect", style = "font-size: 8pt;" }
                                                             ) 
                                                    @Html.DropDownListFor(
                                                             model => model.OptYearEnd,
                                                             Model.OptYearEndList,
                                                             new { @class = "swiftselect", style = "font-size: 8pt;" }
                                                             )
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td valign="top" width="65%">
                            <table cellspacing="1" cellpadding="2" width="100%" border="0" style="text-align: left; line-height: 23px;" class="table table-bordered table-condensed table-striped">
                                <tbody>
                                    <tr>
                                        <td class="smalltext" align="right">
                                            Salary A/C No. / 給与振り込み口座 :&nbsp;
                                        </td>
                                        @* <%--Japanes latter Modification By Sagar(Aumento) 04012024--%> *@
                                        <td colspan="3">
                                            &nbsp; 
                                            @Html.Label(Model.BankAccount, null, new { id = "lblBankAccount" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="smalltext" align="right">
                                            Mobile No. / 携帯番号 :<span style="color: #ff0000">*</span>&nbsp;
                                        </td>
                                        @* <%--Japanes latter Added By Kishan Dodiya --%> *@
                                        <td style="align-self: center;">
                                            &nbsp; 
                                        @Html.TextBoxFor(model => model.txtMobile, new { @class = "swifttext", @id = "txtMobile", @MaxLength = "10", style = "width:105px", @type = "number" })
                                    </td>
                                        <td class="smalltext" align="right">
                                            Ext No. / 内線番号 :&nbsp;
                                        </td>
                                        @* <%--Japanes latter Added By Kishan Dodiya --%> *@
                                        <td>
                                        &nbsp;@Html.TextBoxFor(model => model.txtExtension, new { @class = "swifttext", @id = "txtExtension", @MaxLength = "10", style = "width:100px", @type = "number" })
                                    </td>
                                    </tr>
                                    <tr>
                                        <td class="smalltext" align="right">
                                            Email ID(Non official) / メールアドレス :&nbsp;
                                        </td>
                                        @* <%--Japanes latter Modification By Sagar(Aumento) 04012024 --%> *@
                                        <td colspan="3">
                                        &nbsp;@Html.TextBoxFor(model => model.txtEmail, new { @class = "swifttext", @id = "txtEmail", style = "width:300px" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="smalltext" align="right">
                                            Objective of Journey / 出張の目的 :<span style="color: #ff0000">*</span>&nbsp;
                                        </td>
                                        @* <%--Japanes latter Modification By Sagar(Aumento) 04012024 --%> *@
                                        <td colspan="3">
                                        &nbsp;@Html.TextBoxFor(model => model.txtObjective, new { @class = "swifttext", @id = "txtObjective", style = "width:300px", @TextMode = "MultiLine", @Rows = "2" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="smalltext" align="right">
                                            Previous Advance Remark / 備考 :&nbsp;
                                        </td>
                                       @*  <%--Japanes latter Modification By Sagar(Aumento) 04012024 --%> *@
                                        <td colspan="3">
                                        &nbsp;@Html.TextBoxFor(model => model.txtAdvRemarks, new { @class = "swifttext", @id = "txtAdvRemarks", style = "width:300px" })
                                            @Html.HiddenFor(model => model.HFADVREMARKS, new { id = "hfAdvRemakrs"})
                                        </td>
                                    </tr>
                                    <tr>
                                        @*<%-- 
                                        <td class="smalltext" align="right">Advance Amount Required / 事前清算の要否 :<span style="color: #ff0000">*</span>&nbsp;@* <%--Japanes latter Modification By Sagar(Aumento) 04012024 --%> *@
                                        <td class="smalltext" align="right">
                                            Advance Amount Required / 出張諸経費(ホテル、日当)の前払い :<span style="color: #ff0000">*</span>&nbsp;
                                        </td>
                                        @*<%--Japanes latter Modification By Mayuri(Aumento) 07022024 --%>*@
                                        <td colspan="3">
                                            &nbsp; 
                                            @Html.DropDownListFor(
                                                                 model => model.cboAdvance,
                                                                 Model.cboAdvanceList,
                                                        new { @class = "swiftselect" }
                                                        )

                                            @* <%--<asp:CheckBox ID="chkAdvance" runat="server" Text="" AutoPostBack="true" OnCheckedChanged="chkAdvance_CheckedChanged" />--%> *@
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="smalltext" align="right">
                                            Forwarded To(for Approval) / 承認者 :<span style="color: #ff0000">*</span>&nbsp;
                                        </td>
                                        @* <%--Japanes latter Modification By Sagar(Aumento) 04012024 --%> *@
                                        <td colspan="3">
                                            &nbsp;
                                            @* <asp:DropDownList ID="cboAppAuthority" runat="server" Width="300" CssClass="swiftselect">
                                            </asp:DropDownList> *@
                                            @Html.DropDownListFor(
                                                     model => model.cboAppAuthority,
                                                     Model.cboAppAuthorityList,
                                                     new { @class = "swiftselect",
                                                         style = "width: 300px;"
                                                     }
                                                     )

                                            @* <%--<asp:Label ID="lblAppAuthority" runat="server" Font-Bold="true"></asp:Label>--%> *@
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="smalltext" align="right">
                                            Tour Coordinator / ツアーコーディネーター :&nbsp;
                                        </td>
                                        @*<%--Japanes latter Added By Kishan Dodiya --%>*@
                                        <td colspan="3">
                                            &nbsp;
                                            @* <asp:Label ID="lblTourCoordinator" runat="server" Font-Bold="true"></asp:Label> *@ 
                                           

                                            @Html.Label(Model.lblTourCoordinator, null, new { id = "lblTourCoordinator", style = "font-weight:bold;" })
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                        <td valign="top" width="35%">
                            <table cellspacing="1" cellpadding="2" width="100%" border="0" style="text-align: left; line-height: 23px;">
                                <tr>
                                    <td class="smalltext" align="center">
                                        <strong>Pending Settlement Details</strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="smalltext" valign="top">
                                        <div style="height: 150px; overflow: auto">
                                        <table class="tborder" cellspacing="0" cellpadding="0" style="color:#333333;width:100%;">
                                                <thead>
                                                <tr class="tcat" style="color:White;background-color:#5D7B9D;font-weight:bold;height:20px;">
                                                    <th align="left" valign="top" scope="col">&nbsp;Period</th>
                                                    <th align="left" valign="top" scope="col">Amount&nbsp;</th>
                                                    <th align="left" valign="top" scope="col">Overdue Day&nbsp;</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.gvAdvance != null && Model.gvAdvance.Any())
                                                    {
                                                        foreach (var item in Model.gvAdvance)
                                                        {
                                                        <tr class="row1" style="color:#333333;background-color:#F7F6F3;">
                                                            <td align="left" valign="top" style="width:50%;">@item.TourPeriod</td>
                                                            <td align="left" valign="top" style="width:50%;">@item.Amount</td>
                                                            <td align="left" valign="top" style="width:50%;">@item.Day</td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="3" style="text-align:center;">No Data Found</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <table width="100%">
                                <tr>
                                    <td style="padding: 3px;" class="HeaderStyle12">
                                        Previous Advance Details<span class="alert" style="color: Red; font-size: smaller;">
                                            (As
                                            per policy you have to submit travel bill with in 7 days)
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>

                                    <table class="table table-bordered table-condensed table-striped" cellspacing="0" rules="all" border="1" id="grdprvadv" style="color:Black;border-collapse:collapse;">
                                        <thead>
                                            <tr class="grdHeader">
                                                <th style="width:10%; text-align:center;">TourPeriod</th>
                                                <th style="width:10%; text-align:center;">Advance</th>
                                                <th style="width:10%; text-align:center;">Expenses</th>
                                                <th style="width:10%; text-align:center;">Balance</th>
                                                <th style="width:10%; text-align:center;">Submit Date</th>
                                                <th style="width:10%; text-align:center;">Refund BY</th>
                                                <th style="width:10%; text-align:center;">Chq./Recp. No</th>
                                                <th style="width:10%; text-align:center;">Chq./Recp Date</th>
                                                <th style="width:10%; text-align:center;">Refd. Amt.</th>
                                                <th style="text-align:center;">Action</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @if (Model.grdprvadv != null && Model.grdprvadv.Any())
                                            {
                                                foreach (var item in Model.grdprvadv)
                                                {
                                                    <tr class="grdrow">
                                                        <td>@item.Tourperiod</td>
                                                        <td>@item.Advance</td>
                                                        <td>@item.Exp</td>
                                                        <td>@item.Balance</td>
                                                        <td>@item.Subdate</td>
                                                        <td>@item.Refundbydes</td>
                                                        <td>@item.Chqno</td>
                                                        <td>@item.Chqdate</td>
                                                        <td>@item.Refamount</td>
                                                        <td>
                                                            <img class="btnPrevDelete" src="/images/deleteactive.png" title="Click to delete the record" data-index="-1" />
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr class="placeholder" style="display:none;">
                                                    <td colspan="10"></td>
                                                </tr>
                                            }
                                        </tbody>

                                        <tfoot>
                                            <tr>
                                                <td>
                                                    @Html.DropDownList("ddltourperiod", Model.TourPeriodList, new { @class = "form-control", style = "width:113px;" })
                                                </td>
                                                <td>@Html.TextBox("txtadvance", null, new { @class = "form-control", style = "width:70px;" })</td>
                                                <td>@Html.TextBox("txtexp", null, new { @class = "form-control", style = "width:70px;" })</td>
                                                <td>@Html.TextBox("txtbalance", null, new { @class = "form-control", style = "width:70px;" })</td>
                                                <td>
                                                    @Html.TextBox("txtsubdate", null, new { @class = "form-control", style = "width:80px;" })
                                                    <img id="Img4" src="/images/Calendar_scheduleHS.png" style="vertical-align: middle;" />
                                                </td>
                                                <td>

                                                    @{
                                                        var refundOptions = new List<SelectListItem>
                                                    {
                                                    new SelectListItem { Value = "0", Text = "-Select-" },
                                                    new SelectListItem { Value = "1", Text = "Cheque"   },
                                                    new SelectListItem { Value = "2", Text = "Cash"     }
                                                    };
                                                    }

                                                    @Html.DropDownList("ddlrefundby",
                                                             refundOptions,
                                                             new { @class = "form-control" })
                                                </td>
                                                <td>@Html.TextBox("txtchqno", null, new { @class = "form-control", style = "width:70px;" })</td>
                                                <td>
                                                    @Html.TextBox("txtchqdate", null, new { @class = "form-control", style = "width:75px;" })
                                                    <img id="Img3" alt="Pick To Date" src="/images/Calendar_scheduleHS.png" style="vertical-align: middle;" />
                                                </td>
                                                <td>@Html.TextBox("txtrefamount", null, new { @class = "form-control", style = "width:70px;" })</td>
                                                <td>
                                                    <img id="BtnAdd" src="/images/icon_quickinsert.gif" title="Click to Insert the records" style="cursor:pointer;" />
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>

                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="headmain">
        <div style="padding-left: 6px; padding-right: 6px; padding-top: 6px;">
            <table cellspacing="1" cellpadding="2" width="99%" border="0" class="table table-bordered table-condensed table-striped" style="text-align: left; line-height: 23px;">
                <tbody>
                    <tr>
                        <td colspan="2" style="padding: 3px;" class="HeaderStyle12">
                            Tour Program Section: Travel Details
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <table cellspacing="1" cellpadding="2" width="100%" border="0" style="text-align: left; line-height: 23px;" class="table table-bordered table-condensed table-striped">
                                <tr>
                                    <td class="smalltext" align="right">
                                        Day Objective / 出張内容 :<span style="color: #ff0000">*</span>&nbsp;
                                    </td>
                                    @* <%--Japanes latter Modification By Sagar(Aumento) 04012024 --%> *@
                                    <td colspan="5">
                                        &nbsp; 
                                        @Html.TextBoxFor(model => model.txtDailyObjective, new { @class = "swifttext", @id = "txtDailyObjective", style = "width:587px" })
                                    </td>
                                </tr>
                                <tr>
                                    <td class="smalltext" align="right">
                                        Travel Date / 旅程日 :&nbsp;
                                    </td>
                                    @* <%--Japanes latter Modification By Sagar(Aumento) 04012024--%> *@
                                    <td>
                                        <table cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td>
                                                    &nbsp; 
                                                    @Html.DropDownListFor(
                                                                model => model.OptDay,
                                                                Model.OptDayList,
                                                                new { @class = "swiftselect", style = "font-size: 8pt;" }
                                                                ) 
                                                    @Html.DropDownListFor(
                                                                model => model.OptMonth,
                                                                Model.OptMonthList,
                                                                new { @class = "swiftselect", style = "font-size: 8pt;" }
                                                                ) 
                                                    @Html.DropDownListFor(
                                                                 model => model.OptYear,
                                                                 Model.OptYearList,
                                                                new { @class = "swiftselect", style = "font-size: 8pt;" }
                                                                )
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td colspan="2">
                                        &nbsp; 
                                        @Html.HiddenFor(model => model.HFFROMCITY, new { id = "hffromcity", value = "0" })
                                        @Html.HiddenFor(model => model.HFFROMOTHERCITY, new { id = "hffromOthercity", value = "0" })
                                       @*  <%--Added By Aumento as on 08032024 --%> *@
                                    </td> 
                                    <td class="smalltext" align="right">
                                        Flight/Train Departure Time range / 飛行機、電車の出発時間(例:14:30～15:30→14 30 B/W 15 30) *特定のフライト、電車がある場合は、” About FLT/Train Name”へ記入:&nbsp;
                                    </td>
                                    @* <%--Japanes latter Updated By Sagar as on 05032024 --%> *@
                                    <td>
                                        &nbsp; 
                                        @Html.DropDownListFor(
                                                model => model.OptHour,
                                                Model.OptHourList,
                                                new { @class = "swiftselect" }
                                                )
                                        @Html.DropDownListFor(
                                                model => model.OptMinute,
                                                Model.OptMinuteList,
                                                new { @class = "swiftselect" }
                                                )

                                        @* <%-- Added By Kishan Dodiya --%> *@
                                        B/W 
                                        @Html.DropDownListFor(
                                                model => model.OptHourTo,
                                                Model.OptHourToList,
                                                new { @class = "swiftselect" }
                                                )
                                        @Html.DropDownListFor(
                                                model => model.OptMinuteTo,
                                                Model.OptMinuteToList,
                                                new { @class = "swiftselect" }
                                                )
                                        @* <%-- End Added --%> *@
                                        [ HH24:MM ]
                                    </td>
                                </tr>
                                <tr>
                                    <td valign="top" class="smalltext" align="right">
                                        City - From / 市 - から :<span style="color: #ff0000">*</span>&nbsp;
                                    </td>
                                    @* <%--Japanes latter Added By Kishan Dodiya --%> *@
                                    <td>
                                        &nbsp; @* <%--Updated By Aumento as on 28022024 --%> *@
