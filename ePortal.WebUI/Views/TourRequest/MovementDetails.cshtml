@model ePortal.ViewModels.APPX.TourRequest.MovementDetailsViewModel
@{
    ViewBag.Title = "MovementDetails";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles {
     <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
     <link href="~/css/NewAsset.css"  rel="stylesheet" asp-append-version="true" />
}
<div class="row">
        @* <%--------------------------------------Heading Start------------------------------%> *@
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="height: 8px;"></div>
            <span style="padding-left: 20px;">Tour Movement Details </span>
        @Html.Hidden("hdnUserId", new { id = "hdnUserId" })
    </div>
        @* <%----------------------------------------------Heading End---------------------------%> *@
        
     <div class="headmain">
           <div  style="padding-left: 6px; padding-right: 6px;padding-top:6px;" >
    <table cellspacing="0" cellpadding="1" width="100%" border="0" class="table table-bordered table-condensed table-striped">
        <tbody>
                    <tr>
                        <td>
                            <table cellspacing="0" cellpadding="2" width="100%" border="0" style="text-align: left;
                                line-height: 23px;" class="smalltext">
                                <tbody>
                               
                                    <tr>
                                        <td>
                                              
                                            <table valign="top" style="margin-left: 2px; margin-top:12px; width:100%;" cellspacing="0" cellpadding="0"  border="0" >
                                            <tbody>
                                                <tr>
                                                    <td>
                                                    <table cellspacing="1" cellpadding="1" border="0" width="100%" class="table table-bordered table-condensed table-striped">
                                                        <tbody>
                                                             <tr >
                                                                <td colspan="4" class="HeaderStyle123">Seacrh&nbsp;</td>
                                                               
                                                            </tr>
                                                            <tr >
                                                                <td width="15%">Request ID:&nbsp;</td>
                                                                <td>
                                                                            @Html.TextBox("txtRequestID", null,
                                                                                     new
                                                                                     {
                                                                                         @id = "txtRequestID",
                                                                                         @class = "swifttext",
                                                                                         type = "number",
                                                                                         style = "width:120px;" 
                                                                                     })
                                                                </td>
                                                                <td colspan="2"></td>
                                                            </tr>
                                                            <tr >
                                                                <td width="15%">Employee Code:&nbsp;</td>
                                                                <td>
                                                                            @Html.TextBox("txtEmpCode", null,
                                                                                     new
                                                                                     {
                                                                                         @id = "txtEmpCode",
                                                                                         @class = "swifttext" ,
                                                                                         style = "width:120px;"
                                                                                     })
                                                                </td>
                                                                <td width="15%">Employee Name:&nbsp;</td>
                                                                <td>
                                                                            @Html.TextBox("txtEmpName", null,
                                                                                     new
                                                                                     {
                                                                                         @id = "txtEmpName",
                                                                                         @class = "swifttext",
                                                                                         style = "width:120px;"
                                                                                     })
                                                                </td>
                                                            </tr>
                                                           <tr>
                                                                <td >From Date:&nbsp;</td>
                                                                <td>
                                                                            @Html.TextBox("txtFromDate", null,
                                                                                     new
                                                                                     {
                                                                                         @id = "txtFromDate",
                                                                                         @class = "swifttext",
                                                                                         @readonly = "readonly",
                                                                                         style = "width:120px;"
                                                                                     }) <a href="#"><img id="btnFromDate" src="~/images/Calendar_scheduleHS.png" width="16" height="16" border="0" alt="Pick From date"></a>
                                                                            <a href="#"><img id="btnReFromDate" src="~/images/eraser.png" width="16" height="16" border="0" alt="Remove date"></a> 
                                                                </td>
                                                                <td >Till Date:&nbsp;</td>
                                                                <td>
                                                                            @Html.TextBox("txtToDate", null,
                                                                                     new
                                                                                     {
                                                                                         @id = "txtToDate",
                                                                                         @class = "swifttext",
                                                                                         @readonly = "readonly",
                                                                                         style = "width:120px;"
                                                                                     })
                                                                           <a href="#"><img id="btnToDate" src="~/images/Calendar_scheduleHS.png" width="16" height="16" border="0" alt="Pick To date"></a>
                                                                            <a href="#"><img id="btnReToDate" src="~/images/eraser.png" width="16" height="16" border="0" alt="Remove date"></a> 
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td valign="top" colspan="4" style="text-align: center">
                                                                            <button type="submit" class="assetbtn" id="cmdSearch">Search</button>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td valign="top" class="contenttableborder" >
                                                            <table class="tborder" style="width:100%;" ID="grdRequestList">
                                                                <thead class="tcat">
                                                                    <tr>
                                                                        <th>&nbsp;Request ID</th> 
                                                                        <th>&nbsp;Employee Code</th>
                                                                        <th>&nbsp;Employee Name</th>
                                                                        <th>&nbsp;Designation</th>
                                                                        <th>&nbsp;Department</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody></tbody>
                                                            </table>
                                                    </td>
                                                </tr>
                                            </tbody>
                                            </table> 
                                        </td>
                                    </tr>
                                  
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
    </table>
    </div>
          @* <%----------------------------------------------Back Button Start------------------------------------%> *@
        <div class="clear"></div>
        <div class="backrowdiv" style="width: 99%">
        <a href="/Home/Home" title="Go to Home">Back</a>
        </div>
        <div class="clear"></div>
        @* <%----------------------------------------Back Button End-------------------------------------------%> *@
    </div>
</div>
<div id="ajaxLoader"></div>

@section Scripts {
    <script src="~/js/datetimepicker.js" asp-append-version="true"></script>
    <script src="~/app/Tour/MovementDetails.js" asp-append-version="true"></script>
    }