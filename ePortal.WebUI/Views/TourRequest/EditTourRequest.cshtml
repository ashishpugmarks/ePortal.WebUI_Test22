@model ePortal.ViewModels.APPX.TourRequest.EditTourRequestViewModel
@{
    ViewBag.Title = "Employee Portal  :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles {
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/NewAsset.css"  rel="stylesheet" asp-append-version="true" />
}



<div id="TourPlan"> 
    @Html.Hidden("frmSave", new { id = "frmSave" }) 
    @Html.Hidden("hdnUserId", ViewBag.hdnUserId, new { @id = "hdnUserId" })
    @*<%----------------------------------------------Heading Start-----------------------------------------%>*@
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="height: 2px;"></div>
        <span style="padding-left: 20px;">Edit Tour Request </span>
        <span style="padding-left: 25%;" color="White"> <a name='top'></a>
            <a name='top'></a>
            @Html.ActionLink("", "EditTourRequest", "TourRequest", routeValues: null, htmlAttributes: new { id = "ln" })
            <a id="lnkVisa"
            class="alertfont"
            style="color: white;"
            href="javascript:void(0);"
            data-url="@Url.Action("FlightSchedule", "TourDLGS")?Id=Visa"
            data-name="Visa Schedule"
            data-width="550"
            data-height="300">
                Visa Schedule
            </a>

            <a id="lnkFlight"
            class="alertfont"
            style="color: white;"
            href="javascript:void(0);"
            data-url="@Url.Action("FlightSchedule", "TourDLGS")?Id=Flight"
            data-name="Latest Flight Schedule"
            data-width="550"
            data-height="300">
                Latest Flight Schedule
            </a>
            <a href="@Url.Content("~/Uploads/TravelPolicy/Travel and Hotel Support Escalation Matrix.pdf")"  title="Domestic Travel-Travel Desk & Hotel Desk Escalation Matrix")" target="_blank"
            class="alertfont" style="color: white;"><img src="~/images/pdf.png" alt="Domestic Travel-Travel Desk & Hotel Desk Escalation Matrix" style="width: 28px; height: 20px;">Domestic Travel-Travel Desk & Hotel Desk Escalation Matrix</a>
        </span>
    </div>
    @*<%----------------------------------------------Heading End-----------------------------------------%>*@ 

    <table cellspacing="0" cellpadding="1" width="100%" border="0">
        <tr>
            <td>
                <div ID="errorpanel" Width="100%">
                    <table width="99%" style="margin-left: 5px; margin-top: 2px;" border="0" cellspacing="0"
                    cellpadding="0">
                        <tr>
                            <td align="left" valign="top">
                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                    <tbody>
                                        <tr class="errorbox">
                                            <td>
                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                    <tr>
                                                        <td width="16" align="left" valign="middle">
                                                            <img src="~/images/icon_error.gif" border="0" /> 
                                                            @Html.ActionLink("", "EditTourRequest", "TourRequest", routeValues: null, htmlAttributes: new { id = "ln" })
                                                        </td>
                                                        <td align="left" class="errorbox">
                                                            <span class="smalltext">&nbsp;
                                                                @Html.Label("status", null, new { id = "status" })
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </td>
        </tr>
    </table>

    <div class="headmain">
        <div  style="padding-left: 6px; padding-right: 6px;padding-top:6px;" >
            <table cellspacing="1" cellpadding="2"  width="99%" class="table table-bordered table-condensed table-striped" border="0" style="text-align: left;
                        line-height: 23px;" >
                <tr>
                    @*<%--Below span added by aumento as on 12022024---------------------%>*@
                    <td style="padding: 3px;" class="HeaderStyle12">
                        Tour Program Section <span class="alert" style="color: Red; font-size: small; margin-left: 30%;">Helpline : Travel Desk + 91 9599813304, Hotel desk +91 9599813305</span>
                    </td>
                    @*<%-------------------------------------------------------%>*@

                    <td class="HeaderStyle12" style="text-align:right;margin-right:10px;font-weight:normal;">
                        <a href="@Url.Content("~/TourRequest/DLGS/Guidelines.pdf")"
                        class="alertfont" target="_blank">Guidelines</a>

                    </td>
                </tr>
                @*<%--Added By Aumento For SR73072 Start--%>*@
                <tr>
                    <td colspan="2">
                        <table cellspacing="1" cellpadding="2" width="100%" border="0" style="text-align: left; line-height: 23px;"
                        class="table table-bordered table-condensed table-striped">
                            <tr>
                                <td class="smalltext" align="right" width="23%">Tour Start Date / 出張開始日 : &nbsp;
                                </td>                                            
                                <td width="23%">
                                    <table cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td>&nbsp; 
                                                @Html.DropDownListFor(
                                                          model => model.optDayStart,
                                                          Model.optDayStartList,
                                                         new
                                                         {
                                                             @class = "swiftselect",
                                                             style = "font-size: 8pt",
                                                         }) 
                                                @Html.DropDownListFor(
                                                         model => model.optMonthStart,
                                                         Model.optMonthStartList,
                                                         new
                                                         {
                                                             @class = "swiftselect",
                                                             style = "font-size: 8pt",
                                                         })
                                                @Html.DropDownListFor(
                                                         model => model.optYearStart,
                                                         Model.optYearStartList,
                                                         new
                                                         {
                                                             @class = "swiftselect",
                                                             style = "font-size: 8pt",
                                                         })
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                                <td class="smalltext" align="right">Tour End Date / 出張終了日 :&nbsp;
                                </td>                                            
                                <td>
                                    <table cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td>&nbsp; 
                                                @Html.DropDownListFor(
                                                         model => model.optDayEnd,
                                                         Model.optDayEndList,
                                                         new
                                                         {
                                                             @class = "swiftselect",
                                                             style = "font-size: 8pt",
                                                         })
                                                @Html.DropDownListFor(
                                                         model => model.optMonthEnd,
                                                         Model.optMonthEndList,
                                                         new
                                                         {
                                                             @class = "swiftselect",
                                                             style = "font-size: 8pt",
                                                         })
                                                @Html.DropDownListFor(
                                                          model => model.optYearEnd,
                                                          Model.optYearEndList,
                                                          new
                                                          {
                                                              @class = "swiftselect",
                                                              style = "font-size: 8pt",
                                                          })
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                @*<%--Added By Aumento For SR73072 End--%>*@
                <tr>
                    <td width="65%">
                        <table cellspacing="1" cellpadding="2" width="100%" border="0" style="text-align: left;
                                    line-height: 23px;"  class="table table-bordered table-condensed table-striped">
                            <tbody>                                            
                                <tr>
                                    <td class="smalltext" align="right">
                                        Salary A/C No. / 給与振り込み口座 :&nbsp;
                                    </td>@*<%--Japanes latter Modification By Sagar(Aumento) 04012024 --%>*@
                                    <td colspan="3">
                                        &nbsp;
                                        @Html.Label("lblBankAccount",(Model.lblBankAccount?.ToString() ?? "0"),new { id = "lblBankAccount" })

                                    </td>
                                </tr>
                                <tr>
                                    <td class="smalltext" align="right">
                                        Mobile No./ 携帯番号 :<span style="color: #ff0000">*</span>&nbsp;
                                    </td>@*<%--Japanes latter Added By Kishan Dodiya --%>*@
                                    <td>
                                        &nbsp; 
                                        @Html.TextBoxFor(model => model.txtMobile, new { @class = "swifttext", @id = "txtMobile", @MaxLength = "10", style = "width:105px" , @type = "number" }) 
                                    </td>
                                    <td class="smalltext" align="right">
                                        Ext No./ 内線番号 :&nbsp;
                                    </td>@*<%--Japanes latter Added By Kishan Dodiya --%>*@
                                    <td>
                                        &nbsp;@Html.TextBoxFor(model => model.txtExtension, new { @class = "swifttext", @id = "txtExtension", @MaxLength = "10", style = "width:100px" , @type = "number" }) 
                                    </td>
                                </tr>
                                <tr>
                                    <td class="smalltext" align="right">
                                        Email ID(Non official) / メールアドレス :&nbsp;<span style="color: #ff0000">*</span>&nbsp;
                                    </td>@*<%--Japanes latter Modification By Sagar(Aumento) 04012024 --%>*@
                                    <td colspan="3">
                                        &nbsp; 
                                        @Html.TextBoxFor(model => model.txtEmail, new { @class = "swifttext", @id = "txtEmail", style = "width:300px"  })
                                    </td>
                                </tr>
                                <tr>
                                    <td class="smalltext" align="right">
                                        Objective of Journey / 出張の目的 :<span style="color: #ff0000">*</span>&nbsp;
                                    </td>@*<%--Japanes latter Modification By Sagar(Aumento) 04012024 --%>*@
                                    <td colspan="3">
                                        &nbsp; 
                                        @Html.TextBoxFor(model => model.txtObjective, new { @class = "swifttext", @id = "txtObjective", style = "width:300px" , @TextMode = "MultiLine", @Rows = "2" })
                                    </td>
                                </tr>
                                <tr>
                                    <td class="smalltext" align="right">
                                        Previous Advance Remark / 備考 :&nbsp;
                                    </td>@*<%--Japanes latter Modification By Sagar(Aumento) 04012024 --%>*@
                                    <td colspan="3">
                                        &nbsp;@Html.TextBoxFor(model => model.txtAdvRemarks, new { @class = "swifttext", @id = "txtAdvRemarks", style = "width:300px" })
                                    </td>
                                </tr>
                                <tr>
                                    @*<%--Japanes latter Modification By Sagar(Aumento) 04012024 --%>*@
                                    <td class="smalltext" align="right">
                                        Advance Amount Required / 出張諸経費(ホテル、日当)の前払い :&nbsp;
                                    </td>@*<%--Japanes latter Modification By Mayuri(Aumento) 07022024 --%>*@

                                    <td colspan="3">
                                        &nbsp;
                                        @Html.CheckBoxFor(
                                                          model => model.chkAdvance,
                                                          new
                                                          {
                                                              id = "chkAdvance",
                                                              style = Model.chkAdvance ? "display:block;" : "display:none;",
                                                              disabled = Model.chkAdvanceChecked ? null : "disabled"
                                                          }
                                                          )

                                </tr>
                            </tbody>
                        </table>
                    </td>
                    <td valign="top" width="35%">
                        <table cellspacing="1" cellpadding="2" width="100%" border="0" style="text-align: left;
                                    line-height: 23px;" class="table table-bordered table-condensed table-striped">
                            <tr>
                                <td class="smalltext" align="center">
                                    <strong>Pending Bill Details</strong>
                                </td>
                            </tr>
                            <tr>
                                <td class="smalltext" valign="top">
                                    <div style="height: 120px; overflow: auto">    
                                        <table id="gvAdvance" class="tborder" style="color:#333333;width:100%;">
                                            <thead>
                                                <tr class ="tcat" style="color:White;background-color:#5D7B9D;font-weight:bold;height:20px;">
                                                    <th align ="left" valign="top" scope="col">
                                                        &nbsp; Period</th>
                                                    <th align="left" valign="top" scope="col">&nbsp; Amount</th>
                                                    <th align="left" valign="top" scope="col">&nbsp; Day</th>
                                                </tr>
                                            </thead>
                                            @if (Model.gvAdvance != null && Model.gvAdvance.Any())
                                            {
                                                foreach (var item in Model.gvAdvance)
                                                {
                                                    <tr>
                                                        <td style="text-align:left; vertical-align:top;">@item.TourPeriod</td>
                                                        <td style="text-align:right; vertical-align:top;">@item.Amount</td>
                                                        <td style="text-align:center; vertical-align:middle;">@item.Day</td>
                                                    </tr>
                                                }
                                            }
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <table width="100%" class="table table-bordered table-condensed table-striped">
                            <tr>
                                <td style="padding: 3px;" class="HeaderStyle12">
                                    Previous Advance Details<span class="alert" style="color: Red; font-size: smaller;">(As per policy you have to submit travel bill with in 7 days)</span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div ID="pnl_prv" ScrollBars="Horizontal" Width="99%">
                                        <table id="grdprvadv" class="tborder" border="0" cellspacing="1" cellpadding="1" style="color:#333333;">
                                            <thead>
                                                <tr class="tcat" style="height:20px;">
                                                    <th align="center" valign="top" scope="col" style="width:10%;">TourPeriod</th>  
                                                    <th align="center" valign="top" scope="col" style="width:10%;">Advance</th> 
                                                    <th align="center" valign="top" scope="col" style="width:10%;">Expenses</th> 
                                                    <th align="center" valign="top" scope="col" style="width:10%;">Balance</th> 
                                                    <th align="center" valign="top" scope="col" style="width:10%;">Submit Date</th>
                                                    <th align="center" valign="top" scope="col" style="width:10%;">Refund BY</th>
                                                    <th align="center" valign="top" scope="col" style="width:10%;">Chq./Recp. No</th> 
                                                    <th align="center" valign="top" scope="col" style="width:10%;">Chq./Recp Date</th> 
                                                    <th align="center" valign="top" scope="col" style="width:10%;">Refd. Amt.</th> 
                                                    <th align="center" valign="top" scope="col">Action</th>
                                            </thead>
                                            <tbody>
                                                @if (Model.grdprvadv != null && Model.grdprvadv.Any())
                                                {
                                                    foreach (var item in Model.grdprvadv)
                                                    {
                                                        <tr>
                                                            <td>&nbsp;@item.Tourperiod</td>
                                                            <td>&nbsp;@item.Advance</td>
                                                            <td>&nbsp;@item.Exp</td>
                                                            <td>&nbsp;@item.Balance</td>
                                                            <td>&nbsp;@item.Subdate</td>
                                                            <td>&nbsp;@item.Refundbydes</td>
                                                            <td>&nbsp;@item.Chqno</td>
                                                            <td>&nbsp;@item.Chqdate</td>
                                                            <td>&nbsp;@item.Refamount</td>
                                                            <td><button type="button" ID="BtnEdit">
                                                                    <img src="~/images/edit.png" title="Click to edit the records" />
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr style="color:White;background-color:#990000;font-weight:bold;">
                                                    <td>
                                                        @Html.DropDownListFor(
                                                                 model => model.ddltourperiod,
                                                                 Model.ddltourperiodList,
                                                                 new
                                                                 {
                                                                     style = "width:113px" 
                                                                 })
                                                    </td>
                                                    <td>
                                                        @Html.TextBoxFor(model => model.txtadvance, new { @id = "txtadvance", style = "width:70px"  })
                                                    </td>
                                                    <td>
                                                        &nbsp;
                                                        @Html.TextBoxFor(model => model.txtexp, new { @id = "txtexp", style = "width:70px"  })
                                                    </td>
                                                    <td>
                                                        &nbsp; @Html.TextBoxFor(model => model.txtbalance, new { @id = "txtbalance", style = "width:70px"  })
                                                    </td>
                                                    <td>

                                                        &nbsp; @Html.TextBoxFor(model => model.txtsubdate, new { @id = "txtsubdate", style = "width:80px"  })
                                                        &nbsp;<img id="Img4" alt="Pick To Date" src="~/images/Calendar_scheduleHS.png" style="vertical-align: middle;" />
                                                    </td>
                                                    <td>
                                                        &nbsp;
                                                        @Html.DropDownListFor(
                                                                          model => model.ddlrefundby,
                                                                          Model.ddlrefundbyList,
                                                                          new{})
                                                    </td>
                                                    <td>&nbsp;
                                                        @Html.TextBoxFor(model => model.txtchqno, new { @id = "txtchqno", style = "width:70px" , @type="number" })
                                                    </td>
                                                    <td>
                                                        &nbsp;
                                                        @Html.TextBoxFor(model => model.txtchqdate, new { @id = "txtchqdate", style = "width:75px"  })
                                                        &nbsp;<img id="Img3" alt="Pick To Date" src="~/images/Calendar_scheduleHS.png" style="vertical-align: middle;" />
                                                    </td>
                                                    <td>&nbsp;
                                                        @Html.TextBoxFor(model => model.txtrefamount, new { @id = "txtrefamount", style = "width:70px" })
                                                    </td>
                                                    <td>
                                                        <button type="button" ID="BtnAdd" title="Click to Insert the records" @* data-id="@item.Id" *@>
                                                            <img src="~/images/icon_quickinsert.gif" />
                                                        </button>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

        </div>
    </div>
    <div class="headmain">
        <div style="padding: 5px;">
            <table cellspacing="1" cellpadding="2" width="99%" border="0" style="text-align: left;
                        line-height: 23px;"   class="table table-bordered table-condensed table-striped">
                <tbody>
                    <tr>
                        <td>
                            <table cellspacing="1" cellpadding="2" width="100%" border="0" style="text-align: left;
                                        line-height: 23px;"  class="table table-bordered table-condensed table-striped">
                                <tr>
                                    <td colspan="2" style="padding-left: 5px;">
                                        <b>Tour Program Section: Travel Details</b>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="smalltext" align="right">
                                        Day Objective / 出張内容 :<span style="color: #ff0000">*</span>&nbsp;
                                    </td>@*<%--Japanes latter Modification By Sagar(Aumento) 04012024 --%>*@
                                    <td colspan="5">
                                        &nbsp; 
                                        @Html.TextBoxFor(model => model.txtDailyObjective, new { @class="swifttext", @id = "txtDailyObjective", style = "width:587px"  })
                                    </td>
                                </tr>
                                <tr>
                                    <td class="smalltext" align="right">
                                        Travel Date / 旅程日 :&nbsp;
                                    </td>@*<%--Japanes latter Modification By Sagar(Aumento) 04012024--%>*@
                                    <td>
                                        <table cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td> &nbsp; 
                                                    @Html.DropDownListFor(
                                                              model => model.optDay,
                                                              Model.optDayList,
                                                             new
                                                             {
                                                                 @class = "swiftselect",
                                                                 style = "font-size: 8pt",
                                                             }) 
                                                    @Html.DropDownListFor(
                                                              model => model.optMonth,
                                                                  Model.optMonthList,
                                                             new
                                                             {
                                                                 @class = "swiftselect",
                                                                 style = "font-size: 8pt",
                                                             }) 
                                                    @Html.DropDownListFor(
                                                                  model => model.optYear,
                                                                  Model.optYearList,
                                                             new
                                                             {
                                                                 @class = "swiftselect",
                                                                 style = "font-size: 8pt",
                                                             })
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td colspan="2">
                                        &nbsp;
                                    </td>   
                                    @*<%--Japanes latter Modification By Mayuri as on 07022024 --%>*@
                                    <td class="smalltext" align="right">Flight/Train Departure Time range / 飛行機、電車の出発時間(例:14:30～15:30→14 30 B/W 15 30) *特定のフライト、電車がある場合は、” About FLT/Train Name”へ記入:&nbsp;
                                    </td>@*<%--Japanes latter Updated By Sagar as on 05032024 --%>*@
                                    <td>
                                        &nbsp;
                                        @Html.DropDownListFor(
                                                          model => model.optHour,
                                                          Model.optHourList,
                                                          new
                                                          {
                                                              @class = "swiftselect"
                                                          })
                                        @Html.DropDownListFor(
                                                  model => model.optMinute,
                                                  Model.optMinuteList,
                                                  new
                                                  {
                                                      @class = "swiftselect"
                                                  })
                                        @*<%-- Added By By Sagar as on 05022024 --%>*@
                                        B/W 
                                        @Html.DropDownListFor(
                                                          model => model.optHourTo,
                                                          Model.optHourToList,
                                                          new
                                                          {
                                                              @class = "swiftselect"
                                                          }) 
                                        @Html.DropDownListFor(
                                                          model => model.optMinuteTo,
                                                          Model.optMinuteToList,
                                                          new
                                                          {
                                                              @class = "swiftselect"
                                                          })
                                        @*<%-- End Added --%>*@
                                        [HH24:MM]
                                    </td>
                                </tr>
                                <tr>
                                    <td valign="top" class="smalltext" align="right">
                                        City - From / 市 - から:<span style="color: #ff0000">*</span>&nbsp;
                                    </td>@*<%--Japanes latter Added By Kishan Dodiya --%>*@
                                    <td>&nbsp;
                                        @Html.DropDownListFor(
                                                          model => model.cmbFrom,
                                                          Model.cmbFromList,
                                                          new
                                                          {
                                                              @class = "swiftselect",
                                                              style = "width:134px" 
                                                          })
                                    </td>
                                    <td valign="top" class="smalltext" align="right">
                                        To / に :<span style="color: #ff0000">*</span>&nbsp;
                                    </td>@*<%--Japanes latter Added By Kishan Dodiya --%>*@
                                    <td>
                                        &nbsp;
                                        @Html.DropDownListFor(
                                                          model => model.cmbTo,
                                                          Model.cmbToList,
                                                          new
                                                          {
                                                              @class = "swiftselect",
                                                              style = "width:134px" 
                                                          })
                                    </td>
                                    <td valign="top" class="smalltext" align="right">
                                        Hotel Staying / ホテル宿泊 :&nbsp;
                                    </td>@*<%--Japanes latter Added By Kishan Dodiya --%>*@
                                    <td>
                                        &nbsp;
                                        @Html.DropDownListFor(
                                              model => model.cmbStaying,
                                              Model.cmbStayingList,
                                              new
                                              {
                                                  @class = "swiftselect",
                                                  style = "width:134px" 
                                              })
                                        @*<%--Updated By Aumento as on 28022024 --%>*@                                                     
                                    </td>
                                </tr>
                                <tr>
                                    <td valign="top" class="smalltext" align="right">
                                        Other Cities / 選択肢に行き先の都市名が記載されていない場合に入力:&nbsp;
                                    </td>@*<%--Japanes latter Change By Sagar as on 18012024 --%>*@
                                    <td>
                                        &nbsp;  @Html.TextBoxFor(model => model.txtFromCity, new { @id = "txtFromCity", style = "width:134px" , @class="swifttext" })
                                    </td>
                                    <td>
                                        &nbsp;
                                    </td>
                                    <td>
                                        &nbsp;
                                        @Html.TextBoxFor(model => model.txtToCity, new { @id = "txtToCity", style = "width:134px" , @class="swifttext" })
                                    </td>
                                    <td>
                                        &nbsp;
                                    </td>
                                    <td>
                                        &nbsp;
                                        @Html.TextBoxFor(model => model.txtStayingCity, new { @id = "txtStayingCity", style = "width:134px" , @class="swifttext" })
                                    </td>
                                </tr>
