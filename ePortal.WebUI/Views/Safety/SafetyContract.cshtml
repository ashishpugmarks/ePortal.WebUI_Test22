@model ePortal.ViewModels.APPX.Safety.SafetyModel
@{
    ViewBag.Title = "SafetContract";
    Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles {
    <link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet" />
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="../css/jquery.dataTables.css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">

        #div-datagrid table tbody tr:hover {
            background-color: #F5F3DA;
        }

        .locked {
            background-color: #f0f0f0;
            font-weight: bold;
        }
    </style>

    }


<div id="Form1">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Safety Contract</span>
    </div>
    <div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
                <table style="width: 100%;">
                    <tr>
                        <td>
                            <table class="table table-bordered table-condensed table-striped" style="width: 100%;">
                                <tr class="info">
                                    <td class="smalltext" colspan="4">
                                        <p style="font-weight:bold;">
                                            <img src="../../images/blueblockarrow.gif" alt="arrow" />&nbsp;<span style="letter-spacing: normal">
                                                Search
                                            </span>
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="smalltext" style="text-align: right; border-bottom: solid 1px #CCDCE0; border-top: solid 1px #CCDCE0; padding: 2px;">From Date:&nbsp;</td>
                                    <td style="text-align: left; border-bottom: solid 1px #CCDCE0; border-top: solid 1px #CCDCE0; padding: 2px;">
                                <input type="text" id="txtFromDate" name="txtFromDate" class="swifttext datepic" style="width:120px;" readonly />

                                        @* <a href="#">
                                            <img src="../../images/Calendar_scheduleHS.png" width="16" height="16" border="0" alt="Pick From date" onclick="showfromdate()">
                                        </a> *@
                                    <a href="#">
                                    <img src="../../images/Calendar_scheduleHS.png" width="16" height="16" border="0" alt="Pick From date" id="fromDateOpen">
                                    </a>
                                        <a href="#">
                                           @*  <img src="../../images/eraser.png" width="16" height="16" border="0" alt="Remove date" onclick="removefromdate()"> *@
                                           <img src="../../images/eraser.png" width="16" height="16" style="border:0;" alt="Remove date" id="removefromdate" />
                                        </a>
                                    </td>
                                    <td class="smalltext" style="text-align: right; border-bottom: solid 1px #CCDCE0; border-top: solid 1px #CCDCE0; padding: 2px;">Till Date:&nbsp;</td>
                                    <td style="text-align: left; border-bottom: solid 1px #CCDCE0; border-top: solid 1px #CCDCE0; padding: 2px;">
                                <input type="text" id="txtToDate" name="txtToDate" class="swifttext datepic" style="width:120px;" readonly />

                                        <a href="#">
                                            <img src="../../images/Calendar_scheduleHS.png" width="16" height="16" border="0" alt="Pick To date" id="toDateOpen">
                                        </a>
                                        <a href="#">
                                            <img src="../../images/eraser.png" width="16" height="16" style="border:0;" alt="Remove date" id="removetodate" />
                                        </a>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="smalltext" style="text-align: right; border-bottom: solid 1px #CCDCE0; border-top: solid 1px #CCDCE0; padding: 2px;">
                                        Plant :&nbsp;
                                    </td>
                                    <td style="text-align: left; border-bottom: solid 1px #CCDCE0; border-top: solid 1px #CCDCE0; padding: 2px;">
                                    @Html.DropDownListFor(
                                         m => m.PlantViewModel.SelectedPlantId,
                                         Model.PlantViewModel.Plants,
                                         Model.PlantViewModel.Enabled
                                         ? new { @id = "ddlplant", @class = "swifttext", style = "width:150px;" }
                                         : new { @id = "ddlplant", @class = "swifttext", style = "width:150px;", disabled = "disabled" }
                                         )


                                    </td>
                                    <td class="smalltext" style="text-align: right; border-bottom: solid 1px #CCDCE0; border-top: solid 1px #CCDCE0; padding: 2px;">&nbsp;&nbsp;  Category :&nbsp;</td>
                                    <td style="text-align: left; border-bottom: solid 1px #CCDCE0; border-top: solid 1px #CCDCE0; padding: 2px;">

                                @Html.DropDownList(
                                         "CategoryId",                          
                                         (IEnumerable<SelectListItem>)@Model.SfCategoryViewModel.Categories,
                                         new { @id = "ddlcategory", @class = "swifttext", style = "width:250px;" }
                                         )



                            </td>
                                </tr>
                                <tr>

                                    <td class="smalltext" style="text-align: right; border-bottom: solid 1px #CCDCE0; border-top: solid 1px #CCDCE0; padding: 2px;">&nbsp;&nbsp; Sub Category :</td>
                                    <td style="text-align: left; border-bottom: solid 1px #CCDCE0; border-top: solid 1px #CCDCE0; padding: 2px;"
                                        colspan="3">
                                @Html.DropDownList(
                                         "ddlact",
                                         (IEnumerable<SelectListItem>)@Model.ActViewModel.Acts,
                                         new { @id = "ddlact", @class = "swifttext", style = "width:500px;" }
                                         )
                                    </td>
                                </tr>
                                <tr>
                                    <td class="smalltext" style="text-align: right; padding: 2px;">Status :</td>
                                    <td style="text-align: left; padding: 2px;">
                                <select id="cmbstatus" name="cmbstatus" class="swifttext" style="width:122px;">
                                            <option value="0">Active</option>
                                            <option value="1">Deactive</option>
                                        </select>
                                    </td>
                                    <td class="smalltext" style="text-align: right; padding: 2px;">
                                        Section:
                                    </td>
                                @*     <td style="text-align: left; padding: 2px;">
                                        &nbsp;
                                @Html.DropDownList(
                                         "ddlsfsection",
                                         (IEnumerable<SelectListItem>)@Model.ActViewModel.Acts,
                                         new { @id = "ddlsfsection", @class = "swifttext", style = "width:200px;height:20px;" }
                                         )
                                    </td> *@
                                    <td style="text-align: left; padding: 2px;">
                                        &nbsp;
                                @Html.DropDownList(
                                         "ddlsfsection",
                                                                (IEnumerable<SelectListItem>)@Model.SfSectionViewModel.Sections,
                                          new { @id = "ddlsfsection", @class = "swifttext", style = "width:200px;height:20px;" }
                                          )
                                    </td>
                                </tr>

                                <tr>
                                    <td align="center" style="padding-bottom: 5px; padding-top: 7px;" colspan="4">
                                     <button type="button" id="cmdSearch" class="bluebutton">Search</button>
                                &nbsp;&nbsp;&nbsp;&nbsp;<a id="cmdCancel" style="display:inline-block; text-align:center;" href="@Url.Action("Home", "Home")" class="bluebutton">Cancel</a>
                                    </td>
                                </tr>
                            </table>
                            <asp:HiddenField runat="server" ID="hdn_postback" OnValueChanged="ValueHiddenField_ValueChanged" />
                            <table class="table table-bordered table-condensed" style="width: 100%;">
                                <tbody>
                                    <tr>
                                        <td>
                                            <div id="div-datagrid" class="div-datagrid">
                                               
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
    <div style="margin-left: 0.8em; margin-right: 0.8em; padding: 4px;" class="well well-sm">
                <table border="0" style="width: 100%;">
                    <tr>
                        <td style="height: 20px;">
                            <table style="width: 100%;">
                                <tbody>
                                    <tr>
                                        <td style="width: 20px; vertical-align: middle; text-align: center;">
                                       <a title="Back" href="@Url.Action("Home", "Home")">
                                                <img src="../../images/icon_back.gif" border="0" alt="" />
                                            </a>
                                        </td>
                                        <td style="vertical-align: middle; font-size: 14px;">
                                    <span><a title="Back" href="@Url.Action("Home", "Home")">Back</a></span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
</div>

@section Scripts {
    <script src="../js/datetimepicker.js"></script>
    <script src="../js/jquery.dataTables.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        $(document).ready(function () {
            initializeTables();

        $.fn.datepicker.dates['en'] = {
              days: ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
              daysShort: ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"],
              daysMin: ["Su","Mo","Tu","We","Th","Fr","Sa"],
              months: ["JANUARY","FEBRUARY","MARCH","APRIL","MAY","JUNE","JULY","AUGUST","SEPTEMBER","OCTOBER","NOVEMBER","DECEMBER"],
              monthsShort: ["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"],
              today: "Today",
              clear: "Clear",
              titleFormat: "MM yyyy", // 'MM' for long month name in the header
              weekStart: 0
            };

            //var today = new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate());
            $('.datepic').datepicker({
                format: "dd-M-yyyy",
                // startDate: today,
                language: "en",
                autoclose: true,
                toolbarplacement: 'top'
            });

        // Make it globally available (no block scope)
          window.setDateField = function (targetId, value) {
            const el = document.getElementById(targetId);
            if (el) el.value = value;
          };


            $('#fromDateOpen').on('click', function (e) {
                e.preventDefault();
                $('#txtFromDate').datepicker('show');
            });


            $('#toDateOpen').on('click', function (e) {
                e.preventDefault();
                $('#txtToDate').datepicker('show');
            });


            //SET DATES
            function showfromdate() {
                NewCal('txtFromDate');
            }

            function showtodate() {
                NewCal('txtToDate', 'ddmmmyyyy');
            }

            //REMOVE DATES
            $("#removefromdate").on("click", function () 
            { 
                $("#txtFromDate").val(""); 
            });

            $("#removetodate").on("click", function () {
                $("#txtToDate").val("");
            });


            function openPopup(strOpenUrl) {
                window.showModalDialog(strOpenUrl, "mywindow", "scroll=no;center=yes;resizable=no;dialogHide=yes;STATUS=no;dialogWidth=575px;dialogHeight:470px");
            }
            function fnOpen(path) {
                var retVal = window.showModalDialog(path, null, "dialogHeight:300px;dialogWidth:650px;status:0;resizable:0;edge:raised;scroll:0");
                if (retVal == 1) {
                    var objHdn = document.getElementById("hdn_postback");

                    objHdn.value = Math.random() * 11;
                    __doPostBack("hdn_postback", '');
                }

            }

            
            runSearch();
            $('#cmdSearch').on('click', function () { runSearch(); });

            function runSearch() {
                var data = {
                    Category: $("#ddlcategory").val(),
                    Lact: $("#ddlact").val(),
                    Cmbstatus: $("#cmbstatus").val(),
                    FromDate: $("#txtFromDate").val(),
                    ToDate: $("#txtToDate").val(),
                    SfSection: $("#ddlsfsection").val(),
                    Plant: $("#ddlplant").val(),
                };

                $.ajax({
                    url: '@Url.Action("cmdSearch_Click", "Safety")',
                    type: 'POST',
                    data: data,
                    success: function (response) {

                    // If response is empty/null or an empty array → show message and stop
                        if (!response || (Array.isArray(response) && response.length === 0)) {
                            $("#div-datagrid").html("<div class='alert alert-info'>No Records Found</div>");
                            return;
                        }


                        var html = "<table id=\"grdcnotract\" class='table table-bordered table-striped table-hover'><thead><tr>"
                            + "<th class='locked'>View</th><th class='locked'>Contract</th><th class='locked'>Category</th><th class='locked'>Act</th>"
                            + "<th>Requirement</th><th>Section</th><th>Responsible</th><th>Frequency</th>"
                            + "<th>Expiry</th><th>Due</th><th>Status</th><th>Remark</th>"
                            + "<th>Final Doc.</th><th>Submission Doc.</th>"
                            + "</tr></thead><tbody>";

                        $.each(response, function (i, item) {
                            html += "<tr>"
                                + "<td class='locked'><a href='@Url.Action("ReminderDetail", "Safety")?cid={0}&#39;)" + item.EncryptedId + "'>"
                                + "<img src='../../assets/images/application_view_detail.png' alt='View' /></a></td>"
                                + "<td class='locked'>" + item.SFContracts + "</td>"
                                + "<td class='locked'>" + item.CategoryDes + "</td>"
                                + "<td class='locked'>" + item.ActDes + "</td>"
                                + "<td>" + item.Requirement + "</td>"
                                + "<td>" + item.SFSection + "</td>"
                                + "<td>" + item.RespName + "</td>"
                                + "<td>" + item.FrqDes + "</td>"
                                + "<td>" + item.ExpiryDate + "</td>"
                                + "<td>" + item.DueDate + "</td>"
                                + "<td>" + item.CmpStatus + "</td>"
                                + "<td>" + item.Remark + "</td>";

                            // Conditional attachment icons
                            if (item.Attachment && item.Attachment !== "") {
                                html += "<td><a target='_blank' href='@Url.Action("OpenDocument", "Safety")SF_ID=" + item.SFContracts + "&attach=1'>"
                                    + "<img src='../../assets/images/menu_pdf.gif' alt='attachment' /></a></td>";
                            } else {
                                html += "<td></td>";
                            }

                            if (item.AttachFileSubmit && item.AttachFileSubmit !== "") {
                                html += "<td><a target='_blank' href='@Url.Action("OpenDocument", "Safety")SF_ID=" + item.SFContracts + "&attach=2'>"
                                    + "<img src='../../assets/images/menu_pdf.gif' alt='submission' /></a></td>";
                            } else {
                                html += "<td></td>";
                            }

                            html += "</tr>";
                        });

                        html += "</tbody></table>";
                        $("#div-datagrid").html(html);
                    },
                    error: function () {
                        alert("An error occurred while submitting.");
                    }
                });
            };

            function initializeTables() {
                var cnotract = $('#grdcnotract');
                if ($.fn.DataTable.isDataTable(cnotract)) cnotract.DataTable().destroy();
                cnotract.DataTable({ pageLength: 10, lengthChange: false, bFilter: false });
            }


        });

    </script>
}