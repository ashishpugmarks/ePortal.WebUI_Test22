             var chart = null;

        $(document).ready(function () {
                for (let sheet of document.styleSheets) {
            try {
                for (let i = 0; i < sheet.cssRules.length; i++) {
                    let rule = sheet.cssRules[i];
                    if (rule.selectorText === '.homeContent div') {
                        rule.style.removeProperty('padding');
                    }
                    if (rule.selectorText === '.homeContent') {
                        rule.style.removeProperty('padding');
                    }
                }
            } catch (e) {
                // Some stylesheets may be cross-origin and inaccessible
                console.warn("Could not access stylesheet:", e);
            }
        }

            // Initialize empty DataTable on load (same as GridView empty state)
            initPendingTable();

            // SECTION CHANGE → Load Dashboard
            $("#ddlsfsection").change(function () {

                var sectionId = $("#ddlsfsection").val();
                var plantId = $("#ddlplant").val();

                if (!sectionId || sectionId === "") {
                    return;
                }

                $.ajax({
                    url: '/Safety/btnSearch_OnClick',
                    type: 'POST',
                    data: {
                        ddlsfsection: sectionId,
                        ddlplant: plantId
                    },
                    success: function (data) {

                        // ---------- Populate Pending Count Grid ----------
                        var tbody = $("#grdPendingcount tbody");
                        tbody.empty();

                        if (data.pendingViewModel && data.pendingViewModel.length > 0) {
                            data.pendingViewModel.forEach(function (item) {
                                tbody.append(
                                    "<tr>" +
                                        "<td class='status-cell' style='cursor:pointer;color:#0066cc;text-decoration:underline;'>" +
                                            item.status +
                                        "</td>" +
                                        "<td style='text-align:center;'>" + item.count + "</td>" +
                                    "</tr>"
                                );
                            });
                        }

                        reInitPendingTable();

                        // ---------- Render Chart ----------
                        var ctx = document.getElementById("safetyChart").getContext("2d");

                        if (chart) {
                            chart.destroy();
                        }

                        chart = new Chart(ctx, {
                            type: 'pie',
                            data: {
                                labels: data.chartData.map(function (c) { return c.status; }),
                                datasets: [{
                                    data: data.chartData.map(function (c) { return c.count; }),
                                    backgroundColor: [
                                        '#65A0F0',
                                        '#4CAF50',
                                        '#FFCE56',
                                        '#E57373',
                                        '#9575CD'
                                    ]
                                }]
                            },
                            options: {
                                responsive: true,
                                plugins: {
                                    legend: {
                                        position: 'right'
                                    },
                                    title: {
                                        display: true,
                                        text: 'Compliance(s) Status'
                                    }
                                }
                            }
                        });
                    }
                });
            });

            // STATUS CLICK → Load Detail Grid
            $("#grdPendingcount").on("click", ".status-cell", function () {

                var sectionId = $("#ddlsfsection").val();
                var plantId = $("#ddlplant").val();
                var status = $(this).text();

                $.ajax({
                    type: "POST",
                    url: "/Safety/grdPendingcount_RowCommand",
                    data: JSON.stringify({
                        ddlsfsection: sectionId,
                        ddlplant: plantId,
                        strstatus: status
                    }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {

                        var tbody = $("#grddashdetail tbody");
                        tbody.empty();

                        if (data && data.length > 0) {
                            $.each(data, function (index, item) {
                                var row = "<tr>" +
                                    "<td style='text-align:center;'>" + (index + 1) + "</td>" +
                                    "<td>" + item.categoryDes + "</td>" +
                                    "<td>" + item.actDes + "</td>" +
                                    "<td>" + item.requirement + "</td>" +
                                    "<td style='text-align:center;'>" + item.expiryDate + "</td>" +
                                    "<td>" + item.responsiblePerson + "</td>" +
                                    "<td>" + item.remStatus + "</td>" +
                                    "</tr>";

                                tbody.append(row);
                            });
                        }
                    }
                });
            });

            // ---------- Helpers ----------

            function initPendingTable() {
                $('#grdPendingcount').DataTable({
                    pageLength: 10,
                    lengthChange: false,
                    searching: false,
                    ordering: false,
                    info: false,
                    destroy: true
                });
            }

            function reInitPendingTable() {
                if ($.fn.DataTable.isDataTable('#grdPendingcount')) {
                    $('#grdPendingcount').DataTable().destroy();
                }
                initPendingTable();
            }

        });

    </script>
}