@model IEnumerable<ePortal.ViewModels.APPX.Safety.ReminderDetail>
@{
    ViewBag.Title = "Approval Details";
    Layout = null;
}

<div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
    <table width="100%" style="background-color: White;" cellpadding="0" cellspacing="0">
        <tr>
            <td style="padding: 4px;">
                <fieldset class="fieldsetstyle" style="width: 98%; padding-top: 5px;">
                    <legend class="legendstyle">Reminder Detail'S</legend>
                    <table width="98%" style="margin: 4px;" cellpadding="0" cellspacing="0">
                        <tr>
                            <td style="width: 100%;">
                                <table class="tborder" style="width:100%">
                                    <thead style="background-color:#F0F7FF; height:25px; border-color:#0066FF;">
                                        <tr>
                                            <th style="width:5%; text-align:center;">S.NO</th>
                                            <th style="width:20%; text-align:center;">Remark</th>
                                            <th style="width:10%; text-align:center;">Status</th>
                                            <th style="width:15%; text-align:center;">Added By</th>
                                            <th style="width:15%; text-align:center;">Added Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model == null || !Model.Any())
                                        {
                                            <tr style="background-color:#F5FFF0; height:20px; font-family:Calibri; color:#274D14;">
                                                <td colspan="5">&nbsp;&nbsp;No Reminder details is found.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            var index = 1;
                                            foreach (var item in Model)
                                            {
                                                <tr style="height:20px; background-color:@(index % 2 == 0 ? "White" : "#F9F9F9"); color:#5D838C;">
                                                    <td style="text-align:center;">@index</td>
                                                    <td style="text-align:center;">@item.Remarks</td>
                                                    <td style="text-align:center;">@item.Status</td>
                                                    <td style="text-align:center;">@item.AddedBy</td>
                                                    <td style="text-align:center;">@item.AddedDate</td>
                                                </tr>
                                                index++;
                                            }
                                        }
                                    </tbody>
                                </table>

                            </td>
                        </tr>
                    </table>
                </fieldset>
            </td>
        </tr>
    </table>
</div>

@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />  
}