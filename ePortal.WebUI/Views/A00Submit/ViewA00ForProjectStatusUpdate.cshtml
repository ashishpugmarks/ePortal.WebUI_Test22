@section Scripts{


    <script type="text/javascript" language="Javascript" src="~/js/jquery-ui.js"></script>
    <script type="text/javascript" language="Javascript" src="~/js/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/lib/bootstrap/js/bootstrap.min.js"></script>
    <script type="text/javascript" src="~/lib/bootstrap/js/bootstrap-multiselect.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(function () {
            $('[id*=SKYLIST]').multiselect({
                includeSelectAllOption: true
            });
            $("#start").datepicker({ format: "dd/mm/yyyy" }).val();
            $("#end").datepicker({ format: "dd/mm/yyyy" }).val();
        });
    </script>



    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {

            // $("#btndeficiency").click(function () {
            //    $('#myModal').modal('show');
            //     // $('#myModal').show();
            //     // $('#btnmode').trigger();
            //      //$('#btnmode').hide();
            //     // e.preventDefault();
            //});
        });
        function popup() {
            $('[id*="myModal"]').modal('show');
        }

        function closepopup() {
            $('#myModal').modal('hide');
            $(document.body).removeClass('modal-open');
            $('.modal-backdrop').remove();
        }
    </script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        function HandleBrowseClick() {
            var fileinput = document.getElementById("browse");
            fileinput.click();
            var textinput = document.getElementById("filename");
            textinput.value = fileinput.value;
        }
    </script>

    @*CSP 3.0 Compliant Changes*@

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
        $(document).ready(function () {
            $('#btnBack').on('click', function () {
                window.location = document.referrer;
            });

            $('#btndeficiency').on('click', function () {
                popup();
                return false;
            });

            $('#fakeBrowse').on('click', function () {
                HandleBrowseClick();
            });

            $('[data-ctrl="close-popup"]').on('click', function () {
                closepopup();
                return false;
            });

            $('[data-ctrl="btn-back"]').on('click', function (e) {
                e.preventDefault();
                window.top.close();
            });

            $('#SKYLIST').on('change', function () {
                CheckOthers();
            });

            $('#ImageFile').on('change', function () {
                ValidateSingleInput($(this)[0]);
            });
        });
    </script>


}
