    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
        $(document).ready(function ()  {
            $('.homeContent').removeClass('homeContent');

            $('[id*=SKYLIST]').multiselect({
                includeSelectAllOption: true
            });

            $('#start').datepicker({
                format: "dd/mm/yyyy",
                todayHighlight: true,
                autoclose: true,
                clearBtn: true,

            });

            $('#end').datepicker({
                format: "dd/mm/yyyy",
                todayHighlight: true,
                autoclose: true,
                clearBtn: true,

            });
            $('#reqDetails, #approvalHistory, #deficiencyHistory, #allocationHistory, #itConfApprovalHistory, #projStatusUpdateHistory, #sentBackHistory, #approval').on('show.bs.collapse', function () {
                $(this).prev('.panel-heading').find('.caret-color').removeClass('fa-caret-right').addClass('fa-caret-down');
            });
            $('#reqDetails, #approvalHistory, #deficiencyHistory, #allocationHistory, #itConfApprovalHistory, #projStatusUpdateHistory, #sentBackHistory, #approval').on('hide.bs.collapse', function () {
                $(this).prev('.panel-heading').find('.caret-color').removeClass('fa-caret-down').addClass('fa-caret-right');
            });
            setPanelWidth();
        });
        $(window).resize(function(){
            setPanelWidth();
        });
        function setPanelWidth() {
            var btnApproveClientWidth = $('.pnl-btn .approve').prop('clientWidth');
            if (window.innerWidth < 1024) { // Mobile layout
                $('.last-row-btn .btn').css({
                    'maxWidth': `auto`
                });
            }
            else {
                $('.last-row-btn .btn').css({
                    'maxWidth': `${btnApproveClientWidth}px`
                });
            }
        }
    </script>
