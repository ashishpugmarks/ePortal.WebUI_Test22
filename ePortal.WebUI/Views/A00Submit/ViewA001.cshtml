<link rel="stylesheet" href="~/css/new-aproval-page.css" asp-append-version="true" />
@* Header and Breadcrumb *@
<div class="app-header">
    <div>A00 Concept Form</div>
    <div class="pull-right"><span style="color:#e6dede91"> <i class="fa fa-home"></i> <i class="fa fa-angle-right"></i> A00 Concept Form <i class="fa fa-angle-right"></i> </span>
        @if (ViewBag.actionType == "Approval")
        {
            <span>Approval</span>
        }
        else if (ViewBag.actionType == "Submit")
        {
            <span>New</span>
        }
        else
        {
            <span>View</span>
        }
    </div>
</div>

@using (Html.BeginForm("ViewA001", "A00Submit", FormMethod.Post, new { encType = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary("", new { @class = "text-danger" })
    @Html.HiddenFor(x => x.A00DTLTBID)
    @if (ViewBag.pageType == "VIEW")
    {
        <table style="width:100%; display:none" id="tblmsg" border="1">
            <tr id="errorPanel">
                <td colspan="2" style="width:100%;">
                    <table style="width: 100%; margin-bottom: 5px;">
                        <tr>
                            <td align="left" valign="top">
                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                    <tbody>
                                        <tr class="errorbox">
                                            <td style="vertical-align: middle;">
                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                    <tr>
                                                        <td style="vertical-align: middle; text-align: center; width: 2%;">

                                                            <img src="~/images/icon_error.gif" border="0" alt="" />
                                                        </td>
                                                        <td class="errorbox col-md-12" style="vertical-align: middle; text-align: left;">

                                                            &nbsp;@Html.Label("ErrorStatus", "Test Error", new { id = "ErrorStatus", @class = "smalltext" })
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

    }
    else
    {
        <table style="width:100%; display:none" id="tblmsg" border="1">
            <tr id="errorPanel">
                <td colspan="2" style="width:100%;">
                    <table style="width: 100%; margin-bottom: 5px;">
                        <tr>
                            <td align="left" valign="top">
                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                    <tbody>
                                        <tr class="errorbox">
                                            <td style="vertical-align: middle;">
                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                    <tr>
                                                        <td style="vertical-align: middle; text-align: center; width: 2%;">

                                                            <img src="~/images/icon_error.gif" border="0" alt="" />
                                                        </td>
                                                        <td class="errorbox col-md-12" style="vertical-align: middle; text-align: left;">

                                                            &nbsp;@Html.Label("ErrorStatus", "Test Error", new { id = "ErrorStatus", @class = "smalltext" })
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    }

    @* Request Details *@

    <div class="panel panel-shadow">
        <div class="panel-heading" data-toggle="collapse" data-target="#reqDetails">
            <span class="panel-title">
                <i class="fa fa-caret-down caret-color"></i>Requestor's Details
            </span>
        </div>
        <div id="reqDetails" class="panel-body panel-collapse collapse in">
            <table class="table table-responsive approval-table table-curved">
                <tbody>
                    <tr>
                        <th width="15%">
                            Project title <span style="color: #ff0000">*</span>
                        </th>
                        <td width="20%">
                            @if (ViewBag.pageType == "VIEW")
                            {
                                @Html.TextBoxFor(m => m.Projecttitle,
                                new
                                {
                                    @class = "form-control",
                                    @maxlength = "100",
                                    disabled = "disabled"
                                })
                                                    }
                            else
                            {
                                @Html.TextBoxFor(m => m.Projecttitle,
                                new
                                {
                                    @maxlength = "100",
                                    @class = "form-control",
                                })
                                                    }
                        </td>

                        <th width="15%">
                            Budgeted(Y/N)<span style="color: #ff0000">*</span>
                        </th>
                        <td width="20%">
                            @if (ViewBag.pageType == "VIEW")
                            {
                                @Html.DropDownListFor(model => model.Budgeted, (IEnumerable<SelectListItem>)ViewBag.BudgetedValue,
                                new { @class = "form-control input", @disabled = "disabled" })
                                                    }
                            else
                            {
                                @Html.DropDownListFor(model => model.Budgeted,
                                (IEnumerable<SelectListItem>)ViewBag.BudgetedValue, new { @class = "form-control input" })
                                                    }
                        </td>

                        <th width="10%">
                            KI <span style="color: #ff0000">*</span>
                        </th>
                        <td width="20%">
                            @if (ViewBag.pageType == "VIEW")
                            {
                                @Html.DropDownList("KICODE", ViewBag.SKY as SelectList, new
                                {
                                    @class = "form-control input",
                                                    @disabled = "disabled"
                                                    })
                                                    }
                            else
                            {
                                if (ViewBag.selectedBudgetedVal == "0")
                                {
                                    @Html.DropDownList("KICODE", ViewBag.SKY as SelectList, new
                                    {
                                        @class = "form-control input",
                                                    id = "KICODE",
                                                    @disabled = "disabled"
                                                    })
                                                    }
                                else
                                {
                                    @Html.DropDownList("KICODE", ViewBag.SKY as SelectList, new
                                    {
                                        @class = "form-control input",
                                                    id = "KICODE"
                                                    })
                                                    }
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Background & Situation Analysis <span style="color: #ff0000">*</span></th>
                        <td>
                            @if (ViewBag.pageType == "VIEW")
                            {
                                @Html.TextAreaFor(m => m.Backgrounds, 1, 1,
                                new
                                {
                                    @class = "form-control",
                                    @rows = "1",
                                    @style = "margin: 0px; height: 115px; width: 319px;",
                                    @maxlength = "500",
                                    disabled = "disabled"
                                })
                                                    }
                            else
                            {
                                @Html.TextAreaFor(m => m.Backgrounds, 1, 1, new
                                {
                                    @class = "form-control",
                                                    @rows = "1",
                                                    @style = "margin: 0px; height: 115px; width: 319px;",
                                                    @maxlength = "500"
                                                    })
                                                    }
                        </td>
                        <th>Business Target <span style="color: #ff0000">*</span></th>
                        <td>
                            <div class="row">
                                <div class="col-md-6">
                                    Start date
                                    @if (ViewBag.pageType == "VIEW")
                                    {
                                        <input type="text" id="start" name="Start" readonly="readonly" placeholder="dd/mm/yyyy" class="form-control"
                                                value="@Model.StartDate" disabled />

                                    }
                                    else
                                    {

                                        <input type="text" id="start" name="Start" value="@Model.StartDate" readonly="readonly" class="form-control"
                                                placeholder="dd/mm/yyyy" />

                                    }
                                </div>
                                <div class="col-md-6">
                                    End date
                                    @if (ViewBag.pageType == "VIEW")
                                    {
                                        <input type="text" id="end" name="End" readonly="readonly" placeholder="dd/mm/yyyy" class="form-control"
                                                value="@Model.EndDate" disabled />
                                    }
                                    else
                                    {
                                        <input type="text" id="end" name="End" readonly="readonly" value="@Model.EndDate" placeholder="dd/mm/yyyy" class="form-control" />
                                    }
                                </div>
                            </div>
                        </td>

                        <th>Budgeted by <span style="color: #ff0000">*</span></th>
                        <td>
                            @if (ViewBag.pageType == "VIEW")
                            {
                                //@Html.DropDownList("LEVELDESCRIP", ViewBag.List as SelectList, new
                                @Html.DropDownListFor(m => m.ADORGLEVELID, ViewBag.List as SelectList, new //Changed By Eshant to Bind Drop Down -- 13-06-2022
                                {
                                    @class = "form-control input",
                                                    id = "LEVELDESCRIP",
                                                    @disabled = "disabled"
                                                    })
                                                    }
                            else
                            {
                                if (ViewBag.selectedBudgetedVal == "0")
                                {
                                    //@Html.DropDownList("LEVELDESCRIP", ViewBag.List as SelectList, new
                                    @Html.DropDownListFor(m => m.ADORGLEVELID, ViewBag.List as SelectList, new //Changed By Eshant to Bind Drop Down -- 13-06-2022
                                    {
                                        @class = "form-control input",
                                                    id = "LEVELDESCRIP",
                                                    @disabled = "disabled"
                                                    })
                                                    }
                                else
                                {
                                    @Html.DropDownList("LEVELDESCRIP", ViewBag.List as SelectList, new
                                    {
                                        @class = "form-control input",
                                                    id = "LEVELDESCRIP"
                                                    })
                                                    }
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Business KPI(Key Performance Indicator)<span style="color: #ff0000">*</span></th>
                        <td>
                            @if (ViewBag.pageType == "VIEW")
                            {
                                @Html.TextAreaFor(m => m.BusinessKPI, 1, 1, new
                                {
                                    @class = "form-control",
                                                    @maxlength = "300",
                                                    disabled = "disabled"
                                                    })
                                                    }
                            else
                            {
                                @Html.TextAreaFor(m => m.BusinessKPI, 1, 1, new
                                {
                                    @class = "form-control",
                                                    @maxlength = "300"
                                                    })
                                                    }
                        </td>

                        <th>
                            Investment Effect Forecast<span style="color: #ff0000">*</span>
                        </th>
                        <td>
                            @if (ViewBag.pageType == "VIEW")
                            {
                                int i = 0;
                                foreach (var item in ViewBag.SKYLIST)
                                {
                                    if (i != 0)
                                    {

                                        <br />
                                        <label class="text-info" style="text-align: right; vertical-align: middle; font-size:12px; font-weight: inherit;">@item.Text</label>
                                    }
                                    else
                                    {
                                        <label class="text-info" style="text-align: right; vertical-align: middle; font-size:12px; font-weight: inherit;">@item.Text</label>
                                    }
                                    i++;
                                }
                            }
                            else
                            {
                                if (ViewBag.SKYLIST != null)
                                {

                                    <select id="SKYLIST" multiple="multiple" name="SKYLIST" class="form-control dropdownt">
                                        @foreach (var item in ViewBag.SKYLIST)
                                        {
                                            if (item.Text != null)
                                            {
                                                <option value="@item.Value" selected="@item.Selected"> @item.Text</option>
                                            }
                                        }
                                    </select>
                                }
                            }
                        <th>
                            If Others<span style="color: #ff0000">*</span>
                        </th>
                        <td id="trIfAny">
                            @Html.TextBoxFor(m => m.Ifothers, new
                            {
                                @class = "form-control",
                                                    @maxlength = "100",
                                                    @disabled = "disabled"
                                                    })
                    </td>
                </tr>
                <tr>
                    <th>A00 Purpose<span style="color: #ff0000">*</span></th>
                    <td colspan="5">
                        @if (ViewBag.pageType == "VIEW")
                            {
                                @Html.TextAreaFor(m => m.PurposeA00, new { @class = "form-control", @maxlength = "500", disabled = "disabled" })
                            }
                            else
                            {
                                @Html.TextAreaFor(m => m.PurposeA00, new { @class = "form-control", @maxlength = "500" })
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>A00-Target<span style="color: #ff0000">*</span></th>
                        <td colspan="5">
                            @if (ViewBag.pageType == "VIEW")
                            {
                                @Html.TextBoxFor(m => m.TargetA00, new
                                {
                                    @class = "form-control",
                                                    @maxlength = "200",
                                                    disabled = "disabled"
                                                    })
                                                    }
                            else
                            {
                                @Html.TextBoxFor(m => m.TargetA00, new { @class = "form-control", @maxlength = "200" })
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>A00-Requirement<span style="color: #ff0000">*</span></th>
                        <td colspan="5">
                            @if (ViewBag.pageType == "VIEW")
                            {
                                @Html.TextBoxFor(m => m.RequirmentA00, new { @class = "form-control", @maxlength = "500", disabled = "disabled" })
                            }
                            else
                            {
                                @Html.TextBoxFor(m => m.RequirmentA00, new { @class = "form-control", @maxlength = "500" })
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>
                            AS IS & TO BE Process<span style="color: #ff0000">*</span>
                            <br />
                            <span style="color:red;" class="form-inline">(Only PDF file allowed.)</span>
                        </th>
                        <td colspan="6">
                            @if (ViewBag.pageType == "VIEW")
                            {
                                <div class="btn btn-md btn-aprvl-view">
                                    <a href="@Url.Action("DownloadFile", "A00Submit", new { FileName = @Model.ImagePath })">
                                        Download
                                        <span class="glyphicon glyphicon-download" aria-hidden="true"></span>
                                    </a>
                                </div>
                            }
                            else
                            {
                                if (Model.ImagePath != "" && Model.ImagePath != null)
                                {
                                    <table class="table table-borderless table-curved" style="margin-bottom: 0;">
                                        <tr>
                                            <td width="85%">
                                                <input name="ImageFile" id="ImageFile" type="file" accept=".pdf" class="form-control" />
                                            </td>
                                            <td>
                                                <div class="btn btn-md btn-aprvl-view">
                                                    <a href="@Url.Action("DownloadFile", "A00Submit", new { FileName = @Model.ImagePath })">
                                                        Download
                                                        <span class="glyphicon glyphicon-download" aria-hidden="true"></span>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>
                                    <input type="hidden" id="isFileExist" name="isFileExist" value="Y" />
                                }
                                else
                                {
                                    <input name="ImageFile" id="ImageFile" type="file" accept=".pdf" class="form-control" />
                                    <input type="hidden" id="isFileExist" name="isFileExist" value="N" />
                                }
                            }
                        </td>
                    </tr>
                    <tr>
                        <th></th>
                        <td colspan="6">
                            <div class="alert alert-info" style="margin-bottom: 0;">
                                Note: <b>AS IS & TO BE process signed by Operating Head to be attached and Divisional level explanation meeting need to be called by the initiator.</b>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @* Approval History *@
    @if (ViewBag.ApprovalHistory != null)
    {
        <div class="panel panel-shadow">
            <div class="panel-heading" data-toggle="collapse" data-target="#approvalHistory">
                <span class="panel-title">
                    <i class="fa fa-caret-down caret-color"></i>Approval History
                </span>
            </div>
            <div id="approvalHistory" class="panel-body panel-collapse collapse in">
                <div class="table-responsive">
                    <table class="table table-responsive approval-table table-curved custom-datatable" id="tbApprovalHis">
                        <thead>
                            <tr>
                                <th width="10%"></th>
                                <th width="15%">Dept.Head</th>
                                <th width="15%">Coordinator</th>
                                <th width="15%">Div. Head</th>
                                <th width="15%">Ex. Coordinator</th>
                                <th width="15%">Operating Head</th>
                                <th width="15%">Additional approval (Corp. PPC)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.ApprovalHistory)
                            {
                                <tr>
                                    <th scope="row">Name</th>
                                    <td>@item.DeptHeadName</td>
                                    <td>@item.CoOrdName</td>
                                    <td>@item.DivHeadName</td>
                                    <td>@item.ExeCoOrdName</td>
                                    <td>@item.OpHeadName</td>
                                    <td>@item.PPCHOOHName</td>
                                </tr>
                                <tr>
                                    <th scope="row">Approval Date</th>
                                    <td>
                                        @if (item.DEPTHDAPPDATE != null)
                                        {
                                            @item.DEPTHDAPPDATE.ToString("dd/MM/yyyy")
                                        }
                                    </td>
                                    <td>
                                        @if (item.COORDAPPDATE != null)
                                        {
                                            @item.COORDAPPDATE.ToString("dd/MM/yyyy")
                                        }
                                    </td>
                                    <td>
                                        @if (item.DIVHDAPPDATE != null)
                                        {
                                            @item.DIVHDAPPDATE.ToString("dd/MM/yyyy")
                                        }

                                    </td>
                                    <td>
                                        @if (item.EXECOAPPDATE != null)
                                        {
                                            @item.EXECOAPPDATE.ToString("dd/MM/yyyy")
                                        }

                                    </td>
                                    <td>
