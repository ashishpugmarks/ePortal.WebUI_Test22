        }

        .btn1 {
            /*width: 180px !important;
                                        font-size: 14px !important;
                                        background-color: #e3e3e3;
                                        border: 1px solid #e6e6e6;
                                        border-radius: 3px;
                                            padding-top: 8px;*/
