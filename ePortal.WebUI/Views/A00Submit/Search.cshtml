@*<h2>Search</h2>*@

<div class="row">

    @using (Html.BeginForm("Search", "A00Submit", FormMethod.Post))
    {
        <div class="form-group">

            <table class="table table-bordered table-hover table-responsive">
                <tr>
                    <td class="tbl_cls1"><label for="Ki" class="font-size">ki </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownList("SearchParams.SYKI", ViewBag.SYKIData as SelectList, new { @class = "form-control", @data_ctrl = "syki-dropdown" })
                    </td>
                    <td class="tbl_cls1"><label for="EmpCode" class="font-size">Emp Code/Name </label></td>
                    <td class="tbl_cls2">
                        <div class="col col-md-3 col-lg-3">
                            @Html.TextBoxFor(model => model.SearchParams.ECode, new { id = "empCode", @class = "form-control", @placeholder = "Code" })
                        </div>
                        <div class="col col-md-offset-1 col-lg-offset-1 col-md-8 col-lg-8">
                            @Html.TextBoxFor(model => model.SearchParams.EmpName, new { id = "empName", @class = "form-control", @placeholder = "Name" })
                        </div>
                    </td>
                </tr>

                <tr>
                    <td class="tbl_cls1"><label for="Operation" class="font-size">Operation </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownListFor(model => model.SearchParams.OPERATION,
                                 new SelectList(ViewBag.List, "OPERATIONID", "OPERATION", ViewBag.List[0]),
                                 new { disabled = "disabled", @class = "form-control" })
                        @Html.Hidden("hdnOpId", (object)Convert.ToInt32(ViewBag.List[0].OPERATIONID))
                    </td>
                    <td class="tbl_cls1"><label for="Division" class="font-size">Division </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownListFor(model => model.SearchParams.DIVISION,
                                 new SelectList(ViewBag.List, "DIVISIONID", "DIVISION", ViewBag.List[0]),
                                 new { @class = "form-control", disabled = "disabled" })
                        @Html.Hidden("hdnDivId", (object)Convert.ToInt32(ViewBag.List[0].DIVISIONID))
                    </td>
                </tr>

                <tr style="background-color:#f3f3f3">
                    <td class="tbl_cls1"><label for="Department" class="font-size">Department </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownListFor(model => model.SearchParams.DEPARTMENT,
                                 new SelectList(ViewBag.List, "DEPARTMENTID", "DEPARTMENT", ViewBag.List[0]),
                                 new { @class = "form-control", disabled = "disabled" })
                        @Html.Hidden("hdnDeptId", (object)Convert.ToInt32(ViewBag.List[0].DEPARTMENTID))
                    </td>
                    <td class="tbl_cls1"><label for="Section" class="font-size">Section </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownListFor(model => model.SearchParams.SECTION, new SelectList(ViewBag.List, "SECTIONID",
                                 "SECTION", ViewBag.List[0]), new { @class = "form-control", disabled = "disabled" })
                        @Html.Hidden("hdnSectionId", (object)Convert.ToInt32(ViewBag.List[0].SECTIONID))
                    </td>
                </tr>

                <tr style="background-color:#f3f3f3">
                    <td class="tbl_cls1"><label for="Status" class="font-size">Status </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownList("SearchParams.Status", ViewBag.StatusList as SelectList, new { @class = "form-control" })
                    </td>
                    <td class="tbl_cls1"></td>
                    <td class="tbl_cls2"></td>
                </tr>

                <tr>
                    <td style="height:45px; text-align:center; padding-top:07px;" colspan="4">
                        <button id="SearchBtnClick" type="submit" class="btn btn-success btn_disable" style="width:90px;
                         height:30px; background-color: #ccc; border-color: rgba(0, 0, 0, 0.4); color: #0c0c0c;">
                            Search
                        </button>
                        &nbsp;&nbsp;&nbsp;

                        <button type="button" class="btn btn-success btn_disable" id="CancelBtnClick"
                                style="width:90px; height:30px; background-color: #ccc; border-color: rgba(0, 0, 0, 0.4); color: #0c0c0c;">
                            Cancel
                        </button>
                    </td>

                </tr>
            </table>
        </div>
    }


    @if (Model != null)
    {
        <div id="searchResults">
            <table class="table" style="font-size:13px; border: 1px solid #dddddd;">


                <tr class="tcat">

                    <th style="border: 1px solid #dddddd;text-align:center;width:3%;font-weight:bold">S.No</th>
                    <th style="border: 1px solid #dddddd;text-align:center;width:5%;font-weight:bold">@Html.DisplayName("Ki")</th>
                    <th style="border: 1px solid #dddddd;width:9%;text-align:center;font-weight:bold">@Html.DisplayName("E Code")</th>
                    <th style="border: 1px solid #dddddd;width:13%;text-align:center;font-weight:bold">@Html.DisplayName("Name")</th>
                    <th style="border: 1px solid #dddddd;width:15%;text-align:center;font-weight:bold">@Html.DisplayName("Project Title")</th>
                    <th style="border: 1px solid #dddddd;width:8%;text-align:center;font-weight:bold">@Html.DisplayName("Request Date")</th>
                    @*
                    <th style="border: 1px solid #dddddd;width:9%;text-align:center;font-weight:bold">@Html.DisplayName("Last Approved/ Action By")</th>
                    <th style="border: 1px solid #dddddd;width:9%;text-align:center;font-weight:bold">@Html.DisplayName("Last&nbsp;Approved/ Action Date")</th>*@
                    <th style="border: 1px solid #dddddd;width:9%;text-align:center;font-weight:bold">Last&nbsp;Approved&nbsp;By</th>
                    <th style="border: 1px solid #dddddd;text-align:center;font-weight:bold">Last&nbsp;Approved&nbsp;Date</th>
                    @*
                    <th style="border: 1px solid #dddddd;width:9%;text-align:center;font-weight:bold">Last&nbsp;Approved&nbsp;Remark</th>*@
                    <th style="border: 1px solid #dddddd;width:9%;text-align:center;font-weight:bold">@Html.DisplayName("View")</th>
                    <th style="border: 1px solid #dddddd;width:7%;text-align:center;font-weight:bold">@Html.DisplayName("Action")</th>
                    <th style="border: 1px solid #dddddd;width:7%;text-align:center;font-weight:bold">@Html.DisplayName("Deficiency")</th>
                    <th style="border: 1px solid #dddddd;width:6%;text-align:center">@Html.DisplayName("Remark")</th>
                </tr>
                @{
                    TempData["status"] = Model.SearchParams.Status;
                }
                @if (Model.ResultList.Count > 0)
                {
                    int i = 1;
                    foreach (var item in Model.ResultList)
                    {
                        <tr>
                            <td style="border: 1px solid #dddddd;padding-top:20px;padding-top:20px;text-align:center;">@i</td>
                            <td style="border: 1px solid #dddddd; text-align:center;padding-top:20px;">@Html.DisplayFor(ModelItem => item.KICODE)</td>
                            <td style="border: 1px solid #dddddd;text-align:center;padding-top:20px;">@Html.DisplayFor(ModelItem => item.ECode)</td>
                            <td style="border: 1px solid #dddddd;padding-top:20px;">@Html.DisplayFor(ModelItem => item.EmpName)</td>
                            <td style="border: 1px solid #dddddd;padding-top:20px;">@Html.DisplayFor(ModelItem => item.ProjectTitle)</td>
                            <td style="border: 1px solid #dddddd;text-align:center;padding-top:20px;">@Html.ValueFor(ModelItem => item.RequestDate, "{0:dd/MM/yyyy}")</td>
                            <td style="border: 1px solid #dddddd;padding-top:20px;">@Html.DisplayFor(ModelItem => item.ApprovedBy)</td>
                            <td style="border: 1px solid #dddddd;text-align:center;padding-top:20px;">@Html.ValueFor(ModelItem => item.ApprovedOn, "{0:dd/MM/yyyy}")</td>
                            @*
                    <td style="border: 1px solid #dddddd;padding-top:20px;">@Html.DisplayFor(ModelItem => item.ApprovedRemark)</td>*@
                            <td style="border: 1px solid #dddddd; text-align:center;padding-top:20px;">
                                <a href='@Url.Action("ViewA001", "A00Submit",
                                                                new { A00DTLTBID = item.A00DTLTBID, type = "View",

                                                                    //07-Sept-2021 change start
                                                                    //OPERATIONID = Model.SearchParams.OPERATIONID,
                                                                    OPERATIONID = item.OPERATION,
                                                                    //07-Sept-2021 change start

                                                                    DIVISIONID = Model.SearchParams.DIVISIONID,
                                                                    DEPARTMENTID = Model.SearchParams.DEPARTMENTID,
                                                                    SECTIONID = Model.SearchParams.SECTIONID,
                                                                    SYKIID = Model.SearchParams.SYKIID,
                                                                    ECODE = Model.SearchParams.ECode,
                                                                    EMPNAME = Model.SearchParams.EmpName,
                                                                    STATUSID = Model.SearchParams.StatusId })' target="_blank"
                                   class="glyphicon glyphicon-eye-open">
                                    <!--Change start on 22-July-2021--><!--Added target_blak by Eshant 30 June-22-->
                                    <br />
                                    @if (item.STATUSCD == 125)
                                    {
                                        <span style="font-family:Arial; font-size:12px; color:#18397c; background-color:#cbfffa;">Sent back (Convert to CR)</span>
                                    }
                                    <!--Change end on 22-July-2021-->
                                </a>
                            </td>
                            @{
                                i++;
                            }
                            @*@if (Model.SearchParams.StatusId == 1 || Model.SearchParams.StatusId == 5)*@ @*Commented on 22-July-2021*@
                            @if ((Model.SearchParams.StatusId == 1 || Model.SearchParams.StatusId == 5) && item.STATUSCD != 125) //Change on 22-July-2021
                            {
                                <td style="border: 1px solid #dddddd;text-align:center;padding-top:20px;">
                                    <a href='@Url.Action("ViewA001", "A00Submit",
                                            new { A00DTLTBID = item.A00DTLTBID, type = "Action",

                                            //07-Sept-2021 change start
                                                                    //OPERATIONID = Model.SearchParams.OPERATIONID,
                                                                    OPERATIONID = item.OPERATION,
                                                                    //07-Sept-2021 change start

                                                DIVISIONID = Model.SearchParams.DIVISIONID, DEPARTMENTID = Model.SearchParams.DEPARTMENTID,
                                                SECTIONID = Model.SearchParams.SECTIONID, SYKIID = Model.SearchParams.SYKIID, ECODE = Model.SearchParams.ECode,
                                                EMPNAME = Model.SearchParams.EmpName, STATUSID = Model.SearchParams.StatusId })'
                                       class="glyphicon glyphicon-pencil"></a>

                                </td>
                            }
                            else
                            {
                                <td style="border: 1px solid #dddddd;text-align:center;padding-top:20px;">
                                    -
                                </td>
                            }
                            @if (item.IsDeficiencyRaised == true)
                            {
                                //if (item.DeficiencyStatus == 1 || item.DeficiencyStatus == 3) @*Commented on 22-July-2021*@
                                if ((item.DeficiencyStatus == 1 || item.DeficiencyStatus == 3) && item.STATUSCD != 125) //Change on 22-July-2021
                                {
                                    <td style="border: 1px solid #dddddd;text-align:center;padding-top:20px;">
                                        <a href='@Url.Action("A00DeficiencyUpdate", "A00Submit",
                                                                       new
                                                                       {
                                                                           A00DTLTBID = item.A00DTLTBID,
                                                                           type = "View",

                                                                           //07-Sept-2021 change start
                                                                           //OPERATIONID = Model.SearchParams.OPERATIONID,
                                                                           OPERATIONID = item.OPERATION,
                                                                           //07-Sept-2021 change start

                                                                           DIVISIONID = Model.SearchParams.DIVISIONID,
                                                                           DEPARTMENTID = Model.SearchParams.DEPARTMENTID,
                                                                           SECTIONID = Model.SearchParams.SECTIONID,
                                                                           SYKIID = Model.SearchParams.SYKIID,
                                                                           ECODE = Model.SearchParams.ECode,
                                                                           EMPNAME = Model.SearchParams.EmpName,
                                                                           STATUSID = Model.SearchParams.StatusId
                                                                       })'
                                           class="glyphicon glyphicon-pencil"></a>
                                    </td>
                                }
                                else
                                {
                                    <td style="border: 1px solid #dddddd;text-align:center;padding-top:20px;">



                                        <a href='@Url.Action("ITDivisionView", "A00Submit", new
                                          {
                                              A00DTLTBID = item.A00DTLTBID,
                                              type = "View",

                                              //07-Sept-2021 change start
                                              //OPERATIONID = Model.SearchParams.OPERATIONID,
                                              OPERATIONID = item.OPERATION,
                                              //07-Sept-2021 change start

                                              DIVISIONID = Model.SearchParams.DIVISIONID,
                                              DEPARTMENTID = Model.SearchParams.DEPARTMENTID,
                                              SECTIONID = Model.SearchParams.SECTIONID,
                                              SYKIID = Model.SearchParams.SYKIID,
                                              ECODE = Model.SearchParams.ECode,
                                              EMPNAME = Model.SearchParams.EmpName,
                                              STATUSID = Model.SearchParams.StatusId
                                          })' class="glyphicon glyphicon-eye-open"></a>
                                    </td>
                                }
                            }
                            else
                            {
                                <td style="border: 1px solid #dddddd;text-align:center;padding-top:20px;">
                                    -
                                </td>
                            }
                            <td>

                                <button class="glyphicon glyphicon-pencil" data-ctrl="add-remark" data-id="@item.A00DTLTBID"></button>
                                <button class="glyphicon glyphicon-eye-open" data-ctrl="view-remark" data-id="@item.A00DTLTBID"></button>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="12"> No record found.</td>
                    </tr>
                }
            </table>
        </div>
    }


    <table class="table table-bordered table-hover table-responsive">
        <tr style="background-color:#f3f3f3">
            <td style="height: 20px;font-size: 14px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td colspan="4">
                                <a title="Back" href="/home/home">
                                    <img src="~/images/icon_back.gif" border="0" alt="">
                                    Back
                                </a>
                            </td>

                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>
@*Change start on 22-July-2021*@
