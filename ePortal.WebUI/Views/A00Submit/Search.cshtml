@section Scripts {
    <script src="~/lib/bootstrap/js/bootstrap.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        var msg = '@ViewBag.Msg';
        if (msg.length) {
            alert(msg);
        }
    </script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            var DeptMgr = "DeptMgr";
            var Coordinator = "Coordinator";
            $("#SearchBtnClick1").click(function () {

            });

            $("#CancelBtnClick").click(function () {

                location.reload(true);

            });
        });
        ////======== Bind Division========////
        function BindOperationDivisionDepartmentSectionBySykiId(crnt, call) {
            var kiID = $(crnt).val();
            var select_ddlOp = $("#SearchParams_OPERATION");
            var select_ddlDiv = $("#SearchParams_DIVISION");
            var select_ddlDep = $("#SearchParams_DEPARTMENT");
            var select_ddlSec = $("#SearchParams_SECTION");
            select_ddlOp.empty(); select_ddlDiv.empty(); select_ddlDep.empty(); select_ddlSec.empty();

            select_ddlOp.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlDiv.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlDep.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlSec.append($('<option />', { value: "0", text: "--Please wait--" }));
            if (kiID != "" && kiID != "0") {
                $.getJSON("/A00Submit/BindOperationDivisionDepartmentSectionBySykiId", { SYKIID: kiID },
                    function (data) {
                        select_ddlOp.empty(); select_ddlDiv.empty(); select_ddlDep.empty(); select_ddlSec.empty();
                        if (data.length > 0) {
                            $.each(data, function (index, itemData) {
                                select_ddlOp.append($('<option />', { value: itemData.OPERATIONID != null ? itemData.OPERATIONID : 0, text: itemData.OPERATION }));
                                $("#hdnOpId").val(itemData.OPERATIONID != null ? itemData.OPERATIONID : 0);
                                select_ddlDiv.append($('<option />', { value: itemData.DIVISIONID != null ? itemData.DIVISIONID : 0, text: itemData.DIVISION }));
                                $("#hdnDivId").val(itemData.DIVISIONID != null ? itemData.DIVISIONID : 0);
                                select_ddlDep.append($('<option />', { value: itemData.DEPARTMENTID != null ? itemData.DEPARTMENTID : 0, text: itemData.DEPARTMENT }));
                                $("#hdnDeptId").val(itemData.DEPARTMENTID != null ? itemData.DEPARTMENTID : 0);
                                select_ddlSec.append($('<option />', { value: itemData.SECTIONID != null ? itemData.SECTIONID : 0, text: itemData.SECTION }));
                                $("#hdnSectionId").val(itemData.SECTIONID != null ? itemData.SECTIONID : 0);
                            });
                        }
                        else {
                            $("#hdnOpId").val(0); $("#hdnDivId").val(0);
                            $("#hdnDeptId").val(0); $("#hdnSectionId").val(0);
                            select_ddlOp.append($('<option />', { value: "0", text: "--No record--" }));
                            select_ddlDiv.append($('<option />', { value: "0", text: "--No record--" }));
                            select_ddlDep.append($('<option />', { value: "0", text: "--No record--" }));
                            select_ddlSec.append($('<option />', { value: "0", text: "--No record--" }));
                        }
                    });
            }
            else {
                select_ddlOp.empty(); select_ddlDiv.empty(); select_ddlDep.empty(); select_ddlSec.empty();
                select_ddlOp.append($('<option />', { value: "0", text: "--Select Ki First--" }));
                select_ddlDiv.append($('<option />', { value: "0", text: "--Select--" }));
                select_ddlDep.append($('<option />', { value: "0", text: "--Select--" }));
                select_ddlSec.append($('<option />', { value: "0", text: "--Select--" }));
            }
        };

        function AddRemarkClick(A00Id) {
            debugger;
            $("#txtRemark").val('');
            $("#hdnA00DTLTBID").val(A00Id);
            $('#myModal').modal({ backdrop: "static" });
        }
        function SaveData() {
            var isFormVaildation = CheckFormValidation();
            if (isFormVaildation) {
                $.ajax({
                    type: "POST",
                    url: "/A00Submit/AddRemark",
                    data: JSON.stringify({ A00ID: $('#hdnA00DTLTBID').val(), REMARK: $.trim($("#txtRemark").val()) }),
                    contentType: "application/json; charset=utf-8",
                    // contentType: "application/x-www-form-urlencoded; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        $('#myModal').modal('hide');
                        if (data == 1) {
                            swal({
                                title: "",
                                text: "Record saved successfully.",
                                type: "success",
                            })
                        }
                        else {
                            sweetAlert("", "Record not saved.", "warning");
                        }
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function CheckFormValidation() {
            var isVailed = true;
            debugger;
            $("#txtRemark").removeClass('validationError');
            if ($.trim($('#txtRemark').val()) == "") {
                $("#txtRemark").addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }
        function ViewRemarkClick(A00Id) {
            //debugger;
            $("#hdnViewA00DTLTBID").val(A00Id);
            $.ajax({
                type: "GET",
                url: "/A00Submit/GetRemark",
                data: { A00ID: $('#hdnViewA00DTLTBID').val() },
                success: function (data) {
                    var rows = "", rowId = 0;
                    $.each(data, function (i, item) {
                        //debugger;
                        rowId = i + 1;
                        rows += "<tr class='tr_doc'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.stringAddedDate + "</td><td class='text-center'>" + item.ADDEDBY + " [" + item.FIRSTNAME + " " + item.LASTNAME + "]" + "</td><td class='text-center'>" + item.REMARKS + "</td>"
                        rows += "</tr>"
                    });
                    if (rowId == 0) {
                        rows += "<tr class='tr_doc'><td colspan='4' class='text-center'>" + " No Record Found" + "</td>"
                        rows += "</tr>"
                    }
                    document.getElementById("tbody_append").innerHTML = rows;
                    $('#myViewModal').modal({ backdrop: "static" });
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
    </script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        function closepopup() {
            $('#myModal').modal('hide');
            $(document.body).removeClass('modal-open');
            $('.modal-backdrop').remove();
        }

        function popup(dtltbid) {
            $("#myModal").modal('show');
            $('#hdnA00DTLTBID').val(dtltbid);
        }
        function closeViewRemarkpopup() {
            $('#myViewModal').modal('hide');
            $(document.body).removeClass('modal-open');
            $('.modal-backdrop').remove();
        }
    </script>

