@model ePortal.ViewModels.A00ViewModel
@{
    ViewBag.Title = "A00 Search";
    Layout = "~/Views/Shared/_LayoutA00.cshtml";
}
@section Styles {
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .tbl_cls1 {
            /*border: groove;*/
            padding-top: 07px;
            text-align: right;
            padding-right: 05px;
        }

        .tbl_cls2 {
            /*border: groove;*/
            padding-top: 07px;
            text-align: left;
            padding-left: 05px;
        }

        .font-size {
            font-size: 68% !important;
        }
        /*.btn_disable {
                                        pointer-events: none;
                                        opacity: 0.9;
                                        background: #ccc;
                                        border-color: rgba(0, 0, 0, 0.4);
                                        color: black;
                                    }*/

        .tcat {
            BACKGROUND: url(../images/tablebg.gif) #80a9ea repeat left bottom;
            background-size: 3px;
        }
    </style>

    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .search-elements-border {
            border: 0.5px;
            border-style: groove;
