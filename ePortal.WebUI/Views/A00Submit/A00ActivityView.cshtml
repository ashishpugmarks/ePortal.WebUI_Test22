@model ePortal.ViewModels.A00AcitivtyVM

@{
    ViewBag.Title = "View Activity";
    Layout = "~/Views/Shared/_LayoutA00.cshtml";
}
@section Styles{

    <link rel="stylesheet" href="~/css/jquery-ui.css">
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .fileUpload input[type=file] {
            display: none;
        }

        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .multiselect dropdown-toggle btn btn-default {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            /*.text-right {
                text-align: right;
                vertical-align: middle;
                width: 20%;
                font-size: 14px;
                font-family: roboto-bold;
                color: #000000;
            }*/

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .tcat {
            BACKGROUND: url(../images/tablebg.gif) #80a9ea repeat left bottom !important;
            background-size: 3px !important;
        }
    </style>

}

<div class="row">

    @using (Html.BeginForm())
    {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary("", new { @class = "text-danger" })

    <div class="body-content" style="overflow-x:hidden">
        <div id="msform">
            <input type="hidden" id="hdnA00ActivityID" name="hdnA00ActivityID" value="@ViewBag.A00ActivityID" />
            <table class="table table-responsive table-bordered table-condensed table-striped" style="border-color: #CCDCE0; border-width: 1px; border-style: solid; margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;" width="100%">
                <tbody>
                    <tr>
                        <td class="text-right" style="width:30%;">
                            <b>Activity Name</b> <span class="mandatory" style="color:red;">*</span>
                        </td>
                        <td>
                            @Html.TextBoxFor(m => m.ActivityName, new
                       {
                           @class = "form-control",
                           @maxlength = "100",
                           @disabled = "disabled"
                       })
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">
                            <b>Activity Details</b> <span class="mandatory" style="color:red;">*</span>
                        </td>
                        <td>
                            @Html.TextAreaFor(m => m.ActivityDetails, new
                       {
                           @class = "form-control",
                           @maxlength = "500",
                           @disabled = "disabled"
                       })
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">
                            <b>Activity Start Date</b> <span class="mandatory" style="color:red;">*</span>
                        </td>
                        <td>
                            @Html.TextBoxFor(m => m.ActivityStartDate, new
                       {
                           @class = "form-control",
                           @maxlength = "10",
                           @placeholder = "dd/mm/yyyy",
                           @autocomplete = "off",
                           @disabled = "disabled"
                       })
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">
                            <b>Activity End Date</b> <span class="mandatory" style="color:red;">*</span>
                        </td>
                        <td>
                            @Html.TextBoxFor(m => m.ActivityEndDate, new
                       {
                           @class = "form-control",
                           @maxlength = "10",
                           @placeholder = "dd/mm/yyyy",
                           @autocomplete = "off",
                           @disabled = "disabled"
                       })  @*Dinesh*@
                    <label id="ActivityEndDate-error" class="error" for="ActivityEndDate"></label>
                </td>
            </tr>
            <tr>
                <td class="text-right"><b>Activity Update History</b></td>
                <td colspan="5">
                    @if (ViewBag.ActivityHistoryDetails != null)
                        {
                    <div style="width:100%;display: inline-flex;align-items: center;">
                        <table class="table" style="font-size:13px; border: 1px solid #dddddd;">
                            <tr class="tcat">
                                <th style="border: 1px solid #dddddd; text-align:center; width:3%;">@Html.DisplayName("SNo")</th>
                                <th style="border: 1px solid #dddddd; text-align:center; width:5%;">@Html.DisplayName("Action By")</th>
                                <th style="border: 1px solid #dddddd; text-align:center; width:5%;">@Html.DisplayName("Action On")</th>
                                <th style="border: 1px solid #dddddd; width:12%;text-align:center">@Html.DisplayName("Remarks")</th>
                                <th style="border: 1px solid #dddddd; width:12%;text-align:center">@Html.DisplayName("Status")</th>
                            </tr>
                            @if (ViewBag.ActivityHistoryDetails.Count > 0)
                                    {
                                        int i = 1;
                                        foreach (var item in ViewBag.ActivityHistoryDetails)
                                        {
                            <tr>
                                <td style="border: 1px solid #dddddd;text-align:center;">@i</td>
                                <td style="border: 1px solid #dddddd;text-align:center;">@item.FIRSTNAME @item.LASTNAME</td>
                                <td style="border: 1px solid #dddddd;text-align:center;">
                                    @if (item.ActionOn != null)
                                                    {
                                    @item.ActionOn.ToString("dd/MM/yyyy")
                                                    }
                                </td>
                                <td style="border: 1px solid #dddddd;text-align:center;">@item.Remarks</td>
                                @{ var Status = "";}
                                @if (item.ActivitySchedule == 1)
                                                {
                                                    Status = "In Process";
                                                }
                                                else if (item.ActivitySchedule == 2)
                                                {
                                                    Status = "Completed";
                                                }
                                                else
                                                {
                                                    Status = "Not Started";
                                                }
                                <td style="border: 1px solid #dddddd;text-align:center;">@Status</td>
                            </tr>
                                            i++;
                                        }
                                    }
                                    else
                                    {
                            <tr>
                                <td colspan="5">Activity Pending</td>
                            </tr>
                                    }
                        </table>

                    </div>
                        }
                </td>
            </tr>
        </tbody>
    </table>

</div>
</div>

}
    <br />
    <table class="table table-bordered table-hover table-responsive" style="margin-top:10px;">
        <tr style="background-color:#f3f3f3">
            <td style="height: 20px;font-size: 14px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td colspan="4">
                                <!--Changed By Eshant to close current Tab 06-Jul-2022 -->
                                <!-- <a title="Back" href="javascript:void(0);" onclick="window.location = document.referrer;">-->

                                <a title="Back" href="#" data-ctrl="btn-back">
                                    <img src="~/images/icon_back.gif" border="0" alt="">
                                    Back
                                </a>
                            </td>

                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>


@section  scripts{
    @* @Scripts.Render("~/bundles/jqueryval") *@
    <script src="~/js/jquery.validate.min.js"></script>
    <script type="text/javascript" language="Javascript" src="~/js/jquery-ui.min.js"></script>
    @* <script src="~/lib/bootstrap/js/bootstrap.js"></script> *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('#btnSubmit').on('click', function () {
            $('form').validate();
            if ($('form').valid())
                $(this).button('loading') // button text will be "finished!"
        });
        $(document).ready(function () {
            $("#ActivitySchedule").val(@ViewBag.ActivitySchedule);
        });
    </script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        var msg = '@ViewBag.Msg';
        if (msg.length) {
            alert(msg);
        }
    </script>



@*CSP 3.0 Compliant Changes*@

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
    $(document).ready(function () {
        $('[data-ctrl="btn-back"]').on('click', function (e) {
            e.preventDefault();
            window.top.close();
        });
    });
</script>
}