@model ePortal.ViewModels.A00ViewModel
@{
    ViewBag.Title = "New A00";
    Layout = "~/Views/Shared/_LayoutA00.cshtml";
}

@{
    TempData["serach"] = "yes";

}
@section Styles{
<link rel="stylesheet" href="~/css/jquery-ui.css">
<link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap-multiselect.css">
<link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />
<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    .fileUpload input[type=file] {
        display: none;
    }

    .btn {
        background-color: #e3e3e3;
        color: #333;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
        font-size: 16px;
        width: 329px !important;
    }

    .bttn {
        background-color: #e3e3e3;
        color: #333;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
        font-size: 16px;
    }

    .dropdownt {
        width: 326px !important;
    }

    .multiselect dropdown-toggle btn btn-default {
        width: 326px !important;
    }

    .resr {
        font-weight: bold;
        background-color: #C3E214;
        border-radius: 5px;
        border: 2px solid #ccc;
        text-align: center;
        padding: 5px 15px;
        width: 120px;
        font-size: 12px;
    }

    .CS {
        background-color: #abcdef;
        color: Yellow;
        border: 1px solid #AB00CC;
        font: Verdana 10px;
        padding: 1px 4px;
        font-family: Roboto-Regular;
    }

    * {
        box-sizing: border-box;
    }

    .dropdown-check-list {
        display: inline-block;
    }

        .dropdown-check-list .anchor {
            position: relative;
            cursor: pointer;
            display: inline-block;
            padding: 5px 50px 5px 10px;
            border: 1px solid #ccc;
        }

            .dropdown-check-list .anchor:after {
                position: absolute;
                content: "";
                border-left: 2px solid black;
                border-top: 2px solid black;
                padding: 5px;
                right: 10px;
                top: 20%;
                -moz-transform: rotate(-135deg);
                -ms-transform: rotate(-135deg);
                -o-transform: rotate(-135deg);
                -webkit-transform: rotate(-135deg);
                transform: rotate(-135deg);
            }

            .dropdown-check-list .anchor:active:after {
                right: 8px;
                top: 21%;
            }

    dropdown-check-list ul.items {
        padding: 2px;
        display: none;
        margin: 0;
        border: 1px solid #ccc;
        border-top: none;
        width: 370px !important;
    }

    .dropdown-check-list ul.items li {
        list-style: none;
    }

    .dropdown-check-list.visible .anchor {
        color: #0094ff;
    }

    .dropdown-check-list.visible .items {
        display: block;
    }

    .cellpadding {
        padding: 5px 5px;
    }

    .form-wrapper {
        margin-top: 20px;
    }

    .spret {
        border: 1px solid #ccc;
    }

    .form-label {
        color: #000;
        font-size: 10px;
    }

    .form-input {
        font-size: 13px;
        padding: 2px 5px;
        border: 1px solid #ccc;
        width: 220px !important;
    }

    .field-indicator {
        color: #F00;
        vertical-align: middle;
    }

    .multiselect-container > li > a {
        padding: 0px;
        width: 320px !important;
    }

    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    .bttn {
        background-color: #e3e3e3;
        color: #333;
        border: 1px solid #e6e6e6;
        border-radius: 3px;
        padding: 6px 12px;
        font-size: 16px;
    }
</style>
}

@{
    TempData.Keep("status");
}

<div class="row">
    @using (Html.BeginForm("NewA00", "A00Submit", FormMethod.Post, new { encType = "multipart/form-data" }))
    {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary("", new { @class = "text-danger" })
    @Html.HiddenFor(x => x.A00DTLTBID)
    <div class="body-content" style="overflow-x:hidden">
        <div id="msform">

            <table style="width:100%; display:none" id="tblmsg" border="1">
                <tr id="errorPanel">
                    <td colspan="2" style="width:100%;">
                        <table style="width: 100%; margin-bottom: 5px;">
                            <tr>
                                <td align="left" valign="top">
                                    <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                        <tbody>
                                            <tr class="errorbox">
                                                <td style="vertical-align: middle;">
                                                    <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                        <tr>
                                                            <td style="vertical-align: middle; text-align: center; width: 2%;">

                                                                <img src="~/images/icon_error.gif" border="0" alt="" />
                                                            </td>
                                                            <td class="errorbox col-md-12" style="vertical-align: middle; text-align: left;">

                                                                &nbsp;@Html.Label("ErrorStatus", "Test Error", new { id = "ErrorStatus", @class = "smalltext" })
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>


            <table class="table table-bordered table-hover table-responsive">
                <tbody>
                    <tr>
                        <td class="text-right">
                            <b>Project title <span style="color: #ff0000">*</span></b>
                        </td>
                        <td class="col-md-3">
                            <div class="col-md-12">
                                @if (ViewBag.pageType == "VIEW")
                                {
                                @Html.TextBoxFor(m => m.Projecttitle,
                                new
                                {
                                @class = "form-control",

                                disabled = "disabled"
                                })
                                }
                                else
                                {
                                @Html.TextBoxFor(m => m.Projecttitle, new
                                {
                                @class = "form-control",

                                })
                                }
                            </div>
                        </td>

                        <td class="text-right">
                            <b>Budgeted(Y/N)<span style="color: #ff0000">*</span></b>
                        </td>
                        <td>
                            <div class="col-md-12">

                                @if (ViewBag.pageType == "VIEW")
                                {
                                @Html.DropDownListFor(model => model.Budgeted, (IEnumerable<SelectListItem>
                                    )ViewBag.BudgetedValue,
                                    new { @class = "form-control input", @disabled = "disabled" })
                                    }
                                    else
                                    {
                                    @Html.DropDownListFor(model => model.Budgeted,
                                    (IEnumerable<SelectListItem>
                                        )ViewBag.BudgetedValue, new { @class = "form-control input" })
                                        }
                            </div>
                        </td>

                        <td class="text-right">
                            <b>ki<span style="color: #ff0000">*</span></b>
                        </td>
                        <td>
                            <div class="col-md-12">
                                @if (ViewBag.pageType == "VIEW")
                                {
                                @Html.DropDownList("KICODE", ViewBag.SKY as SelectList, new
                                {
                                @class = "form-control input",

                                @disabled = "disabled"
                                })

                                }
                                else
                                {
                                if (ViewBag.selectedBudgetedVal == "0")
                                {
                                @Html.DropDownList("KICODE", ViewBag.SKY as SelectList, new
                                {
                                @class = "form-control input",

                                id = "KICODE",
                                @disabled = "disabled"
                                })
                                }
                                else
                                {
                                @Html.DropDownList("KICODE", ViewBag.SKY as SelectList, new
                                {
                                @class = "form-control input",

                                id = "KICODE"
                                })
                                }
                                }
                            </div>
                        </td>
                    </tr>


                    <tr>
                        <td class="text-right"><b>Background & Situation Analysis<span style="color: #ff0000">*</span></b></td>
                        <td class="col-md-3">
                            <div class="col-md-12">
                                @if (ViewBag.pageType == "VIEW")
                                {
                                @Html.TextAreaFor(m => m.Backgrounds, 1, 1,
                                new
                                {
                                @class = "form-control",
                                @rows = "1",
                                @style = "margin: 0px; height: 115px; width: 319px;",
                                @maxlength = "500",
                                disabled = "disabled"
                                })
                                }
                                else
                                {
                                @Html.TextAreaFor(m => m.Backgrounds, 1, 1, new
                                {
                                @class = "form-control",
                                @rows = "1",
                                @style = "margin: 0px; height: 115px; width: 319px;",
                                @maxlength = "500"
                                })
                                }


                            </div>
                        </td>

                        <td class="text-right"><b>Business Target<span style="color: #ff0000">*</span></b> </td>
                        <td>
                            <div class="col-md-6" style="padding-right: 0px;">
                                start date
                                @if (ViewBag.pageType == "VIEW")
                                {
                                <input type="text" id="start" name="start" readonly="readonly" placeholder="dd/mm/yyyy" class="form-control"
                                       value="@Model.StartDate" disabled />

                                }
                                else
                                {

                                <input type="text" id="start" name="start" value="@Model.StartDate" readonly="readonly" class="form-control"
                                       placeholder="dd/mm/yyyy" />

                                }


                            </div>
                            <div class="col-md-6" style="padding-right: 0px;">

                                end date
                                @if (ViewBag.pageType == "VIEW")
                                {
                                <input type="text" id="end" name="end" readonly="readonly" placeholder="dd/mm/yyyy" class="form-control"
                                       value="@Model.EndDate" disabled />
                                }
                                else
                                {
                                <input type="text" id="end" name="end" readonly="readonly" value="@Model.EndDate" placeholder="dd/mm/yyyy" class="form-control" />
                                }
                            </div>
                        </td>

                        <td class="text-right col-md-1">

                            <b> Budgeted by</b>
                            <span style="color: #ff0000">*</span>
                        </td>
                        <td colspan="3">
                            <div class="col-md-12">
                                @if (ViewBag.pageType == "VIEW")
                                {
                                @Html.DropDownList("LEVELDESCRIP", ViewBag.List as SelectList, new
                                {
                                @class = "form-control input",

                                @disabled = "disabled"
                                })
                                }
                                else
                                {

                                if (ViewBag.selectedBudgetedVal == "0")
                                {
                                @Html.DropDownList("LEVELDESCRIP", ViewBag.List as SelectList, new
                                {
                                @class = "form-control input",

                                id = "LEVELDESCRIP",
                                @disabled = "disabled"
                                })
                                }
                                else
                                {
                                @Html.DropDownList("LEVELDESCRIP", ViewBag.List as SelectList, new
                                {
                                @class = "form-control input",

                                id = "LEVELDESCRIP"
                                })
                                }
                                }


                            </div>
                        </td>

                    </tr>

                    <tr>
                        <td class="text-right"><b>Business KPI(Key Performance Indicator)<span style="color: #ff0000">*</span></b> </td>
                        <td class="col-md-3">
                            <div class="col-md-12">
                                @if (ViewBag.pageType == "VIEW")
                                {
                                @Html.TextAreaFor(m => m.BusinessKPI, 1, 1, new
                                {
                                @class = "form-control",
                                @maxlength = "300",
                                disabled = "disabled"
                                })
                                }
                                else
                                {
                                @Html.TextAreaFor(m => m.BusinessKPI, 1, 1, new
                                {
                                @class = "form-control",
                                @maxlength = "300"
                                })
                                }
                            </div>
                        </td>

                        <td class="text-right">
                            <b>Investment Effect Forecast<span style="color: #ff0000">*</span></b>
                        </td>
                        <td>

                            <div class="col-md-12">
                                @if (ViewBag.pageType == "VIEW")
                                {
                                int i = 0;
                                foreach (var item in ViewBag.SKYLIST)
                                {
                                if (i != 0)
                                {

                                <br />
                                <label class="text-info" style="text-align: right; vertical-align: middle; font-size:12px; font-weight: inherit;">@item.Text</label>
                                }
                                else
                                {
                                <label class="text-info" style="text-align: right; vertical-align: middle; font-size:12px; font-weight: inherit;">@item.Text</label>
                                }
                                i++;
                                }
                                }
                                else
                                {
                                if (ViewBag.SKYLIST != null)
                                {

                                <select id="SKYLIST" multiple="multiple" name="SKYLIST" class="form-control dropdownt">
                                    @foreach (var item in ViewBag.SKYLIST)
                                    {
                                    if (item.Text != null)
                                    {
                                    <option value="@item.Value" selected="@item.Selected"> @item.Text</option>
                                    }
                                    }
                                </select>
                                }
                                }

                            </div>
                        <td class="text-right">
                            <b>If Others<span style="color: #ff0000">*</span></b>
                        </td>
                        <td id="trIfAny">
                            <div class="col-md-12">

                                @Html.TextBoxFor(m => m.Ifothers, new
                                {
                                @class = "form-control",
                                @maxlength = "100",
                                @disabled = "disabled"

                                })

                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right"><b>A00 Purpose<span style="color: #ff0000">*</span></b> </td>
                        <td colspan="5">
                            <div class="col-md-12">

                                @if (ViewBag.pageType == "VIEW")
                                {
                                @Html.TextAreaFor(m => m.PurposeA00, new { @class = "form-control", @maxlength = "500", disabled = "disabled" })
                                }
                                else
                                {
                                @Html.TextAreaFor(m => m.PurposeA00, new { @class = "form-control", @maxlength = "500" })
                                }
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right"><b>A00-Target<span style="color: #ff0000">*</span></b> </td>
                        <td colspan="5">
                            <div class="col-md-12">
                                @if (ViewBag.pageType == "VIEW")
                                {
                                @Html.TextBoxFor(m => m.TargetA00, new
                                {
                                @class = "form-control",

                                @maxlength = "200",
                                disabled = "disabled"
                                })
                                }
                                else
                                {
                                @Html.TextBoxFor(m => m.TargetA00, new { @class = "form-control", @maxlength = "200" })
                                }
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right"><b>A00-Requirement<span style="color: #ff0000">*</span></b>  </td>
                        <td colspan="5">
                            <div class="col-md-12">
                                @if (ViewBag.pageType == "VIEW")
                                {
                                @Html.TextBoxFor(m => m.RequirmentA00, new { @class = "form-control", @maxlength = "500", disabled = "disabled" })
                                }
                                else
                                {
                                @Html.TextBoxFor(m => m.RequirmentA00, new { @class = "form-control", @maxlength = "500" })
                                }
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">
                            <b>AS IS & TO BE Process</b><span style="color: #ff0000">*</span>
                            <br />
                            <span style="color:red;" class="form-inline">(Only PDF file allowed.)</span>
                        </td>
                        <td colspan="6">
                            <div class="col-md-12" style="padding-right: 0px;">
                                @if (ViewBag.pageType == "VIEW")
                                {
                                <a href="@Url.Action(" DownloadFile", "A00Submit" , new { FileName=@Model.ImagePath})" class="btn btn-warning">
                                    Download
                                    <span class="glyphicon glyphicon-download" aria-hidden="true"></span>
                                </a>
                                }
                                else
                                {
                                if (Model.ImagePath != "" && Model.ImagePath != null)
                                {
                                <table style="width:100%" border="1">
                                    <tr>
                                        <td style="width:90%; padding-top: 20px; padding-bottom: 20px; padding-left: 10px;">
                                            <input name="ImageFile" id="ImageFile" type="file" accept=".pdf" />
                                        </td>
                                        <td>
                                            <a href="@Url.Action(" DownloadFile", "A00Submit" , new { FileName=@Model.ImagePath })" class="btn btn-warning">
                                                Download
                                                <span class="glyphicon glyphicon-download" aria-hidden="true"></span>
                                            </a>
                                        </td>
                                    </tr>
                                </table>
                                <input type="hidden" id="isFileExist" name="isFileExist" value="Y" />
                                }
                                else
                                {
                                <input name="ImageFile" id="ImageFile" type="file" accept=".pdf" style="padding-top: 20px;" />
                                <input type="hidden" id="isFileExist" name="isFileExist" value="N" />
                                }
                                }
                            </div>


                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td colspan="6">
                            <b>Note:</b>
                            <b style="color:blue; padding-top: 20px;font-style: italic;">
                                AS IS & TO BE process signed by Operating Head to be attached and Divisional
                                level explanation meeting need to be called by the initiator.
                            </b>


                        </td>
                    </tr>

                    @if (ViewBag.ApprovalHistory != null)
                    {
                    <tr>
                        <td colspan="6">
                            <div style="width:100%;display: inline-flex;align-items: center;">

                                <div style="width:15%; font-size:14px; font-family: roboto-bold;text-align: right;padding-right: 20px;" class="text-info">Approval History:</div>

                                <table class="table" style="font-size:13px;border:groove;width:85%;margin-bottom: 0;">
                                    <tr style="background-color: #fdf59a;">
                                        <td></td>
                                        <th scope="col" style="border:groove; width:20%;">Dept.Head</th>
                                        <th scope="col" style="border:groove; width:20%;">Coordinator</th>
                                        <th scope="col" style="border:groove; width:20%;">Div. Head</th>
                                        <th scope="col" style="border:groove; width:20%;">Ex. Coordinator</th>
                                        <th scope="col" style="border:groove; width:20%;">Operating Head</th>
                                    </tr>
                                    @foreach (var item in ViewBag.ApprovalHistory)
                                    {
                                    <tr>

                                        <th scope="row" style="background-color: #fdf59a;">Name</th>
                                        <td>@item.DeptHeadName</td>
                                        <td>@item.CoOrdName</td>
                                        <td>@item.DivHeadName</td>
                                        <td>@item.ExeCoOrdName</td>
                                        <td>@item.OpHeadName</td>
                                    </tr>
                                    <tr>
                                        <th scope="row" style="background-color: #fdf59a;">Approval Date</th>
                                        <td>
                                            @if (item.DEPTHDAPPDATE != null)
                                            {
                                            @item.DEPTHDAPPDATE.ToString("dd/MM/yyyy")
                                            }
                                        </td>
                                        <td>
                                            @if (item.COORDAPPDATE != null)
                                            {
                                            @item.COORDAPPDATE.ToString("dd/MM/yyyy")
                                            }
                                            @*@item.COORDAPPDATE.ToString("dd/MM/yyyy")*@
                                        </td>
                                        <td>
                                            @if (item.DIVHDAPPDATE != null)
                                            {
                                            @item.DIVHDAPPDATE.ToString("dd/MM/yyyy")
                                            }

                                        </td>
                                        <td>
                                            @if (item.EXECOAPPDATE != null)
                                            {
                                            @item.EXECOAPPDATE.ToString("dd/MM/yyyy")
                                            }

                                        </td>
                                        <td>
                                            @if (item.OHAPPDATE != null)
                                            {
                                            @item.OHAPPDATE.ToString("dd/MM/yyyy")
                                            }
                                            @*@item.OHAPPDATE.ToString("dd/MM/yyyy")*@
                                        </td>
                                    </tr>
                                    <tr>
                                        <th scope="row" style="background-color: #fdf59a;">Remarks</th>
                                        <td>@item.DEPTHDAPPTXT</td>
                                        <td>@item.COORDAPPTXT</td>
                                        <td>@item.DIVHDAPPTXT</td>
                                        <td>@item.EXECOAPPTXT</td>
                                        <td>@item.OHAPPTXT</td>
                                    </tr>
                                    }
                                </table>

                            </div>

                        </td>
                    </tr>
                    }

                    @if (ViewBag.actionType == "Approval")
                    {



                    <tr>
                        <td class="text-right"><b>Approver Remarks<span style="color: #ff0000">*</span></b>  </td>
                        <td colspan="5">
                            <div class="col-md-12">
                                @Html.TextBoxFor(m => m.Remarks, new
                                {
                                name = "remarks",
                                @class = "form-control",


                                @maxlength = "190"
                                })
                            </div>
                        </td>
                    </tr>



                    }
                    <tr>
                        <td colspan="6" style="text-align:center;">
                            <div class="col-md-12" style="align-items: center;">
                                @if (ViewBag.actionType == "Submit")
                                {
                                <input type="submit" class="bttn btn-success btn_disable" value="Submit" id="btnSubmit"
                                       name="btnSubmit" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />


                                <input type="submit" value="Save as Draft" class="bttn btn-success btn_disable"
                                       name="btnSaveDraft" id="btnSaveAsDraft"
                                       style="background-color: #ccc; border-color: #4e4e4e; align-items: center; width: 10%;color: #232121;font-weight : bold ;" />

                                <input value="Reset" type="button" class="bttn btn-success btn_disable" name="btnReset"
                                       id="btnReset" style="background-color: #ccc; border-color: #4e4e4e; align-items: center;width: 10%;color: #232121;font-weight : bold ;" />

                                <input type='button' id='btnBack' class="bttn btn-success btn_disable"
                                       style="background-color: #ccc;width: 10%;color: #232121; font-weight : bold ;
                                    border-color: #4e4e4e;" value='Back' />
                                }

                                @if (ViewBag.actionType == "Approval")
                                {
                                <input type="submit" value="Approve" class="bttn btn-success btn_disable"
                                       name="btnApprove" id="btnApprove" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />

                                <input type="submit" class="bttn btn-success" value="Send Back"
                                       id="btnSendBack" name="btnSendBack" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />

                                <input value="Reject" type="submit" class="bttn btn-success"
                                       name="btnReject" id="btnReject" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />

                                <input type='button' id='btnBack' class="bttn btn-success btn_disable"
                                       style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" value='Back' />

                                }

                            </div>

                            <input type="hidden" id="hdnOPERATIONID" name="hdnOPERATIONID" value="@ViewBag.OPERATIONID" />
                            <input type="hidden" id="hdnDIVISIONID" name="hdnDIVISIONID" value="@ViewBag.DIVISIONID" />
