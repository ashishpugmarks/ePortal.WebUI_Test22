@model ePortal.ViewModels.A00ViewModel
@{
    ViewBag.Title = "IT Confirmation Approval Request";
    Layout = "~/Views/Shared/_LayoutA00.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/jquery-ui.css">
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .tbl_cls1 {
            /*border: groove;*/
            padding-top: 07px;
            text-align: right;
            padding-right: 05px;
        }

        .tbl_cls2 {
            /*border: groove;*/
            padding-top: 07px;
            text-align: left;
            padding-left: 05px;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .font-size {
            font-size: 70% !important;
        }
    </style>
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .search-elements-border {
            border: 0.5px;
            border-style: groove;
            height: 24px;
        }

        .right-alignment {
            text-align: right;
        }

        .ddl-width-hight {
            width: 70%;
            height: 16px;
        }

        .padding-zero {
            padding: 0;
        }

        .height-16px {
            height: 16px;
        }

        .margin-1px {
            margin: 4px;
        }

        .bg-color-blue {
            background-color: #BBCDEC;
        }

        .tcat {
            BACKGROUND: url(../images/tablebg.gif) #80a9ea repeat left bottom;
            background-size: 3px;
        }
        /*Change start on 22-July-2021*/
        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            /*Change end on 22-July-2021*/
        }

        .validationError {
            border: 1px solid #a94442;
        }

        .modal-body {
            max-height: calc(100vh - 200px);
            overflow-y: auto;
        }
    </style>

}

<div class="row">
    <input type="hidden" id="hdnva" value="0" />
    <input type="hidden" id="hdnopval" value="0" />
    <input type="hidden" id="hdnoptext" value="" />
    @using (Html.BeginForm("ITConfirmationApprovalRequest", "A00Submit", FormMethod.Post))
    {
        <div class="form-group">
            <table class="table table-bordered table-hover table-responsive">
                <tr>
                    <td class="tbl_cls1"><label for="Ki" class="font-size">Ki </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownList("SearchParams.SYKI", ViewBag.SYKIData as SelectList, "All Ki", new { @class = "form-control", @data_ctrl = "syki-dropdown" })
                    </td>
                    <td class="tbl_cls1"><label for="EmpCode" class="font-size">Emp Code/Name </label></td>
                    <td class="tbl_cls2">
                        <div class="col col-md-3 col-lg-3">
                            @Html.TextBoxFor(model => model.SearchParams.ECode, new { id = "empCode", @class = "form-control", @placeholder = "Code" })
                        </div>
                        <div class="col col-md-offset-1 col-lg-offset-1 col-md-8 col-lg-8">
                            @Html.TextBoxFor(model => model.SearchParams.EmpName, new { id = "empName", @class = "form-control", @placeholder = "Name" })
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="tbl_cls1"><label for="Operation" class="font-size">Operation </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownListFor(model => model.SearchParams.OPERATIONID, (IEnumerable<SelectListItem>)ViewBag.OpList, "- Select -", new { @id = "ddlOp", @class = "form-control" })
                    </td>
                    <td class="tbl_cls1"><label for="Division" class="font-size">Division </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownListFor(model => model.SearchParams.DIVISIONID, (IEnumerable<SelectListItem>)ViewBag.DivList, "- Select -", new { @id = "ddlDiv", @class = "form-control" })
                    </td>
                </tr>
                <tr style="background-color:#f3f3f3">
                    <td style="height:45px;" class="tbl_cls1"><label for="Department" class="font-size">Department </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownListFor(model => model.SearchParams.DEPARTMENTID, (IEnumerable<SelectListItem>)ViewBag.DepList, "- Select -", new { @id = "ddlDep", @class = "form-control" })
                    </td>
                    <td class="tbl_cls1"><label for="Section" class="font-size">Section </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownListFor(model => model.SearchParams.SECTIONID, (IEnumerable<SelectListItem>
                                 )ViewBag.SecList, "- Select -",
                                 new { @id = "ddlSec", @class = "form-control" })
                    </td>
                </tr>

                <tr style="background-color:#f3f3f3">
                    <td style="height:45px;" class="tbl_cls1"><label for="Status" class="font-size">IT Confirmation Status </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownList("SearchParams.Status", ViewBag.StatusList as SelectList, new { @class = "form-control" })
                    </td>
                </tr>
                <tr>
                    <td style="height:45px; text-align:center; padding-top:07px;" colspan="4">
                        <button type="submit" id="btnSearch" data-loading-text="Searching..." autocomplete="off" class="btn-xs btn-primary clickcls" style="width:90px; height:30px; background-color: #ccc; border-color: #4e4e4e; color: #0c0c0c;">
                            Search
                        </button>
                        &nbsp; &nbsp; &nbsp;
                        <button type="button" class="btn-xs btn-primary" id="CancelBtnClick"
                                style="width:90px; height:30px; background-color: #ccc; border-color: #4e4e4e; color: #0c0c0c;">
                            Cancel
                        </button>
                        @Html.Hidden("hdnIsITDivisionHead", (object)Convert.ToString(ViewBag.List[0].isITDivisionHead))
                    </td>
                </tr>
            </table>
        </div>
    }

    @if (Model != null)
    {
        <div id="searchResults">
            <table class="table table-responsive table-bordered table-hover" style="font-size:13px;">
                <tr class="tcat">
                    <th style="border: 1px solid #dddddd; text-align:center; width:3%;">S.No</th>
                    <th style="border: 1px solid #dddddd; text-align:center; width:5%;">@Html.DisplayName("Ki")</th>
                    <th style="border: 1px solid #dddddd; text-align:center; width:10%;">@Html.DisplayName("Operation")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Project Code")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Project Title")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("A00 Approval Date")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("A00 Assigned Date")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("IT Confirmation Date")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("IT Confirmation Vs A00 Approval")</th>
                    <th style="border: 1px solid #dddddd; width:6%;text-align:center">@Html.DisplayName("View")</th>
                    <th style="border: 1px solid #dddddd; width:6%;text-align:center">@Html.DisplayName("Action")</th>
                    <th style="border: 1px solid #dddddd; width:6%;text-align:center">@Html.DisplayName("Remark")</th>
                </tr>
                @if (Model.ResultList.Count > 0)
                {
                    int i = 1;
                    foreach (var item in Model.ResultList)
                    {
                        var DaysDiffBetA00ApprovalAndITConfirmation = item.ITConfirmationDate != null ? (Convert.ToDateTime(item.ITConfirmationDate) - Convert.ToDateTime(item.A00ApprovedOn)).Days + " Days" : (DateTime.Now - Convert.ToDateTime(item.A00ApprovedOn)).Days + " Days";
                        <tr>
                            <td style="border: 1px solid #dddddd; text-align:center;">@i</td>
                            <td style="border: 1px solid #dddddd; text-align:center;">@Html.DisplayFor(ModelItem => item.KICODE)</td>
                            <td style="border: 1px solid #dddddd; text-align:center;">@Html.DisplayFor(ModelItem => item.OPERATION)</td>
                            <td style="border: 1px solid #dddddd; text-align:center;">@Html.DisplayFor(ModelItem => item.ProjectCode)</td>
                            <td style="border: 1px solid #dddddd; text-align:center;">@Html.DisplayFor(ModelItem => item.ProjectTitle)</td>
                            <td style="border: 1px solid #dddddd; text-align:center;">@Html.ValueFor(ModelItem => item.A00ApprovedOn, "{0:dd/MM/yyyy}")</td>
                            <td style="border: 1px solid #dddddd; text-align:center;">@Html.ValueFor(ModelItem => item.ApprovedOn, "{0:dd/MM/yyyy}")</td>
                            <td style="border: 1px solid #dddddd; text-align:center;">@Html.ValueFor(ModelItem => item.ITConfirmationDate, "{0:dd/MM/yyyy}")</td>
                            <td style="border: 1px solid #dddddd; text-align:center;">@Html.DisplayFor(ModelItem => DaysDiffBetA00ApprovalAndITConfirmation)</td>
                            <td style="border: 1px solid #dddddd; text-align:center;">
                                <a href='@Url.Action("ITDivisionView", "A00Submit", new
                                        {
                                            A00DTLTBID = item.A00DTLTBID,
                                            type = "View",
                                            OPERATIONID = Model.SearchParams.OPERATIONID,
                                            DIVISIONID = Model.SearchParams.DIVISIONID,
                                            DEPARTMENTID = Model.SearchParams.DEPARTMENTID,
                                            SECTIONID = Model.SearchParams.SECTIONID,
                                            SYKIID = Model.SearchParams.SYKIID,
                                            ECODE = Model.SearchParams.ECode,
                                            EMPNAME = Model.SearchParams.EmpName,
                                            STATUSID = Model.SearchParams.StatusId
                                        })' target="_blank" class="glyphicon glyphicon-eye-open"></a><!--Changed by eshant on 4-Jul-22-->
                            </td>
                            @if (item.UserId == item.MainPIC && item.ITConfirmationStatus == 9)
                            {
                                <td style="border:1px solid #dddddd;text-align:center;">
                                    <a href='@Url.Action("ITConfirmationSaveData", "A00Submit", new
                                        { A00DTLTBID = item.A00DTLTBID,
                                            SYKIID = Model.SearchParams.SYKIID
                                            })' class="glyphicon glyphicon-pencil"></a>
                                </td>
                            }
                            else if (item.UserId == item.ApproverUserId)
                            {
                                <td style="border: 1px solid #dddddd; text-align:center;">
                                    <a href='@Url.Action("ITConfirmationApproval", "A00Submit", new
                                        { A00DTLTBID = item.A00DTLTBID,
                                            SYKIID = Model.SearchParams.SYKIID
                                            })' class="glyphicon glyphicon-pencil"></a>
                                </td>
                            }
                            else
                            {
                                <td style="border: 1px solid #dddddd; text-align:center;">-</td>
                            }
                            <td>

                                <button class="glyphicon glyphicon-pencil" data-ctrl="add-remark" data-id="@item.A00DTLTBID"></button>
                                <button class="glyphicon glyphicon-eye-open" data-ctrl="view-remark" data-id="@item.A00DTLTBID"></button>

                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="12"> No record found.</td>
                    </tr>
                }
            </table>
        </div>
    }
    else
    {
        <div id="searchResults">
            <table class="table table-responsive table-bordered table-hover" style="font-size:13px;">
                <tr class="tcat">
                    <th style="border: 1px solid #dddddd; text-align:center; width:3%;">S.No</th>
                    <th style="border: 1px solid #dddddd; text-align:center; width:5%;">@Html.DisplayName("Ki")</th>
                    <th style="border: 1px solid #dddddd; text-align:center; width:10%;">@Html.DisplayName("Operation")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("E Code")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Name")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Project Title")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Request Date")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Approved By")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Approved Date")</th>
                    <th style="border: 1px solid #dddddd; width:6%;text-align:center">@Html.DisplayName("View")</th>
                    <th style="border: 1px solid #dddddd; width:6%;text-align:center">@Html.DisplayName("Action")</th>

                </tr>
                <tr>
                    <td colspan="12"> No record found.</td>
                </tr>
            </table>
        </div>
    }

    <table class="table table-bordered table-hover table-responsive">
        <tr style="background-color:#f3f3f3">
            <td style="height: 20px;font-size: 14px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td colspan="4">
                                <a title="Back" href="/home/home">
                                    <img src="~/images/icon_back.gif" border="0" alt="">
                                    Back
                                </a>
                            </td>

                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>
@*Change start on 22-July-2021*@
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div style="margin: 10px;">
                <input type="hidden" id="hdnA00DTLTBID" name="hdnA00DTLTBID" />
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4>Add Remark</h4>
                </div>
                <div class="modal-body body-content">
                    @* @Html.ValidationSummary(false, "", new { @class = "text-danger" }) *@
                    <span id="spnRemark"></span>
                    <div class="form-group">
                        <table class="table table-bordered table-hover table-responsive">
                            <tr>
                                <td class="tbl_cls1" style="text-align: center; vertical-align: middle;"><b>Remark<span style="color: #ff0000">*</span></b></td>
                                <td class="tbl_cls2">
                                    <textarea id="txtRemark" name="AddRemark" class="form-control" placeholder="Remarks" required title="Please enter remark."></textarea>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-md-12 center">
                            <button type="submit" id="btnAddRemark" data-loading-text="Submitting..." autocomplete="off" class="bttn btn-success" style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold; margin-top:10px;">Submit</button>
                            <button type="button" class="bttn btn-success" data-ctrl="close-popup" style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold;">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="myViewModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div style="margin: 10px;">
                <input type="hidden" id="hdnViewA00DTLTBID" name="hdnViewA00DTLTBID" />
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4>View Remark</h4>
                </div>
                <div class="modal-body body-content">
                    @* @Html.ValidationSummary(false, "", new { @class = "text-danger" }) *@
                    <div class="form-group">
                        <table class="table table-bordered table-hover table-responsive">
                            <tr>
                                <th style="text-align: center;">SrNo.</th>
                                <th style="text-align: center;">Added On</th>
                                <th style="text-align: center;">Added By</th>
                                <th style="text-align: center;">Remark</th>

                            </tr>
                            <tbody id="tbody_append"></tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-md-12 center">
                            @*<button type="button" class="bttn btn-success" onclick="closeViewRemarkpopup(); return false;" style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold;">Close</button>*@
                            <button type="button" class="bttn btn-success" data-ctrl="close-view-remark" style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold;">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
