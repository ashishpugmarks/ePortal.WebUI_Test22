            <script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
                alert("IT Confirmation request has been submitted successfully.");
            </script>
        }
        else if (Convert.ToInt16(TempData["result"]) == 3)
        {
            <script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
                alert("IT Confirmation request has been approved successfully.");
            </script>
        }
        else if (Convert.ToInt16(TempData["result"]) == 4)
        {
            <script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
