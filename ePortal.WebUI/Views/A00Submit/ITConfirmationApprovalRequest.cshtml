@section scripts {
    <script type="text/javascript" language="Javascript" src="~/js/jquery-ui.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.js"></script>
    @* @Scripts.Render("~/bundles/jqueryval") *@
    <script src="~/js/jquery.validate.min.js"></script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        var msg = '@ViewBag.Msg';
        if(!$("#txtRemark").val()){
             $("#spnRemark").val("Please enter remarks.")
        }
        if (msg.length) {
            alert(msg);
        };
        $(document).ready(function () {
            $("#CancelBtnClick").click(function () {
                location.reload(true);
            });
        });

        $('#btnSearch').on('click', function () {
            $('form').validate();
            if ($('form').valid()){
                var btn = $(this);
                setTimeout(function () {
                    btn.button('loading');
                }, 100);
                //$(this).button('loading');// button text will be "finished!"
            }
        });
    </script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        ////======== Bind Operation========////
        function BindOperationBySykiId(crnt, call) {
            var kiID = $(crnt).val();
            var select_ddlOp = $("#ddlOp");
            var select_ddlDiv = $("#ddlDiv");
            var select_ddlDep = $("#ddlDep");
            var select_ddlSec = $("#ddlSec");
            select_ddlOp.empty(); select_ddlDiv.empty(); select_ddlDep.empty(); select_ddlSec.empty();

            select_ddlOp.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlDiv.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlDep.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlSec.append($('<option />', { value: "0", text: "--Please wait--" }));
            if (kiID != "" && kiID != "0") {
                $.getJSON("/A00Submit/BindOperationBySykiId", { SYKIID: kiID },
                    function (data) {
                        select_ddlOp.empty(); select_ddlDiv.empty(); select_ddlDep.empty(); select_ddlSec.empty();
                        if (data.length > 0) {
                            select_ddlOp.append($('<option />', { value: "0", text: "--Select--" }));
                            $.each(data, function (index, itemData) {
                                select_ddlOp.append($('<option />', { value: itemData.ADORGLEVELID != null ? itemData.ADORGLEVELID : 0, text: itemData.LEVELDESCRIP }));
                            });
                            select_ddlDiv.append($('<option />', { value: "0", text: "--Select--" }));
                            select_ddlDep.append($('<option />', { value: "0", text: "--Select--" }));
                            select_ddlSec.append($('<option />', { value: "0", text: "--Select--" }));
                        }
                        else {
                            select_ddlOp.append($('<option />', { value: "0", text: "--No record--" }));
                            select_ddlDiv.append($('<option />', { value: "0", text: "--No record--" }));
                            select_ddlDep.append($('<option />', { value: "0", text: "--No record--" }));
                            select_ddlSec.append($('<option />', { value: "0", text: "--No record--" }));
                        }
                    });
            }
            else {
                select_ddlOp.empty(); select_ddlDiv.empty(); select_ddlDep.empty(); select_ddlSec.empty();
                select_ddlOp.append($('<option />', { value: "0", text: "--Select Ki First--" }));
                select_ddlDiv.append($('<option />', { value: "0", text: "--Select--" }));
                select_ddlDep.append($('<option />', { value: "0", text: "--Select--" }));
                select_ddlSec.append($('<option />', { value: "0", text: "--Select--" }));
            }
        };
        ////======== Bind Division========////
        function BindDivision(crnt, call) {
            var oID = $(crnt).val();
            var SYKIID = $("#SearchParams_SYKI").val();
            var select = $("#ddlDiv");
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Please wait--"
            }));
            if (oID != "") {
                $.getJSON("/A00Submit/BindDivisionByOperationId", { id: oID, SYKIID: SYKIID },
                    function (data) {
                        select.empty();
                        if (data.length > 0) {
                            select.append($('<option />', {
                                value: "",
                                text: "--Select--"
                            }));
                            $.each(data, function (index, itemData) {
                                select.append($('<option />', {
                                    value: itemData.DIVISIONID,
                                    text: itemData.DIVISION
                                }));
                            });
                            BindDepartment($("#ddlDiv"), "0");
                            BindSection($("#ddlDep"), "0");
                        }
                        else {
                            select.append($('<option />', {
                                value: "",
                                text: "--No record--"
                            }));
                        }
                    });
            }
            else {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Select--"
                }));
                BindDepartment($("#ddlDiv"), "0");
                BindSection($("#ddlDep"), "0");
            }
        };

        ////======== Bind Department========////
        function BindDepartment(crnt, call) {
            var dID = $(crnt).val();
            var SYKIID = $("#SearchParams_SYKI").val();
            var select = $("#ddlDep");
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Please wait--"
            }));
            if (dID != "") {
                $.getJSON("/A00Submit/BindDeptByDivisionId", { id: dID, SYKIID: SYKIID },
                    function (data) {
                        select.empty();
                        if (data.length > 0) {
                            select.append($('<option />', {
                                value: "",
                                text: "--Select--"
                            }));
                            $.each(data, function (index, itemData) {
                                select.append($('<option />', {
                                    value: itemData.DEPARTMENTID,
                                    text: itemData.DEPARTMENT
                                }));
                            });
                            BindSection($("#ddlDep"), "0");
                        }
                        else {
                            select.append($('<option />', {
                                value: "",
                                text: "--No record--"
                            }));
                        }
                    });
            } else {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Select--"
                }));
                BindSection($("#ddlDep"), "0");
            }
        };

        ////======== Bind Section========////
        function BindSection(crnt, call) {
            var dID = $(crnt).val();
            var SYKIID = $("#SearchParams_SYKI").val();
            var select = $("#ddlSec");
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Please wait--"
            }));
            if (dID != "") {
                $.getJSON("/A00Submit/BindSecByDepartmentId", { id: dID, SYKIID: SYKIID },
                    function (data) {
                        select.empty();
                        if (data.length > 0) {
                            select.append($('<option />', {
                                value: "",
                                text: "--Select--"
                            }));
                            $.each(data, function (index, itemData) {
                                select.append($('<option />', {
                                    value: itemData.SECTIONID,
                                    text: itemData.SECTION
                                }));
                            });
                        }
                        else {
                            select.append($('<option />', {
                                value: "",
                                text: "--No record--"
                            }));
                        }
                    });
            } else {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Select--"
                }));
            }
        };

        function AddRemarkClick(A00Id) {
            debugger;
            $("#txtRemark").val('');
            $("#hdnA00DTLTBID").val(A00Id);
            $('#myModal').modal({ backdrop: "static" });
        }
        function SaveData() {
            var isFormVaildation = CheckFormValidation();
            if (isFormVaildation) {
                $.ajax({
                    type: "POST",
                    url: "/A00Submit/AddRemark",
                    data: JSON.stringify({ A00ID: $('#hdnA00DTLTBID').val(), REMARK: $.trim($("#txtRemark").val()) }),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        $('#myModal').modal('hide');
                        if (data == 1) {
                            swal({
                                title: "",
                                text: "Record saved successfully.",
                                type: "success",
                            })
                        }
                        else {
                            sweetAlert("", "Record not saved.", "warning");
                        }
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function CheckFormValidation() {
            var isVailed = true;
            debugger;
            $("#txtRemark").removeClass('validationError');
            if ($.trim($('#txtRemark').val()) == "") {
                $("#txtRemark").addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }
        function ViewRemarkClick(A00Id) {
            //debugger;
            $("#hdnViewA00DTLTBID").val(A00Id);
            $.ajax({
                type: "GET",
                url: "/A00Submit/GetRemark",
                data: { A00ID: $('#hdnViewA00DTLTBID').val() },
                success: function (data) {
                    var rows = "", rowId = 0;
                    $.each(data, function (i, item) {
                        //debugger;
                        rowId = i + 1;
                        rows += "<tr class='tr_doc'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.stringAddedDate + "</td><td class='text-center'>" + item.ADDEDBY + " [" + item.FIRSTNAME + " " + item.LASTNAME + "]" + "</td><td class='text-center'>" + item.REMARKS + "</td>"
                        rows += "</tr>"
                    });
                    if (rowId == 0) {
                        rows += "<tr class='tr_doc'><td colspan='4' class='text-center'>" + " No Record Found" + "</td>"
                        rows += "</tr>"
                    }
                    document.getElementById("tbody_append").innerHTML = rows;
                    $('#myViewModal').modal({ backdrop: "static" });
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
    </script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        function closepopup() {
            $('#myModal').modal('hide');
            $(document.body).removeClass('modal-open');
            $('.modal-backdrop').remove();
        }

        function popup(dtltbid) {
            $("#myModal").modal('show');
            $('#hdnA00DTLTBID').val(dtltbid);
        }
        function closeViewRemarkpopup() {
            $('#myViewModal').modal('hide');
            $(document.body).removeClass('modal-open');
            $('.modal-backdrop').remove();
        }
    </script>

