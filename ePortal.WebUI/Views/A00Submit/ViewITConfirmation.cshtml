<div class="row">
    <div class="form-group right" style="margin-top: -41px; font-size: 16px; font-weight: bold;"><a href="/A00Submit/ITDivisionView?A00DTLTBID=@Model.A00DTLTBID&type=View&SYKIID=@Model.SYKIID" target="_blank" style="color:white;" title="Click here to view the A00"><u>View A00</u></a></div>
