@model ePortal.ViewModels.ITConfirmationVM
@{
    ViewBag.Title = "A00 Project Status Update";
    Layout = "~/Views/Shared/_LayoutA00.cshtml";
}
@section Styles {

    <link rel="stylesheet" href="~/css/jquery-ui.css">
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />
        @* <link href="~/lib/bootstrap/css/bootstrap-datepicker.min.css" rel="stylesheet" /> *@
    <link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet" />

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .fileUpload input[type=file] {
            display: none;
        }

        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .multiselect dropdown-toggle btn btn-default {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            /*.text-right {
                text-align: right;
                vertical-align: middle;
                width: 20%;
                font-size: 14px;
                font-family: roboto-bold;
                color: #000000;
            }*/

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .modal-header {
            padding: 15px !important;
        }

        .modal-body {
            padding: 15px !important;
        }

        .modal-footer {
            padding: 15px !important;
        }

        .tcat {
            BACKGROUND: url(../images/tablebg.gif) #80a9ea repeat left bottom !important;
            background-size: 3px !important;
        }

        .tcat-tp {
            BACKGROUND: url(../images/tablebg.gif) #80a9ea repeat left bottom !important;
            background-size: 10px !important;
            FONT: 12px Verdana, Tahoma;
            COLOR: #ffffff;
        }
    </style>
}
<div class="row">

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary("", new { @class = "text-danger" })
        @Html.HiddenFor(x => x.A00DTLTBID)
        @Html.HiddenFor(x => x.SYKIID)
        @Html.HiddenFor(x => x.ApplicationPIC)
        @Html.HiddenFor(x => x.InfraStructurePIC)
        @Html.HiddenFor(x => x.ProjectDate)
        @Html.HiddenFor(x => x.ProjectName)
        @Html.HiddenFor(x => x.UserPL)
        @Html.HiddenFor(x => x.UserDept)
        @Html.HiddenFor(x => x.ITPL)
        @Html.HiddenFor(x => x.ITDept)
        @Html.HiddenFor(x => x.ITCONFIRMATIONID)

        <div class="body-content" style="overflow-x:hidden">
            <div id="msform">
                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <tr>
                            <td class="text-right">
                                <b>Project&nbsp;Code<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-3">
                                <div class="">
                                    @Html.TextBoxFor(m => m.ProjectCode_Date, new
                                        {
                                            @class = "form-control",
                                            @maxlength = "100",
                                            @disabled = "disabled"
                                        })

                                </div>
                            </td>

                            <td class="text-right">
                                <b>Project&nbsp;Name<span style="color: #ff0000">*</span></b>
                            </td>
                            <td class="col-md-3" colspan="3">
                                <div>
                                    @Html.TextAreaFor(m => m.ProjectName, new
                                        {
                                            @class = "form-control",
                                            @maxlength = "100",
                                            @disabled = "disabled"
                                        })
                                </div>
                            </td>

                        </tr>

                        <tr>
                            <td class="text-right">
                                <b>User Project Leader</b>
                            </td>
                            <td class="col-md-3">
                                <div class="">
                                    @Html.TextBoxFor(m => m.UserPL_Name, new
                                        {
                                            @class = "form-control",
                                            @maxlength = "100",
                                            @disabled = "disabled"

                                        })
                                </div>
                            </td>
                            <td class="text-right">
                                <b>User Dept</b>
                            </td>
                            <td class="col-md-3">
                                <div class="">

                                    @Html.TextBoxFor(m => m.UserDept, new
                                        {
                                            @class = "form-control",
                                            @maxlength = "100",
                                            @disabled = "disaled"

                                        })
                                </div>
                            </td>

                            <td class="text-righ">
                                <b>Impacted Operation<span style="color: #ff0000">*</span></b>
                            </td>
                            <td style="width:115px;">
                                <div>
                                    <input name="ImpactedOperation" type="radio" id="rdSingle" value="1" disabled />
                                    <label for="rdSingle">Single</label><br />
                                    <input name="ImpactedOperation" type="radio" id="rdMulti" value="2" disabled />
                                    <label for="rdMulti">Multi</label>
                                </div>
                                <label id="ImpactedOperation-error" class="error" for="ImpactedOperation"></label>
                            </td>
                        </tr>

                        <tr>
                            <td class="text-right">
                                <b>IT Project Leader</b>
                            </td>
                            <td>
                                <div class="">
                                    @Html.TextBoxFor(m => m.ITPL_Name, new
                                        {
                                            @class = "form-control",
                                            @maxlength = "100",
                                            @disabled = "disabled"
                                        })
                                </div>
                            </td>
                            <td class="text-right">
                                <b>IT Dept</b>
                            </td>
                            <td>
                                <div class="">

                                    @Html.TextBoxFor(m => m.ITDept, new
                                        {
                                            @class = "form-control",
                                            @maxlength = "100",
                                            @disabled = "disabled"

                                        })
                                </div>
                            </td>
                            <td class="text-right">
                                <b>Development<span style="color: #ff0000">*</span></b>
                            </td>
                            <td>
                                <div>
                                    <input name="Development" type="radio" id="rdInternal" value="1" disabled />
                                    <label for="rdInternal">Internal</label><br />
                                    <input name="Development" type="radio" id="rdExternal" value="2" disabled />
                                    <label for="rdExternal">External</label><br />
                                </div>
                                <label id="Development-error" class="error" for="Development"></label>
                            </td>
                        </tr>

                        <tr>
                            <td class="text-right">
                                <b>Stand alone application<span style="color: #ff0000">*</span></b>
                            </td>
                            <td>
                                <div class="">
                                    @Html.DropDownListFor(m => m.SAA, new List<SelectListItem>
                                {
                                new SelectListItem{ Text="Select", Value = "" },
                                new SelectListItem{ Text="Package", Value = "Package" },
                                new SelectListItem{ Text="Scratch Development", Value = "Scratch Development" },
                                new SelectListItem{ Text="Enhancement in Existing Application", Value = "Enhancement in Existing Application" }
                                }, new { @class = "form-control", @disabled = "disabled" })
                                </div>
                            </td>
                            <td class="text-right">
                                <b>Linkage with existing application<span style="color: #ff0000">*</span></b>
                            </td>
                            <td colspan="3">
                                <div class="">
                                    @Html.TextBoxFor(m => m.LWEA, new
                                        {
                                            name = "LWEA",
                                            @class = "form-control",
                                            @maxlength = "190",
                                            @disabled = "disabled"
                                        })
                                </div>
                            </td>

                        </tr>

                        <tr>
                            <td class="text-right">
                                <b>Infrastructure Requirement<span style="color: #ff0000">*</span></b>
                            </td>
                            <td>
                                <div>
                                    <input name="InfrastructureRequirement" type="radio" id="rdIRYes" value="1" disabled />
                                    <label for="rdIRYes">Yes</label>
                                    <input name="InfrastructureRequirement" type="radio" id="rdIRNo" value="2" disabled />
                                    <label for="rdIRNo">No</label>
                                </div>
                                <label id="InfrastructureRequirement-error" class="error" for="InfrastructureRequirement"></label>
                            </td>
                            <td class="text-right">
                                <b>If yes, please specify Hosting on cloud/ on premises</b>
                            </td>
                            <td colspan="3">
                                <div>
                                    @Html.TextBoxFor(m => m.IR, new
                                        {
                                            name = "IR",
                                            @class = "form-control",
                                            @maxlength = "190",
                                            @disabled = "disabled"
                                        })
                                    <label id="IRerror" class="error" for="OEM" style="display:none;"></label>

                                </div>
                            </td>

                        </tr>

                        <tr>
                            <td class="text-right">
                                <b>License required<span style="color: #ff0000">*</span></b>
                            </td>
                            <td>
                                <div>
                                    <input name="LicenseRequired" type="radio" id="rdYes" value="1" disabled />
                                    <label for="rdYes">Yes</label>
                                    <input name="LicenseRequired" type="radio" id="rdNo" value="2" disabled />
                                    <label for="rdNo">No</label>
                                </div>
                                <label id="LicenseRequired-error" class="error" for="LicenseRequired"></label>
                            </td>
                            <td class="text-right">
                                <b>If yes, please specify (In case of indirect usage, please verify with OEM)</b>
                            </td>
                            <td colspan="3">
                                <div>
                                    @Html.TextBoxFor(m => m.OEM, new
                                        {
                                            name = "OEM",
                                            @class = "form-control",
                                            @maxlength = "190",
                                            @disabled = "disabled"
                                        })
                                    <label id="OEMerror" class="error" for="OEM" style="display:none;"></label>
                                </div>
                            </td>
                        </tr>

                        <tr>

                            <td class="text-right">
                                <b>Application<span style="color: #ff0000">*</span></b>
                            </td>
                            <td>
                                <div>
                                    <select class="form-control" id="Application" name="Application" disabled>
                                        <option selected="selected" value="">Select</option>
                                        <option value="1">New</option>
                                        <option value="2">Existing</option>
                                    </select>
                                    <label id="Applicationerror" class="error" for="Application" style="display:none;"></label>
                                </div>
                            </td>
                            <td class="text-right"><b>No of screens<span style="color: #ff0000">*</span></b> </td>
                            <td>
                                <div style="padding-right: 0px;">

                                    @Html.TextBoxFor(m => m.NOFS, new
                                        {
                                            name = "NOFS",
                                            @class = "form-control",
                                            @type = "number",
                                            @min = "0",
                                            @disabled = "disabled",
                                            @data_ctrl = "txt-nofs"

                                        })
                                </div>
                            </td>
                            <td class="text-right">
                                <b>HSDM/CR<span style="color: #ff0000">*</span></b>
                            </td>
                            <td>
                                <div>
                                    @Html.DropDownListFor(m => m.HSDM, new List<SelectListItem>
                                {
                                new SelectListItem{ Text="HSDM", Value = "HSDM" },
                                new SelectListItem{ Text="CR", Value = "CR" }
                                }, new { @class = "form-control", @disabled = "disabled" })

                                    <label id="HSDMerror" class="error" for="HSDM" style="display:none;"></label>
                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td class="text-right"><b>Tentative one time and recurring cost (Rs.)<span style="color: #ff0000">*</span></b> </td>
                            <td>
                                <div class="col-md-6" style="padding-right: 2px;">

                                    @Html.TextBoxFor(m => m.OTC, new
                                        {
                                            name = "OTC",
                                            @class = "form-control",
                                            @maxlength = "190",
                                            @placeholder = "One Time",
                                            @disabled = "disabled"
                                        })
                                </div>
                                <div class="col-md-6" style="padding-right: 0px;">
                                    @Html.TextBoxFor(m => m.RC, new
                                        {
                                            name = "RC",
                                            @class = "form-control",
                                            @maxlength = "190",
                                            @placeholder = "Recurring",
                                            @disabled = "disabled"
                                        })
                                </div>
                            </td>
                            <td class="text-right">
                                <b>Tentative Time line<span style="color: #ff0000">*</span></b>
                            </td>
                            <td>
                                <div>
                                    @Html.TextBoxFor(m => m.TTimeLine, new
                                        {
                                            name = "TTimeLine",
                                            @class = "form-control",
                                            @maxlength = "190",
                                            @disabled = "disabled"
                                        })
                                </div>
                            </td>
                            <td class="text-right">
                                <b>U0 Target<span style="color: #ff0000">*</span></b>
                            </td>
                            <td>
                                <div>
                                    @Html.TextBoxFor(m => m.UOTarget, new
                                        {
                                            name = "UOTarget",
                                            @class = "form-control",
                                            @maxlength = "190",
                                            @placeholder = "dd/mm/yyyy",
                                            @disabled = "disabled"
                                        })
                                </div>
                            </td>

                        </tr>

                        <tr>
                            <td class="text-right"><b>Remarks<span style="color: #ff0000">*</span></b>  </td>
                            <td colspan="5">
                                <div>
                                    @Html.TextBoxFor(m => m.Remarks, new
                                        {
                                            name = "remarks",
                                            @class = "form-control",
                                            @maxlength = "190",
                                            @disabled = "disabled"
                                        })
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">
                                <div style="font-size:14px; font-family: roboto-bold;text-align: left; padding-bottom:5px;"
                                     class="text-info">
                                    IT Confirmation Approval :
                                </div>
                                @if (ViewBag.ITConfirmationDetails != null)
                                {
                                    <div style="width:100%;display: flex;align-items: center;">
                                        @if (ViewBag.ITConfirmationDetails.Count > 0)
                                        {
                                            <table class="table table-responsive table-bordered table-hover" style="max-width:130px; font-size:13px;border: 0.5px solid #dddddd; margin-bottom: 0;">
                                                <thead>
                                                    <tr>
                                                        <th scope="row" class="tcat">&nbsp;</th>
                                                    </tr>
                                                    <tr>
                                                        <th scope="row" class="tcat">Name</th>
                                                    </tr>
                                                    <tr>
                                                        <th scope="row" class="tcat">Approval Date</th>
                                                    </tr>
                                                    <tr style="height: 130px;">
                                                        <th scope="row" class="tcat-tp" style="vertical-align:top;">Remarks</th>
                                                    </tr>
                                                </thead>
                                            </table>
                                            foreach (var item in ViewBag.ITConfirmationDetails)
                                            {
                                                <table class="table table-responsive table-bordered table-hover" style="width:12.5%;font-size:13px;border: 1px solid #dddddd; margin-bottom: 0;">
                                                    <tr>
                                                        <td>@item.Designation</td>
                                                    </tr>
                                                    <tr>
                                                        <td>@item.EmpName</td>
                                                    </tr>
                                                    <tr>
                                                        <td>
                                                            @if (item.ACTIONON != null)
                                                            {
                                                                @item.ACTIONON.ToString("dd/MM/yyyy")
                                                            }
                                                        </td>
                                                    </tr>
                                                    <tr style="height: 130px;">
                                                        <td style="vertical-align:middle;">@item.REMARKS</td>
                                                    </tr>
                                                </table>
                                            }
                                        }
                                        else
                                        {
                                            <table class="table table-responsive table-bordered table-hover" style="font-size:13px; border: 1px solid #dddddd;">
                                                <tr>
                                                    <td colspan="5">No record found!</td>
                                                </tr>
                                            </table>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">
                                <div style="width:100%;display: flex;align-items: center;">
                                    @if (ViewBag.ProjectStatusUpdateList != null)
                                    {
                                        <table class="table table-responsive table-bordered table-hover" style="font-size:13px; border: 1px solid #dddddd;">
                                            <tr>
                                                <th colspan="6" style="font-size:14px; font-family: roboto-bold;text-align: left; padding-bottom:5px; background-color:white;"
                                                    class="text-info">Project Status Update History :</th>
                                            </tr>
                                            <tr class="tcat">
                                                <th style="border: 1px solid #dddddd; text-align:center; width:2%;">S.No</th>
                                                <th style="border: 1px solid #dddddd; text-align:center; width:5%;">Project Stage</th>
                                                <th style="border: 1px solid #dddddd; text-align:center; width:10%;">Status</th>
                                                <th style="border: 1px solid #dddddd; text-align:center; width:10%;">Action By</th>
                                                <th style="border: 1px solid #dddddd; width:10%;text-align:center">Action On</th>
                                                <th style="border: 1px solid #dddddd; width:10%;text-align:center">Remarks</th>
                                                <th style="border: 1px solid #dddddd; width:10%;text-align:center">Attachement</th>
                                            </tr>
                                            @if (ViewBag.ProjectStatusUpdateList.Count > 0)
                                            {
                                                int i = 1;
                                                foreach (var item in ViewBag.ProjectStatusUpdateList)
                                                {
                                                    <tr>
                                                        <td style="border: 1px solid #dddddd;text-align:center;">@i</td>
                                                        <td style="border: 1px solid #dddddd;text-align:center;">@item.PROJECTSTAGE</td>
                                                        <td style="border: 1px solid #dddddd;text-align:center;">
                                                            @{
                                                                var ProjectStatus = "";
                                                            }
                                                            @if (item.PROJECTSTATUS == 1)
                                                            {
                                                                ProjectStatus = "Pending";
                                                            }
                                                            else if (item.PROJECTSTATUS == 2)
                                                            {
                                                                ProjectStatus = "InProcess";
                                                            }
                                                            else if (item.PROJECTSTATUS == 3)
                                                            {
                                                                ProjectStatus = "Hold";
                                                            }
                                                            else if (item.PROJECTSTATUS == 4)
                                                            {
                                                                ProjectStatus = "Completed";
                                                            }
                                                            else if (item.PROJECTSTATUS == 5)
                                                            {
                                                                ProjectStatus = "Not Applicable";
                                                            }
                                                            @ProjectStatus
                                                        </td>
                                                        <td style="border: 1px solid #dddddd;text-align:center;">@item.EmpName</td>
                                                        <td style="border: 1px solid #dddddd;text-align:center;">
                                                            @if (item.ActionOn != null)
                                                            {
                                                                @item.ActionOn.ToString("dd/MM/yyyy")
                                                            }
                                                        </td>
                                                        <td style="border: 1px solid #dddddd;text-align:center;">@item.PROJECTSTATUSREMARKS</td>
                                                        @if (item.ATTACHMENTNOTE != null)
                                                        {
                                                            <td style="border: 1px solid #dddddd;text-align:center;">
                                                                <a href="~/Uploads/A00/A00ProjectStatus/@item.ATTACHMENTNOTE" class="btn btn-warning" download>
                                                                    Download
                                                                    <span class="glyphicon glyphicon-download" aria-hidden="true"></span>
                                                                </a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td style="border: 1px solid #dddddd;text-align:center;">NA</td>
                                                        }

                                                    </tr>
                                                    i++;
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="12">No records found</td>
                                                </tr>
                                            }
                                        </table>

                                    }
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="row clear-both" style="margin-top:10px;">
            <div class="col-md-12 center">
                <input type="button" value="Update Status" class="bttn btn-success" name="btnUpdate" id="btnAllocation" style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold;" />
                <input type='button' id='btnBack' class="bttn btn-success" style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold;" value='Back' />
            </div>
        </div>
    }

    <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog" style="width: 800px;">
            <div class="modal-content">
                @using (Html.BeginForm("SaveA00ProjectStatus", "A00Submit", FormMethod.Post, new { @name = "SaveA00ProjectStatus", encType = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(x => x.A00DTLTBID)
                    <input type="hidden" id="hdnSYKIID" name="hdnSYKIID" value="@ViewBag.SYKIID" />
