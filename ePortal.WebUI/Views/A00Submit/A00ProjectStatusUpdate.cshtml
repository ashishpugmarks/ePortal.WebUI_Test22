@section  scripts {
    @*@Scripts.Render("~/bundles/jqueryval")*@
    <script type="text/javascript" language="Javascript" src="~/js/jquery-ui.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.js"></script>
    <script src="~/js/jquery.validate.js"></script>

    @* <script src="~/lib/bootstrap/js/bootstrap-datepicker.min.js"></script> *@
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(function () {
            $('#ProjectStatusDate').datepicker({
                format: "dd/mm/yyyy",
                todayHighlight: true,
                autoclose: true,
                clearBtn: true,

            });
        });
    </script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        function popup() {
            $("#myModal").modal('show');
        }
        function closepopup() {
            $('#myModal').modal('hide');
            $(document.body).removeClass('modal-open');
            $('.modal-backdrop').remove();
        }

    </script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        $(document).ready(function () {
            $("#ProjectStage").text('@ViewBag.ProjectStage');
            $('#ProjectStage').attr("disabled", true);
            $("#ItConfrApprovedOn").val('@ViewBag.LastCompletedStage');
            $('#ItConfrApprovedOn').attr("disabled", true);
            var Application = $("#Application").val('@ViewBag.Application');

            var IO = '@Model.ImpactedOperation';//$("#ImpactedOperation").val();
            //$('input[name=ImpactedOperation]').attr("disabled", true);
            var Development = '@Model.Development';//$("#Development").val();
            //$('input[name=Development]').attr("disabled", true);
            var LR = '@Model.LicenseRequired';//$("#LicenseRequired").val();
            //$('input[name=LicenseRequired]').attr("disabled", true);
            var IR = '@Model.InfrastructureRequirement';//$("#InfrastructureRequirement").val();
            if (IO == 1) {
                $('#rdSingle').attr('checked', true);
            }
            else {
                $('#rdMulti').attr('checked', true);
            }
            if (Development == 1) {
                $('#rdInternal').attr('checked', true);
            }
            else {
                $('#rdExternal').attr('checked', true);
            }
            if (LR == 1) {
                $('#rdYes').attr('checked', true);
            }
            else {
                $('#rdNo').attr('checked', true);
            }
            if (IR == 1) {
                $('#rdIRYes').attr('checked', true);
            }
            else {
                $('#rdIRNo').attr('checked', true);
            }
            //Dinesh
            if ('@ViewBag.ActualProjectStage' == "P0" || '@ViewBag.ActualProjectStage' == "UAT and Go-Live") {
                $("#btnProjectStatus").hide();
            }
            //$("#Remark").text('@ViewBag.Remark');
            //$("#ddlStatus").val('@ViewBag.UpdateState');
            //***
        });

    </script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
        // Wait for the DOM to be ready
        $(function () {
            // Initialize form validation on the registration form.
            // It has the name attribute "registration"
        });
        $("form[name='SaveA00ProjectStatus']").validate({
            // Specify validation rules
            rules: {
                Remark: "required",
                ImageFile: "required",
                ProjectStatusDate: "required",
                ddlStatus: "required",
            },
            // Specify validation error messages
            messages: {
                Remark: "Please enter remark.",
                ImageFile: "Please select file.",
                ProjectStatusDate: "Please select date.",
                ddlStatus: "Please select status."
            },
            // Make sure the form is submitted to the destination defined
            // in the "action" attribute of the form when valid
            submitHandler: function (form) {
                form.submit();
            }
        });

        $('#btnProjectStatus').on('click', function () {
            $($("form[name='SaveA00ProjectStatus']")).validate();
            if ($("form[name='SaveA00ProjectStatus']").valid()){
                var btn = $(this);
                    setTimeout(function () {
                        btn.button('loading');
                    }, 100);
                //$(this).button('loading') // button text will be "finished!"
            }
        });
    </script>

    @*CSP 3.0 Compliant Changes*@

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
        $(document).ready(function () {
            $('#btnAllocation').on('click', function () {
                popup();
                return false;
            });

            $('#btnBack').on('click', function () {
                window.location = document.referrer;
            });

            $('#btnReset').on('click', function () {
                this.form.reset();
            });

            $('[data-ctrl="btn-close"]').on('click', function () {
                closepopup();
                return false;
            });

            $('[data-ctrl="btn-back"]').on('click', function (e) {
                e.preventDefault();
                window.location = document.referrer;
            });

            $('#ImageFile').on('change', function () {
                ValidateSingleInput($(this)[0]);
            });

            $('[data-ctrl="txt-nofs"]').on('change', function () {
                FillHsdm();
            });

        });
    </script>

}


