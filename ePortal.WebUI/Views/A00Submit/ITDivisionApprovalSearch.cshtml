    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
        $(document).ready(function () {
            $('#CancelBtnClick').on('click', function () {
                CancelBtnClickEvent();
            });

            $(document).on('click', '[data-ctrl="add-remark"]', function () {
                AddRemarkClick($(this).data('id'));
            });

            $(document).on('click', '[data-ctrl="view-remark"]', function () {
                ViewRemarkClick($(this).data('id'));
            });

            $('#btnAddRemark').on('click', function () {
                SaveData();
            });

            $('[data-ctrl="popup-close"]').on('click', function () {
                closepopup();
                return false;
            });

            $('[data-ctrl="close-popup"]').on('click', function () {
                closepopup();
                return false;
            });

            $('[data-ctrl="close-view-remark"]').on('click', function () {
                closeViewRemarkpopup();
                return false;
            });

            $('[data-ctrl="syki-dropdown"]').on('change', function () {
                BindOperationBySykiId($(this)[0], 0);
            });

            $('#ddlOp').on('change', function () {
                BindDivision($(this)[0], 0);
            });

            $('#ddlDiv').on('change', function () {
                BindDepartment($(this)[0], 0);
            });

            $('#ddlDep').on('change', function () {
                BindSection($(this)[0], 0);
            });

            $('[data-ctrl="converttocr"]').on('click', function () {
                var itemId = $(this).data('id');
                popup(itemId);
            });

        });
    </script>

