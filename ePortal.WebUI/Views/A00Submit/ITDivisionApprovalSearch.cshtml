    var AllocationStatus = "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/jquery-ui.css">
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .tbl_cls1 {
            /*border: groove;*/
            padding-top: 07px;
            text-align: right;
            padding-right: 05px;
        }

        .tbl_cls2 {
            /*border: groove;*/
            padding-top: 07px;
            text-align: left;
            padding-left: 05px;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .font-size {
            font-size: 70% !important;
        }

        /*Change start on 22-July-2021*/
        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            /*Change end on 22-July-2021*/
        }
    </style>
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .search-elements-border {
            border: 0.5px;
            border-style: groove;
            height: 24px;
        }

        .right-alignment {
            text-align: right;
        }

        .ddl-width-hight {
            width: 70%;
            height: 16px;
        }

        .padding-zero {
            padding: 0;
        }

        .height-16px {
            height: 16px;
        }

        .margin-1px {
            margin: 4px;
        }

        .bg-color-blue {
            background-color: #BBCDEC;
        }

        .tcat {
            /*Change start on 10-July-2021*/
            /*BACKGROUND: url(../images/tablebg.gif) #80a9ea repeat left bottom;*/
            background: #6c9ce8 repeat left bottom;
            /*Change end on 10-July-2021*/
            background-size: 2px;
        }

        .validationError {
            border: 1px solid #a94442;
        }

        .modal-body {
            max-height: calc(100vh - 200px);
            overflow-y: auto;
        }
