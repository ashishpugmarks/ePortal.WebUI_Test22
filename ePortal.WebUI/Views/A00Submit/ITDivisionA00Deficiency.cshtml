                    {
            <a href="#" name="btndeficiency" id="btndeficiency" style="font-weight : bold;top: 50px;right: 12%;position: absolute;color:red;font-size:15px;text-align: right;">Raise Deficiency</a>
                    }
                    else if (ViewBag.DeficiencyStatus == 2 && (ViewBag.CanPerformAction == 0 || ViewBag.CanPerformAction == 1 || ViewBag.CanPerformAction == 2))
                    {
            <a href="#" name="btndeficiencyClosure" id="btndeficiencyClosure" style="font-weight : bold;top: 50px;right: 12%;position: absolute;color:red;font-size:15px;text-align: right;">Deficiency Closure</a>
