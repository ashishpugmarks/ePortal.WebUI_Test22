@section  scripts{
    @* <script type="text/javascript" language="Javascript" src="~/assets/js/jquery-ui.min.js"></script> *@
    <script src="~/lib/bootstrap/js/bootstrap.js"></script>
    <script type="text/javascript" src="~/lib/bootstrap/js/bootstrap-multiselect.js"></script>
    <script type="text/javascript" src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script>
    @* @Scripts.Render("~/bundles/jqueryval") *@
    <script src="~/js/jquery.validate.min.js"></script>
    <script src="~/js/jquery.validate.unobtrusive.min.js"></script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        // Wait for the DOM to be ready
        $(function () {
            // Initialize form validation on the registration form.
            // It has the name attribute "registration"
        });
        $("#SaveA00Deficiency").validate({
            // Specify validation rules
            rules: {
                DeficiencyRemark: "required"
            },
            // Specify validation error messages
            messages: {
                DeficiencyRemark: "Please enter remark."
            },
            // Make sure the form is submitted to the destination defined
            // in the "action" attribute of the form when valid
            submitHandler: function (form) {
                form.submit();
            }
        });

        $("#SaveA00DeficiencyUpdate").validate({
            // Specify validation rules
            rules: {
                DeficiencyRemark: "required",
                deficiencyStatus: "required"
            },
            // Specify validation error messages
            messages: {
                DeficiencyRemark: "Please enter remark.",
                deficiencyStatus: "Please select deficiency status."
            },
            // Make sure the form is submitted to the destination defined
            // in the "action" attribute of the form when valid
            submitHandler: function (form) {
                form.submit();
            }
        });

        $('#btnDeficiencyRaised').on('click', function () {
            $('#SaveA00Deficiency').validate();
            if ($('#SaveA00Deficiency').valid())
                $(this).button('loading') // button text will be "finished!"
        });

        $('#btnCloseDeficiency').on('click', function () {
            $('#SaveA00DeficiencyUpdate').validate();
            if ($('#SaveA00DeficiencyUpdate').valid())
                $(this).button('loading') // button text will be "finished!"
        });
    </script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(function () {
            $('[id*=SKYLIST]').multiselect({
                includeSelectAllOption: true
            });
            $("#start").datepicker({ format: "dd/mm/yyyy" }).val();
            $("#end").datepicker({ format: "dd/mm/yyyy" }).val();
        });
    </script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        function popup() {
            $("#myModal").modal('show');
        }

        function popupDeficiencyClosure() {
            $("#myModalDeficiencyClosure").modal('show');
        }

        function closepopup() {
            $('#myModal').modal('hide');
            $(document.body).removeClass('modal-open');
            $('.modal-backdrop').remove();
        }

        function closeDeficiencyClosurepopup() {
            $('#myModalDeficiencyClosure').modal('hide');
            $(document.body).removeClass('modal-open');
            $('.modal-backdrop').remove();
        }
    </script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
        function HandleBrowseClick() {
            var fileinput = document.getElementById("browse");
            fileinput.click();
            var textinput = document.getElementById("filename");
            textinput.value = fileinput.value;
        }
    </script>

    @*CSP 3.0 Compliant Changes*@

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">

        $(document).ready(function () {
            $('#btndeficiency').on('click', function (e) {
                e.preventDefault();
                popup();
                return false;
            });

            $('#btndeficiencyClosure').on('click', function (e) {
                e.preventDefault();
                popupDeficiencyClosure();
                return false;
            });

            $('#btnBack').on('click', function () {
                window.top.close();
            });

            $('[data-ctrl="closepopup"]').on('click', function () {
                closepopup();
                return false;
            });

            $('[data-ctrl="closedeficiencyclosurepopup"]').on('click', function () {
                closeDeficiencyClosurepopup();
                return false;
            });

            $('[data-ctrl="btn-back"]').on('click', function (e) {
                e.preventDefault();
                window.top.close();
            });

            $('#SKYLIST').on('change', function () {
                CheckOthers();
            });

            $('#ImageFile').on('change', function () {
                ValidateSingleInput($(this)[0]);
            });

            $('#DeficiencyImageFile').on('change', function () {
                ValidateSingleInput($(this)[0]);
            });
        });
    </script>

}


