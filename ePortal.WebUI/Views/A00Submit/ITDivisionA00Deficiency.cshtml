                //09-Sept-2021 change start
        <table class="table table-responsive table-bordered table-hover" style="font-size:13px;border: 1px solid #dddddd;width:88%;margin-bottom: 0;">
            <tr class="tcat">
                <td style="width: 10%"></td>
