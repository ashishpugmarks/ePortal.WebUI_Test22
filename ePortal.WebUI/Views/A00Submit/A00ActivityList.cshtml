@model ePortal.ViewModels.A00ViewModel
@{
    ViewBag.Title = "Activity List";
    Layout = "~/Views/Shared/_LayoutA00.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/jquery-ui.css">
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .tbl_cls1 {
            /*border: groove;*/
            padding-top: 07px;
            text-align: right;
            padding-right: 05px;
        }

        .tbl_cls2 {
            /*border: groove;*/
            padding-top: 07px;
            text-align: left;
            padding-left: 05px;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .font-size {
            font-size: 70% !important;
        }

        .show-read-more .more-text {
            display: none;
        }

        .hidelink {
            display: none;
        }

        table.display {
            width: 100% !important;
        }
    </style>

    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .search-elements-border {
            border: 0.5px;
            border-style: groove;
            height: 24px;
        }

        .right-alignment {
            text-align: right;
        }

        .ddl-width-hight {
            width: 70%;
            height: 16px;
        }

        .padding-zero {
            padding: 0;
        }

        .height-16px {
            height: 16px;
        }

        .margin-1px {
            margin: 4px;
        }

        .bg-color-blue {
            background-color: #BBCDEC;
        }

        .tcat {
            BACKGROUND: url(../images/tablebg.gif) #80a9ea repeat left bottom;
            background-size: 3px;
        }
    </style>

}

<div class="row">
    <div class="form-group right" style="margin-top: -49px; font-size: 16px; font-weight: bold;">
        <button type="button" class="btn btn-success" data-ctrl="btn-submit" title="Click here to Add New Activity"
                style="width:150px !important; background-color: #ccc; border-color: rgba(0, 0, 0, 0.4); color: #232121; font-weight: bold">
            Add New Activity
        </button>
    </div>
</div>
<div class="row">
    <input type="hidden" id="hdnva" value="0" />
    <input type="hidden" id="hdnopval" value="0" />
    <input type="hidden" id="hdnoptext" value="" />
    @using (Html.BeginForm("A00ActivityList", "A00Submit", FormMethod.Post))
    {
        <div class="form-group">
            <table class="table table-bordered table-hover table-responsive">
                <tr>
                    <td class="tbl_cls1"><label for="Ki" class="font-size">Ki </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownList("SearchParams.SYKI", ViewBag.SYKIData as SelectList, new { @class = "form-control", @data_ctrl = "syki-dropdown" })
                    </td>
                    <td class="tbl_cls1"><label for="EmpCode" class="font-size">Emp Code/Name </label></td>
                    <td class="tbl_cls2">
                        <div class="col col-md-3 col-lg-3">
                            @Html.TextBoxFor(model => model.SearchParams.ECode, new { id = "empCode", @class = "form-control", @placeholder = "Code" })
                        </div>
                        <div class="col col-md-offset-1 col-lg-offset-1 col-md-8 col-lg-8">
                            @Html.TextBoxFor(model => model.SearchParams.EmpName, new { id = "empName", @class = "form-control", @placeholder = "Name" })
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="tbl_cls1"><label for="Operation" class="font-size">Operation </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownListFor(model => model.SearchParams.OPERATIONID, new SelectList(ViewBag.List, "OPERATIONID", "OPERATION", ViewBag.List[0]),
                                 new { @id = "ddlOp", @class = "form-control" })
                    </td>
                    <td class="tbl_cls1"><label for="Division" class="font-size">Division </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownListFor(model => model.SearchParams.DIVISIONID, new SelectList(ViewBag.List, "DIVISIONID", "DIVISION", ViewBag.List[0]),
                                 new { @id = "ddlDiv", @class = "form-control" })
                    </td>
                </tr>
                <tr style="background-color:#f3f3f3">
                    <td style="height:45px;" class="tbl_cls1"><label for="Department" class="font-size">Department </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownListFor(model => model.SearchParams.DEPARTMENTID, new SelectList(ViewBag.List, "DEPARTMENTID", "DEPARTMENT", ViewBag.List[0]),
                                 new { @id = "ddlDep", @class = "form-control" })
                    </td>
                    <td class="tbl_cls1"><label for="Section" class="font-size">Section </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownListFor(model => model.SearchParams.SECTIONID, new SelectList(ViewBag.List, "SECTIONID", "SECTION", ViewBag.List[0]),
                                 new { @id = "ddlSec", @class = "form-control" })
                    </td>
                </tr>

                <tr style="background-color:#f3f3f3">
                    <td style="height:45px;" class="tbl_cls1"><label for="Status" class="font-size">Status </label></td>
                    <td class="tbl_cls2">
                        @Html.DropDownList("SearchParams.Status", ViewBag.StatusList as SelectList, new { @class = "form-control" })
                    </td>
                </tr>
                <tr>
                    <td style="height:45px; text-align:center; padding-top:07px;" colspan="4">
                        <button type="submit" id="btnSearch" data-loading-text="Submitting..." autocomplete="off" class="btn-xs btn-primary clickcls" style="width:90px; height:30px; background-color: #ccc; border-color: #4e4e4e; color: #0c0c0c;" name="value">
                            Search
                        </button>
                        @*<input name="ExportData" type="submit" value="Export to excel" class="button" title="Export Data" />*@

                        @* <a id="btnExport" href="/A00Submit/ActivityListExportToExcel" name="value" data-loading-text="Export..." autocomplete="off" class="btn-xs btn-primary" style="height:30px; background-color: #ccc; border-color: #4e4e4e; color: #0c0c0c;" value="Export to Excel">
                            Export to Excel
                        </a>*@
                        &nbsp; &nbsp; &nbsp;
                        <button type="button" class="btn-xs btn-primary" id="CancelBtnClick"
                                style="width:90px; height:30px; background-color: #ccc; border-color: #4e4e4e; color: #0c0c0c;">
                            Cancel
                        </button>
                        <button type="submit" id="btnExport" name="value" data-loading-text="Export..." autocomplete="off" class="btn-xs btn-primary clickcls" style="float:right; width:100px; height:30px; background-color: #ccc; border-color: #4e4e4e; color: #0c0c0c;" value="Export to excel">
                            Export to Excel
                        </button>
                        @Html.Hidden("hdnIsITDivisionHead", (object)Convert.ToString(ViewBag.List[0].isITDivisionHead))
                    </td>
                </tr>


            </table>
        </div>
    }
    @if (Model != null)
    {
        <div id="searchResults">
            <table class="table" style="font-size:13px; border:1px solid #dddddd;">
                <tr class="tcat">
                    <th style="border: 1px solid #dddddd; text-align:center; width:3%;">S.No</th>
                    <th style="border: 1px solid #dddddd; text-align:center; width:5%;">@Html.DisplayName("Ki")</th>
                    <th style="border: 1px solid #dddddd; width:5%;text-align:center">@Html.DisplayName("E Code")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Emp. Name")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Activity Title")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Start Date")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("End Date")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Status")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Remark")</th>
                    <th style="border: 1px solid #dddddd; width:6%;text-align:center">@Html.DisplayName("Action")</th>
                    <th style="border: 1px solid #dddddd; width:6%;text-align:center">@Html.DisplayName("View")</th>
                </tr>
                @if (Model?.ResultList?.Count > 0)
                {
                    int i = 1;
                    foreach (var item in Model.ResultList)
                    {
                        <tr>
                            <td style="border: 1px solid #dddddd;text-align:center;">@i</td>
                            <td style="border: 1px solid #dddddd;text-align:center;">@Html.DisplayFor(ModelItem => item.KICODE)</td>
                            <td style="border: 1px solid #dddddd;text-align:center;">@Html.DisplayFor(ModelItem => item.ECode)</td>
                            <td style="border: 1px solid #dddddd;text-align:center;">@Html.DisplayFor(ModelItem => item.EmpName)</td>
                            <td style="border: 1px solid #dddddd;text-align:center;">@Html.DisplayFor(ModelItem => item.ActivityTitle)</td>
                            <td style="border: 1px solid #dddddd;text-align:center;">@Html.DisplayFor(ModelItem => item.ActivityStartDate, "{0:dd/MM/yyyy}")</td>
                            <td style="border: 1px solid #dddddd;text-align:center;">@Html.ValueFor(ModelItem => item.ActivityEndDate, "{0:dd/MM/yyyy}")</td>
                            @{
                                var Status = "";
                            }
                            @if (item.STATUSCD == 1)
                            {
                                if (item.ActivitySchedule == 1)
                                {
                                    Status = "In Process";
                                }
                                else if (item.ActivitySchedule == 2)
                                {
                                    Status = "Completed";
                                }
                                else
                                {
                                    Status = "Not Started";
                                }
                            }
                            else
                            {
                                Status = "Save As Draft";
                            }
                            <td style="border: 1px solid #dddddd;text-align:center;">@Status</td>
                            <td style="border: 1px solid #dddddd;text-align:center;"><p class="show-read-more">@Html.DisplayFor(ModelItem => item.ActivityRemark)</p></td>
                            <td style="border: 1px solid #dddddd;text-align:center;">
                                @if (item.UserId == item.ECode)
                                {
                                    if (item.STATUSCD == 1)
                                    {
                                        if (item.ActivitySchedule == 0 || item.ActivitySchedule == 1)
                                        {
                                            <a href='@Url.Action("A00ActivityUpdate", "A00Submit", new { item.ActivityId })' class="glyphicon glyphicon-pencil"></a>
                                        }
                                        else if (item.ActivitySchedule == 2)
                                        {
                                            <label>-</label>
                                        }
                                    }
                                    else
                                    {
                                        <a href='@Url.Action("A00Activity", "A00Submit", new { item.ActivityId })' class="glyphicon glyphicon-pencil"></a>
                                    }
                                }
                                else
                                {
                                    <label>-</label>
                                }
                            </td>
                            <td style="border: 1px solid #dddddd;text-align:center;">
                                <a href='@Url.Action("A00ActivityView", "A00Submit", new
                                    { item.ActivityId })' class="glyphicon glyphicon-eye-open"></a>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10"> No record found.</td>
                    </tr>
                }
            </table>
        </div>
        //}
    }
    else
    {
        <div id="searchResults">
            <table class="table" style="font-size:13px; border:1px solid #dddddd;">
                <tr style="background-color: #fdf59a;">
                    <th style="border: 1px solid #dddddd; text-align:center; width:3%;">@Html.DisplayName("S.No")</th>
                    <th style="border: 1px solid #dddddd; text-align:center; width:5%;">@Html.DisplayName("Ki")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("E Code")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Emp. Name")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Activity Title")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Start Date")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("End Date")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Status")</th>
                    <th style="border: 1px solid #dddddd; width:10%;text-align:center">@Html.DisplayName("Remark")</th>
                    <th style="border: 1px solid #dddddd; width:6%;text-align:center">@Html.DisplayName("Action")</th>
                    <th style="border: 1px solid #dddddd; width:6%;text-align:center">@Html.DisplayName("View")</th>
                </tr>
                <tr>
                    <td colspan="10"> No record found.</td>
                </tr>
            </table>
        </div>
    }

    <table class="table table-bordered table-hover table-responsive">
        <tr style="background-color:#f3f3f3">
            <td style="height: 20px;font-size: 14px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td colspan="4">
                                <a title="Back" href="/home/home">
                                    <img src="~/images/icon_back.gif" border="0" alt="">
                                    Back
                                </a>
                            </td>

                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>

@section scripts {
    @* @Scripts.Render("~/bundles/jqueryval") *@
    <script src="~/js/jquery.validate.min.js"></script>
    <script type="text/javascript" language="Javascript" src="~/js/jquery-ui.js"></script>
    @* <script src="~/lib/bootstrap/js/bootstrap.js"></script> *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        var msg = '@ViewBag.Msg';
        if (msg.length) {
            alert(msg);
        };
        $(document).ready(function () {
            $("#CancelBtnClick").click(function () {
                location.reload(true);
            });
            BindDivision("#ddlOp", 0);
            BindDepartment("#ddlDiv", 0);
            BindSection("#ddlDep", 0);
        });

        $('#btnSearch').on('click', function () {
            $('form').validate();
            if ($('form').valid())
                $(this).button('loading') // button text will be "finished!"
        });
    </script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        ////======== Bind Operation on document ready========////
        function BindOperationBySykiId(crnt, call) {
            var kiID = $(crnt).val();
            var select_ddlOp = $("#ddlOp");
            var select_ddlDiv = $("#ddlDiv");
            var select_ddlDep = $("#ddlDep");
            var select_ddlSec = $("#ddlSec");
            select_ddlOp.empty(); select_ddlDiv.empty(); select_ddlDep.empty(); select_ddlSec.empty();

            select_ddlOp.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlDiv.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlDep.append($('<option />', { value: "0", text: "--Please wait--" }));
            select_ddlSec.append($('<option />', { value: "0", text: "--Please wait--" }));
            if (kiID != "" && kiID != "0") {
                $.getJSON("/A00Submit/BindOperationByUserIDandSykiId", { SYKIID: kiID },
                          function (data) {
                              select_ddlOp.empty(); select_ddlDiv.empty(); select_ddlDep.empty(); select_ddlSec.empty();
                              if (data.length > 0) {
                                  $.each(data, function (index, itemData) {
                                      if (itemData.OPERATIONID > 0)
                                          select_ddlOp.append($('<option />', { value: itemData.OPERATIONID, text: itemData.OPERATION }));
                                      else
                                          select_ddlOp.append($('<option />', { value: "0", text: "--No record--" }));

                                      if (itemData.DIVISIONID > 0)
                                          select_ddlDiv.append($('<option />', { value: itemData.DIVISIONID, text: itemData.DIVISION }));
                                      else
                                          BindDivision("#ddlOp", 0);

                                      if (itemData.DEPARTMENTID > 0)
                                          select_ddlDep.append($('<option />', { value: itemData.DEPARTMENTID, text: itemData.DEPARTMENT }));
                                      else
                                          BindDepartment("#ddlDiv", 0);

                                      if (itemData.SECTIONID > 0)
                                          select_ddlSec.append($('<option />', { value: itemData.SECTIONID, text: itemData.SECTION }));
                                      else
                                          BindSection("#ddlDep", 0);
                                  });
                              }
                              else {
                                  select_ddlOp.append($('<option />', { value: "0", text: "--No record--" }));
                                  select_ddlDiv.append($('<option />', { value: "0", text: "--No record--" }));
                                  select_ddlDep.append($('<option />', { value: "0", text: "--No record--" }));
                                  select_ddlSec.append($('<option />', { value: "0", text: "--No record--" }));
                              }
                          });
            }
            else {
                select_ddlOp.empty(); select_ddlDiv.empty(); select_ddlDep.empty(); select_ddlSec.empty();
                select_ddlOp.append($('<option />', { value: "0", text: "--Select Ki First--" }));
                select_ddlDiv.append($('<option />', { value: "0", text: "--Select--" }));
                select_ddlDep.append($('<option />', { value: "0", text: "--Select--" }));
                select_ddlSec.append($('<option />', { value: "0", text: "--Select--" }));
            }
        };
        ////======== Bind Division on document ready========////
        function BindDivision(crnt, call) {
            var oID = $(crnt).val();
            var SYKIID = $("#SearchParams_SYKI").val();
            var select = $("#ddlDiv");
            if (select.val() == "" || select.val() == "0" || select.val() == null) {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Please wait--"
                }));
                if (oID != "") {
                    $.getJSON("/A00Submit/BindDivisionByOperationId", { id: oID, SYKIID: SYKIID },
                              function (data) {
                                  select.empty();
                                  if (data.length > 0) {
                                      select.append($('<option />', {
                                          value: "",
                                          text: "--Select--"
                                      }));
                                      $.each(data, function (index, itemData) {
                                          select.append($('<option />', {
                                              value: itemData.DIVISIONID,
                                              text: itemData.DIVISION
                                          }));
                                      });
                                      if('@Model.SearchParams.DIVISIONID' != 0)
                                          select.val('@Model.SearchParams.DIVISIONID');
                                      BindDepartment($("#ddlDiv"), "0");
                                      BindSection($("#ddlDep"), "0");
                                  }
                                  else {
                                      select.append($('<option />', {
                                          value: "",
                                          text: "--No record--"
                                      }));
                                  }
                              });
                }
                else {
                    select.empty();
                    select.append($('<option />', {
                        value: "",
                        text: "--Select--"
                    }));
                    BindDepartment($("#ddlDiv"), "0");
                    BindSection($("#ddlDep"), "0");
                }
            }
        };

        ////======== Bind Department on document ready========////
        function BindDepartment(crnt, call) {
            var dID = $(crnt).val();
            var SYKIID = $("#SearchParams_SYKI").val();
            var select = $("#ddlDep");
            if (select.val() == "" || select.val() == "0" || select.val() == null) {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Please wait--"
                }));
                if (dID != "") {
                    $.getJSON("/A00Submit/BindDeptByDivisionId", { id: dID, SYKIID: SYKIID },
                           function (data) {
                               select.empty();
                               if (data.length > 0) {
                                   select.append($('<option />', {
                                       value: "",
                                       text: "--Select--"
                                   }));
                                   $.each(data, function (index, itemData) {
                                       select.append($('<option />', {
                                           value: itemData.DEPARTMENTID,
                                           text: itemData.DEPARTMENT
                                       }));
                                   });
                                   debugger;
                                   if('@Model.SearchParams.DEPARTMENTID' != 0)
                                       select.val('@Model.SearchParams.DEPARTMENTID');
                                   BindSection($("#ddlDep"), "0");
                               }
                               else {
                                   select.append($('<option />', {
                                       value: "",
                                       text: "--No record--"
                                   }));
                               }
                           });
                } else {
                    select.empty();
                    select.append($('<option />', {
                        value: "",
                        text: "--Select--"
                    }));
                    BindSection($("#ddlDep"), "0");
                }
            }
        };

        ////======== Bind Section on document ready========////
        function BindSection(crnt, call) {
            var dID = $(crnt).val();
            var SYKIID = $("#SearchParams_SYKI").val();
            var select = $("#ddlSec");
            if (select.val() == "" || select.val() == "0" || select.val() == null) {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Please wait--"
                }));
                if (dID != "") {
                    $.getJSON("/A00Submit/BindSecByDepartmentId", { id: dID, SYKIID: SYKIID },
                           function (data) {
                               select.empty();
                               if (data.length > 0) {
                                   select.append($('<option />', {
                                       value: "",
                                       text: "--Select--"
                                   }));
                                   $.each(data, function (index, itemData) {
                                       select.append($('<option />', {
                                           value: itemData.SECTIONID,
                                           text: itemData.SECTION
                                       }));
                                   });
                                   if('@Model.SearchParams.SECTIONID' != 0)
                                       select.val('@Model.SearchParams.SECTIONID');
                               }
                               else {
                                   select.append($('<option />', {
                                       value: "",
                                       text: "--No record--"
                                   }));
                               }
                           });
                } else {
                    select.empty();
                    select.append($('<option />', {
                        value: "",
                        text: "--Select--"
                    }));
                }
            }
        };

        ////======== Bind Division on change of Operation========////
        function BindDivisionOnChange(crnt, call) {
            var oID = $(crnt).val();
            var SYKIID = $("#SearchParams_SYKI").val();
            var select = $("#ddlDiv");
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Please wait--"
            }));
            if (oID != "") {
                $.getJSON("/A00Submit/BindDivisionByOperationId", { id: oID, SYKIID: SYKIID },
                          function (data) {
                              select.empty();
                              if (data.length > 0) {
                                  select.append($('<option />', {
                                      value: "",
                                      text: "--Select--"
                                  }));
                                  $.each(data, function (index, itemData) {
                                      select.append($('<option />', {
                                          value: itemData.DIVISIONID,
                                          text: itemData.DIVISION
                                      }));
                                  });
                                  BindDepartment($("#ddlDiv"), "0");
                                  BindSection($("#ddlDep"), "0");
                              }
                              else {
                                  select.append($('<option />', {
                                      value: "",
                                      text: "--No record--"
                                  }));
                              }
                          });
            }
            else {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Select--"
                }));
                BindDepartmentOnChange($("#ddlDiv"), "0");
                BindSectionOnChange($("#ddlDep"), "0");
            }
        };

        ////======== Bind Department on change Of Division========////
        function BindDepartmentOnChange(crnt, call) {
            var dID = $(crnt).val();
            var SYKIID = $("#SearchParams_SYKI").val();
            var select = $("#ddlDep");
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Please wait--"
            }));
            if (dID != "") {
                $.getJSON("/A00Submit/BindDeptByDivisionId", { id: dID, SYKIID: SYKIID },
                       function (data) {
                           select.empty();
                           if (data.length > 0) {
                               select.append($('<option />', {
                                   value: "",
                                   text: "--Select--"
                               }));
                               $.each(data, function (index, itemData) {
                                   select.append($('<option />', {
                                       value: itemData.DEPARTMENTID,
                                       text: itemData.DEPARTMENT
                                   }));
                               });
                               BindSection($("#ddlDep"), "0");
                           }
                           else {
                               select.append($('<option />', {
                                   value: "",
                                   text: "--No record--"
                               }));
                           }
                       });
            } else {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Select--"
                }));
                BindSectionOnChange($("#ddlDep"), "0");
            }
        };

        ////======== Bind Section on change of Department========////
        function BindSectionOnChange(crnt, call) {
            var dID = $(crnt).val();
            var SYKIID = $("#SearchParams_SYKI").val();
            var select = $("#ddlSec");
            select.empty();
            select.append($('<option />', {
                value: "",
                text: "--Please wait--"
            }));
            if (dID != "") {
                $.getJSON("/A00Submit/BindSecByDepartmentId", { id: dID, SYKIID: SYKIID },
                       function (data) {
                           select.empty();
                           if (data.length > 0) {
                               select.append($('<option />', {
                                   value: "",
                                   text: "--Select--"
                               }));
                               $.each(data, function (index, itemData) {
                                   select.append($('<option />', {
                                       value: itemData.SECTIONID,
                                       text: itemData.SECTION
                                   }));
                               });
                           }
                           else {
                               select.append($('<option />', {
                                   value: "",
                                   text: "--No record--"
                               }));
                           }
                       });
            } else {
                select.empty();
                select.append($('<option />', {
                    value: "",
                    text: "--Select--"
                }));
            }
        };
    </script>

    @if (TempData["result"] != null)
    {
        if (Convert.ToInt16(TempData["result"]) == 0)
        {
            <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
                alert("Activity has been saved successfully.");
            </script>
        }
        else if (Convert.ToInt16(TempData["result"]) == 1)
        {
            <script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
                alert("Activity has been submitted successfully.");
            </script>
        }
        else if (Convert.ToInt16(TempData["result"]) == 2)
        {
            <script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
                alert("Activity has been updated successfully.");
            </script>
        }
        else if (Convert.ToInt16(TempData["result"]) == 3)
        {
            <script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
                alert("The activity has been already completed. Please start new activity.");
            </script>
        }
    }
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
        $(document).ready(function () {
            var maxLength = 50;
            $(".show-read-more").each(function () {
                var myStr = $(this).text();
                if ($.trim(myStr).length > maxLength) {
                    var newStr = myStr.substring(0, maxLength);
                    var removedStr = myStr.substring(maxLength, $.trim(myStr).length);
                    $(this).empty().html(newStr);
                    $(this).append(' <span id="showMoreLess" class="more-text">' + removedStr + '</span>');
                    $(this).append(' <a data-ctrl="anc-read-more" href="#" class="read-more">read more...</a>');
                    $(this).append(' <a  data-ctrl="anc-read-less" href="#" class="read-less hidelink">read less...</a>');

                }
            });
            $(document).on('click', '[data-ctrl="anc-read-more"]', function (e) {
                e.preventDefault();
            });
            $(document).on('click', '[data-ctrl="anc-read-less"]', function (e) {
                e.preventDefault();
            });

            $(".read-more").click(function () {
                $(this).siblings("#showMoreLess").removeClass("more-text");
                $(this).addClass("hidelink").siblings().removeClass("hidelink");
            });
            $(".read-less").click(function () {
                $(this).siblings("#showMoreLess").addClass("more-text");
                $(this).addClass("hidelink").siblings().removeClass("hidelink");
            });
        });
    </script>


