@model ePortal.ViewModels.A00AcitivtyVM

@{
    ViewBag.Title = "Update Activity";
    Layout = "~/Views/Shared/_LayoutA00.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/jquery-ui.css">
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .fileUpload input[type=file] {
            display: none;
        }

        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .multiselect dropdown-toggle btn btn-default {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            /*.text-right {
                text-align: right;
                vertical-align: middle;
                width: 20%;
                font-size: 14px;
                font-family: roboto-bold;
                color: #000000;
            }*/

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }
    </style>
}
<div class="row">

    @using (Html.BeginForm("A00ActivityUpdate", "A00Submit", FormMethod.Post, new { @name = "A00ActivityUpdate" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary("", new { @class = "text-danger" })

        <div class="body-content" style="overflow-x:hidden">
            <div id="msform">
                <input type="hidden" id="hdnA00ActivityID" name="hdnA00ActivityID" value="@ViewBag.A00ActivityID" />
                <table class="table table-responsive table-bordered table-condensed table-striped" style="border-color: #CCDCE0; border-width: 1px; border-style: solid;" width="99%">
                    <tbody>
                        <tr>
                            <td class="text-right" style="width:30%;">
                                <b>Activity Name</b> <span class="mandatory" style="color:red;">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.ActivityName, new
                                    {
                                        @class = "form-control",
                                        @maxlength = "100",
                                        @disabled = "disabled"
                                    })
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right">
                                <b>Activity Details</b> <span class="mandatory" style="color:red;">*</span>
                            </td>
                            <td>
                                @Html.TextAreaFor(m => m.ActivityDetails, new
                                    {
                                        @class = "form-control",
                                        @maxlength = "500",
                                        @disabled = "disabled"
                                    })
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right">
                                <b>Activity Start Date</b> <span class="mandatory" style="color:red;">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.ActivityStartDate, new
                                    {
                                        @class = "form-control",
                                        @maxlength = "10",
                                        @placeholder = "dd/mm/yyyy",
                                        @autocomplete = "off",
                                        @disabled = "disabled"
                                    })
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right">
                                <b>Activity End Date</b> <span class="mandatory" style="color:red;">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.ActivityEndDate, new
                                    {
                                        @class = "form-control",
                                        @maxlength = "10",
                                        @placeholder = "dd/mm/yyyy",
                                        @autocomplete = "off",
                                        @disabled = "disabled"
                                    })  @*Dinesh*@
                                <label id="ActivityEndDate-error" class="error" for="ActivityEndDate"></label>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right" style="width:30%;">
                                <b>Activity Schedule</b> <span class="mandatory" style="color:red;">*</span>
                            </td>
                            <td>
                                <select class="form-control" id="ActivitySchedule" name="ActivitySchedule">
                                    <option value="">Select</option>
                                    <option value="0">Not Started</option>
                                    <option value="1">In Process</option>
                                    <option value="2">Completed</option>
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right" style="width:30%;">
                                <b>Activity Remark</b> <span class="mandatory" style="color:red;">*</span>
                            </td>
                            <td>
                                @Html.TextArea("ActivityRemarks", new
                                    {
                                        @class = "form-control",
                                        @name = "ActivityRemarks",
                                        @maxlength = "500"
                                    })
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>

        <div class="row clear-both" style="margin-top:10px;">
            <div class="col-md-12 center">
                <input type="submit" value="Update" class="bttn btn-success" data-loading-text="Submitting..." autocomplete="off"
                       name="btnSubmit" id="btnSubmit" style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold;" />


                <input type='button' id='btnBack' class="bttn btn-success"
                       style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold;" value='Back' />

            </div>

        </div>
    }
    <br />
    <table class="table table-bordered table-hover table-responsive" style="margin-top:10px;">
        <tr style="background-color:#f3f3f3">
            <td style="height: 20px;font-size: 14px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td colspan="4">

                                <a title="Back" href="#" data-ctrl="btn-back">
                                    <img src="~/images/icon_back.gif" border="0" alt="">
                                    Back
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>


@section  scripts {
    @*@Scripts.Render("~/bundles/jqueryval")*@
    <script src="~/js/jquery.validate.js"></script>
    
<script type="text/javascript" language="Javascript" src="~/js/jquery-ui.js"></script>
    @* <script src="~/lib/bootstrap/js/bootstrap.js"></script> *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('#btnSubmit').on('click', function () {
            $('form').validate();
            if ($('form').valid())
                $(this).button('loading') // button text will be "finished!"
        });

    </script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $("form[name='A00ActivityUpdate']").validate({
            // Specify validation rules
            rules: {
                ActivitySchedule: "required",
                ActivityRemarks: "required",
            },
            // Specify validation error messages
            messages: {
                ActivitySchedule: "Please select Activity Schedule",
                ActivityRemarks: "Please enter Activity Remark",
            },
            // Make sure the form is submitted to the destination defined
            // in the "action" attribute of the form when valid
            submitHandler: function (form) {
                form.submit();
            }
        });

    </script>


    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        var msg = '@ViewBag.Msg';
        if (msg.length) {
            alert(msg);
        }
    </script>


    @*CSP 3.0 Compliant Changes*@

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
        $(document).ready(function () {
            $('#btnBack').on('click', function () {
                window.location = document.referrer;
            });

            $('[data-ctrl="btn-back"]').on('click', function (e) {
                e.preventDefault();
                window.location = document.referrer;
            });
        });
    </script>
}
