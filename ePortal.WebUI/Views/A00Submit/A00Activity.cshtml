<div class="row">
    <div class="form-group right" style="margin-top: -49px; font-size: 16px; font-weight: bold;">
        <button type="button" class="btn btn-success" data-ctrl="manage-btn" title="Click here to Manage the Activity"
                style="width:150px !important; background-color: #ccc; border-color: rgba(0, 0, 0, 0.4); color: #232121; font-weight: bold">
            Manage Activity
        </button>
    </div>
</div>
<div class="row">
    @using (Html.BeginForm("A00Activity", "A00Submit", FormMethod.Post, new { @name = "A00ActivitySaveData" }))
    {
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ActivityID)
    <div class="body-content" style="overflow-x:hidden">
        <div id="msform">

            <table class="table table-bordered table-hover table-responsive">
                <tbody>
                    <tr>
                        <td class="text-right" style="width:30%;">
                            <b>Activity Name</b> <span class="mandatory" style="color:red;">*</span>
                        </td>
                        <td>
                            @Html.TextBoxFor(m => m.ActivityName, new
                       {
                           @class = "form-control",
                           @maxlength = "100",
                       })
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">
                            <b>Activity Details</b> <span class="mandatory" style="color:red;">*</span>
                        </td>
                        <td>
                            @Html.TextAreaFor(m => m.ActivityDetails, new
                       {
                           @class = "form-control",
                           @maxlength = "500",
                       })
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">
                            <b>Activity Start Date</b> <span class="mandatory" style="color:red;">*</span>
                        </td>
                        <td>
                            @Html.TextBoxFor(m => m.ActivityStartDate, new
                       {
                           @class = "form-control",
                           @maxlength = "10",
                           @placeholder = "dd/mm/yyyy",
                           @autocomplete = "off"
                       })
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">
                            <b>Activity End Date</b> <span class="mandatory" style="color:red;">*</span>
                        </td>
                        <td>
                            @Html.TextBoxFor(m => m.ActivityEndDate, new
                       {
                           @class = "form-control",
                           @maxlength = "10",
                           @placeholder = "dd/mm/yyyy",
                           @autocomplete = "off"
                       })  @*Dinesh*@
                    <label id="ActivityEndDate-error" class="error" for="ActivityEndDate"></label>
                </td>
            </tr>
        </tbody>
    </table>
</div>
</div>

<div class="row clear-both" style="margin-top:10px;">
    <div class="col-md-12 center">
        <input type="submit" value="Save as Draft" class="bttn btn-success" data-loading-text="Submitting..." autocomplete="off"
               name="btnSaveAsDraft" id="btnSaveAsDraft" style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold;" />

        <input type="submit" value="Submit" class="bttn btn-success" data-loading-text="Submitting..." autocomplete="off"
               name="btnSubmit" id="btnSubmit" style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold;" />

        <button type="button" id="btnReset" class="bttn btn-success" style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold;">Reset</button>

        <input type='button' id='btnBack' class="bttn btn-success"
               style="background-color: #ccc; border-color: #4e4e4e; color: #232121; font-weight : bold;" value='Back' />

    </div>

</div>
    }
    <br />
    <table class="table table-bordered table-hover table-responsive">
        <tr style="background-color:#f3f3f3">
            <td style="height: 20px;font-size: 14px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td colspan="4">
                                <a title="Back" href="/home/home">
                                    <img src="~/images/icon_back.gif" border="0" alt="">
                                    Back
                                </a>
                            </td>

                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>


@section  scripts{
    @* @Scripts.Render("~/bundles/jqueryval") *@
    @* <script type="text/javascript" language="Javascript" src="~/js/jquery-ui.js"></script> *@
    <script type="text/javascript" language="Javascript" src="~/js/jquery-ui.min.js"></script>
    @* <script src="~/lib/bootstrap/js/bootstrap.js"></script> *@
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script>
    <script src="~/js/jquery.validate.min.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(function () {
            $('#ActivityStartDate').datepicker({
                format: "dd/mm/yyyy",
                todayHighlight: true,
                autoclose: true,
                clearBtn: true,
            });
            $('#ActivityEndDate').datepicker({
                format: "dd/mm/yyyy",
                todayHighlight: true,
                autoclose: true,
                clearBtn: true,
            });

        });
    </script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $('#btnSubmit').on('click', function () {
            var istart = document.getElementById("ActivityStartDate").value;
            var iend = document.getElementById("ActivityEndDate").value;
            var splitStrtDate = istart.split("/");
            var splitEndDate = iend.split("/");
            var strtDate = new Date(splitStrtDate[2], Number(splitStrtDate[1]) - 1, splitStrtDate[0]);
            var endDate = new Date(splitEndDate[2], Number(splitEndDate[1]) - 1, splitEndDate[0]);
            if (endDate - strtDate < 0) {
                $("#ActivityEndDate-error").text("End Date should be greater then Start Date.").css('display', 'block');
                document.getElementById("ActivityEndDate").focus();
                return false;
            }
            else {
                $("#ActivityEndDate-error").css('display', 'none');
            }
            $('form').validate();
            if ($('form').valid())
                $(this).button('loading') // button text will be "finished!"
        });

        $('#btnSaveAsDraft').on('click', function () {
            var istart = document.getElementById("ActivityStartDate").value;
            var iend = document.getElementById("ActivityEndDate").value;
            var splitStrtDate = istart.split("/");
            var splitEndDate = iend.split("/");
            var strtDate = new Date(splitStrtDate[2], Number(splitStrtDate[1]) - 1, splitStrtDate[0]);
            var endDate = new Date(splitEndDate[2], Number(splitEndDate[1]) - 1, splitEndDate[0]);
            if (endDate - strtDate < 0) {
                $("#ActivityEndDate-error").text("End Date should be greater then Start Date.");
                document.getElementById("ActivityEndDate").focus();
                return false;
            }
            $('form').validate();
            if ($('form').valid())
                $(this).button('loading') // button text will be "finished!"
        });

    </script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        $("form[name='A00ActivitySaveData']").validate({
            // Specify validation rules
            rules: {
                ActivityName: "required",
                ActivityDetails: "required",
                ActivityStartDate: "required",
                ActivityEndDate: "required"
            },
            // Specify validation error messages
            messages: {
                ActivityName: "Please enter activity name",
                ActivityDetails: "Please enter activity details",
                ActivityStartDate: "Please select activity start date",
                ActivityEndDate: "Please select activity end date"
            },
            // Make sure the form is submitted to the destination defined
            // in the "action" attribute of the form when valid
            submitHandler: function (form) {
                form.submit();
            }
        });

    </script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
        var msg = '@ViewBag.Msg';
        if (msg.length) {
            alert(msg);
        }
    </script>

    @if (TempData["result"] != null)
    {
        if (Convert.ToInt16(TempData["result"]) == 0)
        {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
        alert("Activity has been saved successfully.");
    </script>
        }

    }


@*CSP 3.0 Compliant Changes*@

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
     $(document).ready(function () {

        $('[data-ctrl="manage-btn"]').on('click', function () {
            location.href = '@Url.Action("A00ActivityList", "A00Submit")';
        });


        $('#btnReset').on('click', function () {
            this.form.reset();
        });

        $('#btnBack').on('click', function () {
            window.location = document.referrer;
        });
    });
</script>
}