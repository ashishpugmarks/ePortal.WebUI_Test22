<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    function CheckOthers() {
        var element = document.getElementById('trIfAny');
        var select_button_text = "";
        $('#SKYLIST option:selected')
            .toArray().forEach(function (item) {
                select_button_text = select_button_text + item.text
            });
        var select = $('#Ifothers');
        if (select_button_text.indexOf('Others') == -1) {
            element.style.visibility = 'hidden';
            select.attr('required', false);
        }
        else {
            //var hdnOthers = $("#hdnOthers").val();
            //if (hdnOthers) {
            //select.val(hdnOthers);
            //}
            element.style.visibility = 'visible';
            select.attr('required', true);
        }
    }

    var _validFileExtensions = [".pdf"];
    function ValidateSingleInput(oInput) {
        if (oInput.type == "file") {
            var sFileName = oInput.value;
            if (sFileName.length > 0) {
                $("#selectedFile").style.display = "none";
                var blnValid = false;
                for (var j = 0; j < _validFileExtensions.length; j++) {
                    var sCurExtension = _validFileExtensions[j];
                    if (sFileName.substr(sFileName.length - sCurExtension.length, sCurExtension.length).toLowerCase() == sCurExtension.toLowerCase()) {
                        blnValid = true;
                        break;
                    }
                }

                if (!blnValid) {
                    alert("Only PDF file allowed");
                    oInput.value = "";
                    return false;
                }
            }
        }
        return true;
    }
</script>

