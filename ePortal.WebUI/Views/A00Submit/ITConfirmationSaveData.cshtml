<div class="row">

    @using (Html.BeginForm("ITConfirmationSaveData", "A00Submit", FormMethod.Post, new { @id = "ITConfirmationSaveData", @name = "ITConfirmationSaveData", encType = "multipart/form-data" }))
    {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary("", new { @class = "text-danger" })
    @Html.HiddenFor(x => x.A00DTLTBID)
    @Html.HiddenFor(x => x.SYKIID)
    @Html.HiddenFor(x => x.ApplicationPIC)
    @Html.HiddenFor(x => x.InfraStructurePIC)
    @Html.HiddenFor(x => x.ProjectDate)
    @Html.HiddenFor(x => x.ProjectName)
    @Html.HiddenFor(x => x.UserPL)
    @Html.HiddenFor(x => x.UserDept)
    @Html.HiddenFor(x => x.ITPL)
    @Html.HiddenFor(x => x.ITDept)
    @Html.HiddenFor(x => x.ProjectCode_Date)
    <div class="body-content" style="overflow-x:hidden">
        <div id="msform">
            <table class="table table-bordered table-hover table-responsive">
                <tbody>
                    <tr>
                        <td class="text-right">
                            <b>Project&nbsp;Code<span style="color: #ff0000">*</span></b>
                        </td>
                        <td class="col-md-3">
                            <div class="">
                                @Html.TextBoxFor(m => m.ProjectCode_Date, new
                           {
                               @class = "form-control",
                               @maxlength = "100",
                               @disabled = "disabled"
                           })

                            </div>
                        </td>

                        <td class="text-right">
                            <b>Project&nbsp;Name<span style="color: #ff0000">*</span></b>
                        </td>
                        <td class="col-md-3" colspan="3">
                            <div>
                                @Html.TextAreaFor(m => m.ProjectName, new
                           {
                               @class = "form-control",
                               @maxlength = "100",
                               @disabled = "disabled"
                           })
                            </div>
                        </td>


                    </tr>

                    <tr>
                        <td class="text-right">
                            <b>User Project Leader</b>
                        </td>
                        <td class="col-md-3">
                            <div class="">
                                @Html.TextBoxFor(m => m.UserPL_Name, new
                           {
                               @class = "form-control",
                               @maxlength = "100",
                               @disabled = "disabled"

                           })
                            </div>
                        </td>
                        <td class="text-right">
                            <b>User Dept</b>
                        </td>
                        <td class="col-md-3">
                            <div class="">

                                @Html.TextBoxFor(m => m.UserDept, new
                           {
                               @class = "form-control",
                               @maxlength = "100",
                               @disabled = "disaled"

                           })
                            </div>
                        </td>
                        <td class="text-righ">
                            <b>Impacted Operation<span style="color: #ff0000">*</span></b>
                        </td>
                        <td style="width:115px;">
                            <div>
                                <input name="ImpactedOperation" type="radio" id="rdSingle" value="1" />
                                <label for="rdSingle">Single</label><br />
                                <input name="ImpactedOperation" type="radio" id="rdMulti" value="2" />
                                <label for="rdMulti">Multi</label><br />
                            </div>
                            <label id="ImpactedOperation-error" class="error" for="ImpactedOperation"></label>
                        </td>
                    </tr>

                    <tr>
                        <td class="text-right">
                            <b>IT Project Leader</b>
                        </td>
                        <td>
                            <div class="">
                                @Html.TextBoxFor(m => m.ITPL_Name, new
                           {
                               @class = "form-control",
                               @maxlength = "100",
                               @disabled = "disabled"
                           })
                            </div>
                        </td>
                        <td class="text-right">
                            <b>IT Dept</b>
                        </td>
                        <td>
                            <div class="">

                                @Html.TextBoxFor(m => m.ITDept, new
                           {
                               @class = "form-control",
                               @maxlength = "100",
                               @disabled = "disabled"

                           })
                            </div>
                        </td>
                        <td class="text-right">
                            <b>Development<span style="color: #ff0000">*</span></b>
                        </td>
                        <td>
                            <div>
                                <input name="Development" type="radio" id="rdInternal" value="1" />
                                <label for="rdInternal">Internal</label><br />
                                <input name="Development" type="radio" id="rdExternal" value="2" />
                                <label for="rdExternal">External</label><br />
                            </div>
                            <label id="Development-error" class="error" for="Development"></label>
                        </td>
                    </tr>

                    <tr>
                        <td class="text-right">
                            <b>Stand alone application<span style="color: #ff0000">*</span></b>
                        </td>
                        <td>
                            <div class="">
                                @Html.DropDownListFor(m => m.SAA, new List<SelectListItem>
                                {
                                   new SelectListItem{ Text="Select", Value = "" },
                                   new SelectListItem{ Text="Package", Value = "Package" },
                                   new SelectListItem{ Text="Scratch Development", Value = "Scratch Development" },
                                   new SelectListItem{ Text="Enhancement in Existing Application", Value = "Enhancement in Existing Application" }
                                }, new { @class = "form-control" })
                                @*@Html.TextBoxFor(m => m.SAA, new
                                    {
                                        @class = "form-control",
                                        @maxlength = "100",
                                        //@disabled = "disabled"
                                    })*@
                            </div>
                        </td>
                        <td class="text-right">
                            <b>Linkage with existing application<span style="color: #ff0000">*</span></b>
                        </td>
                        <td colspan="3">
                            <div class="">
                                @Html.TextBoxFor(m => m.LWEA, new
                           {
                               name = "LWEA",
                               @class = "form-control",
                               @maxlength = "190",
                               //@disabled = "disabled"
                           })
                            </div>
                        </td>

                    </tr>

                    <tr>
                        <td class="text-right">
                            <b>Infrastructure Requirement<span style="color: #ff0000">*</span></b>
                        </td>
                        <td>
                            <div>
                                <input name="InfrastructureRequirement" type="radio" id="rdIRYes" value="1" />
                                <label for="rdIRYes">Yes</label>
                                <input name="InfrastructureRequirement" type="radio" id="rdIRNo" value="2" />
                                <label for="rdIRNo">No</label>
                            </div>
                            <label id="InfrastructureRequirement-error" class="error" for="InfrastructureRequirement"></label>
                        </td>
                        <td class="text-right">
                            <b>If yes, please specify Hosting on cloud/ on premises</b>
                        </td>
                        <td colspan="3">
                            <div>
                                @Html.TextBoxFor(m => m.IR, new
                           {
                               name = "IR",
                               @class = "form-control",
                               @maxlength = "190",
                               //@disabled = "disabled"
                           })
                                <label id="IRerror" class="error" for="OEM" style="display:none;"></label>

                            </div>
                        </td>

                    </tr>

                    <tr>
                        <td class="text-right">
                            <b>License required<span style="color: #ff0000">*</span></b>
                        </td>
                        <td>
                            <div>
                                <input name="LicenseRequired" type="radio" id="rdYes" value="1" />
                                <label for="rdYes">Yes</label>
                                <input name="LicenseRequired" type="radio" id="rdNo" value="2" />
                                <label for="rdNo">No</label>
                            </div>
                            <label id="LicenseRequired-error" class="error" for="LicenseRequired"></label>
                        </td>
                        <td class="text-right">
                            <b>If yes, please specify (In case of indirect usage, please verify with OEM)</b>
                            @*<b>(If Yes,Specify)(In case of indirect<br />usage,&nbsp;verify&nbsp;with OEM)</b>*@
                        </td>
                        <td colspan="3">
                            <div>
                                @Html.TextBoxFor(m => m.OEM, new
                           {
                               name = "OEM",
                               @class = "form-control",
                               @maxlength = "190",
                               //@disabled = "disabled"
                           })
                                <label id="OEMerror" class="error" for="OEM" style="display:none;"></label>
                            </div>
                        </td>
                    </tr>

                    <tr>

                        <td class="text-right">
                            <b>Application<span style="color: #ff0000">*</span></b>
                        </td>
                        <td>
                            <div>
                                <select class="form-control" id="Application" name="Application">
                                    <option selected="selected" value="">Select</option>
                                    <option value="1">New</option>
                                    <option value="2">Existing</option>
                                </select>
                                <label id="Applicationerror" class="error" for="Application" style="display:none;"></label>
                            </div>
                        </td>
                        <td class="text-right"><b>No of screens<span style="color: #ff0000">*</span></b> </td>
                        <td>
                            <div style="padding-right: 0px;">

                                @Html.TextBoxFor(m => m.NOFS, new
                           {
                               name = "NOFS",
                               @class = "form-control",
                               @type = "number",
                               @min = "0",
                               @data_ctrl="txt-nofs"
                           })
                            </div>
                        </td>
                        <td class="text-right">
                            <b>HSDM/CR<span style="color: #ff0000">*</span></b>
                        </td>
                        <td>
                            <div>
                                @*@Html.TextBoxFor(m => m.HSDM, new
                                    {
                                        name = "HSDM",
                                        @class = "form-control",
                                        @disabled = "disabled"
                                    })*@
                                @Html.DropDownListFor(m => m.HSDM, new List<SelectListItem>
                                {
                                   new SelectListItem{ Text="HSDM", Value = "HSDM" },
                                   new SelectListItem{ Text="CR", Value = "CR" }
                                }, new { @class = "form-control", @disabled = "disabled" })

                                <label id="HSDMerror" class="error" for="HSDM" style="display:none;"></label>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td class="text-right"><b>Tentative one time and recurring cost (Rs.)<span style="color: #ff0000">*</span></b> </td>
                        <td>
                            <div class="col-md-6" style="padding-right: 2px;">

                                @Html.TextBoxFor(m => m.OTC, new
                           {
                               name = "OTC",
                               @class = "form-control",
                               @maxlength = "190",
                               @placeholder = "One Time",
                               // @disabled = "disabled"
                           })
                            </div>
                            <div class="col-md-6" style="padding-right: 0px;">
                                @Html.TextBoxFor(m => m.RC, new
                           {
                               name = "RC",
                               @class = "form-control",
                               @maxlength = "190",
                               @placeholder = "Recurring",
                               //@disabled = "disabled"
                           })
                            </div>
                        </td>
                        <td class="text-right">
                            <b>Tentative Time line<span style="color: #ff0000">*</span></b>
                        </td>
                        <td>
                            <div>
                                @Html.TextBoxFor(m => m.TTimeLine, new
                           {
                               name = "TTimeLine",
                               @class = "form-control",
                               @maxlength = "190",
                               //@disabled = "disabled"
                           })
                            </div>
                        </td>
                        <td class="text-right">
                            <b>U0 Target<span style="color: #ff0000">*</span></b>
                        </td>
                        <td>
                            <div>
                                @Html.TextBoxFor(m => m.UOTarget, new
                           {
                               name = "UOTarget",
                               @class = "form-control",
                               @maxlength = "190",
                               @placeholder = "dd/mm/yyyy",
                               //@disabled = "disabled"
                           })
                            </div>
                        </td>

                    </tr>

                    <tr>
                        <td class="text-right"><b>Remarks<span style="color: #ff0000">*</span></b>  </td>
                        <td colspan="5">
                            <div>
                                @Html.TextBoxFor(m => m.Remarks, new
                           {
                               name = "remarks",
                               @class = "form-control",
                               @maxlength = "190"
                           })
                            </div>
                        </td>
                    </tr>

                    @*22-Sept-2021 change start*@
                    <tr>
                        <td class="text-right">
                            <b>Attachment</b>@*<span style="color: #ff0000">*</span>*@
                            <br />
                            <span style="color:red;" class="form-inline">(Only PDF file allowed.)</span>
                        </td>
                        <td colspan="5">
                            @if (Model.ImagePath != "" && Model.ImagePath != null)
                                {
                            <table style="width:100%" border="1">
                                <tr>
                                    <td style="width:90%; padding-top: 20px; padding-bottom: 20px; padding-left: 10px;">
                                        <input name="ImageFile" id="ImageFile" type="file" accept=".pdf" />
                                    </td>
                                    <td>
                                        <a href="@Url.Action("DownloadFile", "A00Submit", new { FileName = @Model.ImagePath })" class="btn btn-warning">
                                            Download
                                            <span class="glyphicon glyphicon-download" aria-hidden="true"></span>
                                        </a>
                                    </td>
                                </tr>
                            </table>
                            <input type="hidden" id="isFileExist" name="isFileExist" value="Y" />
                                }
                                else
                                {
                            <div>
                                <input name="ImageFile" id="ImageFile" type="file" accept=".pdf" />
                                <input type="hidden" id="isFileExist" name="isFileExist" value="N" />
                            </div>
                                }
                        </td>
                    </tr>
                    @*22-Sept-2021 change end*@

                    <tr>
                        <td colspan="6" style="text-align:center;">
                            <div class="col-md-12" style="align-items: center;">
                                @if ((ViewBag.DeficiencyStatus == 1 || ViewBag.DeficiencyStatus == 2 || ViewBag.DeficiencyStatus == 3))
                                    {
                                <span>Sorry, you can not fill the IT confirmation form until the deficiency is closed.</span>
                                    }
                                    else
                                    {
                                <input type="submit" class="bttn btn-success btn_disable" value="Submit" id="btnSubmit"
                                       name="btnSubmit" data-loading-text="Submitting..." autocomplete="off" style="background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" />


                                <input type="submit" value="Save as Draft" class="bttn btn-success btn_disable"
                                       name="btnSaveDraft" id="btnSaveAsDraft" data-loading-text="Saving..." autocomplete="off"
                                       style="background-color: #ccc; border-color: #4e4e4e; align-items: center;width: 10%;color: #232121;font-weight : bold ;" />


                                <input value="Reset" type="button" class="bttn btn-success btn_disable" name="btnReset"
                                       id="btnReset" style="background-color: #ccc; border-color: #4e4e4e;align-items: center;width: 10%;color: #232121;font-weight : bold ;" />
                                    }

                                <input type='button' id='btnBack' class="bttn btn-success btn_disable"
                                       style="background-color: #ccc;width: 10%;color: #232121; font-weight : bold ;border-color: #4e4e4e;" value='Back' />

                            </div>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>
    }
    <table class="table table-bordered table-hover table-responsive" style="margin-top:10px;">
        <tr style="background-color:#f3f3f3">
            <td style="height: 20px;font-size: 14px;">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td colspan="4">
                                <a title="Back" href="#" data-ctrl="btn-back">
                                    <img src="~/images/icon_back.gif" border="0" alt="">
                                    Back
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</div>
@section  scripts{
    @* @Scripts.Render("~/bundles/jqueryval") *@
    <script type="text/javascript" language="Javascript" src="~/js/jquery-ui.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.js"></script>
    <script src="~/js/jquery.validate.min.js"></script>
    @*<script type="text/javascript" language="Javascript" src="~/js/jquery-ui.min.js"></script>*@
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(function () {
            $('#UOTarget').datepicker({
                format: "dd/mm/yyyy",
                todayHighlight: true,
                autoclose: true,
                clearBtn: true,

            });

        });


    </script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            var ITCONFIRMATIONID = '@Model.ITCONFIRMATIONID';
            if (ITCONFIRMATIONID != '0' && ITCONFIRMATIONID != '') {
                var Application = $("#Application").val('@ViewBag.Application');
                var HSDMCR = $("#HSDM").val('@ViewBag.HSDMCR');
                var IO = '@Model.ImpactedOperation';//$("#ImpactedOperation").val();
                var Development = '@Model.Development'; //$("#Development").val();
                var LR = '@Model.LicenseRequired';//$("#LicenseRequired").val();
                var IR = '@Model.InfrastructureRequirement';//$("#InfrastructureRequirement").val();
                if (IO == 1) {
                    $('#rdSingle').attr('checked', true);
                }
                else {
                    $('#rdMulti').attr('checked', true);
                }
                if (Development == 1) {
                    $('#rdInternal').attr('checked', true);
                }
                else {
                    $('#rdExternal').attr('checked', true);
                }
                if (LR == 1) {
                    $('#rdYes').attr('checked', true);
                    $('#OEM').removeAttr('disabled');
                }
                else {
                    $('#rdNo').attr('checked', true);
                    $('#OEM').attr('disabled', true);
                }
                if (IR == 1) {
                    $('#rdIRYes').attr('checked', true);
                    $('#IR').removeAttr('disabled');
                }
                else {
                    $('#rdIRNo').attr('checked', true);
                    $('#IR').attr('disabled', true);
                }
            }
        });
        $(function () {
            var queryString = location.search;
            if (queryString.length == 0) {
                $("#divPopUp").removeClass("hide");
                $("#dialog-4").dialog({
                    autoOpen: true,
                    modal: true,
                    minWidth: 900,
                    buttons: [
                        {
                            text: "New A00 Request",
                            class: 'btn2',
                            click: function () {
                                $(this).dialog("close");
                            }
                        },
                        {
                            text: "Change Request",
