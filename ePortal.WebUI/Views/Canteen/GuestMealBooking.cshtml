                    $("#hfGuestId").val('0');
                    $('#txtVisitorContact').val('');
                    $('#txtVisitorName').val('');
                    $('#txtCompany').val('');
                    if (ui.item) {
                        $("#searchTerm").val(ui.item.value);
                        var strArray = ui.item.value.split('|');
                        if (strArray != null) {
                            this.value = strArray[0];
                            $("#hfGuestId").val('0');
                            $('#txtVisitorContact').val(strArray[0].trim());
                            $('#txtVisitorName').val(strArray[1].trim());
                            $('#txtCompany').val(strArray[2].trim());
                        }
