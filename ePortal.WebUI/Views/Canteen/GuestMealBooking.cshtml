        function AddRecord(current, radioInput) {
            var row = $(current).closest("tr")[0];
            if (arrayBookList == null || arrayBookList.length == 0) {
                arrayBookList = new Array;
            }

            var strBookDate = row.cells[1].innerText;
            var data = {
                CSD_GUEST_BOOKINGID: 0,
                MEAL_BOOKED_DATE: row.cells[1].firstElementChild.value,
                strBOOKED_DATE: strBookDate.trim(),
                MEALOPTIONID:row.cells[2].firstElementChild.value,
                MEALTYPEID: row.cells[3].firstElementChild.value,
                MEAL_PRICE: row.cells[4].firstElementChild.value,
                MEAL_QTY: row.cells[5].firstElementChild.value,
                MEALS_AVAILABILITY_ID: current.id,
                MEAL_STATUS: 0,
                VISIT_PURPOSE: $("#txtPurpose").val(),
                APPROVER_ECODE: $("#ddlAppAuth").val(),
                //PAYMENT_TYPE: $("input:radio:checked").val(),
                //SLOTMSTID: $(row).find('#ddlSlot').val()
            }

            var existArrayIbj = $.grep(arrayBookList, function (e) {
                return e.MEAL_BOOKED_DATE == data.MEAL_BOOKED_DATE;
            });
            if (existArrayIbj.length > 0) {
                sweetAlert("", "Meal is already selected for " + strBookDate + ".", "warning");
                current.checked = false;
                $(current).closest("tr")[0].style.backgroundColor = "";

                //radioInput.checked = false;
                //$('#div-self_' + current.id).removeClass('highlightBackground');
                //$('#div-company_' + current.id).removeClass('highlightBackground');

                return;
            }

            TotalBookCount += 1;
            arrayBookList.push(data);
        }

        function DeleteItem(current) {
            arrayBookList = $.grep(arrayBookList, function (e) {
                return e.MEALS_AVAILABILITY_ID != current.id;
            });
            TotalBookCount = TotalBookCount - 1;
        }

        function SaveData(current) {
            debugger;
            var data = {};
            if (TotalBookCount == 0) {
                sweetAlert("", "Please select meal before submission.", "warning");
                return;
            }
            else {
                data = arrayBookList[0];
            }

            if (arrayList == null || arrayList.length == 0) {
                $("#txtVisitorContact").focus();
                sweetAlert("", "Guest not found, Please add guest.", "warning");
                return;
            }
            else {
                $('#txtPurpose').removeClass('validationError');
                if ($("#txtPurpose").val().trim() == "") {
                    $('#txtPurpose').addClass('validationError');
                    sweetAlert("", "Visit Purpose is mandatory.", "warning");
                    return;
                }
                else {
                    data.VISIT_PURPOSE = $("#txtPurpose").val();
                }

                $('#ddlAppAuth').removeClass('validationError');
                if ($("#ddlAppAuth").val() == "" || $("#ddlAppAuth").val() == "0") {
                    $('#ddlAppAuth').addClass('validationError');
                    sweetAlert("", "Approval Authority is mandatory.", "warning");
                    return;
                }
                else {
                    data.APPROVER_ECODE = $("#ddlAppAuth").val();
                }
            }

            data.GUEST_LIST=arrayList;
            data.MEAL_BOOKED_DATE = new Date().toISOString();

            
            
            console.log(data);

            $("#btnSubmit").attr("disabled", true);
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/Canteen/SaveGuestMealBooking",
                // data: JSON.stringify({ id: data.MEALS_AVAILABILITY_ID, model: data, guestList: arrayList }),
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.val == 1) {
                        var txtMsg = "";
                        if (data.PAYMENT_TYPE == 1) {
                            txtMsg = "Meal is booked successfully."
                        }
                        else {
                            txtMsg = "Meal Booking request is submitted successfully.";
                        }
                        swal({
                            title: "",
                            text: txtMsg,
                            type: "success",
                        },
                        function (isConfirm) {
                            if (isConfirm) {
                                window.location.href = "/Canteen/ManageGuestMealBooking";
                            }
                        });
                    }
                    else if (data.val == 2) {
                        sweetAlert("", "Meal is already booked for " + data.msg + ".", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data.val == 3) {
                        sweetAlert("", "Meal cannot be booked for " + data.msg + ".", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data.val == 4) {
                        sweetAlert("", "Booking date should be equal or less than " + data.msg + ".", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data.val == 5) {
                        sweetAlert("", "Validation master not maintained, Kindly contact to SIS team.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data.val == 6) {
                        sweetAlert("", "Meal booking for " + data.msg + " has exceeded the maximum limit.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data.val == 7) {
                        //sweetAlert("", data.msg, "warning");
                        $("#btnSubmit").attr("disabled", false);
                        swal({
                            title: "",
                            text: data.msg,
                            type: "warning",
                        },
                        function (isConfirm) {
                            if (isConfirm) {
                                arrayBookList = new Array;
                                TotalBookCount = 0;
                                UncheckedRows();
                            }
                        });
                    }
                    else if (data.val == 8) {
                        sweetAlert("", "Approval authority does not exist, Kindly contact to SIS team.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data.val == 0 || data.val == -1) {
                        sweetAlert("", "Meal not booked, Please try again.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function AddVisitor() {
            var isFormVaildation = CheckVisitorValidation();
            if (!isFormVaildation) {
                $('#div_valid_msg').removeClass('hidden');
                return;
            }
            else {
                var IsValid = 0;
                $.ajax({
                    type: "GET",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    url: "/Canteen/GetGuestData",
                    data: { mobileNo: $("#txtVisitorContact").val().trim(), bookingDate: $("#txtBookingDate").val(), mealOption: $('#ddlMealOption').val()},
                    success: function (strVal) {
                        debugger;
                        if (strVal != "" && strVal != undefined) {
                            var strArray = strVal.split('|');
                            if (strArray[1] == 0) { //// BookStatus = 0, Meal not booked for selected date.
                                $("#hfGuestId").val(strArray[0]);
                                IsValid = 1;
                            }
                            else {
                                sweetAlert("", "Meal is already booked for this guest.", "warning");
                                return;
                            }
                        }
                        else {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                            return
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                        if (IsValid == 1) {
                            AddGuest();
                        }
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                        return;
                    }
                });
            }
        }

        function AddGuest() {
            if (arrayList == null || arrayList.length == 0) {
                arrayList = new Array;
            }
            var data = {
                BC_GUESTID: $("#hfGuestId").val().trim(),
                MOBILE_NUMBER: $("#txtVisitorContact").val().trim(),
                GUEST_NAME: $("#txtVisitorName").val().trim(),
                COMPANY: $("#txtCompany").val().trim(),
            }
            var existArrayObj = $.grep(arrayList, function (e) {
                return e.MOBILE_NUMBER == data.MOBILE_NUMBER;
            });
            if (existArrayObj.length > 0) {
                sweetAlert("", "Guest is already added.", "warning");
                return;
            }

            TotalRowCount += 1;
            arrayList.push(data);

            Clear();
            BindVisitor(arrayList);
        }

        function CheckVisitorValidation() {
            $('#div_valid_msg').addClass('hidden');
            var isVailed = true; validationMsg = "";
            $('#txtVisitorContact').removeClass('validationError');
            if ($('#txtVisitorContact').val() == "") {
                $('#txtVisitorContact').addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "Guest Contact No., "
            }
            if ($('#txtVisitorContact').val().length < 10 && $('#txtVisitorContact').val() != "") {
                $('#txtVisitorContact').addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "Guest Contact No. should be 10 character. "

                $('#spn_valid_msg').text(validationMsg);
                return isVailed;
            }

            $("#txtVisitorName").removeClass('validationError');
            if ($('#txtVisitorName').val() == "") {
                $("#txtVisitorName").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "Guest Name, "
            }

            $("#txtCompany").removeClass('validationError');
            if ($('#txtCompany').val() == "") {
                $("#txtCompany").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "Guest Company, "
            }

            validationMsg = validationMsg + (isVailed == true ? "" : " field(s) is/are mandatory.");
            $('#spn_valid_msg').text(validationMsg);

            return isVailed;
        }

        function DeleteVisitor(current) {
            arrayList = $.grep(arrayList, function (e) {
                return e.MOBILE_NUMBER != current.id;
            });
            TotalRowCount = TotalRowCount - 1;
            BindVisitor(arrayList);
        }

        function BindVisitor(attList) {
            var rows = "", rowId = 0;
            if (attList != null) {
                if (attList.length > 0) {
                    $.each(attList, function (i, item) {
                        rowId = i + 1;
                        rows += "<tr class='tr_doc'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.MOBILE_NUMBER + "</td>"
                        rows += "<td class='text-left'>" + item.GUEST_NAME + "</a></td>"
                        rows += "<td class='text-left'>" + item.COMPANY + "</td>"
                        rows += "<td class='text-center'><a data-name='" + item.GUEST_NAME + "' id='" + item.MOBILE_NUMBER + "' style='cursor: pointer;' data-ctrl='delete-visitor'>Delete</a></td>"
                        rows += "</tr>"
                    });
                    document.getElementById("append_docRow").innerHTML = rows;

                    //CSP 3.0 Compliant changes
                    $(document).on('click', "[data-ctrl='delete-visitor']", function () {
                        DeleteVisitor($(this)[0]);
                    });
                }
                else {
                    var _row = "<tr><th colspan='5' class='text-center'>No record found.</th></tr>"
                    document.getElementById("append_docRow").innerHTML = _row;
                }
            }
        }

        function Clear() {
            $("#hfGuestId").val('0');
            $("#txtVisitorContact").val('');
            $("#txtVisitorName").val('');
            $("#txtCompany").val('');
            $('#txtVisitorContact').removeClass('validationError');
            $('#txtVisitorName').removeClass('validationError');
            $('#txtCompany').removeClass('validationError');
            $('#spn_valid_msg').text('');
            $('#div_valid_msg').addClass('hidden');
        }

        function BookingHistory(current) {
            window.location.href = "/Canteen/ManageGuestMealBooking";
        }
                
        function UncheckedRows() {
            var rowLength = $('#tbManageMealBooking').find('.mealRow').length;
            var rows = $('#tbManageMealBooking').find('.mealRow');
            for (var i = 0; i < rowLength; i += 1) {
                var row = rows[i];
                if (row != undefined) {
                    if ($(row).find('input[type=CheckBox]')[0] != undefined) {
                        $(row).find('input[type=CheckBox]')[0].checked = false;
                        row.style.backgroundColor = "";
                    }
                }
            }
        }
    </script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            // Bind event for the Search button
            $('#btnSearch').on('click', function () {
                  var selectedFromDate = $('#txtBookingDate').val();

               if (!selectedFromDate) {
                     sweetAlert("", "Please select booking date.", "warning");
                    return false;
                }

                GetRecord($(this)[0]);
            });

            // Reset button
             $('[data-ctrl="reset-btn"]').on('click', function () {
                location.href = '@Url.Action("GuestMealBooking", "Canteen")';
            });

            // Bind event for the Add Guest button
            $('#btnAdd').on('click', function () {
                AddVisitor();
            });

            // Bind event for the Clear button
            $('[data-ctrl="clear-btn"]').on('click', function () {
               Clear();
            });

            // Booking History bind
            $('[data-ctrl="history-btn"]').on('click', function () {
                BookingHistory($(this)[0]);
            });

            // Bind event for the Submit button
            $('#btnSubmit').on('click', function () {
                SaveData($(this)[0]);
            });
        });
    </script>
