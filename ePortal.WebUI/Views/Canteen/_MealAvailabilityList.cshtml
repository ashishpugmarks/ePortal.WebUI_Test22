@model IEnumerable<ePortal.ViewModels.CSDMealsAvailabilityViewModel>

@{
    Layout = null;
    var imgSrc1 = "";
}

<style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
    .card {
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
        word-wrap: break-word;
        /*background-color: #fff;*/
        background-clip: border-box;
        padding: 5px;
        /*border: 1px solid rgba(0,0,0,.125);
                    border-radius: 0.25rem;*/
    }

    /*.row-card {
                border: 1px solid rgba(0,0,0,.125);
                border-radius: 0.25rem;
                box-shadow: 0 0 10px 1px rgba(0, 0, 0, 0.4);
            }*/

    .row-card:hover + .booking-button {
        background-color: #f3f3f3;
        display: inline-block;
    }

    .card-body {
        flex: 1 1 auto;
        padding: 0.7rem 0.7rem;
        height: auto;
        background-color: #dae2f9;
        min-height: 120px;
    }

    .card-title {
        margin-bottom: 0.5rem;
        font-weight: 600;
        padding: 0;
    }

    .card-text {
        font-size: small;
        line-height: normal;
    }

    .h-100 {
        height: 100% !important;
    }

    .card-img, .card-img-top {
        border-top-left-radius: calc(0.25rem - 1px);
        border-top-right-radius: calc(0.25rem - 1px);
    }

    .card-img, .card-img-bottom, .card-img-top {
        width: 100%;
    }

    img, svg {
        vertical-align: middle;
    }
</style>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
    $('.homeContent').removeClass('homeContent');
</script>
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
    $('[data-ctrl="pv-save-btn"]').on('click', function () {
        SaveMeal($(this)[0]);
    });
</script>

<div class="row">
    @{
        if (Model != null)
        {
            if (Model.Count() > 0)
            {
                foreach (var item in Model)
                {
                    System.Text.StringBuilder strCanteenName = new System.Text.StringBuilder();
                    bool IsCanteenMapped = false;
                    if (item.MealCanMapList.Count > 0)
                    {
                        IsCanteenMapped = true;
                        foreach (var obj in item.MealCanMapList)
                        {
                            strCanteenName.Append("<span class='btn btn-warning btn-xs' style='cursor: initial;margin-left: 5px;' title='Canteen : " + obj.CANTEEN_NAME + "'>" + obj.CANTEEN_NAME + "</span>");
                        }
                    }
                    else
                    {
                        strCanteenName.Append("<span class='btn btn-danger btn-xs' style='cursor: initial;margin-left: 5px;'>Canteen not mapped</span>");
                    }
                    <div class="col-md-6" style="padding-bottom: 8px!important;">
                        <div class="row-card">
                            <div class="card-body">
                                <h5 class="col-xs-9 col-md-10 card-title">
                                    <span style="background-color: #009688;padding: 2px 7px;border-radius: 15px;color: white;">@Html.DisplayFor(modelItem => item.MEAL_MAPPING_DATE)</span>&nbsp;&nbsp;<span style="background-color:#b38f82;padding: 2px 7px;border-radius: 15px;color: white;">@Html.DisplayFor(modelItem => item.MEALOPTION)</span>
                                </h5>
                                <h5 class="text-right col-md-2 card-title">
                                    @if (item.MealMst_MODEL.MealTypeModel.MEAL_TYPE_DESC.ToUpper() != "REGULAR MEAL")
                                    {
                                        @*<input type="hidden" id="hfMealOption" value="@item.MEALOPTIONID" />*@
                                        <button class="btn btn-success btn-sm" title="Click here to book meal" data-mappingdate="@item.MEAL_MAPPING_DATE.ToString("dd-MMM-yyyy")" data-mealid="@item.MealMst_MODEL.MealTypeModel.CSD_MEALTYPEID" data-mealqty="@item.MealMst_MODEL.MealTypeModel.MEAL_QTY" data-availablityid="@item.CSD_MEAL_AVAILABILITY_ID" data-mealoption="@item.MEALOPTIONID" data-mealoptionname="@item.MEALOPTION" data-ctrl="pv-save-btn">Book</button>
                                    }
                                </h5>
                                <h5 class="col-xs-9 col-md-6 card-title">@item.MealMst_MODEL.MEAL_NAME&nbsp;(@item.MealMst_MODEL.MealTypeModel.MEAL_TYPE_DESC)</h5>
                                <h5 class="text-right col-md-6 card-title">
                                    @{
                                        // var CanteenHtml = MvcHtmlString.Create(strCanteenName.ToString());
                                        var CanteenHtml = new Microsoft.AspNetCore.Html.HtmlString(strCanteenName.ToString());
                                    }
                                    @CanteenHtml
                                </h5>
                                <p class="card-text">@item.MealMst_MODEL.MEAL_DESC</p>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-md-12">
                    <div class="col-md-12" style="background-color: bisque;padding: 8px;font-size: large;">
                        Meal not available
                    </div>
                </div>
            }
        }
    }

</div>
