@model IEnumerable<ePortal.ViewModels.CSDMealsAvailabilityViewModel>

@{
    Layout = null;
    var imgSrc1 = "";
    //List<ePortal.ViewModels.MealSlotViewModel> slotsModel = ViewBag.Slots;
}

<style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    select.input-sm {
        line-height: 10px !important;
    }

    .card {
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
        word-wrap: break-word;
        /*background-color: #fff;*/
        background-clip: border-box;
        padding: 5px;
        /*border: 1px solid rgba(0,0,0,.125);
                border-radius: 0.25rem;*/
    }

    .row-card {
        border: 1px solid rgba(0,0,0,.125);
        border-radius: 0.25rem;
        box-shadow: 0 0 10px 1px rgba(0, 0, 0, 0.4);
    }

        .row-card:hover + .booking-button {
            background-color: #f3f3f3;
            display: inline-block;
        }

    .card-body {
        flex: 1 1 auto;
        padding: 1rem 1rem;
        height: auto; /*115px;*/
    }

    .card-title {
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .card-text {
        font-size: small;
        line-height: normal;
    }

    .h-100 {
        height: 100% !important;
    }

    .card-img, .card-img-top {
        border-top-left-radius: calc(0.25rem - 1px);
        border-top-right-radius: calc(0.25rem - 1px);
    }

    .card-img, .card-img-bottom, .card-img-top {
        width: 100%;
    }

    img, svg {
        vertical-align: middle;
    }

    .booking-button {
        display: none;
    }

    .dataTables_scrollBody {
        overflow-x: hidden !important;
    }
</style>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
    $('.homeContent').removeClass('homeContent');
    $(document).ready(function () {


    var table = $('#tbManageMealBooking').DataTable();
    table.destroy();


        $("#tbManageMealBooking").dataTable({
            "ordering": false,
            "bFilter": false,
            "bLengthChange": false,
            "bInfo": false,
            //scrollY: '50vh',
            //scrollCollapse: true,
            paging: false,
        });
    });
</script>

