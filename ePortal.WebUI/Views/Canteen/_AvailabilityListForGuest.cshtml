<table class="table table-bordered table-hover table-responsive" id="tbManageMealBooking">
    <thead>
        <tr class="bg-info">
            <th class="text-center hidden-xs" style="width:4%;">
                @Html.DisplayName("SNo")
            </th>
            <th class="text-center" style="width:8%;">
                @Html.DisplayName("Booking Date")
            </th>
            <th class="text-center" style="width:7%;">
                @Html.DisplayName("Meal Option")
            </th>
            <th class="text-center hidden-xs" style="width:10%;">
                @Html.DisplayName("Meal Type")
            </th>
            <th style="width: 30%;">
                @Html.DisplayName("Meal Description")
            </th>
            @*<th class="text-center" style="width: 25%;">
                    @Html.DisplayName("Payment Type")
                </th>
                <th class="text-center">
                    @Html.DisplayName("Slot")
                </th>*@
            @*<th class="text-center" style="width:8%;">
                    @Html.DisplayName("Meal Price")
                </th>*@
            <th class="text-center" style="width:6%;">
                @Html.DisplayName("Action")
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            int rowNo = 0;
        }
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr class="mealRow tr_@item.CSD_MEAL_AVAILABILITY_ID">
                    <td class="text-center hidden-xs">
                        @(rowNo += 1)
                    </td>
                    <th class="text-center">
                        @Html.HiddenFor(modelItem => item.MEAL_MAPPING_DATE)
                        @Html.DisplayFor(modelItem => item.MEAL_MAPPING_DATE)
                    </th>
                    <th class="text-center">
                        @Html.HiddenFor(modelItem => item.MEALOPTIONID)
                        @Html.DisplayFor(modelItem => item.MEALOPTION)
                    </th>
                    <th class="text-center hidden-xs">
                        @Html.HiddenFor(modelItem => item.MealMst_MODEL.MealTypeModel.CSD_MEALTYPEID)
                        @Html.DisplayFor(modelItem => item.MealMst_MODEL.MealTypeModel.MEAL_TYPE_DESC)
                    </th>
                    <td>
                        @{
                            var _mealPrice = item.MealMst_MODEL.MealTypeModel.MEAL_PRICE == null ? 0 : item.MealMst_MODEL.MealTypeModel.MEAL_PRICE;
                            @Html.HiddenFor(modelItem => _mealPrice)

                            //imgSrc1 = "";
                            //var base164 = Convert.ToBase64String(item.MealMst_MODEL.MEAL_PHOTO);
                            //var contentType = item.MealMst_MODEL.MEAL_PHOTO_NAME.Split('.')[1];
                            //imgSrc1 = String.Format("data:" + contentType + ";base64,{0}", base164);

                            <div class="card col-xs-12 col-sm-12 col-md-12">
                                <div class="row-card">
                                    @*<div class="col-md-5" style="background: #868e96; padding:0px;height: 130px;">
                                            <img src="@imgSrc1" class="card-img-top h-100" alt="@item.MealMst_MODEL.MEAL_PHOTO_NAME" />
                                        </div>*@
                                    <div class="col-md-12" style="padding:0px;">
                                        <div class="card-body">
                                            <h5 class="card-title">@item.MealMst_MODEL.MEAL_NAME&nbsp;(@item.MealMst_MODEL.MealTypeModel.MEAL_TYPE_DESC)</h5>
                                            <p class="card-text">@item.MealMst_MODEL.MEAL_DESC</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </td>
                    @*<td class="text-center">
                            <h5 class="card-title">Meal Price :-&nbsp;@item.MealMst_MODEL.MealTypeModel.MEAL_PRICE</h5>

                            <div class="col-md-12" style="padding: 0px;border-radius:5px;" id="type_error">
                                <div class="col-md-6" style="padding:1px 3px 1px 3px">
                                    <div id="div-self_@item.BC_MEALS_AVAILABILITY_ID" style="background-color: #6080dc;height: 27px;margin-top: 3px;margin-bottom: 3px;border-radius: 18px;">
                                        <div class="col-xs-6 col-sm-3 col-md-3 col-lg-3 text-right">
                                            <input id="rbSELF_@item.BC_MEALS_AVAILABILITY_ID" type="radio" name="type_@item.BC_MEALS_AVAILABILITY_ID" value="1" data-aid="@item.BC_MEALS_AVAILABILITY_ID" onChange="typeChange(this);" style="width:18px;height:18px;">
                                        </div>
                                        <div class="col-xs-6 col-sm-9 col-md-9 col-lg-9 text-left" style="padding: 0px;">
                                            <p style="margin: 6px 0px 0px 0px;font-weight: 600;color:white;">Self Paid</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6" style="padding:1px 3px 1px 3px">
                                    <div id="div-company_@item.BC_MEALS_AVAILABILITY_ID" style="background-color: #6080dc;height: 27px;margin-top: 3px;margin-bottom: 3px;border-radius: 18px;">
                                        <div class="col-xs-6 col-sm-3 col-md-3 col-lg-3 text-right">
                                            <input id="rbCOMPANY_@item.BC_MEALS_AVAILABILITY_ID" type="radio" name="type_@item.BC_MEALS_AVAILABILITY_ID" value="2" data-aid="@item.BC_MEALS_AVAILABILITY_ID" onChange="typeChange(this);" style="width:18px;height:18px;">
                                        </div>
                                        <div class="col-xs-6 col-sm-9 col-md-9 col-lg-9 text-left" style="padding: 0px;">
                                            <p style="margin: 6px 0px 0px 0px;font-weight: 600;color:white;">Company Paid</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="text-center">
                            @Html.DropDownListFor(modelItem => item.SLOTMSTID, new SelectList(slotsModel.Where(x => x.MEALTYPEID == item.MealMst_MODEL.MealTypeModel.BC_MEALTYPEID).ToList(), "BCSLOTMSTID", "SLOT_TIME"), "- Select -", new { @id = "ddlSlot", @class = "form-control" })
                            @Html.ValidationMessageFor(modelItem => item.SLOTMSTID, "", new { @class = "text-danger", @id = "slotMsg" })
                        </td>*@
                    @*<th class="text-center">
                            @Html.HiddenFor(modelItem => item.MealMst_MODEL.MealTypeModel.MEAL_QTY)
                            @Html.DisplayFor(modelItem => item.MealMst_MODEL.MealTypeModel.MEAL_PRICE)
                        </th>*@
                    <td class="text-center">
                        @Html.HiddenFor(modelItem => item.MealMst_MODEL.MealTypeModel.MEAL_QTY)
                        @Html.CheckBox("ChkSelect", new { @id = item.CSD_MEAL_AVAILABILITY_ID, @style = "width:20px; height:20px;", @data_ctrl = "chk-sel-avl" })
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

