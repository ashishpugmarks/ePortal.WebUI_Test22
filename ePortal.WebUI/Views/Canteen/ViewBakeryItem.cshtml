@model IEnumerable<ePortal.ViewModels.CSDBakeryItemViewModel>

@{
    ViewBag.Title = "ViewBakeryItem";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 6px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .card-title {
            margin-bottom: 0.2rem;
            font-weight: 600;
        }

        .card-text {
            font-size: small;
            line-height: normal;
        }
    </style>
}


    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                Canteen Service - View Bakery Item
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Bakery Items</strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <table class="table table-bordered table-hover table-responsive" id="tbBakeryItem">
                            <thead>
                                <tr class="bg-info">
                                    <th class="text-center" style="width:8%;">
                                        @Html.DisplayNameFor(model => model.CSD_ITEMID)
                                    </th>
                                    <th class="text-center" style="width:30%;">
                                        @Html.DisplayNameFor(model => model.ITEM_NAME)
                                    </th>
                                    <th style="width: 30%;">
                                        @Html.DisplayNameFor(model => model.ITEM_DESC)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.ITEM_PRICE)
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNo = 0;
                                }
                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                @(rowNo += 1)
                                                @Html.HiddenFor(modelItem => item.CSD_ITEMID)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.ITEM_NAME)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.ITEM_DESC)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.ITEM_PRICE)
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-12 bg-info" style="border: 1px solid #61c0ed;border-radius: 0.25em;padding:8px;">
                    <span>
                        <a title="Back" href="/Home/Home">
                            <img src="~/images/icon_back.gif" border="0" alt="">
                            Back
                        </a>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div id="ajaxLoader"></div>

@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $("#tbBakeryItem").dataTable({
                "bFilter": true,
                "bLengthChange": true
            });

        });
    </script>
}
