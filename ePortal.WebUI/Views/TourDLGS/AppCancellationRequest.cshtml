@model ePortal.ViewModels.APPX.TourRequest.AppCancellationRequestViewModel
@{
    ViewBag.Title = "::Request Cancellation::";
    }
    @section Styles {
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
}


    <div id="form1" runat="server">
    <div>
     <table width="100%" cellpadding="0" cellspacing="0" style="padding-left:5px;">
        <tr class="row1" >
            <td colspan="4" align="center">
                @Html.Label(Model.lblErrMsg, null, new { id = "lblErrMsg", style = "font-weight:bold;" })
            </td>
        </tr>
        <tr class="row2" >
            <td>Request Detail ID:</td>
            <td>&nbsp;
                @Html.Label(Model.lblRequestID, null, new { id = "lblRequestID" })
            </td>
            <td>Travel Date:</td>
            <td>&nbsp;
                @Html.Label(Model.lblTravelDate, null, new { id = "lblTravelDate" })
            </td>
        </tr>
        <tr class="row1">
            <td width="25%" >City From:</td>
            <td width="25%">&nbsp;
                @Html.Label(Model.lblCityFrom, null, new { id = "lblCityFrom" })
            </td>
            <td width="30%" >City To:</td>
            <td>&nbsp;
               @Html.Label(Model.lblCityTo, null, new { id = "lblCityTo" })
            </td>
        </tr>
        <tr class="row2">
            <td >Ticket No.:</td>
            <td>&nbsp;
                @Html.Label(Model.lblTicketNumber, null, new { id = "lblTicketNumber" })
            </td>
            <td >Ticket Amount:</td>
            <td>&nbsp;
                @Html.Label(Model.lblTicketAmount, null, new { id = "lblTicketAmount" })
            </td>
        </tr>
        <tr class="row1">
            <td >Ticket Issue Date:</td>
            <td colspan="3">&nbsp;
                @Html.Label(Model.lblIssueDate, null, new { id = "lblIssueDate" })
            </td>
        </tr>
        <tr class="row2">
            <td >Hotel Name:</td>
            <td colspan="3" >&nbsp;
                @Html.Label(Model.lblHotelName, null, new { id = "lblHotelName" })
            </td>
        </tr>
        <tr class="row1">
            <td >Hotel Address:</td>
            <td colspan="3">&nbsp;
                @Html.Label(Model.lblHotelAddress, null, new { id = "lblHotelAddress" })
            </td>
        </tr>
        <tr class="row2">
            <td >Checkin Date.:</td>
            <td>&nbsp;
                @Html.Label(Model.lblCheckinDate, null, new { id = "lblCheckinDate" })
            </td>
            <td >In Time[ HH24:MM ]:</td>
            <td>&nbsp;
                @Html.Label(Model.lblCheckinTime, null, new { id = "lblCheckinTime" }) 
            </td>
        </tr>
        <tr class="row1">
            <td >Checkout Date.:</td>
            <td>&nbsp;
                @Html.Label(Model.lblCheckoutDate, null, new { id = "lblCheckoutDate" })
            </td>
            <td >Out Time[ HH24:MM ]:</td>
            <td>&nbsp;
                @Html.Label(Model.lblCheckoutTime, null, new { id = "lblCheckoutTime" }) 
            </td>
        </tr>
        <tr class="row2">
            <td >PickUp/Drop:</td>
            <td colspan="3">&nbsp;
                @Html.Label(Model.lblPickUpDetails, null, new { id = "lblPickUpDetails" }) 
            </td>
        </tr>
         <tr class="row1">
            <td >Approval Remarks:</td>
            <td colspan="3">&nbsp;
                    @Html.TextBox("txtCalcellationRemarks", null, new { @class = "swifttext", id = "txtCalcellationRemarks", maxlength = "300", style = "width:400px;" })
            </td>
        </tr>
        <tr class="row2">
            <td colspan="4">&nbsp;</td>
        </tr>
        <tr class="row1">
            <td colspan="4" align="center">
                    <button class="yellowbuttonbigbig" id="btnCancel" style="width:130PX">Approve Request</button> 
                <input type="button" class="yellowbuttonbig" value="Close" id="btnClose" />
                
            </td>
        </tr>
        <tr class="row2">   
            <td colspan="4">&nbsp;</td>
        </tr>
    </table>
    </div>
    </div>
    <div id="ajaxLoader"></div>

@section Scripts {
    <script src="~/app/Tour/dlgs/AppCancellatinRequest.js" asp-append-version="true"></script>
}
