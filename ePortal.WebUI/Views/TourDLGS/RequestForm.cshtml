@model ePortal.ViewModels.APPX.TourRequest.RequestFormViewModel
@{
    ViewBag.Title = "::Tour Request Form::";
}
@section Styles {
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/NewAsset.css" rel="stylesheet" asp-append-version="true" />
}
    <div id="form1">
    <div>
        <fieldset class="swiftfieldset" style="margin-left: 9px; margin-right: 6px;">
        <legend class="nfont">Tour Program</legend>
            <table cellspacing="1" cellpadding="2" width="100%"  border="0" style="text-align: left;line-height: 23px;">
            <tr>
                <td>
                     <table cellspacing="1" cellpadding="2" width="100%"  border="0" style="text-align: left;
                        line-height: 23px;">
                        <tbody>
                            <tr class ="row1">
                                <td class ="smalltext"  align="right">Request ID :&nbsp;</td>    
                                <td >&nbsp;
                                    @Html.Label(Model.lblPageRequestID, null, new { id = "lblPageRequestID" })
                                </td>
                                <td class ="smalltext"  align="right">Requested By :&nbsp;</td>    
                                <td >&nbsp; 
                                    @Html.Label(Model.lblEmpName, null, new { id = "lblEmpName" }) 
                                    @Html.HiddenFor(model => model.hfAuthType, new { id = "hfAuthType" })      
                                </td>
                            </tr>
                            <tr class ="row2">
                                <td  class ="smalltext" align="right">Mobile No.:&nbsp;</td>    
                                <td>&nbsp; 
                                    @Html.Label(Model.txtMobile, null, new { id = "txtMobile" })
                                </td>
                                <td class ="smalltext"  align="right">Ext No.:&nbsp;</td>    
                                <td>&nbsp; 
                                    @Html.Label(Model.txtExtension, null, new { id = "txtExtension" })
                                </td>
                            </tr>
                            <tr class ="row1">
                                <td class ="smalltext"  align="right">Designation:&nbsp;</td>    
                                <td colspan="3">&nbsp; 
                                    @Html.Label(Model.lblDesignation, null, new { id = "lblDesignation" })
                                </td>
                            </tr>
                            <tr class ="row2">
                                <td  class ="smalltext" align="right">Operation:&nbsp;</td>    
                                <td>&nbsp; 
                                    @Html.Label(Model.lblOperation, null, new { id = "lblOperation" })
                                </td>
                                <td class ="smalltext"  align="right">Division:&nbsp;</td>    
                                <td>&nbsp; 
                                    @Html.Label(Model.lblDivision, null, new { id = "lblDivision" })
                                </td>
                            </tr>
                             <tr class ="row1">
                                <td  class ="smalltext" align="right">Department:&nbsp;</td>    
                                <td>&nbsp; 
                                    @Html.Label(Model.lblDepartment, null, new { id = "lblDepartment" })
                                </td>
                                <td class ="smalltext"  align="right">Section:&nbsp;</td>    
                                <td>&nbsp; 
                                    @Html.Label(Model.lblSection, null, new { id = "lblSection" })
                                </td>
                            </tr>
                            <tr class ="row2">
                                <td class ="smalltext"  align="right">Objective of Journey:&nbsp;</td>    
                                <td colspan="3">&nbsp; 
                                    @Html.Label(Model.txtObjective, null, new { id = "txtObjective" })
                                </td>
                            </tr>
                            <tr class ="row1" style="display:none">
                                <td class ="smalltext"  align="right">Advance Amount Required:&nbsp;</td>
                                <td colspan="3">&nbsp;
                                        @Html.CheckBoxFor(model => model.chkAdvance, new { id = "chkAdvance", @disabled = "disabled" })
                                </td>
                            </tr>
                        </tbody>
                        </table>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                        <table id="gvList" cellspacing="1" cellpadding="4" border="0" style="color:#333333;width:100%;">
                                            <thead id="gvListThead">
                                                <tr class="tcat" style="color:White;background-color:#5D7B9D;font-weight:bold;height:20px;">
                                                    <th align="left" valign="top" scope="col">&nbsp;TourFromDate</th>
                                                    <th align="left" valign="top" scope="col">&nbsp;TourTime</th>
                                                    <th align="left" valign="top" scope="col">&nbsp;From Loc</th>
                                                    <th align="left" valign="top" scope="col">&nbsp;To Loc</th>
                                                    <th align="left" valign="top" scope="col">&nbsp;Stay Loc</th>
                                                    <th align="left" valign="top" scope="col">&nbsp;Mode</th>
                                                    <th align="left" valign="top" scope="col">&nbsp;Class</th>
                                                    <th align="left" valign="top" scope="col">&nbsp;Ticketing By</th>
                                                    <th align="left" valign="top" scope="col">Hotel Reserv</th>
                                                    <th scope="col">PickDrop</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.gvList != null && Model.gvList.Any())
                                                {
                                                    int i = 0;
                                                    foreach (var item in Model.gvList)
                                                    {
                                                        i++;
                                                        <tr class="row+{i}" style="color:#333333;background-color:#F7F6F3;">
                                                            <td align="left" valign="top">@item.TourFromDate</td>
                                                            <td align="left" valign="top">@item.TourTime</td>
                                                            <td align="left" valign="top">@item.FromLoc</td>
                                                            <td align="left" valign="top">@item.ToLoc</td>
                                                            <td align="left" valign="top">@item.StayingLoc</td>
                                                            <td align="left" valign="top">@item.Mode</td>
                                                            <td align="left" valign="top">@item.TicketClass</td>
                                                            <td align="left" valign="top">@item.TicketingBy</td>
                                                            <td align="left" valign="top">@item.HotelReserv</td>
                                                            <td align="left" valign="top">@item.PickDrop</td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                </td> 
            </tr>
            </table>
        </fieldset>
         <div ID="pnlAdvance" style="display:@(Model.pnlAdvance ? "block" : "none")">
        <fieldset class="swiftfieldset" style="margin-left: 9px; margin-right: 6px;">
        <legend class="nfont">Anticipated Expenditure</legend>
            <table cellpadding="2" cellspacing="0" border="0" width="100%">
                    <tr class="row1">
                        <td>STAY CHARGES</td>
                        <td align="right"> 
                            @Html.Label(Model.lblTotalCharges, null, new { id = "lblTotalCharges", style = "font-weight:bold;" })
                        </td>
                    </tr>
                    <tr >
                        <td colspan="2">
                            <table cellpadding ="0" cellpadding ="0" border ="1" width="50%">
                            <tr class="row2">
                                <th align ="center" class ="smalltext" width="5%">A+</th>
                                <th align ="center" class ="smalltext" width="5%">A</th>
                                <th align ="center" class ="smalltext" width="5%">B</th>
                                <th align ="center" class ="smalltext" width="5%">C</th>
                                <th align ="center" class ="smalltext" width="10%">Total Nights</th> 
                            </tr>
                            <tr class="row1">
                                <td align ="center" class ="smalltext"> 
                                    @Html.Label(Model.lblStayChargeAPLUS, null, new { id = "lblStayChargeAPLUS" })
                                </td>
                                <td align ="center" class ="smalltext"> 
                                    @Html.Label(Model.lblStayChargeA, null, new { id = "lblStayChargeA" })
                                </td>
                                <td align ="center" class ="smalltext"> 
                                    @Html.Label(Model.lblStayChargeB, null, new { id = "lblStayChargeB" })
                                </td>
                                <td align ="center" class ="smalltext"> 
                                    @Html.Label(Model.lblStayChargeC, null, new { id = "lblStayChargeC" })
                                </td>
                                <td align ="center" class ="smalltext"> 
                                    @Html.Label(Model.lblTotalNights, null, new { id = "lblTotalNights" })
                                </td> 
                            </tr>
                            </table>
                        </td>
                    </tr>
                    <tr class="row2">
                        <td>DAILY ALLOWANCE</td>
                        <td align="right"> 
                            @Html.Label(Model.lblTotalAllowances, null, new { id = "lblTotalAllowances", style = "font-weight:bold;" })
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                        <table cellpadding ="0" cellpadding ="0" border ="1" width="50%">
                        <tr class ="row1">
                            <th align ="center" class ="smalltext" width="5%">A+</th>
                            <th align ="center" class ="smalltext" width="5%">A</th>
                            <th align ="center" class ="smalltext" width="5%">B</th>
                            <th align ="center" class ="smalltext" width="5%">C</th>
                            <th align ="center" class ="smalltext" width="10%">Total Days</th>
                        </tr>
                        <tr class="row2">
                            <td align ="center" class ="smalltext"> 
                                @Html.Label(Model.lblAllownceAPLUS, null, new { id = "lblAllownceAPLUS" })
                            </td>
                            <td align ="center" class ="smalltext"> 
                                @Html.Label(Model.lblAllownceA, null, new { id = "lblAllownceA" })
                            </td>
                            <td align ="center" class ="smalltext"> 
                                @Html.Label(Model.lblAllownceB, null, new { id = "lblAllownceB" })
                            </td>
                            <td align ="center" class ="smalltext"> 
                                @Html.Label(Model.lblAllownceC, null, new { id = "lblAllownceC" })
                            </td>
                            <td align ="center" class ="smalltext"> 
                                @Html.Label(Model.lblTotalDays, null, new { id = "lblTotalDays" })
                            </td>
                        </tr>
                        </table>
                        </td>
                    </tr>
                    <tr class="row1">
                        <td>MISCELLANEOUS AMOUNT</td>
                        <td align="right"> 
                            @Html.Label(Model.lblMiscAmount, null, new { id = "lblMiscAmount", style = "font-weight:bold;" })
                        </td>
                    </tr>
                    <tr class="row2">
                        <td>SYSTEM GENERATED TOTAL AMOUNT</td>
                        <td align="right"> 
                            @Html.Label(Model.lblTotalAmount, null, new { id = "lblTotalAmount", style = "font-weight:bold;" })
                        </td>
                    </tr>
                    <tr class="row1">
                        <td><strong>REQUIRED AMOUNT</strong></td>
                        <td align="right"> 
                           @Html.Label(Model.lblRequiredAmount, null, new { id = "lblRequiredAmount", style = "font-weight:bold;" })
                        </td>
                    </tr>
                </table>
         </fieldset>
        </div>
    </div>
    </div>

<div id="ajaxLoader"></div>

@section Scripts {
    <script src="~/app/Tour/dlgs/RequestForm.js" asp-append-version="true"></script>
}

