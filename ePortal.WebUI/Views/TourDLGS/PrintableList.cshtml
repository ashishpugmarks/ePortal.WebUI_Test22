@model ePortal.ViewModels.APPX.TourRequest.PrintableListViewModel
@{
    ViewBag.Title = "::Tour Request List::";
    Layout = null;
}
@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_3"]">
        @@media print {
            .noprint {
                display: none;
            }
        }

        @@page {
            margin: 10%;
            size: landscape
        }
    </style>
}

<div style="font-size:10px; color:Black;font-family:arial,helvetica,clean,sans-serif;">
    <div id="form1">
        <div>
            <div style="text-align:right; height:20px; font-size:13px; padding:5px; font-weight:bold">
                @Html.Label(Model.lblduplicate, null, new { id = "lblduplicate" })
            </div>
            <div style="text-align:center; height:20px; font-size:13px; font-weight:bold">Electronic Tour Advance Request</div>
            <table cellpadding="1px" cellspacing="0px" border="0" width="100%">
                <tr>
                    <td width="65%">
                        <table cellpadding="1px" cellspacing="0px" border="0" width="100%">
                            <tr>
                                <td>
                                    <strong> Honda Motorcycle & Scooter India Pvt.Ltd.</strong><br />
                                    Plot No. 1&2, Sector-3 ,IMT Manesar,<br />
                                    Distt. Gurgaon,(Haryana) - 122050
                                </td>
                            </tr>
                        </table>
                    </td>
                    <td>
                        <table cellpadding="1px" cellspacing="0px" border="0" width="100%">
                            <tr>
                                <td align="left" width="35%">Reference No. :</td>
                                <td>@Html.Label(Model.lblGroupNumber, null, new { id = "lblGroupNumber" })</td>
                            </tr>
                            <tr>
                                <td align="left">Date :</td>
                                <td>@Html.Label(Model.lblDate, null, new { id = "lblDate" }) </td>
                            </tr>
                            <tr>
                                <td align="left">Operation :</td>
                                <td>@Html.Label(Model.lblOperation, null, new { id = "lblOperation" }) </td>
                            </tr>
                            <tr>
                                <td align="left">Department :</td>
                                <td>@Html.Label(Model.lblDepartment, null, new { id = "lblDepartment" })</td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
            <table cellpadding="1px" cellspacing="0px" border="0" width="100%">
                <tr>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-left:solid 1px #000000;border-top:solid 1px #000000;width:4%" valign="top"><strong>Emp Code</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:8%" valign="top"><strong>Employee Name</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:8%" valign="top"><strong>Bank A/C No.</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:5%" valign="top"><strong>Desig.</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:8%" valign="top"><strong>Objective</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:6%" valign="top"><strong>From Date</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:6%" valign="top"><strong>To Date</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:6%" valign="top"><strong>Days</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:6%" valign="top"><strong>Nights</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:5%" valign="top"><strong>Stay Charges</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:5%" valign="top"><strong>Daily Allow.</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:5%" valign="top"><strong>Misc. Amt</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:5%" valign="top"><strong>Remarks</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:5%" valign="top"><strong>Req. Total Amt</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:5%" valign="top"><strong>App. By</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:6%" valign="top"><strong>App. Date</strong></td>
                    <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:6%" valign="top"><strong>Location</strong></td>
                </tr>

                @{
                    var odt = Model.PrintGroupList;
                }

                @if (odt != null && odt.Rows.Count > 0)
                {
                    foreach (System.Data.DataRow dr in odt.Rows)
                    {
                        <tr>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-left:solid 1px #000000;">
                                <strong>@(dr["ADEMPCODE"]?.ToString())</strong>
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;">
                                <strong>@(dr["EMPNAME"]?.ToString())</strong>
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;">
                                <strong>@(dr["ACCOUNTNO"]?.ToString())</strong>
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;">
                                @(dr["DESIG"]?.ToString())
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;">
                                @(dr["OBJOFJOURNEY"]?.ToString())
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;">
                                @(dr["STARTDATE"])
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;">
                                @(dr["ENDDATE"])
                            </td>
                            <td style="border-bottom:solid 1px #000000;border-right:solid 1px #000000;">
                                <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                    <tr>
                                        <td style="border-right:solid 1px #000000;">A+</td>
                                        <td style="border-right:solid 1px #000000;padding-left:2px; padding-right:2px;">A</td>
                                        <td style="border-right:solid 1px #000000;padding-left:2px; padding-right:2px;">B</td>
                                        <td style="padding-left:2px; padding-right:2px;">C</td>
                                    </tr>
                                    <tr>
                                        <td style="border-right:solid 1px #000000;">@(dr["TOTALAACITYDAYS"]?.ToString())</td>
                                        <td style="border-right:solid 1px #000000;padding-left:2px; padding-right:2px;">@(dr["TOTALACITYDAYS"]?.ToString())</td>
                                        <td style="border-right:solid 1px #000000;padding-left:2px; padding-right:2px;">@(dr["TOTALBCITYDAYS"]?.ToString())</td>
                                        <td style="padding-left:2px; padding-right:2px;">@(dr["TOTALCCITYDAYS"]?.ToString())</td>
                                    </tr>
                                </table>
                            </td>
                            <td style="border-bottom:solid 1px #000000;border-right:solid 1px #000000;">
                                <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                    <tr>
                                        <td style="border-right:solid 1px #000000;">A+</td>
                                        <td style="border-right:solid 1px #000000;padding-left:2px; padding-right:2px;">A</td>
                                        <td style="border-right:solid 1px #000000;padding-left:2px; padding-right:2px;">B</td>
                                        <td style="padding-left:2px; padding-right:2px;">C</td>
                                    </tr>
                                    <tr>
                                        <td style="border-right:solid 1px #000000;">@(dr["TOTALAACITYNIGHTS"]?.ToString())</td>
                                        <td style="border-right:solid 1px #000000;padding-left:2px; padding-right:2px;">@(dr["TOTALACITYNIGHTS"]?.ToString())</td>
                                        <td style="border-right:solid 1px #000000;padding-left:2px; padding-right:2px;">@(dr["TOTALBCITYNIGHTS"]?.ToString())</td>
                                        <td style="padding-left:2px; padding-right:2px;">@(dr["TOTALCCITYNIGHTS"]?.ToString())</td>
                                    </tr>
                                </table>
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;" align="right" valign="middle">
                                @(dr["TOTALSTAYCHARGESAMOUNT"])
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;" align="right">
                                @(dr["TOTALDAILYALLOOWANCEAMOUNT"])
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;" align="right">
                                @(dr["MISCELLANEOUSAMT"])
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;">
                                @(dr["MISCAMOUNTREMARKS"]?.ToString())&nbsp;
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;" align="right">
                                <strong>&nbsp;@(dr["TOTALAMOUNTREQUIRED"])</strong>
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;">
                                @(dr["APPEMPNAME"]?.ToString())&nbsp;
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;">
                                @(dr["APPDATE"])&nbsp;
                            </td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;">
                                @dr["StayCity"]
                                &nbsp;
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="15">No records found.</td></tr>
                }

            </table>
        </div>
        <table cellpadding="0" width="100%" cellspacing="0" style="padding-top:100px;">
            <tr>
                <td width="35%">
                    <table width="100%" cellpadding="0" cellspacing="0" border="1">
                        <tr>
                            <td>&nbsp;Prepared/Checked By</td>
                            <td>&nbsp;Approved By</td>
                        </tr>
                        <tr>
                            <td>
                                <table width="100%" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td>&nbsp;Name:</td>
                                        <td>@Html.Label(Model.lblName, null, new { id = "lblName" })</td>
                                    </tr>
                                    <tr>
                                        <td>&nbsp;Ext:</td>
                                        <td>@Html.Label(Model.lblExt, null, new { id = "lblExt" })</td>
                                    </tr>
                                    <tr>
                                        <td>&nbsp;Mobile No:</td>
                                        <td>@Html.Label(Model.lblMobileNo, null, new { id = "lblMobileNo" })</td>
                                    </tr>
                                    <tr>
                                        <td colspan="2">&nbsp;Signature:</td>
                                    </tr>
                                    <tr>
                                        <td colspan="2">&nbsp;</td>
                                    </tr>
                                </table>
                            </td>
                            <td>&nbsp;</td>
                        </tr>
                    </table>
                </td>
                <td width="5%">&nbsp;</td>
                <td>
                    <table width="100%" cellpadding="0" cellspacing="0" border="1">
                        <tr>
                            <td colspan="5" style="padding-left:5px;">For Accounts use only</td>
                        </tr>
                        <tr>
                            <td align="center" style="width:18%">Accounted By</td>
                            <td align="center" style="width:18%">Audited By</td>
                            <td align="center" style="width:18%">Dpt. Mgr.</td>
                            <td align="center" style="width:28%">Div. Head/SMC Member</td>
                            <td align="center" style="width:18%">Adv/Director</td>
                        </tr>
                        <tr>
                            <td style="height:50px">&nbsp;</td>
                            <td>&nbsp;</td>
                            <td>&nbsp;</td>
                            <td>&nbsp;</td>
                            <td>&nbsp;</td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <input type="button" value="Print Report" class="noprint" onclick="window.print()" style="background-color: #fed;" />
                </td>
            </tr>
        </table>
    </div>
</div>

<div id="ajaxLoader"></div>

@section Scripts {
    <script src="~/app/Tour/dlgs/PrintableList.js" asp-append-version="true"></script>
}
