@model ePortal.ViewModels.SeatMgmtViewModel

@{
    ViewBag.Title = "Manage Shift Roster";
    Layout = "~/Views/Shared/_Layout.cshtml";

    //System.Text.StringBuilder tfootTr = new System.Text.StringBuilder();
    System.Text.StringBuilder theadTr2 = new System.Text.StringBuilder();
}

@section Styles{

    <style nonce="@Context.Items["StyleNonce_0"]">
        /*table Css*/
        .table > thead > tr > th {
            padding: 1px 2px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            padding: 1px;
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
            border: 1px solid #8ac2de;
        }

        .table-bordered {
            border: 1px solid #8ac2de;
        }

        .table > tbody > tr > td {
            padding: 1px 1px;
        }

        .table > tbody > tr:nth-of-type(even) {
            background: #e9e9e9;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .validationBackground {
            background-color: #a94442 !important;
            color: white;
        }

        .highlightBackground {
            background-color: #8bb55a !important;
            color: white;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .alert-error {
            background-color: antiquewhite;
            margin-left: 15px;
            margin-right: 15px;
        }

        .disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .required::after {
            content: "*";
            font-weight: 800;
            color: red;
            margin-left: 5px;
        }


        tr:hover {
            background-color: #8ac2de !important;
        }

        .scrollit {
            overflow: auto;
            height: 390px;
        }

        .popover {
            z-index: 1010 !important; /* A value higher than 1010 that solves the problem */
        }

        .dataTables_scrollBody {
            overflow-x: hidden !important;
        }

        .headDiv {
            padding: 7px 7px;
            color: white;
            border: 1px solid #e18645;
            background-color: #e18645;
            font-size: small; /*SR102091*/
        }
    </style>
}

<div id="ajaxLoader2"></div>


    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Manage Seat Roster</div>
        </div>
        <div class="body-content" style="overflow-x:hidden">
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group" style="margin-bottom:9px;">
                    <div class="col-md-12 col-lg-12">
                        <table class="table table-bordered table-hover table-responsive" id="tbmyTable">
                            <thead>
                                <tr>
                                    @{
                                    var dayCount = Model.CAL_HEADER_LIST.Count() + 1;
                                        <th colspan="@dayCount" class="bg-primary text-center" style="height:30px;">
                                        <a class="pull-left" style="margin-left: 5px;color: white;cursor: pointer;" title="Click to previous month" data-ctrl='anc-ms-prev-item'> &lt;&lt; Previous</a>
                                            <span>@Model.CAL_MONTH_YEAR</span>
                                            <a class="pull-right" style="margin-right: 5px;color: white;cursor: pointer;" title="Click to next month" data-ctrl='anc-ms-next-item'> Next >></a>
                                        </th>
                                    }
                                </tr>
                                <tr>
                                    <th style="background-color:#b3d3ef">Employee</th>
                                    @{
                                        foreach (var item1 in Model.CAL_HEADER_LIST)
                                        {
                                            var _bgColor = item1.IS_OFFDAY ? item1.OFFDAY_COLOR : "#b3d3ef";
                                            <th class="text-center" style="width:3%; height:30px; background-color:@_bgColor;" title="@item1.CAL_DATE">@item1.CALID</th>

                                            var _bgColor2 = item1.IS_OFFDAY ? item1.OFFDAY_COLOR : "#e9e9e9";
                                            theadTr2.Append("<th class='text-center' style='width:3%;height:30px;background-color:" + _bgColor2 + ";'>" + item1.WEEK_DAY + "</th>");
                                        }
                                    }
                                </tr>
                                <tr style="font-size:12px;">
                                    @*SR102091 Start*@
                                    @{
                                        var count_for_roster = Model.EMP_LIST.Select(s => s.ECODE).Distinct().Count() - Model.NewJoineeCount - Model.InactiveCount;
                                    }
                                    <th style="background-color:#b3d3ef">No. of Emp. @Model.EMP_LIST.Select(s => s.ECODE).Distinct().Count()<br /> (For Roster: @count_for_roster)</th>
                                    @*<th style="background-color:#b3d3ef">No. of Emp. @Model.EMP_LIST.Select(s => s.ECODE).Distinct().Count()</th>*@
                                    @*SR102091 End*@
                                    @{
                                    var theadTr2Html = Html.Raw(theadTr2.ToString());
                                    }
                                    @theadTr2Html
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    if (Model.EMP_LIST.Count > 0)
                                    {
                                        int empcount = 0;
                                        string[] colorArray = new string[7] { "cadetblue", "turquoise", "orange", "lightgreen", "wheat", "powderblue", "aquamarine" };
                                        long DepID = 0;
                                        int colorIndex = 0;
                                        var empBgColor = "";
                                        foreach (var emp_code in Model.EMP_LIST.Select(s => s.ECODE).Distinct())
                                        {
                                            var empObj = Model.EMP_LIST.Where(w => w.ECODE == emp_code).FirstOrDefault();
                                            empcount = empcount + 1;
                                            if (empObj.DEPARTMENTID != null)
                                            {
                                                if (DepID != empObj.DEPARTMENTID)
                                                {
                                                    colorIndex = colorIndex + 1;
                                                    DepID = (long)empObj.DEPARTMENTID;
                                                    colorIndex = colorArray.Length == colorIndex ? 0 : colorIndex;
                                                }
                                            }
                                            empBgColor = colorArray[colorIndex];
                                            <tr>
                                                <th style="font-size:11px; vertical-align:middle; height:35px;background-color:@empBgColor;" title="@empObj.DEPARTMENT">
                                                    @empObj.ENAME - @empObj.ECODE
                                                </th>
                                                @foreach (var empCal in empObj.CAL_LIST)
                                                {
                                                    //SR102091 Start
                                                    //Model.CAL_HEADER_LIST.Where(w => w.CALID == empCal.CALID).SingleOrDefault().DATE_WISE_COUNT += (empCal.IS_CHECKED ? 1 : 0);
                                                    if (!empCal.IsNewJoinee)
                                                    {
                                                        Model.CAL_HEADER_LIST.Where(w => w.CALID == empCal.CALID).SingleOrDefault().DATE_WISE_COUNT += (empCal.IS_CHECKED ? 1 : 0);
                                                    }
                                                    //SR102091 End
                                                    var tdBGColor = ""; var divBgColor = ""; var divAttribute = ""; var divCursor = ""; var _popoverID = "";
                                                    //SR102091 Start
                                                    //if (empCal.IS_READONLY && !empCal.IS_OFFDAY) { tdBGColor = "#e9e9e9"; } 
                                                    if (empCal.IsNewJoinee) { tdBGColor = "#bbfff9ed"; } 
                                                    else if (empCal.IsInActiveEmp) { tdBGColor = "#ffabab"; } 
                                                    else if (empCal.IS_READONLY && !empCal.IS_OFFDAY) { tdBGColor = "#e9e9e9"; } 
                                                    //SR102091 End
                                                    else { tdBGColor = empCal.IS_OFFDAY ? empCal.OFFDAY_COLOR : empCal.WORKINGDAY_COLOR; }

                                                    //SR102091 Start
                                                    //divBgColor = empCal.IS_CHECKED ? "src=../ASPXView/images/office_chair_green.png" : "src=../ASPXView/images/office_chair_Gray.png";
                                                    if (!empCal.IS_OFFDAY && !empCal.IS_READONLY && !empCal.IsInActiveEmp)//SR102091
                                                    {
                                                        divBgColor = empCal.IS_CHECKED || empCal.IsNewJoinee ? "src=../ASPXView/images/office_chair_green.png" : "src=../ASPXView/images/office_chair_Gray.png";
                                                    }
                                                    else
                                                    {
                                                        divBgColor = empCal.IS_CHECKED ? "src=../ASPXView/images/office_chair_green.png" : "src=../ASPXView/images/office_chair_Gray.png";
                                                    }
                                                    //divAttribute = !empCal.IS_READONLY && !empCal.IS_OFFDAY ? "data-ctrl=ctrl-div-click" : "";
                                                    divAttribute = !empCal.IS_READONLY && !empCal.IS_OFFDAY && !empCal.IsNewJoinee && !empCal.IsInActiveEmp ? "data-ctrl=ctrl-div-click" : "";
                                                    //divCursor = !empCal.IS_READONLY && !empCal.IS_OFFDAY ? "pointer;" : "";
                                                    divCursor = !empCal.IS_READONLY && !empCal.IS_OFFDAY && !empCal.IsNewJoinee && !empCal.IsInActiveEmp ? "pointer;" : "";
                                                    //SR102091 End
                                                    _popoverID = empObj.ECODE + "_" + empCal.CALID;

                                                <td class="text-center" style="width:3%;background-color:@tdBGColor;" data-popover-id="@_popoverID">
                                                    @{

                                                        //SR102091 Start        
                                                        //if (empCal.IS_OFFDAY) 
                                                        if (empCal.IsNewJoinee)
                                                        {
                                                    <div class="hidden" id="@_popoverID" style="font-size:11px;">
                                                        <div class="popover-heading">
                                                            <b>Date&nbsp;:&nbsp;</b>@empCal.CAL_DATE
                                                        </div>
                                                        <div class="popover-body">
                                                            <b>New Joiner</b>
                                                        </div>
                                                    </div>
                                                        }
                                                        else if (empCal.IsInActiveEmp)
                                                        {
                                                    <div class="hidden" id="@_popoverID" style="font-size:11px;">
                                                        <div class="popover-heading">
                                                            <b>Date&nbsp;:&nbsp;</b>@empCal.CAL_DATE
                                                        </div>
                                                        <div class="popover-body">
                                                            <b>Inactive</b>
                                                        </div>
                                                    </div>
                                                        }
                                                        else if (empCal.IS_OFFDAY)
                                                        //SR102091 End
                                                        {
                                                    <div class="hidden" id="@_popoverID" style="font-size:11px;">
                                                        <div class="popover-heading">
                                                            <b>Date&nbsp;:&nbsp;</b>@empCal.CAL_DATE
                                                        </div>
                                                        <div class="popover-body">
                                                            <b>Off Day</b>
                                                        </div>
                                                    </div>
                                                        }
                                                        else
                                                        {
                                                    <div class="hidden" id="@_popoverID" style="font-size:11px;">
                                                        <div class="popover-heading">
                                                            <b>Date&nbsp;:&nbsp;</b>@empCal.CAL_DATE
                                                        </div>
                                                        <div class="popover-body">
                                                            <b>Employee&nbsp;:&nbsp;</b>@empObj.ENAME
                                                        </div>
                                                    </div>
                                                        }
                                                <div style="cursor: @divCursor;" @divAttribute data-placement="top" data-container="body" data-toggle="popover" data-popover-content="#@_popoverID" data-html="true" data-trigger="hover">
                                                    @*@if (!empCal.IS_OFFDAY && !empCal.IS_READONLY)*@
                                                    @if (!empCal.IS_OFFDAY && !empCal.IS_READONLY && !empCal.IsInActiveEmp) //SR102091
                                                            {
                                                                var checkBoxID = ""; var IsChecked = "";
                                                                checkBoxID = "chk_" + empcount + "_" + empCal.CALID;
                                                        //SR102091 Start
                                                                //IsChecked = empCal.IS_CHECKED ? "checked=checked" : "";
                                                                //<input type="checkbox" id="@checkBoxID" @IsChecked class="hidden" data-ctrl="ctrl-check-click" data-ecode="@empObj.ECODE" data-date="@empCal.CAL_DATE" data-calid="@empCal.CALID" width="20" height="20"/>
                                                                
                                                                IsChecked = empCal.IS_CHECKED || empCal.IsNewJoinee ? "checked=checked" : "";  
                                                        <input type="checkbox" id="@checkBoxID" @IsChecked class="hidden" data-ctrl="ctrl-check-click" data-ecode="@empObj.ECODE" data-date="@empCal.CAL_DATE" data-calid="@empCal.CALID" width="20" height="20" data-isnewjoinee="@empCal.IsNewJoinee.ToString().ToLower()" />
                                                        //SR102091 End

                                                        }
                                                    <img class="img" @divBgColor />
                                                </div>
                                                }
                                                </td>
                                                }
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class='text-center' style='background-color:#b3d3ef'>Day Wise Count</th>
                                    @foreach (var item2 in Model.CAL_HEADER_LIST)
                                    {
                                        var _bgColor = item2.IS_OFFDAY ? item2.OFFDAY_COLOR : "#b3d3ef";
                                        <th class='text-center' style='width:3%;height:30px;background-color:@_bgColor;'><span class='footer-@item2.CALID'>@item2.DATE_WISE_COUNT</span></th>
                                    }
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 col-lg-12">
                        <div class="col-md-6">
                            <b style="color:blue;">Note :-</b> <br />
                            <p style="font-size:small; color:#a94442;">
                                1.	Save as Draft or Submitted Roster for the next week will become Fixed Roster on every Thursday.<br />
                                @*SR102091 Start*@
                                @*2.	Operating Head can change the Roster in N-1 day also (if required). <br />*@
                                2. Operating Head /Division Head can change the Roster in N-1 day also (if required).<br />
                                3.  All new joiner associates will be mandatorily required to work from office for the first @ViewBag.MandatoryDays days of joining.<br />
                                4. Total no. of Employees: @Model.EMP_LIST.Select(s => s.ECODE).Distinct().Count()
                                (New Joinees: @Model.NewJoineeCount + Inactive Associates: @Model.InactiveCount + For Roster: @count_for_roster)
                                @*SR102091 End*@
                            </p> 
                        </div>
                        <input type="button" value="Save As Draft" class="btn btn-primary btn-save" id="btnSaveDraft" />&nbsp;&nbsp;
                        <input type="button" value="Submit" class="btn btn-success btn-save" id="btnSave" />
                        &nbsp;&nbsp;
                        <input type="button" name="cancel" class="cancel btn btn-dark" value="Cancel" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <form id="_form" action="@Url.Action("ManageSeat","SeatMgmt")" method="post">
        <input type="hidden" id="hfParmValue" name="parmValue" value="0" />
        <input type="hidden" id="hfParmDate" name="parmDate" value="0" />
    </form>
    <div id="ajaxLoader"></div>

@section Scripts{
    <script nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        var arrayList = new Array, actionCount = 0;
        $(document).ready(function () {
            $("#tbmyTable").dataTable({
                "searching": true,
                scrollY: '34.3vh',
                //scrollX: true,
                scrollCollapse: true,
                "paging": false,
                "ordering": false,
                "info": false,
            });

            $("#ajaxLoader").removeClass('loader');

            $("[data-toggle=popover]").popover({
                html: true,
                content: function () {
                    var content = $(this).attr("data-popover-content");
                    return $(content).children(".popover-body").html();
                },
                title: function () {
                    var title = $(this).attr("data-popover-content");
                    return $(title).children(".popover-heading").html();
                }
            });

            //$("#tbmyTable_wrapper").find('.row').eq(0).find('div').eq(0).html('<div class="headDiv col-md-5"><b>Day wise allow seat : ' + "@Model.ALLOW_SEAT" + ' (as per ' + "@Model.ALLOW_PERCENT" + '%.)</b></div><div class="col-md-5" style="padding:8px;"><span style="background-color: #cccccc;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> Not Allocated &nbsp;&nbsp;&nbsp;&nbsp;<span style="background-color: #12b886;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> Allocated</div>');//Commented by Aumento for : SR100656

            //Update / Added by aumento : SR100656
            if(@Model.EXTRA_SEAT != null && @Model.EXTRA_SEAT > 0)
            {
                $("#tbmyTable_wrapper").find('.row').eq(0).find('div').eq(0).html(
                    //SR102091 Start
                    //'<div class="headDiv col-md-5" style="width: 54%;"><b>Day wise allow seat : ' +
                    '<div class="headDiv col-md-5"><b>Day wise allow seat : ' +
                    //SR102091 End
                    '@Model.ALLOW_SEAT' +
                    ' (as per ' + '@Model.ALLOW_PERCENT' + '%) + Extra Seat ' + '@Model.EXTRA_SEAT' + '</b></div>' +
                    //SR102091 Start
                    //'<div class="col-md-5" style="padding:8px;">' +
                    '<div class="col-md-7" style="padding:8px;font-size: small;">' +
                    //SR102091 End
                    '<span style="background-color: #cccccc;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> Not Allocated &nbsp;&nbsp;&nbsp;&nbsp;' +
                    //SR102091 Start
                    //'<span style="background-color: #12b886;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> Allocated</div>' +
                    '<span style="background-color: #12b886;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> Allocated &nbsp;&nbsp;&nbsp;&nbsp;' +
                    '<span style="background-color: #bbfff9ed;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> New Joinee &nbsp;&nbsp;&nbsp;&nbsp;' +
                    '<span style="background-color: #ffabab;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> Inactive &nbsp;&nbsp;&nbsp;&nbsp;</div>'
                    //SR102091 End
                );
            }
            else {
                $("#tbmyTable_wrapper").find('.row').eq(0).find('div').eq(0).html(
                    //SR102091 Start
                    //'<div class="headDiv col-md-5"><b>Day wise allow seat : ' +
                     '<div class="headDiv col-md-5"><b>Day wise allow seat : ' +
                     //SR102091 End
                    "@Model.ALLOW_SEAT" +
                    ' (as per ' + "@Model.ALLOW_PERCENT" + '%.)</b></div>' +
                    //SR102091 Start
                    //'<div class="col-md-5" style="padding:8px;">' +
                    '<div class="col-md-7" style="padding:8px;font-size: small;">' +
                    //SR102091 End
                    '<span style="background-color: #cccccc;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> Not Allocated &nbsp;&nbsp;&nbsp;&nbsp;' +
                    //SR102091 Start
                    //'<span style="background-color: #12b886;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> Allocated</div>'
                    '<span style="background-color: #12b886;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> Allocated &nbsp;&nbsp;&nbsp;&nbsp;' +
                    '<span style="background-color: #bbfff9ed;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> New Joinee &nbsp;&nbsp;&nbsp;&nbsp;' +
                    '<span style="background-color: #ffabab;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> Inactive &nbsp;&nbsp;&nbsp;&nbsp;</div>'
                    //SR102091 End
                );
            }
        });

        function PreNextClick(parmVal) {
            event.stopPropagation();
            if (parmVal != undefined) {
                $("#ajaxLoader").addClass('loader');
                $('#hfParmValue').val(parmVal);
                $('#hfParmDate').val('01-' + '@Model.CAL_MONTH_YEAR');
                $('#_form').submit();
            }
        }

        function divOnclick(curnt) {
            var _checkBox = $(curnt).find("input[type=checkbox]");
            if (_checkBox != "undefined") {
                //_checkBox.click();
                _checkBox.get(0).click();
            }
        }

        function ChkClick(crnt) {
            var _img = $(crnt).parent("div").children(".img")[0];
            //SR102091 Start
            var isNewJoinee = $(crnt).attr("data-isnewjoinee") === "true";
            if (isNewJoinee) {
                _img.src = "../ASPXView/images/office_chair_green.png";
                AddRecord(crnt);
                return;
            }
            //SR102091 End
            if (crnt.checked) {
                var _RecordCount = 0, _Date = "", _calID = "", _fTdID = "", _footerCount = 0;
                _Date = $(crnt).attr("data-date");
                _calID = $(crnt).attr("data-calid");
                _fTdID = '.footer-' + _calID;
                _footerCount = parseInt($(_fTdID).html());

                //_RecordCount = arrayList.filter(function (el) { return el.strROSTER_DATE == _Date && el.STATUS == 1 }).length;
                //Commented by Aumento for : SR100656
                //if (_footerCount >= parseInt('@Model.ALLOW_SEAT')) {
                //           sweetAlert("", "Seat limit for " + _Date + " has exceeded.", "warning");
                //            crnt.checked = false;
                //            return;
                //       }
                //Added by aumento : SR100656
                if (_footerCount >= parseInt('@Model.ALLOW_SEAT')  + parseInt('@Model.EXTRA_SEAT' || '0')) {
                    sweetAlert("", "Seat limit for " + _Date + " has exceeded.", "warning");
                    crnt.checked = false;
                    return;
                }
                else {
                    //_div.style.backgroundColor = "#9ee18b";
                    _img.src = "../ASPXView/images/office_chair_green.png";
                    AddRecord(crnt);
                }
            }
            else {
                //_div.style.backgroundColor = "";
                _img.src = "../ASPXView/images/office_chair_Gray.png";
                DeleteItem(crnt);
            }
        }

        function AddRecord(crnt) {
            debugger;
            var _Ecode = '', _Date = '', _calID = '', _ExistCount = 0, _recordID = '';
            if (arrayList == null || arrayList.length == 0) {
                arrayList = new Array;
            }
            _Ecode = $(crnt).attr("data-ecode");
            _Date = $(crnt).attr("data-date");
            _calID = $(crnt).attr("data-calid");
            _recordID = (_Ecode + "_" + _calID);

            _ExistCount = arrayList.filter(function (el) { return el.RECORDID == _recordID }).length;
            if (_ExistCount > 0) {
                arrayList = $.grep(arrayList, function (e) { return e.RECORDID != _recordID });
            }
            //SR102091 Start
            var IsNewJoineeDay = 0;
            var isNewJoinee = $(crnt).attr("data-isnewjoinee") === "true";
            if (isNewJoinee) {
                IsNewJoineeDay = 1;
            }
            //SR102091 End
            var data = {
                RSTTRNID: 0,
                ADEMPCODE: _Ecode,
                strROSTER_DATE: _Date,
                STATUS: 1,
                RECORDID: _recordID,
                IS_NEWJOINEEDAY:IsNewJoineeDay //SR102091
            }

            actionCount += 1;
            arrayList.push(data);

            DayWiseCalculation(crnt, 1);
        }

        function DeleteItem(crnt) {
            debugger;
            var _Ecode = '', _Date = '', _calID = '', _ExistCount = 0, _recordID = '';
            _Ecode = $(crnt).attr("data-ecode");
            _Date = $(crnt).attr("data-date");
            _calID = $(crnt).attr("data-calid");
            _recordID = (_Ecode + "_" + _calID);

            _ExistCount = arrayList.filter(function (el) { return el.RECORDID == _recordID }).length;
            if (_ExistCount > 0) {
                arrayList = $.grep(arrayList, function (e) { return e.RECORDID != _recordID });
            }

            //SR102091 Start
            var IsNewJoineeDay = 0;
            var isNewJoinee = $(crnt).attr("data-isnewjoinee") === "true";
            if (isNewJoinee) {
                IsNewJoineeDay = 1;
            }
            //SR102091 End

            //else {
                var data = {
                    RSTTRNID: 0,
                    ADEMPCODE: _Ecode,
                    strROSTER_DATE: _Date,
                    STATUS: 0,
                    RECORDID: _recordID,
                    IS_NEWJOINEEDAY:IsNewJoineeDay //SR102091
                }
                arrayList.push(data);
                actionCount = actionCount + 1;
            //}
            DayWiseCalculation(crnt, 0);
        }

        function DayWiseCalculation(crnt, itemStatus) {
            var _fTdId = "", _Date = "", _calId = "", _footerCount = 0, _TotalCount = 0;
            _Date = $(crnt).attr("data-date");
            _calId = $(crnt).attr("data-calid");
            _fTdId = '.footer-' + _calId;
            //if (arrayList != null) {
            //    _Count = _ExistCount = arrayList.filter(function (el) { return el.strROSTER_DATE == _Date && el.STATUS == 1 }).length;
            //}

            //SR102091 Start
            var isNewJoinee = $(crnt).attr("data-isnewjoinee") === "true";
            if (isNewJoinee) return;
            //SR102091 End

            _footerCount = parseInt($(_fTdId).html());
            _TotalCount = (itemStatus == 1 ? (_footerCount + 1) : (_footerCount - 1))
            $(_fTdId).html(_TotalCount);
            return;
        }

        function SaveData() {
            if (actionCount == 0) {
                swal({
                    title: "",
                    text: "Roster saved successfully",
                    type: "success",
                }, function (isConfirm) {
                    if (isConfirm) {
                        window.location.href = "/SeatMgmt/ManageSeat";
                    }
                });
            }
            else {
                $(".btn-save").attr("disabled", true);
                $.ajax({
                    type: "PUT",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    url: "/SeatMgmt/ManageSeat",
                    data: JSON.stringify(arrayList),
                    contentType: "application/json",
                    // contentType: "application/json; charset=utf-8",
                    // datatype: "json",
                    success: function (data) {
                        if (data == 1) {
                            swal({
                                title: "",
                                text: "Roster saved successfully",
                                type: "success",
                            },
                                function (isConfirm) {
                                    if (isConfirm) {
                                        window.location.href = "/SeatMgmt/ManageSeat";
                                    }
                                });
                        }
                        else if (data == 0 || data == -1) {
                            sweetAlert("", "Roster not saved", "warning");
                        }
                    },
                    complete: function () {
                        $(".btn-save").attr("disabled", false);
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function Reset() {
            window.location.href = "/SeatMgmt/ManageSeat";
        }
    </script>

