@model IEnumerable<ePortal.ViewModels.DivWiseSeatViewModel>

@{
    ViewBag.Title = "DivisionWiseSeatMaster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        @@media only screen and (max-width: 600px) {
            .col-xs-8 {
                width: 66.66% !important;
            }

            .col-xs-4 {
                width: 33.33% !important;
            }
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .validationError {
            border: 1px solid #a94442;
        }

        .ui-widget {
            font-family: Verdana,Arial,sans-serif;
            font-size: 0.6em !important;
            overflow: auto;
            max-height: 150px;
        }
    </style>
}


    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                Division Wise Seat Master
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Division Wise Physical Seat List </strong>
                            <strong class="pull-right">
                                <button class="btn btn-success btn-xs" id="maintainDivisionSeatBtn">Maintain Division Seat</button>
                            </strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <table class="table table-bordered table-hover table-responsive" id="tbFixMst">
                            <thead>
                                <tr class="bg-info">
                                    <th class="text-center hidden-xs" style="width:6%;">
                                        @Html.DisplayNameFor(model => model.DWS_DTLID)
                                    </th>
                                    <th class="text-center" style="width:40%;">
                                        @*@Html.DisplayNameFor(model => model.OPERATION)*@
                                        <div class="col-md-7">@Html.DisplayNameFor(model => model.OPERATION)</div>
                                        <div class="col-md-5">@Html.DisplayNameFor(model => model.OPERATION_SEAT)</div>
                                    </th>
                                    @*<th class="text-center" style="width:50%;">
                                            @Html.DisplayNameFor(model => model.DIV_LIST[0].DIVISION) |
                                            @Html.DisplayNameFor(model => model.DIV_LIST[0].PHYSICALSEAT)
                                        </th>*@
                                    <th class="text-center" style="width:40%;">
                                        <div class="col-md-6">@Html.DisplayNameFor(model => model.DIVISION)</div>
                                        <div class="col-md-3">@Html.DisplayNameFor(model => model.PHYSICALSEAT)</div>
                                        <div class="col-md-3">@Html.DisplayNameFor(model => model.IsSeatAutoUpdated)</div> @*// Added by Aumento :: SR100223*@
                                        @*@Html.DisplayNameFor(model => model.DIVISION) &nbsp;&nbsp;&nbsp;&nbsp; | &nbsp;&nbsp;&nbsp;&nbsp;
                                            @Html.DisplayNameFor(model => model.PHYSICALSEAT)*@
                                    </th>
                                    @*<th class="text-center" style="width:25%;">
                                            @Html.DisplayNameFor(model => model.PHYSICALSEAT)
                                        </th>*@
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.STATUS)
                                    </th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNo = 0;
                                }
                                @if (Model != null)
                                {
                                    foreach (var opID in Model.Select(s => s.OPERATIONID).Distinct().ToList())
                                    {
                                        var item = Model.Where(w => w.OPERATIONID == opID).FirstOrDefault();
                                        var g_Status = (Model.Where(w => w.OPERATIONID == opID && w.STATUS == true).Count() > 0) ? true : false;  // Added by Aumento  :: SR102348
                                        <tr>
                                            <td class="text-center hidden-xs">
                                                @(rowNo += 1)
                                                @Html.HiddenFor(modelItem => item.DWS_DTLID)
                                            </td>
                                            <td class="text-left">
                                                <div class="col-md-7" style="background-color: wheat;padding: 3px;text-align: center;border-bottom: 1px solid;">@Html.DisplayFor(modelItem => item.OPERATION)</div>
                                                <div class="col-md-5" style="background-color: wheat;padding: 3px;text-align: center;border-bottom: 1px solid;">@Html.DisplayFor(modelItem => item.OPERATION_SEAT)</div>
                                            </td>
                                            <td class="text-left">
                                                @*@Html.DisplayFor(modelItem => item.DIVISION)*@
                                                @* START :: Added by Aumento  :: SR102348 *@
                                                @{
                                                    var Activecount = Model.Where(x => x.OPERATIONID == opID && x.STATUS == true).Count();
                                                    if (Activecount == 0)
                                                    {
                                                        <div class="col-md-12" style="background-color: wheat;color:red;padding: 3px;text-align: center;border-bottom: 1px solid;">No Active Divisions</div>
                                                    }
                                                    else
                                                    {
                                                        foreach (var divItem in Model.Where(x => x.OPERATIONID == opID).ToList())
                                                        {
                                                            @*// Added by Aumento :: SR100223*@
                                                            <div class="col-md-6" style="background-color: wheat;padding: 3px;text-align: center;border-bottom: 1px solid;height:25px;">@divItem.DIVISION</div>
                                                            <div class="col-md-3" style="background-color: wheat;padding: 3px;text-align: center;border-bottom: 1px solid;height:25px;">@divItem.PHYSICALSEAT</div>
                                                            <div class="col-md-3" style="background-color: wheat;padding: 1px;text-align: center;border-bottom: 1px solid;height:25px;">
                                                                @if (divItem.IsSeatAutoUpdated == "Y")
                                                                {
                                                                    <label class="btn btn-success btn-xs" title="Yes" style="pointer-events: none;">Y</label>
                                                                }
                                                                else
                                                                {
                                                                    <label class="btn btn-danger btn-xs" title="No" style="pointer-events: none;">N</label>
                                                                }
                                                            </div>
                                                            @*// Added by Aumento :: SR100223*@
                                                        }
                                                    }
                                                }

                                            </td>
                                            @*<td class="text-center">
                                                    @Html.DisplayFor(modelItem => item.PHYSICALSEAT)
                                                </td>*@
                                            <td class="text-center">
                                                @*@if (item.STATUS)*@ @*Added by Aumento  :: SR102348*@
                                                @if (g_Status)         // Added by Aumento  :: SR102348
                                                {
                                                    @* END :: Added by Aumento  :: SR102348 *@

                                                    <button class="btn btn-success btn-xs" style="cursor: text !important">Active</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-danger btn-xs" style="cursor: text !important">Deactive</button>
                                                }
                                            </td>

                                            <td class="text-center">
                                                <button class="btn btn-warning btn-xs glyphicon glyphicon-edit" id="btnEdit" data-ctrl="ctrl-btnEdit"
                                                        title="Click here to edit"
                                                        data-opseat="@item.OPERATION_SEAT"
                                                        data-operationid="@item.OPERATIONID">
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-12 bg-info" style="border: 1px solid #61c0ed;border-radius: 0.25em;padding:8px;">
                    <span>
                        <a title="Back" href="/Home/Home">
                            <img src="~/images/icon_back.gif" border="0" alt="">
                            Back
                        </a>
                    </span>
                </div>
            </div>
        </div>

    </div>

    <div id="myCreateModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="padding:10px!important;">
                    <div class="pull-left">
                        <h5 class="modal-title"><span id="sp_type"></span></h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body" style="padding:10px!important;">
                    <div id="myCreateModelContent"></div>
                </div>
            </div>
        </div>
    </div>


    <div id="ajaxLoader"></div>

@section Scripts{
    <script src="~/js/jquery-ui.js"></script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        var IS_Edit = 0;
        $(document).ready(function () {
            $("#tbFixMst").dataTable({
                "bFilter": true,
                "bLengthChange": false
            });

             $(document).off("click", "[data-ctrl='ctrl-btnEdit']");
            $(document).on('click', '[data-ctrl="ctrl-btnEdit"]', function () {
                var operationSeat = $(this).data('opseat');
                var operationId = $(this).data('operationid');
                EditDivisionSeat(operationId,1);
            });

            $('#maintainDivisionSeatBtn').on('click', function () {
                AddDivisionSeat(0);
            });

            $(document).off("click", "[data-ctrl='btn-save']");
            $(document).on("click", "[data-ctrl='btn-save']", function () {
                SaveData();
            });

            $(document).off('change', '[data-ctrl="dd-operation"]');
            $(document).on("change", '[data-ctrl="dd-operation"]', function () {
                BindDivision(this, 0);
            });
        });

        function AddDivisionSeat(isEdit) {
            IS_Edit = isEdit;
            $.ajax({
                type: "GET",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SeatMgmt/AddDivisionSeat",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $("#ajaxLoader").removeClass('loader');
                        $('#sp_type').html("Division Wise Seat");
                        $('#myCreateModelContent').html(data);
                        $('#myCreateModel').modal({ backdrop: "static" });
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function EditDivisionSeat(row_id, isEdit) {
            IS_Edit = isEdit;
            $.ajax({
                type: "GET",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SeatMgmt/EditDivisionSeat",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                data: { id: row_id },
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $("#ajaxLoader").removeClass('loader');
                        $('#sp_type').html("Edit Division Wise Seat");
                        $('#myCreateModelContent').html(data);
                        $('#myCreateModel').modal({ backdrop: "static" });
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function SaveData() {
            var arrayList = new Array;
            var isFormVaildation = CheckFormValidation();
            if (isFormVaildation) {
                $("#btnSave").attr("disabled", true);
                var rowLength = $('#tbDivDtl').find('.row_data').length;
                var rows = $('#tbDivDtl').find('.row_data');
                for (var i = 0; i < rowLength; i += 1) {
                    var row = rows[i];
                    if (row != undefined) {
                        var hfDivisionID = $(row.cells[0]).find('input[type=hidden]').val() == "" ? 0 : $(row.cells[0]).find('input[type=hidden]').val();
                        var hfDwsID = $(row.cells[1]).find('input[type=hidden]').val() == "" ? 0 : $(row.cells[1]).find('input[type=hidden]').val();
                        var PhySeat = $(row.cells[1]).find('#txtPhySeat').val() == "" ? 0 : $(row.cells[1]).find('#txtPhySeat').val();
                        var status = $(row.cells[2]).find('#chkActive')[0].checked;
                        var seatAutoupdate = $(row.cells[3]).find('#chkSeatAutoipdate')[0].checked ? "Y" : "N"; // Added by Aumento :: SR100223
                        if (IS_Edit == 0 && (!status || PhySeat == 0)) {
                            alert("Physical seat & status are mandatory.");
                            $(row.cells[1]).find('#txtPhySeat').focus();
                            $("#btnSave").attr("disabled", false);
                            return;
                        }
                        var rowData = {
                            DWSID: hfDwsID,
                            DIVISIONID: hfDivisionID,
                            PHYSICALSEAT: PhySeat,
                            STATUS: status,
                            IsSeatAutoUpdated: seatAutoupdate, // Added by Aumento :: SR100223
                        }
                        arrayList.push(rowData);
                    }
                }
                if (arrayList.length == 0) {
                    sweetAlert("", "Please maintain physical seat at least one division.", "warning");
                    $("#btnSave").attr("disabled", false);
                    return;
                }
                var data = {
                    OPERATIONID: $('#ddOperation').val(),
                    DIV_LIST: arrayList
                }

                $.ajax({
                    type: "POST",
                    url: "/SeatMgmt/DivisionWiseSeatMaster",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: JSON.stringify(data),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        $('#myCreateModel').modal('hide');
                        if (data == 1) {
                            swal({
                                title: "",
                                text: "Record saved successfully.",
                                type: "success",
                            }, function (isConfirm) {
                                if (isConfirm) {
                                    window.location.href = "/SeatMgmt/DivisionWiseSeatMaster";
                                }
                            });
                        }
                        else if (data == 2) {
                            sweetAlert("", "Record already exist.", "warning");
                        }
                        else if (data == 3) {
                            sweetAlert("", "Physical seat limit has been exceeded for " + $("#ddOperation option:selected").text() + ".", "warning");
                        }
                        else {
                            sweetAlert("", "Record not saved.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function CheckFormValidation() {
            var isVailed = true;
            $('#ddOperation').removeClass('validationError');
            if ($('#ddOperation').val() == "") {
                $('#ddOperation').addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }
    </script>

}
