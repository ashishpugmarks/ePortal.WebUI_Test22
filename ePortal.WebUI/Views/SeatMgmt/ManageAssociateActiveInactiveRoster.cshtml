@model ePortal.ViewModels.SearchSeatViewModel

@{
    ViewBag.Title = "ManageAssociateActiveInactiveRoster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .form-control {
            height: 28px;
            padding: 3px 3px;
            font-size: 13px;
        }
    </style>
}


    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                Manage Active-Inactive Roster
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Search</strong>
                        </h2>
                    </div>
                    <div class="panel-body" style="padding:5px;">
                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.Employee, new { @class = "control-label text-right col-md-1", @style = "margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2">
                                @Html.TextBoxFor(model => model.Employee, new { @type = "number", @value = "", @id = "txtEmpCode", @class = "form-control" })
                            </div>
                            @Html.LabelFor(model => model.OpId, new { @class = "control-label text-right col-md-1", @style = "margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2">
                                @Html.DropDownListFor(model => model.OpId,
                                         new SelectList(ViewBag.OpList.Items, "Value", "Text"),
                                         "- Select -",
                                         new { @id = "ddlOp", @data_ctrl = "ddl-op", @class = "form-control" })
                            </div>

                            @Html.LabelFor(model => model.DivId, new { @class = "control-label text-right col-md-1", @style = "margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2">
                                @Html.DropDownListFor(model => model.DivId, new SelectList(ViewBag.DivList.Items, "Value", "Text"), "- Select -", new { @id = "ddlDiv", @class = "form-control" })
                            </div>
                            @Html.LabelFor(model => model.Status, new { @class = "control-label text-right col-md-1", @style = "margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2">
                                @*@Html.DropDownListFor(model => model.Status, new SelectList( "Value", "Text"), "- Select -", new { @id = "ddlStatus", @class = "form-control" })*@
                                @Html.DropDownListFor(model => model.Status, new List<SelectListItem>
                                {
                                new SelectListItem{ Text="-- ALL --", Value = "-1"},
                                new SelectListItem{ Text="Active", Value = "1" },
                                new SelectListItem{ Text="Inactive", Value = "0" },
                                }, new { @class = "form-control", @id = "ddlStatus" })
                            </div>
                        </div>
                        <div class="row" style="padding:4px 4px 10px 4px;">
                            @*@Html.Label("From Date", new { @class = "control-label text-right col-md-2", @style = "margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2">
                                <input id="txtFromDate" class="form-control datepic" placeholder="dd-MMM-yyyy" style="width: 120px;" name="Fromdate" type="text" value="" readonly="readonly" />
                            </div>
                            @Html.Label("To Date", new { @class = "control-label text-right col-md-1", @style = "margin-top: 7px;" })
                            <div class="col-lg-3 col-md-3">
                                <input id="txtToDate" class="form-control datepic" placeholder="dd-MMM-yyyy" style="width: 120px;" name="Todate" type="text" value="" readonly="readonly" />
                            </div>*@



                        </div>
                        <div class="row" style="margin-left: 37%;">
                            <div>
                                <button id="btnSubmit" class="btn btn-success btn-sm">Search</button>
                                <button id="btnExcel" class="btn btn-primary btn-sm">Export To Excel</button>
                                <input type="button" value="Reset" class="btn btn-default btn-sm" id="btnReset" />
                            </div>

                        </div>
                        <div id="div_append" style="/*overflow: auto;*/max-height: 294px;"></div>
                    </div>
                </div>
            </div>
            <div id="ajaxLoader"></div>
        </div>
    </div>

@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $('#txtEmpCode').val('');
            $('.datepic').datepicker({
                format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top'
            });

            BindDivision($("#ddlOp"), 1);

            $("#btnSubmit").click();
        });

        ////======== Bind Division========////
        function BindDivision(crnt, call) {
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            $.getJSON("/SeatMgmt/BindDivisionByOperationId", { id: dID },
                   function (data) {
                       var select = $("#ddlDiv");
                       select.empty();
                       if (data.divList.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data.divList, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.Value,
                               text: itemData.Text
                           }));
                       });
                       if ('@Model.DivId' != '' && call == 1) {
                           $("#ddlDiv").val('@Model.DivId');
                       }
                   });
        }        

        function GetReportList(crnt) {
            var data = {
                OpId: $('#ddlOp').val() == "" ? 0 : $('#ddlOp').val(),
                DivId: $('#ddlDiv').val() == "" ? 0 : $('#ddlDiv').val(),
                Employee: $('#txtEmpCode').val() == "" ? 0 : $('#txtEmpCode').val(),
                Status: $('#ddlStatus').val() == "" ? 0 : $('#ddlStatus').val(),
                FromDate:"",
                ToDate:""
            }
            console.log(data);
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SeatMgmt/ManageAssociateActiveInactiveRoster",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#div_append').html(data);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function GetExcel(crnt) {
            var data = {
                OpId: $('#ddlOp').val() == "" ? 0 : $('#ddlOp').val(),
                DivId: $('#ddlDiv').val() == "" ? 0 : $('#ddlDiv').val(),
                Employee: $('#txtEmpCode').val() == "" ? 0 : $('#txtEmpCode').val(),
                Status: $('#ddlStatus').val() == "" ? 0 : $('#ddlStatus').val()
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SeatMgmt/ExportToExcelActiveInactiveDetail",
                data: JSON.stringify(data),
                contentType: "application/json",                
                // contentType: "application/json; charset=utf-8",
                // datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "SeatMgmt", Action = "DownloadExcel" })";
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }


        function ActionBtn(crnt, empCode) {

            $.ajax({
                url: "/SeatMgmt/UpdateEmployeeStatus",
                type: 'POST',
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                traditional: true, // Important to send array properly
                data: { empCode: empCode },
                success: function (response) {
                    if (response.success) {
                        sweetAlert("Done", "Update successful!", "success");
                        GetReportList(this);
                    } else {
                        alert("Error: " + (response.message || "Something went wrong."));
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function (xhr, status, error) {
                    alert("Error: " + error);
                }
            });
        }
        function View(crnt, EmpCode) {
            $.fancybox.open({
                href: '/SeatMgmt/ManageAssociateActiveInactiveRosterHistory?empId=' + EmpCode,
                type: 'iframe',
                autoSize: true,
                fitToView: true,
                maxWidth: '100%',
                maxHeight: '97%',
                width: '95%',
                height: '95%',
                padding: 5,
                closeClick: true,
                openEffect: 'elastic',
                openSpeed: 120,
                closeEffect: 'elastic',
                closeSpeed: 100,
                afterClose: function () {
                    GetReportList(this);
                },
                helpers: {
                    overlay: { closeClick: false }
                }
            });
        }
    </script>

    @* CSP 3.0 Compliant changes *@
    <script nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#btnSubmit').on('click', function () {
                GetReportList(this);
            });
             $('#div_append').on('click', '.btnaction', function () {

                 ActionBtn(this, this.value);
             });
             $('#div_append').on('click', '.logView', function () {
                console.log('view log click');
                 View(this, this.value);
             });

            $('#btnExcel').on('click', function() {
                GetExcel(this);
            });

            $('#btnReset').on('click', function() {
                window.location.href = '@Url.Action("ManageAssociateActiveInactiveRoster", "SeatMgmt")';
            });

             $(document).off("change", "[data-ctrl='ddl-op']");
             $(document).on("change", "[data-ctrl='ddl-op']", function () {
                 BindDivision(this, 0);
             });
        });
    </script>
}
