@model IEnumerable<ePortal.ViewModels.SeatingAllocationSummaryReportViewModel>

@{
    Layout = null;
}

<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    select.input-sm {
        line-height: 10px !important;
    }
</style>

<table class="table table-bordered table-hover table-responsive" id="tbRequestReport">
    <thead>
        <tr class="bg-info">
            <th class="text-center">
                @Html.DisplayNameFor(model => model.SRNO)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.DATE)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.FLOOR)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.TOTAL_MANEPOWER)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.SEATCAPACITY)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.TOTAL_PHISICAL_SEAT)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.ALLOCATED_SEAT)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.VACANT_SEAT)
            </th>

        </tr>
    </thead>
    <tbody>
        @{
            int rowNo = 0;
        }
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td class="text-center" style="width:3%;">
                        @(rowNo += 1)
                        @Html.HiddenFor(modelItem => item.SRNO)
                    </td>
                    <td class="text-center" style="width:10%;">
                        @Html.DisplayFor(modelItem => item.DATE)
                    </td>


                    @if (!string.IsNullOrEmpty(item.BUILDING))
                    {
                        <td class="text-center">
                            @Html.DisplayFor(modelItem => item.BUILDING) / @Html.DisplayFor(modelItem => item.FLOOR)
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }


                    <td class="text-center">
                        @Html.DisplayFor(modelItem => item.TOTAL_MANEPOWER)
                    </td>
                    <td class="text-center">
                        @Html.DisplayFor(modelItem => item.SEATCAPACITY)
                    </td>
                    <td class="text-center">
                        @Html.DisplayFor(modelItem => item.TOTAL_PHISICAL_SEAT)
                    </td>
                    <td class="text-center">
                        @Html.DisplayFor(modelItem => item.ALLOCATED_SEAT)
                    </td>
                    <td class="text-center">
                        @Html.DisplayFor(modelItem => item.VACANT_SEAT)
                    </td>

                </tr>
            }
        }
    </tbody>
</table>
