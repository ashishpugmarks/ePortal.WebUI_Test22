@model IEnumerable<ePortal.ViewModels.SeatingAllocationDetailReportViewModel>

@{
    Layout = null;
}

<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    select.input-sm {
        line-height: 10px !important;
    }
</style>

<table class="table table-bordered table-hover table-responsive" id="tbRequestReport">
    <thead>
        <tr class="bg-info">
            <th class="text-center">
                @Html.DisplayNameFor(model => model.SEATINGID)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.ADEMPCODE)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.ADEMPNAME)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.OPERATION)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.DIVISION)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.FLOOR)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.DATE)
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.SEATNO)
            </th>
            @*SR102091 Start*@
            @*<th class="text-center">
            @Html.DisplayNameFor(model => model.REMARKS)
        </th>*@
            <th class="text-center">Status</th>
            @*SR102091 End*@

        </tr>
    </thead>
    <tbody>
        @{
            int rowNo = 0;
        }
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td class="text-center" style="width:3%;">
                        @(rowNo += 1)
                        @Html.HiddenFor(modelItem => item.SEATINGID)
                    </td>
                    <td class="text-center">
                        @Html.DisplayFor(modelItem => item.ADEMPCODE)
                    </td>
                    <td class="text-center">
                        @Html.DisplayFor(modelItem => item.ADEMPNAME)
                    </td>

                    <td class="text-center">
                        @Html.DisplayFor(modelItem => item.OPERATION)
                    </td>
                    <td class="text-center">
                        @Html.DisplayFor(modelItem => item.DIVISION)
                    </td>
                    @if (!string.IsNullOrEmpty(item.BUILDING))
                    {
                        <td class="text-center">
                            @Html.DisplayFor(modelItem => item.BUILDING) / @Html.DisplayFor(modelItem => item.FLOOR)
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    <td class="text-center" style="width:10%;">
                        @Html.DisplayFor(modelItem => item.DATE)
                    </td>

                    @if (!string.IsNullOrEmpty(item.SEATNAME))
                    {
                        //SR102091 Start
                        if (item.SEATNAME == "SEAT NOT ALLOCATED")
                        {
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.SEATNAME)
                            </td>
                        }
                        else
                        {
                            //SR102091 End
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.SEATNAME) -@Html.DisplayFor(modelItem => item.SEATNO)
                            </td>
                        }//SR102091
                    }
                    else
                    {
                        <td></td>
                    }

                    <td class="text-center">
                        @Html.DisplayFor(modelItem => item.REMARKS)
                        @*@if (item.REMARKS == "1")
                            {
                                <span> OFF DAY </span>
                            }
                            else
                            {
                                <span>WFH</span>
                            }*@
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
