@model IEnumerable<ePortal.ViewModels.FloorOperationMapViewModel>

@{
    ViewBag.Title = "FloorOperationMapping";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        @@media only screen and (max-width: 600px) {
            .col-xs-8 {
                width: 66.66% !important;
            }

            .col-xs-4 {
                width: 33.33% !important;
            }
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .ui-widget {
            font-family: Verdana,Arial,sans-serif;
            font-size: 0.6em !important;
            overflow: auto;
            max-height: 150px;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }
    </style>
}


    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                Floor Operation Mapping
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>List of Operation Mapping</strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <div class="form-group">
                        @Html.Label("Floor", "Floor", new { @class = "control-label text-right col-xs-4 col-sm-2 col-md-1 col-lg-1", @style = "margin-top: 7px;padding-bottom: 5px;" })
                            <div class="col-xs-8 col-sm-3 col-md-2 col-lg-2" style="padding-bottom: 5px;">
                                <input type="hidden" id="hfOpMapID" value="0" />
                                @Html.DropDownList("Floor", new SelectList(ViewBag.FloorList.Items, "Value", "Text"), "-Select Floor-", new { @id = "ddFloor", @class = "form-control" })
                            </div>

                        @Html.Label("Operation", "Operation", new { @class = "control-label text-right col-xs-4 col-sm-2 col-md-1", @style = "margin-top: 7px;padding-bottom: 5px;" })
                            <div class="col-xs-8 col-sm-3 col-md-2 col-lg-2" style="padding-bottom: 5px;">
                                @Html.DropDownList("Operation", new SelectList(ViewBag.OpList.Items, "Value", "Text"), "-Select Operation-", new { @id = "ddOperation", @class = "form-control" })
                            </div>

                        @Html.Label("Seat Capacity", "Seat Capacity", new { @class = "control-label text-right col-xs-4 col-sm-1 col-md-2", @style = "margin-top: 7px;padding-bottom: 5px;" })
                            <div class="col-xs-8 col-sm-1 col-md-1 col-lg-1" style="padding-bottom: 5px;">
                                @Html.Editor("Capacity", new { htmlAttributes = new { @type = "number", @id = "txtSeatCapacity", @class = "form-control" } })
                            </div>

                            <div class="col-xs-8 col-sm-2 col-md-2 col-lg-2" style="padding-bottom: 5px;">
                                <input type="button" id="btnSave" class="btn btn-primary btn-sm" value="Save" />
                                <input type="button" id="btnReset" value="Reset" class="btn btn-default btn-sm" />
                            </div>
                        </div>

                        <table class="table table-bordered table-hover table-responsive" id="tbFixMst">
                            <thead>
                                <tr class="bg-info">
                                    <th class="text-center hidden-xs" style="width:5%;">
                                        @Html.DisplayNameFor(model => model.FLOOR_OPMAPPID)
                                    </th>
                                    <th class="text-center" style="width:15%;">
                                        @Html.DisplayNameFor(model => model.BUILDING)
                                    </th>
                                    <th class="text-center" style="width:15%;">
                                        @Html.DisplayNameFor(model => model.FLOOR)
                                    </th>
                                    <th class="text-center" style="width:20%;">
                                        @Html.DisplayNameFor(model => model.OPERATION)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.SEATCAPACITY)
                                    </th>
                                    <th class="text-center" style="width:10%;">
                                        @Html.DisplayNameFor(model => model.STATUS)
                                    </th>
                                    @*Added by Aumento :: SR100223*@
                                    <th class="text-center" style="width:10%;">
                                        Seat Auto Update
                                    </th>
                                    @*Added by Aumento :: SR100223*@
                                    <th class="text-center" style="width:10%;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNo = 0;
                                }
                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="text-center hidden-xs">
                                                @(rowNo += 1)
                                                @Html.HiddenFor(modelItem => item.FLOOR_OPMAPPID)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.BUILDING)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.FLOOR)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.OPERATION)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.SEATCAPACITY)
                                            </td>
                                            <td class="text-center">
                                                @if (item.STATUS == 1)
                                                {
                                                    <button class="btn btn-success btn-xs" style="cursor: text !important">Active</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-danger btn-xs" style="cursor: text !important">Deactive</button>
                                                }
                                            </td>
                                            @*START :: Added by Aumento :: SR100223*@
                                            <td class="text-center">
                                                @if (item.IsSeatAutoUpdated == "Y")
                                                {
                                                    <label class="btn btn-success btn-xs" title="Yes" style="pointer-events: none;">Y</label>
                                                }
                                                else
                                                {
                                                    <label class="btn btn-danger btn-xs" title="No" style="pointer-events: none;">N</label>
                                                }
                                            </td>

                                            <td class="text-center">
                                                @{
                                                    var autoUpdateClass = item.IsSeatAutoUpdated == "Y" ? "btn-success" : "btn-danger";
                                                    var autoUpdateTitle = item.IsSeatAutoUpdated == "Y" ? "Click here to set seat update manual" : "Click here to set seat update auto";
                                                    var autoUpdateNextValue = item.IsSeatAutoUpdated == "Y" ? "N" : "Y";
                                                    var autoUpdateAction = item.IsSeatAutoUpdated == "Y" ? "Update seat count manually" : "Auto-update Seat count";
                                                    var autoUpdateCtrl = item.IsSeatAutoUpdated == "Y" ? "ctrl-btnSeatAutoUpdatedManual" : "ctrl-btnSeatAutoUpdatedAuto";
                                                    var autoUpdateDisabled = item.STATUS == 0 ? "disabled" : "";
                                                }
                                                <button class="btn @autoUpdateClass btn-xs glyphicon glyphicon-cog"
                                                        title="@autoUpdateTitle"
                                                        data-floor-opmappid="@item.FLOOR_OPMAPPID"
                                                        data-status="@item.STATUS"
                                                        data-seatautoupdate="@autoUpdateNextValue"
                                                        data-action="@autoUpdateAction"
                                                        data-ctrl="@autoUpdateCtrl"
                                                        id="btnSeatAutoUpdated"
                                                @autoUpdateDisabled></button>

                                                @{

                                                    var statusClass = "btn-default btn-xs glyphicon " + (item.STATUS == 1 ? "glyphicon-eye-close" : "glyphicon-eye-open");
                                                    var statusTitle = item.STATUS == 1 ? "Click here to deactivate" : "Click here to activate";
                                                    var statusNext = item.STATUS == 1 ? 0 : 1;
                                                    var statusAction = item.STATUS == 1 ? "deactivate the record" : "activate the record";
                                                    var statusCtrl = item.STATUS == 1 ? "ctrl-btnDeactivate" : "ctrl-btnActivate";
                                                }
                                                <button class="@statusClass"
                                                        title="@statusTitle"
                                                        data-floor-opmappid="@item.FLOOR_OPMAPPID"
                                                        data-status="@statusNext"
                                                        data-seatautoupdate="@item.IsSeatAutoUpdated"
                                                        data-action="@statusAction"
                                                        data-ctrl="@statusCtrl"
                                                        id="btnStatusToggle"></button>

                                                @{

                                                    var editDisabled = item.IsSeatAutoUpdated == "Y" ? "disabled" : "";
                                                }
                                                <button class="btn btn-warning btn-xs glyphicon glyphicon-edit"
                                                        title="Click here to edit"
                                                        data-capacity="@item.SEATCAPACITY"
                                                        data-opid="@item.OPERATIONID"
                                                        data-floorid="@item.FLOORID"
                                                        data-seatautoupdate="@item.IsSeatAutoUpdated"
                                                        data-id="@item.FLOOR_OPMAPPID"
                                                        data-ctrl="ctrl-btnEdit"
                                                @editDisabled></button>
                                            </td>
                                            @*END :: Added by Aumento :: SR100223*@
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-12 bg-info" style="border: 1px solid #61c0ed;border-radius: 0.25em;padding:8px;">
                    <span>
                        <a title="Back" href="/Home/Home">
                            <img src="~/images/icon_back.gif" border="0" alt="">
                            Back
                        </a>
                    </span>
                </div>
            </div>
        </div>

    </div>

    <div id="ajaxLoader"></div>


@section Scripts{

    <script src="~/js/jquery-ui.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $("#tbFixMst").dataTable({
                "bFilter": true,
                "bLengthChange": false
            });
            $("#txtSeatCapacity").val('');

             $('#btnSave').on('click', function () {
                     SaveRecord(this);
                 });

                 $(document).off("click", "[data-ctrl='ctrl-btnActivate']");
                 $(document).on('click', '[data-ctrl="ctrl-btnActivate"]', function () {
                     const floorOpMapId = $(this).data('floor-opmappid');
                     const status = $(this).data('status');
                     const action = $(this).data('action');
                     const seatautoupdate = $(this).data('seatautoupdate'); // Added by Aumento :: SR100223
                     UpdateRecord(floorOpMapId, status, action, seatautoupdate); // Updated by Aumento :: SR100223
                 });

                 $(document).off("click", "[data-ctrl='ctrl-btnDeactivate']");
                 $(document).on('click', '[data-ctrl="ctrl-btnDeactivate"]', function () {
                     const floorOpMapId = $(this).data('floor-opmappid');
                     const status = $(this).data('status');
                     const action = $(this).data('action');
        // START :: Added by Aumento :: SR100223
                     const seatautoupdate = 'N'; // Added by Aumento :: SR100223
                     UpdateRecord(floorOpMapId, status, action, seatautoupdate); // Updated by Aumento :: SR100223
                 });

                 $(document).off("click", "[data-ctrl='ctrl-btnSeatAutoUpdatedManual']");
                 $(document).on('click', '[data-ctrl="ctrl-btnSeatAutoUpdatedManual"]', function () {
                     const floorOpMapId = $(this).data('floor-opmappid');
                     const status = $(this).data('status');
                     const action = $(this).data('action');
                     const seatautoupdate = $(this).data('seatautoupdate');
                     UpdateRecord(floorOpMapId, status, action, seatautoupdate);
                 });

                 $(document).off("click", "[data-ctrl='ctrl-btnSeatAutoUpdatedAuto']");
                 $(document).on('click', '[data-ctrl="ctrl-btnSeatAutoUpdatedAuto"]', function () {
                     const floorOpMapId = $(this).data('floor-opmappid');
                     const status = $(this).data('status');
                     const action = $(this).data('action');
                     const seatautoupdate = $(this).data('seatautoupdate');
        // END :: Added by Aumento :: SR100223
                     UpdateRecord(floorOpMapId, status, action, seatautoupdate); // Updated by Aumento :: SR100223
                 });

                 $(document).off("click", "[data-ctrl='ctrl-btnEdit']");
                 $(document).on('click', '[data-ctrl="ctrl-btnEdit"]', function () {
                     const capacity = $(this).data('capacity');
                     const opId = $(this).data('opid');
                     const floorId = $(this).data('floorid');
                     const floorOpMapId = $(this).data('id');
                     EditRecord(this);
                 });

                $('#btnReset').on('click', function() {
                    window.location.href = '@Url.Action("FloorOperationMapping", "SeatMgmt")';
                });
        });

        function SaveRecord(current) {
            var isFormVaildation = CheckFormValidation();
            if (isFormVaildation) {
                var data = {
                    FLOOR_OPMAPPID: $("#hfOpMapID").val(),
                    FLOORID: $("#ddFloor").val(),
                    OPERATIONID: $("#ddOperation").val(),
                    SEATCAPACITY: $("#txtSeatCapacity").val(),
                    STATUS: 1
                    ,IsSeatAutoUpdated: $("#SeatAutoupdate").prop("checked") ? "Y" : "N" // Added by Aumento :: SR100223
                }
                $.ajax({
                    type: "POST",
                    url: "/SeatMgmt/FloorOperationMapping",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: JSON.stringify(data),
                     contentType: "application/json",
                    // contentType: "application/json; charset=utf-8",
                    // datatype: "json",
                    success: function (data) {
                        if (data == 1) {
                            swal({
                                title: "",
                                text: "Record saved successfully.",
                                type: "success",
                            },
                                 function (isConfirm) {
                                     if (isConfirm) {
                                         window.location.href = "/SeatMgmt/FloorOperationMapping";
                                     }
                                 });
                        }
                        else if (data == 2) {
                            sweetAlert("", "Record already exist.", "warning");
                        }
                        else {
                            sweetAlert("", "Record not saved.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function CheckFormValidation() {
            var isVailed = true;
            $('#ddOperation').removeClass('validationError');
            if ($('#ddOperation').val() == "") {
                $('#ddOperation').addClass('validationError');
                isVailed = false;
            }
            $('#ddFloor').removeClass('validationError');
            if ($('#ddFloor').val() == "") {
                $('#ddFloor').addClass('validationError');
                isVailed = false;
            }
            $('#txtSeatCapacity').removeClass('validationError');
            if ($('#txtSeatCapacity').val() == "" || $('#txtSeatCapacity').val() == "0") {
                $('#txtSeatCapacity').addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }

        function UpdateRecord(row_id, status, label, IsSeatAutoUpdated) { // IsSeatAutoUpdated Updated by Aumento :: SR100223

            swal({
                title: "Do you want to " + label + " ?"/*" the record ?"*/,  // Updated by Aumento :: SR100223
                text: "",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                closeOnConfirm: false,
                closeOnCancel: true
            },
            function (isConfirm) {
                if (isConfirm) {
                    $.ajax({
                        type: "PUT",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        url: "/SeatMgmt/FloorOperationMapping",
                        // contentType: "application/json; charset=utf-8",
                        // datatype: "json",
                        // data: JSON.stringify({ id: row_id, status: status, IsSeatAutoUpdated: IsSeatAutoUpdated }),  // IsSeatAutoUpdated Updated by Aumento :: SR100223
                        data: { id: row_id, status: status, IsSeatAutoUpdated: IsSeatAutoUpdated },
                        success: function (data) {
                            if (data == 1) {
                                swal({
                                    title: "",
                                    text: "Record updated successfully.",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                        window.location.href = "/SeatMgmt/FloorOperationMapping";
                                    }
                                });
                            }
                            else {
                                sweetAlert("", "Record not updated, Please try again.", "warning");
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }
            });
        }

        function EditRecord(crnt) {
            $("#ddFloor").val($(crnt).attr('data-floorid'));
            $("#ddOperation").val($(crnt).attr('data-opid'));
            $("#txtSeatCapacity").val($(crnt).attr('data-capacity'));
            $("#hfOpMapID").val($(crnt).attr('data-id'));
            $("#btnSave").attr('value', 'Update');
            $("#SeatAutoupdate").prop("checked", $(crnt).attr('data-seatautoupdate') === "Y"); // Added by Aumento :: SR100223
        }
    </script>


}