@model IEnumerable<ePortal.ViewModels.ExtrSeatMstViewModel>

@{
    ViewBag.Title = "Extra Seat For Division List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        @@media only screen and (max-width: 600px) {
            .col-xs-8 {
                width: 66.66% !important;
            }

            .col-xs-4 {
                width: 33.33% !important;
            }
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .ui-widget {
            font-family: Verdana,Arial,sans-serif;
            font-size: 0.6em !important;
            overflow: auto;
            max-height: 150px;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }
    </style>
}

 

    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                Extra Seat For Division Master
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>List of Seat </strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <div class="form-group">
                            @Html.Label("Division", "Division", new { @class = "control-label text-right col-xs-4 col-sm-2 col-md-1 col-lg-1", @style = "margin-top: 7px;padding-bottom: 5px;" })
                            <div class="col-xs-8 col-sm-3 col-md-2 col-lg-2" style="padding-bottom: 5px;">
                                <input type="hidden" id="hdnSrNo" value="0" />
                                @Html.DropDownList("DIVISION", new SelectList(ViewBag.Division.Items, "Value", "Text"), "-Select Division-", new { @id = "ddDivision", @class = "form-control" })
                            </div>

                            @Html.Label("Extra Seat", "Extra Seat", new { @class = "control-label text-right col-xs-4 col-sm-1 col-md-1", @style = "margin-top: 7px;padding-bottom: 5px;" })
                            <div class="col-xs-8 col-sm-1 col-md-2 col-lg-1" style="padding-bottom: 5px;">
                                @Html.Editor("EXTRASEATCOUNT", new
                                    {
                                        htmlAttributes = new
                                        {
                                            @type = "number",
                                            @id = "txtEXTRASEATCOUNT",
                                            @class = "form-control no-spinner",
                                            @min = "1",
                                            @max = "999"
                                        }
                                    })
                            </div>




                            <div class="col-xs-8 col-sm-2 col-md-2 col-lg-2" style="padding-bottom: 5px;">
                                <input type="button" id="btnSave" class="btn btn-primary" value="Save" />
                                <input type="button" id="btnReset" value="Reset" class="btn btn-default" />
                            </div>
                        </div>

                        <table class="table table-bordered table-hover table-responsive" id="tbSeatMst">
                            <thead>
                                <tr class="bg-info">
                                    <th class="text-center hidden-xs" style="width:5%;">
                                        @Html.DisplayNameFor(model => model.SRNO)
                                    </th>
                                    <th class="text-center" style="width:15%;">
                                        @Html.DisplayNameFor(model => model.DIVISION)
                                    </th>
                                    <th class="text-center" style="width:15%;">
                                        @Html.DisplayNameFor(model => model.EXTRASEATCOUNT)
                                    </th>
                                    <th class="text-center" style="width:10%;">
                                        @Html.DisplayNameFor(model => model.STATUS)
                                    </th>
                                    <th class="text-center" style="width:10%;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNo = 0;
                                }
                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="text-center hidden-xs">
                                                @(rowNo += 1)
                                                @Html.HiddenFor(modelItem => item.SRNO)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.DIVISION)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.EXTRASEATCOUNT)
                                            </td>
                                            <td class="text-center">
                                                @if (item.STATUS == 1)
                                                {
                                                    <button class="btn btn-success btn-xs" style="cursor: text !important">Active</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-danger btn-xs" style="cursor: text !important">Deactive</button>
                                                }
                                            </td>

                                            <td class="text-center">
                                                @if (item.STATUS == 1)
                                                {
                                                    <button class="btn btn-default btn-xs glyphicon glyphicon-eye-close"
                                                            title="Click here to deactivate"
                                                            data-srno="@item.SRNO"
                                                            data-status="0"
                                                            data-action="deactivate" id="btnDeactivate" data-ctrl="ctrl-btnDeactivate"></button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-default btn-xs glyphicon glyphicon-eye-open"
                                                            title="Click here to activate"
                                                            data-srno="@item.SRNO"
                                                            data-status="1"
                                                            data-action="activate" id="btnActivate" data-ctrl="ctrl-btnActivate"></button>
                                                }
                                                <button class="btn btn-warning btn-xs glyphicon glyphicon-edit"
                                                        title="Click here to edit"
                                                        data-seatcount="@item.EXTRASEATCOUNT"
                                                        data-divisionid="@item.DIVISIONID"
                                                        data-srno="@item.SRNO" id="btnEdit" data-ctrl="ctrl-btnEdit"></button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-12 bg-info" style="border: 1px solid #61c0ed;border-radius: 0.25em;padding:8px;">
                    <span>
                        <a title="Back" href="/Home/Home">
                            <img src="~/assets/images/icon_back.gif" border="0" alt="">
                            Back
                        </a>
                    </span>
                </div>
            </div>
        </div>

    </div>

    <div id="ajaxLoader"></div>

@section Scripts{
    <script src="~/assets/js/jquery-ui.js"></script>


    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $("#tbSeatMst").dataTable({
                "bFilter": true,
                "bLengthChange": true
            });
            $("#txtEXTRASEATCOUNT").val('');

        });


        function SaveRecord(current) {
            var isFormVaildation = CheckFormValidation();
            if (isFormVaildation) {
                var data = {
                    SRNO: $("#hdnSrNo").val(),
                    DIVISIONID: $("#ddDivision").val(),
                    EXTRASEATCOUNT: $("#txtEXTRASEATCOUNT").val(),
                    STATUS: 1
                }
                $.ajax({
                    type: "POST",
                    url: "/SeatMgmt/ExtraSeatForDiv",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: JSON.stringify(data),
                    contentType: "application/json",
                    // contentType: "application/json; charset=utf-8",
                    // datatype: "json",
                    success: function (data) {
                        if (data == 1) {
                            swal({
                                title: "",
                                text: "Record saved successfully.",
                                type: "success",
                            },
                                 function (isConfirm) {
                                     if (isConfirm) {
                                         window.location.href = "/SeatMgmt/ExtraSeatForDivMasterList";
                                     }
                                 });
                        }
                        else if (data == 2) {
                            sweetAlert("", "Record already exist.", "warning");
                        }
                        else {
                            sweetAlert("", "Record not saved.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }
        function CheckFormValidation() {
            var isVailed = true;
            var errorMessages = [];
            debugger;

            $('#ddDivision').removeClass('validationError');
            if ($('#ddDivision').val() === "") {
                $('#ddDivision').addClass('validationError');
                errorMessages.push("Please select a Division.");
                isVailed = false;
            }


            $('#txtEXTRASEATCOUNT').removeClass('validationError');
            var seatCount = $('#txtEXTRASEATCOUNT').val();
            if (seatCount === "" || !/^(0|[1-9][0-9]{0,2})$/.test(seatCount)) {
                $('#txtEXTRASEATCOUNT').addClass('validationError');
                errorMessages.push("Please enter a valid seat count");
                isVailed = false;
            }

            if (!isVailed && errorMessages.length > 0) {
                sweetAlert("Validation Error", errorMessages.join("\n"), "error");
            }

            return isVailed;
        }



        function UpdateRecord(row_id, status, label) {
            swal({
                title: "Do you want to " + label + " the record ?",
                text: "",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                closeOnConfirm: false,
                closeOnCancel: true
            },
            function (isConfirm) {
                if (isConfirm) {
                    $.ajax({
                        type: "PUT",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        url: "/SeatMgmt/ExtraSeatForDiv",
                        // contentType: "application/json; charset=utf-8",
                        // datatype: "json",
                        data: { id: row_id, status: status },
                        success: function (data) {
                            if (data == 1) {
                                swal({
                                    title: "",
                                    text: "Record updated successfully.",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                        window.location.href = "/SeatMgmt/ExtraSeatForDivMasterList";
                                    }
                                });
                            }
                            else {
                                sweetAlert("", "Record not updated, Please try again.", "warning");
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }
            });
        }

        function EditRecord(crnt) {
            $("#txtEXTRASEATCOUNT").val($(crnt).attr('data-seatcount'));
            $("#ddDivision").val($(crnt).attr('data-divisionid'));
            $("#hdnSrNo").val($(crnt).attr('data-srno'));
            $("#btnSave").attr('value', 'Update');


        }
    </script>

    @* CSP 3.0 Compliant changes *@
    <script nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#btnSave').on('click', function () {
                SaveRecord(this);
            });

            $(document).off("click", "[data-ctrl='ctrl-btnActivate']");
            $(document).on('click', '[data-ctrl="ctrl-btnActivate"]', function () {
                const srno = $(this).data('srno');
                const status = $(this).data('status');
                const action = $(this).data('action');
                UpdateRecord(srno, status, action);
            });

            $(document).off("click", "[data-ctrl='ctrl-btnDeactivate']");
            $(document).on('click', '[data-ctrl="ctrl-btnDeactivate"]', function () {
                const srno = $(this).data('srno');
                const status = $(this).data('status');
                const action = $(this).data('action');
                UpdateRecord(srno, status, action);
            });

            $(document).off("click", "[data-ctrl='ctrl-btnEdit']");
            $(document).on('click', '[data-ctrl="ctrl-btnEdit"]', function () {
                EditRecord(this);
            });

            $('#btnReset').on('click', function () {
                location.href = '@Url.Action("ExtraSeatForDivMasterList", "SeatMgmt")';
            });
        });

    </script>
}
