@model ePortal.ViewModels.DivWiseCountReportViewModel

    @{
        ViewBag.Title = "Division Wise Count Report";
        Layout = "~/Views/Shared/_Layout.cshtml";

        //System.Text.StringBuilder tfootTr = new System.Text.StringBuilder();
        System.Text.StringBuilder theadTr2 = new System.Text.StringBuilder();
    }

    @section Styles{
    <style nonce="@Context.Items["StyleNonce_0"]">
        /*table Css*/
        .table > thead > tr > th {
            padding: 1px 2px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            padding: 1px;
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
            border: 1px solid #8ac2de;
        }

        .table-bordered {
            border: 1px solid #8ac2de;
        }

        .table > tbody > tr > td {
            padding: 1px 1px;
        }

        .table > tbody > tr:nth-of-type(even) {
            background: #f7f7d5;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .validationBackground {
            background-color: #a94442 !important;
            color: white;
        }

        .highlightBackground {
            background-color: #8bb55a !important;
            color: white;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .alert-error {
            background-color: antiquewhite;
            margin-left: 15px;
            margin-right: 15px;
        }

        .disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .required::after {
            content: "*";
            font-weight: 800;
            color: red;
            margin-left: 5px;
        }


        tr:hover {
            background-color: #e9e98b !important;
        }

        .scrollit {
            overflow: auto;
            height: 428px;
        }

        .dataTables_scrollBody {
            overflow-x: hidden !important;
        }
    </style>
    }
   
    <div id="ajaxLoader2"></div>       
 
        <div class="row">
            <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
                <div style="padding:8px;">Division Wise Count Report</div>
            </div>
            <div class="body-content" style="overflow-x:hidden">
                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-12 col-lg-12">
                            <table class="table table-bordered table-hover table-responsive" id="tbmyTable">
                                <thead>
                                    <tr>
                                        @{
                                            var dayCount = Model.CAL_HEADER_LIST.Count() + 3;
                                            <th colspan="@dayCount" class="bg-primary text-center" style="height:22px;">
                                                <a id="previousMonthLink" class="pull-left" style="margin-left: 5px;color: white;cursor: pointer;" title="Click to previous month"> &lt;&lt; Previous</a>
                                                <span>@Model.CAL_MONTH_YEAR</span>
                                                <a id="nextMonthLink" class="pull-right" style="margin-right: 5px;color: white;cursor: pointer;" title="Click to next month"> Next >></a>
                                            </th>
                                        }
                                    </tr>
                                    <tr>
                                        <th rowspan="2" style="background-color:#b3d3ef" class="text-center">Operation</th>
                                        <th rowspan="2" style="background-color:#b3d3ef" class="text-center">Division</th>
                                        @foreach (var item1 in Model.CAL_HEADER_LIST)
                                        {
                                            var _bgColor = item1.IS_OFFDAY ? item1.OFFDAY_COLOR : "#b3d3ef";
                                            <th class="text-center" style="width:2.7%; height:22px; background-color:@_bgColor;" title="@item1.CAL_DATE">@item1.CALID</th>

                                            var _bgColor2 = item1.IS_OFFDAY ? item1.OFFDAY_COLOR : "#e9e9e9";
                                            theadTr2.Append("<th class='text-center' style='width:2.7%;height:22px;font-size: smaller;background-color:" + _bgColor2 + ";'>" + item1.WEEK_DAY + "</th>");
                                        }
                                    </tr>

                                    <tr>
                                        @{
                                        var theadTr2Html = Html.Raw(theadTr2.ToString());
                                        }
                                        @theadTr2Html
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        foreach (var divObj in Model.DIV_LIST)
                                        {
                                            <tr>
                                                <th style="font-size:11px; vertical-align:middle; height:22px;" title="@divObj.OPERATION">
                                                    @divObj.OPERATION
                                                </th>
                                                <th style="font-size:11px; vertical-align:middle; height:22px;" title="@divObj.OPERATION">
                                                    @divObj.DIVISION
                                                </th>
                                                @foreach (var divCal in divObj.CAL_LIST)
                                                {
                                                    var tdBGColor = divCal.IS_OFFDAY ? divCal.OFFDAY_COLOR : "";
                                                    <td class="text-center" style="width:2.7%;background-color:@tdBGColor;">
                                                        @divCal.DATE_WISE_COUNT
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                                @*<tfoot>
                                    <tr>
                                        <th class='text-center' style='background-color:#b3d3ef'>Day Wise Count</th>
                                        @foreach (var item2 in Model.CAL_HEADER_LIST)
                                        {
                                            var _bgColor = item2.IS_OFFDAY ? item2.OFFDAY_COLOR : "#b3d3ef";
                                            <th class='text-center' style='width:3%;height:30px;background-color:@_bgColor;'><span class='footer-@item2.CALID'>@item2.DATE_WISE_COUNT</span></th>
                                        }
                                    </tr>
                                </tfoot>*@
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <form id="_form" action="@Url.Action("DivisionWiseCountReport","SeatMgmt")" method="post">
            <input type="hidden" id="hfParmValue" name="parmValue" value="0" />
            <input type="hidden" id="hfParmDate" name="parmDate" value="0" />
        </form>

        <form id="_formExcel" action="@Url.Action("DivisionWiseCountExcel","SeatMgmt")" method="post">
            <input type="hidden" id="hfParmDateExcel" name="parmDate" value="" />
        </form>
        <div id="ajaxLoader"></div>

        @section Scripts{
    <script nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        var arrayList = new Array, actionCount = 0;
        $(document).ready(function () {
            $("#ajaxLoader").removeClass('loader');

            $("#tbmyTable").dataTable({
                "searching": true,
                scrollY: '49vh',
                //scrollX: true,
                scrollCollapse: true,
                "paging": false,
                "ordering": false,
                "info": false,
            });

            /*$("#tbmyTable_wrapper").find('.row').eq(0).find('div').eq(0).html('<div class="headDiv"><button class="btn btn-primary" onclick="ExportToExcel(0);">Export to Excel</button></div>');*/

        });

        function PreNextClick(parmVal) {
            event.stopPropagation();
            if (parmVal != undefined) {
                $("#ajaxLoader").addClass('loader');
                $('#hfParmValue').val(parmVal);
                $('#hfParmDate').val('01-' + '@Model.CAL_MONTH_YEAR');
                $('#_form').submit();
            }
        }

        function ExportToExcel(parmVal) {
            event.stopPropagation();
            if (parmVal != undefined) {
                //$("#ajaxLoader").addClass('loader');
                $('#hfParmDateExcel').val('01-' + '@Model.CAL_MONTH_YEAR');
                $('#_formExcel').submit();
            }
        }
    </script>

    @* CSP 3.0 Compliant changes *@
    <script nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $("#tbmyTable_wrapper").find('.row').eq(0).find('div').eq(0).html('<div class="headDiv"><button id="exportButton" class="btn btn-primary">Export to Excel</button></div>');


            $('#exportButton').on('click', function () {
                ExportToExcel(0);
            });

            $('#previousMonthLink').on('click', function () {
                PreNextClick(-1);
            });

            $('#nextMonthLink').on('click', function () {
                PreNextClick(1);
            });
        });
    </script>
        }