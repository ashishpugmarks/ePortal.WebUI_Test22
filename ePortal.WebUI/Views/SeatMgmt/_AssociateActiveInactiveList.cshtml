@model IEnumerable<ePortal.ViewModels.EmpActiveInactiveforRosterViewModel>

@{
    Layout = null;
}

<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    @@media only screen and (max-width: 600px) {
        .col-xs-8 {
            width: 66.66% !important;
        }

        .col-xs-4 {
            width: 33.33% !important;
        }
    }

    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    select.input-sm {
        line-height: 10px !important;
    }

    .loader {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
        opacity: .7;
    }

    .ui-widget {
        font-family: Verdana,Arial,sans-serif;
        font-size: 0.6em !important;
        overflow: auto;
        max-height: 150px;
    }

    .validationError {
        border: 1px solid #a94442 !important;
    }
</style>
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $('.homeContent').removeClass('homeContent');
    $(document).ready(function () {
        $("#tblactiveinactive").dataTable({
            "bFilter": true,
            "bLengthChange": true
        });
    });

</script>
<table class="table table-bordered table-hover table-responsive" id="tblactiveinactive">
    <thead>
        <tr class="bg-info">
            <th class="text-center">Sr. No</th>
            <th class="text-center">Opration</th>
            <th class="text-center">Division</th>
            <th class="text-center">Department</th>
            <th class="text-center">Associate Code</th>
            <th class="text-center">Associate Name</th>
            @*<th class="text-center">Updated By</th>*@
            <th class="text-center">Updated Date</th>
            <th class="text-center">Status</th>
            <th class="text-center">Action</th>
        </tr>
    </thead>
    <tbody>
        @{
            int rowNo = 0;
        }
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td class="text-center" style="width:3%;">
                        @(rowNo += 1)
                    </td>
                    <td class="text-center" style="width:10%;">
                        @Html.DisplayFor(modelItem => item.OPERATION)
                    </td>
                    <td class="text-center" style="width:10%;">
                        @Html.DisplayFor(modelItem => item.DIVISION)
                    </td>
                    <td class="text-center" style="width:10%;">
                        @Html.DisplayFor(modelItem => item.DEPARTMENT)
                    </td>
                    <td class="text-center" style="width:10%;">
                        @Html.DisplayFor(modelItem => item.ADEMPCODE)
                    </td>
                    <td class="text-center" style="width:10%;">
                        @Html.DisplayFor(modelItem => item.EMPLOYEENAME)
                    </td>
                    @*<td class="text-center" style="width:10%;">
                        @Html.DisplayFor(modelItem => item.UPDATED_DATE)
                    </td>*@
                    <td class="text-center" style="width:10%;">
                        @if (!item.UPDATED_DATE.HasValue || item.UPDATED_DATE.Value == DateTime.MinValue)
                        {
                            @:
                        }
                        else
                        {
                            @item.UPDATED_DATE.Value.ToString("dd-MM-yyyy")
                        }
                    </td>
                    <td class="text-center" style="width:10%;">
                        @if (item.ACTIVITY_STATUS == 1)
                        {
                            <button class="btn btn-success btn-xs" style="cursor: text !important">Active</button>
                        }
                        else
                        {
                            <button class="btn btn-danger btn-xs" style="cursor: text !important">Inactive</button>
                        }
                    </td>
                    <td class="text-center" style="width:7%;">
                        @*<input type="checkbox" class="form-check SelectedIds" name="SelectedIds" value="@item.ADEMPCODE" />*@
                        <button class="btn btn-warning btn-xs btnaction" value="@item.ADEMPCODE">Active / Inactive</button>
                        <button class="btn btn-info btn-xs logView" tool-tip="VIew log" value="@item.ADEMPCODE"><i class="ace-icon fa fa-history"></i></button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>