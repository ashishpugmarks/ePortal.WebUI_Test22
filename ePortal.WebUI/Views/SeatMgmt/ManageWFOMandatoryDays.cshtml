@model IEnumerable<ePortal.ViewModels.SeatSettingViewModel>

@{
    ViewBag.Title = "Manage WFO Mandatory Days";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        @@media only screen and (max-width: 600px) {
            .col-xs-8 {
                width: 66.66% !important;
            }

            .col-xs-4 {
                width: 33.33% !important;
            }
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .ui-widget {
            font-family: Verdana,Arial,sans-serif;
            font-size: 0.6em !important;
            overflow: auto;
            max-height: 150px;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }
    </style>
}

    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                Mandatory WFO Days
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>List of Seat </strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <div class="form-group">
                        @Html.Label("Description", "Description", new { @class = "control-label text-right col-xs-4 col-sm-2 col-md-1 col-lg-1", @style = "margin-top: 7px;padding-bottom: 5px;" })
                            <div class="col-xs-8 col-sm-3 col-md-2 col-lg-3" style="padding-bottom: 5px;">
                                <input type="text" id="WFO_Description" class="form-control" readonly />
                            </div>

                        @Html.Label("Mandatory Days", "Mandatory Days", new { @class = "control-label text-right col-xs-4 col-sm-1 col-md-1", @style = "margin-top: 7px;padding-bottom: 5px;" })
                            <div class="col-xs-8 col-sm-1 col-md-2 col-lg-1" style="padding-bottom: 5px;">
                                <input type="number" id="WFO_Mandatory" class="form-control" />
                            </div>
                            <input type="hidden" id="pname" />
                            <div class="col-xs-8 col-sm-2 col-md-2 col-lg-2" style="padding-bottom: 5px;">
                                <input type="button" id="btnSave" class="btn btn-primary" value="Save" />
                                <input type="button" id="btnReset" value="Reset" class="btn btn-default" />
                            </div>
                        </div>

                        <table class="table table-bordered table-responsive" id="tbWFODays">
                            <thead>
                                <tr class="bg-info">
                                    <th class="text-center" style="width:5%;">Sr. No</th>
                                    <th class="text-center hidden-xs" style="width:15%;">Description</th>
                                    <th class="text-center" style="width:15%;">Mandatory Days</th>
                                    <th class="text-center" style="width:15%; display:none;">param name</th>
                                    <th class="text-center" style="width:10%;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNo = 0;
                                }
                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr style="height:35px;">
                                            <td class="text-center hidden-xs">
                                                @(rowNo += 1)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.DESCRIPTION)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.PARM_VALUE)
                                            </td>
                                            <td class="text-center" style="display:none;">
                                                @Html.DisplayFor(modelItem => item.PARM_NAME)
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-success btn-xs update_val" style="height: 25px;width: 25px;"><i class="ace-icon fa fa-edit" style="font-size: 18px; margin-left: -1px;"></i></button>
                                                <button class="btn btn-info btn-xs logView" tool-tip="VIew log" value="@item.PARM_NAME"><i class="ace-icon fa fa-history" style="font-size: 18px; margin-left: -1px;"></i></button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-12 bg-info" style="border: 1px solid #61c0ed;border-radius: 0.25em;padding:8px;">
                    <span>
                        <a title="Back" href="/Home/Home">
                            <img src="~/images/icon_back.gif" border="0" alt="">
                            Back
                        </a>
                    </span>
                </div>
            </div>
        </div>

    </div>

    <div id="ajaxLoader"></div>

@section Scripts{
    <script src="~/js/jquery-ui.js"></script>


    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $("#tbWFODays").dataTable({
                //"bLengthChange": true,
                "bSort": false,          // Disable column sorting
                "bFilter": false,        // Disable search box
                "bPaginate": false,      // Disable pagination
                "bLengthChange": false   // Hide "Show entries" dropdown
            });
            $("#txtEXTRASEATCOUNT").val('');

        });



    </script>

    <script nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#tbWFODays').on('click', '.logView', function () {
                var $row = $(this).closest('tr');
                var Description = $row.find('td:eq(1)').text().trim();

                View(this, this.value, Description);
            });
            function View(crnt, Statement, Desc) {
                $.fancybox.open({
                    href: '/SeatMgmt/ManageWFOMandatoryDaysHistory?Statement=' + Statement + '&Description=' + Desc,
                    type: 'iframe',
                    autoSize: true,
                    fitToView: true,
                    maxWidth: '100%',
                    maxHeight: '97%',
                    width: '95%',
                    height: '95%',
                    padding: 5,
                    closeClick: true,
                    openEffect: 'elastic',
                    openSpeed: 120,
                    closeEffect: 'elastic',
                    closeSpeed: 100,
                    afterClose: function () {
                        window.location.reload();
                    },
                    helpers: {
                        overlay: { closeClick: false }
                    }
                });
            }
            $('#tbWFODays').on('click', '.update_val', function () {
                var $row = $(this).closest('tr');

                var Description = $row.find('td:eq(1)').text().trim();
                var Days = $row.find('td:eq(2)').text().trim();
                var Pname = $row.find('td:eq(3)').text().trim();

                $('#WFO_Description').val(Description);
                $('#WFO_Mandatory').val(Days);
                $('#pname').val(Pname);
            });

            $('#btnSave').click(function () {
                var value = $('#WFO_Mandatory').val().trim();

                if (value === "") {
                    alert("Value cannot be empty.");
                    return;
                }
                var Days = $('#WFO_Mandatory').val().trim();
                var Pname = $('#pname').val().trim();
                console.log(Days, Pname);
                // Proceed to save
                $.ajax({
                    url: '@Url.Action("UpdateWFODays", "SeatMgmt")',
                    type: 'POST',
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: {
                        pname: Pname,
                        days: Days
                    },
                    success: function (response) {
                        if (response.success) {
                            swal({
                                title: "",
                                text: "Record saved successfully.",
                                type: "success"
                            }, function () {
                                window.location.href = '@Url.Action("ManageWFOMandatoryDays", "SeatMgmt")';
                            });
                        } else {
                            swal({
                                title: "Error",
                                text: response.message || "Something went wrong.",
                                type: "error"
                            });
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        swal({
                            title: "Server Error",
                            text: "An unexpected error occurred while saving.",
                            type: "error"
                        });
                    }
                });


            });

            // Reset fields
            $('#btnReset').click(function () {
                $('#WFO_Description').val('');
                $('#WFO_Mandatory').val('');
                $('#pname').val();
            });
        });
    </script>

}