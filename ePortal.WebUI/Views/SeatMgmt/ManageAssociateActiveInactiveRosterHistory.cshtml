@model List<ePortal.ViewModels.EmpActiveInactiveforRosterLogViewModel>
@{
    ViewBag.Title = "View Log";
    Layout = null;
}

<link href="~/Content/bootstrap.min.css" rel="stylesheet" />

<div class="panel panel-primary" style="margin:10px;">
    <div class="panel-heading">
        <h3 class="panel-title">Manage Associate Active-Inactive Roster History</h3>
    </div>
    <div class="panel-body">
        <table class="table table-bordered table-striped">
            <thead style="background-color:#80a9ea; color:#fff;">
                <tr>
                    <th class="text-center">Id</th>
                    <th class="text-center">Employee Name</th>
                    <th class="text-center">Employee Code</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Updated By</th>
                    <th class="text-center">Updated On</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int i = 0;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@(++i)</td>
                            <td class="text-center">@item.ADEMPCODE</td>
                            <td class="text-center">@item.EMPLOYEENAME</td>
                            <td class="text-center">
                                @(item.ACTIVITY_STATUS == 0 ? "Inactive" : "Active")
                            </td>
                            <td class="text-center">@item.EMPLOYEENAME_Updated_by</td>
                            <td class="text-center">@item.UPDATED_DATE.Value.ToString("dd-MM-yyyy HH:mm:ss")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No record found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<script src="~/js/jquery.2.1.3.min.js"></script>
