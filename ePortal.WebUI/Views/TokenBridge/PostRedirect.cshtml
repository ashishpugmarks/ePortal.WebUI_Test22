@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // Optional: remove if you want no header/footer
    ViewBag.Title = "Redirecting...";
}

@section Styles {
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6f9;
            color: #333;
            margin: 0;
            padding: 0;
            text-align: center;
        }

        .redirect-container {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 80vh;
            padding: 20px;
        }

            .redirect-container h2 {
                font-size: 28px;
                color: #2c3e50;
                margin-bottom: 10px;
            }

            .redirect-container p {
                font-size: 16px;
                color: #555;
                margin-bottom: 30px;
            }

        .spinner {
            border: 8px solid #e0e0e0;
            border-top: 8px solid #3498db;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            animation: spin 1s linear infinite;
            margin-bottom: 20px;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .redirect-note {
            font-size: 13px;
            color: #888;
        }
    </style>
}

<div class="redirect-container">
    <div class="spinner"></div>
    <h2>Please wait...</h2>
    <p>We are securely redirecting you to the requested module.</p>
    <div class="redirect-note">This may take a few seconds. Please do not refresh or click back.</div>

    <form id="redirectForm" method="post" action="@ViewBag.OldAppUrl">
        <input type="hidden" name="token" value="@ViewBag.Token" />
        <input type="hidden" name="target" value="@ViewBag.Target" />
    </form>
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            document.getElementById('redirectForm').submit();
        }, 200); // Slight delay for visual smoothness

        // window.onload = function () {
        //     document.getElementById('redirectForm').submit();

        //     // Optional: clear session after redirection starts
        //     fetch('/TokenBridge/ClearSessionAfterRedirect', {
        //         method: 'POST'
        //     });
        // };
    </script>
}


