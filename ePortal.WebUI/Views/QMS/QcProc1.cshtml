@model ePortal.ViewModels.APPX.QMS.QcProc1ViewModel
@{
    ViewBag.Title = "Employee Portal - Contract Management :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/newasset.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/css/qms/qcproc1.css" rel="stylesheet" asp-append-version="true" />
}

<div class="row">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Quality Management System - Standards &amp; Procedures</span>
    </div>

    <div class="body-content" style="overflow-x:hidden; padding: 0px !important;">

        <div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">

            <input type="hidden" asp-for="QCPROCSESSION" />

            <table class="table table-bordered table-condensed table-striped" style="width: 100%;">
                <tr class="HeaderStyle12">
                    <td style="width: 10%; text-align: center;">
                        &nbsp;<b>S. No.</b>
                    </td>
                    <td style="width: 68%; text-align: left;">
                        &nbsp;<b>Description</b>
                    </td>

                    <td style="text-align: center;">
                        &nbsp;<b>Remarks</b>
                    </td>
                </tr>
                <tr>
                    <td colspan="3" align="center" valign="top">
                        <div style="height: 230px; width: 100%; overflow: scroll;">
                            <table width="100%" class="tborder">
                                @Html.Raw(Model.strhtml)
                            </table>
                        </div>
                    </td>
                </tr>
                <tr class="row2">
                    <td colspan="3" style="font-weight:bold;">
                        <b>&nbsp;Departmental Procedures</b>
                    </td>
                </tr>

                <tr class="row2">
                    <td colspan="3">
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Plant :&nbsp;

                        @Html.DropDownListFor(
                                 model => model.ddlPlant,
                                 Model.ddlPlantList,
                                 new { @class = "swiftselect", style = "width:130px;" }
                                 )
                        &nbsp;&nbsp;&nbsp;Department :&nbsp
                        @Html.DropDownListFor(
                                 model => model.ddlDept,
                                 Model.ddlDeptList,
                                 new { @class = "swiftselect", style = "width:300px;" }
                                 )
              
                    </td>
                </tr>
                <tr class="row1">
                    <td colspan="3" style="padding: 4px;">
                        <div>
                            <table class="border" cellspacing="1" cellpadding="4" border="0" id="grdDeptProc" style="color:#333333;width:100%;">
                                <thead>
                                    <tr class="" style="height:20px;">
                                        <th scope="col">S.No</th>
                                        <th scope="col">&nbsp;Department</th>
                                        <th scope="col">&nbsp;Plant Name</th>
                                        <th scope="col">Procedure</th>
                                    </tr>
                                </thead>
                                <tbody>

                                 
                                    
                                </tbody>
                            </table>
                        </div>
                    </td>
                </tr>
            </table>
        </div>


        @* ---Back Button Start---- *@
        <div class="clear"></div>
        <div class="backrowdiv"><a asp-controller="Home" asp-action="Home" title="Go to Home">Back</a></div>

        <div class="clear"></div>
        @* ----Back Button End---- *@
    </div>
</div>

   

@section Scripts {
    <script src="~/app/js/qms/qcproc1.js" asp-append-version="true"></script>
}
