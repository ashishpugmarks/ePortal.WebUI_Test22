@using System.Net
@using ePortal.Shared

@model IEnumerable<ePortal.ViewModels.APPX.QMS.QmsdetailViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/newasset.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/css/qms/qmsdetail.css" rel="stylesheet" asp-append-version="true" />
}

<div class="row">
  
    <div class="body-content" style="overflow-x:hidden; padding: 0px !important;">

        <table cellspacing="0" cellpadding="1" width="100%" border="0">
            <tbody>
                <tr>
                    <td width="100%" colspan="8" height="3">
                        <img height="2" src="~/images/space.gif" alt='' width="1" />
                    </td>
                </tr>
                <tr>
                    <td>
                        <fieldset class="swiftfieldset" style="margin-left: 9px; margin-right: 6px;">
                            <legend class="nfont">Quality Control - FileUpload Detail </legend>
                            <table cellspacing="1" cellpadding="5" width="100%" border="0" style="text-align: left;
                            line-height: 23px;">
                                <tbody>
                                    <tr>
                                        <td style="line-height: 28px;">
                                            <strong>HMSI Quality Management System - Uploaded File Link</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" align="center" valign="top" class="contenttableborder" style="width: 100%">
                                            <div style="margin-top: 0px; vertical-align: top; line-height: 22px; margin-left: 0px;
                                            background-color: White; margin-right: 0px;">


                                                <table class="border" id="grdqmsdetail" cellspacing="1" cellpadding="4" border="0" style="color:#333333;width:98%;">
                                                    <thead>
                                                        <tr class="tcat" style="height:20px;">
                                                            <th align="left" valign="middle" scope="col" style="width: 150px;">&#160;  File Name</th>
                                                            <th align="left" valign="middle" scope="col" style="width: 150px;">&#160;Applicable Date</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                      
                                                        @foreach (var item in Model)
                                                        {
                                                            if (Model.Any())
                                                            {

                                                                <tr class="row1">
                                                                    <td>
                                                                        <a data-navigateurl="@item.FILENAME" class="filename">
                                                                            @* <a data-navigateurl="@WebUtility.UrlEncode(Encryption.Encrypt(Convert.ToString(item.FILENAME ?? string.Empty)))" class="filename"> *@
                                                                            @item.FILENAME
                                                                        </a>
                                                                    </td>

                                                                    <td class="smalltext">
                                                                        @item.APPLICABLEDATE
                                                                    </td>

                                                                </tr>

                                                            }

                                                            

                                                        }

                                                    </tbody>
                                                </table>

                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </fieldset>
                    </td>
                </tr>
                
            </tbody>
        </table>


        


        @* ---Back Button Start---- *@
        <div class="clear"></div>
        <div class="backrowdiv"><a asp-controller="Home" asp-action="Home" title="Go to Home">Back</a></div>

        <div class="clear"></div>
        @* ----Back Button End---- *@
    </div>
</div>

   

@section Scripts {
        <script src="~/app/js/qms/qmsdetail.js" asp-append-version="true"></script>
}
