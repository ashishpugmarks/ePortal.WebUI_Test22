@model ePortal.ViewModels.APPX.QMS.ISODocEditViewModel
@{
    ViewBag.Title = "Employee Portal - Contract Management :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/newasset.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/css/qms/isodocedit.css" rel="stylesheet" asp-append-version="true" />
}

<div class="row">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Edit/Modify QMS Document Change Request Form</span>
    </div>

    <div class="body-content" style="overflow-x:hidden; padding: 0px !important;">

        <div id="errorpanel" class="roundedPanel" style="background-color:#ED243B;width:100%; display: none;">
            <div style="padding-left: 6px;">
                <div id="pnlError" class="roundedPanel" style="background-color:#FFEAEA;width:99%;">
                    <table cellpadding="0" cellspacing="0" border="0" width="100%">
                        <tbody>
                            <tr id="tr_ErrorRow">
                                <td style="padding: 2px; padding-left: 5px; color: Black;">
                                    <span id="status" style="font-size: 13px; font-family: Trebuchet MS"></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
            <table style="width: 100%;">
                <tbody>
                    <tr>
                        <td>
                            <asp:Panel ID="errorpanel" runat="server" Width="100%">
                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                    <tr id="tr_ErrorRow" runat="server">
                                        <td style="padding-top: 5px; padding-bottom: 2px; padding-left: 2px; padding-right: 2px;">
                                            <asp:Panel BackColor="#ED243B" ID="pnlErrorHeader" runat="server" Width="100%" CssClass="roundedPanel">
                                                <div style="padding-left: 6px;">
                                                    <asp:Panel BackColor="#ffeaea" ID="pnlError" runat="server" Width="99%" CssClass="roundedPanel">
                                                        <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                                            <tr>
                                                                <td style="padding: 2px; padding-left: 5px; color: Black;">
                                                                    <asp:Label ID="status" Font-Size="13px" runat="server" Font-Names="Trebuchet MS"></asp:Label>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </asp:Panel>
                                                </div>
                                            </asp:Panel>
                                        </td>
                                    </tr>
                                </table>
                            </asp:Panel>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <table style="width: 100%;">
                                <tbody>
                                    <tr>
                                        <td style="padding: 5px;">
                                            <table class="table table-bordered table-condensed table-striped" style="width: 100%;">
                                                <tr>
                                                    <td style="text-align: right; padding: 2px;" class="smalltext">
                                                        &nbsp; &nbsp; Plant: &nbsp;&nbsp;
                                                    </td>
                                                    <td align="left" style="height: 24px; padding: 2px;">
                                                        &nbsp;

                                                        @Html.DropDownListFor(
                                                                 model => model.ddlPlant,
                                                                 Model.ddlPlantList,
                                                                 new { style = "width:155px;" }
                                                                 )
                                                    </td>
                                                    <td style="text-align: right; padding: 2px;" class="smalltext">
                                                        &nbsp; &nbsp; Department: <span style="color: #ff0000">*</span>
                                                    </td>
                                                    <td align="left" style="height: 24px; padding: 2px;">
                                                        &nbsp;

                                                        @Html.DropDownListFor(
                                                                 model => model.ddlDept,
                                                                 Model.ddlDeptList,
                                                                 new { style = "width:211px;" }
                                                                 )
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align: right; padding: 2px;" class="smalltext">
                                                        Change Type: <span style="color: #ff0000">*</span>
                                                    </td>
                                                    <td align="left" style="height: 24px; padding: 2px;">

                                                        <div>
                                                            <input asp-for="changeType_rdomaster" id="rbtnAdd" type="radio" value="Addition" /> Addition
                                                            <input asp-for="changeType_rdomaster" id="rbtnRev" type="radio" value="Revision" /> Revision
                                                            <input asp-for="changeType_rdomaster" id="rbtnDel" type="radio" value="Deletion" /> Deletion

                                                        </div>

                                                        @*  <asp:RadioButton ID="rbtnAdd" GroupName="group1" Text="Addition" runat="server" AutoPostBack="true"
                                                                         Checked="true" OnCheckedChanged="rbtnAdd_CheckedChanged"></asp:RadioButton>
                                                        <asp:RadioButton ID="rbtnRev" GroupName="group1" Text="Revision" AutoPostBack="true"
                                                                         runat="server" OnCheckedChanged="rbtnRev_CheckedChanged"></asp:RadioButton>
                                                        <asp:RadioButton ID="rbtnDel" GroupName="group1" Text="Deletion" AutoPostBack="true"
                                                                         runat="server" OnCheckedChanged="rbtnDel_CheckedChanged"></asp:RadioButton> *@


                                                    </td>
                                                    <td style="text-align: right; padding: 2px;" class="smalltext">
                                                        &nbsp; &nbsp;  &nbsp;&nbsp;
                                                    </td>
                                                    <td align="left" style="height: 24px; padding: 2px;">
                                                        &nbsp;

                                                        @Html.DropDownListFor(
                                                                 model => model.ddlSection,
                                                                 Model.ddlSectionList,
                                                                 new { style = "width:211px; display: none;" }
                                                                 )

                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align: right; padding: 2px;" class="smalltext">
                                                        &nbsp; &nbsp; Document No: <span style="color: #ff0000">*</span>
                                                    </td>
                                                    <td align="left" style="height: 24px; padding: 2px;">
                                                        &nbsp;

                                                        @Html.DropDownListFor(
                                                                 model => model.ddlformatnumber,
                                                                 Model.ddlformatnumberList
                                                                 )
                                                        <input type="text" asp-for="txtDocNo9" class="swifttext alphanumeric" style="text-transform: uppercase; text-align: center; border-width: thin; width: 40px;" MaxLength="4" />
                                                        <strong>-</strong>
                                                        <input type="text" asp-for="txtDocNo" class="swifttext letters" style="text-transform: uppercase; text-align: center; border-width: thin; width: 18px;" MaxLength="1" />
                                                        <strong>-</strong>
                                                        <input type="text" asp-for="txtDocNo1" class="swifttext numeric" style="text-transform: uppercase; text-align: center; border-width: thin; width: 25px;" MaxLength="2" />
                                                        <strong>-</strong>
                                                        <input type="text" asp-for="txtDocNo2" class="swifttext numeric" style="text-transform: uppercase; text-align: center; border-width: thin; width: 40px;" MaxLength="4" />


                                                        @*  
                                                        <asp:DropDownList runat="server" ID="ddlformatnumber" AutoPostBack="true" OnSelectedIndexChanged="ddlformatnumber_TextChanged"></asp:DropDownList>
                                                        <asp:TextBox ID="txtDocNo9" CssClass="swifttext" runat="server" Style='text-transform: uppercase; text-align: center; border-width: thin;'
                                                                     Width="47px" MaxLength="4" AutoPostBack="true"
                                                                     OnTextChanged="txtDocNo9_TextChanged"></asp:TextBox><strong>-</strong>
                                                        <ajaxToolkit:FilteredTextBoxExtender runat="server" ID="FilteredTextBoxExtender5"
                                                                                             TargetControlID="txtDocNo9" FilterType="LowercaseLetters,UppercaseLetters,Numbers">
                                                        </ajaxToolkit:FilteredTextBoxExtender>
                                                        &nbsp;<asp:TextBox ID="txtDocNo" CssClass="swifttext" runat="server" Style='text-transform: uppercase; text-align: center; border-width: thin;'
                                                                           Width="18px" MaxLength="1" AutoPostBack="true"
                                                                           OnTextChanged="txtDocNo_TextChanged"></asp:TextBox><strong>-</strong>
                                                        <ajaxToolkit:FilteredTextBoxExtender runat="server" ID="FilteredTextBoxExtender13"
                                                                                             TargetControlID="txtDocNo" FilterType="LowercaseLetters,UppercaseLetters">
                                                        </ajaxToolkit:FilteredTextBoxExtender>
                                                        <asp:TextBox ID="txtDocNo1" CssClass="swifttext" runat="server" Style='text-transform: uppercase; text-align: center; border-width: thin;'
                                                                     Width="25px" MaxLength="2" AutoPostBack="true"
                                                                     OnTextChanged="txtDocNo1_TextChanged"></asp:TextBox><strong>-</strong>
                                                        <ajaxToolkit:FilteredTextBoxExtender runat="server" ID="FilteredTextBoxExtender14"
                                                                                             TargetControlID="txtDocNo1" FilterType="Numbers">
                                                        </ajaxToolkit:FilteredTextBoxExtender>
                                                        <asp:TextBox ID="txtDocNo2" CssClass="swifttext" runat="server" Style='text-transform: uppercase; text-align: center; border-width: thin;'
                                                                     Width="40px" MaxLength="4" AutoPostBack="true"
                                                                     OnTextChanged="txtDocNo2_TextChanged"></asp:TextBox>
                                                        <ajaxToolkit:FilteredTextBoxExtender runat="server" ID="FilteredTextBoxExtender41"
                                                                                             TargetControlID="txtDocNo2" FilterType="Numbers">
                                                        </ajaxToolkit:FilteredTextBoxExtender>
                                                       *@



                                                    <td style="text-align: right; padding: 2px;" class="smalltext">
                                                        &nbsp; &nbsp; Document Title: <span style="color: #ff0000">*</span>
                                                    </td>
                                                    <td align="left" style="height: 24px; padding: 2px;">
                                                        &nbsp;

                                                        <input type="text" asp-for="txtDocTitle" class="swifttext" title="Document Title is non editable in Case of Revision & Deletion" Width="155px" />
                                                        <input type="hidden" id="hdnDocTitle" asp-for="txtDocTitle" />

                                                    </td>
                                                </tr>

                                                <tr id="pnlAdditon">
                                                    <td style="text-align: right; padding: 2px;" class="smalltext">
                                                        &nbsp; &nbsp; Revision No: <span style="color: #ff0000">*</span>
                                                    </td>
                                                    <td align="left" style="height: 24px; padding: 2px;">
                                                        &nbsp;
                                                        <input type="text" asp-for="txtRevNoA" class="swifttext numeric" Width="155px" disabled />

                                                    </td>
                                                    <td style="text-align: right; padding: 2px;" class="smalltext">
                                                        &nbsp; &nbsp; Implementation Date: <span style="color: #ff0000">*</span>
                                                    </td>
                                                    <td align="left" style="height: 24px; padding: 2px;">
                                                        &nbsp;

                                                        @Html.DropDownListFor(
                                                                 model => model.ddlDayA,
                                                                 Model.ddlDayAList,
                                                                 new { @class = "swiftselect cclick", @style = "font-size: 8pt; width: 40px" }
                                                                 )

                                                        @Html.DropDownListFor(
                                                                 model => model.ddlMonthA,
                                                                 Model.ddlMonthAList,
                                                                 new { @class = "swiftselect cclick", @style = "font-size: 8pt; width: 60px" }
                                                                 )

                                                        @Html.DropDownListFor(
                                                                 model => model.ddlYearA,
                                                                 Model.ddlYearAList,
                                                                 new { @class = "swiftselect cclick", @style = "font-size: 8pt; width: 60px" }
                                                                 )

                                                    </td>
                                                </tr>
                                                <tbody id="pnlRevison" style="display: none;">
                                                    <tr>
                                                        <td style="text-align: right; padding: 2px;" class="smalltext">
                                                            &nbsp; &nbsp; Curr Revision No: <span style="color: #ff0000">*</span>
                                                        </td>
                                                        <td align="left" style="height: 24px; padding: 2px;">
                                                            &nbsp;
                                                            <input type="text" asp-for="txtCurrRevNoR" class="swifttext" Width="155px" readonly="true" title="You can not add in Current Revision no." />
                                                            <input type="hidden" asp-for="txtCurrRevNoR" id="hdnCurrRevNoR" />

                                                        </td>
                                                        <td style="text-align: right; padding: 2px;" class="smalltext">
                                                            &nbsp; &nbsp; New Revision No: <span style="color: #ff0000">*</span>
                                                        </td>
                                                        <td align="left" style="height: 24px; padding: 2px;">
                                                            &nbsp;

                                                            <input type="text" asp-for="txtNewRevNoR" class="swifttext" Width="155px" readonly="true" title="You can not add in New Revision no." />
                                                            <input type="hidden" asp-for="txtNewRevNoR" id="hdnNewRevNoR" />

                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="text-align: right; padding: 2px;" class="smalltext">
                                                            Establishment Date: <span style="color: #ff0000">*</span>
                                                        </td>
                                                        <td align="left" style="height: 24px; padding: 2px;">
                                                            &nbsp;

                                                            @Html.DropDownListFor(
                                                                     model => model.ddlRevDayR,
                                                                     Model.ddlRevDayRList,
                                                                     new { @class = "swiftselect cclickRI", @style = "width: 40px" }
                                                                     )

                                                            @Html.DropDownListFor(
                                                                     model => model.ddlRevMonthR,
                                                                     Model.ddlRevMonthRList,
                                                                     new { @class = "swiftselect cclickRI", @style = "width: 60px" }
                                                                     )

                                                            @Html.DropDownListFor(
                                                                     model => model.ddlRevYearR,
                                                                     Model.ddlRevYearRList,
                                                                     new { @class = "swiftselect cclickRI", @style = "width: 60px" }
                                                                     )
                                                        </td>
                                                        <td style="text-align: right; padding: 2px;" class="smalltext">
                                                            Implementation Date: <span style="color: #ff0000">*</span>
                                                        </td>
                                                        <td align="left" style="height: 24px; padding: 2px;">
                                                            &nbsp;

                                                            @Html.DropDownListFor(
                                                                     model => model.ddlImpDayR,
                                                                     Model.ddlImpDayRList,
                                                                     new { @class = "swiftselect cclickR", @style = "font-size: 8pt; width: 40px;" }
                                                                     )

                                                            @Html.DropDownListFor(
                                                                     model => model.ddlImpMonthR,
                                                                     Model.ddlImpMonthRList,
                                                                     new { @class = "swiftselect cclickR", @style = "font-size: 8pt; width: 60px;" }
                                                                     )

                                                            @Html.DropDownListFor(
                                                                     model => model.ddlImpYearR,
                                                                     Model.ddlImpYearRList,
                                                                     new { @class = "swiftselect cclickR", @style = "font-size: 8pt; width: 40px;" }
                                                                     )

                                                        </td>
                                                    </tr>
                                                </tbody>
                                                <tr id="pnlDeletion" style="display: none;">
                                                    <td style="text-align: right; padding: 2px;" class="smalltext">
                                                        &nbsp; &nbsp; Curr Revision No: <span style="color: #ff0000">*</span>
                                                    </td>
                                                    <td align="left" style="height: 24px; padding: 2px;">
                                                        &nbsp;
                                                        <input type="text" asp-for="txtCurrRevD" class="swifttext" width="155px" title="You can not add in Current Revision no." readonly="true" />
                                                    </td>
                                                    <td style="text-align: right; padding: 2px;" class="smalltext">
                                                        &nbsp; Implementation Date: <span style="color: #ff0000">*</span>
                                                    </td>
                                                    <td align="left" style="height: 24px; padding: 2px;">
                                                        &nbsp;

                                                        @Html.DropDownListFor(
                                                                 model => model.ddlDayD,
                                                                 Model.ddlDayDList,
                                                                 new { @class = "swiftselect cclickD", @style = "font-size: 8pt; width: 40px;" }
                                                                 )

                                                        @Html.DropDownListFor(
                                                                 model => model.ddlMonthD,
                                                                 Model.ddlMonthDList,
                                                                 new { @class = "swiftselect cclickD", @style = "font-size: 8pt; width: 60px;" }
                                                                 )

                                                        @Html.DropDownListFor(
                                                                 model => model.ddlYearD,
                                                                 Model.ddlYearDList,
                                                                 new { @class = "swiftselect cclickD", @style = "font-size: 8pt; width: 60px;" }
                                                                 )
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td style="text-align: right; vertical-align: top; padding: 2px;" class="smalltext">
                                                        &nbsp;&nbsp; Reason: <span style="color: #ff0000">*</span>
                                                    </td>
                                                    <td align="left" colspan="3" style="padding: 0px;">
                                                        &nbsp;

                                                        @Html.TextAreaFor(
                                                                 model => model.txtReason,
                                                                 new
                                                                 {
                                                                     @class = "swifttext onpaste",
                                                                     style = "width: 554px; height: 60px;",
                                                                     maxlength = "250"
                                                                 }
                                                                 )

                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align: right; padding: 2px; vertical-align: middle;" class="smalltext">
                                                        &nbsp;&nbsp;Attachment: <span style="color: #ff0000">*</span>
                                                    </td>
                                                    <td align="left" colspan="3" style="padding: 2px;">

                                                        <input type="hidden" asp-for="hdnFile" />
                                                        &nbsp;
                                                        <input type="file" asp-for="txtFileUpload" style="width: 350px" />
                                                        <input type="hidden" id="FilenameExist" />
                                                        &nbsp;
                                                        @if (!string.IsNullOrWhiteSpace(Model.hdFilenameExist))
                                                        {
                                                            <a id="FileList" data-filename="@Model.hdFilenameExist">
                                                                <img src="~/images/menu_pdf.gif" />
                                                            </a>
                                                        }
                                                          
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align: right; padding: 2px; padding: 4px;" class="smalltext">
                                                        Approval Authority: <span style="color: #ff0000">*</span>
                                                    </td>
                                                    <td align="left" valign="bottom" colspan="3" style="padding: 4px;">
                                                        <span id="lblAppAuth">@Model.lblAppAuth</span>
                                                        <input type="hidden" asp-for="hdAPPECODE" />
                                                        <input type="hidden" asp-for="hdAPPEMAILID" />
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="buttonwrapper" align="center" style="margin-top: 3px; margin-bottom: 3px; height: 30px;">
                                            <input type="hidden" asp-for="hdIsoDocId" id="IsoDocId" />
                                            <input type="hidden" asp-for="OldIsoDocId" />


                                            <button class="yellowbuttonbig" id="btnSubmit">Submit</button>
                                            &nbsp;
                                            <button class="yellowbuttonbig" id="btnCancel">Cancel</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
       
        @* ---Back Button Start---- *@
        <div class="clear"></div>
        <div class="backrowdiv"><a asp-controller="Home" asp-action="Home" title="Go to Home">Back</a></div>

        <div class="clear"></div>
        @* ----Back Button End---- *@
    </div>
</div>

   

@section Scripts {
    <script src="~/js/calendarpopup.js" asp-append-version="true"></script>
    <script src="~/app/js/qms/isodocedit.js" asp-append-version="true"></script>
}
