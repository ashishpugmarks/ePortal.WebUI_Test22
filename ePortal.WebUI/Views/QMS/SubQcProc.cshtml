@model IEnumerable<ePortal.ViewModels.APPX.QMS.SubQcProcViewModel>
@{
    ViewBag.Title = "Employee Portal - Contract Management :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/newasset.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/css/qms/subqcproc.css" rel="stylesheet" asp-append-version="true" />
}

<div class="row">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Quality Management System - Standards &amp; Procedures</span>
    </div>

    <div class="body-content" style="overflow-x:hidden; padding: 0px !important;">

        <div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
            <table style="width: 100%;">
                <tr>
                    <td>
                        <div>
                            <table class="tborder" cellspacing="1" cellpadding="4" border="0" id="GridHmsiStandard" style="color:#333333;width:99%;">
                                <thead>
                                    <tr class="tcat" style="height:20px;">
                                        <th align="left" valign="middle" scope="col" style="width:10%;">S.No.</th>
                                        <th align="left" valign="middle" scope="col" style="width:40%;">Standard Name</th>
                                        <th align="center" valign="middle" scope="col" style="width:15%;">Standard No.</th>
                                        <th align="center" valign="middle" scope="col" style="width:15%;">Revision No.</th>
                                        <th align="center" valign="middle" scope="col" style="width:15%;">Revision Date</th>
                                    </tr>
                                </thead>

                                @if(Model.Any())
                                {
                                    <tbody>
                                        @{
                                            int idx = 1;  
                                        }
                                        @foreach(var item in Model)
                                        {
                                            <tr class="row1">
                                                <td align="left" valign="middle">
                                                    &nbsp; <span>@idx</span>
                                                </td>
                                                <td align="left" valign="middle">
                                                    @* vks *@
                                                    <a data-filename="@item.FILENAME" class="lnkShow">@item.DESCRIPTION</a>
                                                </td>
                                                <td align="center" valign="middle">
                                                    &nbsp;<span>@item.STANDARDNO</span>
                                                </td>
                                                <td align="center" valign="middle">
                                                    &nbsp;<span>@item.REVISIONNO</span>
                                                </td>
                                                <td align="center" valign="middle">
                                                    &nbsp;<span>@item.APPLICABLEDATE</span>
                                                </td>
                                            </tr>

                                            idx++;
                                        }
                                       
                                    </tbody>
                                }
                                else
                                {
                                    <tfoot>
                                        <tr>
                                            <td colspan="5">
                                                <div>No Record Found.</div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                }
                                
                            </table>
                        </div>
                    </td>
                </tr>
            </table>
        </div>


        


        @* ---Back Button Start---- *@
        <div class="clear"></div>
        <div class="backrowdiv"><a asp-controller="Home" asp-action="Home" title="Go to Home">Back</a></div>

        <div class="clear"></div>
        @* ----Back Button End---- *@
    </div>
</div>

   

@section Scripts {
    <script src="~/app/js/qms/subqcproc.js" asp-append-version="true"></script>
}
