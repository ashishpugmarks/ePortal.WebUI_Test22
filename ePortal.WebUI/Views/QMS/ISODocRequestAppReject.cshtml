@model ePortal.ViewModels.APPX.QMS.ISODocRequestAppRejectViewModel
@{
    ViewBag.Title = "Employee Portal - Contract Management :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/newasset.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/css/qms/isodocrequestappreject.css" rel="stylesheet" asp-append-version="true" />
}

<div class="row">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">
            <label id="lblHeader">@Model.lblHeader</label>
        </span>
    </div>

    <div class="body-content" style="overflow-x:hidden; padding: 0px !important;">

        <div id="errorpanel" class="roundedPanel" style="background-color:#ED243B;width:100%; display: none;">
            <div style="padding-left: 6px;">
                <div id="pnlError" class="roundedPanel" style="background-color:#FFEAEA;width:99%;">
                    <table cellpadding="0" cellspacing="0" border="0" width="100%">
                        <tbody>
                            <tr id="tr_ErrorRow">
                                <td style="padding: 2px; padding-left: 5px; color: Black;">
                                    <span id="status" style="font-size: 13px; font-family: Trebuchet MS"></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
            <table style="width: 100%;">
                <tbody>
                    <tr>
                        <td>
                           @*  <asp:Panel ID="errorpanel" runat="server" Width="100%">
                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                    <tr id="tr_ErrorRow" runat="server">
                                        <td style="padding-top: 5px; padding-bottom: 2px; padding-left: 2px; padding-right: 2px;">
                                            <asp:Panel BackColor="#ED243B" ID="pnlErrorHeader" runat="server" Width="100%" CssClass="roundedPanel">
                                                <div style="padding-left: 6px;">
                                                    <asp:Panel BackColor="#ffeaea" ID="pnlError" runat="server" Width="99%" CssClass="roundedPanel">
                                                        <table cellpadding="0" cellspacing="0" border="0" width="100%">
                                                            <tr>
                                                                <td style="padding: 2px; padding-left: 5px; color: Black;">
                                                                    <asp:Label ID="status" Font-Size="13px" runat="server" Font-Names="Trebuchet MS"></asp:Label>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </asp:Panel>
                                                </div>
                                            </asp:Panel>
                                        </td>
                                    </tr>
                                </table>
                            </asp:Panel> *@
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <table class="table table-bordered table-condensed" style="width: 100%;">
                                <tbody>
                                    <tr>
                                        <td style="padding: 5px;">
                                            <table class="table table-bordered table-condensed" style="width: 100%;">
                                                <tr>
                                                    <td colspan="4">
                                                        <table class="table table-bordered table-condensed table-striped" style="width: 100%; margin-bottom:2px;">
                                                            <tbody>
                                                                <tr>
                                                                    <td colspan="4" style="padding: 3px; height: 25px;" class="HeaderStyle123">
                                                                        QMS Document Change Requester Detail's
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="text-align: right;" class="smalltext">
                                                                        Requester Name :
                                                                    </td>
                                                                    <td align="left">
                                                                        <b>
                                                                            <span>@Model.lblEmpName</span>
                                                                        </b>
                                                                    </td>
                                                                    <td style="text-align: right;" class="smalltext">
                                                                        Emp Code :
                                                                    </td>
                                                                    <td align="left">
                                                                        <span id="lblEmpCode">@Model.lblEmpCode</span>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="text-align: right;" class="smalltext">
                                                                        Mobile No. :
                                                                    </td>
                                                                    <td align="left">
                                                                        <span>@Model.lblMobile</span>
                                                                    </td>
                                                                    <td style="text-align: right;" class="smalltext">
                                                                        Request Date :
                                                                    </td>
                                                                    <td align="left">
                                                                        <span>@Model.lblRequestDate</span>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td class="HeaderStyle123" style="padding: 3px; height: 25px;" colspan="4">
                                                        QMS Document Change Details
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align: right; padding: 2px; font-weight: bold;" class="smalltext">
                                                        Plant
                                                    </td>
                                                    <td align="left" style="height: 24px; width: 216px; padding: 2px;">
                                                        <span id="lblEmpName" style="width: 216px;">@Model.lblEmpName</span>
                                                        <input type="hidden" asp-for="hdnplant" />
                                                    </td>
                                                    <td style="text-align: right; width: 156px; padding: 2px; font-weight: bold;" class="smalltext">
                                                        Department
                                                    </td>
                                                    <td align="left" style="height: 24px; padding: 2px; width: 236px;">
                                                        <span style="width:236px;">@Model.lblDept</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align: right; padding: 2px; width: 166px; font-weight: bold;" class="smalltext">Change Type</td>
                                                    <td colspan="3" align="left" style="height: 24px; width: 226px; padding: 2px;">

                                                        <div>
                                                            <input asp-for="changeType_rdomaster" id="rbtnAdd" type="radio" value="Addition" disabled="disabled" /> Addition
                                                            <input asp-for="changeType_rdomaster" id="rbtnRev" type="radio" value="Revision" disabled="disabled" /> Revision
                                                            <input asp-for="changeType_rdomaster" id="rbtnDel" type="radio" value="Deletion" disabled="disabled" /> Deletion

                                                        </div>

                                                </tr>
                                                <tr>
                                                    <td style="text-align: right; padding: 2px; font-weight: bold; width: 176px; font-weight: bold;" class="smalltext">
                                                        Document No
                                                    </td>
                                                    <td align="left" style="height: 24px; width: 216px; padding: 2px;">
                                                        <span style="width:216px;" id="lblDocNo">@Model.lblDocNo</span>
                                                    </td>
                                                    <td style="text-align: right; width: 156px; padding: 2px; font-weight: bold;" class="smalltext">
                                                        Document Title
                                                    </td>
                                                    <td align="left" style="height: 24px; padding: 2px; width: 236px;">
                                                        <span id="lblDocTitle" style="width:216px;">@Model.lblDocTitle</span>
                                                    </td>
                                                </tr>
                                                @if (ViewBag.pnlAdditonVisible ?? true)
                                                {
                                                    <tr id="pnlAdditon">
                                                        <td style="text-align: right; padding: 2px; width: 176px; font-weight: bold;" class="smalltext">
                                                            Revision No
                                                        </td>
                                                        <td align="left" style="height: 24px; width: 216px; padding: 2px;">
                                                            <span style="width:216px;">@Model.lblRevisionNoA</span>
                                                        </td>
                                                        <td style="text-align: right; width: 176px; padding: 2px; font-weight: bold;" class="smalltext">
                                                            Implementation Date
                                                        </td>
                                                        <td align="left" style="height: 24px; width: 216px; padding: 2px;">
                                                            <span>@Model.lblImpDateA</span>
                                                        </td>
                                                    </tr>

                                                }
                                                

                                                @if (ViewBag.pnlRevisonVisible ?? false)
                                                {
                                                    <tbody id="pnlRevison">
                                                        <tr>
                                                            <td style="text-align: right; padding: 2px; width: 176px; font-weight: bold;" class="smalltext">
                                                                Curr Revision No
                                                            </td>
                                                            <td align="left" style="height: 24px; width: 216px; padding: 2px;">
                                                                <span style="width:216px;">@Model.lblCurrRevisonR</span>
                                                            </td>
                                                            <td style="text-align: right; width: 176px; padding: 2px; font-weight: bold;" class="smalltext">
                                                                New Revision No
                                                            </td>
                                                            <td align="left" style="height: 24px; padding: 2px; width: 216px;">
                                                                <span style="width:216px;">@Model.lblNewRevisonR</span>
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <td style="text-align: right; width: 176px; padding: 2px; font-weight: bold;" class="smalltext">
                                                                Establishment Date
                                                            </td>
                                                            <td align="left" style="height: 24px; padding: 2px; width: 216px;">
                                                                <span style="width:216px;">@Model.lblRevisonDateR</span>
                                                            </td>
                                                            <td style="text-align: right; padding: 2px; width: 176px; font-weight: bold;" class="smalltext">
                                                                Implementation Date
                                                            </td>
                                                            <td align="left" style="height: 24px; width: 216px; padding: 2px;">
                                                                <span style="width:216px;">@Model.lblImpDateR</span>
                                                            </td>

                                                        </tr>
                                                    </tbody>
                                                }
                                                @if (ViewBag.pnlDeletionVisible ?? false)
                                                {
                                                    <tr id="pnlDeletion">
                                                        <td style="text-align: right; padding: 2px; width: 176px; font-weight: bold;" class="smalltext">
                                                            Curr Revision No
                                                        </td>
                                                        <td align="left" style="height: 24px; width: 216px; padding: 2px;">
                                                            <span style="width:216px;">@Model.lblCurrRevisonD</span>

                                                        </td>
                                                        <td style="text-align: right; font-weight: bold; width: 176px; padding: 2px;" class="smalltext">
                                                            Implementation Date
                                                        </td>
                                                        <td align="left" style="height: 24px; width: 216px; padding: 2px;">
                                                            <span style="width: 216px;">@Model.lblImpDateD</span>
                                                        </td>
                                                    </tr>

                                                }

                                                
                                                <tr>
                                                    <td style="text-align: right; vertical-align: top; padding: 2px; font-weight: bold; width: 176px;" class="smalltext">
                                                        Reason
                                                    </td>
                                                    <td align="left" colspan="3" style="padding: 0px; width: 608px;">
                                                        <span>@Model.lblReason</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align: right; padding: 2px; width: 176px; font-weight: bold;" class="smalltext">
                                                        Attachment
                                                    </td>
                                                    <td align="left" colspan="3" style="padding: 2px; width: 295px;">

                                                        @if (ViewBag.FileListVisible ?? false)
                                                        {
                                                            <a id="FileList" data-docid="@Model.hdFilenameExist">
                                                                <img src="~/images/menu_pdf.gif" />
                                                            </a>
                                                        }
                                                    </td>
                                                </tr>
                                            </table>
                                            @if (ViewBag.pnlApprovalVisible ?? false)
                                            {
                                                <div id="pnlApproval">
                                                    <table class="table table-bordered table-condensed table-striped" style="width: 100%;">
                                                        <tr>
                                                            <td colspan="2" style="padding: 3px; height: 25px;" class="HeaderStyle123">
                                                                Approval Detail's
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="text-align: right; width: 141px; height: 27px;">
                                                                Approval Status
                                                            </td>
                                                            <td style="height: 27px">

                                                                <div>
                                                                    <input asp-for="rblApprovalStatus" type="radio" value="1" checked="true" /> Approve
                                                                    <input asp-for="rblApprovalStatus" type="radio" value="2" /> Reject
                                                                </div>

                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="width: 141px; vertical-align: top; text-align: right">
                                                                Remarks <span style="color: #ff0000">*</span>
                                                            </td>
                                                            <td style="padding-bottom: 8px;">
                                                                @Html.TextAreaFor(
                                                                         model => model.txtAPPRemarks,
                                                                         new
                                                                         {
                                                                             @class = "Swifttext",
                                                                             style = "width: 495px; height: 52px;"

                                                                         }
                                                                         )

                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>
                                            }
                                           
                                            
                                            @if (ViewBag.pnlCancelVisible ?? false)
                                            {
                                                <div id="pnlCancel">
                                                    <table class="table table-bordered table-condensed table-striped" style="width: 100%; margin-bottom:2px;">
                                                        <tr>
                                                            <td colspan="2" style="padding: 3px; height: 25px;" class="HeaderStyle123">
                                                                Cancellation Detail's
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td class="fieldname" style="width: 130px; vertical-align: top; padding-top: 8px; text-align: right">
                                                                Remarks <span style="color: #ff0000">*</span>
                                                            </td>
                                                            <td style="padding-top: 8px; padding-bottom: 8px;">
                                                                @Html.TextAreaFor(
                                                                            model => model.txtCancallation,
                                                                            new
                                                                            {
                                                                                @class = "Swifttext onpaste",
                                                                                style = "width: 495px; height: 52px;",
                                                                                maxlength = "250"
                                                                            }
                                                                            )
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>
                                            }
                                                
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="buttonwrapper" align="center" style="margin-top: 3px; margin-bottom: 3px; height: 30px;">

                                            <input type="hidden" asp-for="RequestIDC" />
                                            <input type="hidden" asp-for="RequestIDA" />
                                            <input type="hidden" asp-for="EMPEMAIL" />
                                            <input type="hidden" asp-for="chg" />

                                            <button class="yellowbuttonbig" id="btnSubmit">Submit</button>
                                            &nbsp;
                                            <button class="yellowbuttonbig" id="btnCancel">Cancel</button>


                                           @*  <asp:Button CssClass="yellowbuttonbig" ID="btnSubmit" runat="server" OnClientClick="return fnRequired();"
                                                        Text="Submit" OnClick="btnSubmit_Click" />
                                            &nbsp;<asp:Button CssClass="yellowbuttonbig" ID="btnCancel" runat="server"
                                                              Text="Cancel" OnClick="btnCancel_Click" /> *@
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>


        @* ---Back Button Start---- *@
        <div class="clear"></div>
        <div class="backrowdiv"><a asp-controller="Home" asp-action="Home" title="Go to Home">Back</a></div>

        <div class="clear"></div>
        @* ----Back Button End---- *@
       
      
    </div>
</div>

   

@section Scripts {
    <script src="~/app/js/qms/isodocrequestappreject.js" asp-append-version="true"></script>
}
