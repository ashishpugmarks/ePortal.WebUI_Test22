@model ePortal.ViewModels.APPX.QMS.ISODocRequestDetailViewModel
@{
    ViewBag.Title = "QMS Document Request Detail : Workflow History";
    Layout = null;
}

<link href="~/aspxview/styles/index.css" rel="stylesheet" asp-append-version="true" />
<link href="~/app/css/qms/isodocrequestdetail.css" rel="stylesheet" asp-append-version="true" />
<form>
    <div>
        <table cellspacing="0" cellpadding="0" width="100%" border="0">
            <tbody>
                <tr>
                    <td valign="top" align="left" style="width: 770px;">
                        <table cellspacing="0" cellpadding="0" width="100%" border="0" id="maintable" runat="server">
                            <tbody>

                                <tr>
                                    <td bgcolor="#ffffff" style="padding-left: 20px">
                                        <fieldset class="swiftfieldset" style="width: 700px">
                                            <legend><b>QMS Document Request Information</b></legend>
                                            <table width="100%" border="0" cellspacing="1" cellpadding="2">
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Request ID:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">&nbsp; @Model.ltlReqID</td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Employee :</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltlEmployee</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Application Date:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltlAppDate</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Status:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltlReqStatus</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">DOC NO:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltldocno</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">DOC Title:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltldoctitle</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Change Type:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltlchangetype</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Department:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltldepartment</span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </fieldset>
                                        <fieldset class="swiftfieldset" style="width: 700px">
                                            <legend><b>Department Approval History</b></legend>
                                            <table width="100%" border="0" cellspacing="0" cellpadding="2">
                                                <tr id="tr_AppAuth" runat="server">
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Department Approval Authority:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltlAppAuth</span>
                                                    </td>
                                                </tr>
                                                <tr id="tr_AppEmail" runat="server">
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Approval Authority Email:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltlAuthEmail</span>
                                                    </td>
                                                </tr>
                                                <tr id="tr_AppStatus" runat="server">
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Status:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltlAppStatus</span>
                                                    </td>
                                                </tr>
                                                <tr id="tr_AppRem" runat="server">
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Remarks:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltlAuthRem</span>
                                                    </td>
                                                </tr>
                                                <tr id="tr_AppDate" runat="server">
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Approval Date:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltlDate</span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </fieldset>
                                        <fieldset class="swiftfieldset" style="width: 700px ;">
                                            <legend><b>Factory QS Secretariat Approval History</b></legend>
                                            <table width="100%" border="0" cellspacing="0" cellpadding="2">
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Factory QS Secretariat Approval Authority:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltlAdminAuth</span>
                                                    </td>
                                                </tr>
                                                <tr id="tr1" runat="server">
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;">
                                                        <span class="smalltext">Approval Authority Email:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltladminemail</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;">
                                                        <span class="smalltext">Status:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltlStatus</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Remarks:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltlAdminRem</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Approval Date:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltlAdminAppDate</span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </fieldset>

                                        <fieldset class="swiftfieldset" style="width: 700px ;">
                                            <legend><b>HO QS Secretariat Approval History</b></legend>
                                            <table width="100%" border="0" cellspacing="0" cellpadding="2">
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">HO QS Secretariat Approval Authority:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltladminheadauth</span>
                                                    </td>
                                                </tr>
                                                <tr id="tr2" runat="server">
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Approval Authority Email:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltladminheademail</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Status:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        @Model.ltladminheadstatus
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Remarks:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        <span>@Model.ltladminheadremarks</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td align="left" valign="middle" class="row2" style="width: 450px; text-align: right;height: 24px;">
                                                        <span class="smalltext">Approval Date:</span>&nbsp;
                                                    </td>
                                                    <td width="55%" valign="middle">
                                                        &nbsp;
                                                        @Model.ltladminheaddate
                                                    </td>
                                                </tr>
                                            </table>
                                        </fieldset>
                                        <br />
                                        <br />

                                    </td>
                                </tr>
                            </tbody>
                        </table>

                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</form>
