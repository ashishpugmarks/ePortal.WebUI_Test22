@model IEnumerable<ePortal.ViewModels.APPX.QMS.DeptSectProcViewModel>
@{
    ViewBag.Title = "Employee Portal - Contract Management :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/newasset.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/css/qms/deptsectproc.css" rel="stylesheet" asp-append-version="true" />
}

<div class="row">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Quality Management System</span>
    </div>

    <div class="body-content" style="overflow-x:hidden; padding: 0px !important;">

        <div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
            <table class="table table-bordered table-condensed table-striped" id="" style="width: 100%;">
                <tbody>
                    <tr>
                        <td class="smalltext" style="padding: 4px;" align="left">
                            <img alt="" src="../../assets/images/blueblockarrow.gif" />&nbsp;<span style="letter-spacing: normal">
                                Procedures for <b>
                                    <asp:Label ID="lblDeptName" runat="server"></asp:Label>
                                </b> Department:
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td align="center">
                            <div>
                                <table class="border" id="grdDeptSectProc" cellspacing="1" cellpadding="4" border="0" style="color:#333333;width:98%;">
                                    <thead>
                                        <tr class="tcat" style="height:20px;">
                                            <th align="left" valign="middle" scope="col">DOCNO</th>
                                            <th align="left" valign="middle" scope="col">&nbsp; Revision No.</th>
                                            <th align="left" valign="middle" scope="col">&nbsp; Procedures Description</th>
                                            <th scope="col"></th>
                                        </tr>
                                    </thead>

                                    @if (Model.Any())
                                    {
                                        <tbody>
                                            @{
                                                int idx = 1;
                                            }
                                            @foreach (var item in Model)
                                            {
                                                <tr class="row1">
                                                    
                                                    <td>
                                                        &nbsp;<span>@item.DOCNO</span>
                                                    </td>
                                                    <td>
                                                        &nbsp;<span>@item.NEWREVISIONNO</span>
                                                    </td>
                                                    <td>
                                                        &nbsp;<span>@item.Description</span>
                                                    </td>
                                                    <td align="left">

                                                        <a data-filename="@item.Filename" class="filename">
                                                            <img src="~/images/application_view_detail.png" style="padding-right: 2px; vertical-align: middle" alt="Procedures" />
                                                        </a>
                                                    </td>
                                                </tr>

                                                idx++;
                                            }

                                        </tbody>
                                    }
                                    else
                                    {
                                        <tfoot>
                                            <tr>
                                                <td colspan="5">
                                                    <div>No Record Found.</div>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    }

                                </table>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="smalltext" style="padding-top: 2px; height: 18px;" align="left">
                            <span style="letter-spacing: normal">
                                &nbsp;&nbsp; <b>Note:</b>&nbsp;These documents
                                are for reference only and shall be treated as uncontrolled if printed.
                            </span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>


        


        @* ---Back Button Start---- *@
        <div class="clear"></div>
        <div class="backrowdiv"><a asp-controller="QMS" asp-action="QcProc1" title="Go to Home">Back</a></div>

        <div class="clear"></div>
        @* ----Back Button End---- *@
    </div>
</div>

   

@section Scripts {
    <script src="~/app/js/qms/deptsectproc.js" asp-append-version="true"></script>
}
