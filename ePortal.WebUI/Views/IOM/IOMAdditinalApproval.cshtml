@model ePortal.ViewModels.IOMHeaderViewModel

@{
    ViewBag.Title = "IOMViewDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _path = "../../../Uploads/DGIT_IOM/";
    @* //Added by TTL on 28th Oct 2025 against SR109889 > CR7269 - End *@
    string _prPath = "../../../Uploads/PR/";
    @* //Added by TTL on 28th Oct 2025 against SR109889 > CR7269 - End *@
}
@section Styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 3px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        table.dataTable {
            clear: both;
            margin-top: 0px !important;
            margin-bottom: 0px !important;
            max-width: none !important;
            border-collapse: separate !important;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        #msform {
            /*text-align: center;*/
            position: relative;
        }

            #msform fieldset {
                background: #fff;
                border: 0 none;
                border-radius: 0px;
                box-shadow: 0 0 1px 1px #337ab7;
                /*padding: 8px 0px;*/
                box-sizing: border-box;
                width: 100%;
                position: relative;
            }

            #msform input, #msform textarea, #msform select {
                padding: 5px;
                border: 1px solid #ccc;
                border-radius: 0px;
                margin-bottom: 8px;
                /*width: 100%;*/
                box-sizing: border-box;
                font-family: arial;
                color: #000;
                font-size: 12px;
            }

        .panel-heading {
            padding: 8px 15px !important;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .div-heading {
            text-align: left;
            height: 2.2em;
            font-weight: bold;
            background-color: #91b4ff;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

            .div-heading div {
                padding: 8px;
            }

        #iom_div {
            border: 1px solid #ccc;
            padding: 8px;
            /*margin-left: 10px;*/
            border-radius: 5px;
            background-color: #eee;
            overflow: auto;
            min-height: 35px;
            max-height: 92px;
            /*width: 73.30%;*/
        }

        .ui-widget {
            font-family: Verdana,Arial,sans-serif;
            font-size: 0.6em !important;
            overflow: auto;
            max-height: 150px;
        }
    </style>
}

    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Approval Note Detail</div>
        </div>
@if (Model.IOMHEADERID == 0)
{
        <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        //sweetAlert("", "Please upload approval note attachment.", "warning");
        swal({
            title: "",
            text: "Unauthorized Access.",
            type: "error",
        }, function (isConfirm) {
            if (isConfirm) {
                window.location.href = "/ASPXView/ManageRequestHistory.aspx?id=IOMDOCRequest";
            }
        });
    </script>
}
else
{
        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Request Detail</strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <div id="msform">
                            <div class="form-group">
                                <fieldset>
                                    <div class="div-heading">
                                        <div>Requestor Detail's</div>
                                    </div>
                                    <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Emp Code") :-  @Model.Emp_Detail._ECode
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Employee Name") :-  @Model.Emp_Detail._EName
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Operation") :-  @Model.Emp_Detail._OpDesc
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Division") :-  @Model.Emp_Detail._DivDesc
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Department") :-  @Model.Emp_Detail._DepDesc
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Section") :-  @Model.Emp_Detail._SecDescrip
                                        </div>
                                    </div>
                                </fieldset>
                            </div>

                            <div class="form-group" style="box-shadow: 0 0 1px 1px #337ab7;">
                                <div class="div-heading">
                                    <div class="col-sm-6 col-md-8 col-lg-9"> Approval Note Detail's</div>
                                    <div class="col-sm-6 col-md-4 col-lg-3">
                                        <span class="pull-right">
                                            <i class="glyphicon glyphicon-new-window"></i>
                                            &nbsp;&nbsp;Click to open document in new window
                                        </span>
                                    </div>
                                </div>
                                <div class="panel-body">
                                    <table class="table table-bordered table-hover table-responsive" style="margin-bottom: 0px;">
                                        <tbody>
                                            <tr>
                                                <td>
                                                    @Html.HiddenFor(model => model.IOMHEADERID, new { @id = "hfIomHeaderId" })
                                                    @Html.LabelFor(model => model.IOMDesc, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.IOMDesc)
                                                </td>
                                                <td rowspan="@(Model.IOMCATMSTID == 4 ? 5 : 4)" id="append_pdf" width="60%;" style="vertical-align: top;"></td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.IOMCATMSTID, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.IOMCATDESC)
                                                    @if (!string.IsNullOrEmpty(Model.IOMCATDESC) && Model.ishighlighted == 1)
                                                    {
                                                        <span class="glyphicon glyphicon-exclamation-sign" style="color: #f93637;font-size:20px;" title='@Model.IOMCATDESC'></span>;
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="width:8%;">
                                                    @Html.LabelFor(model => model.IOMATTACHMENT, htmlAttributes: new { @class = "control-label text-left" })
                                                </td>
                                                <td>
                                                    @{
                                                        var _poAtt = Model.iomDetail.FirstOrDefault(x => x.DOC_TYPE == "IOM");
                                                        <span>
                                                            @if (_poAtt != null)
                                                            {
                                                                var fullPath = _path + _poAtt.FILENAME;
                                                                <a id="iomPDF" data-id="@_poAtt.FILENAME" style="cursor: pointer;margin-right:10px;border: solid 1px;border-radius: 3px;padding: 1px;background-color: aliceblue;" title="Document preview" data-ctrl="getpdf_1">View Approval Note</a>
                                                                <a data-ctrl="opendoc_1" data-path="@fullPath" data-name="@_poAtt.FILENAME" title="Click to open document">
                                                                    <i class="glyphicon glyphicon-new-window" style="cursor:pointer;"></i>
                                                                </a>
                                                                <input type="hidden" id="hfIOMAttachment" value="@_poAtt.FILENAME" />
                                                            }
                                                            else
                                                            {
                                                                <a id="iomPDF" style="cursor: pointer;">View Approval Note</a>
                                                            }
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                            @*Added by TTL on 28th Oct 2025 against SR109889 > CR7269 - Start*@
                                            @if (Model.IOMCATMSTID == 4)
                                            {
                                                <tr>
                                                    <td>
                                                        @Html.LabelFor(model => model.IndentNos, htmlAttributes: new { @class = "control-label" })
                                                    </td>
                                                    <td>
                                                        @if (Model.IndentNos != null && Model.IndentNos.Count > 0)
                                                        {
                                                            @string.Join(", ", Model.IndentNos)
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                            @*Added by TTL on 28th Oct 2025 against SR109889 > CR7269 - End*@
                                            <tr>
                                                <td colspan="2" style="vertical-align:top;">
                                                    <div class="" style="box-shadow: 0 0 1px 1px #337ab7;">
                                                        <div class="div-heading">
                                                            <div>Document Detail's</div>
                                                        </div>
                                                        <div class="panel-body">
                                                            <table class="table table-bordered table-hover table-responsive" id="tbDocDtl" style="margin-bottom: 0px;">
                                                                <thead>
                                                                    <tr class="bg-info">
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.iomDetail[0].IOMDTL_ID)
                                                                        </th>
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.iomDetail[0].DOC_TYPE)
                                                                        </th>
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.iomDetail[0].FILENAME)
                                                                        </th>
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.iomDetail[0].ADDITIONAL_INFO)
                                                                        </th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @{ int _row_No = 0; }
                                                                    @if (Model.iomDetail != null)
                                                                    {
                                                                        foreach (var item in Model.iomDetail.Where(x => x.DOC_TYPE != "IOM").OrderBy(x => x.ADDEDDATE).ToList()) /*Aumento 12072024*/
                                                                        {
                                                                            var _fname = _path + item.FILENAME;
                                                                            var _extension = item.FILENAME.Substring((item.FILENAME.LastIndexOf('.') + 1));
                                                                            <tr>
                                                                                <td class="text-center">
                                                                                    @(_row_No += 1)
                                                                                    @Html.HiddenFor(modelItem => item.IOMDTL_ID)
                                                                                </td>
                                                                                <td class="text-center" style="padding-left: 10px;">
                                                                                    @Html.HiddenFor(modelItem => item.IOMHEADERID)
                                                                                    @Html.DisplayFor(modelItem => item.DOC_TYPE)
                                                                                </td>
                                                                                <td class="text-center" style="padding-left: 10px;">
                                                                                    @if (_extension.ToLower() == "pdf")
                                                                                    {
                                                                                        <a id="iomPDF_@item.IOMDTL_ID" data-id="@item.FILENAME" style="cursor: pointer;margin-right: 10px;" data-ctrl="getpdf">View Document</a>
                                                                                        <a data-ctrl="opendoc" data-path="@_fname" data-name="SD" title="Click to open document">
                                                                                            <i class="glyphicon glyphicon-new-window" style="cursor:pointer;"></i>
                                                                                        </a>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <a href="@Url.Action("DownloadAttachment", "IOM", new { fileName = item.FILENAME })" title="Click to download document">Download Document</a>
                                                                                    }
                                                                                </td>
                                                                                <td class="text-left">
                                                                                    @Html.DisplayFor(modelItem => item.ADDITIONAL_INFO)
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                            @* //Added by TTL on 28th Oct 2025 against SR109889 > CR7269 - End *@
                                                            @* //PR Documents *@
                                                            @if (Model.IOMCATMSTID == 4 && Model.PRDocDetails != null && Model.PRDocDetails.Count > 0)
                                                            {
                                                                <div style="margin:1em;font-size: 14px !important;font-weight:600">PR Documents : </div>
                                                                <div style="height:300px;overflow-y:auto;">
                                                                <table class="table table-bordered table-hover table-responsive" id="tbPRDocDtl">
                                                                    <thead>
                                                                        <tr class="bg-info">
                                                                            @* <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.iomDetail[0].IOMDTL_ID)
                                                                        </th> *@
                                                                            <th class="text-center">
                                                                                Indent No.
                                                                            </th>
                                                                            <th class="text-center">
                                                                                @Html.DisplayNameFor(model => model.iomDetail[0].DOC_TYPE)
                                                                            </th>
                                                                            <th class="text-center">
                                                                                @Html.DisplayNameFor(model => model.iomDetail[0].FILENAME)
                                                                            </th>
                                                                            <th class="text-center">
                                                                                @Html.DisplayNameFor(model => model.iomDetail[0].ADDITIONAL_INFO)
                                                                            </th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var item in Model.PRDocDetails)
                                                                        {
                                                                            var _fname = _prPath + item.FILENAME;
                                                                            var _extension = item.FILENAME.Substring((item.FILENAME.LastIndexOf('.') + 1));
                                                                            <tr>
                                                                                @* <td class="text-center">
                                                                                @(_row_No += 1)
                                                                                @Html.HiddenFor(modelItem => item.PRHEADERID)
                                                                            </td> *@
                                                                                <td class="text-center">
                                                                                    @Html.DisplayFor(modelItem => item.PRNo)
                                                                                </td>
                                                                                <td class="text-left">
                                                                                    @Html.HiddenFor(modelItem => Model.IOMHEADERID)
                                                                                    @Html.DisplayFor(modelItem => item.DOC_TYPE)
                                                                                </td>
                                                                                <td class="text-center">
                                                                                    <a id="prPDF_@item.PRHEADERID" data-id="@item.FILENAME" style="cursor: pointer;margin-right: 10px;" data-ctrl="getprpdf">View</a>
                                                                                    <a data-ctrl="opendoc" data-path="@_fname" data-name="SD" title="Click to open document">
                                                                                        <i class="glyphicon glyphicon-new-window" style="cursor:pointer;"></i>
                                                                                    </a>
                                                                                </td>
                                                                                <td class="text-left">
                                                                                    @Html.DisplayFor(modelItem => item.ADDITIONAL_INFO)
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                                </div>
                                                            }
                                                            @* //Added by TTL on 28th Oct 2025 against SR109889 > CR7269 - End *@
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="form-group" style="box-shadow: 0 0 1px 1px #337ab7;">
                                <div class="div-heading">
                                    <div style="vertical-align:middle;">
                                        Approval History
                                        @*<h2 class="panel-title">
                                        *@
                                        @*<span>Approval History</span>*@

                                        @{string str1 = "", str2 = ""; string strdivfxhdn = "", strdivothhdn = ""; }
                                        @if (Model.APP_TYPE == 1) { str1 = "checked=checked"; strdivothhdn = "hidden"; } else { str2 = "checked=checked"; strdivfxhdn = "hidden"; }
                                        <span class="pull-right">
                                            Approval Type&nbsp;&nbsp;<input type="radio" name="rdbFO" disabled="disabled" value="1" @str1 /> Company Defined Authority &nbsp; <input type="radio" name="rdbFO" value="2" disabled="disabled" @str2 />&nbsp; Other&nbsp;&nbsp;
                                        </span>
                                    </div>
                                </div>
                                <div class="panel-body">
                                    <table class="table table-bordered table-hover table-responsive" id="tbApprovalHis" style="margin-bottom: 0px;">
                                        <thead>
                                            <tr class="bg-info">
                                                <th class="text-center">
                                                    @Html.DisplayNameFor(model => model.iomAppHis[0].IOMAPPHISTORY_ID)
                                                </th>
                                                <th class="text-left">
                                                    @Html.DisplayNameFor(model => model.iomAppHis[0].APPEMP_NAME)
                                                </th>
                                                <th class="text-center">
                                                    @Html.DisplayNameFor(model => model.iomAppHis[0].APPROVAL_STATUS)
                                                </th>
                                                <th class="text-center">
                                                    @Html.DisplayNameFor(model => model.iomAppHis[0].APPROVALDATE)
                                                </th>
                                                <th class="text-left">
                                                    @Html.DisplayNameFor(model => model.iomAppHis[0].APPROVAL_REMARK)
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{ int row_No = 0; }
                                            @if (Model.iomAppHis != null)
                                            {
                                                foreach (var item in Model.iomAppHis)
                                                {
                                                    <tr>
                                                        <td class="text-center">
                                                            @(row_No += 1)
                                                            @Html.HiddenFor(modelItem => item.IOMAPPHISTORY_ID)
                                                        </td>
                                                        <td class="text-left" style="padding-left: 10px;">
                                                            @Html.HiddenFor(modelItem => item.IOMID)
                                                            @Html.DisplayFor(modelItem => item.APPEMP_NAME)
                                                        </td>
                                                        <td class="text-center" style="padding-left: 10px;">
                                                            @{
                                                                string _msg = "";
                                                                if (item.APPROVAL_STATUS == 1)
                                                                {
                                                                    _msg = "Approved";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 2)
                                                                {
                                                                    _msg = "Send back";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 3)
                                                                {
                                                                    _msg = "Rejected";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 0)
                                                                {
                                                                    _msg = "Pending";
                                                                }
                                                                //Aumento 12072024 start
                                                                else if (item.APPROVAL_STATUS == 5)
                                                                {
                                                                    _msg = "Hold";
                                                                }
                                                                //Aumento 12072024 end
                                                                <span>@_msg</span>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @Html.DisplayFor(modelItem => item.APPROVALDATE)
                                                        </td>
                                                        <td class="text-left" style="padding-left: 10px;">
                                                            @Html.DisplayFor(modelItem => item.APPROVAL_REMARK)
                                                        </td>
                                                    </tr>
                                                                    }
                                                                }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="panel-group">
                                <div class="panel panel-primary">
                                    <div style="vertical-align:middle!important;" class="panel-heading">
                                        Add Additional Approval Authority
                                        @*<h2 class="panel-title">
                                        *@
                                        @*<span>Approval History</span>*@

                                        @{ str1 = ""; str2 = ""; strdivfxhdn = ""; strdivothhdn = ""; }
                                        @if (Model.APP_TYPE == 1) { str1 = "checked=checked"; strdivothhdn = "hidden"; } else { str2 = "checked=checked"; strdivfxhdn = "hidden"; }
                                        <span class="pull-right">
                                            Approval Type&nbsp;&nbsp;<input type="radio" name="rdbFO1" disabled="disabled" value="1" @str1 /> Company Defined Authority &nbsp; <input type="radio" name="rdbFO1" value="2" disabled="disabled" @str2 />&nbsp; Other&nbsp;&nbsp;
                                        </span>
                                    </div>
                                    <div class="panel-body">
                                        @{
                                            if (Model.APP_TYPE == 1)
                                            {
                                                <div class="form-group" id="FixedApproval">
                                                    <div class="col-md-1 col-sm-3 col-xs-3 text-right">
                                                        @Html.Label("","Header", htmlAttributes: new { @class = "control-label required" })
                                                    </div>
                                                    <div class="col-md-2 col-sm-4 col-xs-5">
                                                        <select class="form-control" id="ddHeader">
                                                            <option value="">-Select-</option>
                                                            <option value="1">Section Manager</option>
                                                            <option value="2">Department Manager</option>
                                                            <option value="3">Coordinator</option>
                                                            <option value="4">Division Head</option>
                                                            <option value="5">Executive Coordinator</option>
                                                            <option value="6">Operating Head</option>
                                                            <option value="7">Executive Internal Auditor</option>
                                                            <option value="8">Executive Vice President</option>
                                                            <option value="9">Director</option>
                                                            <option value="10">Chief Production Officer</option>
                                                            <option value="11">President & CEO</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-1 col-sm-3 col-xs-3 text-right">
                                                        @Html.LabelFor(model => model.iomAuthSeq[0].ADEMPCODE, htmlAttributes: new { @class = "control-label required" })
                                                    </div>
                                                    <div class="col-md-3 col-sm-4 col-xs-5">
                                                        <input type="text" class="form-control" id="txtEmpcode" placeholder="Search Employee" @*style="width:145px"*@ />
                                                        <span id="searchTerm"></span>
                                                    </div>

                                                    <div class="col-md-1 col-sm-4 col-xs-4">
                                                        <input type="button" class="btn btn-primary btn-sm" value="Add Authority" id="btnAdd" />
                                                    </div>
                                                    <div class="col-md-4 col-sm-4 col-xs-4" style="margin-top:6px;">
                                                        <span id="spn_auth_msg" style="color:#a94442;font-weight:600;"></span>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="form-group" id="CrossApproval">
                                                    <div class="col-md-1 col-sm-3 col-xs-3 text-right">
                                                        @Html.Label("","Header", htmlAttributes: new { @class = "control-label required" })
                                                    </div>
                                                    <div class="col-md-2 col-sm-4 col-xs-5">
                                                        <input type="text" class="form-control" id="txtOheader" placeholder="Approval Header" />
                                                    </div>
                                                    <div class="col-md-1 col-sm-3 col-xs-3 text-right">
                                                        @Html.LabelFor(model => model.iomAuthSeq[0].ADEMPCODE, htmlAttributes: new { @class = "control-label required" })
                                                    </div>
                                                    <div class="col-md-3 col-sm-4 col-xs-5">
                                                        <input type="text" class="form-control" id="txtOEmpcode" placeholder="Search Employee" />
                                                        <span id="OsearchTerm"></span>
                                                    </div>

                                                    <div class="col-md-1 col-sm-4 col-xs-4">
                                                        <input type="button" class="btn btn-primary btn-sm" value="Add Authority" id="btnOadd" />
                                                    </div>
                                                    <div class="col-md-4 col-sm-4 col-xs-4" style="margin-top:6px;">
                                                        <span id="spn_O_auth_msg" style="color:#a94442;font-weight:600;"></span>
                                                    </div>
                                                </div>
                                            }
                                           }
                                            <table class="table table-bordered table-responsive" id="mytable" style="margin-bottom: 0px!important;">
                                                <thead>
                                                    <tr class="bg-info">
                                                        <th class="text-center">SNo.</th>
                                                        <th class="text-center">Header</th>
                                                        <th class="text-center">Emp Code</th>
                                                        <th>Employee Name</th>
                                                        <th class="text-center">Designation</th>
                                                        <th class="text-center hidden" colspan="2" width="6%;">Move Seq</th>
                                                        <th class="text-center">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="append_row">
                                                    <tr><th colspan="6" class="text-center">No record found.</th></tr>
                                                </tbody>
                                            </table>

                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group text-center">
                                        <input type="button" class="cancel btn btn-dark" value="Cancel" id="btnReset" />
                                        <input type="button" value="Submit" class="btn btn-success" id="btnPreview" />
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        </div>
   
    <div id="myPreviewModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog" style="width: 900px;">
            <div class="modal-content">
                <div class="modal-header" style="padding:10px!important;">
                    <div class="pull-left">
                        <h5 class="modal-title"><span>Preview</span></h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body" style="padding:10px!important;">
                    <div id="IOM_attachment"></div>
                    <div class="form-group" style="margin-top:10px;font-size:13px;">
                        <table class="table table-bordered table-hover table-responsive">
                            <tr style="background-color: antiquewhite;">
                                <td colspan="4">
                                    <span style="color: blue;">
                                        <strong> Note:- </strong>Incase approval Authority box is not fitting on the page, that is due to earlier approvals utilizes the space.Hence continue with existing approval or else proceed with fresh approval of the document.
                                    </span>
                                    <br />
                                    <br />
                                </td>
                            </tr>

                        </table>
                    </div>
                    <div class="form-group text-center" style="margin-top:10px;">
                        <input type="button" name="cancel" class="btn btn-dark" value="Cancel" data-dismiss="modal" aria-label="Close" />
                        <input type="button" value="OK" class="submit btn btn-success" id="btnSave" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div id="ajaxLoader"></div>

@section Scripts {

    <script src="~/js/jquery-ui.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        var arrayList = new Array;
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {

            if ($("#iomPDF") != null && $("#iomPDF") !="undefined") {
                GetPDF($("#iomPDF"));
                $("#ajaxLoader").removeClass('loader');
            }
        });

        function GetPDF(current) {
            var _pdfName = $(current).attr('data-id');
            if (_pdfName != "") {
                $.ajax({
                    type: "GET",
                    url: "/IOM/GetPDF",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { fileName: _pdfName },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.FILEPATH != "") {
                            document.getElementById("append_pdf").innerHTML = data.FILEPATH;
                        }
                        else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function CancelClick() {
            window.location.href = "/Home/Home";
        }

        function OpenDoc(current) {
            var _pdfPath = $(current).attr('data-path');
            var _pdfName = $(current).attr('data-name');
            var width = screen.width - 100;
            var height = screen.height - 100;
            var winTop = 50;
            var winLeft = 50;
            var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
            window.open(_pdfPath, _pdfName, windowFeatures);
        }

        $(function () {
            $("input#txtEmpcode").autocomplete({
                source: "/IOM/AutocompleteSuggestions",
                minLength: 2,
                select: function (event, ui) {
                    if (ui.item) {
                        $("#searchTerm").val(ui.item.value);
                    }

                }
            });
        });
        $(function () {
            $("input#txtOEmpcode").autocomplete({
                source: "/IOM/AutocompleteSuggestions",
                minLength: 2,
                select: function (event, ui) {
                    if (ui.item) {
                        $("#OsearchTerm").val(ui.item.value);
                    }

                }
            });
        });

        function AddAuthority() {
            $('#spn_auth_msg').text('');
            $('#ddHeader').removeClass('validationError');
            if ($('#ddHeader').val() == "") {
                $('#ddHeader').addClass('validationError');
                $('#spn_auth_msg').text('Please select header.');
                return;
            }
            $('#txtEmpcode').removeClass('validationError');
            if ($('#txtEmpcode').val() == "") {
                $('#txtEmpcode').addClass('validationError');
                $('#spn_auth_msg').text('Please enter employee code.');
                return;
            }
            if (arrayList.length > 0) {
                var _ecode = parseInt($('#txtEmpcode').val().split("-")[0].trim());
                var itemArray = $.grep(arrayList, function (e) {
                    return e.ADEMPCODE == _ecode;
                });
                if (itemArray.length > 0) {
                    $('#txtEmpcode').addClass('validationError');
                    $('#spn_auth_msg').text('This approval authority already added.');
                    return;
                }

                //var itemArray2 = $.grep(arrayList, function (e) {
                //    return e.APP_SEQ == $('#ddHeader').val();
                //});
                //if (itemArray2.length > 0) {
                //    $('#ddHeader').addClass('validationError');
                //    $('#spn_auth_msg').text('This designation already added.');
                //    return;
                //}
            }
            $.ajax({
                type: "GET",
                url: "/IOM/GetAppAuthority",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: { eCode: $('#txtEmpcode').val(), headerId: $("#ddHeader").val(), header: $('#ddHeader option:selected').text() },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.ECODE > 0 && data.ENAME != "") {
                        arrayList = data.SEQ_LIST;
                        $('#txtEmpcode').val('');
                        $("#ddHeader").val('');
                    }
                    else {
                        $('#spn_auth_msg').text('Record not found.');
                    }
                },
                complete: function () {
                    BindData(arrayList);
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function DeleteItem(current) {
            var appHeader = $(current).attr('data-headerid');
            $.ajax({
                type: "GET",
                url: "/IOM/DeleteAppAuthority",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: { eCode: current.id, header: appHeader, ISALL: 0 },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.RESULT == 1) {
                        arrayList = data.SEQ_LIST;
                    }
                    else {
                        $('#spn_auth_msg').text('Record not deleted.');
                    }
                },
                complete: function () {
                    BindData(arrayList);
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function BindData(arrayList) {
            var rows = "", rowId = 0;
            if (arrayList != null) {
                if (arrayList.length > 0) {
                    $.each(arrayList, function (i, item) {
                        rowId = i + 1;
                        rows += "<tr class='tr-auth'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.Header + "</td><td class='text-center'>" + item.ADEMPCODE + "</td>"
                        rows += "<td class='text-left'><input type='hidden' value='" + item.APP_SEQ + "'>" + item.ADEMPNAME + "</td><td class='text-center'><input type='hidden' value='" + item.FNDESID + "'>" + item.ADDESIGNATION + "</td>"
                        //rows += "<td class='text-center'>" + item.APP_SEQ + "</td>"
                        rows += "<td class='hidden'><input type='button' value='up' class='move up text-right btn btn-info btn-xs' /></td><td class='hidden'><input type='button' value='down' class='move down text-left btn btn-info btn-xs' /></td>"
                        rows += "<td class='text-center'><a id='" + item.ADEMPCODE + "' data-headerid='" + item.Header + "' style='cursor: pointer;' data-ctrl='deleteitem'>Delete</a></td>"
                        rows += "</tr>"
                    });
                }
                else {
                    rows += "<tr id='div-table'><td colspan='6' class='text-center'>No record found.</td></tr>"
                }
                document.getElementById("append_row").innerHTML = rows;

                //CSP 3.0 Compliant changes
                if (rowId > 0) {
                    $("[data-ctrl='deleteitem']").on('click', function () {
                        DeleteItem($(this)[0]);
                    });
                }
            }
            else {
                rows += "<tr id='div-table'><td colspan='6' class='text-center'>No record found.</td></tr>"
                document.getElementById("append_row").innerHTML = rows;
            }
        }
        function AddOAuthority() {
            $('#spn_O_auth_msg').text('');
            $('#txtOheader').removeClass('validationError');
            if ($('#txtOheader').val() == "") {
                $('#txtOheader').addClass('validationError');
                $('#spn_O_auth_msg').text('Please select header.');
                return;
            }
            $('#txtOEmpcode').removeClass('validationError');
            if ($('#txtOEmpcode').val() == "") {
                $('#txtOEmpcode').addClass('validationError');
                $('#spn_O_auth_msg').text('Please enter employee code.');
                return;
            }
            if (arrayList.length > 0) {
                var _ecode = parseInt($('#txtOEmpcode').val().split("-")[0].trim());
                var itemArray = $.grep(arrayList, function (e) {
                    return e.ADEMPCODE == _ecode;
                });
                if (itemArray.length > 0) {
                    $('#txtOEmpcode').addClass('validationError');
                    $('#spn_O_auth_msg').text('This approval authority already added.');
                    return;
                }

                //var itemArray2 = $.grep(arrayList, function (e) {
                //    return e.APP_SEQ == $('#ddHeader').val();
                //});
                //if (itemArray2.length > 0) {
                //    $('#ddHeader').addClass('validationError');
                //    $('#spn_auth_msg').text('This designation already added.');
                //    return;
                //}
            }
            $.ajax({
                type: "GET",
                url: "/IOM/GetAppAuthority",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: { eCode: $('#txtOEmpcode').val(), headerId: arrayList.length, header: $("#txtOheader").val() },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.ECODE > 0 && data.ENAME != "") {
                        arrayList = data.SEQ_LIST;
                        $('#txtOEmpcode').val('');
                        //$("#ddHeader").val('');
                    }
                    else {
                        $('#spn_O_auth_msg').text('Record not found.');
                    }
                },
                complete: function () {
                    BindData(arrayList);
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
        function submitForm() {
            $('#myPreviewModel').modal('hide');
                $('#txtEmpcode').removeClass('validationError');
                if (arrayList == null || arrayList.length == 0) {
                    $('#txtEmpcode').addClass('validationError');
                    sweetAlert("", "Please add approval authority.", "warning");
                    return;
                }
                else {
                    $("#btnSave").attr("disabled", true);
                    $("#btnPreview").attr("disabled", true);
                    var rowLength = $('#mytable').find('.tr-auth').length;
                    var rows = $('#mytable').find('.tr-auth');
                    var newArrayList = new Array;
                    for (var i = 0; i < rowLength; i += 1) {
                        var row = rows[i];
                        if (row != undefined) {
                            app_seq = i; //$(row.cells[2]).find('input[type=hidden]').val();
                            fnId = $(row.cells[3]).find('input[type=hidden]').val();
                            var rowData = {
                                Header: $(row.cells[1])[0].textContent,
                                ADEMPCODE: $(row.cells[2])[0].textContent,
                                ADEMPNAME: $(row.cells[3])[0].textContent,
                                ADDESIGNATION: $(row.cells[4])[0].textContent,
                                APP_SEQ: app_seq,
                                APPTYPE: 1,
                                FNDESID: fnId,
                            }
                            newArrayList.push(rowData);
                        }
                    }
                    arrayList = newArrayList;

                    var data = {
                        IOMHEADERID: $("#hfIomHeaderId").val(),
                        iomAuthSeq: arrayList,
                    }
                    $.ajax({
                        type: "POST",
                        url: "/IOM/IOMAdditinalApproval",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        data: JSON.stringify(data),
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (data) {
                            debugger;
                            if (data == 1) {
                                swal({
                                    title: "",
                                    text: "Record saved successfully.",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                        window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                                    }
                                });
                            }
                            else if (data == -2) {
                                sweetAlert("", "Added Additinal authority already exist in approval.", "warning");
                                ///BindDocument(new Array);
                                $("#btnSave").attr("disabled", false);
                                $("#btnPreview").attr("disabled", false);
                            }
                            else if (data == 2) {
                                sweetAlert("", "This approval note request already processed.", "warning");
                                //BindDocument(new Array);
                                $("#btnSave").attr("disabled", false);
                                $("#btnPreview").attr("disabled", false);
                            }
                            else if (data == -3) {
                                sweetAlert("", "Please upload approval note attachment.", "warning");
                                $("#btnSave").attr("disabled", false);
                                $("#btnPreview").attr("disabled", false);
                            }
                            else {
                                sweetAlert("", "Record not saved.", "warning");
                                //BindDocument(new Array);
                                $("#btnSave").attr("disabled", false);
                                $("#btnPreview").attr("disabled", false);
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                            $("#btnSave").attr("disabled", false);
                            $("#btnPreview").attr("disabled", false);
                            $("#ajaxLoader").removeClass('loader');
                        }
                    });
                }

            //else {
            //    $('#div_valid_msg').removeClass('hidden');
            //}
        }
        function Preview() {
            $('#myPreviewModel').modal('hide');
            debugger;
            //var isFormVaildation = CheckFormValidation();
                $('#txtEmpcode').removeClass('validationError');
                if (arrayList == null || arrayList.length == 0) {
                    $('#txtEmpcode').addClass('validationError');
                    sweetAlert("", "Please add approval authority.", "warning");
                    return;
                }
                else {
                    var _iomFile = $("#hfIOMAttachment").val();
                    if (_iomFile != "") {
                        $("#btnPreview").attr("disabled", true);

                        var data = {
                            IOMHEADERID: $("#hfIomHeaderId").val(),
                            iomAuthSeq: arrayList,
                            IOMATTACHMENT: _iomFile
                        }
                        debugger;
                          $.ajax({
                            type: "POST",
                            url: "/IOM/PreviewIOM",
                            beforeSend: function () {
                                $("#ajaxLoader").addClass('loader');
                            },
                            data: JSON.stringify(data),
                            contentType: "application/json; charset=utf-8",
                            datatype: "json",
                            success: function (data) {
                                if (data.FILEPATH != "") {
                                    document.getElementById("IOM_attachment").innerHTML = data.FILEPATH;
                                    $('#myPreviewModel').modal({ backdrop: "static" });
                                }
                            },
                            complete: function () {
                                $("#ajaxLoader").removeClass('loader');
                                $("#btnPreview").attr("disabled", false);
                            },
                            error: function () {
                                sweetAlert("Oops...", "Something went wrong!", "error");
                                $("#btnPreview").attr("disabled", false);
                                $("#ajaxLoader").removeClass('loader');
                            }
                        });
                    }
                    else {
                        sweetAlert("", "IOM attachment not found. Please upload again.", "warning");
                        return;
                    }
                }
        }
        function Reset() {
            window.location.href = "/ASPXView/ManageRequestHistory.aspx?id=IOMDOCRequest";
        }
            //else {
            //    $('#div_valid_msg').removeClass('hidden');
            //}
        //}
