                    sweetAlert("",`Only numbers are allowed!: ${event.item}`,"error");
                    return;
                }
                GetPRDoc(event.item);
            });
            let isAutoRemoval = false;
            $('#txtIndentNos').on('itemRemoved', function(event) {
                if(!isAutoRemoval){
                    PRAttachmentArray = PRAttachmentArray.filter(item => item.PRNo !== event.item);
                    BindPRDocument(PRAttachmentArray);
                    showSuccessMessage(event.item,false);
                }
                isAutoRemoval = false;
            });

            function GetPRDoc(IndentNos){
                $.ajax({
                    type: "GET",
                    url: "/IOM/GetPRDocumentsByIndentNo",
                    data: { IndentNos: IndentNos },
                    traditional: true,
                    datatype: "json",
                    success: function (data) {
                        if(data.length > 0 ){
                            PRAttachmentArray.push(...data);
                            BindPRDocument(PRAttachmentArray);
                            showSuccessMessage(IndentNos);

                        }else{
                            isAutoRemoval = true;
                            $('#txtIndentNos').tagsinput('remove', IndentNos);
                            sweetAlert("",`No document found for Indent No: ${IndentNos}`,"error");
                        }
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }

            function showSuccessMessage(indentNo, isSuccess = true) {
                if(isSuccess){
                    $('#IndentDocsuccessMsg').text(`PR-${indentNo} with documents has been fetched successfully!`);
                    $('#IndentDocsuccessMsg').removeClass("alert-danger");
                    $('#IndentDocsuccessMsg').addClass("alert-success");
                    $('#IndentDocsuccessMsg').fadeIn();

                }else{
                    $('#IndentDocsuccessMsg').text(`PR-${indentNo} with documents has been removed successfully!`);
                    $('#IndentDocsuccessMsg').removeClass("alert-success");
                    $('#IndentDocsuccessMsg').addClass("alert-danger");
                    $('#IndentDocsuccessMsg').fadeIn();
                }
                setTimeout(function () {
                    $('#IndentDocsuccessMsg').fadeOut();
                }, 4000);
            }

            function BindPRDocument(attList) {
                var rows = "", rowId = 0;
                if (attList != null) {
                    if (attList.length > 0) {
                        $.each(attList, function (i, item) {
                            rowId = i + 1;
                            var additionalInfo = item.ADDITIONAL_INFO == null ? "":item.ADDITIONAL_INFO;
                            rows += "<tr class='tr_doc'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.PRNo + "</td>"
                            rows += "<td class='text-center'>" + item.DOC_TYPE + "</td>"
                            rows += "<td class='text-left'><a style='cursor: pointer;' data-id='"+ item.FILENAME +"' data-ctrl='getprpdf'>" + item.FILENAME + "</a></td>"
                            rows += "<td class='text-left'>" + additionalInfo + "</td>"
                            rows += "</tr>"
                        });
                        document.getElementById("append_PR_docRow").innerHTML = rows;
                        //CSP 3.0 Compliant changes
                        if (rowId > 0) {
                            $("[data-ctrl='getprpdf']").on('click', function () {
                                GetPRPDF($(this)[0]);
                            });
                        }
                    }
                    else{
                        var _row = "<tr><th colspan='6' class='text-center'>No record found.</th></tr>"
                        document.getElementById("append_PR_docRow").innerHTML = _row;
                    }
                }
            }
            function GetPRPDF(current) {
                var _pdfName = $(current).attr('data-id');
                var _extension = _pdfName.substr((_pdfName.lastIndexOf('.') + 1));
                if (_pdfName != "" && _extension.toLowerCase() == "pdf") {
                    $.ajax({
                        type: "GET",
                        url: "/IOM/GetPRPDF",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        data: { fileName: _pdfName },
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (data) {
                            if (data.FILEPATH != "") {
                                document.getElementById("myCreateModelContent").innerHTML = data.FILEPATH;
                                $('#myCreateModel').modal({ backdrop: "static" });
                            }
                            else {
                                sweetAlert("", "File not found.", "warning");
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }
                else if(_pdfName != "" && _extension.toLowerCase() != "pdf"){
                    window.open("../../../Uploads/DGIT_IOM/" + _pdfName,"_blank");
                }
            }
            //Added by TTL on 28th Oct 2025 against SR109889 > CR7269 - End
        });
    </script>
