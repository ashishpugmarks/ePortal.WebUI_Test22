                ? "/PIOM/UploadIOMAttachment" : "/IOM/UploadIOMAttachment";

            /* ============================================================================================================== PIOM ================================================================================================ */
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                /* ============================================================================================================== PIOM ================================================================================================ */
                  url: url,
                /* ============================================================================================================== PIOM ================================================================================================ */
                data: formData,
                datatype: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.res == 1 && data.headerId > 0) {
                        $("#hfIOMHeaderId").val(data.headerId);
                        sweetAlert("", "IOM Attachment uploaded successfully.", "success");
                        if(data.iomAttachment != null){
                            $("#hfIOMAttachment").val(data.iomAttachment.FILENAME);
                            //var atag =  "<a style='cursor: pointer;' onclick='GetIOMPDF(this)' title='Click to view IOM attachment.' data-id='"+ data.iomAttachment.FILENAME +"'>"+ data.iomAttachment.FILENAME +"</a>"
                        }
                    }
                    else if (data.res == 0 || data.res == -1) {
                        sweetAlert("", "Approval Note attachment not uploaded, Please try again.", "warning");
                        $("#txtIOMFile").val('');
