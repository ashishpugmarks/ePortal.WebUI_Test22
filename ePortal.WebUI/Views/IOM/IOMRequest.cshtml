        // Separate function to call API and get records (no await, use .then)
        function fetchPrevAuthorityRecords(callback) {
            const apiUrl = '/PIOM/GetPIOMPrevAuthority';

            $.ajax({
                url: apiUrl,
                type: 'GET',
                dataType: 'json'
            })
                .done(function (response) {
                    if (response && response.HeaderList && response.HeaderList.length > 0) {
                        callback(null, response.HeaderList); // Success: pass records
                    } else {
                        alert('No records found!');
                        callback(null, []); // Empty array on no data
                    }
                })
                .fail(function (error) {
                    console.error('API Error:', error);
                    alert('Something went wrong while fetching data.');
                    callback(error, []); // Error: pass error
                });
        }

        // Helper function to close modal (reusable, no error-prone hide)
        function closeModal(modalId) {
            if ($(`#${modalId}`).length > 0) {
                $(`#${modalId}-backdrop`).hide();
                $(`#${modalId}`).hide();
            }
        }

        // Separate function to build and show modal (updated for safety)
        function createPrevAuthModal(records) {
            const modalId = 'prevAuthModal';

            // Remove if already exists (prevents duplicates)
            closeModal(modalId);
            $(`#${modalId}`).remove();
            $(`#${modalId}-backdrop`).remove();

            // Build HTML (basic styling, no Bootstrap JS)
            let modalHtml = `
             <div class="modal-backdrop" id="${modalId}-backdrop" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1040;"></div>
             <div class="modal select-previous-authority" id="${modalId}" tabindex="-1" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1050; overflow: auto; background-color: transparent;">
                 <div class="modal-dialog modal-lg" style="margin: 50px auto; width: 80%; max-width: 800px;">
                     <div class="modal-content" style="border-radius: 5px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                         <div class="modal-header" style="background-color: #f8f9fa; border-bottom: 1px solid #dee2e6; padding: 15px; display: flex; justify-content: space-between; align-items: center;">
                             <h5 class="modal-title" id="prevAuthLabel">Select Previous Authority</h5>
                             <button type="button" class="close-btn" id="closePrevAuth" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #6c757d;">&times;</button>
                         </div>
                         <div class="modal-body" style="padding: 15px;">
                             <div class="table-responsive">
                                 <table class="table table-striped">
                                     <thead>
                                         <tr>
                                             <th>Select</th>
                                             <th>Description</th>
                                             <th>Stages</th>
                                          </tr>
                                     </thead>
                                     <tbody>`;

            records.forEach((record, index) => {
                // Get comma-separated stages from record.Stages
                let stagesList = 'N/A';
                if (record.Stages && record.Stages.length > 0) {
                    stagesList = record.Stages.map(stage => stage.StageName || 'Unnamed').join(', ');
                }
                let IOMDesc = 'N/A';
                if (record.IOMDesc && record.IOMDesc.length > 0) {
                    IOMDesc = record.IOMDesc;
                }
                modalHtml += `
             <tr>
                 <td>
                     <input type="radio" name="selectedRecord" value="${index}" id="radio_${index}">
                 </td>
                 <td>${IOMDesc}</td>
                 <td>${stagesList}</td>
             </tr>`;
            });

            modalHtml += `
                                     </tbody>
                                 </table>
                             </div>
                         </div>
                         <div class="modal-footer" >

                             <button type="button" class="btn btn-secondary" id="cancelPrevAuth" style="padding: 8px 16px; border: 1px solid #6c757d; background: #6c757d; color: white; border-radius: 4px; cursor: pointer;">Cancel</button>
                             <button type="button" class="btn btn-primary" id="submitPrevAuth" style="padding: 8px 16px; border: 1px solid #0d6efd; background: #0d6efd; color: white; border-radius: 4px; cursor: pointer;">Submit</button>
                         </div>
                     </div>
                 </div>
             </div>`;

            // Append to body
            $('body').append(modalHtml);

            // Open modal safely
            $(`#${modalId}-backdrop`).show();
            $(`#${modalId}`).show();

            // Attach close handlers (safe checks)
            $(document).off('click', `#${modalId} #closePrevAuth, #${modalId} #cancelPrevAuth`).on('click', `#${modalId} #closePrevAuth, #${modalId} #cancelPrevAuth`, function () {
                closeModal(modalId);
                $(`#${modalId}, #${modalId}-backdrop`).remove();
            });
            $(document).off('click', `#${modalId}-backdrop`).on('click', `#${modalId}-backdrop`, function () {
                closeModal(modalId);
                $(`#${modalId}, #${modalId}-backdrop`).remove();
            });

            return { modalId };
        }

        // Fixed handleSubmit function (swal syntax corrected, confirm check added)
        function handleSubmit(records, modalId) {
            const selectedRadio = $(`#${modalId} input[name="selectedRecord"]:checked`);
            if (selectedRadio.length === 0) {
                alert('Please select one record!');
                return;
            }

            const selectedIndex = parseInt(selectedRadio.val());
            const selectedRecord = records[selectedIndex];

            swal({
                title: "",
                text: "Are you sure you want to set previous authority..?\nif Yes then set authorities will be removed.",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: '#DD6B55',
                confirmButtonText: 'Yes',
                cancelButtonText: "No"
            }, function (isConfirm) {
                if (isConfirm) { // Only proceed if user clicks 'Yes'
                    appendSelectedStagesToUI(selectedRecord.Stages);
                    closeModal(modalId);
                    $(`#${modalId}, #${modalId}-backdrop`).remove();
                }
                // If cancel, do nothing – modal stays open for re-selection
            });
        }

        // NEW: Separate function to append selected stages/groups/approvers to UI
        function appendSelectedStagesToUI(stages) {
            // Clear existing stages and reset counters (to start fresh with selected data)
            $('#stageContainer').empty();
            currentStageCount = 0;
            parallelGroupCount = {};
            parallelStages = [];

            // Loop over each stage from selected record
            stages.forEach(function (stage, stageOrder) {
                // Add the stage using existing addStage function
                addStage(stage.StageName);

                // Get the current stage index (after addStage increments it)
                var stageIdx = currentStageCount - 1; // Latest added

                // Initialize group count for this stage
                parallelGroupCount[stageIdx] = 0;

                // Loop over each parallel group in this stage
                stage.ParallelGroups.forEach(function (pg, pgOrder) {
                    var groupName = pg.GroupName || 'Default Group'; // Fallback if empty
                    var groupIdx = parallelGroupCount[stageIdx]; // Current group count

                    // Get HTML for the group using existing function
                    var groupHtml = getApprovalGroupHtml(stageIdx, groupIdx, groupName);
                    $('#parallelGroupsContainer_' + stageIdx).prepend(groupHtml);

                    // Set the header input (use first approver's Header if available, as it's shared per group)
                    var firstApproverHeader = '';
                    if (pg.Approvers && pg.Approvers.length > 0) {
                        firstApproverHeader = pg.Approvers[0].Header || '';
                    }
                    // $(`#txtHeader_${stageIdx}_${groupIdx}`).val(firstApproverHeader);

                    // Now populate approvers rows directly (no API call, use model data)
                    var tbody = $(`#approvalBody_${stageIdx}_${groupIdx}`);
                    tbody.empty(); // Clear "No record found"

                    pg.Approvers.forEach(function (approver, appOrder) {
                        var rowId = appOrder + 1;
                        var row = `
            <tr class='tr-auth'>
                <td class='text-center'>${rowId}</td>
                <td class='text-center'>${approver.Header || ''}</td>
                <td class='text-center'>${approver.ADEMPCODE || ''}</td>
                <td class='text-left'>
                    <input type='hidden' value='${approver.APP_SEQ || 0}'>
                    ${approver.ADEMPNAME || ''}
                </td>
                <td class='text-center'>
                    <input type='hidden' value='${approver.APP_SEQ || 0}'>
                    ${approver.ADDESIGNATION || ''}
                </td>

                                                          <td class='text-center action-btn'>

                                      <a style='cursor:pointer;'  data-ctrl='deleteitem'>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="17px" height="17px" viewBox="0 0 24 24" fill="none">
                                            <path d="M10 12V17" stroke="#d9534f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path d="M14 12V17" stroke="#d9534f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path d="M4 7H20" stroke="#d9534f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path d="M6 10V18C6 19.6569 7.34315 21 9 21H15C16.6569 21 18 19.6569 18 18V10" stroke="#d9534f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path d="M9 5C9 3.89543 9.89543 3 11 3H13C14.1046 3 15 3.89543 15 5V7H9V5Z" stroke="#d9534f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                    </a>
                                       <button type="button" class="btn btn-sm btn-transparent btn-move" title="Reorder">
                                           <span class="triangle-up"></span>
                                           <span class="triangle-down"></span>
                                       </button>
                                  </td>
            </tr>`;
                        tbody.append(row);
                    });


                    // Attach delete event for approver rows (existing logic)
                    tbody.find("[data-ctrl='deleteitem']").off("click").on("click", function () {
                        $(this).closest("tr").remove();
                        // Re-index SNo after delete (simple, loop and update)
                        tbody.find('tr.tr-auth').each(function (idx) {
                            $(this).find('td').eq(0).text(idx + 1);
                        });
                    });

                    // Bind employee autocomplete for this group (existing function, for future adds)
                    bindEmployeeAutocomplete(stageIdx, groupIdx);

                    // Increment group count
                    parallelGroupCount[stageIdx]++;
                });
            });

            // Optional: Show the panel if hidden
            $('#parallelapproval').removeClass('hidden').addClass('show'); // Or slideDown() if needed
        }
        // ==============================================================================================PIOM=========================================================================================================================
    </script>

