        function UploadIOMAttachment(input) {
            $("#txtIOMDesc").removeClass('validationError');
            if($("#txtIOMDesc").val().trim() == ""){
                $("#txtIOMDesc").addClass('validationError');
                sweetAlert(" ", "Description is mandatory field !", "warning");
                $("#txtIOMFile").val('');
                return;

            }

            var _URL = window.URL || window.webkitURL;
            var file = input.files[0];
            var extension = $(input).val().split('.').pop().toLowerCase();
            var validFileExtensions = ['pdf'];
            if ($.inArray(extension, validFileExtensions) == -1) {
                var _msg = "Sorry! Upload only 'pdf' file";
                sweetAlert(" ", _msg, "warning");
                $(input).replaceWith($(input).val('').clone(true));
                return;
            }
            if (file.size > (5e+6)) {
                sweetAlert(" ", "Sorry! Max allowed file size is 5 mb", "warning");
                $(input).replaceWith($(input).val('').clone(true));
                return;
            }

            var formData = new FormData();
            formData.append("FILE", document.getElementById("txtIOMFile").files[0]);
            formData.append("DOC_TYPE", "IOM");
            formData.append("IOMDESC", $("#txtIOMDesc").val());
            formData.append("ADDITIONAL_INFO", "");
            formData.append("IOMHEADERID", $("#hfIOMHeaderId").val());
            /* ============================================================================================================== PIOM ================================================================================================ */
