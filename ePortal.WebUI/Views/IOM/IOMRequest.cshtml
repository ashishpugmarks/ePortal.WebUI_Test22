        function CheckParallelFormValidation() {
            $('#div_valid_msg').addClass('hidden');
            var isValid = true;
            var validationMsg = "";

            // Remove previous validation errors
            $("#txtIOMDesc").removeClass('validationError');
            $("#txtIOMFile").removeClass('validationError');
            $("#ddCategory").removeClass('validationError');

            // Check description
            var desc = $('#txtIOMDesc').val().trim();
            if (desc === "") {
                $("#txtIOMDesc").addClass('validationError');
                isValid = false;
                validationMsg += "Description is mandatory. ";
            } else {
                var specialCharactersPattern = /[!\"#$%&'()*+\/:;<=>?@@[\\]^_`{|}~]/;
                if (specialCharactersPattern.test(desc)) {
                    $("#txtIOMDesc").addClass('validationError');
                    isValid = false;
                    validationMsg += "Special characters not allowed in description. ";
                }
            }

            // Check file
            if ($('#txtIOMFile').val() === "" && $("#hfIOMAttachment").val() === "") {
                $("#txtIOMFile").addClass('validationError');
                isValid = false;
                validationMsg += "IOM Attachment is mandatory. ";
            }

            // Check if at least 1 stage exists
            var stages = gatherApprovalData();
            if (stages.length === 0) {
                isValid = false;
                validationMsg += "Please add at least one stage with approvers. ";
            } else {
                // Validate approvers inside each stage/group
                stages.forEach(function (stage, si) {
                    if (stage.ParallelGroups.length === 0) {
                        isValid = false;
                        validationMsg += "Stage " + (si + 1) + " has no approval group. ";
                    } else {
                        stage.ParallelGroups.forEach(function (grp, gi) {
                            if (grp.Approvers.length === 0) {
                                isValid = false;
                                validationMsg += "Stage " + (si + 1) + ", Group " + (gi + 1) + " has no approver. ";
                            }
                        });
                    }
                });
            }

            // Show validation message with alert or sweetAlert
            if (!isValid) {
                sweetAlert("", validationMsg.trim(), "warning");
                // Or use regular alert if sweetAlert is not available:
                // alert(validationMsg.trim());
            }

            return isValid;
        }

