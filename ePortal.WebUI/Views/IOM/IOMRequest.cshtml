            @*<div class="form-group">
                    @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-4 text-right" })
                    <div class="col-md-6">
                        @Html.TextAreaFor(model => model.Remark, new { @id = "txtRemark", @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                    </div>
