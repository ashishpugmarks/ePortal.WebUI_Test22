        function submitPIOMForm() {

            var iomDesc = $("#txtIOMDesc").val().trim();
            var iomId = $("#hfIOMHeaderId").val();
            var appType = $("input[name='rdbFO']:checked").val();
            var stages = gatherApprovalData();

            if (!iomDesc) {
