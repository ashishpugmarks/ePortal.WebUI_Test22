            $.ajax({
                type: "POST",
                url: "/PIOM/PIOMRequest",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                    $("#btnSave").attr("disabled", true);
                    $("#btnPreview").attr("disabled", true);
                },
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        swal({
                            title: "",
