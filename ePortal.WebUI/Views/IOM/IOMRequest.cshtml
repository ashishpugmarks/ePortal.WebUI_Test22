<div id="ajaxLoader"></div>

@section Scripts{
    <script src="~/js/jquery-ui.js"></script>
    @* //Added by TTL on 28th Oct 2025 against SR109889 > CR7269 - Start *@
    <script src="~/lib/bootstrap/js/bootstrap-tagsinput.js"></script>
    @* //Added by TTL on 28th Oct 2025 against SR109889 > CR7269 - End *@
    <script nonce="@Context.Items["ScriptNonce_3"]">

        var arrayList = new Array, attachmentArray = new Array, tmpHeaderArray = new Array, mainHeaderArray = new Array, TotalRowCount = 0, IsUploadAttachment = false, desig = "", PRAttachmentArray = new Array;

        /* ============================================================================================================== PIOM ================================================================================================ */

        var currentStageCount = 0;
        var parallelGroupCount = {};
        var parallelStages = [];

        $(document).ready(function () {
            // #region ParallelApprovalSection
            // Move Up button click
            $(document).on('click', '.triangle-up', function () {
                var row = $(this).closest('tr');
                var prev = row.prev('.tr-auth');
                if (prev.length) {
                    row.insertBefore(prev);
                    renumberRows(row.closest('tbody'));
                    updateApproverOrder(row.closest('tbody'));
                }
            });

            // Move Down button click
            $(document).on('click', '.triangle-down', function () {
                var row = $(this).closest('tr');
                var next = row.next('.tr-auth');
                if (next.length) {
                    row.insertAfter(next);
                    renumberRows(row.closest('tbody'));
                    updateApproverOrder(row.closest('tbody'));
                }
            });

            // Re-number Sr No. column
            function renumberRows(tbody) {
                tbody.find('tr.tr-auth').each(function (index) {
                    $(this).find('td').eq(0).text(index + 1);
                });
            }

            // Update in-memory order (optional, same as before)
            function updateApproverOrder(tbody) {
                var ids = tbody.attr('id').split('_');
                var stageIdx = parseInt(ids[1]);
                var groupIdx = parseInt(ids[2]);

                var approvers = [];
                tbody.find('tr.tr-auth').each(function (index) {
                    var tr = $(this);
                    approvers.push({
                        ADEMPCODE: parseInt(tr.find('td').eq(2).text().trim()),
                        APP_SEQ: index + 1
                    });
                });

                if (parallelStages[stageIdx] && parallelStages[stageIdx][groupIdx]) {
                    var group = parallelStages[stageIdx][groupIdx];
                    if (group.Approvers) {
                        group.Approvers.forEach(a => {
                            var match = approvers.find(x => x.ADEMPCODE === a.ADEMPCODE);
                            if (match) a.APP_SEQ = match.APP_SEQ;
                        });
                    }
                }

                console.log("Order updated:", approvers);
            }



            // Add Stage
            $('#btnOStage').on('click', function () {
                var stageName = $('#txtStageName').val().trim();
                if (stageName === '') {
                    sweetAlert("", "Please enter a stage name", "warning");
                    return;
                }

                var isDuplicateStage = false;
                $('#stageContainer .stage-box').each(function () {
                    var existingStageName = $(this).find('.panel-heading h4').text().split(':').slice(1).join(':').trim().toLowerCase();
                    if (existingStageName === stageName.toLowerCase()) {
                        isDuplicateStage = true;
                        return false; // break loop
                    }
                });

                if (isDuplicateStage) {
                    sweetAlert("", "Stage name must be unique. '" + stageName + "' already exists.", "warning");
                    return;
                }

                // Validate previous stage (if any)
                if (currentStageCount > 0) {
                    var prevStageIdx = currentStageCount - 1;
                    var prevStageDiv = $('#stageBox_' + prevStageIdx);

                    // Check if at least one approval group exists in prev stage
                    var groupBlocks = prevStageDiv.find('.approval-group-block');
                    if (groupBlocks.length === 0) {
                        sweetAlert("", "Please add at least one approval group with approvers in the previous stage before adding a new stage.", "warning");
                        return;
                    }

                    // Check if each group has at least one approver
                    var isValid = true;
                    groupBlocks.each(function () {
                        var approvers = $(this).find('tbody tr.tr-auth');
                        if (approvers.length === 0) {
                            isValid = false;
                            return false; // break loop
                        }
                    });
                    if (!isValid) {
                        sweetAlert("", "Each approval group in the previous stage must have at least one approver.", "warning");
                        return;
                    }
                }

                // If validation passed, add new stage
                addStage(stageName);
                $('#txtStageName').val('');
            });

            $(document).on('click', '.delete-stage-btn', function () {
                var stageIdx = $(this).data('stage');
                $('#stageBox_' + stageIdx).remove();

                parallelStages[stageIdx] = undefined;
                parallelGroupCount[stageIdx] = undefined;

                // Decrement currentStageCount if applicable
                if (currentStageCount > 0) {
                    currentStageCount--;
                }

                reindexStages();
            });

            $(document).on('click', '.delete-group-btn', function () {
                var stageIdx = $(this).data('stage');
                var pgIdx = $(this).data('group');

                $('#approvalGroupBox_' + stageIdx + '_' + pgIdx).remove();

                // Remove group data from arrays
                if (parallelStages[stageIdx]) parallelStages[stageIdx][pgIdx] = undefined;

                // Decrement parallelGroupCount for the stage
                if (parallelGroupCount[stageIdx] > 0) {
                    parallelGroupCount[stageIdx]--;
                }

                // Optional: Re-index remaining groups' UI and data attributes for consistency
                reindexGroups(stageIdx);
            });


            // Add Approval Group
            $(document).on('click', '.add-approval-btn', function () {
                var stageIdx = $(this).data('stage');
                var groupCount = parallelGroupCount[stageIdx];

                // If there is at least one group already, check if it has at least one approver
                if (groupCount > 0) {
                    var lastGroupTbody = $('#approvalBody_' + stageIdx + '_' + (groupCount - 1));
                    var approversCount = lastGroupTbody.find('tr.tr-auth').length;
                    if (approversCount === 0) {
                        sweetAlert("", "Please add at least one approver in the current group before adding a new group.", "warning");
                        return;
                    }
                }

                var inputBox = $(this).closest('.form-group').find('.txtParallelGroupName');
                var groupName = inputBox.val();
                if (!groupName || groupName.trim() === '') {
                    sweetAlert("", "Please enter approval group name", "warning");
                    return;
                }
                groupName = groupName.trim();

                // Check for duplicate group name within the current stage (case insensitive)
                var isDuplicateGroup = false;
                $('#parallelGroupsContainer_' + stageIdx).find('.approval-group-block h5').each(function () {
                    var existingGroupName = $(this).text().replace('Approval Group: ', '').trim().toLowerCase();
                    if (existingGroupName === groupName.toLowerCase()) {
                        isDuplicateGroup = true;
                        return false; // break loop
                    }
                });
                if (isDuplicateGroup) {
                    sweetAlert("", "Approval group name must be unique within the stage. '" + groupName + "' already exists.", "warning");
                    return;
                }

                // If validation passed, add the new approval group
                var html = getApprovalGroupHtml(stageIdx, groupCount, groupName);
                $('#parallelGroupsContainer_' + stageIdx).prepend(html);
                bindEmployeeAutocomplete(stageIdx, groupCount);

                parallelGroupCount[stageIdx]++;
                inputBox.val(''); // clear input after adding
            });

            // Add Approver
            $(document).on('click', '.add-approver-btn', function () {
                var stageIdx = $(this).data('stage');
                var pgIdx = $(this).data('group');
                var tbody = $('#approvalBody_' + stageIdx + '_' + pgIdx);

                var header = $('#txtHeader_' + stageIdx + '_' + pgIdx).val().trim();
                var empCode = $('#txtEmpcode_' + stageIdx + '_' + pgIdx).val().trim();

                if (header === '' || empCode === '') {
                    alert('Please enter both Header and Employee Code');
                    return;
                }

                var _ecode = parseInt(empCode.split("-")[0].trim());

                // First, check duplicate within same group (existing logic)
                var isDuplicateInGroup = false;
                tbody.find('tr.tr-auth').each(function () {
                    var existingEmpCode = parseInt($(this).find('td').eq(2).text().trim());
                    if (existingEmpCode === _ecode) {
                        isDuplicateInGroup = true;
                        return false;
                    }
                });

                if (isDuplicateInGroup) {
                    $('#txtEmpcode_' + stageIdx + '_' + pgIdx).addClass('validationError');
                    $('#spn_stage_msg_' + stageIdx + '_' + pgIdx).text('This approval authority is already added in this group.');
                    return;
                }

                // New: Check duplicate across ALL stages and groups
                var isGlobalDuplicate = false;
                $('#stageContainer .stage-box').each(function () {
                    var currentStageDiv = $(this);
                    currentStageDiv.find('.approval-group-block').each(function () {
                        var currentGroupTbody = $(this).find('tbody');
                        currentGroupTbody.find('tr.tr-auth').each(function () {
                            var existingEmpCode = parseInt($(this).find('td').eq(2).text().trim());
                            if (existingEmpCode === _ecode) {
                                isGlobalDuplicate = true;
                                return false; // Break inner each
                            }
                        });
                        if (isGlobalDuplicate) return false; // Break group each
                    });
                    if (isGlobalDuplicate) return false; // Break stage each
                });

                if (isGlobalDuplicate) {
                    $('#txtEmpcode_' + stageIdx + '_' + pgIdx).addClass('validationError');
                    $('#spn_stage_msg_' + stageIdx + '_' + pgIdx).text('This approval authority is already added in another stage or group. Cannot add duplicate.');
                    return;
                }

                // Call your API (rest remains same)
                $.ajax({
                    type: "GET",
                    url: "/IOM/GetAppAuthority",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: {
                        eCode: empCode,
                        headerId: header,
                        header: header
                    },
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        if (data && data.ECODE > 0 && data.ENAME !== "") {
                            $('#spn_stage_msg_' + stageIdx + '_' + pgIdx).text('');
                            $('#txtEmpcode_' + stageIdx + '_' + pgIdx).removeClass('validationError');
                            // Append single row to this group's tbody
                            var rowId = tbody.find("tr").length;
                            if (tbody.find("td").first().text() === "No record found.") {
                                tbody.empty(); // remove placeholder row
                                rowId = 0;
                            }
                            rowId++;

                            var empDesignation = "";
                            if (data.SEQ_LIST && data.SEQ_LIST.length > 0) {
                                var emp = data.SEQ_LIST.find(x => x.ADEMPCODE == data.ECODE);
                                if (emp && emp.ADDESIGNATION) empDesignation = emp.ADDESIGNATION;
                            }

                            var row = `
                             <tr class='tr-auth'>
                                 <td class='text-center'>${rowId}</td>
                                 <td class='text-center'>${header}</td>
                                 <td class='text-center'>${data.ECODE}</td>
                                 <td class='text-left'>
                                     <input type='hidden' value='${data.APP_SEQ}'>
                                     ${data.ENAME}
                                 </td>
                                 <td class='text-center'>
                                     <input type='hidden' value='${data.APP_SEQ}'>
                                     ${empDesignation} <!-- fallback from SEQ_LIST -->
                                 </td>
                                 <td class='text-center action-btn'>

                                     <a style='cursor:pointer;'  data-ctrl='deleteitem'>
                                           <svg xmlns="http://www.w3.org/2000/svg" width="17px" height="17px" viewBox="0 0 24 24" fill="none">
                                           <path d="M10 12V17" stroke="#d9534f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                           <path d="M14 12V17" stroke="#d9534f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                           <path d="M4 7H20" stroke="#d9534f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                           <path d="M6 10V18C6 19.6569 7.34315 21 9 21H15C16.6569 21 18 19.6569 18 18V10" stroke="#d9534f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                           <path d="M9 5C9 3.89543 9.89543 3 11 3H13C14.1046 3 15 3.89543 15 5V7H9V5Z" stroke="#d9534f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                           </svg>
                                   </a>
                                      <button type="button" class="btn btn-sm btn-transparent btn-move" title="Reorder">
                                          <span class="triangle-up"></span>
                                          <span class="triangle-down"></span>
                                      </button>
                                 </td>
                             </tr>`;

                            tbody.append(row);

                            // Attach delete event
                            tbody.find("[data-ctrl='deleteitem']").off("click").on("click", function () {
                                $(this).closest("tr").remove();
                            });

                            // Clear inputs
                            $('#txtHeader_' + stageIdx + '_' + pgIdx).val('');
                            $('#txtEmpcode_' + stageIdx + '_' + pgIdx).val('');
                            $('#hdnEmpName_' + stageIdx + '_' + pgIdx).val('');
                            $('#hdnEmpDesig_' + stageIdx + '_' + pgIdx).val('');
                        } else {
                            console.log('Record not found condition hit');
                            $('#spn_stage_msg_' + stageIdx + '_' + pgIdx).text('Record not found.');
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            });
            // #endregion
        });

        // #region ParallelApprovalSection

        function reindexStages() {
            var stages = $('#stageContainer').children('.stage-box');
            currentStageCount = stages.length;

            stages.each(function (newStageIdx) {
                var stageDiv = $(this);
                stageDiv.attr('id', 'stageBox_' + newStageIdx);
                stageDiv.find('.panel-heading h4').html(`Stage ${newStageIdx + 1}:` + stageDiv.find('.panel-heading h4').text().split(':').slice(1).join(':'));
                stageDiv.find('.add-approval-btn').attr('data-stage', newStageIdx);
                stageDiv.find('.delete-stage-btn').attr('data-stage', newStageIdx);
                stageDiv.find('.txtParallelGroupName').closest('.form-group').find('.add-approval-btn').attr('data-stage', newStageIdx);
                stageDiv.find('#parallelGroupsContainer_' + (newStageIdx + 1)).attr('id', 'parallelGroupsContainer_' + newStageIdx);

                // Also reindex groups in that stage
                reindexGroups(newStageIdx);
            });
        }

        function reindexGroups(stageIdx) {
            var groupsContainer = $('#parallelGroupsContainer_' + stageIdx);
            var groups = groupsContainer.children('.approval-group-block');
            parallelGroupCount[stageIdx] = groups.length;

            groups.each(function (newPgIdx) {
                var groupDiv = $(this);

                // Update id attribute
                groupDiv.attr('id', 'approvalGroupBox_' + stageIdx + '_' + newPgIdx);
                groupDiv.attr('data-group', newPgIdx);

                // Update internal button data-group attributes
                groupDiv.find('.add-approver-btn').attr('data-group', newPgIdx);
                groupDiv.find('.delete-group-btn').attr('data-group', newPgIdx);

                // Update input ids
                groupDiv.find('.header-input').attr('id', `txtHeader_${stageIdx}_${newPgIdx}`);
                groupDiv.find('.empcode-input').attr('id', `txtEmpcode_${stageIdx}_${newPgIdx}`);
                groupDiv.find('input[type=hidden][id^=hdnEmpName_]').attr('id', `hdnEmpName_${stageIdx}_${newPgIdx}`);
                groupDiv.find('input[type=hidden][id^=hdnEmpDesig_]').attr('id', `hdnEmpDesig_${stageIdx}_${newPgIdx}`);

                // Update table and tbody ids
                groupDiv.find('table').attr('id', `approvalTable_${stageIdx}_${newPgIdx}`);
                groupDiv.find('tbody').attr('id', `approvalBody_${stageIdx}_${newPgIdx}`);

                // Re-index row serial numbers inside tbody if needed
                groupDiv.find('tbody tr.tr-auth').each(function (idx) {
                    $(this).find('td').eq(0).text(idx + 1);
                });

                // Re-bind employee autocomplete for this group's employee code input
                bindEmployeeAutocomplete(stageIdx, newPgIdx);
            });
        }

        // Add Stage function
        function addStage(stageName) {
            var stageIdx = currentStageCount;

            var html = `
             <div class="panel panel-default stage-box" id="stageBox_${stageIdx}" style="margin-bottom:15px; border:1px solid #ddd; padding:10px; border-radius:5px;">
                 <div class="panel-heading parallel" style="cursor:pointer;">
                     <h4 style="display:inline-block;" onclick="$('#stageBody_${stageIdx}').slideToggle();">
                         Stage : ${stageName}
                     </h4>
                     <button type="button" class="btn btn-danger btn-sm delete-stage-btn" data-stage="${stageIdx}">Delete Stage</button>
                 </div>
                 <div class="form-group row gap-box">
                     <div class="col-md-6 padding-remove">
                         <input type="text" class="form-control txtParallelGroupName" placeholder="Enter Approval Group Name" />
                     </div>
                     <div class="col-md-2 padding-remove">
                         <input type="button" class="btn btn-primary add-approval-btn" data-stage="${stageIdx}" value="Add Approval Group" />
                     </div>
                 </div>
                 <div id="parallelGroupsContainer_${stageIdx}" style="margin-top:10px;"></div>
             </div>`;

            $('#stageContainer').prepend(html);
            parallelStages[stageIdx] = [];
            parallelGroupCount[stageIdx] = 0;
            currentStageCount++;
        }

        function gatherApprovalData() {
            var stages = [];

            var stageCounter = 0;
            var groupCounter = 0;
            var headerCounter = 0;
            var approverCounter = 0;
            var stageBoxes = $('#stageContainer .stage-box').toArray().reverse();
            $(stageBoxes).each(function (stageIndex) {
                var stageDiv = $(this);
                var stageName = stageDiv.find('.panel-heading h4')
                    .text().split(':').slice(1).join(':').trim();

                var stageObj = {
                    StageID: stageCounter++,
                    StageName: stageName,
                    StageOrder: stageIndex,
                    STATUS: 1,
                    ParallelGroups: []
                };
                var groupBlocks = stageDiv.find('.approval-group-block').toArray().reverse();

                $(groupBlocks).each(function (correctGroupOrder) {
                    var groupDiv = $(this);
                    var groupName = groupDiv.find('h5')
                        .text().replace('Approval Group: ', '').trim();

                    var headers = [];
                    groupDiv.find('.header-input').each(function (headerIndex) {
                        var headerVal = $(this).val().trim();
                        if (headerVal) {
                            headers.push({
                                IOMAPPHEADERID: headerCounter++,
                                IOMHEADERID: 0,
                                IOMAPPHEADER: headerVal,
                                APPHEADERDESC: '',
                                STATUS: 1,
                                Seq_Order: headerIndex,
                                ADDEDBY: 0,
                                ADDEDDATE: new Date().toISOString(),
                                UPDATEBY: null,
                                UPDATEDATE: null
                            });
                        }
                    });

                    var groupObj = {
                        ParallelGroupID: groupCounter++,
                        GroupName: groupName,
                        GroupOrder: correctGroupOrder,
                        STATUS: 1,
                        Headers: headers,
                        Approvers: []
                    };

                    groupDiv.find('tbody tr.tr-auth').each(function (approverIndex) {
                        var tr = $(this);
                        groupObj.Approvers.push({
                            IOMAPPAUTH_ID: approverCounter++,
                            IOMID: 0,
                            ADEMPCODE: parseInt(tr.find('td').eq(2).text().trim()),
                            ADEMPNAME: tr.find('td').eq(3).text().trim(),
                            ADDESIGNATION: tr.find('td').eq(4).text().trim(),
                            Header: tr.find('td').eq(1).text().trim(),
                            APP_SEQ: approverIndex,
                            STATUS: 1,
                            APPTYPE: 0,
                            ADDEDBY: 0,
                            ADDEDDATE: new Date().toISOString(),
                            UPDATEBY: null,
                            UPDATEDATE: null,
                            FNDESID: 0
                        });
                    });

                    stageObj.ParallelGroups.push(groupObj);
                });

                stages.push(stageObj);
            });

            return stages;
        }




