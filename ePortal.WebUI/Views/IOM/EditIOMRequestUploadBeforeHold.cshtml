            $('input[name="rdbFO"]').on('change', function () {
                rdbOnchange($(this)[0]);
            });
            $('#txtFile').on('change', function () {
                readBackupFile($(this)[0]);
            });
            $('#btnPreview').on('click', function () {
                submitForm();
            });
            $('#btnCancel').on('click', function () {
                Cancel();
            });
            $('#btnUpload').on('click', function () {
                UploadAttachment();
            });
            $('#ancGetIOMPdf').on('click', function () {
                GetIOMPDF($(this)[0]);
            });
        });
    </script>
