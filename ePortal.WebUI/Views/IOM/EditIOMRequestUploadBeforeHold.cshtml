        }
        /*basic reset*/

        /** {
                    margin: 0;
                    padding: 0;
                }

                html {
                    height: 100%;
                    background: white;
                    background: -webkit-linear-gradient(to left, #6441A5, #2a0845);
                }

                body {
                    font-family: montserrat, arial, verdana;
                    background: transparent;
                }*/

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .panel-heading {
            padding: 8px 15px;
        }

        #iom_div {
            border: 1px solid #ccc;
            padding: 8px; /*15px 0px 15px 0px;*/
            margin-left: 10px;
            border-radius: 5px;
            background-color: #eee;
