            background-color: antiquewhite;
            margin-left: 15px;
            margin-right: 15px;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .required::after {
            content: "*";
            font-weight: 800;
            color: red;
            margin-left: 5px;
        }


        .ui-widget {
            font-family: Verdana,Arial,sans-serif;
            font-size: 0.6em !important;
            overflow: auto;
            max-height: 150px;
        }
    </style>

}

    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Approval Note : Upload Document for Hold Request</div>
        </div>

        <div class="body-content" style="overflow-x:hidden">
            <div id="div_valid_msg" class="form-group hidden alert alert-error text-left">
                <span id="spn_valid_msg" style="color:#a94442;"></span>
            </div>

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="panel-group">
                    <div class="panel panel-primary hidden">
                        <div class="panel-heading">
                            <h2 class="panel-title">
                                <strong>Request Detail</strong>
                            </h2>
                        </div>
                        <div class="panel-body">
                            <div class="form-group">
                                <div class="col-md-7 col-lg-7">
                                    @Html.HiddenFor(model => model.IOMHEADERID, new { @id = "hfIomHeaderId" })
                                    @Html.LabelFor(model => model.IOMDesc, htmlAttributes: new { @class = "control-label col-md-3 required" })
                                    <div class="col-md-9">
                                        @Html.TextAreaFor(model => model.IOMDesc, new { @class = "form-control", @id = "txtIOMDesc",@readonly=true })
                                        @Html.ValidationMessageFor(model => model.IOMDesc, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-5 col-lg-5">
                                    @Html.LabelFor(model => model.IOMCATMSTID, htmlAttributes: new { @class = "control-label col-md-4 required" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.IOMCATMSTID, new SelectList(ViewBag.CategoryList.Items, "IOMCATMSTID", "CATDESC"), "- Select -", new { @id = "ddCategory", @class = "form-control" , @readonly = true })
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-7 col-lg-7">
                                    @Html.LabelFor(model => model.IOMATTACHMENT, htmlAttributes: new { @class = "control-label col-md-3 required" })
                                    <div class="col-md-9" style="margin-top: 9px;">    
                                        @Html.ValidationMessageFor(model => model.IOMFile, "", new { @class = "text-danger" })
                                        @{
                                            var _fileName = Model.iomDetail.Where(x => x.DOC_TYPE == "IOM").Select(s => s.FILENAME).FirstOrDefault();
                                            <a style="cursor: pointer;" id="ancGetIOMPdf" title="Click to view IOM attachment." data-id="@_fileName">@_fileName</a>
                                            <input type="hidden" id="hfIOMAttachment" value="@_fileName" />
                                        }
                                    </div>
                                </div>
                                <div class="col-md-5 col-lg-5">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel-group">
                    <div class="panel panel-primary">
                        <div class="panel-heading">
                            <h2 class="panel-title">
                                <strong>Documents Detail</strong>
                            </h2>
                        </div>
                        <div class="panel-body">
                            <div class="form-group">
                                <div class="col-md-2 col-sm-3 col-xs-3 text-right">
                                    @Html.LabelFor(model => model.iomDetail[0].DOC_TYPE, htmlAttributes: new { @class = "control-label required", @style = "margin-top: 8px;" })
                                </div>
                                <div class="col-md-2 col-sm-4 col-xs-5">
                                    <select class="form-control" id="ddDocType">
                                        <option value="">-Select-</option>
                                        <option value="SupportingDocument">Supporting Document</option>
                                        <option value="Other">Other Document</option>
                                    </select>
                                </div>
                                <div class="col-md-2 col-sm-3 col-xs-3 text-right">
                                    @Html.LabelFor(model => model.iomDetail[0].FILENAME, htmlAttributes: new { @class = "control-label required", @style = "margin-top: 8px;" })
                                </div>
                                <div class="col-md-5 col-sm-5 col-xs-6">
                                    <input type="file" name="AttFile" class="form-control" id="txtFile" />
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-2 col-sm-3 col-xs-4 text-right">
                                    @Html.LabelFor(model => model.iomDetail[0].ADDITIONAL_INFO, htmlAttributes: new { @class = "control-label", @style = "margin-top: 8px;" })
                                </div>
                                <div class="col-md-9 col-sm-9 col-xs-8">
                                    @Html.TextArea("ADDITIONAL_INFO", new { @id = "txtAddInfo", @class = "form-control", @style = "height:40px!important;" })
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6 col-sm-6 col-xs-6 text-right">
                                    <input type="button" class="btn btn-primary btn-sm" value="Add Document" id="btnUpload" />
                                </div>
                                <div class="col-md-6 col-sm-6 col-xs-6 text-left" style="margin-top:6px;">
                                    <span id="span-attachmentMsg" style="font-weight:600;"></span>
                                </div>
                            </div>

                            <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                                <thead>
                                    <tr class="bg-info">
                                        <th class="text-center">SNo.</th>
                                        <th class="text-center">Document Type</th>
                                        <th style="width:35%;" colspan="2">Attachment</th>
                                        <th width="20%">Additional Info</th>
                                        <th width="20%" class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="append_docRow">
                                    <tr><th colspan="6" class="text-center">No record found.</th></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="panel-group">
                    <div class="panel panel-primary hidden">
                        <div class="panel-heading">
                            <h2 class="panel-title">
                                <strong>Approval Authority</strong>&nbsp;&nbsp;&nbsp;&nbsp;
                                @{string str1 = "", str2 = ""; string strdivfxhdn = "", strdivothhdn = ""; }
                                @if (Model.APP_TYPE == 1) { str1 = "checked=checked"; strdivothhdn = "hidden"; } else { str2 = "checked=checked"; strdivfxhdn = "hidden"; }
                                <div class="hidden"><input type="radio" name="rdbFO" value="1" @str1 /> Company Defined Authority &nbsp; <input type="radio" name="rdbFO" value="2" @str2 />&nbsp; Other</div>
                            </h2>
                        </div>
                        <div class="panel-body">
                           
                            <table class="table table-bordered table-responsive" id="mytable" style="margin-bottom: 0px!important;">
                                <thead>
                                    <tr class="bg-info">
                                        <th class="text-center">SNo.</th>
                                        <th class="text-center">Header</th>
                                        <th class="text-center">Emp Code</th>
                                        <th>Employee Name</th>
                                        <th class="text-center">Designation</th>
                                        <th class="text-center hidden" colspan="2" width="6%;">Move Seq</th>
                                       
                                    </tr>
                                </thead>
                                <tbody id="append_row">
                                    <tr><th colspan="6" class="text-center">No record found.</th></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

               

                <div class="form-group text-center">
                    <input type="button" class="cancel btn btn-dark" value="Cancel" id="btnCancel" />
                    <input type="button" value="Submit" class="btn btn-success" id="btnPreview" />
                </div>
            </div>
        </div>
    </div>

    <div id="myCreateModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="padding:10px!important;">
                    <div class="pull-left">
                        <h5 class="modal-title"><span id="sp_type"></span></h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body" style="padding:10px!important;">
                    <div id="myCreateModelContent">

                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="ajaxLoader"></div>

@section Scripts{
    <script src="~/js/jquery-ui.js"></script>
    <script nonce="@Context.Items["ScriptNonce_3"]">
        var arrayList = new Array, attachmentArray = new Array, tmpHeaderArray = new Array, mainHeaderArray = new Array,  TotalRowCount = 0, IsUploadAttachment = false;
        $('.homeContent').removeClass('homeContent');

        $(document).ready(function () {
            BindDocument(attachmentArray);
            BindData(arrayList);


            $('input[type=number]').keyup(function () {
                this.value = this.value.replace(/[^0-9\.]/g, '');
            });


            $('#txtIOMDesc').on('keypress input', function (event) {


                const asciiValue = event.key.charCodeAt(0);


                if( asciiValue === 33 || asciiValue === 34 || asciiValue === 35 || asciiValue === 36 || asciiValue === 37 || asciiValue === 38
                     || asciiValue === 39 || asciiValue === 40 || asciiValue === 41 || asciiValue === 42 || asciiValue === 43 || asciiValue === 47
                     || asciiValue === 58 || asciiValue === 59 || asciiValue === 60 || asciiValue === 61 || asciiValue === 62 || asciiValue === 63
                     || asciiValue === 64 || asciiValue === 91 || asciiValue === 92 || asciiValue === 93 || asciiValue === 94 || asciiValue === 95
                     || asciiValue === 96 || asciiValue === 123 || asciiValue === 124 || asciiValue === 125 || asciiValue === 126 ) {

                   alert("Special characters are not allowed in IOM Desc.");
                   event.preventDefault();
                }

            });



            $('#txtAddInfo').on('keypress input', function (event) {

                const asciiValue = event.key.charCodeAt(0);


                if( asciiValue === 33 || asciiValue === 34 || asciiValue === 35 || asciiValue === 36 || asciiValue === 37 || asciiValue === 38
                       || asciiValue === 39 || asciiValue === 40 || asciiValue === 41 || asciiValue === 42 || asciiValue === 43 || asciiValue === 47
                       || asciiValue === 58 || asciiValue === 59 || asciiValue === 60 || asciiValue === 61 || asciiValue === 62 || asciiValue === 63
                       || asciiValue === 64 || asciiValue === 91 || asciiValue === 92 || asciiValue === 93 || asciiValue === 94 || asciiValue === 95
                       || asciiValue === 96 || asciiValue === 123 || asciiValue === 124 || asciiValue === 125 || asciiValue === 126 ) {

                    alert("Special characters are not allowed in IOM Desc.");
                    event.preventDefault();
                }

            });



        });

        function readBackupFile(input) {
            var _URL = window.URL || window.webkitURL;
            var file = input.files[0];
            var image = new Image();
            image.src = _URL.createObjectURL(file);
            var extension = $(input).val().split('.').pop().toLowerCase();
            var validFileExtensions = ['pdf', 'doc', 'docx', 'xls', 'xlsx', 'csv', 'ppt', 'pptx', 'png', 'jpg', 'jpeg'];
            if ($.inArray(extension, validFileExtensions) == -1) {
                var _msg = "Sorry! Upload only 'pdf', 'doc', 'docx', 'xls', 'xlsx', 'csv', 'ppt', 'pptx', 'png', 'jpg', 'jpeg' files";
                sweetAlert(" ", _msg, "warning");
                $(input).replaceWith($(input).val('').clone(true));
                IsUploadAttachment = false;
                return false;
            }
            if (file.size > (5e+6)) {
                sweetAlert(" ", "Sorry! Max allowed file size is 5 mb", "warning");
                $(input).replaceWith($(input).val('').clone(true));
                IsUploadAttachment = false;
                return false;
            }

        }

        function CheckAttachmentsValidation() {
            var isVailed = true;
            $('#txtFile').removeClass('validationError');
            if ($('#txtFile').val() == "") {
                $('#txtFile').addClass('validationError');
                isVailed = false;
            }

            $("#ddDocType").removeClass('validationError');
            if ($('#ddDocType').val() == "") {
                $("#ddDocType").addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }

        function UploadAttachment() {

            debugger;
            var IsAttachmentsValidation = CheckAttachmentsValidation();
            if (!IsAttachmentsValidation) {
                return;
            }


            if($("#txtAddInfo").val().trim() != ""){
                var specialCharactersPattern = /[!\"#$%&'()*+\/:;<=>?@@[\\\]^_`{|}~]/;
                var specialCharactersRegex = new RegExp(specialCharactersPattern);
                if (specialCharactersRegex.test($('#txtAddInfo').val())) {
                    sweetAlert(" ", "Special characters are not allowed in additional Info.", "warning");
                    return;
                }
            }


            $("#btnUpload").attr("disabled", true);
            var txtAddInfo = "Hold justification document: " + $("#txtAddInfo").val();
            var formData = new FormData();
            formData.append("FILE", document.getElementById("txtFile").files[0]);
            formData.append("DOC_TYPE", $("#ddDocType").val());
            formData.append("ADDITIONAL_INFO", txtAddInfo);
            formData.append("IOMHEADERID", $("#hfIomHeaderId").val());
            $.ajax({
                type: "POST",
                url: "/IOM/UploadAttachment",
                data: formData,
                datatype: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.res == 1) {


                        attachmentArray = data.attachmentList;
                        if(attachmentArray != null){
                            if (attachmentArray.length > 0) {
                                //BindDocument(attachmentArray);
                                window.location.reload();
                            }

                            $("#span-attachmentMsg").text('Attachment uploaded successfully. ').css('color', 'green').show().delay(5000).fadeOut();
                            IsUploadAttachment = true;
                            $("#txtFile").val('');
                            $("#ddDocType").val('');
                            $("#txtAddInfo").val('');
                        }
                    }
                    else if (data.res == 0 || data.res == -1) {
                        $("#span-attachmentMsg").text('Attachment not uploaded, Please try again. ').css('color', '#a94442').show().delay(5000).fadeOut();
                    }
                    $("#btnUpload").attr("disabled", false);
                },
                error: function () {
                    $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                    $("#btnUpload").attr("disabled", false);
                }
            });
        }

        function BindDocument(attList) {
            var rows = "", rowId = 0;

            console.log(arrayList);
            console.log(attList);
            if (attList != null) {
                if (attList.length > 0) {
                    $.each(attList, function (i, item) {
                        rowId = i + 1;
                        var additionalInfo = item.ADDITIONAL_INFO == null ? "":item.ADDITIONAL_INFO;
                        rows += "<tr class='tr_doc'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.DOC_TYPE + "</td>"
                        rows += "<td class='text-left'><a style='cursor: pointer;' data-id='"+ item.FILENAME +"' data-ctrl='getpdf'>" + item.FILENAME + "</a></td>"

                        rows += "<td class='text-center' style='color:#a94442'>Not Verified</td>"

                        rows += "<td class='text-left'>" + additionalInfo + "</td>"

                        rows += "<td class='text-center'><a data-name='" + item.FILENAME + "' data-type='" + item.DOC_TYPE + "' data-id='" + item.IOMHEADERID + "' style='cursor: pointer;' data-ctrl='deletedoc'>Delete</a></td>"



                        rows += "</tr>"
                    });
                    document.getElementById("append_docRow").innerHTML = rows;
                }
                else{
                    var _row = "<tr><th colspan='6' class='text-center'>No record found.</th></tr>"
                    document.getElementById("append_docRow").innerHTML = _row;
                }

                //CSP 3.0 Compliant Changes
                if (rowId > 0) {
                    $("[data-ctrl='deletedoc']").on('click', function () {
                        DeleteDoc($(this)[0]);
                    });
                    $("[data-ctrl='getpdf']").on('click', function () {
                        GetPDF($(this)[0]);
                    });
                }
            }
        }

        function GetPDF(current) {
            var _pdfName = $(current).attr('data-id');
            var _extension = _pdfName.substr((_pdfName.lastIndexOf('.') + 1));
            $(current).parent().next()[0].textContent = "verified";
            $(current).parent().next().css("color", "green");
            if (_pdfName != "" && _extension.toLowerCase() == "pdf") {
                $.ajax({
                    type: "GET",
                    url: "/IOM/GetPDF",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { fileName: _pdfName },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.FILEPATH != "") {
                            document.getElementById("myCreateModelContent").innerHTML = data.FILEPATH;
                            $('#myCreateModel').modal({ backdrop: "static" });
                        }
                        else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
            else if(_pdfName != "" && _extension.toLowerCase() != "pdf"){
                window.open("../../../Uploads/DGIT_IOM/" + _pdfName,"_blank");
                //window.location.href = "../../../Uploads/DGIT_IOM/" + _pdfName;
            }
        }

        function GetIOMPDF(current) {
            var _pdfName = $(current).attr('data-id');
            if (_pdfName != "") {
                $.ajax({
                    type: "GET",
                    url: "/IOM/GetPDF",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { fileName: _pdfName },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.FILEPATH != "") {
                            document.getElementById("myCreateModelContent").innerHTML = data.FILEPATH;
                            $('#myCreateModel').modal({ backdrop: "static" });
                        }
                        else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function DeleteDoc(crnt){
            var fileName = $(crnt).attr('data-name');
            var docType = $(crnt).attr('data-type');
            var iomHeaderId = $(crnt).attr('data-id');
            $.ajax({
                type: "POST",
                url: "/IOM/DeleteAttachment",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                // data: JSON.stringify({fileName:fileName, docType:docType, iomHeaderId:iomHeaderId}),
                data: {fileName:fileName, docType:docType, iomHeaderId:iomHeaderId},
                // contentType: "application/json; charset=utf-8",
                contentType: "application/x-www-form-urlencoded; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.res == 1) {
                        //attachmentArray = data.attachmentList;

                        sweetAlert("", "Document deleted successfully.", "success");
                        window.location.reload();
                    }
                    else {
                        sweetAlert("", "Document not deleted, Please try again.", "warning");
                    }
                },
                complete: function () {
                    BindDocument(attachmentArray);
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }


        function BindData(arrayList) {


            var rows = "", rowId = 0;
            if (arrayList != null) {
                if (arrayList.length > 0) {
                    $.each(arrayList, function (i, item) {
                        rowId = i + 1;
                        rows += "<tr class='tr-auth'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.Header + "</td><td class='text-center'>" + item.ADEMPCODE + "</td>"
                        rows += "<td class='text-left'><input type='hidden' value='" + item.APP_SEQ + "'>" + item.ADEMPNAME + "</td><td class='text-center'><input type='hidden' value='" + item.FNDESID + "'>" + item.ADDESIGNATION + "</td>"
                        //rows += "<td class='text-center'>" + item.APP_SEQ + "</td>"
                        rows += "<td class='hidden'><input type='button' value='up' class='move up text-right btn btn-info btn-xs' /></td><td class='hidden'><input type='button' value='down' class='move down text-left btn btn-info btn-xs' /></td>"
                        rows += "</tr>"
                    });
                }
                else {
                    rows += "<tr id='div-table'><td colspan='6' class='text-center'>No record found.</td></tr>"
                }
                document.getElementById("append_row").innerHTML = rows;
            }
            else
            {
                rows += "<tr id='div-table'><td colspan='6' class='text-center'>No record found.</td></tr>"
                document.getElementById("append_row").innerHTML = rows;
            }
        }


        function CheckFormValidation() {
            $('#div_valid_msg').addClass('hidden');
            var isValid = true;
            var validationMsg = "";

            // Remove validation error classes
            $("#txtIOMDesc").removeClass('validationError');
            $("#txtIOMFile").removeClass('validationError');
            $("#ddCategory").removeClass('validationError');

            // Check if IOMDesc is empty
            if ($('#txtIOMDesc').val() == "") {
                $("#txtIOMDesc").addClass('validationError');
                isValid = false;
                validationMsg = "Description field is mandatory.";
            }

            else {
                // Check for special characters in IOMDesc
                var specialCharactersPattern = /[!\"#$%&'()*+\/:;<=>?@@[\\\]^_`{|}~]/;
                var specialCharactersRegex = new RegExp(specialCharactersPattern);
                if (specialCharactersRegex.test($('#txtIOMDesc').val())) {
                    //$("#txtIOMDesc").addClass('validationError');
                    //isValid = false;
                    //validationMsg = "Special characters are not allowed in description. ";
                }
            }

            // Check if IOMFile is empty
            if ($('#txtIOMFile').val() == "") {
                $("#txtIOMFile").addClass('validationError');
                isValid = false;
                validationMsg += "IOM Attachment field is mandatory. ";
            }


            if ($('#ddCategory').val() == "") {
                $("#ddCategory").addClass('validationError');
                isVailed = false;
                //validationMsg = validationMsg + "Approval Category , "
                validationMsg = 'Approval Category field is mandatory.';
            }

            // Display validation message
            if (!isValid) {
                $('#spn_valid_msg').text(validationMsg);
            }

            return isValid;
        }

        function submitForm() {


            var isFormVaildation = CheckFormValidation();
            if (isFormVaildation) {
                var docTr = $("#append_docRow .tr_doc");
                if(docTr.length > 0){
                    for (var i = 0; i < docTr.length; i += 1) {
                        var row = docTr[i];
                        if (row != undefined) {
                            var varificationText = row.cells[3].innerHTML.trim();
                            if(varificationText == "Not Verified"){
                                sweetAlert("", "Document not verified. Please open all document & verified", "warning");
                                return;
                            }
                        }
                    }
                }
                $('#txtEmpcode').removeClass('validationError');
                if (arrayList == null || arrayList.length == 0) {
                    $('#txtEmpcode').addClass('validationError');
                    sweetAlert("", "Please add approval authority.", "warning");
                    return;
                }
                else {
                    $("#btnSave").attr("disabled", true);
                    $("#btnPreview").attr("disabled", true);

                    var rowLength = $('#mytable').find('.tr-auth').length;
                    var rows = $('#mytable').find('.tr-auth');
                    var newArrayList = new Array;
                    for (var i = 0; i < rowLength; i += 1) {
                        var row = rows[i];
                        if (row != undefined) {
                            app_seq = i; //$(row.cells[2]).find('input[type=hidden]').val();
                            fnId = $(row.cells[3]).find('input[type=hidden]').val();
                            var rowData = {
                                Header: $(row.cells[1])[0].textContent,
                                ADEMPCODE: $(row.cells[2])[0].textContent,
                                ADEMPNAME: $(row.cells[3])[0].textContent,
                                ADDESIGNATION: $(row.cells[4])[0].textContent,
                                APP_SEQ:  app_seq,
                                APPTYPE:  1,
                                FNDESID:  fnId,
                            }
                            newArrayList.push(rowData);
                        }
                    }
                    arrayList = newArrayList;

                    var data = {
                        IOMHEADERID : $("#hfIomHeaderId").val(),
                        IOMDesc:$("#txtIOMDesc").val(),
                        STATUS : 1,
                        PROCESS_STATUS : 1,
                        IsFinalSubmit : 1,
                        iomAuthSeq : arrayList,
                        iomAppHeaderList : mainHeaderArray,
                        APP_TYPE: $("input[name='rdbFO']:checked").val(),
                        IOMCATMSTID : $("#ddCategory").val(),
                    }
                    $.ajax({
                        type: "POST",
                        url: "/IOM/EditIOMRequestUploadBeforeHold",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        data: JSON.stringify(data),
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (data) {
                            if (data == 1) {
                                swal({
                                    title: "",
                                    text: "Record saved successfully.",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                        window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                                    }
                                });
                            }
                                //else if (data == 2) {
                                //    sweetAlert("", "This IOM request already processed.", "warning");
                                //    $("#btnSave").attr("disabled", false);
                                //    $("#btnPreview").attr("disabled", false);
                                //}
                            else if (data == 2) {
                                sweetAlert("", "Kindly add other director of same operation.", "warning");
                                BindDocument(new Array);
                                $("#btnSave").attr("disabled", false);
                                $("#btnPreview").attr("disabled", false);
                            }
                            //Changed by TTL on 18-June-2025 against SR99343 > CR6531 - Start
                            //Validate if the request is actually on hold
                            else if (data == -2) {
                                sweetAlert("", "Request is currently not on hold.", "warning");
                                $("#btnSave").attr("disabled", false);
                                $("#btnPreview").attr("disabled", false);
                            }
                            //Changed by TTL on 18-June-2025 against SR99343 > CR6531 - End
                            else {
                                sweetAlert("", "Record not saved.", "warning");
                                $("#btnSave").attr("disabled", false);
                                $("#btnPreview").attr("disabled", false);
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                            $("#btnSave").attr("disabled", false);
                            $("#btnPreview").attr("disabled", false);
                        }
                    });
                }
            }
            else {
                $('#div_valid_msg').removeClass('hidden');
            }
        }

        function CheckHeaderValidation() {
            var isVailed = true;
            $('#lblValidationMsg').text('');
            $('#txtHeaderName').removeClass('validationError');
            if ($('#txtHeaderName').val() == "") {
                $('#txtHeaderName').addClass('validationError');
                $('#lblValidationMsg').text('Please enter approval header');
                isVailed = false;
            }
            return isVailed;
        }

        function openInfo(url) {
            window.open(url, 'mywin', 'width=500,height=500');
        }

        function Cancel()
        {
            window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
            return false;
        }



    </script>

    @* CSP 3.0 Compliant Changes *@
    <script nonce="@Context.Items["ScriptNonce_4"]">
