<script nonce="@Context.Items["ScriptNonce_3"]">
    function GetPDF(filename, no) {
        var _pdfName = filename;
        if (_pdfName != "" && _pdfName != "Select") {
            $.ajax({
                type: "GET",
                url: "/IOM/GetTwoPDF",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: { fileName: _pdfName },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    debugger;
                    if (data.FILEPATH != "") {
                        document.getElementById("append_pdf" + no).innerHTML = data.FILEPATH;
                    }
                    else {
                        sweetAlert("", "File not found.", "warning");
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
    }


</script>
<script nonce="@Context.Items["ScriptNonce_3"]">
    $(document).ready(function () {
        $('#ddlFileName1').on('change', function () {
            GetPDF($(this).val(), 1);
        });
        $('#ddlFileName2').on('change', function () {
            GetPDF($(this).val(), 2);
        });
        $('#ddlFileName3').on('change', function () {
            GetPDF($(this).val(), 3);
        });
        $('#ddlFileName4').on('change', function () {
            GetPDF($(this).val(), 4);
        });
    });
</script>
