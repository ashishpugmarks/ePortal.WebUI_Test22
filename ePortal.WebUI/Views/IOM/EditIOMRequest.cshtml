            function HeaderPopup() {
                $.ajax({
                    type: "GET",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    url: "/IOM/AddApprovalHeader",
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data == "error") {
                            sweetAlert("", "An error occurred while processing your request.", "error");
                        }
                        else {
                            $("#ajaxLoader").removeClass('loader');
                            $('#sp_type').html("Add Approval Header");
                            $('#myCreateModelContent').html(data);
                            $('#myCreateModel').modal({ backdrop: "static" });
                        }
                    },
                    complete: function () {
                        tmpHeaderArray = new Array;
                        tmpHeaderArray = mainHeaderArray;
                        BindHeader();
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }

            function AddHeader(){
                var isFormVaildation = CheckHeaderValidation();
                if (isFormVaildation) {
                    if (tmpHeaderArray == null || tmpHeaderArray.length == 0) {
                        tmpHeaderArray = new Array;
                    }

                    if (tmpHeaderArray.length > 0) {
                        var itemArray = $.grep(tmpHeaderArray, function (e) {
                            return e.IOMAPPHEADER == $('#txtHeaderName').val().trim();
                        });
                        if (itemArray.length > 0) {
                            $('#txtHeaderName').addClass('validationError');
                            $('#lblValidationMsg').text('This approval header already added.');
                            return;
                        }
                    }

                    var SeqOrder = tmpHeaderArray.length + 1;
                    var data = {
                        IOMAPPHEADERID: 0,
                        IOMHEADERID :0,
                        IOMAPPHEADER: $('#txtHeaderName').val().trim(),
                        APPHEADERDESC: "",
                        STATUS: 1,
                        Seq_Order: SeqOrder,
                    }
                    tmpHeaderArray.push(data);
                    $('#txtHeaderName').val('');
                    $('#txtHeaderDesc').val('');
                    BindHeader();
                }
            }

            function DeleteHeader(current){
                var _header = $(current).attr('data-header');
                if (arrayList.length > 0) {
                    var itemArray = $.grep(arrayList, function (e) {
                        return e.Header == _header;
                    });
                    if (itemArray.length > 0) {
                        $("#spn_msg").text('This header is in use. you cannot delete it.');
                        $("#div_msg").removeClass('hidden');
                        $("#div_msg").css('color', '#a94442').show().delay(3000).fadeOut(1000);
                        return;
                    }
                }

                tmpHeaderArray = $.grep(tmpHeaderArray, function (e) {
                    return e.Seq_Order != current.id;
                });
                var newtmpHeaderArray = new Array;
                if(tmpHeaderArray.length > 0){
                    $.each(tmpHeaderArray, function (i, item) {
                        var obj1 = {
                            IOMAPPHEADERID: item.IOMAPPHEADERID,
                            IOMHEADERID :item.IOMHEADERID,
                            IOMAPPHEADER: item.IOMAPPHEADER,
                            APPHEADERDESC: item.APPHEADERDESC,
                            STATUS: 1,
                            Seq_Order: newtmpHeaderArray.length + 1,
                        }
                        newtmpHeaderArray.push(obj1);
                    });
                }
                tmpHeaderArray = newtmpHeaderArray;
                BindHeader();
            }

            function BindHeader(){
                var rows = "", rowId = 0;
                if (tmpHeaderArray != null) {
                    if (tmpHeaderArray.length > 0) {
                        $.each(tmpHeaderArray, function (i, item) {
                            rowId = i + 1;
                            rows += "<tr><td class='text-center'>" + rowId + "</td><td>" + item.IOMAPPHEADER + "</td>"
                            //rows += "<td class='text-left'>" + item.APPHEADERDESC + "</td>"
                            rows += "<td class='text-center'>" + item.Seq_Order + "</td>"
                            rows += "<td class='text-center'><a id='" + item.Seq_Order + "' data-header='"+ item.IOMAPPHEADER +"' style='cursor: pointer;' data-ctrl='deletehdr'>Delete</a></td>"
                            rows += "</tr>"
                        });
                    }
                    else {
                        rows += "<tr id='div-table'><td colspan='4' class='text-center'>No record found.</td></tr>"
                    }
                    document.getElementById("header_row").innerHTML = rows;

                    //CSP 3.0 Compliant changes
                    if (rowId > 0) {
                        $("[data-ctrl='deletehdr']").on('click', function () {
                            DeleteHeader($(this)[0]);
                        });
                    }
                }
            }

            function HeaderSubmit (){
                if (tmpHeaderArray == null || tmpHeaderArray.length == 0) {
                    $("#spn_msg").text('Please add atleast one header.');
                    $("#div_msg").removeClass('hidden');
                    $("#div_msg").css('color', '#a94442').show().delay(3000).fadeOut(1000);
                    return;
                }
                mainHeaderArray = new Array;
                mainHeaderArray = tmpHeaderArray;
                BindHeaderDropdown();
                $('#myCreateModel').modal('hide');
            }

            function BindHeaderDropdown(){
                var options = "";
                options += '<option value="">-Select-</option>'
                for (i = 0; i < mainHeaderArray.length; i++) {
                    options += '<option value="' + mainHeaderArray[i].Seq_Order +'">' + mainHeaderArray[i].IOMAPPHEADER + '</option>'
                }
                document.getElementById("ddHeader").innerHTML = options;
            }

            function CheckHeaderValidation() {
                var isVailed = true;
                $('#lblValidationMsg').text('');
                $('#txtHeaderName').removeClass('validationError');
                if ($('#txtHeaderName').val() == "") {
                    $('#txtHeaderName').addClass('validationError');
                    $('#lblValidationMsg').text('Please enter approval header');
                    isVailed = false;
                }
                return isVailed;
            }

            function openInfo(url) {
                window.open(url, 'mywin', 'width=500,height=500');
            }

            function Reset(){
                window.location.href = "/IOM/EditIOMRequest?id=" + '@ViewBag.strId';
            }

            function Preview() {
                var isFormVaildation = CheckFormValidation();
                //Added by TTL on 18th July 2025 against SR101913 > CR6738 - Start
                if (!isFormVaildation) {
                    //Scroll top of the page
                    $('html, body').animate({ scrollTop: 0 }, 'slow');
                }
                //Added by TTL on 18th July 2025 against SR101913 > CR6738 - End
                if (isFormVaildation) {
                    var docTr = $("#append_docRow .tr_doc");
                    if(docTr.length > 0){
                        for (var i = 0; i < docTr.length; i += 1) {
                            var row = docTr[i];
                            if (row != undefined) {
                                var varificationText = row.cells[3].innerHTML.trim();
                                if(varificationText == "Not Verified"){
                                    sweetAlert("", "Document not verified. Please open all document & verified", "warning");
                                    return;
                                }
                            }
                        }
                    }
                    //else{
                    //    sweetAlert("", "Please upload documents.", "warning");
                    //    return;
                    //}

                    $('#txtEmpcode').removeClass('validationError');
                    if (arrayList == null || arrayList.length == 0) {
                        $('#txtEmpcode').addClass('validationError');
                        sweetAlert("", "Please add approval authority.", "warning");
                        return;
                    }
                    else {
                        var _iomFile = $("#hfIOMAttachment").val();
                        if (_iomFile != "") {
                            $("#btnPreview").attr("disabled", true);

                            var data = {
                                IOMHEADERID : $("#hfIomHeaderId").val(),
                                iomAuthSeq : arrayList,
                                IOMATTACHMENT:_iomFile
                            }

                            $.ajax({
                                type: "POST",
                                url: "/IOM/PreviewIOM",
                                beforeSend: function () {
                                    $("#ajaxLoader").addClass('loader');
                                },
                                data: JSON.stringify(data),
                                contentType: "application/json; charset=utf-8",
                                datatype: "json",
                                success: function (data) {
                                    if (data.FILEPATH != "") {
                                        document.getElementById("IOM_attachment").innerHTML = data.FILEPATH;
                                        $('#myPreviewModel').modal({ backdrop: "static" });
                                    }

                                },
                                complete: function () {
                                    $("#ajaxLoader").removeClass('loader');
                                    $("#btnPreview").attr("disabled", false);
                                },
                                error: function () {
                                    sweetAlert("Oops...", "Something went wrong!", "error");
                                    $("#btnPreview").attr("disabled", false);
                                }
                            });
                        }
                        else{
                            sweetAlert("", "IOM attachment not found. Please upload again.", "warning");
                            return;
                        }
                    }
                }
                else {
                    $('#div_valid_msg').removeClass('hidden');
                }
            }
            function AddOAuthority() {
                $('#spn_O_auth_msg').text('');
                $('#txtOheader').removeClass('validationError');
                if ($('#txtOheader').val() == "") {
                    $('#txtOheader').addClass('validationError');
                    $('#spn_O_auth_msg').text('Please select header.');
                    return;
                }
                $('#txtOEmpcode').removeClass('validationError');
                if ($('#txtOEmpcode').val() == "") {
                    $('#txtOEmpcode').addClass('validationError');
                    $('#spn_O_auth_msg').text('Please enter employee code.');
                    return;
                }
                if (arrayList.length > 0) {
                    var _ecode = parseInt($('#txtOEmpcode').val().split("-")[0].trim());
                    var itemArray = $.grep(arrayList, function (e) {
                        return e.ADEMPCODE == _ecode;
                    });
                    if (itemArray.length > 0) {
                        $('#txtOEmpcode').addClass('validationError');
                        $('#spn_O_auth_msg').text('This approval authority already added.');
                        return;
                    }

                    //var itemArray2 = $.grep(arrayList, function (e) {
                    //    return e.APP_SEQ == $('#ddHeader').val();
                    //});
                    //if (itemArray2.length > 0) {
                    //    $('#ddHeader').addClass('validationError');
                    //    $('#spn_auth_msg').text('This designation already added.');
                    //    return;
                    //}
                }
                $.ajax({
                    type: "GET",
                    url: "/IOM/GetAppAuthority",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { eCode: $('#txtOEmpcode').val(), headerId : arrayList.length, header:$("#txtOheader").val() },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.ECODE > 0 && data.ENAME != "") {
                            arrayList = data.SEQ_LIST;
                            $('#txtOEmpcode').val('');
                            //$("#ddHeader").val('');
                        }
                        else {
                            $('#spn_O_auth_msg').text('Record not found.');
                        }
                    },
                    complete: function () {
                        BindData(arrayList);
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }

            function DeleteAll() {
                $.ajax({
                    type: "GET",
                    url: "/IOM/DeleteAppAuthority",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { eCode: "", header: "",ISALL:1 },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.RESULT == 1) {
                            arrayList = data.SEQ_LIST;
                        }
                        else {
                            //$('#spn_auth_msg').text('Record not deleted.');
                        }
                    },
                    complete: function () {
                        BindData(arrayList);
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        </script>

