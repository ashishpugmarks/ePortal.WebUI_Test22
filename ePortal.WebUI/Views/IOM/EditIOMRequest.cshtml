                                @Html.Label("", "Header", htmlAttributes: new { @class = "control-label required" })
                                </div>
                                <div class="col-md-2 col-sm-4 col-xs-5">
                                    <input type="text" class="form-control" id="txtOheader" placeholder="Approval Header" />
                                </div>
                                <div class="col-md-1 col-sm-3 col-xs-3 text-right">
                                @Html.LabelFor(model => model.iomAuthSeq[0].ADEMPCODE, htmlAttributes: new { @class = "control-label required" })
                                </div>
                                <div class="col-md-3 col-sm-4 col-xs-5">
