@model ePortal.ViewModels.IOMAppHeaderViewModel

@{
    Layout = null;
}

    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .ui-autocomplete {
            z-index: 99999;
            max-height: 120px;
        }

        .validationError {
            border: 1px solid #a94442;
        }
    </style>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
        $(function () {

            $("input#txtHeaderName").autocomplete({
                source: "/IOM/AutocompleteDesignation",
                minLength: 2,
                select: function (event, ui) {
                    if (ui.item) {
                        $("#searchHeader").val(ui.item.value);
                    }

                }
            });
        });

        function ResetHeader() {
            $('#txtHeaderName').val('');
            $('#txtHeaderName').removeClass('validationError');
            $('#lblValidationMsg').text('');
        }

    </script>

    @* CSP 3.0 Compliant Changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
        $(document).ready(function () {
            $('#btnHeaderSubmit').on('click', function () {
                HeaderSubmit();
            });
            $('#btnResetHeader').on('click', function () {
                ResetHeader();
            });
            $('#btnHeaderSave').on('click', function () {
                AddHeader();
            });
        });
    </script>

    <div class="body-content" style="padding:0px !important;">
        <div>
            <div id="div_msg" class="form-group hidden alert alert-error text-left">
                <span id="spn_msg" style="color:#a94442;"></span>
            </div>
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group">
                    @Html.HiddenFor(model => model.IOMAPPHEADERID, htmlAttributes: new { @id = "hfAppHeaderId" })
                    @Html.LabelFor(model => model.IOMAPPHEADER, htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-6">
                        @*@Html.EditorFor(model => model.IOMAPPHEADER, new { htmlAttributes = new { @id = "txtHeaderName", @class = "form-control" } })*@
                        <input type="text" class="form-control" id="txtHeaderName" placeholder="Search Designation" />
                        <span id="searchHeader"></span>
                        @*@Html.ValidationMessageFor(model => model.IOMAPPHEADER, "", new { @id="lblValidationMsg", @class = "text-danger" })*@
                    </div>
                    <div class="col-md-3">
                        <input type="button" value="Add" class="btn btn-primary btn-sm" id="btnHeaderSave" />
                        <button type="button" class="btn btn-default btn-sm" id="btnResetHeader">Reset</button>
                    </div>
                </div>

                <div style="overflow:auto; max-height:280px;">
                    <table class="table table-bordered table-responsive" id="myHeadertable">
                        <thead>
                            <tr class="bg-info">
                                <th class="text-center">SNo.</th>
                                <th>Approval Header</th>
                                @*<th>Header Description</th>*@
                                <th class="text-center">Seq. Order</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="header_row">
                            <tr><th colspan="5" class="text-center">No record found.</th></tr>
                        </tbody>
                    </table>
                </div>
                <div class="row">
                    <div class="col-md-offset-4 col-md-8">
                        <input type="button" value="Submit" class="btn btn-success btn-sm" id="btnHeaderSubmit" />
                        <button type="button" class="btn btn-default btn-sm" data-dismiss="modal" aria-label="Close">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

