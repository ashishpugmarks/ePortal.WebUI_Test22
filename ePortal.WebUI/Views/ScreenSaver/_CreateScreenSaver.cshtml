    <div class="body-content" style="padding:0px !important">
        <div>
            @using (Html.BeginForm("CreateScreenSaverNews", "ScreenSaver", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="form-group">
                        @Html.LabelFor(model => model.DEPARTNAME, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.DEPARTNAME, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.DEPARTNAME, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    @*<div class="form-group">
                        @Html.LabelFor(model => model.BRIEF, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.BRIEF, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.BRIEF, "", new { @class = "text-danger" })
                        </div>
                    </div>*@

                   

                    <div class="form-group">
                        @Html.LabelFor(model => model.LASTREVISEDDATE, htmlAttributes: new { @class = "control-label col-md-3" })               
                            <div class="col-md-8">
                                @Html.TextBoxFor(a => a.LASTREVISEDDATE, new { @class = "form-control" })
                            </div>
                      
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.STATUS, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-6" style="margin-top: 8px;">
                            @Html.RadioButtonFor(model => model.STATUS, "1", htmlAttributes: new { @class = "col-md-1" })
                            @Html.Label("","Active", htmlAttributes: new { @class = "col-md-3" })
                            @Html.RadioButtonFor(model => model.STATUS, "0", htmlAttributes: new { @class = "col-md-1" })
                            @Html.Label("", "DeActive", htmlAttributes: new { @class = "col-md-3" })
                            @Html.ValidationMessageFor(model => model.STATUS, "", new { @class = "text-danger" })
                        </div>
                        </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Policies, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-8">
                            @*<input id="Upload_Banner" type="file" name="file[0]" class="form-control" />*@
                            @Html.TextBoxFor(model => model.FILE_NAME, new { type = "file", @name = "file", @class = "form-control", @id = "Upload_Screen" })
                            @Html.ValidationMessageFor(model => model.FILE_NAME, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group" style="text-align:center">
                        <div class="col-md-12">
                            <input type="submit" value="Submit" class="btn btn-success" style="margin:auto; display:block;" /> 
                            @*<input type="submit" value="Submit" class="btn btn-success" />*@
                            @*<button type="button" class="btn btn-primary" onclick="openPreviewPopup();">Preview</button>*@
                            @*<button type="button" class="btn btn-secondary" data-dismiss="modal" aria-label="Close">Cancel</button>*@
                        </div>
                    </div>
                </div>
            }
        </div>

        <div id="myReadMoreModal" class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog" style="font-size:15px !important; width:550px">
                <div class="modal-content">
                    <div class="modal-header">
                        <img src="~/images/icon_fdelete.gif" alt="close" title="close" id="closeModel" class="close-readmore-modal" />
                        <img alt="CorporateNews banner" id="headerImage" title="Corporate News banner" style="width:547px" />
                    </div>
                    <div class="modal-body">
                        <div class="modal-left-content hidden-xs">
                            <h3 class="visible-xs lblSubject"><span class="heading lblCreateDate"></span></h3>
                            <span><img id="banner-img" alt="CorporateNews" title="Corporate News image" class="left-content-img" /></span>
                            <div class="download-links hidden-xs">
                                <h6>Download :</h6>
                                <a id="Attachment1-link"></a>
                                <a id="Attachment2-link"></a>
                            </div>
                        </div>
                        <div class="modal-right-content">
                            <h3 class="hidden-xs">
                                <span id="lblSubject"></span>
                                <span class="heading lblCreateDate"></span>
                            </h3>
                            <div id="modal-scroll">
                                <p style="white-space:pre-wrap"  id="lblDescription">Loading please wait.....</p>
                            </div>
                            <p class="venue-text" style="display:none;"></p>

                            <div class="download-links visible-xs">
                                <h6>Download :</h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- CorporateNews preview modal end -->
