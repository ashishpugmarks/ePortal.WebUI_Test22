                    </div>

                </td>
            </tr>
        </tbody>
    </table>
@section Scripts{
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

    function DownloadSample(File) {
        debugger;
        var link = document.createElement("a");
        link.href = "../../Uploads/ScreenSaver/" + File;
        link.download = File;
        link.click();
    }

</script>
    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $(document).on('click', '[data-ctrl="arcDownloadSample"]', function () {
               var fileName = $(this).data('filename');
               DownloadSample(fileName);
            });
        });
    </script>
}