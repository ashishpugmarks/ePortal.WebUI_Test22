                                                    @Html.DisplayFor(modelItem => item.PoliciesFileName)
                                                </a>*@
                                        <a href="#" class="button" data-ctrl="arcDownloadSample" data-filename="@item.PoliciesFileName" ><i class="fa fa-file-excel"> </i><span> @item.PoliciesFileName </span></a>
                                            </td>
                                            <td style="height: 20px; width: 150px; text-align: left">
                                                &nbsp;@Html.DisplayFor(modelItem => item.LASTREVISEDDATE)
