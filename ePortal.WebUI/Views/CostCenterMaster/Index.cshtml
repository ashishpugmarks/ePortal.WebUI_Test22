@section Scripts{
@*     <script src="~/js/jquery.2.1.3.min.js"></script>
    <script src="~/js/jquery.dataTables.js"></script> *@

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_1"]">
            $(document).ready(function () {
                GetDetails("");
            });

            function GetDetails(searchStr) {
                $.ajax({
                    type: "POST",
                    url: "/CostCenterMaster/GetCostCenterMasterList?SearchTex="+searchStr,
                    // data: "{SearchTex: \"" + searchStr + "\"}",
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    beforeSend: function () {
                        $('#loader_new').removeClass('hidden');
                    },
                    success: function (data) {
                        $("#append_Data").empty();

                        if (data.length > 0) {

                            if ($.fn.DataTable.isDataTable('#myDataTable')) {
                                $('#myDataTable').DataTable().clear().destroy();
                            }

                            $.each(data, function (i, r) {
                                var htmlString = '<tr>' +
                                                     '<td><center>' + EditorFormatter(r.ADCOSTCENTERID) + '</center></td>' +
                                                     //'<td>' + r.ADCOSTCENTERCODE + '</td>' +
                                                     '<td>' + r.ADCOSTCENTERNAME + '</td>' +
                                                     '<td>' + r.ADSYSITE + '</td>' +
                                                     '<td>' + r.ADDIVISION + '</td>' +
                                                 '</tr>';

                                $("#append_Data").append(htmlString);
                            });

                            $('#myDataTable').DataTable({
                                searching: false,
                                bPaginate: true,
                                pageLength: 10,
                                lengthChange: false,
                                info: false,
                                ordering: false
                            });
                        }
                        else {
                            $("#append_Data").append("<tr><td colspan='5' class='text-center'>No record found.</td></tr>")
                        }
                        $('#loader_new').addClass('hidden');
                    },
                    error: function () {
                        $('#loader_new').addClass('hidden');
                        swal("Oops...", "Something went wrong!", "error");
                    }
                });
            }

            function EditorFormatter(SrNo) {
                    var editBtn = '<a title="Edit" class="btn btn-primary btn-xs" data-ctrl="ancEdit" data-SrNo=' + SrNo+'><i class="ace-icon fa fa-edit"></i></a>&nbsp;&nbsp;'

                        var deleteBtn = '<a title="Delete" class="btn btn-danger btn-xs" data-ctrl="ancDelete" data-SrNo=' + SrNo + '><i class="ace-icon fa fa-trash"></i></a>&nbsp;&nbsp;';

                    var viewlogBtn = '<a title="View Log" class="btn btn-primary btn-xs" data-ctrl="ancView" data-SrNo=' + SrNo + '><i class="ace-icon fa fa-history"></i></a>&nbsp;&nbsp;';

                return (editBtn + deleteBtn + viewlogBtn);
            }

            function Search() {
                var inputVal = $("#txtCostCenter").val();
                GetDetails(inputVal);
            }

            function Add() {
                $.fancybox.open({
                    href: '/CostCenterMaster/Add',
                    type: 'iframe',
                    padding: 5,
                    fitToView: true,
                    maxHeight: 350,
                    autoSize: true,
                    closeClick: true,
                    openEffect: 'elastic',
                    openSpeed: 120,
                    closeEffect: 'elastic',
                    closeSpeed: 100,
                    afterClose: function () {
                        window.location.reload();
                    },
                    helpers: {
                        overlay: { closeClick: false }
                    }
                });
            }

        function View(SrNo) {
                $.fancybox.open({
                    href: '/CostCenterMaster/ViewLog?id=' + SrNo,
                    type: 'iframe',
                    autoSize: true,
                    fitToView: true,
                    maxWidth: '100%',
                    maxHeight: '97%',
                    width: '95%',
                    height: '95%',
                    padding: 5,
                    closeClick: true,
                    openEffect: 'elastic',
                    openSpeed: 120,
                    closeEffect: 'elastic',
                    closeSpeed: 100,
                    afterClose: function () {
                        window.location.reload();
                    },
                    helpers: {
                        overlay: { closeClick: false }
                    }
                });
            }

            function Import() {
                var formData = new FormData();
                var fileInput = document.getElementById('file');
                var file = fileInput.files[0];

                if (!file) {
                    swal("Oops...", "Please select a file to upload.", "error");
                    return;
                }

                var allowedExtensions = ['.xls', '.xlsx'];
                var fileExtension = file.name.split('.').pop().toLowerCase();

                if (!allowedExtensions.includes('.' + fileExtension)) {
                    swal("Oops...", "Invalid file type. Please upload an Excel file.", "error");
                    return;
                }

                formData.append('file', file);

                $.ajax({
                    url: '/CostCenterMaster/Upload',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    beforeSend: function () {
                        $('#loader_new').removeClass('hidden');
                    },
                    success: function (response) {

                        $('#loader_new').addClass('hidden');

                        if (response.status == "false") {
                            swal("Oops...", response.message, "error");
                        }
                        else {

                            if (response.logfile && response.logfile !== "") {
                                var downloadUrl = response.logfile.startsWith("~") ? response.logfile.replace("~", window.location.origin) : response.logfile;

                                var link = document.createElement("a");
                                link.href = downloadUrl;
                                link.download = downloadUrl.split('/').pop();

                                document.body.appendChild(link);
                                link.click();
                                document.body.removeChild(link);

                                swal({
                                    title: 'Warning!',
                                    text: response.message,
                                    icon: 'warning',
                                    button: 'OK'
                                }, function () {
                                    window.location.reload();
                                });
                            } else {
                                swal({
                                    title: 'Success!',
                                    text: response.message,
                                    icon: 'success',
                                    button: 'OK'
                                }, function () {
                                    window.location.reload();
                                });
                            }
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        $('#loader_new').addClass('hidden');
                        swal("Oops...", "File upload failed.", "error");
                    }
                });
                return false;
            }

            function Export() {
                var inputVal = $("#txtCostCenter").val();

                $.ajax({
                    type: "POST",
                    url: "/CostCenterMaster/ExportToExcel",
                    data: "{SearchTex: \"" + inputVal + "\"}",
                    xhrFields: {
                        responseType: 'blob'
                    },
                    beforeSend: function () {
                        $('#loader_new').removeClass('hidden');
                    },
                    success: function (data, status, xhr) {
                        var disposition = xhr.getResponseHeader('Content-Disposition');

                        var fileName = "ExportedData.xlsx";

                        if (disposition && disposition.indexOf('attachment') !== -1) {
                            var matches = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/.exec(disposition);
                            if (matches != null && matches[1]) {
                                fileName = matches[1].replace(/['"]/g, '');
                            }
                        }

                        var blob = new Blob([data], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
                        var url = window.URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = url;
                        a.download = fileName;
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(url);
                        $('#loader_new').addClass('hidden');
                    },
                    error: function (xhr, status, error) {
                        $('#loader_new').addClass('hidden');
                        swal("Oops...", "Failed to download the file: " + error, "error");
                    }
                });
            }

            function Edit(SrNo) {
                $.fancybox.open({
                    href: '/CostCenterMaster/Edit?id=' + SrNo,
                    type: 'iframe',
                    padding: 5,
                    fitToView: true,
                    maxHeight: 350,
                    autoSize: true,
                    closeClick: true,
                    openEffect: 'elastic',
                    openSpeed: 120,
                    closeEffect: 'elastic',
                    closeSpeed: 100,
                    afterClose: function () {
                        window.location.reload();
                    },
                    helpers: {
                        overlay: { closeClick: false }
                    }
                });
            }

            function Delete(SrNo) {
                swal({
                    title: "",
                    text: "Are you sure you want to Delete this record?",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonColor: '#DD6B55',
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: "No",
                    closeOnConfirm: false,
                    closeOnCancel: false
                },
                function (isConfirm) {
                    if (isConfirm) {
                        $.ajax({
                            type: "GET",
                            url: "/CostCenterMaster/DeleteCostCenterBySrNo?SrNo="+SrNo,
                            // data: "{SrNo: \"" + SrNo + "\"}",
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            beforeSend: function () {
                                $('#loader_new').removeClass('hidden');
                            },
                            success: function (response) {
                                $('#loader_new').addClass('hidden');
                                if (response.status === "false") {
                                    swal("Oops...", response.message, "error");
                                } else {
                                    swal({
                                        title: 'Success!',
                                        text: "Record Deleted Successfully!",
                                        icon: 'success',
                                        button: 'OK'
                                    }, function () {
                                        window.location.reload();
                                    });
                                }
                            },
                            error: function () {
                                $('#loader_new').addClass('hidden');
                                swal("Oops...", "Record Delete failed", "error");
                            }
                        });
                    } else {
                        swal("Cancelled", "Your record not deleted :)", "error");
                    }
                });
            }
    </script>

    @* CSP 3.0 Compliant Changes *@
    <script nonce="@Context.Items["ScriptNonce_2"]">
        $(document).ready(function () {
            $('#btnSearch').on('click', function () {
                Search();
            });
            $('#btnAdd').on('click', function () {
                Add();
            });
            $('#btnImport').on('click', function () {
                Import()
            });
            $('#btnExport').on('click', function () {
                Export();
            });
            $(document).on('click', '[data-ctrl="ancEdit"]', function () {
                var srno = $(this).data('srno');
                Edit(srno);
            });
            $(document).on('click', '[data-ctrl="ancDelete"]', function () {
                var srno = $(this).data('srno');
                Delete(srno);
            });
            $(document).on('click', '[data-ctrl="ancView"]', function () {
                var srno = $(this).data('srno');
                View(srno);
            });
        });
    </script>
}
