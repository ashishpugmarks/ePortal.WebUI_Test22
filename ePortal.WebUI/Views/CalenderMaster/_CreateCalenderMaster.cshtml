        function UploadCalenderAttachment(input) {
            var _URL = window.URL || window.webkitURL;
            var file = input.files[0];
            var image = new Image();
            image.src = _URL.createObjectURL(file);
            var extension = $(input).val().split('.').pop().toLowerCase();
            var validFileExtensions = ['pdf'];
            if ($.inArray(extension, validFileExtensions) == -1) {
                var _msg = "Sorry! Upload only 'pdf' file";
                sweetAlert(" ", _msg, "warning");
                $(input).replaceWith($(input).val('').clone(true));
                return;
            }
            if (file.size > (5e+6)) {
                sweetAlert(" ", "Sorry! Max allowed file size is 5 mb", "warning");
                $(input).replaceWith($(input).val('').clone(true));
                return;
            }
            var formData = new FormData();
            formData.append("FILE", document.getElementById("txtcalenderFile").files[0]);
            formData.append("DOC_TYPE", "CALENDAR");
            //formData.append("SrNo", $("#txtAcrNo").val());
            $.ajax({
                type: "POST",
                url: "/CalenderMaster/UploadCalender",
                data: formData,
                datatype: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    debugger;
                    if (data.res == 1) {
                        alert("ACR Attachment uploaded successfully.");
                    }
                    else if (data.res == 0 || data.res == -1) {
                        alert("ACR Attachment not uploaded, Please try again.");
                        $("#txtcalenderFile").val('');
                    }
                },
                error: function () {
                    alert("Oops... Something went wrong!.");
                    $("#txtcalenderFile").val('');
                }
            });
        }
    </script>

