    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
        $(document).ready(function () {
           var initialSelectedValues = @Html.Raw(json);
            $('#ddLocation1').val(initialSelectedValues);

            $("#ddLocation1").SumoSelect({
                selectAll: true,
                onChange: function () {
                    $('#Loc').val($("#ddLocation1").val());
                    //$('#Loc').val($("#ddLocation1").val());
                }
            });

            $('#ddLocation1').on('change', function (e) {
                $("#ddLocation1").SumoSelect();
                var selectedValues = $(this).val();
                $('#Loc').val(selectedValues);
                //$('#Loc').val(selectedValues);
            });

            function UploadCalenderAttachment(input) {
                var _URL = window.URL || window.webkitURL;
                var file = input.files[0];
                var image = new Image();
                image.src = _URL.createObjectURL(file);
                var extension = $(input).val().split('.').pop().toLowerCase();
                var validFileExtensions = ['pdf'];
                if ($.inArray(extension, validFileExtensions) == -1) {
                    var _msg = "Sorry! Upload only 'pdf' file";
                    sweetAlert(" ", _msg, "warning");
                    $(input).replaceWith($(input).val('').clone(true));
                    return;
                }
                if (file.size > (5e+6)) {
                    sweetAlert(" ", "Sorry! Max allowed file size is 5 mb", "warning");
                    $(input).replaceWith($(input).val('').clone(true));
                    return;
                }
                var formData = new FormData();
                formData.append("FILE", document.getElementById("txtcalenderFile").files[0]);
                formData.append("DOC_TYPE", "CALENDAR");
                //formData.append("SrNo", $("#txtAcrNo").val());
                $.ajax({
                    type: "POST",
                    url: "/CalenderMaster/UploadCalender",
                    data: formData,
                    datatype: "json",
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        debugger;
                        if (data.res == 1) {
                            alert("ACR Attachment uploaded successfully.");
                        }
                        else if (data.res == 0 || data.res == -1) {
                            alert("ACR Attachment not uploaded, Please try again.");
                            $("#txtcalenderFile").val('');
                        }
                    },
                    error: function () {
                        alert("Oops... Something went wrong!.");
                        $("#txtcalenderFile").val('');
                    }
                });
            }



            @*var dropdown = document.getElementById("ddLocation");
            dropdown.value = '@ViewBag.SYSITE';

            var dropdown = document.getElementById("ddlAppAuth1");
            dropdown.value = '@ViewBag.AppAuth1';

            var dropdown1 = document.getElementById("ddlAppAuth2");
            dropdown1.value = '@ViewBag.AppAuth2';*@


            $("#Upload_Calender").change(function () {
                var _URL = window.URL || window.webkitURL;
                var file = $(this)[0].files[0];
                var image = new Image();
                image.src = _URL.createObjectURL(file);
                var extension = $(this).val().split('.').pop().toLowerCase();
                var validFileExtensions = ['pdf'];
                if ($.inArray(extension, validFileExtensions) == -1) {
                    alert("Sorry!! Upload only '.pdf' file")
                    $(this).replaceWith($(this).val('').clone(true));
                    $('#Apply').prop('disabled', true);
                } else {
                    if ($(this).get(0).files[0].size > (5000000)) {
                        alert("Sorry!! Max allowed file size is 5 MB");
                        $(this).replaceWith($(this).val('').clone(true));
                        $('#Apply').prop('disabled', true);
                    }
                    image.onload = function () {
                        var height = this.height;
                        var width = this.width;
                        if (height < 150 && width < 200) {
                            //alert("Sorry!! Width and Height must be between 200px - 250px & 150px - 200px.");
                            //$("#Upload_Banner").replaceWith($("#Upload_Banner").val('').clone(true));
                        }
                        else if (height > 200 && width > 250) {
                            //alert("Sorry!! Width and Height must be between 200px - 250px & 150px - 200px.");
                            //$("#Upload_Banner").replaceWith($("#Upload_Banner").val('').clone(true));
                        }
                        else {
                            $('#Apply').prop('disabled', false);
                        }
                    };
                }
            });

            $('#btnEdit').click(function (e) {

                debugger;
                e.preventDefault();
                var data = new FormData(this.form);
                $.ajax({
                    type: "POST",
                    url: "/CalenderMaster/EditCalenderMaster",
                    data: data,
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        $('#myModal').modal('hide');
                        var msg = "";
                        var actionType = "";
                        if (response == "success") {
                            msg = "Your Data has been Updated Successfully.";
                            actionType = "success";
                        }
                        else if (response == "failed") {
                            msg = "Your Data not Updated";
                            actionType = "warning";
                        }
                        else {
                            msg = response;
                            actionType = "error";
                        }
                        swal({
                            title: "",
                            text: msg,
                            type: actionType,
                        }, function (isConfirm) {
                            if (isConfirm) {
                                window.location.href = "/CalenderMaster/CalenderMaster";
                            }
                        });
                    },
                    error: function (response) {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            });

        });
    </script>

