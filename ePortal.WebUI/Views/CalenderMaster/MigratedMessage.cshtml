@model ePortal.WebUI.Controllers.CalenderMasterController.MigratedPageViewModel

@{
    ViewBag.Title = "CalenderMaster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <style nonce="@Context.Items["ScriptNonce_3"]">
        /* Prevent accidental interactions if layout has leftover UI */
       /*  main, .container {
            pointer-events: none;
        }

        .alert, .btn {
            pointer-events: auto;
        } */

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6f9;
            color: #333;
            margin: 0;
            padding: 0;
            text-align: center;
        }

        .redirect-container {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 80vh;
            padding: 20px;
        }

            .redirect-container h2 {
                font-size: 28px;
                color: #2c3e50;
                margin-bottom: 10px;
            }

            .redirect-container p {
                font-size: 16px;
                color: #555;
                margin-bottom: 30px;
            }
    </style>
}

<div class="redirect-container">
    <div class="alert ">        
        <h2>@Model.Title has moved</h2>
        <p>@Model.Message</p>        
    </div>
</div>






