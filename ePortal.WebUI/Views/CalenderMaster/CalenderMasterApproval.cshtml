@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            //GetPDF($("#iomPDF"));
        });


        function WindowSettings_WithoutMenu(str1, str2) {
            var winTop = (screen.height / 2) - 325;
            var winLeft = (screen.width / 2) - 425;
            var windowFeatures = "location=no,status=no,width=800,height=550";
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable" + ",scrollbars";
            window.open(str1, str2, windowFeatures);
        }

        function SaveData(current) {

            var _IsValid = CheckValidation();
            if (!_IsValid) {
                return;
            }
            $("#btnSubmit").attr("disabled", true);
            debugger;

            var approvalData = {
                CAL_MAS_SRNO: $(current).attr('data-id'),
                STATUS: $("#ddApprovalStatus").val(),
                APPAUTH_REMARKS: $("#txtRemarks").val(),
                //IOM_ATTACHMENT_NAME: $(current).attr('data-attachment'),
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/CalenderMaster/CalenderMasterApproval",
                data: JSON.stringify(approvalData),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        $("#btnSubmit").attr("disabled", true);
                        GetNext($(current).attr('data-id'));
                        window.location.href = "/ASPXView/ManageApproval.aspx";
                        swal({
                            title: "",
                            text: "Record saved successfully",
                            type: "success",
                        },
                            function (isConfirm) {
                                if (isConfirm) {
                                    window.location.href = "/Home/Home";
                                }
                            });
                    }
                    else if (data == 0 || data == -1) {
                        sweetAlert("", "Record not saved", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function CheckValidation() {
            var isVailed = true;
            $('#ddApprovalStatus').removeClass('validationError');
            if ($('#ddApprovalStatus').val() == "" || $('#ddApprovalStatus').val() == "0") {
                $('#ddApprovalStatus').addClass('validationError');
                isVailed = false;
            }
            $('#txtRemarks').removeClass('validationError');
            if ($('#txtRemarks').val() == "" && $('#ddApprovalStatus').val() != "1") {
                $('#txtRemarks').addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }

