            }

                .pagination li.page-item.active {
                    border: 1px solid rgba(0, 0, 0, 0.3);
                    background: linear-gradient(to bottom, rgba(230, 230, 230, 0.1) 0%, rgba(0, 0, 0, 0.1) 100%) !important;
