        }

        .modal-content {
            border-radius: 15px;
            background: #ffff;
            border: none !important;
        }

        .modal-header {
            border-radius: 10px 10px 0px 0px;
            justify-content: space-between;
            width: 100%;
        }

        .modal-header {
            background: #6186a7;
            display: flex;
            padding: 12px 15px !important;
        }

            .modal-header h5 {
                color: #fff;
