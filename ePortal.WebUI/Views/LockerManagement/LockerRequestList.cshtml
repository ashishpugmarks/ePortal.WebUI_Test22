<div class="panel-group theme_inner-page">

    <div class="panel panel-primary panel-2">
        <div class="align-items-center d-flex justify-content-between p10 panel-heading custom-panel-heading">
            <h2 class="panel-title">Locker Admin Approvals</h2>
        </div>
        <!-- Summary Statistics -->
        <!-- Summary Statistics -->
        <div class="stats-container">

            <div class="stat-card">
                <div class="stat-number">@Model.TotalRequest</div>
                <div class="stat-label">Total Requests</div>
            </div>

            <div class="stat-card">
                <div class="stat-number">@Model.PendingRequest</div>
                <div class="stat-label">Pending</div>
            </div>

            <div class="stat-card">
                <div class="stat-number">@Model.ApprovedRequest</div>
                <div class="stat-label">Approved</div>
            </div>

            <div class="stat-card">
                <div class="stat-number">@Model.ReallocateRequest</div>
                <div class="stat-label">Re-Allocate</div>
            </div>
        </div>


        <!-- Filter Section -->
        <div class="filter-section-outer">
            <div class="filter-section">
                @* <h5><i class="fas fa-filter"></i> Filter Items</h5> *@
                <form method="get" id="filterForm">
                    <div class="filter-row">
                        <div class="filter-group">
                            <label>Status</label>
                            <select id="statusFilter" class="form-control">
                                <option value="">All</option>
                                <option value="2">Requested</option>
                                <option value="3">Approved</option>
                                <option value="4">Assigned</option>
                                <option value="5">Released</option>
                            </select>
                        </div>
                        <div class="filter-group">
                            <label for="location">Location</label>
                            <select id="location" name="location" class="form-control">
                                <option value="">All Location</option>

                                @if (Model.Location != null && Model.Location.Any())
                                {
                                    foreach (var loc in Model.Location)
                                    {
                                        <option value="@loc.Value">@loc.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="filter-group">
                            <label for="dateFrom">Date From</label>
                            <input type="date" id="dateFrom" name="dateFrom" class="form-control" />
                        </div>
                        <div class="filter-group">
                            <label for="dateTo">Date To</label>
                            <input type="date" id="dateTo" name="dateTo" class="form-control" />
                        </div>
                        <div class="filter-actions">
                            <button type="button" class="btn-filter" id="btnFilter">
                                <i class="fas fa-search"></i> Search
                            </button>
                            <button type="button" class="btn-clear" id="clearFiltersBtn">
                                <i class="fas fa-times"></i> Clear
                            </button>
                            <button type="button" class="btn-export" id="exportToExcel">
                                <i class="fas fa-times"></i> Export
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="panel-body p15">
            @if (!Model.AdminRequest.Any())
            {
                         <div class="empty-state">
                             <h4>No Locker Requests Found</h4>
                         </div>
                             }
                             else
                             {
                         <div class="table-container">
                             <div class="table-responsive">
                        
                                 <table class="table" id="lockerTable">
                                     <thead>
                                         <tr>
                                             <th>Request No</th>
                                             <th>Employee Name/Code</th>
                                             <th>Location</th>
                                             <th>Department</th>
                                             <th>Designation</th>
                                             <th>Operation</th>

                                             <th>Request Date</th>
                                             <th>Status</th>
                                             <th>Floor</th>
                                             <th>Locker</th>
                                             <th>Locker Box</th>

                                             <th>Action</th>
                                         </tr>
                                     </thead>
                        
                                     <tbody>
                                                 @{
                                                     int count = 1;
                                                 }
                        
                                                 @foreach (var item in Model.AdminRequest)
                                                 {
                                             <tr>
                                                 <td>@item.Id</td>
                                                 <td>@item.EmployeeName</td>
                                                 <td>@item.SiteName</td>
                                                 <td>@item.EmployeeDepartment</td>
                                                 <td>@item.EmployeeDesignation</td>
                                                 <td>@item.EmployeeOperation</td>

                                        <td>@item.RequestDate?.ToString("dd MMM yyyy")</td>
                        
                                                 <td>
                                                     <span class="status-badge 
                                                 @(item.Status == 2 ? "status-pending" :
                                                   item.Status == 3 ? "status-approved" :
                                                   item.Status == 4 ? "status-assigned" :
                                                   "status-released")">
                                                                 @item.StatusText
                                                     </span>
                                                 </td>
                                                 <td  class="text-center">@(item.FloorName ?? "-")</td>
                                                 <td class="text-center">@(item.LockerName ?? "-")</td>
                                                 <td class="text-center">@(item.LockerBoxId?.ToString() ?? "-")</td>
                                        <td class="admin-actions">
                                            @if (item.Status == 2)
                                            {
                                                <button class="btn-approve"
                                                        data-requestid="@item.Id"
                                                        data-siteid="@item.SiteId">
                                                    Assign Locker
                                                </button>
                                            }
                                            @if (item.Status == 3)
                                            {
                                                <button class="btn-assign"
                                                        data-requestid="@item.Id"
                                                        data-siteid="@item.SiteId">
                                                    Assigned
                                                </button>
                                            }
                                            @if (item.Status == 4)
                                            {
                                                <button class="btn-release"
                                                        data-requestid="@item.Id"
                                                        data-siteid="@item.SiteId">
                                                    Release
                                                </button>
                                            }
                                        </td>
                                             </tr>
                                                     count++;
                                                 }
                        
                                     </tbody>
                                 </table>
                             </div>
                         </div>
            }  
        </div>
    </div>
</div>




<div class="modal fade approveModal" id="actionModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="approveModalLabel">Approve</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="requestIdHidden" />
                <input type="hidden" id="siteIdHidden" />
                <div class="stats-container">
                    <div class="stat-card">
                        <div class="stat-number" id="totalLockerCount">0</div>
                        <div class="stat-label">Total Locker</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="assignedLockerCount">0</div>
                        <div class="stat-label">Assigned Locker</div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-number" id="totalBoxCount">0</div>
                        <div class="stat-label">Total Locker Box</div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-number" id="assignedBoxCount">0</div>
                        <div class="stat-label">Total Assigned Box</div>
                    </div>

                </div>

                <form id="approveForm">
                    <div class="form-group">
                        <label>Floor</label>
                        <select id="floorDropdown" name="floorDropdown" class="form-control">
                            <option value="">Select Floor</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Select Locker</label>
                        <select class="form-control" id="lockerDropdown">
                            <option value="">-- Select Locker --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Select Locker Box</label>
                        <select class="form-control" id="lockerBoxDropdown">
                            <option value="">-- Select Locker Box --</option>
                        </select>
                    </div>


                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="submitApproveBtn">Approve</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>

            </div>
        </div>
    </div>
</div>




@section Scripts {
    <script nonce="@Context.Items["ScriptNonce_0"]">

    var originalRows = [];
    var allRows = [];
    var currentPage = 1;
    var rowsPerPage = 10;

    var currentAction = "";
    var selectedId = 0;

    $(document).ready(function () {

        originalRows = $('#lockerTable tbody tr').toArray();
        allRows = [...originalRows];

        bindFilters();
        bindActions();
    });

    // ==============================
    // FILTER SECTION
    // ==============================
    function bindFilters() {

        $("#btnFilter").click(function () {

            var statusVal = $("#statusFilter").val();
            var locationText = $("#location option:selected").text();
            var fromDate = $("#dateFrom").val();
            var toDate = $("#dateTo").val();

            var filtered = originalRows.filter(function (row) {

                var r = $(row);

                var rowStatus = r.find("td:nth-child(8)").text().trim();
                var rowLocation = r.find("td:nth-child(3)").text().trim();
                var rowDate = r.find("td:nth-child(7)").text().trim();

                if (statusVal && rowStatus !== getStatusText(statusVal))
                    return false;

                if ($("#location").val() && rowLocation !== locationText)
                    return false;

                if (fromDate || toDate) {

                    var d = new Date(rowDate);

                    if (fromDate && d < new Date(fromDate))
                        return false;

                    if (toDate && d > new Date(toDate))
                        return false;
                }

                return true;
            });

            $('#lockerTable tbody').empty().append(filtered);
            allRows = [...filtered];
        });

        $("#clearFiltersBtn").click(function () {

            $("#statusFilter").val("");
            $("#location").val("");
            $("#dateFrom").val("");
            $("#dateTo").val("");

            $('#lockerTable tbody').empty().append(originalRows);
            allRows = [...originalRows];
        });
    }

    function getStatusText(val) {

        if (val == "2") return "Requested";
        if (val == "3") return "Approved";
        if (val == "4") return "Assigned";
        if (val == "5") return "Released";

        return "";
    }

    // ==============================
    // BUTTON ACTIONS
    // ==============================
            function bindActions() {

        // APPROVE
                $(document).on("click", ".btn-approve", function () {

            var requestId = $(this).data("requestid");
            var siteId = $(this).data("siteid");

            // Store in hidden fields
            $("#requestIdHidden").val(requestId);
            $("#siteIdHidden").val(siteId);

            // Reset dropdowns
            $("#floorDropdown").val('');
            $("#lockerDropdown").html('<option value="">-- Select Locker --</option>');
            $("#lockerBoxDropdown").html('<option value="">-- Select Locker Box --</option>');

            // Reset stats
            $("#totalLockerCount").text(0);
            $("#assignedLockerCount").text(0);
            $("#totalBoxCount").text(0);
            $("#assignedBoxCount").text(0);

            // Load floors based on site
            loadFloors(siteId);

            // Open modal
            $("#actionModal").modal("show");
        });

                          function loadFloors(siteId) {

            $("#floorDropdown").html('<option value="">Loading...</option>');
            $("#lockerDropdown").html('<option value="">-- Select Locker --</option>');
            $("#lockerBoxDropdown").html('<option value="">-- Select Locker Box --</option>');

            // Reset all stats
            $("#totalLockerCount").text(0);
            $("#assignedLockerCount").text(0);
            $("#totalBoxCount").text(0);
            $("#assignedBoxCount").text(0);

            $.ajax({
                url: "/LockerManagement/GetFloorList",
                type: "GET",
                data: { siteId: siteId },
                success: function (response) {

                    $("#floorDropdown").empty();
                    $("#floorDropdown").append('<option value="">-- Select Floor --</option>');

                    if (response.success === false) {
                        alert(response.message);
                        return;
                    }

                    // Populate floors
                    $.each(response.Floors, function (i, item) {

                        $("#floorDropdown").append(
                            '<option value="' + item.Id + '">' + item.Name + '</option>'
                        );

                    });
                },
                error: function () {
                    alert("Unable to load floors");
                }
            });
        }
                    $(document).on("change", "#floorDropdown", function () {

            var floorId = $(this).val();

            $("#lockerDropdown").html('<option value="">Loading...</option>');

            // ✅ Reset locker box dropdown
            $("#lockerBoxDropdown").html('<option value="">-- Select Locker Box --</option>');

            // ✅ Reset ALL counts immediately
            $("#totalLockerCount").text(0);
            $("#assignedLockerCount").text(0);
            $("#totalBoxCount").text(0);
            $("#assignedBoxCount").text(0);

            if (!floorId) {
                $("#lockerDropdown").html('<option value="">-- Select Locker --</option>');
                return;
            }

            $.ajax({
                url: "/LockerManagement/GetLockerList",
                type: "GET",
                data: { floorId: floorId },
                success: function (response) {

                    $("#lockerDropdown").empty();
                    $("#lockerDropdown").append('<option value="">-- Select Locker --</option>');

                    // ✅ Update locker counts
                    $("#totalLockerCount").text(response.TotalLocker);
                    $("#assignedLockerCount").text(response.AssignedLocker);

                    $.each(response.Lockers, function (i, item) {
                        $("#lockerDropdown").append(
                            '<option value="' + item.Id + '">' + item.LockerName + '</option>'
                        );
                    });
                },
                error: function () {
                    alert("Unable to load lockers");

                    $("#lockerDropdown").html('<option value="">-- Select Locker --</option>');
                }
            });
        });

                           $(document).on("change", "#lockerDropdown", function () {

            var lockerId = $(this).val();

            $("#totalBoxCount").text(0);
            $("#assignedBoxCount").text(0);

            $("#lockerBoxDropdown").html('<option value="">Loading...</option>');

            if (!lockerId) {
                $("#lockerBoxDropdown").html('<option value="">-- Select Locker Box --</option>');
                return;
            }

            $.ajax({
                url: "/LockerManagement/GetLockerBoxList",
                type: "GET",
                data: { lockerId: lockerId },
                success: function (response) {

                    $("#lockerBoxDropdown").empty();
                    $("#lockerBoxDropdown").append('<option value="">-- Select Locker Box --</option>');

                    $("#totalBoxCount").text(response.TotalLockerBox);
                    $("#assignedBoxCount").text(response.TotalAssignedBox);

                    $.each(response.Boxes, function (i, item) {
                        $("#lockerBoxDropdown").append(
                            '<option value="' + item.Id + '">' + item.BoxNumber + '</option>'
                        );
                    });
                },
                error: function () {
                    alert("Unable to load locker boxes");
                }
            });
        });
        // ASSIGN
        $(document).on("click", ".btn-assign", function () {

            selectedId = $(this).data("id");
            currentAction = "assign";

            $("#selectedId").val(selectedId);
            $("#actionText").text("Are you sure you want to ASSIGN locker?");
            $("#actionModal").modal("show");
        });

        // RELEASE
        $(document).on("click", ".btn-release", function () {

            selectedId = $(this).data("id");
            currentAction = "release";

            $("#selectedId").val(selectedId);
            $("#actionText").text("Are you sure you want to RELEASE this locker?");
            $("#actionModal").modal("show");
        });

        // CONFIRM ACTION
        $("#confirmAction").click(function () {

            var id = $("#selectedId").val();
            var url = "";

            if (currentAction == "approve")
                url = "/Locker/ApproveRequest";

            if (currentAction == "assign")
                url = "/Locker/AssignLocker";

            if (currentAction == "release")
                url = "/Locker/ReleaseLocker";

            $.ajax({
                url: url,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ AssignId: id }),
                success: function (res) {

                    $("#actionModal").modal("hide");

                    if (res.success) {
                        alert("Action completed successfully");
                        location.reload();
                    }
                    else {
                        alert("Operation failed");
                    }
                },
                error: function () {
                    $("#actionModal").modal("hide");
                    alert("Something went wrong");
                }
            });
        });
    }

    // ==============================
    // EXPORT TO EXCEL
    // ==============================
    $("#exportToExcel").click(function () {

        var table = document.getElementById("lockerTable");
        var html = table.outerHTML;

        var url = 'data:application/vnd.ms-excel,' + escape(html);

        var link = document.createElement("a");
        link.href = url;
        link.download = "LockerRequests.xls";
        link.click();
    });

</script>
}