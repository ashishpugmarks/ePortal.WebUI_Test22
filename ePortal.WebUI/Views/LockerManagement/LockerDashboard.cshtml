@model ePortal.ViewModels.Locker.LockerManagementViewModel
@{
    ViewData["Title"] = "Locker Management";
}

<style>
    /* Reset any conflicting styles */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background-color: #f5f5f5;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
    }

    .locker-management {
        width: 100%;
        min-height: 90vh;
        padding: 25px 30px;
        background-color: #ffffff;
        margin: 0;
    }

    /* Company Header */
    .company-header {
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid #e0e0e0;
    }

        .company-header h1 {
            font-size: 32px;
            font-weight: 700;
            color: #1a1a1a;
            margin: 0 0 5px 0;
            letter-spacing: 1px;
        }

        .company-header h2 {
            font-size: 24px;
            font-weight: 500;
            color: #333;
            margin: 0;
        }

    /* Filter Section */
    .filter-section {
        background-color: #f8f9fa;
        padding: 25px;
        border-radius: 8px;
        margin-bottom: 30px;
        border: 1px solid #e5e5e5;
    }

    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: flex-end;
    }

    .filter-group {
        flex: 1 1 200px;
        min-width: 180px;
    }

        .filter-group label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: #444;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .filter-group select,
        .filter-group .filter-select {
            width: 100%;
            padding: 10px 12px;
            font-size: 14px;
            color: #333;
            background-color: #ffffff;
            border: 1px solid #ccc;
            border-radius: 4px;
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23333' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
            background-repeat: no-repeat;
            background-position: right 12px center;
            background-size: 16px;
            cursor: pointer;
        }

            .filter-group select:hover,
            .filter-group .filter-select:hover {
                border-color: #999;
            }

            .filter-group select:focus,
            .filter-group .filter-select:focus {
                outline: none;
                border-color: #0066cc;
                box-shadow: 0 0 0 2px rgba(0,102,204,0.1);
            }

            .filter-group select option {
                padding: 8px;
            }

    .filter-actions {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .btn-search {
        padding: 10px 25px;
        font-size: 14px;
        font-weight: 600;
        color: #ffffff;
        background-color: #28a745;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        min-width: 120px;
        letter-spacing: 0.5px;
    }

        .btn-search:hover {
            background-color: #333;
        }

    .btn-export {
        display: inline-block;
        padding: 10px 25px;
        font-size: 14px;
        font-weight: 600;
        color: #ffffff;
        background-color: #337ab7;
        border: none;
        border-radius: 4px;
        text-decoration: none;
        letter-spacing: 0.5px;
        cursor: pointer;
        margin: 0 0 0 111px;
    }

    .btn-clear {
        display: inline-block;
        padding: 10px 25px;
        font-size: 14px;
        font-weight: 600;
        color: #ffffff;
        background-color: #dc3545;
        border: none;
        border-radius: 4px;
        text-decoration: none;
        letter-spacing: 0.5px;
        cursor: pointer;
    }

    .btn-export:hover {
        background-color: #286090;
    }

    .btn-clear:hover {
        background-color: #c82333;
    }

    /* Locker Grid */
    .locker-grid {
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        gap: 8px;
        margin: 25px 0;
    }

    .locker-box {
        padding: 8px 4px;
        text-align: center;
        border-radius: 6px;
        min-height: 90px;
        font-size: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        border: 1px solid rgba(0,0,0,0.1);
        display: flex;
        flex-direction: column;
    }

    .locker-vacant {
        background-color: #4CAF50;
        color: black;
    }

    .locker-occupied {
        background-color: #F6C6AD;
        color: black;
    }

    .locker-number {
        font-weight: 700;
        font-size: 13px;
        margin-top: 4px;
    }

    .locker-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 50px;
    }

    .locker-detail {
        line-height: 1.3;
        word-break: break-word;
        font-size: 17px;
        font-weight: bold;
    }

    .locker-vacant {
        line-height: 1.3;
        word-break: break-word;
        font-size: 21px;
        font-weight: bold;
    }

    /* Summary Section */
    .summary-section {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 30px;
    }

    .summary-box1 {
        background-color: #ffe600;
        padding: 20px;
        text-align: center;
        border-radius: 6px;
        font-weight: 600;
        border: 1px solid #e6c300;
    }

    .summary-box2 {
        background-color: #F6C6AD;
        padding: 20px;
        text-align: center;
        border-radius: 6px;
        font-weight: 600;
        border: 1px solid #F6C6AD;
    }

    .summary-box3 {
        background-color: #28a745;
        padding: 20px;
        text-align: center;
        border-radius: 6px;
        font-weight: 600;
        border: 1px solid #28a745;
    }

    .summary-label {
        font-size: 16px;
        color: #333;
        margin-bottom: 8px;
    }

    .summary-value {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .no-results {
        grid-column: 1 / -1;
        text-align: center;
        padding: 40px;
        background-color: #f8f9fa;
        border-radius: 6px;
        color: #dc3545;
        font-size: 16px;
        font-weight: 500;
        border: 1px dashed #dc3545;
    }

    /* Responsive Design */
    @@media (max-width: 1400px) {
        .locker-grid {
            grid-template-columns: repeat(6, 1fr);
        }
    }

    @@media (max-width: 1200px) {
        .locker-grid {
            grid-template-columns: repeat(5, 1fr);
        }
    }

    @@media (max-width: 992px) {
        .locker-grid {
            grid-template-columns: repeat(4, 1fr);
        }

        .filter-row {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-group {
            width: 100%;
        }

        .btn-search {
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .locker-management {
            padding: 15px;
        }

        .locker-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .summary-section {
            grid-template-columns: 1fr;
        }

        .welcome-bar {
            flex-direction: column;
            gap: 10px;
            text-align: center;
        }

        .welcome-links a {
            margin: 0 10px;
        }
    }

    @@media (max-width: 576px) {
        .locker-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<div class="locker-management">

    <!-- Company Header -->
    <div class="company-header">
        <h2><b>Locker Management</b></h2>
    </div>

    <!-- SEARCH FORM -->
    <form method="post">
        <div class="filter-section">
            <div class="filter-row">
                <div class="filter-group">
                    <label>Location</label>
                    <select asp-for="SelectedLocation" class="filter-select">
                        <option value="">-- Select Location --</option>
                        @foreach (var loc in Model.Location)
                        {
                            <option value="@loc">@loc</option>
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label>Floor</label>
                    <select asp-for="SelectedFloor" class="filter-select">
                        <option value="">-- Select Floor --</option>
                        @foreach (var dept in Model.Floor)
                        {
                            <option value="@dept">@dept</option>
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label>Locker</label>
                    <select asp-for="SelectedMainLocker" class="filter-select">
                        <option value="">-- Select Main Locker --</option>
                        @foreach (var locker in Model.MainLocker)
                        {
                            <option value="@locker">@locker</option>
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <div class="filter-actions">
                        <button type="submit" class="btn-search">Search</button>
                        <button type="button" class="btn-clear">Clear</button>
                        <a asp-action="Export"
                           asp-route-location="@Model.SelectedLocation"
                           asp-route-department="@Model.SelectedFloor"
                           asp-route-mainLocker="@Model.SelectedMainLocker"
                           class="btn-export">
                            Export
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- RESULTS SECTION -->
    @if (Model.ShowResults)
    {
        <div class="locker-grid">
            @if (Model.SubLockers != null && Model.SubLockers.Any())
            {
                foreach (var locker in Model.SubLockers)
                {
                    <div class="locker-box @(locker.IsOccupied ? "locker-occupied" : "locker-vacant")">
                        <div class="locker-number">Locker No - @locker.LockerNumber</div>
                        <div class="locker-content">
                            @if (locker.IsOccupied)
                            {
                                <div class="locker-detail">@locker.EmployeeName</div>
                                <div class="locker-detail">@locker.EmployeeCode</div>
                            }
                            else
                            {
                                <div class="locker-vacant">Vacant</div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-results">
                    No lockers found for selected combination.
                </div>
            }
        </div>

        <!-- SUMMARY -->
        <div class="summary-section">
            <div class="summary-box1">
                <div class="summary-label">Total Locker Count</div>
                <div class="summary-value">@Model.TotalLockers</div>
            </div>
            <div class="summary-box2">
                <div class="summary-label">Total Occupied</div>
                <div class="summary-value">@Model.TotalOccupied</div>
            </div>
            <div class="summary-box3">
                <div class="summary-label">Total Available</div>
                <div class="summary-value">@Model.TotalAvailable</div>
            </div>
        </div>
    }
</div>