<div class="panel-group">

    <div class="panel panel-primary" style="height:325px;">
        <div class="panel-heading">
            <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Non SAP Role Master Edit</h2>
        </div>

        <div class="panel-body">
            <div style="margin-top:25px;">
                <div class="col-md-2" style="display:flex; flex-direction:row; padding-bottom:15px; margin-left:17px;">
                    <label style="padding-bottom:5px; width:108px">Sysite</label>
                    <div class="col-md-2" style="margin-left:37px; width:245px;">
                        <select id="ddlPlantCode" class="form-control" ></select>
                    </div>
                </div>

                <div class="col-md-2" style="margin-left: 17px; display:flex; flex-direction:row; padding-bottom:15px">

                    <label style="padding-bottom:5px;">Department</label>
                    <div class="col-md-2" style="margin-left:36px; width:245px;">
                    @*     <select id="ddlDepartment" class="form-control">
                            <option value="">--Select--</option>
                            <option value="Taxation" @(obj.DEPARTMENT == "Taxation" ? "selected" : "")>Taxation</option>
                            <option value="Finance" @(obj.DEPARTMENT == "Finance" ? "selected" : "")>Finance</option>
                     </select> *@
                        @Html.DropDownList("ddlDepartment", new List<SelectListItem>
                        {
                        new SelectListItem { Text = "--Select--", Value = "" },
                        new SelectListItem { Text = "Taxation", Value = "Taxation", Selected = obj.DEPARTMENT == "Taxation" },
                        new SelectListItem { Text = "Finance", Value = "Finance", Selected = obj.DEPARTMENT == "Finance" }
                        }
                                 , htmlAttributes: new { @class = "form-control", @id = "ddlDepartment" })
                    </div>
                </div>
                
                
                <div class="col-md-2 @(obj.DEPARTMENT.Trim().ToUpper() == "FINANCE" ? "" : "hidden" ) " style="margin-left: 17px; display:flex; flex-direction:row; padding-bottom:15px" id="DivSAP">

                    <label style="padding-bottom:5px;"> SAP Rights</label>
                    <div class="col-md-2" style="margin-left:41px; width:245px;">
                        @* <select id="ddlSAPRight" class="form-control">
                            <option value="POST" @(obj.POST == "Y" ? "selected" : "")>POST</option>
                            <option value="REVERSE" @(obj.REVERSE == "Y" ? "selected" : "")>REVERSE</option>
                        </select> *@
                        @Html.DropDownList("ddlSAPRight", new List<SelectListItem>
                        {
                        new SelectListItem { Text = "POST", Value = "POST", Selected = obj.POST == "Y" },
                        new SelectListItem { Text = "REVERSE", Value = "REVERSE", Selected = obj.REVERSE == "Y" }
                        }
                                 , htmlAttributes: new { @class = "form-control", @id = "ddlSAPRight" })
                    </div>
                </div>
                

                <div class="col-md-2" style="display:flex; flex-direction:row; padding-bottom:5px; margin-left:17px;">
                    <label style="padding-bottom:20px;">ECode</label>
                    <div class="col-md-2" style="margin-left:87px; width:245px;">
                        <input id="ECode" name="ECode" type="text" class="form-control mb-3" value=@obj.ECODE autocomplete="off" />
                        <span id="searchTerm"></span>
                    </div>
                </div>
                <div class="col-lg-2" style="margin:10px;">
                    <button type="submit" id="btnsubmit" class="btn btn-block btn-success" ><i class="menu-icon fa fa-save"></i> &nbsp; Update</button>
