@section Scripts{
    <script src="~/js/jquery-ui.js"></script>
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $(document).ready(function () {
        debugger;
        BindPlantName();

        $("#ddlPlantCode").val(@obj.SYSITEID);

    });



    $(function () {
        debugger;
        var Term = $("#ECode").val();
        $("input#ECode").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/NSPPayment/AutocompleteSuggestions",
                    data: { term: request.term, catagory: "Employees" },
                    dataType: "json",
                    method: "GET",
                    success: function (data) {
                        debugger;

                        var MainData = JSON.parse(data);
                        var EmployeeList = MainData.EmployeeList;
                         if (EmployeeList != "") {
                            debugger;
                            const suggestions = EmployeeList.map(function (suggestion) {
                                return {
                                    label: suggestion.ADEMPCODE + "-" + suggestion.FIRSTNAME + " " + suggestion.LASTNAME,
                                    name: suggestion.FIRSTNAME + " " + suggestion.LASTNAME,
                                    value: suggestion.ADEMPCODE

                                };
                            });
                            debugger;
                            response(suggestions);

                        }
                        else {
                            response([]);
                        }
                    },
                    error: function (error) {
                        console.error("Error fetching autocomplete suggestions:", error);
                        response([]);
                    },
                });
            },
            minLength: 2,
            select: function (event, ui) {
                debugger;
                if (ui.item) {
                    $("#searchTerm").val(ui.item.value);
                }

            }
        });
    });


    function BindPlantName() {
        debugger;
        $.ajax({
            async: false,
            type: "GET",
            url: "/NSPPayment/BindPlantName",

            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                debugger;
                if (data != "[]") {

                    var Data1 = JSON.parse(data);
                    var ddlDesi = $('#ddlPlantCode');
                    var Data2 = Data1.resultObject.sort();
                    ddlDesi.empty();

                    $.each(Data2, function (i, r) {
                        ddlDesi.append($('<option>', {
                            value: r.Value,
                            text: r.Text
                        }));
                    });

                    ddlDesi.append($('<option>', {
                        value: 0,
                        text: "- Please select Plant Name -"
                    }));

                    ddlDesi.val(0);
                }
            },
            complete: function () {
            },
            error: function () {
                sweetAlert("Oops...", "Something went wrong!", "error");
            }
        });

    }

    function Save() {
        debugger;

        var _Sysitid = $('#ddlPlantCode').val();
        if (_Sysitid === "- Select -") {
            alert("Please select a Site.");
            $('#ddlPlantCode').focus();
            return;
        }

        var _Department = $('#ddlDepartment').val();
        if (_Department === "- Select -") {
            alert("Please select a Department.");
            $('#ddlDepartment').focus();
            return;
        }

        var _ECode = $('#ECode').val();

        if (!_ECode || isNaN(parseInt(_ECode.split("-")[0].trim()))) {
            alert("Please enter a valid Employee code.");
            $('#ECode').focus();
            return;
        }

        $("#btnsubmit").attr('disabled', true);

        var POST = $("#ddlSAPRight").val() === "POST" ? "Y" : "N";
        var REVERSE = $("#ddlSAPRight").val() !== "POST" ? "Y" : "N";


        var jsonData = JSON.stringify({
            SRNO:@obj.SRNO,
            SYSITEiD: _Sysitid,
            DEPARTMENT: _Department,
            ECODE: parseInt(_ECode.split("-")[0].trim()),
            POST: POST,
            REVERSE: REVERSE
        });


        var URL = '/NSPPayment/NSP_Role_Master_SaveAndUpdate_Data';
        var Mode = "UPDATE";

        console.log('Mode :' + Mode);
        console.log('jsonData :' + jsonData);
        console.log('jsonData stringify:' + JSON.stringify(jsonData));

        $.ajax({
            type: "POST",
            url: URL,
            data: {
                Data: jsonData,
                Mode: Mode
            },
            success: function (data) {

                var dataobj = JSON.parse(data);
                alert(dataobj.errorMessage);
                $("#btnsubmit").attr('disabled', false);

                parent.jQuery.fancybox.close();

            },
            error: function () {
                alert("Error: While calling AJAX.");
                $("#btnsubmit").attr('disabled', false);
            }
        });

    }


    function DepartmentChange() {
        var dept = $("#ddlDepartment").val();

        if (dept == "Finance") {
            $("#DivSAP").removeClass('hidden');
        } else {
            $("#DivSAP").addClass('hidden');
        }
    }


</script>
    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#btnsubmit').on('click', function () {
                Save($(this)[0]);
            });
            $('#ddlDepartment').on('change', function () {
                DepartmentChange($(this)[0]);
            });
        });
    </script>
}


