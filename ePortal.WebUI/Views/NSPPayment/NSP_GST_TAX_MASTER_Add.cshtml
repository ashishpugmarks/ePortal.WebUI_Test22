    }

    .div_disable {
        pointer-events: none;
        opacity: 0.9;
        background: #eee;
        color: black;
    }

    .required::after {
        content: "*";
        font-weight: 800;
        color: red;
        margin-left: 5px;
    }

    .ui-widget {
        font-family: Verdana,Arial,sans-serif;
        font-size: 0.6em !important;
        overflow: auto;
        max-height: 150px;
    }
</style>
}
<div class="panel-group">
    <div class="panel panel-primary" style="height:auto;">
        <div class="panel-heading">
            <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Non SAP GST Master Add</h2>
        </div>
        <div class="panel-body">
        
                <div class="container">
                    <!-- First Row: 4 Columns -->
                    <div class="row mb-3" style="display:flex;">
                        <div class="col-lg-3 col-md-6 mb-3" style="margin: 10px;">
                            <label for="ddlTaxType">Tax Type:</label>
                            <select id="ddlTaxType" name="taxType" class="form-control">
                                <option value="Forward Charge">Forward Charge</option>
                                <option value="RCM Charges">RCM Charges</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3"  style="margin: 10px;">
                            <label for="ddlGSTType">Type:</label>
                            <select id="ddlGSTType" name="gstType" class="form-control">
                                <option value="SGST/CGST">SGST/CGST</option>
                                <option value="IGST">IGST</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3"  style="margin: 10px;">
                            <label for="ddlISDeduct">Is Deducted?:</label>
                            <select id="ddlISDeduct" name="isDeducted" class="form-control">
                                <option value="Y">Y</option>
                                <option value="N">N</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3"  style="margin: 10px;">
                            <label for="txtTaxCode">Tax Code:</label>
                            <input id="txtTaxCode" name="taxCode" type="text" class="form-control" placeholder="Tax Code" autocomplete="off" />
                        </div>
                    </div>
                    <!-- Second Row: 4 Columns -->
                    <div class="row mb-3" style="display:flex;">
                        <div class="col-lg-3 col-md-6 mb-3"  style="margin: 10px;">
                            <label for="txtRate1">Rate 1:</label>
                            <input id="txtRate1" name="rate1" type="text" class="form-control" placeholder="Rate 1" autocomplete="off" />
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3"  style="margin: 10px;">
                            <label for="txtRate2">Rate 2:</label>
                            <input id="txtRate2" name="rate2" type="text" class="form-control" placeholder="Rate 2" disabled autocomplete="off" />
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3" id="DivReGl1"  style="margin: 10px;">
                            <label for="txtGLAcc1">GL Account 1:</label>
                            <input id="txtGLAcc1" name="glAcc1" type="text" class="form-control" placeholder="GL Account 1" autocomplete="off" />
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3" id="DivReGl2"  style="margin: 10px;">
                            <label for="txtGLAcc2">GL Account 2:</label>
                            <input id="txtGLAcc2" name="glAcc2" type="text" class="form-control" placeholder="GL Account 2" disabled autocomplete="off" />
                        </div>
                    </div>
                    <!-- Third Row: 5 Columns -->
                    <div class="row mb-3" style="display:flex;">
                        <div class="col-lg-2 col-md-4 mb-3"  style="margin: 10px;">
                            <label for="txtProCenter">Profit Center:</label>
                            <input id="txtProCenter" name="proCenter" type="text" class="form-control" placeholder="Type Here Profit Center..." autocomplete="off" />
                        </div>
                        <div class="col-lg-2 col-md-4 mb-3"  id="DivPaGl1"  style="margin: 10px;">
                            <label for="txtPayableGL1">Payable GL 1:</label>
                            <input id="txtPayableGL1" name="payableGL1" type="text" class="form-control" placeholder="Payable" autocomplete="off" />
                        </div> 
                        <div class="col-lg-2 col-md-4 mb-3" id="DivPaGl2"  style="margin: 10px;">
                            <label for="txtPayableGL2">Payable GL 2:</label>
                            <input id="txtPayableGL2" name="payableGL2" type="text" class="form-control" placeholder="Payable" autocomplete="off" />
                        </div>
                        <div class="col-lg-2 col-md-4 mb-3"  style="margin: 10px;">
                            <label for="txtCessRate">Cess Rate:</label>
                            <input id="txtCessRate" name="cessRate" type="text" class="form-control" placeholder="Cess Rate" autocomplete="off" />
                        </div>
                        <div class="col-lg-2 col-md-4 mb-3"  style="margin: 10px;">
                            <label for="txtCessGL">Cess GL:</label>
                            <input id="txtCessGL" name="cessGL" type="text" class="form-control" placeholder="Cess GL" autocomplete="off" />
                        </div>
                    </div>
                    <!-- Submit Button -->
                    <div class="row">
                        <div class="col-lg-12 text-center"  style="margin: 10px;">
                            <button type="submit" id="btnsubmit"  class="btn btn-success"><i class="menu-icon fa fa-save"></i> &nbsp; Save</button>
                        </div>
                    </div>
                </div>
           
        </div>
    </div>
</div>

@section Scripts{
<script src="~/js/jquery-ui.js"></script>
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $(document).ready(function () {
        debugger;
        updateFormFields();
        $('#ddlGSTType').change(updateFormFields);
        $('#ddlTaxType').change(showHideFields);
        $('#ddlISDeduct').change(showHideFields);
        $('#txtRate1').on('input', function () {
            var selectedType = $('#ddlGSTType').val();
            if (selectedType == 'SGST/CGST') {
                $('#txtRate2').val($(this).val());
            }
        });
        showHideFields();
    });

    
    function Save() {
        debugger;
        $('#loader_new').removeClass('hidden');

        // Collect values from form fields
        var taxType = $('#ddlTaxType').val();
        var gstType = $('#ddlGSTType').val();
        var taxCode = $('#txtTaxCode').val();
        var rate1 = $('#txtRate1').val();
        var rate2 = $('#txtRate2').val();
        var glAcc1 = $('#txtGLAcc1').val();
        var glAcc2 = $('#txtGLAcc2').val();
        var profitCenter = $('#txtProCenter').val();
        var isDeducted = $('#ddlISDeduct').val();
        var PayableGL1 = $('#txtPayableGL1').val();
        var PayableGL2 = $('#txtPayableGL2').val();
        var CessRate = $('#txtCessRate').val(); 
        var CessGL = $('#txtCessGL').val();

    

        if (taxCode === "") {
            alert("Please enter Tax Code.");
            $('#txtTaxCode').focus();
            $('#loader_new').addClass('hidden');
            return;
        }
        if (rate1 === "") {
            alert("Please enter Rate 1.");
            $('#txtRate1').focus();
            $('#loader_new').addClass('hidden');
            return;
        }
       
        if (profitCenter === "") {
            alert("Please enter Profit Center.");
            $('#txtProCenter').focus();
            $('#loader_new').addClass('hidden');
            return;
        }

        $("#btnsubmit").attr('disabled', true);
        // Create JSON object
        var jsonData = JSON.stringify({
            TAXTYPE: taxType,
            TYPE: gstType,
            TAXCODE: taxCode,
            VATRATE1: parseFloat(rate1),
            VATRATE2: parseFloat(rate2),
            GLACC1: glAcc1 ? parseInt(glAcc1) : null,
            GLACC2: glAcc2 ? parseInt(glAcc2) : null,
            PROFITCENTER: profitCenter,
            ISDEDUCTED: isDeducted,
            PAYABLE_GLACC1: PayableGL1,
            PAYABLE_GLACC2: PayableGL2,
            CESS_RATE : CessRate,
            CESS_GLACC : CessGL
            
        });

        var URL = '/NSPPayment/NSP_GST_TAX_MASTER_SaveData';
        console.log(jsonData);
        $.ajax({
            type: "POST",
            url: URL,
            data: {
                Data: jsonData,Mode:"ADD"
            },
            success: function (data) {
                var dataobj = JSON.parse(data);
                alert(dataobj.errorMessage);
                $('#loader_new').addClass('hidden');
                parent.jQuery.fancybox.close();
                $("#btnsubmit").attr('disabled', false);
            },
            error: function () {
                alert("Error: While calling AJAX.");
                $('#loader_new').addClass('hidden');
                $("#btnsubmit").attr('disabled', false);
            }
        });
    }
    function updateFormFields() {
        var selectedType = $('#ddlGSTType').val();

        if (selectedType == 'SGST/CGST') {

            $('#txtRate2').val($('#txtRate1').val());
        }
        else {
            $('#txtRate2').val('');
        }

        if (selectedType == 'IGST') {

            $('#txtGLAcc2').prop('disabled', true);
            $('#txtGLAcc2').val('');
            $('#txtRate2').val('');
            $('#txtPayableGL2').prop('disabled', true);
            $('#txtPayableGL2').val('');
        }
        else {
            $('#txtGLAcc2').prop('disabled', false);
            $('#txtGLAcc2').val('');
            $('#txtRate2').val('');
            $('#txtPayableGL2').prop('disabled', false);
            $('#txtPayableGL2').val('');
        }
       
    }

    function showHideFields() {
        var TaxType = $("#ddlTaxType").val();
        var IsDeduct = $("#ddlISDeduct").val();

        var glAcc1 = $('#txtGLAcc1');
        var glAcc2 = $('#txtGLAcc2');
        var PayableGL1 = $('#txtPayableGL1');
        var PayableGL2 = $('#txtPayableGL2');

        var DivReGL1 = $("#DivReGl1");
        var DivReGL2 = $("#DivReGl2");
        var DivPaGL1 = $("#DivPaGl1");
        var DivPaGL2 = $("#DivPaGl2");

        // Default to hide all fields
        DivReGL1.addClass('hidden');
        DivReGL2.addClass('hidden');
        DivPaGL1.addClass('hidden');
        DivPaGL2.addClass('hidden');

        // Show or hide fields based on conditions
        if (TaxType == "Forward Charge") {
            if (IsDeduct == "Y") {
                DivReGL1.removeClass('hidden');
                DivReGL2.removeClass('hidden');
                PayableGL1.val('');
                PayableGL2.val('');
            } else if (IsDeduct == "N") {
                DivReGL1.addClass('hidden');
                DivReGL2.addClass('hidden');
                DivPaGL1.addClass('hidden');
                DivPaGL2.addClass('hidden');
                glAcc1.val('');
                glAcc2.val('');
                PayableGL1.val('');
                PayableGL2.val('');

            }
        } else if (TaxType == "RCM Charges") {
            if (IsDeduct == "Y") {
                DivReGL1.removeClass('hidden');
                DivReGL2.removeClass('hidden');
                DivPaGL1.removeClass('hidden');
                DivPaGL2.removeClass('hidden');
            } else if (IsDeduct == "N") {
                DivPaGL1.removeClass('hidden');
                DivPaGL2.removeClass('hidden');
                glAcc1.val('');
                glAcc2.val('');
            }
        }
    }


</script>
@* CSP 3.0 Compliant changes *@
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    $(document).ready(function () {
        $('#btnsubmit').on('click', function () {
            Save($(this)[0]);
        });
    });
</script>
}
