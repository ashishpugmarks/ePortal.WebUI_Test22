            function formatTimeFromTimestamp(timestamp) {
            if (timestamp == null) {
                return "";
            }

            const isoDate = new Date(timestamp);

            if (!isNaN(isoDate.getTime())) {
                let hours = isoDate.getHours();
                const minutes = ("0" + isoDate.getMinutes()).slice(-2);
                const seconds = ("0" + isoDate.getSeconds()).slice(-2);
                const ampm = hours >= 12 ? 'PM' : 'AM';
                hours = hours % 12;
                hours = hours ? hours : 12;

                return `${("0" + hours).slice(-2)}:${minutes}:${seconds} ${ampm}`;
            } else {
                const timestampStr = timestamp.toString().match(/\d+/)?.[0];
                const date = new Date(parseInt(timestampStr));

                if (isNaN(date.getTime())) {
                    return "";
                }

                let hours = date.getHours();
                const minutes = ("0" + date.getMinutes()).slice(-2);
                const seconds = ("0" + date.getSeconds()).slice(-2);
                const ampm = hours >= 12 ? 'PM' : 'AM';
                hours = hours % 12;
                hours = hours ? hours : 12;

                return `${("0" + hours).slice(-2)}:${minutes}:${seconds} ${ampm}`;
            }
        }

