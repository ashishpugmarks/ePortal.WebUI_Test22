        $('#modalDtID').val(rowIndex);

        totalAmount = total; // Set the total amount
        splitData = []; // Reset split data
        rowCounter = 0; // Reset row counter
        $('#splitGrid').empty(); // Clear existing rows

        const tableData = getTableData();
        localStorage.setItem('tableData', JSON.stringify(tableData));

        $('#splitModal').modal('show');
    }
    function addSplitAmount() {
        debugger;
        const amount = parseFloat($('#splitAmount').val()) || 0;
        let  existingTotal= 0;


        $('#splitGrid tr').each(function () {
            const rowAmount = parseFloat($(this).find('td').eq(2).text()) || 0;
            existingTotal +=rowAmount;
        });

        if (amount <= 0) {
            alert('Amount must be greater than 0.');
            return;
        }

        var CurTotal = parseFloat(existingTotal) + parseFloat(amount);
        var totalAmountNumber = parseFloat(totalAmount);
        if (CurTotal > totalAmountNumber) {
            alert('The total split amount cannot exceed the invoice total amount.');
            return;
        }




        const newRowId = rowCounter++;
        splitData.push({ amount: amount, id: newRowId });

        $('#splitGrid').append(`
        <tr id="row_${newRowId}">
            <td>${$('#modalInvoiceNo').val()}</td>
            <td>${$('#modalInvoiceDate').val()}</td>
            <td>${amount.toFixed(2)}</td>
        <td><center><a title="Delete" data-ctrl-id="delete-btn" data-delete-id=${newRowId}><i class="ace-icon fa fa-trash" style="color: red;"></i></a></center></td>


        </tr>
    `);
    // CSP 3.0 Compliant changes
    $('[data-ctrl-id="delete-btn"]').on('click', function () {
        deleteSplitAmount($(this).data('delete-id'));
    });

        // Clear the input field
        $('#splitAmount').val('');
    }
    function deleteSplitAmount(rowId) {
        $(`#row_${rowId}`).remove();
        // Remove from splitData
        splitData = splitData.filter(item => item.id !== rowId);
    }
    function submitSplit() {
        debugger;
        let  existingTotal= 0;


        $('#splitGrid tr').each(function () {
            const rowAmount = parseFloat($(this).find('td').eq(2).text()) || 0;
            existingTotal += rowAmount;
        });

        var CurTotal = parseFloat(existingTotal) ;
        var totalAmountNumber = parseFloat(totalAmount);

        if (CurTotal  > totalAmountNumber) {
            alert('The total amount is mismatched. Please review and adjust the amounts to ensure they match the total.');
            return;
        }


        var rowIndex = $('#modalDtID').val();
        var NewGlobalDtList = [];
        var item = GlobalDtList[rowIndex];

        // Clear any existing entries related to the current invoice number

        var invDate_ = $('#modalInvoiceDate').val();
        var invAmount_ = $('#modalInvoiceAmount').val();
        var invNo_ = $('#modalInvoiceNo').val();


        GlobalDtList.forEach(function (r) {
            if (r.InvoiceNo !== invNo_ && r.Amount !== invAmount_ && r.InvoiceDate !== invDate_  ) {
                debugger;
                var newR = JSON.parse(JSON.stringify(r));
                NewGlobalDtList.push(newR);
            }
        });

        var i = 0;
        // Iterate through rows in splitGrid and add new items
        $('#splitGrid tr').each(function () {
            debugger;
            const rowAmount = parseFloat($(this).find('td').eq(2).text()) || 0;

            // Clone the item object to avoid modifying the same instance
            var newItem = JSON.parse(JSON.stringify(item));
            newItem.Amount = rowAmount;
            newItem.BaseAmount = rowAmount;
            newItem.TDSBaseAmount = rowAmount;
            newItem.APPROVED_AMOUNT = rowAmount;
            newItem.Split  = (i == 0 ? "0" : "1");
            newItem.RowSrNo = -1;

            NewGlobalDtList.push(newItem);
            i++;
        });

        // Update the GlobalDtList with the new list
        GlobalDtList = NewGlobalDtList;

        // Call the function to update the grid or perform any additional actions
        AppendInvoiceData(GlobalDtList, GlobalAppStatus);





        // Close the modal
        $('#splitModal').modal('hide');


    }

    function getTableData() {
        const table = document.getElementById('tblPaymentDttitle');
        const rows = table.querySelectorAll('tbody tr');
        const tableData = [];

        rows.forEach(row => {
            const cells = row.querySelectorAll('td');
            const rowData = {};

            cells.forEach((cell, index) => {
                const cellId = cell.querySelector('input, select')?.id || `cell_${index}`;
                const cellValue = cell.querySelector('input, select')?.value || cell.textContent.trim();
                rowData[cellId] = cellValue;
            });

            tableData.push(rowData);
        });

        return tableData;
    }
    function toggleCommission(index) {
        var commissionInput = document.getElementById('commission_' + index);
        var toggleButton = document.getElementById('toggleCommission_' + index);
        if (commissionInput.style.display === 'none') {
            commissionInput.style.display = 'inline-block';
            toggleButton.textContent = 'Remove Commission';
        } else {
            commissionInput.style.display = 'none';
            toggleButton.textContent = 'Add Commission';
            $('#commission_' + index).val(0);
        }
        CalculateRate(index);
    }
    function Cancel() {
        parent.jQuery.fancybox.close();
    }
</script>
