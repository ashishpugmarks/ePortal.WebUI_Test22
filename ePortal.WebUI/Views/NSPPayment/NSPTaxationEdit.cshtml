@section Scripts{

<script nonce="@Context.Items["ScriptNonce_3"]">
    let rowCounter = 0;
    let splitData = [];
    let totalAmount = 0;
    let GlobalDtList = [];
    let GlobalAppStatus;
    $(document).ready(function () {

        PreLoadData();

        $("#searchInput").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("table tbody tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
        $("th").click(function () {
            var table = $(this).parents("table").eq(0)
            var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()))
            this.asc = !this.asc
            if (!this.asc) { rows = rows.reverse() }
            for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
        });
        function comparer(index) {
            return function (a, b) {
                var valA = getCellValue(a, index), valB = getCellValue(b, index)
                return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
            }
        }
        function getCellValue(row, index) {
            return $(row).children("td").eq(index).html()
        }

        $(document).on('change', 'input[id^="approvedAmount_"]', function () {
            debugger;
            var changedId = $(this).attr('id');
            var ApprovedAmount = parseFloat($(this).val());
            var originalAmountId = changedId.replace('approved', '');
            var originalAmount = parseFloat($("#" + originalAmountId).val());

            if (isNaN(ApprovedAmount) || ApprovedAmount < 0 || !isFinite(ApprovedAmount)) {
                alert('Please enter a valid numeric number.');
                $(this).val(originalAmount);
                return;
            }

            if (ApprovedAmount > originalAmount) {
                alert('You cannot approve an amount greater than the original.');
                $(this).val(originalAmount);
            }

            var totalApprovedAmount = 0;
            debugger;
            $('#append_PaymentDtRows tr').each(function () {
                var approvedAmountInput = $(this).find('input[type="number"]');
                var approvedAmount = parseFloat(approvedAmountInput[5].value) || 0;
                totalApprovedAmount += approvedAmount;
            });

            $('#txtFinalToal').val(totalApprovedAmount.toFixed(2));

            var RowID = changedId.substr(changedId.length - 1, 1);
            $('#txtTdsBaseAmount_' + RowID).val(ApprovedAmount); // AUMENTO :: SR88023-CR5305 :: 2.0
            CalculateRate(RowID);

        });
    });



    function PreLoadData() {
        $.ajax({
            type: "POST",
            url: "/NSPPayment/GetNSPPaymentFinanceTaxationEditData",
            data: { id: @ViewBag.id,DepHead : "TAXATION" },
            dataType: "json",
            success: function (data) {
                debugger;

                if (data != null && data.length !== 0) {

                    var Data = JSON.parse(data);
                    var AppAuthList = Data.appAuthority;
                    var DtList = Data.appInvoiceDetails;
                    var _Date = formatDateFromTimestamp(Data.RequestDate);
                    var ApprovalStatus = Data.ApprovalStatus;
                    $("#txtHeaderID").val(Data.HeaderID);
                    $("#ddlRequestType").val(Data.RequestType);
                    $("#ddlCurrencyType").val(Data.CurrencyType);
                    $("#txtCurrency").val(Data.CurrencyType);
                    $("#txtVendorPanNo").val(Data.VendorPanNo);
                    $("#ddlBudgeted").val(Data.Budgeted);
                    $("#txtRequestNo").val(Data.RequestRefNo);
                    $("#txtRequestDate").val(_Date);
                    $("#ddlCategory").val(Data.Category);
                    $("#txtExpenses").val(Data.PurposeofExpenses);
                    $("#txtLocation").val(Data.Location);
                    $("#txtPayProLocation").val(Data.PAY_PRO_LOCATION);
                    $("#txtGstIn").val(Data.GSTIN);
                    $("#txtVendorCode").val(Data.VendorCode);
                    $("#txtVendorName").val(Data.VendorName);
                    $("#txtVendorAddress").val(Data.VendorAddress);
                    $("#txtBankName").val(Data.BankName);
                    $("#txtBankAccNo").val(Data.BankAccountNo);
                    $("#txtBankIFSCCode").val(Data.BankIFSCCode);
                    $("#txtCostCentre").val(Data.CostCentre);
                    $("#txtVendorPanNo").val(Data.VendorPANNo);

                    debugger;
                    if (Data.BUDGETED_ATTACH != null && Data.BUDGETED_ATTACH != ""){
                        $("#AttBudgetedAttachmentLink").removeClass('hidden');
                        $("#AttBudgetedAttachmentFile").val(Data.BUDGETED_ATTACH);
                    }
                    else{
                        $("#AttBudgetedAttachmentLink").addClass('hidden');
                    }

                    updateLabels();
                    SetBudgedChnage();

