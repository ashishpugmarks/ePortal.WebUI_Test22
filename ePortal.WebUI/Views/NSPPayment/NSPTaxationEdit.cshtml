        Value = (TDS == "No" ? '' :Value);
        var TDSTypeList = @Html.Raw(Json.Serialize(ViewBag.TDSTypeList));

        $.each(TDSTypeList, function(index, item) {
            var Options =   (item.value + ":" + item.text + ":" + item.Rate );
            TDSTACOPTIONS += '<option value="' + Options + '" ' + (Value == item.text ? 'selected' : '') + '>' + (item.value + "-" + item.text) + '</option>';
        });
        if (Value == '' || Value == undefined || Value == null) {
