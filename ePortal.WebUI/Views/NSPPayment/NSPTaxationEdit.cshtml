        var BaseAmount = parseFloat($('#approvedAmount_' + RowID).val()) || 0;
        var CommiissionAmount =   parseFloat($('#commission_' + RowID).val()) || 0;
        var SGSTRate = parseFloat($('#txtSgstRate_' + RowID).val()) || 0;
        var CGSTRate = parseFloat($('#txtCgstRate_' + RowID).val()) || 0;
        var IGSTRate = parseFloat($('#txtIgstRate_' + RowID).val()) || 0;
        var TDSRate = parseFloat($('#txTtdsRate_' + RowID).val()) || 0;
        var TDSBaseAmount = parseFloat($('#txtTdsBaseAmount_' + RowID).val()) || 0;
        var esiAmount = 0;

        const $checkbox = $(`#chkESI_${RowID}`);
        var selectedValue = $('#ddlTDS_' + RowID).val();
        var TaxType = $('#ddlTaxType_' + RowID).val();
        const esiRate_ = parseFloat('@ViewBag.ESTaxData') || 0;

        if(selectedValue == "Yes" &&TaxType != "XX")
        {

        $(`#txtESIRate_${RowID}`).text(esiRate_);
        const esiRate = parseFloat($(`#txtESIRate_${RowID}`).text()) || 0;

        if ($checkbox.is(':checked')) {
            esiAmount = (TDSBaseAmount * esiRate) / 100;
            $(`#txtESIAmount_${RowID}`).text(esiAmount.toFixed(2));
        } else {
            $(`#txtESIAmount_${RowID}`).text('0.00');
        }
        }
        else{
            $(`#txtESIRate_${RowID}`).text('0.00');
            $(`#txtESIAmount_${RowID}`).text('0.00');
        }


        var SGSTamt = CommiissionAmount != 0 ?  (CommiissionAmount * SGSTRate) / 100  :  (BaseAmount * SGSTRate) / 100;
        var CGSTamt =  CommiissionAmount != 0 ? (CommiissionAmount * CGSTRate) / 100: (BaseAmount * CGSTRate) / 100;
        var IGSTamt =  CommiissionAmount != 0 ? (CommiissionAmount * IGSTRate) / 100: (BaseAmount * IGSTRate) / 100;
        var TDSAmount = (TDSBaseAmount * TDSRate) / 100;
        var TotalGSTAmount = SGSTamt + CGSTamt + IGSTamt;
        var FinalAmount = 0;
        var selectedValue = $('#ddlTaxType_' + RowID).val();
        var CessRate =  parseFloat($('#txtCessRate_' + RowID).text()) || 0;
        var CessAmount =   (TotalGSTAmount *  CessRate ) / 100 ;
        $('#txtCessAmount_' + RowID).text(CessAmount.toFixed(2));


        if (selectedValue == "RCM Charges") {
            FinalAmount = BaseAmount - TDSAmount + CessAmount - esiAmount;
        } else {

            FinalAmount = BaseAmount - TDSAmount + TotalGSTAmount + CessAmount - esiAmount;
        }

        $('#txtSgstAmount_' + RowID).val(SGSTamt.toFixed(2));
        $('#txtCgstAmount_' + RowID).val(CGSTamt.toFixed(2));
        $('#txtIgstAmount_' + RowID).val(IGSTamt.toFixed(2));
        $('#txtTdsAmount_' + RowID).val(TDSAmount.toFixed(2));
        $('#txtTotalGstAmount_' + RowID).val(TotalGSTAmount.toFixed(2));
        $('#txtTotalNetAmount_'+ RowID).val(FinalAmount.toFixed(2));

        setFinalvalue();
    }

