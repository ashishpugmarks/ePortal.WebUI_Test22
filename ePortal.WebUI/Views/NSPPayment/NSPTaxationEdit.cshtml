    function GSTTypeChangeBindTaxCode(ID,GSTTaxCode) {
        var RowID;
        debugger;
        if(ID.toString().length == 1)
        {
            RowID = ID;
        }
        else
        {
            RowID = ID.id.substr(ID.id.length - 1, 1);
        }




        var selectedValue = $('#ddlGST_' + RowID).val();
        var TaxType = $('#ddlTaxType_' + RowID).val();
        var CostCentre = $('#txtCostCentre').val();
        $.ajax({
            url: '/NSPPayment/GetGSTRateList',
            type: 'GET',
            data: { Type: selectedValue ,  TaxType :TaxType,  COSTCENTER :CostCentre ,Status :GlobalAppStatus },
            success: function (data) {
                $('#ddlGSTTaxCode_' + RowID).empty();
                var Data1 = JSON.parse(data);
                $.each(Data1, function (i, r) {
                    $('#ddlGSTTaxCode_' + RowID).append('<option value="' + r.Rate1 + ',' + r.Rate2 + ','+ r.CessRate +'">' + r.TaxCode + '</option>');
                });
                $('#ddlGSTTaxCode_' + RowID).append('<option value="0,0">Select</option>');


                var $dropdown = $('#ddlGSTTaxCode_' + RowID);

                if (GSTTaxCode != null) {
                    // Select by text
                    $dropdown.find('option').each(function() {
                        if ($(this).text() === GSTTaxCode) {
                            $(this).prop('selected', true);
                        }
                    });
                } else {
                    // Set value to "0,0"
                    $dropdown.val("0,0");
                }

                SelectRate(ID);
            },
            error: function (xhr, status, error) {
                console.error('AJAX request failed:', status, error);
            }
        });

    }
    function SelectRate(ID) {

        var RowID;
        if(ID.toString().length == 1)
        {
            RowID = ID;
        }
        else
        {
            RowID = ID.id.substr(ID.id.length - 1, 1);
        }

        debugger;
        var Rates = $("#ddlGSTTaxCode_"+ RowID).val();
        var Type = $('#ddlGST_' + RowID).val();
        var IgsrRate = 0;
        var SgsrRate = 0;
        var CgsrRate = 0;
        var CessRate = 0;

        if (Rates) {
            var splitRate = Rates.split(",");

            if (Type == "IGST") {

                IgsrRate = parseFloat(splitRate[0]) || 0;
                $('#txtIgstRate_' + RowID).val(IgsrRate);
                $('#txtSgstRate_' + RowID).val(0);
                $('#txtCgstRate_' + RowID).val(0);
            }
            else
            {

                SgsrRate = parseFloat(splitRate[0]) || 0;
                CgsrRate = parseFloat(splitRate[1]) || 0;
                $('#txtIgstRate_' + RowID).val(0);
                $('#txtSgstRate_' + RowID).val(SgsrRate);
                $('#txtCgstRate_' + RowID).val(CgsrRate);
            }

            CessRate =  parseFloat(splitRate[2]) || 0;
        }

        $('#txtCessRate_' + RowID).text(CessRate);






        CalculateRate(ID);
    }
    function SelectTDSRate(ID) {

        var RowID;
        if(ID.toString().length == 1)
        {
            RowID = ID;
        }
        else
        {
            RowID = ID.id.substr(ID.id.length - 1, 1);
        }

        var Rates = $("#ddlTDSTaxType_"+ RowID).val();
        debugger;
        var TDSRate = 0;

        if (Rates) {
            var splitRate = Rates.split(":");

            TDSRate = parseFloat(splitRate[2]) || 0;
        }

        $('#txTtdsRate_' + RowID).val(TDSRate);
        CalculateRate(ID);

    }
