<div class="panel panel-primary">
            <div class="panel-heading">
                <h2 class="panel-title" style="padding-left:10px">
                    Approval History
                </h2>
            </div>
            <div style="padding-left:inherit">
                <table id="tblAuthorityDt" class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                    <thead>
                        <tr class="bg-info">
                            <th class="text-center">SRNo</th>
                            <th class="text-center">Emp Code</th>
                            <th class="text-center">Employee Name</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Remarks</th>
                            <th class="text-center">Date</th>
                            <th class="text-center">Time</th>
                        </tr>
                    </thead>
                    <tbody class="disabled">
                        @{ int row_No = 0; }
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                if (item.Department == "APPROVAL")
                                {
                                <tr>
                                    <td class="text-center">
                                        @(row_No += 1)
                                        @Html.HiddenFor(modelItem => item.APPROVALID)
                                    </td>
                                    <td class="text-center" style="padding-left: 10px;">
                                        @Html.HiddenFor(modelItem => item.APPROVALID)
                                        <Span id="txtEMPCODE">@Html.DisplayFor(modelItem => item.EMPCODE)</Span>
                                    </td>

                                    <td class="text-center">
                                        <Span id="txtEmpName">@Html.DisplayFor(modelItem => item.EMP_NAME)</Span>
                                    </td>

                                    <td class="text-center" style="padding-left: 10px;">
                                        @if (item.APPROVAL_STATUS == 1)
                                        {
                                            <span>Pending</span>
                                        }
                                        else if (item.APPROVAL_STATUS == 2)
                                        {
                                            <span>Approve</span>
                                        }
                                        else if (item.APPROVAL_STATUS == 3)
                                        {
                                            <span>Send Back</span>
                                        }
                                        else if (item.APPROVAL_STATUS == 4)
                                        {
                                            <span>Reject</span>
                                        }
                                        else if (item.APPROVAL_STATUS == 5)
                                        {
                                            <span>Send To Taxation</span>
                                        }
                                        else if (item.APPROVAL_STATUS == 6)
                                        {
                                            <span>Hold</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <Span id="txtAppRemark">@Html.DisplayFor(modelItem => item.APPREMARK)</Span>
                                    </td>

                                    <td class="text-center" style="padding-left: 10px;">
                                        @{
                                            string formattedDates = string.Empty;

                                            if (item.APPROVAL_STATUS == 1)
                                            {
                                                formattedDates = string.IsNullOrEmpty(item.ADDEDON.ToString()) || item.ADDEDON.ToString() == "1/1/0001 12:00:00 AM" ? "" : DateTime.Parse(item.ADDEDON.ToString()).ToString("MM/dd/yyyy");
                                            }
                                            else
                                            {
                                                formattedDates = string.IsNullOrEmpty(item.UPDATEDON.ToString()) || item.UPDATEDON.ToString() == "1/1/0001 12:00:00 AM" ? "" : DateTime.Parse(item.UPDATEDON.ToString()).ToString("MM/dd/yyyy");
                                            }

                                        }
                                        @formattedDates
                                    </td>
                                    <td class="text-center" style="padding-left: 10px;">
                                        @{
                                            string formattedTime = string.Empty;
                                            if (item.APPROVAL_STATUS == 1)
                                            {
                                                formattedTime = string.IsNullOrEmpty(item.ADDEDON.ToString()) || item.ADDEDON.ToString() == "1/1/0001 12:00:00 AM" ? "" : DateTime.Parse(item.ADDEDON.ToString()).ToString("hh:mm:ss tt");
                                            }
                                            else
                                            {
                                                formattedTime = string.IsNullOrEmpty(item.UPDATEDON.ToString()) || item.UPDATEDON.ToString() == "1/1/0001 12:00:00 AM" ? "" : DateTime.Parse(item.UPDATEDON.ToString()).ToString("hh:mm:ss tt");
                                            }


                                        }
                                        @formattedTime
                                    </td>
                                </tr>
                                                    }
                                                }
                                            }
                    </tbody>
                </table>
            </div>
        </div>
@if (Model[Model.Count - 1].Department != "APPROVAL")
{
