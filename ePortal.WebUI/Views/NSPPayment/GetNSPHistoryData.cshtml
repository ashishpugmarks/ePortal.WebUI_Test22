                                    }
                                    else
                                    {
                                        formattedTime = string.IsNullOrEmpty(item.UPDATEDON.ToString()) || item.UPDATEDON.ToString() == "1/1/0001 12:00:00 AM" ? "" : DateTime.Parse(item.UPDATEDON.ToString()).ToString("hh:mm:ss tt");
                                    }


                                }
