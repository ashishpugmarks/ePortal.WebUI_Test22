@*<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jsfile/0.1.17/jsfile.js"></script>*@
@section Scripts{
<script nonce="@Context.Items["ScriptNonce_3"]">
    $(document).ready(function () {

        let now = new Date();
        let firstDayOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
        let lastDayOfMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0);
        $('#txtFromDate').val(formatDateFiltter(firstDayOfMonth));
        $('#txtToDate').val(formatDateFiltter(lastDayOfMonth));

        $('#btnSearch').click(function () {
            PreLoadData();
        });

        $("#searchInput").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("table tbody tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
        $("th").click(function () {
            var table = $(this).parents("table").eq(0)
            var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()))
            this.asc = !this.asc
            if (!this.asc) { rows = rows.reverse() }
            for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
        })
        function comparer(index) {
            return function (a, b) {
                var valA = getCellValue(a, index), valB = getCellValue(b, index)
                return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
            }
        }
        function getCellValue(row, index) {
            return $(row).children("td").eq(index).html()
        }
        $('#btnSubmit').click(function () {
            PreLoadData();
        });
        PreLoadData();
    });
    function PreLoadData() {
        $('#loader_new').removeClass('hidden');
        var Status = $("#ddlStatus").val();
        var FromDate = $('#txtFromDate').val().toString() || "";
        var ToDate = $('#txtToDate').val().toString() || "";

        if (FromDate == "") {
            return alert('Please Select From Date')
        }
        if (ToDate == "") {
            return alert('Please Select From Date')
        }

        $.ajax({
            type: "GET",
            url: "/NSPPayment/GetNSPTaxation",
            data: { Status: Status, FromDate: FromDate, ToDate: ToDate },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                debugger;
                var parsedData = JSON.parse(data);
                if (parsedData.length !== 0) {
                    $("#append_Data").empty();
                    $.each(parsedData, function (i, r) {
                        var formattedDate = moment(r.RequestDate).format('DD-MMM-YYYY');
                        $("#append_Data").append('<tr><td><center>' +
                            HistoryFormatter(r.HeaderID, r.ApprovalStatus) + '</center></td><td><center>' + r.RequestRefNo + '</center></td><td><center>' + formattedDate + '</center></td><td><center>' + r.Category + '</center></td><td><center>' + (r.VendorCode == null ? "" : r.VendorCode) +
                            '</center></td><td><center class="Setlineheight">' + (r.VendorName == null ? "" : r.VendorName) +
                            '</center></td><td><center>' + r.Location + '</center></td><td><center>' + (r.TotalNetAmount ? r.TotalNetAmount : 0) + '</center></td><td style="text-align: center;">' +
                            '<span style="margin-right:2px;">' + EditorFormatter(r.HeaderID) + '</span></td></tr>');
                        calculateTotalAmount();
                    });
                    // CSP 3.0 Compliant changes
                    $('[data-ctrl-id="Edit-Header"]').on('click', function () {
                        Edit($(this).data('header-id'));
                    });

                    // CSP 3.0 Compliant changes
                    $('[data-ctrl-id="View-History"]').on('click', function () {
                        History($(this).data('history-id'));
                    });

                } else {
                    $("#append_Data").empty();
                    $("#append_Data").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>")
                }
                $('#loader_new').addClass('hidden');
            },
            complete: function () {
            },
            error: function () {
                alert("Oops...", "Something went wrong!");
                $('#loader_new').addClass('hidden');
            }
        });
    }
    function calculateTotalAmount() {
        var totalAmount = parseFloat($("#txtAmount").val()) || 0;
        $("#append_PaymentDtRows tbody tr").each(function () {
            var amount = parseFloat($(this).find("td:eq(4)").text());
            if (!isNaN(amount)) {
                totalAmount += amount;
            }
        });
        $("#txtTotalAmount").text(totalAmount.toFixed(2));
        var amountInWords = convertNumberToWords(totalAmount);
        $("#txtAmountInWords").text(amountInWords);
    }
    function convertNumberToWords(amount) {
        var words = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine'];
        var teens = ['Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
        var tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
        function convertLessThanThousand(number) {
            if (number === 0) {
                return '';
            } else if (number < 10) {
                return words[number] + ' ';
            } else if (number < 20) {
                return teens[number - 11] + ' ';
            } else if (number < 100) {
                return tens[Math.floor(number / 10)] + ' ' + convertLessThanThousand(number % 10);
            } else {
                return words[Math.floor(number / 100)] + ' Hundred ' + convertLessThanThousand(number % 100);
            }
        }
        if (isNaN(amount) || amount < 0 || amount > 10000000) {
            return 'Invalid input';
        }
        if (amount === 0) {
            return 'Zero';
        }
        var result = '';
        var crore = Math.floor(amount / 10000000);
        var lakh = Math.floor((amount % 10000000) / 100000);
        var thousand = Math.floor((amount % 100000) / 1000);
        var remainder = amount % 1000;
        if (crore > 0) {
            if (crore == 10) {
                result = 'Ten Crore ';
            }
            else {
                result += convertLessThanThousand(crore) + 'Crore ';
            }
        }
        if (lakh > 0) {
            if (lakh == 10) {
                result = 'Ten Lakh ';
            }
            else {
                result += convertLessThanThousand(lakh) + 'Lakh ';
            }
        }
        if (thousand > 0) {
            if (thousand == 10) {
                result = 'Ten Thousand ';
            }
            else {
                result += convertLessThanThousand(thousand) + 'Thousand ';
            }
        }
        if (remainder > 0) {
            result += convertLessThanThousand(remainder);
        }
        return result.trim();
    }
    function EditorFormatter(HeaderID) {
        return '<center><a title="Edit" class="btn btn-primary btn-xs" data-ctrl-id="Edit-Header" data-header-id="' + HeaderID + '"><i class="ace-icon fa fa-edit"></i></a>&nbsp;</center>';
    }
    function Edit(HeaderID) {
        debugger;
        var URL = '/NSPPayment/NSPTaxationEdit?id=' + HeaderID;
        $.fancybox.open({
            href: URL,
            type: 'iframe',
            padding: 2,
            maxWidth: 1300,
            maxHeight: 1100,
            fitToView: false,
            width: '1300px',
            height: '1100px',
            autoSize: true,
            closeClick: true,
            openEffect: 'elastic',
            openSpeed: 120,
            closeEffect: 'elastic',
            closeSpeed: 100,
            helpers:
            {
                overlay: { closeClick: false }
            },
            afterClose: function () {

                PreLoadData();
            }
        });
        return false;
    }

    function HistoryFormatter(HeaderID, STATUS) {
        return GetStatus(STATUS) + '&nbsp;<a title="History" class="btn btn-primary btn-xs" data-ctrl-id="View-History" data-history-id="' + HeaderID + '"><i class="ace-icon fa fa-history"></i></a>';
    }
    function History(HeaderID) {
        debugger;
        var URL = '/NSPPayment/GetNSPHistoryData?id=' + HeaderID;
        $.fancybox.open({
            href: URL,
            type: 'iframe',
            padding: 2,
            maxWidth: 1100,
            maxHeight: 1100,
            fitToView: false,
            width: '1100px',
            height: '1100px',
            autoSize: true,
            closeClick: true,
            openEffect: 'elastic',
            openSpeed: 120,
            closeEffect: 'elastic',
            closeSpeed: 100,
            helpers:
            {
                overlay: { closeClick: false }
            },
            afterClose: function () {

                PreLoadData();
            }
        });
        return false;
    }
    function GetStatus(STATUS) {
        if (STATUS == 1) {
            return 'Pending';
        } else if (STATUS == 2) {
            return 'Approve';
        } else if (STATUS == 3) {
            return 'SendBack';
        } else if (STATUS == 4) {
            return 'Rejecte';
        } else if (STATUS == 5) {
            return 'Sent To Taxation';
        } else if (STATUS == 6) {
            return 'Hold';
        } else {
            return '';
        }
    }
    function formatDateFiltter(date) {
        let year = date.getFullYear();
        let month = String(date.getMonth() + 1).padStart(2, '0'); // Months are zero-based
        let day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

</script>
}
