    function GetStatus(STATUS) {
        if (STATUS == 1) {
            return 'Pending';
        } else if (STATUS == 2) {
            return 'Approve';
        } else if (STATUS == 3) {
            return 'SendBack';
        } else if (STATUS == 4) {
            return 'Rejecte';
        } else if (STATUS == 5) {
            return 'Sent To Taxation';
        } else if (STATUS == 6) {
            return 'Hold';
        } else {
            return '';
        }
    }
