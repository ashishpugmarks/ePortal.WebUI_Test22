@section Scripts{
<script nonce="@Context.Items["ScriptNonce_3"]">
    $(document).ready(function () {

        let now = new Date();
        let firstDayOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
        let lastDayOfMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0);
        $('#txtFromDate').val(formatDateFiltter(firstDayOfMonth));
        $('#txtToDate').val(formatDateFiltter(lastDayOfMonth));
        $('#txtFromDate2').val(formatDateFiltter(firstDayOfMonth));
        $('#txtToDate2').val(formatDateFiltter(lastDayOfMonth));

        $('#btnSearch').click(function () {
           
           

            PreLoadData();
        });

        $('#btnPsearch').click(function () {
            debugger;

            PreLoadDataPost();
        });

        $("#searchInput").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("table tbody tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
        $("#searchInput2").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("table tbody tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
 // START ::  AUMENTO :: SR88023-CR5305 :: 2.0
        //$("th").click(function () {
        //    var table = $(this).parents("table").eq(0)
        //    var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()))
        //    this.asc = !this.asc
        //    if (!this.asc) { rows = rows.reverse() }
        //    for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
        //})

        //function comparer(index) {
        //    return function (a, b) {
        //        var valA = getCellValue(a, index), valB = getCellValue(b, index)
        //        return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
        //    }
        //}

        //function getCellValue(row, index) {
        //    return $(row).children("td").eq(index).html()
        //}
        $("th").click(function () {
            var table = $(this).closest("table");
            var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()));
            var isAscending = $(this).hasClass("sorted-asc");

            $("th").removeClass("sorted-asc sorted-desc");
            $(this).addClass(isAscending ? "sorted-desc" : "sorted-asc");

            if (isAscending) {
                rows.reverse();
            }

            for (var i = 0; i < rows.length; i++) {
                table.append(rows[i]);
            }
        });

        function comparer(index) {
            return function (a, b) {
                var valA = getCellValue(a, index), valB = getCellValue(b, index);
                if ($.isNumeric(valA) && $.isNumeric(valB)) {
                    return valA - valB;
                } else {
                    return valA.toString().localeCompare(valB);
                }
            };
        }

        function getCellValue(row, index) {
            return $(row).children("td").eq(index).text().trim();
        }
 // END ::  AUMENTO :: SR88023-CR5305 :: 2.0
        $('#btnSubmit').click(function () {
            PreLoadData();
        });
        PreLoadData();
        PreLoadDataPost();


        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            var target = $(e.target).attr("href");
            if (target === "#tabFinance") {
                PreLoadData();
            } else if (target === "#tabSAP") {

                let now = new Date();
                let firstDayOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
                let lastDayOfMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0);
                $('#txtFromDate2').val(formatDateFiltter(firstDayOfMonth));
                $('#txtToDate2').val(formatDateFiltter(lastDayOfMonth));
                PreLoadDataPost();
            }
        });
    });


    function PreLoadData() {
        $('#loader_new').removeClass('hidden');
        var Status = $("#ddlStatus").val();
        var FromDate = $('#txtFromDate').val().toString() || "";
        var ToDate = $('#txtToDate').val().toString() || "";

        if (FromDate == "") {
            return alert('Please Select From Date')
        }
        if (ToDate == "") {
            return alert('Please Select From Date')
        }
 //START :: ADDED BY AUMENTO :: SR88023-CR5305
        if ($("#ddlMode").val() === "No") {
            alert('You don’t have rights in Role Master of Non-SAP module. Please contact the admin.');
            return;
        }
        var Searchkey = $('#searchInvoice').val().toString() || "";

 //END :: ADDED BY AUMENTO :: SR88023-CR5305
        $.ajax({
            type: "GET",
            url: "/NSPPayment/GetNSPFinanceList",
            data: { Status: Status, FromDate: FromDate, ToDate: ToDate, InvoiceSearchKey: Searchkey }, //  InvoiceSearchKey: Searchkey ADDED BY AUMENTO :: SR88023-CR5305
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                debugger;
                var parsedData = JSON.parse(data);
                if (parsedData.length !== 0) {
                    $("#append_Data").empty();
                   
                    $.each(parsedData, function (i, r) {

                        var formattedDate = moment(r.RequestDate).format('DD-MMM-YYYY');

                        $("#append_Data").append('<tr><td><center>' +
                            HistoryFormatter(r.HeaderID, r.ApprovalStatus) + '</center></td><td><center>' + Number(r.RequestRefNo) + '</center></td><td><center>' + formattedDate + '</center></td><td><center>' + r.Category +
                            '</center></td><td><center>' + (r.VendorCode == null ? "" : r.VendorCode) +
                            '</center></td><td><center class="Setlineheight">' + (r.VendorName == null ? "" : r.VendorName) +
                            '</center></td><td><center>' + r.Location + '</center></td><td><center>' + Number(r.TotalNetAmount ? r.TotalNetAmount : 0).toFixed(2) + '</center></td><td style="text-align: center;">' +  // ADDED BY  AUMENTO :: SR88023-CR5305 :: 2.0
                            '<span style="margin-right:2px;">' + EditorFormatter(r.HeaderID, r.STATUS) + '</span></td></tr>');

                    });
                    // CSP 3.0 Compliant changes
                $('[data-ctrl-id="print-header"]').on('click', function () {
                    Print($(this).data('print-id'));
                });
                 // CSP 3.0 Compliant changes
                $('[data-ctrl-id="edit-header"]').on('click', function () {
                    Edit($(this).data('header-id'));
                });
                // CSP 3.0 Compliant changes
                $('[data-ctrl-id="view-history"]').on('click', function () {
                    History($(this).data('history-id'));
                });

                } else {
                    $("#append_Data").empty();
                    $("#append_Data").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>")
                }
                $('#loader_new').addClass('hidden');
            }, complete: function () {
            },
            error: function () {
                alert("Oops...", "Something went wrong!");
                $('#loader_new').addClass('hidden');
            }
        });
    }
    function EditorFormatter(HeaderID, STATUS) {
        if ([2, 3, 4].includes(STATUS)) {
            return '<center><a title="Print" class="btn btn-secondary btn-xs" data-ctrl-id="print-header" data-print-id="'+HeaderID+'"><i class="fa fa-print" aria-hidden="true"></i></a>&nbsp;<a title="Edit"  class="btn btn-primary btn-xs" data-ctrl-id="edit-header" data-header-id="'+HeaderID+'"><i class="ace-icon fa fa-edit"></i></a>&nbsp;</center>'
        }
        else {
            return '<center><a title="Edit"  class="btn btn-primary btn-xs" data-ctrl-id="edit-header" data-header-id="'+HeaderID+'"><i class="ace-icon fa fa-edit"></i></a>&nbsp;</center>';
        }


    }
    function HistoryFormatter(HeaderID, STATUS) {
        return GetStatus(STATUS) + '&nbsp;<a title="History" class="btn btn-primary btn-xs" data-ctrl-id="view-history" data-history-id="'+HeaderID+'"><i class="ace-icon fa fa-history"></i></a>';
    }
    function Edit(HeaderID) {
        debugger;
        var URL = '/NSPPayment/NSPFinanceEdit?id=' + HeaderID;
        $.fancybox.open({
            href: URL,
            type: 'iframe',
            padding: 2,
            maxWidth: 1300,
            maxHeight: 1100,
