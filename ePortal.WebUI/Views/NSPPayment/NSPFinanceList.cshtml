    function PreLoadDataPost() {
        $('#loader_new').removeClass('hidden');
        var Status = $("#ddlStatusP").val() || 'N';
        var Mode = $("#ddlMode").val();

        var FromDate = $('#txtFromDate2').val().toString() || "";
        var ToDate = $('#txtToDate2').val().toString() || "";

        if (FromDate == "") {
            return alert('Please Select From Date')
        }
        if (ToDate == "") {
            return alert('Please Select From Date')
        }


        $.ajax({
            type: "GET",
            url: "/NSPPayment/GetDataForPostInvoices",
            data: { Status: Status, Mode: Mode, FromDate: FromDate, ToDate: ToDate },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                debugger;
                var parsedData = JSON.parse(data).resultObject;
                if (parsedData.length !== 0) {
                    $("#append_DataPost").empty();


                    $.each(parsedData, function (i, r) {
                      
                        var InvoiceDate = moment(r.InvoiceDate).format('DD-MMM-YYYY');
                        var POSTDOCDATE = r.POSTDOCDATE ? moment(r.POSTDOCDATE).format('DD-MMM-YYYY') : "";
                        var REVERSEPOSTDOCDATE = r.REVERSEPOSTDOCDATE ? moment(r.REVERSEPOSTDOCDATE).format('DD-MMM-YYYY') : "";
                        var POSTDOCNO = r.POSTDOCNO || "";
                        var REVERSEPOSTDOCNO = r.REVERSEPOSTDOCNO || "";
                        var ISPOSTED = r.ISPOSTED || 'N';
                        var ISREVERSEPOSTED = r.ISREVERSEPOSTED || 'N';

                        var historuVisible = Status == "Y" ? 1 : 0;

                        if (Mode == "POST") {

                            $("#columnPostDocNo").removeClass('hidden');
                            $("#columnPostDocDate").removeClass('hidden');
                            $("#columnReversePostDocNo").addClass('hidden');
                            $("#columnReversePostDocDate").addClass('hidden');

                        } else {

                            $("#columnPostDocNo").addClass('hidden');
                            $("#columnPostDocDate").addClass('hidden');
                            $("#columnReversePostDocNo").removeClass('hidden');
                            $("#columnReversePostDocDate").removeClass('hidden');

                        }

                        

                        $("#append_DataPost").append('<tr><td><center>' + Number(r.RequestRefNo) +
                                               '</center></td><td class="hidden"><center>' + r.SAP_STATUS +
                                               '</center></td><td class="hidden"><center>' + r.DetailID +
                                               '</center></td><td><center class="Setlineheight">' + r.InvoiceNo +
                                               '</center></td><td><center class="Setlineheight">' + InvoiceDate +
                                               '</center></td><td><center>' + r.CATEGORY +
                                               '</center></td><td><center>' + (r.VENDORCODE == null ? "" : r.VENDORCODE) +
                                               '</center></td><td><center  class="Setlineheight">' + (r.VENDORNAME == null ? "" : r.VENDORNAME) +
                                               '</center></td><td><center>' + Number(r.Amount).toFixed(2) +    // ADDED BY  AUMENTO :: SR88023-CR5305 :: 2.0
                                               '</center></td><td><center>' + Number(r.TotalNetAmount).toFixed(2) +  // ADDED BY  AUMENTO :: SR88023-CR5305 :: 2.0
                                               '</center></td><td class="hidden"><center>' + ISPOSTED +
                                               '</center></td><td class="hidden"><center>' + ISREVERSEPOSTED +
                                               '</center></td><td ' + (Mode != "POST" ? 'class="hidden"' : '') +
                                               '><center>' + ( Status == "Y" ? POSTDOCNO : "") + '</center></td><td ' + (Mode != "POST" ? 'class="hidden"' : '') +
                                               '><center>' + ( Status == "Y" ? POSTDOCDATE : "")+ '</center></td><td ' + (Mode == "POST" ? 'class="hidden"' : '') +
                                               '><center>' + ( Status == "Y" ? REVERSEPOSTDOCNO : "") + '</center></td><td ' + (Mode == "POST" ? 'class="hidden"' : '') +
                                               '> <center>' + (Status == "Y" ? REVERSEPOSTDOCDATE : "") + '</center></td><td><center>' +
                     '<span style="margin-right:2px;">' + EditorFormatterPost(r,ISPOSTED, ISREVERSEPOSTED, Mode, Status, historuVisible, POSTDOCNO) + '</span></td></tr>');

                       
                    });

                    // CSP 3.0 Compliant changes
                $('[data-ctrl-id="postedit-btn"]').on('click', function () {
                    Edit($(this).data('editheader-id'));
                });

                // CSP 3.0 Compliant changes
                $('[data-ctrl-id="postreverse-btn"]').on('click', function () {
                    var postheader = $(this).data('postheader-id'); 
                    var postinv = $(this).data('postinv-id'); 
                    var detail = $(this).data('detail-id'); 
                    var flag = $(this).data('flag'); 
                    var costcen = $(this).data('costcen-id'); 
                    var status = $(this).data('status-id'); 
                    var postdocs = $(this).data('postdocs-id'); 
                    var invdate = $(this).data('invdate-id'); 
                    var gstin = $(this).data('gstin-id'); 
                    var reqref = $(this).data('reqref-id'); 
 
                    PostReverse(postheader, postinv, detail, flag, costcen, status, postdocs, invdate, gstin, reqref);
                });
                // CSP 3.0 Compliant changes
                $('[data-ctrl-id="posthistory-btn"]').on('click', function () {
                    PostInvHistory($(this).data('posthistory-id'), $(this).data('posthistoryinv-id'),$(this).data('historydetail-id'));
                });

                
                } else {
                    $("#append_DataPost").empty();
                    $("#append_DataPost").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>")
                }
                $('#loader_new').addClass('hidden');
            }, complete: function () {
            },
            error: function () {
                alert("Oops...", "Something went wrong!");
                $('#loader_new').addClass('hidden');
            }
        });
    }
    function EditorFormatterPost( r,ISPOSTED,ISREVERSEPOSTED,Mode, Status, historuVisible, POSTEDDOCNO) {

        var HeaderID = r.HeaderID;
        var InvoiceNo = r.InvoiceNo;
        var DetailID = r.DetailID;
        var CostCenter =  r.CostCenter;
        var InvoiceDate = moment(r.InvoiceDate).format('DD-MMM-YYYY');
        var GSTIN = r.GSTIN || "-";
        var RequestRefNo = r.RequestRefNo;

        return '<center>' +
                   '<a title="Edit" class="btn btn-primary btn-xs" data-ctrl-id="postedit-btn" data-editheader-id="'+HeaderID+'"><i class="ace-icon fa fa-edit"></i></a>&nbsp;' +
                   (ISPOSTED == "N" && Mode == "POST" ? '<a title="Post" class="btn btn-success btn-xs" data-ctrl-id="postreverse-btn" data-postheader-id="'+HeaderID+'" data-flag="0" data-postinv-id="'+InvoiceNo+'" data-detail-id="'+DetailID+'" data-costcen-id="'+CostCenter+'" data-status-id="'+Status+'" data-postdocs-id="'+POSTEDDOCNO+'" data-invdate-id="'+InvoiceDate+'" data-gstin-id="'+GSTIN+'" data-reqref-id="'+RequestRefNo+'"><i class="fa fa-paper-plane" aria-hidden="true"></i> Post</a>&nbsp;' : '') +
            (ISREVERSEPOSTED == "N" && Mode != "POST" ? '<a title="Reverse" class="btn btn-warning btn-xs" data-ctrl-id="postreverse-btn" data-postheader-id="' + HeaderID +'"  data-flag="1" data-postinv-id="'+InvoiceNo+'" data-detail-id="'+DetailID+'" data-costcen-id="'+CostCenter+'" data-status-id="'+Status+'" data-postdocs-id="'+POSTEDDOCNO+'" data-invdate-id="'+InvoiceDate+'" data-gstin-id="'+GSTIN+'" data-reqref-id="'+RequestRefNo+'"><i class="fa fa-undo"></i> Reverse</a>&nbsp;' : '') +
                   (Status == "Y" || historuVisible == 1 ? '<a title="History" class="btn btn-info btn-xs" data-ctrl-id="posthistory-btn" data-posthistory-id="'+HeaderID+'" data-posthistoryinv-id="'+InvoiceNo+'" data-historydetail-id="'+DetailID+'"><i class="fa fa-history"></i> History</a>&nbsp;' : '') +
               '</center>';
    }
    function ModeChange() {
        var Mode = $("#ddlMode").val();

        if (Mode == "POST") {
            $("#columnPostDocNo").removeClass('hidden');
            $("#columnPostDocDate").removeClass('hidden');
            $("#columnReversePostDocNo").addClass('hidden');
            $("#columnReversePostDocDate").addClass('hidden');


        }
        else {
            $("#columnPostDocNo").addClass('hidden');
            $("#columnPostDocDate").addClass('hidden');
            $("#columnReversePostDocNo").removeClass('hidden');
            $("#columnReversePostDocDate").removeClass('hidden');

        }

        PreLoadDataPost();
    }
    function PostReverse(HeaderID, InvoiceNo, detailId, Flag, CostCenter, Status,POSTEDDOCNO,InvoiceDate,GSTIN,RequestRefNo) {
        debugger;
        var Mode = Flag == 1 ? 'REVERSE' : 'POST';
        var URL = '';

    

        URL = Flag == 1 ? ('/NSPPayment/ReversePostInvoiceWindow?HeaderID=' + HeaderID + '&POSTEDDOCNO=' + POSTEDDOCNO + '&InvoiceNo=' + InvoiceNo + '&InvoiceDate=' + InvoiceDate + '&GSTIN=' + GSTIN + '&ReqRefNo=' + RequestRefNo) :
        ('/NSPPayment/PostInvoiceWindow?HeaderID=' + HeaderID + '&DtID=' + detailId + '&InvoceNo=' + InvoiceNo + '&CostCenterValue=' + CostCenter + '&Status=' + Status+'&Mode='+Mode 
         + '&InvoiceDate=' + InvoiceDate + '&GSTIN=' + GSTIN + '&ReqRefNo=' + RequestRefNo);
        

         
        $.fancybox.open({
            href: URL,
            type: 'iframe',
            padding: 2,
            maxWidth: 1600,
            maxHeight: 700,
            width: '1600px',
