    function CalculateGST() {
        var sgstRate = parseFloat($('#txtSGstRate').val());
        var cgstRate = parseFloat($('#txtCGstRate').val());
        var igstRate = parseFloat($('#txtIGstRate').val());

        var Amount = $("#txtAmount").val().trim();


        var baseAmount = isNaN(Amount) || Amount === '' || Amount === undefined ? 0 : Amount;
        sgstRate = isNaN(sgstRate) || sgstRate === '' || sgstRate === undefined ? 0 : sgstRate;
        cgstRate = isNaN(cgstRate) || cgstRate === '' || cgstRate === undefined ? 0 : cgstRate;
        igstRate = isNaN(igstRate) || igstRate === '' || igstRate === undefined ? 0 : igstRate;

        var sgstAmount = (baseAmount * sgstRate) / 100;
        var cgstAmount = (baseAmount * cgstRate) / 100;
        var igstAmount = (baseAmount * igstRate) / 100;

        var TotalGsTamount = parseFloat(sgstAmount) + parseFloat(cgstAmount) + parseFloat(igstAmount);

        $('#txtTotalGst').val(TotalGsTamount.toFixed(2));
        var TotalAmount = parseFloat(TotalGsTamount) + parseFloat(baseAmount);
        $('#txtTotalInvAmount').val(TotalAmount.toFixed(2));

    }

