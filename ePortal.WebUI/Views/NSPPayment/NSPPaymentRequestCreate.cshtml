@model ePortal.DomainClasses.NSP_PAYMENT_HEADER
@{
    ViewBag.Title = "NSPPaymentRequestCreate";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";
    List<object> allLocations = ViewBag.Location;
    List<object> PPLocation = new List<object>();



    try
    {
        PPLocation = allLocations.Where(x =>
        {
            var valueProperty = x.GetType().GetProperty("value");
            if (valueProperty != null)
            {
                var value = valueProperty.GetValue(x);
                if (value != null && value is IConvertible)
                {
                    string valueAsString = Convert.ToString(value);
                    return valueAsString == "3" || valueAsString == "6" || valueAsString == "8" || valueAsString == "21" || valueAsString == "22";
                }
            }
            return false;
        }).ToList();
    }
    catch (Exception ex)
    {

    }
}

