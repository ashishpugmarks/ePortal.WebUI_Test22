    function GetDate(dateStr) {
        debugger;
        var components = dateStr.split(' ');
        var dateComponents = components[0].split('/');
        var month = dateComponents[0];
        var day = dateComponents[1].length == 1 ? "0" + dateComponents[1] : dateComponents[1];
        var year = dateComponents[2];
        var formattedDate = year + '-' + month + '-' + day;
        return formattedDate
    }
    function tableToJson(controlID) {
        const table = document.querySelector(controlID);
        const headers = Array.from(table.querySelectorAll("th")).map(header => header.textContent);
        const jsonData = Array.from(table.querySelectorAll("tr"))
          .slice(1)
          .map(row => {
              const columns = row.querySelectorAll("td");
              const obj = {};
              columns.forEach((column, index) => {
                  obj[headers[index]] = column.textContent;
              });
              return obj;
          });
        return jsonData;
    }
