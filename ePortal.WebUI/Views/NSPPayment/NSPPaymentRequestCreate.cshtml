    function SelectRate() {
        var Rates = $("#ddlGSTTaxCode").val();
        var Type = $("#ddlGST").val();

        var IgsrRate = 0;
        var SgsrRate = 0;
        var CgsrRate = 0;

        if (Rates) {
            var splitRate = Rates.split(",");

            if (Type == "IGST") {

                IgsrRate = parseFloat(splitRate[0]) || 0;
            } else {

                SgsrRate = parseFloat(splitRate[0]) || 0;
                CgsrRate = parseFloat(splitRate[1]) || 0;
            }
        }


        $("#txtSGstRate").val(SgsrRate);
        $("#txtCGstRate").val(CgsrRate);
        $("#txtIGstRate").val(IgsrRate);
        CalculateGST();
    }



