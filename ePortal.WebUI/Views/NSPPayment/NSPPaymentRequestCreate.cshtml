    function isDuplicateRecord(newInvoiceNo, newInvoiceDate, newCurrency, newAmount) {
        var isDuplicate = false;

        $("#tblPaymentDt tbody tr").each(function () {
            debugger;
            var existingInvoiceNo = $(this).find("td:eq(0)").text().trim();
            var existingInvoiceDate = $(this).find("td:eq(1)").text().trim();
            var existingCurrency = $(this).find("td:eq(2)").text().trim();
            var existingAmount = $(this).find("td:eq(7)").text().trim();

            if (newInvoiceNo == existingInvoiceNo &&
                Date(newInvoiceDate) == Date(existingInvoiceDate) &&
                newCurrency == existingCurrency &&
                newAmount == existingAmount) {
                isDuplicate = true;
                return false;
            }
        });

        return isDuplicate;
    }


