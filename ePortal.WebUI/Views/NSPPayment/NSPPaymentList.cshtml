@{
    ViewBag.Title = "NSPPaymentList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
<link href="~/css/loading_spinner.css" rel="stylesheet" />
<style nonce="@Context.Items["StyleNonce_0"]">
       .Setlineheight{
        line-height:normal !important;
    }
.panel-body {
    padding: 15px;
}

.filter-container {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top:10px;
}

.filter-item {
    flex: 0 1 200px; /* Adjust the basis as needed */
    min-width: 200px; /* Prevent items from becoming too narrow */
}

.filter-item label {
    display: block;
    margin-bottom: 5px; /* Space between label and input */
}

.filter-actions {
    display: flex;
    align-items: center;
    gap: 10px; /* Space between buttons */
    margin-top: 25px;
}

.filter-actions .btn {
    display: flex;
    align-items: center;
    gap: 5px;
}
.filter-item span {
    margin-right: 10px;
   font-size: smaller;
}



    .table > thead > tr > th {
        padding: 6px 10px;
    }
    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        padding: 5px;
        line-height: 0.7;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
        border: 1px solid #8ac2de;
        align-content: center;
        font-size: 70% !important;
    }
    .table-bordered {
        border: 1px solid #8ac2de;
    }
    .table > tbody > tr > td {
        padding: 8px 3px !important;
    }
    .table > tbody > tr:nth-of-type(even) {
        background: #e9e9e9;
    }
    .validationError {
        border: 1px solid #a94442 !important;
    }
    .validationBackground {
        background-color: #a94442 !important;
        color: white;
    }
    .highlightBackground {
        background-color: #8bb55a !important;
        color: white;
    }
    * {
        margin: 0;
        padding: 0;
    }
    html {
        height: 100%;
        background: white; 
        background: -webkit-linear-gradient(to left, #6441A5, #2a0845); 
    }
    body {
        font-family: montserrat, arial, verdana;
        background: transparent;
    }
    #msform {
        text-align: center;
        position: relative;
    }
        #msform fieldset {
            background: white;
            border: 0 none;
            border-radius: 0px;
            box-shadow: 0 0 15px 1px rgba(0, 0, 0, 0.4);
            padding: 8px 0px;
            box-sizing: border-box;
            width: 100%;
            position: relative;
        }
            #msform fieldset:not(:first-of-type) {
                display: none;
            }
    .fs-title {
        font-size: 18px;
        text-transform: uppercase;
        color: #2C3E50;
        margin-bottom: 10px;
        letter-spacing: 2px;
        font-weight: bold;
    }
    .fs-subtitle {
        font-weight: normal;
        font-size: 13px;
        color: #666;
        margin-bottom: 20px;
    }
    #progressbar {
        margin-bottom: 20px;
        overflow: hidden;
        counter-reset: step;
    }
        #progressbar li {
            list-style-type: none;
            color: #6080dc;
            text-transform: uppercase;
            font-size: 9px;
            font-weight: 800;
            width: 50%;
            float: left;
            position: relative;
            letter-spacing: 1px;
        }
            #progressbar li:before {
                content: counter(step);
                counter-increment: step;
                width: 40px;
                height: 24px;
                line-height: 26px;
                display: block;
                font-size: 12px;
                color: #333;
                background: #ccc;
                border-radius: 25px;
                margin: 0 auto 6px auto;
            }
            #progressbar li:after {
                content: '';
                width: 100%;
                height: 8px;
                background: #ccc;
                position: absolute;
                left: -50%;
                top: 8px;
                z-index: -1; 
            }
            #progressbar li:first-child:after {
                content: none;
            }
            #progressbar li.active:before, #progressbar li.active:after {
                background: #6080dc;
                color: white;
            }
    .dme_link {
        margin-top: 30px;
        text-align: center;
    }
        .dme_link a {
            background: #FFF;
            font-weight: bold;
            color: #6080dc;
            border: 0 none;
            border-radius: 25px;
            cursor: pointer;
            padding: 5px 25px;
            font-size: 12px;
        }
            .dme_link a:hover, .dme_link a:focus {
                background: #C5C5F1;
                text-decoration: none;
            }
    .loader {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
        opacity: .7;
    }
    .panel-heading {
        padding: 8px 15px;
    }
    #pr_div {
        border: 1px solid #ccc;
        padding: 8px; 
        margin-left: 10px;
        border-radius: 5px;
        background-color: #eee;
        overflow: auto;
        min-height: 35px;
        max-height: 92px;
        width: 73.30%;
    }
    .alert-error {
        background-color: antiquewhite;
        margin-left: 15px;
        margin-right: 15px;
    }
    .div_disable {
        pointer-events: none;
        opacity: 0.9;
        background: #eee;
        color: black;
    }
    .required::after {
        content: "*";
        font-weight: 800;
        color: red;
        margin-left: 5px;
    }
    .ui-widget {
        font-family: Verdana,Arial,sans-serif;
        font-size: 0.6em !important;
        overflow: auto;
        max-height: 150px;
    }
</style>
}
<div id="loader_new" class="loading hidden overlayer">
    <div class="loading-text">
        <span class="loading-text-words">L</span>
        <span class="loading-text-words">O</span>
        <span class="loading-text-words">A</span>
        <span class="loading-text-words">D</span>
        <span class="loading-text-words">I</span>
        <span class="loading-text-words">N</span>
        <span class="loading-text-words">G</span>
    </div>
</div>
<div class="panel-group" style="padding: 0px 8px 0px 8px;">
    <div class="panel panel-primary">
        <div class="panel-heading">
            <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Payment Request List</h2>
        </div>
        <div class="panel-body">
            <div class="filter-container">
                <div class="filter-item" style="padding-left: 10px;">
                    <span for="searchInput">Table Search</span>
                    <input id="searchInput" name="searchInput" type="text" class="form-control mb-3" placeholder="Type Here for Search..." value="" autocomplete="off" />
                </div>         
                <div class="filter-item">
                    <span for="txtFromDate">From Date</span>
                    <input type="date" id="txtFromDate" class="form-control mb-3" />
                </div>
                <div class="filter-item">
                    <span for="txtToDate">To Date</span>
                    <input type="date" id="txtToDate"  class="form-control mb-3"/>
                </div>
                <div class="filter-item">
                    <span for="ddlStatus">Status</span>
                    <select id="ddlStatus" class="form-control">
                        <option value="0">Initiate</option>
                        <option value="1">Submitted</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" id="btnSearch" class="btn btn-primary">
                        <i class="menu-icon fa fa-search"></i> &nbsp; Search
                    </button>
                    <a title="Add" id="btnAdd" class="btn btn-success">
                        <i class="fa fa-plus" aria-hidden="true"></i>&nbsp; ADD
                    </a>
                </div>
            </div>
        </div>
<br />
        <div class="panel-body">
            <div class="form-group" style="margin-bottom: 0px;">
                <form id="myform">
                    <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                        <thead>
                            <tr class="bg-info">
                                <th class="text-center">Actions <i class="fa fa-sort"></i></th>
                                <th class="text-center">Request Ref No <i class="fa fa-sort"></i></th>
                                <th class="text-center">Request Date <i class="fa fa-sort"></i></th>
                                <th class="text-center">Category <i class="fa fa-sort"></i></th>
                                <th class="text-center">Vendor/Dealer/Emp Code <i class="fa fa-sort"></i></th>
                                <th class="text-center">Vendor/Dealer/Emp Name <i class="fa fa-sort"></i></th>
                                <th class="text-center">Location <i class="fa fa-sort"></i></th>
                                <th class="text-center">Amount <i class="fa fa-sort"></i></th>
                                <th class="text-center">Status <i class="fa fa-sort"></i></th>
                            </tr>
                        </thead>
                        <tbody id="append_Data">
                            <tr><td colspan="7" class="text-center">No record found.</td></tr>
                        </tbody>
                    </table>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts{
<script src="~/js/moment.min.js"></script>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
   
    $(document).ready(function () {

    
        let now = new Date();
        let firstDayOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
        let lastDayOfMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0);
        $('#txtFromDate').val(formatDateFiltter(firstDayOfMonth));
        $('#txtToDate').val(formatDateFiltter(lastDayOfMonth));


        $('#btnSearch').click(function () {
            PreLoadData();
        });
        $("#searchInput").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("table tbody tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
 // START ADDED BY AUMENTO :: SR88023-CR5305 :: 2.0
        //$("th").click(function () {
        //    var table = $(this).parents("table").eq(0)
        //    var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()))
        //    this.asc = !this.asc
        //    if (!this.asc) { rows = rows.reverse() }
        //    for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
        //})
        //function comparer(index) {
        //    return function (a, b) {
        //        var valA = getCellValue(a, index), valB = getCellValue(b, index)
        //        return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
        //    }
        //}
        //function getCellValue(row, index) {
        //    return $(row).children("td").eq(index).html()
        //}
        $("th").click(function () {
            var table = $(this).closest("table");
            var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()));
            var isAscending = $(this).hasClass("sorted-asc");

            $("th").removeClass("sorted-asc sorted-desc");
            $(this).addClass(isAscending ? "sorted-desc" : "sorted-asc");

            if (isAscending) {
                rows.reverse();
            }

            for (var i = 0; i < rows.length; i++) {
                table.append(rows[i]);
            }
        });

        function comparer(index) {
            return function (a, b) {
                var valA = getCellValue(a, index), valB = getCellValue(b, index);
                if ($.isNumeric(valA) && $.isNumeric(valB)) {
                    return valA - valB;
                } else {
                    return valA.toString().localeCompare(valB);
                }
            };
        }

        function getCellValue(row, index) {
            return $(row).children("td").eq(index).text().trim();
        }
         // END ADDED BY AUMENTO :: SR88023-CR5305 :: 2.0
        PreLoadData();
        
    });
   
    function PreLoadData() {
        $('#loader_new').removeClass('hidden');
        var StatusTest = $("#ddlStatus").val();
        var FromDate  = $('#txtFromDate').val().toString() || "";
        var ToDate = $('#txtToDate').val().toString() || "";

        if (FromDate == "")
        {
           return alert('Please Select From Date')
        }
        if (ToDate == "") {
            return alert('Please Select From Date')
        }

        $.ajax({
            async: false,
            type: "GET",
            url: "/NSPPayment/GetNSPPaymentDataList",
            data: { Status: StatusTest, FromDate: FromDate, ToDate: ToDate },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            success: function (data) {
                debugger;
                if (JSON.parse(data).length != 0) {
                    var Data1 = JSON.parse(data);
                    $("#append_Data").empty();

                    $.each(Data1, function (i, r) {
                        debugger;
                        var formattedDate = moment(r.RequestDate).format('DD-MMM-YYYY');
                        var STATUS = r.STATUS;
                        $("#append_Data").append('<tr><td><center>' +
                            EditorFormatter(r.HeaderID,r.STATUS) +
                            '</center></td><td><center>' + r.RequestRefNo +
                            '</center></td><td><center>' + formattedDate +
                            '</center></td><td><center>' + r.Category +
                            '</center></td><td><center>' + (r.VendorCode == null ? "" : r.VendorCode) +
                            '</center></td><td><center class="Setlineheight">' + (r.VendorName == null ? "" : r.VendorName) +
                            '</center></td><td><center>' + r.Location +
                            '</center></td><td><center>' + (r.TotalNetAmount ? r.TotalNetAmount : 0).toFixed(2) + // ADDED BY AUMENTO :: SR88023-CR5305 :: 2.0
                            '</center></td><td style="text-align: center;">' +
                            '<span style="margin-right:2px;">' + HistoryFormatter(r.HeaderID, r.STATUS) + '</span></td></tr>');
                    });

                // CSP 3.0 Compliant changes
                $('[data-ctrl-id="delete-header"]').on('click', function () {
                    Delete($(this).data('delete-id'));
                });
                 // CSP 3.0 Compliant changes
                $('[data-ctrl-id="print-header"]').on('click', function () {
                    Print($(this).data('print-id'));
                });
                // CSP 3.0 Compliant changes
                $('[data-ctrl-id="edit-header"]').on('click', function () {
                    Edit($(this).data('header-id'));
                });

                // CSP 3.0 Compliant changes
                $('[data-ctrl-id="history-header"]').on('click', function () {
                    History($(this).data('history-id'));
                });

                } else {
                    $("#append_Data").empty();
                    $("#append_Data").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>")
                }
                $('#loader_new').addClass('hidden');
            },
            complete: function () {
                $('#loader_new').addClass('hidden');
            },
            error: function () {
                alert("Oops...", "Something went wrong!");
                $('#loader_new').addClass('hidden');
            }
        });
    }
   
    function EditorFormatter(HeaderID, STATUS) {
        if (STATUS == 0) {
            return '<center><a title="Delete" class="btn btn-danger btn-xs" data-ctrl-id="delete-header" data-delete-id="'+HeaderID+'"><i class="ace-icon fa fa-trash"></i></a>&nbsp;<a title="Edit" class="btn btn-primary btn-xs"  data-ctrl-id="edit-header" data-header-id="'+HeaderID+'"><i class="ace-icon fa fa-edit"></i></a></center>';
        } else if ([2, 3, 4].includes(STATUS)) {
            return '<center><a title="Print" class="btn btn-secondary btn-xs" data-ctrl-id="print-header" data-print-id="'+HeaderID+'"><i class="fa fa-print" aria-hidden="true"></i></a>&nbsp;<a title="Edit" class="btn btn-primary btn-xs" data-ctrl-id="edit-header" data-header-id="'+HeaderID+'" ><i class="ace-icon fa fa-edit"></i></a></center>';
        } else {
            return '<center><a title="Edit" class="btn btn-primary btn-xs" data-ctrl-id="edit-header" data-header-id="'+HeaderID+'"><i class="ace-icon fa fa-edit"></i></a></center>';
        }

    }
    function HistoryFormatter(HeaderID, STATUS) {
        return '' + GetStatus(STATUS) + ' &nbsp;&nbsp;<a title="History" class="btn btn-primary btn-xs" data-ctrl-id="history-header" data-history-id="'+HeaderID+'"><i class="ace-icon fa fa-history"></i></a>';
    }
    function ADD() {
        debugger;
        var URL = '/NSPPayment/NSPPaymentRequestCreate';
        $.fancybox.open({
            href: URL,
            type: 'iframe',
            padding: 2,
            maxWidth: 1500,
            maxHeight: 1100,
            fitToView: false,
            width: '1500px',
            height: '1100px',
            autoSize: false,
            closeClick: true,
            openEffect: 'elastic',
            openSpeed: 120,
            closeEffect: 'elastic',
            closeSpeed: 100,
            afterClose: function () {
                PreLoadData();
            }, helpers: {
                overlay: { closeClick: false }
            }
        });

        return false;
    }
    function Edit(HeaderID) {
        debugger;
        var URL = '/NSPPayment/NSPPaymentRequestEdit/?id=' + HeaderID;
        $.fancybox.open({
            href: URL,
            type: 'iframe',
            padding: 2,
            maxWidth: 1400,
            maxHeight: 1100,
            fitToView: false,
            width: '1400px',
            height: '1100px',
            autoSize: true,
            closeClick: true,
            openEffect: 'elastic',
            openSpeed: 120,
            closeEffect: 'elastic',
            closeSpeed: 100,
            helpers:
            {
                overlay: { closeClick: false }
            },
            afterClose: function () {
                PreLoadData();
            },
            helpers: {
                overlay: { closeClick: false }
            }
        });
    }                               
    function Delete(HeaderID) {
        var URL = '/NSPPayment/NSPPaymentRequestDelete/?id=' + HeaderID;
        if(confirm("Are you sure you want to delete this?")){
            $.ajax({
                type: "POST",
                url: URL,
                datatype: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data == true) {
                        alert("Record Delete Sucessfully.");
                    }
                    PreLoadData();
                },
                error: function () {
                }
            });
        }
    }
    function History(HeaderID) {
        debugger;
        var URL = '/NSPPayment/GetNSPHistoryData?id=' + HeaderID;
        $.fancybox.open({
            href: URL,
            type: 'iframe',
            padding: 2,
            maxWidth: 1100,
            maxHeight: 400,
            //fitToView: false,
            width: '1100px',
            height: '400px',
           // autoSize: true,
            closeClick: true,
            openEffect: 'elastic',
            openSpeed: 120,
            closeEffect: 'elastic',
            closeSpeed: 100,
            helpers:
            {
                overlay: { closeClick: false }
            },
            afterClose: function () {
                // window.location.reload();
                        PreLoadData();
            }
        });
        return false;
    }
    function formatDateFiltter(date) {
        let year = date.getFullYear();
        let month = String(date.getMonth() + 1).padStart(2, '0'); // Months are zero-based
        let day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }
  
    function GetStatus(STATUS) {
        if (STATUS == 0) {
            return 'Initiate';
        } else if (STATUS == 1) {
            return 'Pending at Approval';
        } else if (STATUS == 2) {
            return 'Pending at Finance';
        } else if (STATUS == 3) {
            return 'Pending at Taxation';
        } else if (STATUS == 4) {
            return 'Approved By Finance';
        } else if (STATUS == 5) {
            return 'SendBack';
        } else if (STATUS == 6) {
            return 'Reject';
        } else if (STATUS == 7) {
            return 'Hold';
        } else {
            return '';
        }
    }

    function Print(HeaderID) {
        var Mode = "User";
        var URL = '/NSPPayment/GeneratePdfReport/?HeaderID=' + HeaderID + '&Mode=' + Mode;
        $.ajax({
            type: "POST",
            url: URL,
            dataType: "json",
            success: function (data) {
                debugger;
                if (data != null)
                {
                    var fullFilePath = "../../Uploads/NSPPayment/" + data.filePath;
                  
                    var width = screen.width - 100;
                    var height = screen.height - 100;
                    var winTop = 50;
                    var winLeft = 50;
                    var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
                    windowFeatures = windowFeatures + ",left=" + winLeft + ",";
                    windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes,scrollbars=yes";
                    window.open(fullFilePath, "_blank", windowFeatures);
                }
               
            },
            error: function () {
            }
        });
    }

</script>

@* CSP 3.0 Compliant changes *@
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    $(document).ready(function () {
        $('#btnAdd').on('click', function () {
            ADD($(this)[0]);
        });
    });
</script>

}