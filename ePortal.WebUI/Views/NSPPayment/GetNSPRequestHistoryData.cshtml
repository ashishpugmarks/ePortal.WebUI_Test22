            return Download(doc);
        });
        $(document).on('click', '#ancInvDoc', function (e) {
            e.preventDefault();
            var doc = $(this).data('doc');
            return Download(doc);
        });
        $(document).on('click', '#ancPoDoc', function (e) {
            e.preventDefault();
            var doc = $(this).data('doc');
            return Download(doc);
        });
    });
</script>
