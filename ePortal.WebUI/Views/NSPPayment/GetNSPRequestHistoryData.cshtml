</div>
@section Scripts{
<script src="~/js/jquery-ui-1.12.1.js"></script>

<script nonce="@Context.Items["ScriptNonce_3"]">
    $(document).ready(function () {
        var totalAmount = 0;
        $('.amount').each(function () {
            var amountText = $(this).text().trim();
            var amount = parseFloat(amountText);
            console.log('Amount:', amount);
            if (!isNaN(amount)) {
                totalAmount += amount;
            }
        });
        $('#txtTotalAmount').text(totalAmount.toFixed(2));
        var amountInWords = convertNumberToWords(totalAmount);
        $("#txtAmountInWords").text(amountInWords);
    });
    function convertNumberToWords(amount) {
        debugger;
        var words = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine'];
        var teens = ['Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
        var tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
        function convertLessThanThousand(number) {
            if (number === 0) {
                return '';
            } else if (number < 10) {
                return words[number] + ' ';
            } else if (number < 20) {
                return teens[number - 11] + ' ';
            } else if (number < 100) {
                return tens[Math.floor(number / 10)] + ' ' + convertLessThanThousand(number % 10);
            } else {
                return words[Math.floor(number / 100)] + ' Hundred ' + convertLessThanThousand(number % 100);
            }
        }
        if (isNaN(amount) || amount < 0 || amount > 10000000) {
            return 'Invalid input';
        }
        if (amount === 0) {
            return 'Zero';
        }
        var result = '';
        var crore = Math.floor(amount / 10000000);
        var lakh = Math.floor((amount % 10000000) / 100000);
        var thousand = Math.floor((amount % 100000) / 1000);
        var remainder = amount % 1000;
        if (crore > 0) {
            if (crore == 10) {
                result = 'Ten Crore ';
            }
            else {
                result += convertLessThanThousand(crore) + 'Crore ';
            }
        }
        if (lakh > 0) {
            if (lakh == 10) {
                result = 'Ten Lakh ';
            }
            else {
                result += convertLessThanThousand(lakh) + 'Lakh ';
            }
        }
        if (thousand > 0) {
            if (thousand == 10) {
                result = 'Ten Thousand ';
            }
            else {
                result += convertLessThanThousand(thousand) + 'Thousand ';
            }
        }
        if (remainder > 0) {
            result += convertLessThanThousand(remainder);
        }
        return result.trim();
    }
    function Download(FileName) {
        var fullFilePath = "../../Uploads/NSPPayment/" + FileName;
        var width = screen.width - 100;
        var height = screen.height - 100;
        var winTop = 50;
        var winLeft = 50;
        var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
        windowFeatures = windowFeatures + ",left = " + winLeft + ",";
        windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
        window.open(fullFilePath, "_blank", windowFeatures);
    }
</script>
@* CSP 3.0 Compliant changes *@
<script nonce="@Context.Items["ScriptNonce_4"]">
