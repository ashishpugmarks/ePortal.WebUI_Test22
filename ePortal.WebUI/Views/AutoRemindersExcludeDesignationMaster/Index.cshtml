@model ePortal.ViewModels.AutoRemindersExcludeDesignationMaster

@{
    ViewBag.Title = "Auto Reminders Exclude Designation Master";
    Layout = "~/Views/Shared/_LayoutAsset.cshtml";

    var List = ViewBag.ViewToList as List<ePortal.ViewModels.AutoRemindersExcludeDesignationMaster>;
}
@section Styles {
    <link href="~/css/index.css" rel="stylesheet" type="text/css" media="all" />

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .btn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
            width: 329px !important;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .dropdownt {
            width: 326px !important;
        }

        .resr {
            font-weight: bold;
            background-color: #C3E214;
            border-radius: 5px;
            border: 2px solid #ccc;
            text-align: center;
            padding: 5px 15px;
            width: 120px;
            font-size: 12px;
        }

        .CS {
            background-color: #abcdef;
            color: Yellow;
            border: 1px solid #AB00CC;
            font: Verdana 10px;
            padding: 1px 4px;
            font-family: Roboto-Regular;
        }

        * {
            box-sizing: border-box;
        }

        .dropdown-check-list {
            display: inline-block;
        }

            .dropdown-check-list .anchor {
                position: relative;
                cursor: pointer;
                display: inline-block;
                padding: 5px 50px 5px 10px;
                border: 1px solid #ccc;
            }

                .dropdown-check-list .anchor:after {
                    position: absolute;
                    content: "";
                    border-left: 2px solid black;
                    border-top: 2px solid black;
                    padding: 5px;
                    right: 10px;
                    top: 20%;
                    -moz-transform: rotate(-135deg);
                    -ms-transform: rotate(-135deg);
                    -o-transform: rotate(-135deg);
                    -webkit-transform: rotate(-135deg);
                    transform: rotate(-135deg);
                }

                .dropdown-check-list .anchor:active:after {
                    right: 8px;
                    top: 21%;
                }

        dropdown-check-list ul.items {
            padding: 2px;
            display: none;
            margin: 0;
            border: 1px solid #ccc;
            border-top: none;
            width: 370px !important;
        }

        .dropdown-check-list ul.items li {
            list-style: none;
        }

        .dropdown-check-list.visible .anchor {
            color: #0094ff;
        }

        .dropdown-check-list.visible .items {
            display: block;
        }

        .cellpadding {
            padding: 5px 5px;
        }

        .form-wrapper {
            margin-top: 20px;
        }

        .spret {
            border: 1px solid #ccc;
        }

        .form-label {
            color: #000;
            font-size: 10px;
        }

        .form-input {
            font-size: 13px;
            padding: 2px 5px;
            border: 1px solid #ccc;
            // width:220px !important;
        }

        .field-indicator {
            color: #F00;
            vertical-align: middle;
        }

        .multiselect-container > li > a {
            padding: 0px;
            width: 320px !important;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .bttn {
            background-color: #e3e3e3;
            color: #333;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
            font-size: 16px;
        }

        .ui-widget-header, .ui-state-default, ui-button {
            font-weight: bold;
            font-size: 16px;
        }

        .ui-dialog .ui-dialog-content {
            font-size: 14px;
        }

        .ui-dialog-buttonset {
            font-size: 16px;
        }

        .btn1 {
            width: 190px !important;
            font-size: 14px !important;
            background-color: #e3e3e3;
            border: 1px solid #e6e6e6;
            border-radius: 3px;
            padding: 6px 12px;
        }

        .ui-dialog-titlebar-close:before {
            content: "x";
        }
    </style>
}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold;font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;width:98%;margin-left:1%;">
        <div style="padding:8px;">@TempData["PageHead"]</div>
    </div>
    @if (TempData["msg"] != null)
    {
        <span class="error">
            @TempData["msg"].ToString()
        </span>
    }
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(x => x.DESIGNATION_ID)
    <div class="body-content" style="overflow-x:hidden">
        <div id="msform">
            <table class="table" style="font-size:13px;border:1px solid;" id="GetData">
                <thead>
                    <tr>
                    <tr style="background-color: lightblue;">
                        <th style="border:1px solid;text-align:center; width:2%;">Sr.No.</th>
                        <th style="border:1px solid;text-align:center; width:22%;">@Html.DisplayName("Designation")</th>
                        <th style="border:1px solid;width:2%;text-align:center">Exclude</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        foreach (var item in List)
                        {
                            <tr>
                                <td style="border:1px solid;text-align:center;">@index</td>
                                <td style="border:1px solid;text-align:center;">@item.DESIGNATION_DESCRIPTION</td>
                                <td style="border:1px solid;text-align:center;">
                                    <input type="checkbox" checked="@(item.IS_EXCLUDE == "Y")" name="ID" value="@item.DESIGNATION_ID" class="custom-checkbox" />
                                </td>
                            </tr>
                            index++;
                        }
                        if (List.Count == 0)
                        {
                            <tr>
                                <td colspan="7" style="border:1px solid;text-align:center;">No record found.</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <div class="form-group" style="display:none">
                <div class="col-md-12" style="align-items: center;">
                    <input type="button" value="Update" style="height: 31px; margin-left: 1164px; background-color: #ccc; border-color: #4e4e4e; width: 10%; color: #232121; font-weight : bold ;" class="btnBulkUpdate" />
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#GetData').DataTable({
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excel',
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4]
                        }
                    }
                ]
            });
        });
    </script>
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        var Ids = [];
        // $('#GetData tbody').on('click', 'input[type="checkbox"]', function (e) {
        //     if (this.checked) {
        //         Ids.push($(this).val());
        //         console.log("Ids",Ids)
        //     }
        //     else {
        //         Ids = arrayRemove(Ids, $(this).val());
        //         console.log("remove Ids",Ids)
        //     }
        // })

        // function arrayRemove(arr, value) {
        //     return arr.filter(function (ele) {
        //         return ele != value;
        //     });
        // }


         $('#GetData tbody').on('click', 'input[type="checkbox"]', function (e) {
            if (this.checked)
            {
                console.log("Ids",$(this).val())
                BulkUpdate($(this).val())
            }
            else {
                console.log("remove Ids",$(this).val())
                BulkUpdate($(this).val());;
            }
        })

        function BulkUpdate(selectIDs)
        {
            $.ajax({
                type: "POST",
                url: "/AutoRemindersExcludeDesignationMaster/BulkUpdate",
                data: { selectIDs: selectIDs },
                dataType: "json",
                success: function (response)
                {
                    if (response.success)
                    {
                        alert("Updated Sucessfully...!");
                        //window.location.reload();
                    }
                    else
                    {
                        alert(response.error);
                    }
                }
            });
        }


        $(".btnBulkUpdate").click(function ()
        {
            var newIds = '';
            if (Ids != null && Ids != "")
            {
                newIds = Ids.toString()
                console.log("newIds",newIds);
            }

            if (Ids != null && Ids != "")
            {
                console.log("call");
                $.ajax({
                    type: "POST",
                    url: "/AutoRemindersExcludeDesignationMaster/BulkUpdate",
                    data: { selectIDs: newIds },
                    dataType: "json",
                    success: function (result)
                    {
                        console.log("result",result);
                        alert("Updated Sucessfully...!")
                    },
                });
            }
            else
            {
                alert("Please select at least on item for asset edit.")
            }
        });

    </script>



    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
        $("#BtnCancel").click(function () {
            location.reload(true);

        });
    </script>
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
        function BtnBack(ths, event) {
            window.location.href = "Search";
        }
    </script>

    


    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
        $(document).ready(function () {
            $('#BtnCancel').on('click', function () {
                CancelBtnClickEvent();
            });
        });
    </script>
}