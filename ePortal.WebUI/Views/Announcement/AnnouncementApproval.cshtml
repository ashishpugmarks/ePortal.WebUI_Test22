@model IEnumerable<ePortal.ViewModels.AnnouncementApprovalViewModel>

@{
    ViewBag.Title = "AnnouncementApproval";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .scrollit {
            overflow-y: auto;
            max-height: 100px;
        }

        select.input-sm {
            line-height: 10px !important;
        }
    </style>
}

    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Announcement Approval</div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <table class="table table-bordered table-hover table-responsive" id="tbAnnouncementList" style="width:100%">
                <thead>
                    <tr class="info">
                        <th colspan="10">
                            <b class="pull-left">Approval List</b>
                            @*<b class="pull-right">
                                    <button class="btn btn-primary btn-xs" onclick="openCreatePopup(this);">Create New</button>
                                </b>*@
                        </th>
                    </tr>
                    <tr>
                        <th class="text-center">
                            @Html.DisplayName("SNo")
                        </th>
                        @*<th>
                                @Html.DisplayNameFor(model => model.ATTACHMENTID)
                            </th>*@
                        <th class="text-left">
                            @Html.DisplayNameFor(model => model.AnnouncementTrn.SUBJECT)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.AnnouncementTrn.BRIEF)
                        </th>
                        <th class="text-left">
                            @Html.DisplayNameFor(model => model.INITIATED_BY)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.INITIATED_DATE)
                        </th>
                        @*<th class="text-left">
                                @Html.DisplayNameFor(model => model.INITIATOR_REMARKS)
                            </th>*@
                        @*<th class="text-center">
                                @Html.DisplayNameFor(model => model.APPAUTH1_DATE)
                            </th>
                            <th class="text-center">
                                @Html.DisplayNameFor(model => model.APPAUTH2_DATE)
                            </th>*@
                        @*<th>
                                @Html.DisplayNameFor(model => model.APPAUTH1_ECODE)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.APPAUTH1_REMARKS)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.APPAUTH2_ECODE)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.APPAUTH2_REMARKS)
                            </th>*@
                        <th class="text-left">
                            @Html.DisplayName("Assign By")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Assign Date")
                        </th>
                        @*<th class="text-left">
                                @Html.DisplayName("Remarks")
                            </th>*@
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.STATUS)
                        </th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowNo = 0;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center" style="width:3%;">
                                @(rowNo += 1)
                                @Html.HiddenFor(modelItem => item.ATTACHMENTAPPID)
                            </td>
                            @*<td>
                                    @Html.DisplayFor(modelItem => item.ATTACHMENTID)
                                </td>*@
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.AnnouncementTrn.SUBJECT)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.AnnouncementTrn.BRIEF)
                            </td>
                            <td class="text-left" style="width:13%;">
                                @Html.DisplayFor(modelItem => item.INITIATED_User)
                            </td>
                            <td class="text-center" style="width:7%;">
                                @Html.DisplayFor(modelItem => item.INITIATED_DATE)
                            </td>
                            @*<td class="text-left">
                                    <div class="scrollit">
                                        @Html.DisplayFor(modelItem => item.INITIATOR_REMARKS)
                                    </div>
                                </td>*@
                            @*<td class="text-center" style="width:7%;">
                                    @Html.DisplayFor(modelItem => item.APPAUTH1_DATE)
                                </td>
                                <td class="text-center" style="width:7%;">
                                    @Html.DisplayFor(modelItem => item.APPAUTH2_DATE)
                                </td>*@
                            @*<td>
                                    @Html.DisplayFor(modelItem => item.APPAUTH1_ECODE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.APPAUTH1_REMARKS)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.APPAUTH2_ECODE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.APPAUTH2_REMARKS)
                                </td>*@
                            <td class="text-left" style="width:13%;">
                                @Html.DisplayFor(modelItem => item.HRAPP_User)
                            </td>
                            <td class="text-center" style="width:8%;">
                                @Html.DisplayFor(modelItem => item.HRAPP_DATE)
                            </td>
                            @*<td class="text-left">
                                    @Html.DisplayFor(modelItem => item.HRAPP_REMARKS)
                                </td>*@
                            <td class="text-center" style="width:7%;">
                                @if (item.STATUS == 2)
                                {
                                    <span style="cursor: text !important;" class="btn btn-warning btn-xs">Pending Approval 1</span>
                                }
                                else if (item.STATUS == 3)
                                {
                                    <span style="cursor: text !important;" class="btn btn-warning btn-xs">Pending Approval 2</span>
                                }
                                else if (item.STATUS == 5)
                                {
                                    <button class="btn btn-dark btn-xs">Cancel By User</button>
                                }
                            </td>
                            <td class="text-center" style="width:6%;">
                                <button class="btn btn-warning btn-xs glyphicon glyphicon-edit" title="Click to Approve/Reject/Sendback" data-attachmentId="@item.ATTACHMENTID" data-subject="@item.AnnouncementTrn.SUBJECT" data-brief="@item.AnnouncementTrn.BRIEF"
                                        data-description="@item.AnnouncementTrn.DESCRIPTION" data-banner="@item.AnnouncementTrn.BANNER_NAME" data-attachment1="@item.AnnouncementTrn.ATTACHMENT1_NAME"
                                        data-attachment2="@item.AnnouncementTrn.ATTACHMENT2_NAME" data-status="@item.STATUS" data-fndesignation="@item.AnnouncementTrn.FnDesignationDescrip" data-designation="@item.AnnouncementTrn.DesignationDescrip" data-site="@item.AnnouncementTrn.SiteDescrip"
                                        data-ctrl="btn-open-upd-stat-popup" id="@item.ATTACHMENTAPPID"></button>
                                <button class="btn btn-info btn-xs glyphicon glyphicon-tasks" title="Click to view details" name="Details" data-ctrl="btn-get-att-detail" id="@item.ATTACHMENTAPPID"></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="myApprovalModal" class="modal" tabindex="-1" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="pull-left">
                            <h5 class="modal-title">Approve / Reject</h5>
                        </div>
                        <div class="pull-right">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    </div>
                    <div class="modal-body">
                        <div id="myApproveModalContent" style="font-size:14px;">
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <input type="hidden" id="hfAttachmentAppId" />
                                        <label>Subject :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <span id="lblSubject"></span>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">

                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <label>Brief :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <span id="lblBrief"></span>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <label>Description :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9 scrollit">
                                        <span id="lblDescription"></span>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <label>Banner :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <input type="hidden" id="bannerAttachmentId" />
                                        <div><a style="cursor:pointer;" id="banner_download" data-type="Banner">Download </a>(<span id="lblBanner"></span>)</div>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <label>Attachment 1 :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <input type="hidden" id="firstAttachmentId" />
                                        <div><a style="cursor:pointer;" id="attachment1_download" data-type="Attachment1">Download </a>(<span id="lblAttachment1"></span>)</div>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <label>Attachment 2 :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <input type="hidden" id="secondAttachmentId" />
                                        <div><a style="cursor:pointer;" id="attachment2_download" data-type="Attachment2">Download </a>(<span id="lblAttachment2"></span>)</div>
                                    </div>
                                </div>
                            </div>
                            <br />
                            @*<div style="margin-left:0px; text-align:center; margin-bottom:7px; font-weight:bold;"><span class="bold">----- Applicable To -----</span></div>*@
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <label>Fn-Designation :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <span id="lblFnDesignation"></span>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <label>Designation :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <span id="lblDesignation"></span>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <label>Location :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <span id="lblSite"></span>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <input type="hidden" id="hfCurrentStatus" />
                                        <label>Remarks :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <textarea id="txtRemarks" class="form-control" rows="5"></textarea>
                                        <span id="lblMessage" class="text-danger hidden"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success" id="btnApprove">Approve</button>
                        <button type="button" class="btn btn-danger" id="btnReject">Reject</button>
                        <button type="button" class="btn btn-warning" id="btnSendBack">Send Back</button>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal" aria-label="Close">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

        <div id="myDetailsModel" class="modal" tabindex="-1" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="pull-left">
                            <h5 class="modal-title">Details</h5>
                        </div>
                        <div class="pull-right">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    </div>
                    <div class="modal-body">
                        <div id="myDetailModalContent" style="font-size:14px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $("#tbAnnouncementList").dataTable();
            $('.homeContent').removeClass('homeContent');
        });

        function GetDetails(current) {
            var $buttonClicked = $(this);
            $.ajax({
                type: "GET",
                url: "/Announcement/AnnouncementApprovalDetails",
                data: { id: current.id },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    $('#myDetailModalContent').html(data);
                    $('#myDetailsModel').modal({ backdrop: "static" });
                },
                error: function () {
                    alert("Content load failed.");
                }
            });
        }

        function UpdateStatus(current) {
            var remarks = $('#txtRemarks').val();
            if (remarks == "") {
                $("#lblMessage").text("Please enter remarks");
                $("#lblMessage").removeClass("hidden");
                return;
            }
            var actionName, actionMessage, actionType = "";
            var actionName = current.innerText;
            switch (actionName) {
                case "Approve":
                    actionType = "success";
                    actionMessage = " Request is Approved successfully";
                    break;
                case "Reject":
                    actionType = "success";
                    actionMessage = "Request is rejected successfully"
                    break;
                case "Send Back":
                    actionType = "success";
                    actionMessage = "Request is Send Back successfully"
            }
            var status = "";
            var currentStatus = $('#hfCurrentStatus').val()
            if (currentStatus == "2") {
                status = $(current).text() == "Approve" ? 3 : $(current).text() == "Reject" ? 10 : 7; // status 3 : Approved by Authority 1, 10 : Reject, 7: Send Back Authority 1
            }
            else if (currentStatus == "3") {
                status = $(current).text() == "Approve" ? 4 : $(current).text() == "Reject" ? 11 : 8; // status 4 : Approved by Authority 2, 11 : Reject, 8: Send Back Authority 2
            }
            var data = {
                ATTACHMENTAPPID: $('#hfAttachmentAppId').val(),
                APPAUTH1_REMARKS: $('#txtRemarks').val(),
                APPAUTH2_REMARKS: $('#txtRemarks').val(),
                STATUS: status
            }
            var $buttonClicked = $(this);
            $.ajax({
                type: "POST",
                url: "/Announcement/UpdateAnnouncementStatus",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    $('#myApprovalModal').modal('hide');
                    $('#hfAttachmentAppId').val("");
                    $('#lblSubject').text("");
                    $('#txtRemarks').text("");
                    swal({
                        title: "",
                        text: actionMessage,
                        type: actionType,
                    }, function (isConfirm) {
                        if (isConfirm) {
                            window.location.href = "/Announcement/AnnouncementApproval";
                        }
                    });
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function OpenUpdateStatusPopup(current) {
            $("#lblMessage").text("");
            $("#lblMessage").addClass("hidden");
            $('#hfAttachmentAppId').val(current.id);
            $('#bannerAttachmentId').val($(current).attr("data-attachmentId"));
            $('#firstAttachmentId').val($(current).attr("data-attachmentId"));
            $('#secondAttachmentId').val($(current).attr("data-attachmentId"));
            $('#hfCurrentStatus').val($(current).attr("data-status"));
            $('#lblSubject').text($(current).attr("data-subject"));
            $('#lblBrief').text($(current).attr("data-brief"));
            $('#lblDescription').text($(current).attr("data-description"));
            $('#lblFnDesignation').text($(current).attr("data-fndesignation"));
            $('#lblDesignation').text($(current).attr("data-designation"));
            $('#lblSite').text($(current).attr("data-site"));

            var banner = $(current).attr("data-banner") == null || $(current).attr("data-banner") == "" ? "N/A" : $(current).attr("data-banner");
            $('#lblBanner').text(banner);
            $(current).attr("data-banner") == null || $(current).attr("data-banner") == "" ? $('#banner_download').addClass('hidden') : $('#banner_download').removeClass('hidden');

            var attachment1 = $(current).attr("data-attachment1") == null || $(current).attr("data-attachment1") == "" ? "N/A" : $(current).attr("data-attachment1");
            $('#lblAttachment1').text(attachment1);
            $(current).attr("data-attachment1") == null || $(current).attr("data-attachment1") == "" ? $('#attachment1_download').addClass('hidden') : $('#attachment1_download').removeClass('hidden');

            var attachment2 = $(current).attr("data-attachment2") == null || $(current).attr("data-attachment2") == "" ? "N/A" : $(current).attr("data-attachment2");
            $('#lblAttachment2').text(attachment2);
            $(current).attr("data-attachment2") == null || $(current).attr("data-attachment2") == "" ? $('#attachment2_download').addClass('hidden') : $('#attachment2_download').removeClass('hidden');
            $('#myApprovalModal').modal({ backdrop: "static" });
        }

        function DownloadAttachment(current) {
            var type = $(current).attr("data-type");
            if (type == "Banner") {
                var id = $('#bannerAttachmentId').val();
                var Atype = "Banner";
            }
            else if (type == "Attachment1") {
                var id = $('#firstAttachmentId').val();
                var Atype = "Attachment1";
            }
            else if (type == "Attachment2") {
                var id = $('#secondAttachmentId').val();
                var Atype = "Attachment2";
            }
            window.location.href = '/Announcement/Download/?id=' + id + '&type=' + Atype;
        }

    </script>

    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#btnSendBack').on('click', function () {
                UpdateStatus($(this)[0]);
            });
            $('#btnReject').on('click', function () {
                UpdateStatus($(this)[0]);
            });
            $('#btnApprove').on('click', function () {
                UpdateStatus($(this)[0]);
            });
            $('#attachment2_download').on('click', function () {
                DownloadAttachment($(this)[0]);
            });
            $('#attachment1_download').on('click', function () {
                DownloadAttachment($(this)[0]);
            });
            $('#banner_download').on('click', function () {
                DownloadAttachment($(this)[0]);
            });
            $('[data-ctrl="btn-get-att-detail"]').on('click', function () {
                GetDetails($(this)[0]);
            });
            $('[data-ctrl="btn-open-upd-stat-popup"]').on('click', function () {
                OpenUpdateStatusPopup($(this)[0]);
            });
        });
    </script>
    }