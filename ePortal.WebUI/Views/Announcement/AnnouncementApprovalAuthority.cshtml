@model IEnumerable<ePortal.ViewModels.AnnouncementApprovalViewModel>

@{
    ViewBag.Title = "AnnouncementApprovalAuthority";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
    .scrollit {
        overflow-y: auto;
        max-height: 100px;
    }

    select.input-sm {
        line-height: 10px !important;
    }
</style>
}
<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">Announcement Approval Authority</div>
    </div>

    <div class="body-content" style="overflow-x:auto!important;">
        <table class="table table-bordered table-hover table-responsive" id="tbAnnouncementList" style="width:100%">
            <thead>

                <tr class="info">
                    <th colspan="10">
                        <b class="pull-left">Approval Authority List</b>
                        @*<b class="pull-right">
                                <button class="btn btn-primary btn-xs" onclick="openCreatePopup(this);">Create New</button>
                            </b>*@
                    </th>
                </tr>
                <tr>
                    <th class="text-center">
                        @Html.DisplayName("SNo")
                    </th>
                    @*<th class="text-center">
                            @Html.DisplayNameFor(model => model.ATTACHMENTAPPID)
                        </th>*@
                    @*<th>
                            @Html.DisplayNameFor(model => model.ATTACHMENTID)
                        </th>*@
                    <th class="text-left">
                        @Html.DisplayNameFor(model => model.AnnouncementTrn.SUBJECT)
                    </th>
                    <th class="text-left">
                        @Html.DisplayNameFor(model => model.AnnouncementTrn.BRIEF)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.INITIATED_BY)
                    </th>
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.INITIATED_DATE)
                    </th>
                    @*<th class="text-left">
                            @Html.DisplayNameFor(model => model.INITIATOR_REMARKS)
                        </th>*@
                    @*<th>
                            @Html.DisplayNameFor(model => model.APPAUTH1_ECODE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.APPAUTH1_DATE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.APPAUTH1_REMARKS)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.APPAUTH2_ECODE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.APPAUTH2_DATE)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.APPAUTH2_REMARKS)
                        </th>*@
                    @*<th class="text-center">
                            @Html.DisplayNameFor(model => model.HRAPP_ECODE)
                        </th>*@
                    @*<th class="text-center">
                            @Html.DisplayNameFor(model => model.HRAPP_DATE)
                        </th>*@
                    @*<th class="text-left">
                            @Html.DisplayNameFor(model => model.HRAPP_REMARKS)
                        </th>*@
                    <th class="text-center">
                        @Html.DisplayNameFor(model => model.STATUS)
                    </th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @{ int rowNo = 0; }
                @foreach (var item in Model)
            {
                    <tr>
                        <td class="text-center" style="width:3%;">
                            @(rowNo += 1)
                            @Html.HiddenFor(modelItem => item.ATTACHMENTAPPID)
                        </td>
                        @*<td>
                                @Html.DisplayFor(modelItem => item.ATTACHMENTID)
                            </td>*@
                        <td class="text-left">
                            @Html.DisplayFor(modelItem => item.AnnouncementTrn.SUBJECT)
                        </td>
                        <td class="text-left">
                            @Html.DisplayFor(modelItem => item.AnnouncementTrn.BRIEF)
                        </td>
                        <td class="text-center" style="width:14%;">
                            @Html.DisplayFor(modelItem => item.INITIATED_User)
                        </td>
                        <td class="text-center" style="width:7%;">
                            @Html.DisplayFor(modelItem => item.INITIATED_DATE)
                        </td>
                        @*<td class="text-left" style="width:35%;">
                                <div class="scrollit">
                                    @Html.DisplayFor(modelItem => item.INITIATOR_REMARKS)
                                </div>
                            </td>*@
                        @*<td>
                                @Html.DisplayFor(modelItem => item.APPAUTH1_ECODE)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.APPAUTH1_DATE)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.APPAUTH1_REMARKS)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.APPAUTH2_ECODE)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.APPAUTH2_DATE)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.APPAUTH2_REMARKS)
                            </td>*@
                        @*<td class="text-center" style="width:14%;">
                                @Html.DisplayFor(modelItem => item.HRAPP_User)
                            </td>*@
                        @*<td class="text-center" style="width:7%;">
                                @Html.DisplayFor(modelItem => item.HRAPP_DATE)
                            </td>*@
                        @*<td class="text-left">
                                @Html.DisplayFor(modelItem => item.HRAPP_REMARKS)
                            </td>*@
                        <td class="text-center" style="width:7%;">
                            @if (item.STATUS == 1)
                            {
                                <button class="btn btn-secondary btn-xs">Initiated</button>//Initiated / Pending for Approval Auth set by HR
                            }
                            else if (item.STATUS == 2)
                            {
                                <button class="btn btn-success btn-xs">Approved</button>//Approval Authorities are entered by HR/Pending at Approval Authority 1
                            }
                            else if (item.STATUS == 9)
                            {
                                <button class="btn btn-danger btn-xs">Reject By HR</button>// Reject By HR
                            }
                            else if (item.STATUS == 6)
                            {
                                <button class="btn btn-secondary btn-xs">Send Back By HR</button>
                            }
                            else if (item.STATUS == 5)
                            {
                                <button class="btn btn-dark btn-xs">Cancel By User</button>
                            }
                        </td>
                        <td class="text-center" style="width:6%;">
                           <button class="btn btn-warning btn-xs glyphicon glyphicon-edit" data-ctrl="btn-open-edit-popup" id="@item.ATTACHMENTAPPID" title="Click to set approval authority"></button>
                            <button class="btn btn-info btn-xs glyphicon glyphicon-tasks" name="Details" data-ctrl="btn-get-details" id="@item.ATTACHMENTAPPID" title="Click to view details"></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="myEditModal" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div id="myModelHeader"></div>
                </div>
                @*<label id="closbtn" class="modal-close" for="modal-toggle">&#x2715;</label>*@
                <div class="modal-body">
                    <div id="myModalContent"></div>
                </div>
            </div>
        </div>
    </div>

    <div id="myDetailsModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="pull-left">
                        <h5 class="modal-title">Details</h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body">
                    <div id="myDetailModalContent" style="font-size:14px;"></div>
                </div>
            </div>
        </div>
    </div>
    </div>
@section Scripts {
    <script src="@Url.Content("~/js/jquery.validate.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/js/jquery.validate.unobtrusive.js")" type="text/javascript"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $("#tbAnnouncementList").dataTable();
            $('.homeContent').removeClass('homeContent');
        });

        function openEditPopup(current) {
            var $buttonClicked = $(this);
            $.ajax({
                type: "GET",
                url: "/Announcement/EditAnnouncementApprovalAuthority",
                data: { id: current.id },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    var headerHtml = '<div class="pull-left"><h5 class="modal-title">Set Approval Authority</h5></div><div class="pull-right"><button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px"><span aria-hidden="true">&times;</span></button></div>'
                    $('#myModelHeader').html(headerHtml);
                    $('#myModalContent').html(data);
                    $('#myEditModal').modal({ backdrop: "static" });
                },
                error: function () {
                    alert("Content load failed.");
                }
            });
        }

        function GetDetails(current) {
            var $buttonClicked = $(this);
            $.ajax({
                type: "GET",
                url: "/Announcement/AnnouncementApprovalDetails",
                data: { id: current.id },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    $('#myDetailModalContent').html(data);
                    $('#myDetailsModel').modal({ backdrop: "static" });
                },
                error: function () {
                    alert("Content load failed.");
                }
            });
        }

    </script>
    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('[data-ctrl="btn-get-details"]').on('click', function () {
                GetDetails($(this)[0]);
            });
            $('[data-ctrl="btn-open-edit-popup"]').on('click', function () {
                openEditPopup($(this)[0]);
            });
        });
    </script>
}