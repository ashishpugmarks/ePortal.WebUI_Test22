@model ePortal.ViewModels.AnnouncementMasterViewModel

@{
    Layout = null;
}
<!doctype html>
<html>
<head>
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .form-group {
            margin-bottom: 8px !important;
        }

        .textArea {
            max-width: 418px;
        }
    </style>
    @*<script src="~/js/jquery.3.6.3.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.js"></script>*@
    @*<link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet" />*@
    @*<script src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script>
    <script src="~/js/jquery.validate.min.js" type="text/javascript"></script>
    <script src="~/js/jquery.validate.unobtrusive.js" type="text/javascript"></script>*@

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
        $(document).ready(function () {
            var today = new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate());
            $('#START_DATE').datepicker({
                format: "dd-M-yyyy",
                //startDate: today,
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top'
            });
            $('#END_DATE').datepicker({
                format: "dd-M-yyyy",
                //startDate: today,
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top'
            });

            $("#Upload_Banner").change(function () {
                var _URL = window.URL || window.webkitURL;
                var file = $(this)[0].files[0];
                var image = new Image();
                image.src = _URL.createObjectURL(file);
                var extension = $(this).val().split('.').pop().toLowerCase();
                var validFileExtensions = ['gif', 'png', 'jpg', 'jpeg'];
                if ($.inArray(extension, validFileExtensions) == -1) {
                    alert("Sorry!! Upload only 'gif', 'png', 'jpg', 'jpeg' file")
                    $(this).replaceWith($(this).val('').clone(true));
                    $('#Apply').prop('disabled', true);
                } else {
                    if ($(this).get(0).files[0].size > (3e+6)) {
                        alert("Sorry!! Max allowed file size is 3 mb");
                        $(this).replaceWith($(this).val('').clone(true));
                        $('#Apply').prop('disabled', true);
                    }
                    image.onload = function () {
                        var height = this.height;
                        var width = this.width;
                        if (height < 150 && width < 200) {
                            alert("Sorry!! Width and Height must be between 200px - 250px & 150px - 200px.");
                            $("#Upload_Banner").replaceWith($("#Upload_Banner").val('').clone(true));
                        }
                        else if (height > 200 && width > 250) {
                            alert("Sorry!! Width and Height must be between 200px - 250px & 150px - 200px.");
                            $("#Upload_Banner").replaceWith($("#Upload_Banner").val('').clone(true));
                        }
                        else {
                            $('#Apply').prop('disabled', false);
                        }
                    };
                }
            });

            $("#Upload_Attachment1").change(function () {
                var extension = $(this).val().split('.').pop().toLowerCase();
                var validFileExtensions = ['pdf', 'doc', 'docx', 'ppt', 'pptx', 'gif', 'png', 'jpg', 'jpeg'];
                if ($.inArray(extension, validFileExtensions) == -1) {
                    alert("Sorry!! Upload only 'pdf', 'doc', 'docx', 'ppt', 'pptx', 'gif', 'png', 'jpg', 'jpeg' file")
                    $(this).replaceWith($(this).val('').clone(true));
                    $('#Apply').prop('disabled', true);
                } else {
                    if ($(this).get(0).files[0].size > (3e+6)) {
                        alert("Sorry!! Max allowed file size is 3 mb");
                        $(this).replaceWith($(this).val('').clone(true));
                        $('#Apply').prop('disabled', true);
                    } else {
                        $('#Apply').prop('disabled', false);
                    }
                }
            });

            $("#Upload_Attachment2").change(function () {
                var extension = $(this).val().split('.').pop().toLowerCase();
                var validFileExtensions = ['pdf', 'doc', 'docx', 'ppt', 'pptx', 'gif', 'png', 'jpg', 'jpeg'];
                if ($.inArray(extension, validFileExtensions) == -1) {
                    alert("Sorry!! Upload only 'pdf', 'doc', 'docx', 'ppt', 'pptx', 'gif', 'png', 'jpg', 'jpeg' file")
                    $(this).replaceWith($(this).val('').clone(true));
                    $('#Apply').prop('disabled', true);
                } else {
                    if ($(this).get(0).files[0].size > (3e+6)) {
                        alert("Sorry!! Max allowed file size is 3 mb");
                        $(this).replaceWith($(this).val('').clone(true));
                        $('#Apply').prop('disabled', true);
                    } else {
                        $('#Apply').prop('disabled', false);
                    }
                }
            });
        });

        function readBannerURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#banner-img')
                        .attr('src', e.target.result);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function openPreviewPopup() {
            var img = "";
            $('#Attachment1-link').text('');
            $('#Attachment2-link').text('');
            var attachment1 = $('#Upload_Attachment1').prop('files');
            $('#Attachment1-link').text(attachment1.length > 0 ? attachment1[0].name : "");
            var attachment2 = $('#Upload_Attachment2').prop('files');
            $('#Attachment2-link').text(attachment2.length > 0 ? attachment2[0].name : "");
            $('#lblSubject').text($('#SUBJECT').val());
            $('#lblDescription').text($('#DESCRIPTION').val());
            $('.lblCreateDate').text(new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate()).toDateString('ddd MMM yyyy'))
            $('#myAnnouncementsModal').modal({ backdrop: "static" });
        }
        $("#closeModel").click(function () {
            $('#myAnnouncementsModal').modal('hide');
        });
    </script>
</head>

<body>
    @*<div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #9A9A9A; color: #FFF; vertical-align: middle;">
            <div style="padding:9px;">Add New Process Attachment</div>
        </div>*@
    <div class="body-content" style="padding:0px !important;">
        <div>
            @using (Html.BeginForm("CreateAnnouncement", "Announcement", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @*<div class="form-group hidden">
                            <div class="col-md-2">
                                @Html.HiddenFor(model => model.ATTACHMENTID, htmlAttributes: new { @class = "form-control" })
                            </div>
                        </div>*@
                    <div class="form-group">
                        @Html.LabelFor(model => model.PROCESSID, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-4">
                            @Html.DropDownListFor(model => model.PROCESSID, new SelectList(ViewBag.ContentProcess.Items, "PROCESSID", "PROCESS_NAME"), new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.PROCESSID, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.SUBJECT, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.SUBJECT, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.SUBJECT, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.BRIEF, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.BRIEF, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.BRIEF, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.DESCRIPTION, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.TextAreaFor(model => model.DESCRIPTION, new { @class = "form-control textArea", @rows = "4" })
                            @*@Html.EditorFor(model => model.DESCRIPTION, new { htmlAttributes = new { @class = "form-control" }, new { @row="4" } })*@
                            @Html.ValidationMessageFor(model => model.DESCRIPTION, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.START_DATE, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-3">
                            @Html.TextBoxFor(x => x.START_DATE, new { @class = "form-control", @id = "START_DATE", placeholder = "dd-MMM-yyyy", @readonly = "readonly" })
                            @Html.ValidationMessageFor(model => model.START_DATE, "", new { @class = "text-danger" })
                        </div>
                        @Html.LabelFor(model => model.END_DATE, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            @Html.TextBoxFor(x => x.END_DATE, new { @class = "form-control", @id = "END_DATE", placeholder = "dd-MMM-yyyy", @readonly = "readonly" })
                            @Html.ValidationMessageFor(model => model.END_DATE, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.BANNER, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @*<input id="Upload_Banner" type="file" name="file[0]" class="form-control" />*@
                            @Html.TextBoxFor(model => model.BannerFile, new { @type = "file", @name = "file", @class = "form-control", @id = "Upload_Banner" })
                            @Html.ValidationMessageFor(model => model.BannerFile, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.ATTACHMENT1, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.TextBoxFor(model => model.AttachmentFile1, new { @type = "file", @name = "file", @class = "form-control", @id = "Upload_Attachment1" })
                            @Html.ValidationMessageFor(model => model.AttachmentFile1, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.ATTACHMENT2, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.TextBoxFor(model => model.AttachmentFile2, new { @type = "file", @name = "file", @class = "form-control", @id = "Upload_Attachment2" })
                            @Html.ValidationMessageFor(model => model.AttachmentFile2, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.REMARKS, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.TextAreaFor(model => model.REMARKS, new { @class = "form-control textArea", @rows = "2" })
                            @Html.ValidationMessageFor(model => model.REMARKS, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("Fn-Designation", "Fn-Designation", new { @class = "control-label col-md-3" })
                        <div class="col-sm-9 col-sm-9 col-md-6 col-lg-6">
                            @Html.DropDownListFor(model => model.FUNCTIONAL_DESIGNATION, new MultiSelectList(ViewBag.FunctionalDesignation.Items, "ADFUNCTIONALDESIGNATIONID", "DESCRIP"), new { @id = "fnDesignation", @class = "multiSelectDrop", @multiple = "multiple" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Designation", "Designation", new { @class = "control-label col-md-3" })
                        <div class="col-sm-9 col-sm-9 col-md-9 col-lg-9">
                            @Html.DropDownListFor(model => model.DESIGNATION, new MultiSelectList(ViewBag.Designation.Items, "ADDESIGNATIONID", "DESCRIP"), new { @id = "Designation", @class = "multiSelectDrop", @multiple = "multiple" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Location", "Location", new { @class = "control-label col-sm-3" })
                        <div class="col-sm-9 col-sm-9 col-md-9 col-lg-9">
                            @Html.DropDownListFor(model => model.SITE, new MultiSelectList(ViewBag.SYSITE.Items, "SYSITEID", "DESCRIP"), new { @id = "Site", @class = "multiSelectDrop", @multiple = "multiple" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Send Email", "Send Email", new { @class = "control-label col-md-3" })
                        <div class="col-sm-9 col-sm-9 col-md-9 col-lg-9">
                            @Html.CheckBoxFor(model => model.SendEmail, new { @id = "sendEmail", @style = "width:20px; height:20px;" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-4 col-md-8">
                            <input type="submit" value="Save" class="btn btn-success" />
                            <button type="button" class="btn btn-primary" id="btnPrevPopup_Part_CA">Preview</button>
                            <button type="button" class="btn btn-secondary" data-dismiss="modal" aria-label="Close">Cancel</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Annoucements preview modal start -->
    <div id="myAnnouncementsModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" style="font-size:16px!important;">
            <div class="modal-content">
                <div class="modal-header">
                    <span aria-hidden="true" title="close" class="close-announcements-modal" id="closeModel">&times;</span>
                    <img src="/images/announcements_overlay_header_bg.png" alt="Announcements banner" title="Announcements banner" class="announcements-read-more-banner" />
                    <img src="/images/honda_logo_white.png" alt="Announcements logo" title="Announcements logo" class="announcements-read-more-logo" />
                    <h2>Announcements</h2>
                </div>
                <div class="modal-body">
                    <div class="modal-left-content">
                        <h3 class="visible-xs lblSubject"><span class="heading lblCreateDate"></span></h3>
                        <span><img id="banner-img" alt="Announcement" title="Announcement image" class="left-content-img" /></span>
                        <div class="download-links hidden-xs">
                            <h6>Download :</h6>
                            <a id="Attachment1-link"></a>
                            <a id="Attachment2-link"></a>
                        </div>
                    </div>
                    <div class="modal-right-content">
                        <h3 class="hidden-xs">
                            <span id="lblSubject"></span>
                            <span class="heading lblCreateDate"></span>
                        </h3>
                        <p id="lblDescription"></p>
                        <p class="venue-text" style="display:none;"></p>

                        <div class="download-links visible-xs">
                            <h6>Download :</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Annoucements preview modal end -->

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
        $(document).ready(function () {
            $('#fnDesignation').multiselect({
                nonSelectedText: '-- Select Functional Designation --',
                includeSelectAllOption: true,
                maxHeight: 350,
                dropUp: true,
                buttonWidth: 415,
                enableFiltering: true
            });
            $('#Designation').multiselect({
                nonSelectedText: '-- Select Designation --',
                includeSelectAllOption: true,
                maxHeight: 350,
                dropUp: true,
                buttonWidth: 415,
                enableFiltering: true
            });
            $('#Site').multiselect({
                nonSelectedText: '-- Select Location --',
                includeSelectAllOption: true,
                maxHeight: 350,
                dropUp: true,
                buttonWidth: 415,
                enableFiltering: true
            });
        });
    </script>
    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_10"]">
        $(document).ready(function () {
            $('#btnPrevPopup_Part_CA').click(function () {
                openPreviewPopup();
            });
            //$('#Upload_Banner').change(function () {
            //    readBannerURL($(this)[0]);
            //});
        });
    </script>
</body>
</html>
