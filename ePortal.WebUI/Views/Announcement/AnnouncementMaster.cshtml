@model ePortal.ViewModels.AnnouncementMasterViewModel
@{
    ViewBag.Title = "AnnouncementMaster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {

    @* <link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet" /> *@
    @* <link href="~/lib/bootstrap/css/bootstrap-multiselect.css" rel="stylesheet" /> *@
       
    @* <link href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet" /> *@
    <link href="~/lib/bootstrap/css/bootstrap-multiselect.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet" />    

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .scrollit {
            overflow-y: auto;
            max-height: 100px;
        }

        select.input-sm {
            line-height: 10px !important;
        }
    </style>
   
}    
<div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Announcement Master</div>
        </div>
        @if (TempData["resVal"] != null)
        {
            <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
                @* if(@Html.Raw(Json.Encode(TempData["resVal"])) == 1){ *@
                if(@Html.Raw(Json.Serialize(TempData["resVal"])) == 1){
                    sweetAlert("", "Record saved successfully", "success");
                }
                @* else if(@Html.Raw(Json.Encode(TempData["resVal"])) == -1){ *@
                else if(@Html.Raw(Json.Serialize(TempData["resVal"])) == -1){
                    sweetAlert("", "Record not saved", "warning");
                }
                else{
                    @* sweetAlert(@Html.Raw(Json.Encode(TempData["resVal"]))); *@
                    sweetAlert(@Html.Raw(Json.Serialize(TempData["resVal"])));
                }
            </script>
        }

        <div class="body-content" style="overflow-x:auto!important;">
            @using (Html.BeginForm("AnnouncementMaster", "Announcement", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <table class="table table-bordered table-hover table-striped table-responsive" style="width:100%">
                    <thead>
                        <tr class="info">
                            <th colspan="10">
                                <b class="pull-left">Search</b>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="row">
                                    <div class="col-xs-12 col-sm-11 col-md-8 col-lg-8">
                                        <div class="col-xs-6 col-sm-3 col-md-3 col-lg-3">
                                            @Html.Label("Subject")
                                            @Html.EditorFor(model => model.SearchViewModel.Name, new { htmlAttributes = new { @id = "txtSubject", @class = "form-control" } })
                                        
                                        </div>

                                        <div class="col-xs-6 col-sm-3 col-md-3 col-lg-2">
                                            @Html.Label("From Date")

                                        @* @Html.EditorFor(model => model.SearchViewModel.FromDate, new { htmlAttributes = new { @id = "dpFromDate", @class = "form-control datepic", placeholder = "dd-MMM-yyyy" } }) *@                                        
                                        <input id="dpFromDate" class="form-control datepic" style="width: 110px;" name="SearchViewModel.FromDate" type="text" value="@Model?.SearchViewModel?.FromDate?.ToString("dd-MMM-yyyy")" readonly="readonly" placeholder="dd-MMM-yyyy" />

                                        </div>

                                        <div class="col-xs-6 col-sm-3 col-md-3 col-lg-2">
                                            @Html.Label("To Date")
                                        @* @Html.EditorFor(model => model.SearchViewModel.ToDate, new { htmlAttributes = new { @id = "dpToDate", @class = "form-control datepic", placeholder = "dd-MMM-yyyy" } }) *@
                                        <input id="dpToDate" class="form-control datepic" style="width: 110px;" name="SearchViewModel.ToDate" type="text" value="@Model?.SearchViewModel?.ToDate?.ToString("dd-MMM-yyyy")" readonly="readonly" placeholder="dd-MMM-yyyy" />
                                        </div>
                                        <div class="col-xs-6 col-sm-3 col-md-3 col-lg-2">
                                            @Html.Label("Status")
                                            @Html.DropDownListFor(x => x.SearchViewModel.Status, new List<SelectListItem>
                                 {
                                    new SelectListItem() {Text = "All", Value="-1"},
                                    new SelectListItem() {Text = "DeActive", Value="0"},
                                    new SelectListItem() {Text = "Active", Value="1"},
                                    new SelectListItem() {Text = "WIP", Value="2"},
                                    new SelectListItem() {Text = "Reject", Value="3"},
                                    new SelectListItem() {Text = "Send Back", Value="4"}
                                 }, new { @id = "ddStatus", @class = "form-control" })
                                        </div>
                                        <div class="col-xs-6 col-sm-3 col-md-3 col-lg-3" style="margin-top:20px;">
                                            <div class="form-group">
                                                <input type="submit" value="Search" class="btn btn-info" />
                                                <input id="reset" type="button" value="Reset" class="btn btn-secondary" />
                                                <div style="margin-left:500px;">
                                                    <input type="submit" formaction="AnnouncementExporttoExcel" name="btnExcel" value="Export To Excel" class="btn btn-primary" />
                                                </div>
                                            </div>
                                           
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            }

            <table id="tbAnnouncementList" class="table table-bordered table-hover table-striped table-responsive" style="width:100%">
                <thead>
                    <tr class="info">
                        <th colspan="10">
                            <b class="pull-left">Announcement List</b>
                            <b class="pull-right">
                            <button class="btn btn-primary btn-xs" id="btnOpenCreatePopup">Create New</button>
                            </b>
                        </th>
                    </tr>
                    <tr>
                        <th class="text-center">
                            @Html.DisplayName("SNo")
                        </th>
                        <th>
                                @Html.DisplayNameFor(model => model.ProcessName)
                            </th>
                        <th>
                            @Html.DisplayNameFor(model => model.SUBJECT)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.BRIEF)
                        </th>
                       
                        @*<th>
                                @Html.DisplayNameFor(model => model.DESCRIPTION)
                            </th>*@
                        @*<th>
                                @Html.DisplayNameFor(model => model.BANNER_CONTENTTYPE)
                            </th>*@
                        @*<th>
                                @Html.DisplayNameFor(model => model.BANNER_NAME)
                            </th>*@
                        @*<th>
                                @Html.DisplayNameFor(model => model.ATTACHMENT1_CONTENTTYPE)
                            </th>*@
                        @*<th>
                                @Html.DisplayNameFor(model => model.ATTACHMENT1_NAME)
                            </th>*@
                        @*<th>
                                @Html.DisplayNameFor(model => model.ATTACHMENT2_CONTENTTYPE)
                            </th>*@
                        @*<th>
                                @Html.DisplayNameFor(model => model.ATTACHMENT2_NAME)
                            </th>*@
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.START_DATE)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.END_DATE)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.CREATED_DATE)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.STATUS)
                        </th>

                        @* <th>
                                @Html.DisplayNameFor(model => model.CREATED_BY)
                            </th>
                            <th>
                                    @Html.DisplayNameFor(model => model.MODIFIED_BY)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.MODIFIED_DATE)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.FUNCTIONAL_DESIGNATION)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.DESIGNATION)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.SITE)
                                </th>*@
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNo = 0; }
                    @foreach (var item in Model.Announcements)
                    {
                        <tr>
                            <td style="width:3%;" class="text-center">
                                @(rowNo += 1)
                                @Html.HiddenFor(modelItem => item.ATTACHMENTID)
                            </td>
                            <td>
                                    @Html.DisplayFor(modelItem => item.ProcessName)
                                </td>
                            <td style="width:28%;">
                                @Html.DisplayFor(modelItem => item.SUBJECT)
                            </td>
                            <td style="width:28%;">
                                @Html.DisplayFor(modelItem => item.BRIEF)
                            </td>
                            @*<td style="width:25%;">
                                    <div class="scrollit">
                                        @Html.DisplayFor(modelItem => item.DESCRIPTION)
                                    </div>
                                </td>*@
                            @*<td>
                                    @Html.DisplayFor(modelItem => item.BANNER_CONTENTTYPE)
                                </td>*@
                            @*<td>
                                    @Html.DisplayFor(modelItem => item.BANNER_NAME)
                                </td>*@
                            @*<td>
                                    @Html.DisplayFor(modelItem => item.ATTACHMENT1_CONTENTTYPE)
                                </td>*@
                            @*<td>
                                    @Html.DisplayFor(modelItem => item.ATTACHMENT1_NAME)
                                </td>*@
                            @*<td>
                                    @Html.DisplayFor(modelItem => item.ATTACHMENT2_CONTENTTYPE)
                                </td>*@
                            @*<td>
                                    @Html.DisplayFor(modelItem => item.ATTACHMENT2_NAME)
                                </td>*@
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.START_DATE)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.END_DATE)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.CREATED_DATE)
                            </td>
                            <td class="text-center">
                                @if (item.STATUS == 0)
                                {
                                    <button class="btn btn-danger btn-xs" style="cursor: text !important">Deactive</button>
                                }
                                else if (item.STATUS == 1)
                                {
                                    <button class="btn btn-success btn-xs" style="cursor: text !important">Active</button>
                                }
                                else if (item.STATUS == 2)
                                {
                                    <button class="btn btn-secondary btn-xs" style="cursor: text !important">WIP</button>
                                }
                                else if (item.STATUS == 3)
                                {
                                    <button class="btn btn-danger btn-xs" style="cursor: text !important">Rejected</button>
                                }
                                else if (item.STATUS == 4)
                                {
                                    <button class="btn btn-warning btn-xs" style="cursor: text !important">Send Back</button>
                                }
                                else if (item.STATUS == 5)
                                {
                                    <button class="btn btn-dark btn-xs" style="cursor: text !important">Cancel By User</button>
                                }
                            </td>

                            @*<td>
                                    @Html.DisplayFor(modelItem => item.CREATED_BY)
                                </td>
                                <td>
                                        @Html.DisplayFor(modelItem => item.MODIFIED_BY)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.MODIFIED_DATE)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.FUNCTIONAL_DESIGNATION)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.DESIGNATION)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.SITE)
                                    </td>*@
                        <td class="text-center" style="width:6%;">
                            @if (item.STATUS == 1)
                            {
                                <button class="btn glyphicon btn-xs glyphicon-eye-close" title="Click to deactivate announcement" id="@item.ATTACHMENTID" data-ctrl="btn-open-conf-model" style="color:#d43f3a;"></button>
                            }
                            @if (item.STATUS == 2)
                            {
                                <button class="btn glyphicon btn-xs glyphicon glyphicon-trash" title="Click to cancel announcement" id="@item.ATTACHMENTID" data-ctrl="btn-open-cancel-model" style="color:#d43f3a;"></button>
                            }
                            @if (item.STATUS == 4)
                            {
                                <button class="btn btn-warning btn-xs glyphicon glyphicon-edit" title="Click to edit" id="@item.ATTACHMENTID" data-ctrl="btn-open-edit-popup"></button>
                            }
                            @*<button class="btn btn-warning btn-xs glyphicon glyphicon-edit" title="Click to edit" id="@item.ATTACHMENTID" onclick="openEditPopup(this);"
                                    @{ if (item.STATUS == 0 || item.STATUS == 1 || item.STATUS == 2 || item.STATUS == 3) { @: style="display: none;"
                                    } }></button>*@
                            <button class="btn btn-info btn-xs glyphicon glyphicon-tasks" title="Click to view details" id="@item.ATTACHMENTID" data-ctrl="btn-get-detail"></button>
                        </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="myModal" class="modal" tabindex="-1" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <div id="myModelHeader"></div>
                    </div>
                    @*<label id="closbtn" class="modal-close" for="modal-toggle">&#x2715;</label>*@
                    <div class="modal-body">
                        <div id="myModalContent"></div>
                    </div>
                </div>
            </div> 
        </div>

        <div id="myDetailsModel" class="modal" tabindex="-1" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="pull-left">
                            <h5 class="modal-title">Details</h5>
                        </div>
                        <div class="pull-right">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    </div>
                    <div class="modal-body">
                        <div id="myDetailModalContent" style="font-size:14px;"></div>
                    </div>
                </div>
            </div>
        </div>

        @*<div class="modal" id="confirmModal" tabindex="-1" role="dialog">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-body" id="confirmMessage">
                            <input type="hidden" id="hfAttachmentId" />
                            Are you sure want to deactivate?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" id="confirmOk" onclick="DeactiveAnnouncement();">Yes</button>
                            <button type="button" class="btn btn-secondary" data-dismiss="modal" aria-label="Close">No</button>
                        </div>
                    </div>
                </div>
            </div>*@

        @*<div class="modal" id="cancelConfirmModal" tabindex="-1" role="dialog">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-body" id="confirmMessage">
                            <input type="hidden" id="hfAttachmentId" />
                            Are you sure want to cancel this process?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" id="confirmOk" onclick="CancelAnnouncement();">Yes</button>
                            <button type="button" class="btn btn-secondary" data-dismiss="modal" aria-label="Close">No</button>
                        </div>
                    </div>
                </div>
            </div>*@
    </div>
@section Scripts {

    @* <script src="~/js/jquery.3.6.3.min.js"></script> *@
    <script src="~/lib/bootstrap/js/bootstrap.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap-multiselect.js"></script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('.homeContent').removeClass('homeContent');
            $("#tbAnnouncementList").dataTable({
                "bFilter": false,
                "bLengthChange": false
            });
            $('.datepic').datepicker({
                format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top'
            });
            // $('#dpFromDate').datepicker({
            //     format: "dd-M-yyyy",
            //     todayHighlight: true,
            //     autoclose: true,
            //     toolbarplacement: 'top'
            // });
            // $('#dpToDate').datepicker({
            //     format: "dd-M-yyyy",
            //     todayHighlight: true,
            //     autoclose: true,
            //     toolbarplacement: 'top'
            // });

            $("#reset").click(function () {
                $("#txtSubject").val("");
                $("#dpFromDate").val("");
                $("#dpToDate").val("");
                $("#ddStatus")[0].selectedIndex = 0;
            });
        });

        function openCreatePopup(current) {
            var $buttonClicked = $(this);
            $.ajax({
                type: "GET",
                url: "/Announcement/CreateAnnouncement",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if(data == "error"){
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else{
                        var headerHtml = '<div class="pull-left"><h5 class="modal-title">Create New Announcement</h5></div><div class="pull-right"><button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px"><span aria-hidden="true">&times;</span></button></div>'
                        $('#myModelHeader').html(headerHtml);
                        $('#myModalContent').html(data);
                        $('#myModal').modal({ backdrop: "static" });
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function openEditPopup(current) {
            var $buttonClicked = $(this);
            $.ajax({
                type: "GET",
                url: "/Announcement/EditAnnouncement",
                data: { id: current.id },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if(data == "error"){
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else{
                        var headerHtml = '<div class="pull-left"><h5 class="modal-title">Edit Announcement</h5></div><div class="pull-right"><button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px"><span aria-hidden="true">&times;</span></button></div>'
                        $('#myModelHeader').html(headerHtml);
                        $('#myModalContent').html(data);
                        $('#myModal').modal({ backdrop: "static" });
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function GetDetails(current) {
            var $buttonClicked = $(this);
            $.ajax({
                type: "GET",
                url: "/Announcement/AnnouncementDetails",
                data: { id: current.id },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if(data == "error"){
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else{
                        $('#myDetailModalContent').html(data);
                        $('#myDetailsModel').modal({ backdrop: "static" });
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function OpenConfirModel(current) {
            swal({
                title: "",
                text: "Are you sure want to deactivate?",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, deactivate it!",
                closeOnConfirm: false
            },function(){
                DeactiveAnnouncement(current.id);
                //swal("Deactivated!", "Your announcement has been deactivated.", "success");
            });
            //var $buttonClicked = $(this);
            //$('#hfAttachmentId').val(current.id);
            //$('#confirmModal').modal({ backdrop: "static" });
        }

        function DeactiveAnnouncement(id) {
            //$('#confirmModal').modal('hide');
            //var attachmentId = $('#hfAttachmentId').val();
            var data = {
                ATTACHMENTID: id,
            }
            $.ajax({
                type: "PUT",
                url: "/Announcement/DeactiveAnnouncement",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1)
                    {
                        window.location.href = "/Announcement/AnnouncementMaster";
                    }
                    else{
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                   
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function OpenCancelModel(current) {
            swal({
                title: "",
                text: "Are you sure want to Cancel?",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-warning",
                confirmButtonText: "Yes, cancel it!",
                closeOnConfirm: false
            },function(){
                CancelAnnouncement(current.id);
                //swal("Deactivated!", "Your announcement has been deactivated.", "success");
            });
            //var $buttonClicked = $(this);
            //$('#hfAttachmentId').val(current.id);
            //$('#cancelConfirmModal').modal({ backdrop: "static" });
        }

        function CancelAnnouncement(id) {
            //$('#cancelConfirmModal').modal('hide');
            //var attachmentId = $('#hfAttachmentId').val();
            var data = {
                ATTACHMENTID: id,
            }            
            $.ajax({
                type: "PUT",
                url: "/Announcement/CancelAnnouncement",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (response) {
                    if (response != 1) {
                    //if (!response.success) {
                        sweetAlert("Oops...", response.message, "error");
                    } else {
                        window.location.href = "/Announcement/AnnouncementMaster";
                    }
                }
            });
        }
    </script>

    @* CSP 3.0 Complaint changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        $(document).ready(function () {
            $(document).on('click', '[data-ctrl="btn-get-detail"]', function () {
                GetDetails($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="btn-open-edit-popup"]', function () {
                openEditPopup($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="btn-open-cancel-model"]', function () {
                OpenCancelModel($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="btn-open-conf-model"]', function () {
                OpenConfirModel($(this)[0]);
            });
            $('#btnOpenCreatePopup').on('click', function () {
                openCreatePopup($(this)[0]);
            });
        });
    </script>

}