    @*<script src="~/lib/bootstrap/js/bootstrap.min.js"></script>*@
    @* <link href="~/lib/bootstrap/css/bootstrap-multiselect.css" rel="stylesheet" />
    <script src="~/lib/bootstrap/js/bootstrap-multiselect.js"></script>*@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
        $(function () {
            $('#fnDesignation').multiselect({
                nonSelectedText: '-- Select Functional Designation --',
                includeSelectAllOption: true,
                maxHeight: 350,
                dropUp: true,
                buttonWidth: 415,
                enableFiltering: true
            });
            $('#Designation').multiselect({
                nonSelectedText: '-- Select Designation --',
                includeSelectAllOption: true,
                maxHeight: 350,
                dropUp: true,
                buttonWidth: 415,
                enableFiltering: true
            });
            $('#Site').multiselect({
                nonSelectedText: '-- Select Location --',
                includeSelectAllOption: true,
                maxHeight: 350,
                dropUp: true,
                buttonWidth: 415,
                enableFiltering: true
            });
            debugger;
            if ($('#FnDesignationDescrip').val() != null && $('#FnDesignationDescrip').val() != "") {
                var fnDesignationArray = $('#FnDesignationDescrip').val().split(",");
                $("#fnDesignation").val(fnDesignationArray);
                $("#fnDesignation").multiselect("refresh");
            }
            if ($('#DesignationDescrip').val() != null && $('#DesignationDescrip').val() != "") {
                var DesignationArray = $('#DesignationDescrip').val().split(",");
                $("#Designation").val(DesignationArray);
                $("#Designation").multiselect("refresh");
            }
            if ($('#SiteDescrip').val() != null && $('#SiteDescrip').val() != "") {
                var SiteArray = $('#SiteDescrip').val().split(",");
                $("#Site").val(SiteArray);
                $("#Site").multiselect("refresh");
            }
        });
    </script>
    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
        $(document).ready(function () {
            $('[data-ctrl="del-file-part-ed-an"]').on('click', function () {
                DeleteFile($(this)[0]);
            });
            $('[data-ctrl="del-file-part-ed-an-1"]').on('click', function () {
                DeleteFile($(this)[0]);
            });
            $('[data-ctrl="del-file-part-ed-an-2"]').on('click', function () {
                DeleteFile($(this)[0]);
            });
        });
    </script>
</body>
</html>
