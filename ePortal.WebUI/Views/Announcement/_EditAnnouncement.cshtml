    <div class="body-content" style="padding:0px !important;">
        <div>
            @using (Html.BeginForm("EditAnnouncement", "Announcement", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="form-group hidden">
                        <div class="col-md-3">
                            @Html.HiddenFor(model => model.ATTACHMENTID, htmlAttributes: new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.PROCESSID, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-4">
                            @Html.DropDownListFor(model => model.PROCESSID, new SelectList(ViewBag.ContentProcess.Items, "PROCESSID", "PROCESS_NAME"), new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.PROCESSID, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.SUBJECT, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.SUBJECT, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.SUBJECT, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.BRIEF, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.BRIEF, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.BRIEF, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.DESCRIPTION, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.TextAreaFor(model => model.DESCRIPTION, new { @class = "form-control textArea", @rows = "4" })
                            @*@Html.EditorFor(model => model.DESCRIPTION, new { htmlAttributes = new { @class = "form-control" }, new { @row="4" } })*@
                            @Html.ValidationMessageFor(model => model.DESCRIPTION, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.START_DATE, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-3">
                            @Html.TextBoxFor(x => x.START_DATE, new { @class = "form-control", @id = "startDate", placeholder = "dd-MMM-yyyy", @readonly = "readonly" })
                            @Html.ValidationMessageFor(model => model.START_DATE, "", new { @class = "text-danger" })
                        </div>
                        @Html.LabelFor(model => model.END_DATE, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-3">
                            @Html.TextBoxFor(x => x.END_DATE, new { @class = "form-control", @id = "endDate", placeholder = "dd-MMM-yyyy", @readonly = "readonly" })
                            @Html.ValidationMessageFor(model => model.END_DATE, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group" id="main-banner-div">
                        @Html.LabelFor(model => model.BANNER, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            <input id="Upload_Banner" type="file" name="file[0]" class="form-control" />
                            @*@Html.TextBoxFor(model => model.BANNER, new { @type = "file", @name = "file", @class = "form-control", @id = "Upload_Banner" })*@
                            @Html.ValidationMessageFor(model => model.BANNER, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 Banner-text" style="padding:0px; padding: 0px;margin-top:6px; overflow: hidden;" title="@Model.BANNER_NAME">
                            @Html.DisplayFor(model => model.BANNER_NAME, new { @class = "control-label col-md-3" })
                        </div>
                        <div class="col-md-1 pull-right Banner-text">
                            @{
                                if (!String.IsNullOrEmpty(Model.BANNER_NAME))
                                {
                                    <a class="glyphicon glyphicon-trash" id="@Model.ATTACHMENTID" data-type="Banner" data-ctrl="del-file-part-ed-an-2"></a>
                                    <a href="@Url.Action("Download", "Announcement", new { id = Model.ATTACHMENTID, type = "Banner" })" class="glyphicon glyphicon-download"></a>
                                }
                            }
                        </div>
                    </div>

                    <div class="form-group" id="main-attachment1-div">
                        @Html.LabelFor(model => model.ATTACHMENT1, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            <input id="Upload_Attachment1" type="file" name="file[1]" class="form-control" />
                            @*@Html.TextBoxFor(model => model.ATTACHMENT1, new { @type = "file", @name = "file", @class = "form-control", @id = "Upload_Attachment1" })*@
                            @Html.ValidationMessageFor(model => model.ATTACHMENT1, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 Attachment1-text" style="padding:0px; padding: 0px;margin-top:6px; overflow: hidden;" title="@Model.ATTACHMENT1_NAME">
                            @Html.DisplayFor(model => model.ATTACHMENT1_NAME, new { @class = "control-label col-md-3" })
                        </div>
                        <div class="col-md-1 pull-right Attachment1-text">
                            @{
                                if (!String.IsNullOrEmpty(Model.ATTACHMENT1_NAME))
                                {
                                    <a class="glyphicon glyphicon-trash" id="@Model.ATTACHMENTID" data-type="Attachment1" data-ctrl="del-file-part-ed-an-1"></a>
                                    <a href="@Url.Action("Download", "Announcement", new { id = Model.ATTACHMENTID, type = "Attachment1" })" class="glyphicon glyphicon-download"></a>
                                }
                            }
                        </div>
                    </div>
                    <div class="form-group" id="main-attachment2-div">
                        @Html.LabelFor(model => model.ATTACHMENT2, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            <input id="Upload_Attachment2" type="file" name="file[2]" class="form-control" />
                            @*@Html.TextBoxFor(model => model.ATTACHMENT2, new { @type = "file", @name = "file", @class = "form-control", @id = "Upload_Attachment2" })*@
                            @Html.ValidationMessageFor(model => model.ATTACHMENT2, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 Attachment2-text" style="padding:0px; padding: 0px;margin-top:6px; overflow: hidden;" title="@Model.ATTACHMENT2_NAME">
                            @Html.DisplayFor(model => model.ATTACHMENT2_NAME, new { @class = "control-label col-md-3" })
                        </div>
                        <div class="col-md-1 pull-right Attachment2-text">
                            @{
                                if (!String.IsNullOrEmpty(Model.ATTACHMENT2_NAME))
                                {
                                    <a class="glyphicon glyphicon-trash" id="@Model.ATTACHMENTID" data-type="Attachment2" data-ctrl="del-file-part-ed-an"></a>
                                    <a href="@Url.Action("Download", "Announcement", new { id = Model.ATTACHMENTID, type = "Attachment2" })" class="glyphicon glyphicon-download"></a>
                                }
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.REMARKS, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.TextAreaFor(model => model.REMARKS, new { @class = "form-control textArea", @rows = "2" })
                            @Html.ValidationMessageFor(model => model.REMARKS, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("Fn-Designation", "Fn-Designation", new { @class = "control-label col-md-3" })
                        <div class="col-sm-9 col-sm-9 col-md-6 col-lg-6">
                            <input type="hidden" value="@Model.FnDesignationDescrip" id="FnDesignationDescrip" />
                            @Html.DropDownListFor(model => model.FUNCTIONAL_DESIGNATION,
                                     new MultiSelectList(ViewBag.FunctionalDesignation.Items, "ADFUNCTIONALDESIGNATIONID", "DESCRIP"),
                                     new { @class = "multiSelectDrop", @id = "fnDesignation", @multiple = "multiple" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Designation", "Designation", new { @class = "control-label col-md-3" })
                        <div class="col-sm-9 col-sm-9 col-md-6 col-lg-6">
                            <input type="hidden" value="@Model.DesignationDescrip" id="DesignationDescrip" />
                            @Html.DropDownListFor(model => model.DESIGNATION,
                                     new MultiSelectList(ViewBag.Designation.Items, "ADDESIGNATIONID", "DESCRIP"),
                                     new { @class = "multiSelectDrop", @id = "Designation", @multiple = "multiple" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Location", "Location", new { @class = "control-label col-md-3" })
                        <div class="col-sm-9 col-sm-9 col-md-6 col-lg-6">
                            <input type="hidden" value="@Model.SiteDescrip" id="SiteDescrip" />
                            @Html.DropDownListFor(model => model.SITE,
                                     new MultiSelectList(ViewBag.SYSITE.Items, "SYSITEID", "DESCRIP"),
                                     new { @class = "multiSelectDrop", @id = "Site", @multiple = "multiple" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Send Email", "Send Email", new { @class = "control-label col-md-3" })
                        <div class="col-md-6">
                            @Html.CheckBoxFor(model => model.SendEmail, new { @id = "chkSendMail", @style = "width:20px; height:20px;" })
                            @Html.ValidationMessageFor(model => model.SendEmail, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-5 col-md-7">
                            <input type="submit" value="Update" class="btn btn-success" />
                            <button type="button" class="btn btn-secondary" data-dismiss="modal" aria-label="Close">Cancel</button>
                        </div>
                    </div>
                </div>
