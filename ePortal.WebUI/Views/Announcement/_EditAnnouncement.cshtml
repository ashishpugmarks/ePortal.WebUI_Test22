@model ePortal.ViewModels.AnnouncementMasterViewModel

@{
    Layout = null;
}
<!doctype html>
<html>
<head>
    <style type="text/css" nonce="@Context.Items["StyleNonce_8"]">
        .form-group {
            margin-bottom: 8px !important;
        }

        .textArea {
            max-width: 418px;
