    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">

        function CheckStatus(current) {
            var EMP_CODE = "";
            if (current.id == "APPAUTH1_ECODE") {
                EMP_CODE = $('#APPAUTH1_ECODE').val();
            }
            else if (current.id == "APPAUTH2_ECODE") {
                EMP_CODE = $('#APPAUTH2_ECODE').val();
            }
            if (EMP_CODE != "") {
                $.ajax({
                    type: "GET",
                    url: "/Announcement/GetIsEmployeeActive",
                    data: { id: parseInt(EMP_CODE) },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (msg) {
                        if (current.id == "APPAUTH1_ECODE") {
                            $("#APPAUTH1_MSG").html('');
                            $("#lblMessage1").text("");
                            if (msg != "" && msg != "Deactive") {
                                $("#APPAUTH1_MSG").append('<span>' + msg + '</span>');
                            }
                            else if (msg == "Deactive") {
                                $("#APPAUTH1_MSG").append('<span> Employee ' + EMP_CODE + ' is deactive </span>');
                                $('#APPAUTH1_ECODE').val('');
                            }
                            else {
                                $("#APPAUTH1_MSG").append('<span> Employee ' + EMP_CODE + ' does not exist </span>');
                                $('#APPAUTH1_ECODE').val('');
                            }
                        }
                        else if (current.id == "APPAUTH2_ECODE") {
                            $("#APPAUTH2_MSG").html('');
                            $("#lblMessage2").text("");
                            if (msg != "" && msg != "Deactive") {
                                $("#APPAUTH2_MSG").append('<span>' + msg + '</span>');
                            }
                            else if (msg == "Deactive") {
                                $("#APPAUTH2_MSG").append('<span> Employee ' + EMP_CODE + ' is deactive </span>');
                                $('#APPAUTH2_ECODE').val('');
                            }
                            else {
                                $("#APPAUTH2_MSG").append('<span> Employee ' + EMP_CODE + ' does not exist </span>');
                                $('#APPAUTH2_ECODE').val('');
                            }
                        }
                    },
                    error: function () {
                        alert("Content load failed.");
                    }
                });
            }
        }

        function UpdateStatus(current) {
            var actionName, actionMessage, actionType = "";
            var actionName = current.innerText;
            switch (actionName) {
                case "Approve":
                    actionType = "success";
                    actionMessage = "Approval authorities are set successfully";
                    break;
                case "Reject":
                    actionType = "success";
                    actionMessage = "Request is rejected successfully"
                    break;
                case "Send Back":
                    actionType = "success";
                    actionMessage = "Request is Send Back successfully"
            }
            $("#lblMessage1").text("");
            $("#lblMessage2").text("");
            $("#lblMessage1").addClass("hidden");
            $("#lblMessage2").addClass("hidden");
            if ($(current).text() == "Approve") {
                if ($('#APPAUTH1_ECODE').val() == "") {
                    $("#lblMessage1").text("Please Select Approval Authority 1");
                    $("#lblMessage1").removeClass("hidden");
                    if ($('#APPAUTH2_ECODE').val() == "") {
                        $("#lblMessage2").text("Please Select Approval Authority 2");
                        $("#lblMessage2").removeClass("hidden");
                        $("#APPAUTH2_MSG").html('');
                    }
                    $("#APPAUTH1_MSG").html('');
                    return;
                }
                else if ($('#APPAUTH2_ECODE').val() == "") {
                    $("#lblMessage2").text("Please Select Approval Authority 2");
                    $("#lblMessage2").removeClass("hidden");
                    $("#APPAUTH2_MSG").html('');
                    return;
                }
            }
            var status = $(current).text() == "Approve" ? 2 : $(current).text() == "Reject" ? 9 : 6; // status 2 : Approved by Hr, 9: Reject, 6: Send Back Hr
            var data = {
                ATTACHMENTAPPID: $(current).attr("data-id"),
                APPAUTH1_ECODE: $('#APPAUTH1_ECODE').val() || null,
                APPAUTH2_ECODE: $('#APPAUTH2_ECODE').val() || null,
                HRAPP_REMARKS: $('#HRAPP_REMARKS').val(),
                STATUS: status
            }
            var $buttonClicked = $(this);
            $.ajax({
                type: "POST",
                url: "/Announcement/EditAnnouncementApprovalAuthority",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    $('#myEditModal').modal('hide');
                    swal({
                        title: "",
                        text: actionMessage,
                        type: actionType,
                    }, function (isConfirm) {
                        if (isConfirm) {
                            window.location.href = "/Announcement/AnnouncementApprovalAuthority";
                        }
                    });
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
    </script>
    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
        $(document).ready(function () {
            $('[data-ctrl="btn-approve-part-eaa"]').click(function () {
                UpdateStatus($(this)[0]);
            });
            $('[data-ctrl="btn-reject-part-eaa"]').click(function () {
                UpdateStatus($(this)[0]);
            });
            $('[data-ctrl="btn-send-back-part-eaa"]').click(function () {
                UpdateStatus($(this)[0]);
            });
            $(document).on('change', "#APPAUTH1_ECODE", function () {
                CheckStatus($(this)[0]);
            });
            $(document).on('change', "#APPAUTH2_ECODE", function () {
                CheckStatus($(this)[0]);
            });
        });
    </script>
