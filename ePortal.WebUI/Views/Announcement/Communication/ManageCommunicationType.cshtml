@model IEnumerable<ePortal.ViewModels.CommMailTypeViewModel>
@{
    ViewBag.Title = "ManageOperation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
    </style>
   }
    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Manage Communication Type</div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Record List</strong>
                            <strong class="pull-right">
                                <button class="btn btn-success btn-xs" id="btnCreateOperation">Add </button>
                            </strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <table class="table table-bordered table-hover table-responsive" id="tbManageOperationMapping">
                            <thead>
                                <tr>
                                    <th class="text-center hidden-xs">
                                        @Html.DisplayName("SNo")
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.COMM_TYPE)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.COMM_EMAILID)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.STATUS)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.ADDEDBY_NAME)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.CREATED_DATE)
                                    </th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNo = 0;
                                }
                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="text-center" style="width:3%;">
                                                @(rowNo += 1)
                                                @Html.HiddenFor(modelItem => item.COMMTYPEID)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.COMM_TYPE)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.COMM_EMAILID)
                                            </td>
                                            <td class="text-center">
                                                @if (item.STATUS == true)
                                                {
                                                    <button class="btn btn-success btn-xs" style="cursor: text !important">Active</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-danger btn-xs" style="cursor: text !important">Deactive</button>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.ADDEDBY_NAME)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.CREATED_DATE)
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-warning btn-xs glyphicon glyphicon-edit" title="Click to edit" data-ctrl="btn-edit-operation" data-commtypeid="@item.COMMTYPEID"></button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="myCreateModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="padding:10px!important;">
                    <div class="pull-left">
                        <h5 class="modal-title"><span id="sp_type"></span></h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body" style="padding:10px!important;">
                    <div id="myCreateModelContent"></div>
                </div>
            </div>
        </div>
    </div>

    <div id="ajaxLoader"></div>
    @section Scripts {
        <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
            $('.homeContent').removeClass('homeContent');
            $(document).ready(function () {
                $("#tbManageOperationMapping").dataTable({
                    "bFilter": true,
                    "bLengthChange": true
                });
            });

            function CreateOperation() {
                $.ajax({
                    type: "GET",
                    //beforeSend: function () {
                    //    $("#ajaxLoader").addClass('loader');
                    //},
                    url: "/Announcement/CreateCommunicationType",
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data == "error") {
                            sweetAlert("", "An error occurred while processing your request.", "error");
                        }
                        else {
                            $('#sp_type').html("Add ");
                            $('#myCreateModelContent').html(data);
                            $('#myCreateModel').modal({ backdrop: "static" });
                        }
                    },
                    //complete: function () {
                    //    $("#ajaxLoader").removeClass('loader');
                    //},
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }

            function EditOperation(row_id) {
                $.ajax({
                    type: "GET",
                    //beforeSend: function () {
                    //    $("#ajaxLoader").addClass('loader');
                    //},
                    url: "/Announcement/EditCommunicationType",
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    data: { id: row_id },
                    success: function (data) {
                        if (data == "error") {
                            sweetAlert("", "An error occurred while processing your request.", "error");
                        }
                        else {
                            $('#sp_type').html("Edit ");
                            $('#myCreateModelContent').html(data);
                            $('#myCreateModel').modal({ backdrop: "static" });
                        }
                    },
                    //complete: function () {
                    //    $("#ajaxLoader").removeClass('loader');
                    //},
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }

        </script>

        @* CSP 3.0 Compliant changes *@
        <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
            $(document).ready(function () {
                $(document).on('click', '[data-ctrl="btn-edit-operation"]', function () {
                    var commtypeid = $(this).data('commtypeid');
                    EditOperation(commtypeid);
                });
                $('#btnCreateOperation').on('click', function () {
                    CreateOperation();
                });
            });
        </script>
    }
