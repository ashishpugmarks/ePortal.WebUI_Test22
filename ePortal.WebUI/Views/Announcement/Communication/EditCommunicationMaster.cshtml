        /*End tab css*/

        .div_disable {
        pointer-events: none;
        opacity: 1.9;
        background: #eee;
        color: black;
        }

        .btn_disable {
        pointer-events: none;
        opacity: 0.9;
        background: #ccc;
        border-color: rgba(0, 0, 0, 0.4);
        color: black;
        }

        .editor {
        height: 200px;
        border: 1px solid #ccc;
        padding: 10px;
        }

        .textArea {
        max-width: 100%;
        min-width: 100%;
        }

        .loader {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
        opacity: .7;
        }

        .validationError {
        border: 1px solid #a94442 !important;
        }

        .required::after {
        content: "*";
        font-weight: 800;
        color: red;
        margin-left: 5px;
        }

        .form-control {
        height: 26px;
        padding: 3px 6px;
        font-size: 13px;
        }

        .label-additional {
        font-size: smaller;
        padding-bottom: 1px;
        }

        .label-heading {
        padding-bottom: 3px;
        font-style: italic;
        }

        .ui-widget {
