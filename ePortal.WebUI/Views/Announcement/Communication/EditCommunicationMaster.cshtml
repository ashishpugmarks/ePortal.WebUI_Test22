                                                        @Html.DropDownListFor(model => model.DESIGNATION, new MultiSelectList(ViewBag.Designation.Items, "ADDESIGNATIONID", "DESCRIP"), new { @id = "Designation", @class = "multiSelectDrop", @multiple = "multiple" })
                                                    </div>
                                                </div>
