           function UploadAttachment() {
               var IsAttachmentsValidation = CheckAttachmentsValidation();
               if (!IsAttachmentsValidation) {
                   return;
               }
               $("#btnUpload").attr("disabled", true);
               var formData = new FormData();
               formData.append("FILE", document.getElementById("txtFile").files[0]);
               formData.append("DOC_TYPE", $("#ddDocType").val());
               formData.append("ADDITIONAL_INFO", $("#txtAddInfo").val());
               formData.append("COMMUNICATIONID", $("#hfCommReqId").val());
               formData.append("FILENAME", $("#txtFilename").val().trim());
               $.ajax({
                   type: "POST",
                   url: "/Announcement/UploadAttachment",
                   data: formData,
                   datatype: "json",
                   contentType: false,
                   processData: false,
                   success: function (data) {
                       if (data.res == 1) {
                           attachmentArray = data.attachmentList;
                           if (attachmentArray != null) {
                               if (attachmentArray.length > 0) {
                                   BindDocument(attachmentArray);
                               }
                               $("#span-attachmentMsg").text('Attachment uploaded successfully. ').css('color', 'green').show().delay(5000).fadeOut();
                               IsUploadAttachment = true;
                               $("#txtFile").val('');
                               $("#ddDocType").val('');
                               $("#txtAddInfo").val('');
                               $("#txtFilename").val('');

                           }
                       }
                       else if (data.res == 0 || data.res == -1) {
                           $("#span-attachmentMsg").text('Attachment not uploaded, Please try again. ').css('color', '#a94442').show().delay(5000).fadeOut();
                       }
                       $("#btnUpload").attr("disabled", false);
                   },
                   error: function () {
                       $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                       $("#btnUpload").attr("disabled", false);
                   }
               });
           }

           function BindDocument(attList) {
               var rows = "", rowId = 0;
               if (attList != null) {
                   if (attList.length > 0) {
                       $.each(attList, function (i, item) {
                           rowId = i + 1;
                           var additionalInfo = item.ADDITIONAL_INFO == null ? "" : item.ADDITIONAL_INFO;
                           rows += "<tr class='tr_doc'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.DOC_TYPE + "</td>"
                           rows += "<td class='text-left'><a style='cursor: pointer;' data-id='" + item.FILENAME + "' data-ctrl='anc-get-pdf'>" + item.FILENAME + "</a></td>"
                           rows += "<td class='text-center' style='color:#a94442'>Not Verified</td>"
                           rows += "<td class='text-left'>" + additionalInfo + "</td>"
                           rows += "<td class='text-center'><a data-name='" + item.FILENAME + "' data-type='" + item.DOC_TYPE + "' data-id='" + item.COMMUNICATIONID + "' style='cursor: pointer;' data-ctrl='anc-del-doc'>Delete</a></td>"
                           rows += "</tr>"
                       });
                       document.getElementById("append_docRow").innerHTML = rows;

                       //CSP 3.0 Compliant changes
                       //Clear click events
                       $(document).off("click", "[data-ctrl='anc-del-doc']");
                       $(document).off("click", "[data-ctrl='anc-get-pdf']");

                       $(document).on("click", "[data-ctrl='anc-del-doc']", function () {
                           DeleteDoc($(this)[0]);
                       });
                       $(document).on("click", "[data-ctrl='anc-get-pdf']", function () {
                           GetPDF($(this)[0], 1);
                       });
                   }
                   else {
                       var _row = "<tr><th colspan='6' class='text-center'>No record found.</th></tr>"
                       document.getElementById("append_docRow").innerHTML = _row;
                   }
               }
           }

           function GetPDF(current, verfiedMark) {
               var _pdfName = $(current).attr('data-id');
               var _extension = _pdfName.substr((_pdfName.lastIndexOf('.') + 1));
               if(verfiedMark == 1){
                   $(current).parent().next()[0].textContent = "Verified";
                   $(current).parent().next().css("color", "green");
               }
               if (_pdfName != "" && _extension.toLowerCase() == "pdf") {
                   $.ajax({
                       type: "GET",
                       url: "/Announcement/GetPDF",
                       beforeSend: function () {
                           $("#ajaxLoader").addClass('loader');
                       },
                       data: { fileName: _pdfName },
                       contentType: "application/json; charset=utf-8",
                       datatype: "json",
                       success: function (data) {
                           if (data.FILEPATH != "") {
                               document.getElementById("myCreateModelContent").innerHTML = data.FILEPATH;
                               $('#myCreateModel').modal({ backdrop: "static" });
                           }
                           else {
                               sweetAlert("", "File not found.", "warning");
                           }
                       },
                       complete: function () {
                           $("#ajaxLoader").removeClass('loader');
                       },
                       error: function () {
                           sweetAlert("Oops...", "Something went wrong!", "error");
                       }
                   });
               }
               else if (_pdfName != "" && _extension.toLowerCase() != "pdf") {
                   window.open("../../../Uploads/Communication/" + _pdfName, "_blank");

               }
           }

