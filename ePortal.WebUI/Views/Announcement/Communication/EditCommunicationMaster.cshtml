           /*Added by Aumento for SR90805*/
           $(document).ready(function () {
               function validateDateRange() {
                   var startDate = $("#START_DATE").val();
                   var endDate = $("#END_DATE").val();

                   if (!startDate || !endDate) {
                       return; // Exit if either date is empty
                   }

                   var start = new Date(startDate);
                   var end = new Date(endDate);

                   // Scenario 3: End date cannot be earlier than start date
                   if (end < start) {
                       swal({
                           title: "Invalid Date Range",
                           text: "End date cannot be earlier than the start date. Please select a valid date.",
                           type: "warning",
                       });
                       $("#END_DATE").val(''); // Clear invalid input
                       return;
                   }

                   var diffTime = Math.abs(end - start);
                   var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                   // Scenario 4: Date difference exceeds 10 days
                   if (diffDays >= 10) {
                       swal({
                           title: "Date Range Exceeded",
                           text: "The difference between the 'From date' and the 'To date' exceeds 10 days. Please select a date range within 10 days.",
                           type: "warning",
                       });
                       $("#END_DATE").val(''); // Clear the invalid selection
                       return;
                   }
               }

               // Attach the function to both date inputs
               $("#START_DATE, #END_DATE").change(validateDateRange);
           });
    </script>

