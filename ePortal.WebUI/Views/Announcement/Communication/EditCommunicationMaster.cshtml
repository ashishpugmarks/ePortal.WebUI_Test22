@using Newtonsoft.Json
@model ePortal.ViewModels.CommunicationViewModel
@{
    ViewBag.Title = "EditCommunicationMaster";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.RequestType = new List<SelectListItem>{ new SelectListItem{
                Text="Normal",
                Value = "1"
            },
            new SelectListItem{
                Text="Emergency",
                Value = "2"
            }};
}

