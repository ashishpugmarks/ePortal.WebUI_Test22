           function Next(crnt, action) {
               var checkedInput = $('input[name="radio-set"]:Checked')[0].id;
               const myArray = checkedInput.split("-");
               var newval = parseInt(myArray[1]) + crnt;
               var element = document.getElementById("tab-" + newval);

               if (action == "FORM") {
                   if (element != undefined || element != null) {
                       BindDocument(attachmentArray);
                       element.click();
                   }
               }
               if (action == "UPLOAD_DOC") {
                   if (element != undefined || element != null) {
                       var docTr = $("#append_docRow .tr_doc");
                       if (docTr.length > 0) {
                           var IsTemplateDocExist = false, IsBannerExist = false, IsOtherDocExist = false, IsDocVerified = true;
                           for (var i = 0; i < docTr.length; i += 1) {
                               var row = docTr[i];
                               if (row != undefined) {
                                   var docTypeText = row.cells[1].innerHTML.trim();
                                   if (docTypeText == "Template") {
                                       IsTemplateDocExist = true;
                                   }
                                   if (docTypeText == "Banner") {
                                       IsBannerExist = true;
                                   }
                                   if (docTypeText == "Other") {
                                       IsOtherDocExist = true;
                                   }
                                   var varificationText = row.cells[3].innerHTML.trim();
                                   if (varificationText == "Not Verified") {
                                       IsDocVerified = false;
                                   }
                               }
                           }
                           if (!IsTemplateDocExist && ISREQ_TEMPLATE == 1) {
                               sweetAlert("", "Template document is mandatory. Please add Template document", "warning");
                               $("#ddDocType").addClass('validationError');
                               $("#txtFile").addClass('validationError');
                               return;
                           }
                           if (!IsBannerExist && ISREQ_BANNER == 1) {
                               sweetAlert("", "Banner is mandatory. Please add Banner", "warning");
                               $("#ddDocType").addClass('validationError');
                               $("#txtFile").addClass('validationError');
                               return;
                           }
                           if (!IsOtherDocExist && ISREQ_OTHER == 1) {
                               sweetAlert("", "Other document is mandatory. Please add other document", "warning");
                               $("#ddDocType").addClass('validationError');
                               $("#txtFile").addClass('validationError');
                               return;
                           }
                           if (!IsDocVerified) {
                               sweetAlert("", "Document not verified. Please open all document & verified", "warning");
                               return;
                           }
                           BindData(arrayList);
                           BindAdditionalAuth();
                           element.click();
                       }
                       else {
                           if (ISREQ_TEMPLATE == 1) {
                               sweetAlert("", "Template document is mandatory. Please add Template document", "warning");
                               $("#ddDocType").addClass('validationError');
                               $("#txtFile").addClass('validationError');
                               return;
                           }
                           if (ISREQ_BANNER == 1) {
                               sweetAlert("", "Banner is mandatory. Please add Banner", "warning");
                               $("#ddDocType").addClass('validationError');
                               $("#txtFile").addClass('validationError');
                               return;
                           }
                           if (ISREQ_OTHER == 1) {
                               sweetAlert("", "Other document is mandatory. Please add other document", "warning");
                               $("#ddDocType").addClass('validationError');
                               $("#txtFile").addClass('validationError');
                               return;
                           }

                           //sweetAlert("", "Please upload mandatory documents.", "warning");
                           //$("#ddDocType").addClass('validationError');
                           //$("#txtFile").addClass('validationError');
                           //return;

                           BindData(arrayList);
                           BindAdditionalAuth();
                           element.click();
                       }
                   }
               }
               if (action == "AUTHORITY") {
                   var isRender = 0;
                   if (element != undefined || element != null) {
                       if (arrayList == null || arrayList.length == 0) {
                           $('#txtEmpcode').addClass('validationError');
                           sweetAlert("", "Please add approval authority.", "warning");
                           return;
                       }
                       else {
                           var data = {
                               COMMUNICATIONID: $("#hfCommReqId").val(),
                               STATUS: 1,
                               PROCESS_STATUS: 0,
                               IsFinalSubmit: 0,
                               commAuthSeq: arrayList,
                               additionalCommAuthSeq: arrayAdditionalAuthList
                           }
                           $.ajax({
                               type: "PUT",
                               url: "/Announcement/CommunicationMasterFinalSave",
                               beforeSend: function () {
                                   $("#ajaxLoader").addClass('loader');
                               },
                               data: JSON.stringify(data),
                               contentType: "application/json; charset=utf-8",
                               datatype: "json",
                               success: function (data) {
                                   if (data == 1) {
                                       isRender = 1;
                                       RenderPreview();
                                   }
                                   else {
                                       sweetAlert("", "Approval authority not saved.", "warning");
                                   }
                               },
                               complete: function () {
                                   if (isRender == 1) {
                                       element.click();
                                   }
                                   $("#ajaxLoader").removeClass('loader');
                               },
                               error: function () {
                                   sweetAlert("Oops...", "Something went wrong!", "error");
                               }
                           });
                       }
                   }
               }
           }

