        /*Start tab css*/
        .tabs {
        position: relative;
        /*margin: 40px auto;
        width: 750px;*/
        width: 100%;
        }

        .tabs input.radio-input {
        position: absolute;
        z-index: 1000;
        width: 150px;
        height: 40px;
        left: 0px;
        top: 0px;
        opacity: 0;
        -ms-filter: "progid:DXImageTransform.Microsoft.Alpha(Opacity=0)";
