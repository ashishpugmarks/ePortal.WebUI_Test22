        }

        .tabs input#tab-2 {
        left: 150px;
        }

        .tabs input#tab-3 {
        left: 300px;
        }

        .tabs input#tab-4 {
        left: 450px;
        }

        .tabs label.label-tab {
        background: #bfc2ef;
        background: -moz-linear-gradient(top, #bfc2ef 0%, #4e8c8a 100%);
        background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#bfc2ef), color-stop(100%,#4e8c8a));
        background: -webkit-linear-gradient(top, #bfc2ef 0%,#4e8c8a 100%);
        background: -o-linear-gradient(top, #bfc2ef 0%,#4e8c8a 100%);
        /*background: -ms-linear-gradient(top, #bfc2ef 0%,#4e8c8a 100%);*/
        background: -webkit-linear-gradient(top, #bfc2ef 0%,#f5f7f7 100%);
        background: linear-gradient(top, #bfc2ef 0%,#4e8c8a 100%);
        font-size: 15px;
        line-height: 40px;
        height: 40px;
        position: relative;
        padding: 0 8px;
        float: left;
        display: block;
        width: 150px;
        color: #385c5b;
        top: 0px;
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: bold;
        text-align: center;
        text-shadow: 1px 1px 1px rgba(255,255,255,0.3);
        border-radius: 3px 3px 0 0;
        box-shadow: 2px 0 2px rgba(0,0,0,0.1), -2px 0 2px rgba(0,0,0,0.1);
        }

        .tabs label.label-tab:after {
        content: '';
        background: #fff;
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 100%;
        height: 8px;
        display: block;
        }

        .tabs input:hover + label.label-tab {
        background: #bfc2ef;
        top: -8px;
        -webkit-transition: top linear 0.2s;
        -moz-transition: top linear 0.2s;
        -o-transition: top linear 0.2s;
        -ms-transition: top linear 0.2s;
        transition: top linear 0.2s;
        }

        .tabs input:hover + label.label-tab:after {
        background: #bfc2ef;
        }

        .tabs input:hover + label.label-tab ~ .clear-shadow {
        top: -8px;
        -webkit-transition: top linear 0.2s;
        -moz-transition: top linear 0.2s;
        -o-transition: top linear 0.2s;
        -ms-transition: top linear 0.2s;
        transition: top linear 0.2s;
        }

        .tabs input:checked:hover + label.label-tab {
        top: 0;
        }

        .tabs input:checked:hover + label.label-tab:after {
        background: #fff;
        }

        .tabs input:checked:hover + label.label-tab ~ .clear-shadow {
        top: 0;
        background: #fff;
        -webkit-transition: none;
        -moz-transition: none;
        -o-transition: none;
        -ms-transition: none;
        transition: none;
        }

        .tabs input.tab-selector-1:hover + label.tab-label-1 ~ .clear-shadow {
        z-index: 3;
        }

        .tabs input.tab-selector-2:hover + label.tab-label-2 ~ .clear-shadow {
        z-index: 2;
        }

        .tabs input.tab-selector-3:hover + label.tab-label-3 ~ .clear-shadow {
        z-index: 1;
        }

        .tabs input.tab-selector-4:hover + label.tab-label-4 ~ .clear-shadow {
        z-index: 0;
        }

        .tabs label.label-tab:first-of-type {
        z-index: 4;
        box-shadow: 0px 0 4px rgba(0,0,0,0.1);
        }

        .tab-label-2 {
        z-index: 3;
        }

        .tab-label-3 {
        z-index: 2;
        }

        .tab-label-4 {
        z-index: 1;
        }

        .tabs input:checked + label.label-tab {
        background: #fff;
        z-index: 6;
        -webkit-transition: top linear 0.2s;
        -moz-transition: top linear 0.2s;
        -o-transition: top linear 0.2s;
        -ms-transition: top linear 0.2s;
        transition: top linear 0.2s;
        }

        .clear-shadow {
        background: #bfc2ef;
        position: relative;
        top: 0;
        height: 10px;
        margin-bottom: -10px;
        clear: both;
        z-index: -2;
        box-shadow: 0 -2px 3px -2px rgba(0,0,0,0.2);
        border-radius: 3px;
        }

        .content {
        background: #fff;
        position: relative;
        width: 100%;
        min-height: 350px;
        z-index: 5;
        overflow: hidden;
        box-shadow: 0 -2px 3px -2px rgba(0,0,0,0.2), 0 4px 4px rgba(0,0,0,0.1);
        border-radius: 0 3px 3px 3px;
        margin-bottom: 15px;
        padding: 15px;
        }

        /*.content div {
        position: absolute;
        top: 0;
        left: 0;
        bottom: 100%;
        padding: 10px 40px;
        overflow: hidden;
        z-index: 1;
        opacity: 0;
        -webkit-transition: all linear 0.1s;
        -moz-transition: all linear 0.1s;
        -o-transition: all linear 0.1s;
        -ms-transition: all linear 0.1s;
        transition: all linear 0.1s;
        }*/

