<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">
            Communication Process
        </div>
    </div>
    @if (Model.commAuthSeq != null)
    {
        var SeqList = (List<ePortal.ViewModels.CommunicationAppSeqViewModel>)Model.commAuthSeq;
        <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
            @*arrayList = @Html.Raw(Json.Encode(SeqList.Where(w => w.ISADDITIONAL_AUTH == 0).OrderBy(o => o.APP_SEQ).ToList()));*@
            @*arrayAdditionalAuthList = @Html.Raw(Json.Encode(SeqList.Where(w => w.ISADDITIONAL_AUTH == 1).OrderBy(o => o.APP_SEQ).ToList()));*@
            arrayAdditionalAuthList = @Html.Raw(Json.Serialize(SeqList.Where(w => w.ISADDITIONAL_AUTH == 1).OrderBy(o => o.APP_SEQ).ToList()));
        </script>
    }
    @if (Model.commDetail != null)
    {     
        var commDetail = (List<ePortal.ViewModels.CommunicationDtlViewModel>)Model.commDetail;
        <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
            @* attachmentArray = @Html.Raw(Json.Encode(commDetail.OrderBy(o => o.COMM_DTLID).ToList()));*@
            attachmentArray = @Html.Raw(Json.Serialize(commDetail.OrderBy(o => o.COMM_DTLID).ToList()));
         </script>
        }
        <div class="body-content" style="overflow-x:auto!important;">

            <section class="tabs">
                <div class="div_disable">
                    <input id="tab-1" type="radio" name="radio-set" class="tab-selector-1 radio-input" data-id="content-1" checked="checked" />
                    <label for="tab-1" class="tab-label-1 col-xs-3 col-sm-2 col-md-1 label-tab">Form</label>

                    <input id="tab-2" type="radio" name="radio-set" class="tab-selector-2 radio-input" data-id="content-2" />
                    <label for="tab-2" class="tab-label-2 col-xs-3 col-sm-2 col-md-1 label-tab">Attachment</label>

                    <input id="tab-3" type="radio" name="radio-set" class="tab-selector-3 radio-input" data-id="content-3" />
                    <label for="tab-3" class="tab-label-3 col-xs-3 col-sm-2 col-md-1 label-tab">Approval</label>

                    <input id="tab-4" type="radio" name="radio-set" class="tab-selector-4 radio-input" data-id="content-4" />
                    <label for="tab-4" class="tab-label-4 col-xs-3 col-sm-2 col-md-1 label-tab">Preview</label>
                </div>
                <div class="clear-shadow"></div>

                <div class="content">
                    <div class="content-1">
                        <div class="row">
                            <div class="col-md-11">
                                <form id="CommForm">
                                    <div class="form-horizontal">
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                        <div class="form-group">
                                            @Html.HiddenFor(model => model.COMMUNICATIONID, new { @id = "hfCommReqId" })
                                            @Html.LabelFor(model => model.COMM_CATID, htmlAttributes: new { @class = "control-label col-md-2 required" })
                                            <div class="col-md-2">
                                                @Html.DropDownListFor(model => model.COMM_CATID, new SelectList(ViewBag.Categories.Items, "COMMCATEGORYID", "CATEGORY_NAME"), "-Select-", new { @id = "ddlCommCategory", @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.COMM_CATID, "", new { @class = "text-danger" })
                                            </div>
                                            @Html.LabelFor(model => model.REQUEST_TYPE, htmlAttributes: new { @class = "control-label col-md-2 required" })
                                            <div class="col-md-2">
                                                @Html.DropDownListFor(model => model.REQUEST_TYPE, new SelectList(ViewBag.RequestType, "Value", "Text"), "-Select-", new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.REQUEST_TYPE, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.COMM_MAILTYPEID, htmlAttributes: new { @class = "control-label col-md-2 required" })
                                            <div class="col-md-2">
                                                @Html.DropDownListFor(model => model.COMM_MAILTYPEID, new SelectList(ViewBag.MailTypes.Items, "COMMTYPEID", "COMM_TYPE"), "-Select-", new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.COMM_MAILTYPEID, "", new { @class = "text-danger" })
                                            </div>
                                            @Html.LabelFor(model => model.EMAILSTATUS, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-2">
                                                @Html.CheckBoxFor(model => model.EMAILSTATUS, new { @id = "sendEmail", @style = "width:20px; height:20px;" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.SUBJECT, htmlAttributes: new { @class = "control-label col-md-2 required" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.SUBJECT, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.SUBJECT, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <fieldset class="scheduler-border" style="width:95%; float:right;">
                                            <legend class="scheduler-border">
                                                <span class="text-info" style="font-weight: 600;">Below description will be displayed on the Eportal home page between Active From and Active To Date.</span>
                                            </legend>
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.CONTENT, htmlAttributes: new { @class = "control-label col-md-2 required" })
                                                <div class="col-md-10">
                                                    @*@Html.TextAreaFor(model => model.CONTENT, new { @id = "textarea-editor", @class = "form-control textArea", @onpaste = "return false", @rows = "4" })*@
                                                    @Html.TextAreaFor(model => model.CONTENT, new { @id = "txtContent", @class = "form-control textArea", @rows = "4" })
                                                    @Html.ValidationMessageFor(model => model.CONTENT, "", new { @class = "text-danger" })
                                                </div>
                                            </div>

                                            <div class="form-group" id="div_activeDate">
                                                @*hidden*@
                                                @Html.LabelFor(model => model.START_DATE, htmlAttributes: new { @class = "control-label col-md-2 required" })
                                                <div class="col-md-2">
                                                    @Html.TextBoxFor(x => x.START_DATE, new { @class = "form-control date-pic", @id = "START_DATE", placeholder = "dd-MMM-yyyy", @readonly = "readonly" })
                                                    @Html.ValidationMessageFor(model => model.START_DATE, "", new { @id = "errorMsgSDate", @class = "text-danger" })
                                                </div>
                                                @Html.LabelFor(model => model.END_DATE, htmlAttributes: new { @class = "control-label col-md-2 required" })
                                                <div class="col-md-2">
                                                    @Html.TextBoxFor(x => x.END_DATE, new { @class = "form-control date-pic", @id = "END_DATE", placeholder = "dd-MMM-yyyy", @readonly = "readonly" })
                                                    @Html.ValidationMessageFor(model => model.END_DATE, "", new { @id = "errorMsgEDate", @class = "text-danger" })
                                                </div>
                                            </div>
                                        </fieldset>

                                        <fieldset class="scheduler-border" style="width:95%; float:right;">
                                            <legend class="scheduler-border">
                                                <label class="required">Recipient</label><span class="text-info" style="font-weight: 600;">
                                                    &nbsp;&nbsp;&nbsp;&nbsp;@Html.RadioButtonFor(model => model.Recipient, 1, new { @id = "rbAll", @name = "recipient" })&nbsp;&nbsp;All Associates
                                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;@Html.RadioButtonFor(model => model.Recipient, 2, new { @id = "rbSpecific", @name = "recipient" })&nbsp;&nbsp;Specific Associates
                                                </span>
                                            </legend>
                                            @*[If you do not select any Location, Desgnation and Functinal Desgnation, This communication will go to all associates.]*@
                                            @Html.ValidationMessageFor(model => model.Recipient, "", new { @class = "text-danger" })
