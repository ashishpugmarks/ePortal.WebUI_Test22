           ////======== Bind Division========////
           function BindDivision(crnt, call) {
               var dID = $(crnt).val();
               if (dID == "") {
                   dID = 0;
               }
               var myData = {
                   OPERATION: dID,
               };
               $.ajax({
                   type: "POST",
                   url: "/Announcement/BindDivisionByOperationId",
                   data: JSON.stringify(myData),
                   contentType: "application/json; charset=utf-8",
                   dataType: "json",
                   processdata: true,
                   traditional: true,
                   success: function (data) {
                       var select = $("#Division");
                       select.empty();
                       if (data.length == 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.Value,
                               text: itemData.Text
                           }));
                       });
                       select.multiselect('rebuild');
                       if ($('#DivisionDescrip').val() != null && $('#DivisionDescrip').val() != "") {
                           var DivisionArray = $('#DivisionDescrip').val().split(",");
                           $("#Division").val(DivisionArray);
                           $("#Division").multiselect("refresh");
                       }
                       BindDepartment(select, 1);
                   }
               });
           }

           ////======== Bind Division========////
           function BindDepartment(crnt, call) {
               var dID = $(crnt).val();
               if (dID == "") {
                   dID = 0;
               }
               var myData = {
                   DIVISION: dID,
               };
               $.ajax({
                   type: "POST",
                   url: "/Announcement/BindDeptmentByDivisionId",
                   data: JSON.stringify(myData),
                   contentType: "application/json; charset=utf-8",
                   dataType: "json",
                   processdata: true,
                   traditional: true,
                   success: function (data) {
                       var select = $("#Department");
                       select.empty();
                       if (data.length == 0) {
                           select.append($('<option/>', {
                               value: 0,
