               textbox.addEventListener('input', function() {
                   // Get the input value
                   const inputValue = textbox.value;

                   // Define the regular expression to allow only character, number, space, and underscore
                   const regex = /^[a-zA-Z0-9_ ]*$/;

                   // Test the input value against the regular expression
                   if (!regex.test(inputValue)) {
                       // If the input doesn't match the pattern, clear the textbox
                       textbox.value = inputValue.slice(0, -1);
                   }
               });
           });

