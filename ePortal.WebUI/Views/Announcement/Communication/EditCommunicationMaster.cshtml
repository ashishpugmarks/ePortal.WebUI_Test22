           function AddAuthority() {
               $('#ddHeader').removeClass('validationError');
               if ($('#ddHeader').val() == "") {
                   $('#ddHeader').addClass('validationError');
                   return;
               }
               $('#txtEmpcode').removeClass('validationError');
               if ($('#txtEmpcode').val() == "") {
                   $('#txtEmpcode').addClass('validationError');
                   return;
               }
               var _ecode = parseInt($('#txtEmpcode').val().split("-")[0].trim());
               var _ename = $('#txtEmpcode').val().split("-")[1].trim();
               if (arrayList.length > 0) {
                   var itemArray = $.grep(arrayList, function (e) {
                       return e.ADEMPCODE == _ecode;
                   });

                   if (itemArray.length > 0) {
                       $('#txtEmpcode').addClass('validationError');
                       sweetAlert("", "This approval authority already added.", "warning");
                       return;
                   }
               }
               if (arrayAdditionalAuthList.length > 0) {
                   var itemArray2 = $.grep(arrayAdditionalAuthList, function (e) {
                       return e.ADEMPCODE == _ecode;
                   });

                   if (itemArray2.length > 0) {
                       $('#txtEmpcode').addClass('validationError');
                       sweetAlert("", "This approval authority already added.", "warning");
                       return;
                   }
               }

               var data = {
                   ADEMPCODE: _ecode,
                   ADEMPNAME: _ename,
                   FNDESID: $('#ddHeader').val(), //$('#ddHeader').val()== "5" ? 0 : $('#ddHeader').val(),
                   ISADDITIONAL_AUTH: 1,
                   ADDESIGNATION: $('option:selected', $('#ddHeader')).text()
               }
               arrayAdditionalAuthList.push(data);
               $('#txtEmpcode').val('');
               $("#ddHeader").val('');
               BindAdditionalAuth()
           }

