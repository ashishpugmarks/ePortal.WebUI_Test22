           function CheckAttachmentsValidation() {
               var isVailed = true;
               $('#txtFile').removeClass('validationError');
               if ($('#txtFile').val() == "") {
                   $('#txtFile').addClass('validationError');
                   isVailed = false;
               }

               $("#ddDocType").removeClass('validationError');
               if ($('#ddDocType').val() == "") {
                   $("#ddDocType").addClass('validationError');
                   isVailed = false;
               }
               $("#txtFilename").removeClass('validationError');
               if ($('#txtFilename').val().trim() == "") {
                   $("#txtFilename").addClass('validationError');
                   isVailed = false;
               }
               return isVailed;
