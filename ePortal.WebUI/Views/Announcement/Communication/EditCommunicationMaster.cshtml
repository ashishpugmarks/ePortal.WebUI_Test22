                                                    @*@Html.LabelFor(model => model.FUNCTIONAL_DESIGNATION, htmlAttributes: new { @class = "control-label col-md-4" })*@
                                                    <div class="col-sm-9 col-sm-9 col-md-8 col-lg-8">
                                                        <input type="hidden" value="@Model.FnDesignationIds" id="FnDesignationDescrip" />
                                                        @Html.DropDownListFor(model => model.FUNCTIONAL_DESIGNATION, new MultiSelectList(ViewBag.FunctionalDesignation.Items, "ADFUNCTIONALDESIGNATIONID", "DESCRIP"), new { @id = "fnDesignation", @class = "multiSelectDrop", @multiple = "multiple" })
                                                    </div>
                                                </div>

                                                @Html.LabelFor(model => model.OPERATION, htmlAttributes: new { @class = "control-label col-sm-2", @style = "margin-top:10px" })
                                                <div class="col-sm-9 col-sm-9 col-md-2 col-lg-2" style="margin-top:10px">
                                                    <input type="hidden" value="@Model.OPIds" id="OperationDescrip" />
                                                    @Html.DropDownListFor(model => model.OPERATION, new MultiSelectList(ViewBag.OPList.Items, "Value", "Text"), new { @id = "Operation", @class = "multiSelectDrop", @multiple = "multiple" })
                                                </div>
                                                @Html.LabelFor(model => model.DIVISION, htmlAttributes: new { @class = "control-label col-sm-2", @style = "margin-top:10px" })
                                                <div class="col-sm-9 col-sm-9 col-md-2 col-lg-2 ddl-div-height" style="margin-top:10px">
                                                    <input type="hidden" value="@Model.DIVIds" id="DivisionDescrip" />
                                                    @Html.DropDownListFor(model => model.DIVISION, new MultiSelectList(ViewBag.DivList.Items, "Value", "Text"), new { @id = "Division", @class = "multiSelectDrop", @multiple = "multiple" })
                                                </div>
                                                @Html.LabelFor(model => model.DEPARTMENT, htmlAttributes: new { @class = "control-label col-sm-2", @style = "margin-top:10px" })
                                                <div class="col-sm-9 col-sm-9 col-md-2 col-lg-2 ddl-dep-height" style="margin-top:10px">
                                                    <input type="hidden" value="@Model.DEPIds" id="DepartmentDescrip" />
                                                    @Html.DropDownListFor(model => model.DEPARTMENT, new MultiSelectList(ViewBag.DepList.Items, "Value", "Text"), new { @id = "Department", @class = "multiSelectDrop", @multiple = "multiple" })
                                                </div>

                                                @Html.ValidationMessageFor(model => model.SITE, "", new { @id = "errormsgSite", @class = "text-danger" })
                                            </div>
                                            <div id="div_All">
