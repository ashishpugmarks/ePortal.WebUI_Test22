             function UploadImage(file) {
                 var url = '@Url.Action("UploadContentImage", "Announcement")';
                 formData = new FormData();
                 formData.append("aUploadedFile", file);
                 $.ajax({
                     type: 'POST',
                     url: url,
                     data: formData,
                     cache: false,
                     contentType: false,
                     processData: false,
                     success: function (FileUrl) {
                         var imgNode = document.createElement('img');
                         imgNode.src = FileUrl;
                         //imgNode.setAttribute('width', '100%');
                         $('#textarea-editor').summernote('insertNode', imgNode);
                     },
                     error: function (data) {
                         alert(data.responseText);
                     }
                 });
             }

             function SaveData(current) {
                 var _IsValid = CheckValidation();
                 if (!_IsValid) {
                     return;
                 }
                 $("#btnSubmit").attr("disabled", true);
                 var approvalData = {
                     COMMUNICATIONID: $(current).attr('data-id'),
                     SUBJECT: $("#txtSubject").val(),
                     CONTENT: $("#txtContent").val(),
                     EMAIL_CONTENT: $("#textarea-editor").val(),
                     CHANGES_REQUIRED: $("#ddDocChanges").val(),
                     APPROVAL_STATUS: $("#ddApprovalStatus").val(),
                     APPROVAL_REMARK: $("#txtRemarks").val(),
                     APPTYPE: 2
                 }
                 $.ajax({
                     type: "PUT",
                     beforeSend: function () {
                         $("#ajaxLoader").addClass('loader');
                     },
                     url: "/Announcement/EditBrandCommunicationApproval",
                     data: JSON.stringify({ ADVM: approvalData, CommCategory: $("#hfCommCategory").val(), TEMP_PRV_FNAME: $('#hfTempPrwFileName').val() }),
                     contentType: "application/json; charset=utf-8",
                     datatype: "json",
                     success: function (data) {
                         if (data == 1) {
                             $('#myPreviewModel').modal('hide');
                             swal({
                                 title: "",
                                 text: "Record saved successfully",
                                 type: "success",
                             },
                             function (isConfirm) {
                                 if (isConfirm) {
                                     window.location.href = "/Announcement/BrandCommunicationApproval";
                                 }
                             });
                         }
                         else if (data == -2) {
                             $("#span-attachmentMsg").text('Attachment not uploaded, Please try again. ').css('color', '#a94442').show().delay(8000).fadeOut();
                         }
                         else if (data == 0 || data == -1) {
                             $('#myPreviewModel').modal('hide');
                             sweetAlert("", "Record not saved", "warning");
                             $("#btnSubmit").attr("disabled", false);
                         }
                     },
                     complete: function () {
                         $("#ajaxLoader").removeClass('loader');
                     },
                     error: function () {
                         sweetAlert("Oops...", "Something went wrong!", "error");
                     }
                 });
             }

             function CheckValidation() {
                 var isVailed = true;
                 $('#txtSubject').removeClass('validationError');
                 if ($('#txtSubject').val() == "") {
                     $('#txtSubject').addClass('validationError');
                     isVailed = false;
                 }
                 $('#txtContent').removeClass('validationError');
                 if ($('#txtContent').val() == "") {
                     $('#txtContent').addClass('validationError');
                     isVailed = false;
                 }
                 $('#textarea-editor').removeClass('validationError');
                 if ($('#textarea-editor').val() == "") {
                     $('#textarea-editor').addClass('validationError');
                     isVailed = false;
                 }
                 $('#ddApprovalStatus').removeClass('validationError');
                 if ($('#ddApprovalStatus').val() == "" || $('#ddApprovalStatus').val() == "0") {
                     $('#ddApprovalStatus').addClass('validationError');
                     isVailed = false;
                 }
                 $('#txtRemarks').removeClass('validationError');
                 //if ($('#ddApprovalStatus').val() == "2" || $('#ddApprovalStatus').val() == "3") {
                 if ($('#txtRemarks').val() == "") {
                     $('#txtRemarks').addClass('validationError');
                     isVailed = false;
                 }
                 //}
                 $('#ddDocChanges').removeClass('validationError');
                 if ($('#ddApprovalStatus').val() == "1") {
                     if ($('#ddDocChanges').val() == "" || $('#ddDocChanges').val() == "0") {
                         $('#ddDocChanges').addClass('validationError');
                         isVailed = false;
                     }
                 }

                 $('#txtApprvalAttachment').removeClass('validationError');
                 if (($('#ddDocChanges').val() == "1" || $('#ddDocChanges').val() == "2") && $('#hfCategory').val() == "Policy") {
                     if ($('#txtApprvalAttachment').val() == "") {
                         $('#txtApprvalAttachment').addClass('validationError');
                         return;
                     }
                 }
                 return isVailed;
             }

             function GetPDF(current) {
                 var _pdfName = $(current).attr('data-id');
                 if (_pdfName != "") {
                     $.ajax({
                         type: "GET",
                         url: "/Announcement/GetPDF",
                         beforeSend: function () {
                             $("#ajaxLoader").addClass('loader');
                         },
                         data: { fileName: _pdfName },
                         contentType: "application/json; charset=utf-8",
                         datatype: "json",
                         success: function (data) {
                             if (data.FILEPATH != "") {
                                 document.getElementById("append_pdf").innerHTML = data.FILEPATH;
                             }
                             else {
                                 sweetAlert("", "File not found.", "warning");
                             }
                         },
                         complete: function () {
                             $("#ajaxLoader").removeClass('loader');
                         },
                         error: function () {
                             sweetAlert("Oops...", "Something went wrong!", "error");
                         }
                     });
                 }
             }

             function openInfo(url) {
                 window.open(url, 'mywin', 'width=800,height=600');
             }
             function CancelClick() {
                 window.location.href = "/Announcement/BrandCommunicationApproval";
             }

             function ddApprovalStatus(current) {
                 if ($(current).val() == "2" || $(current).val() == "3") {
                     $("#lblRemark").addClass('required');
                 }
                 else {
                     $("#lblRemark").removeClass('required');
                 }
             }
             function ddDocChanges(current) {
                 //$('#myupdateModel').modal('hide');
                 if ($('#hfCategory').val() == "Policy") {
                     if ($(current).val() == "1") {
                         $("#attachment_row").removeClass('hidden');
                         //$('#myupdateModel').modal('show');
                     }
                     else if ($(current).val() == "2") {
                         //$("#attachment_row").addClass('hidden');
                         $("#attachment_row").removeClass('hidden');
                         //$('#myupdateModel').modal('hide');
                     }
                 }
             }
             function OpenDoc(current) {
                 var _pdfPath = $(current).attr('data-path');
                 var _pdfName = $(current).attr('data-name');
                 var width = screen.width - 100;
                 var height = screen.height - 100;
                 var winTop = 50;
                 var winLeft = 50;
                 var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
                 windowFeatures = windowFeatures + ",left = " + winLeft + ",";
                 windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
                 window.open(_pdfPath, _pdfName, windowFeatures);
             };

             function readBackupFile(input) {
                 var _URL = window.URL || window.webkitURL;
                 var file = input.files[0];
                 var image = new Image();
                 image.src = _URL.createObjectURL(file);
                 var extension = $(input).val().split('.').pop().toLowerCase();
                 var validFileExtensions = ['pdf'];
                 if ($.inArray(extension, validFileExtensions) == -1) {
                     sweetAlert(" ", "Sorry! Upload only 'pdf' file", "warning");
                     $(input).replaceWith($(input).val('').clone(true));
                 }
             }

             function UploadAttachment() {
                 $('#txtApprvalAttachment').removeClass('validationError');
                 if ($('#txtApprvalAttachment').val() == "") {
                     $('#txtApprvalAttachment').addClass('validationError');
                     return;
                 }
                 var formData = new FormData();
                 formData.append("FILE", document.getElementById("txtApprvalAttachment").files[0]);
                 formData.append("DOC_TYPE", "VERIFIED_DOC");
                 formData.append("ADDITIONAL_INFO", "Verified By Corporate Communication Team");
                 formData.append("COMMUNICATIONID", $("#hfCommReqID").val());
                 formData.append("FILENAME", "VERIFIED_DOC");
                 $.ajax({
                     type: "POST",
                     url: "/Announcement/UploadBC",
                     data: formData,
                     datatype: "json",
                     contentType: false,
                     processData: false,
                     success: function (data) {
                         if (data == 1) {
                             $("#span-attachmentMsg").text('Attachment uploaded successfully. ').css('color', 'green').show().delay(5000).fadeOut();
                         }
                         else if (data == 0 || data == -1) {
                             $("#span-attachmentMsg").text('Attachment not uploaded, Please try again. ').css('color', '#a94442').show().delay(5000).fadeOut();
                         }
                     },
                     error: function () {
                         $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                     }
                 });
             }

             function Preview(crnt) {
                 debugger; var emailStatus = $(crnt).attr('data-email');
                 document.getElementById("lblSubject").innerHTML = "";
                 document.getElementById("lblContent").innerHTML = "";
                 if (emailStatus == "True") {
                     document.getElementById("lblEmailContent").innerHTML = "";
                 }

                 $('#myPreviewModel').modal('hide');
                 var _IsValid = CheckValidation();
                 if (!_IsValid) {
                     return;
                 }
                 if ($("#hfCommTemplateName").val() != "") {
                     $("#btnPreview").attr("disabled", true);
                     $.ajax({
                         type: "POST",
                         url: "/Announcement/PreviewCommunication",
                         beforeSend: function () {
                             $("#ajaxLoader").addClass('loader');
                         },
                         data: JSON.stringify({
                             id: $("#hfCommID").val(), IsChanges: $('#ddDocChanges').val(), TEMP_PRV_FNAME: $('#hfTempPrwFileName').val()
                         }),
                         contentType: "application/json; charset=utf-8",
                         datatype: "json",
                         success: function (data) {
                             if (data.FILEPATH != "") {
                                 if (data.TEMP_PREVIEW_FILE != "") {
                                     $('#hfTempPrwFileName').val(data.TEMP_PREVIEW_FILE);
                                 }

                                 document.getElementById("Comm_attachment").innerHTML = data.FILEPATH;
                                 document.getElementById("lblSubject").innerHTML = $("#txtSubject").val();
                                 document.getElementById("lblContent").innerHTML = $("#txtContent").val();
                                 if (emailStatus == "True") {
                                     document.getElementById("lblEmailContent").innerHTML = $("#textarea-editor").val();
                                     debugger;
                                     var images = $("#lblEmailContent").find("img");
                                     if (images.length > 0) {
                                         images.each(function () {
                                             $(this).css("max-width", "100%");
                                         });
                                     }
                                 }
                                 $('#myPreviewModel').modal({ backdrop: "static" });
                             }
                             else if (data.FILEPATH == "" && data.TEMP_PREVIEW_FILE == "") {
                                 $("#span-attachmentMsg").text('Attachment not uploaded, Please try again. ').css('color', '#a94442').show().delay(5000).fadeOut();
                             }
                         },
                         complete: function () {
                             $("#ajaxLoader").removeClass('loader');
                             $("#btnPreview").attr("disabled", false);
                         },
                         error: function () {
                             sweetAlert("Oops...", "Something went wrong!", "error");
                             $("#btnPreview").attr("disabled", false);
                             $("#ajaxLoader").removeClass('loader');
                         }
                     });
                 }
                 else {
                     document.getElementById("lblSubject").innerHTML = $("#txtSubject").val();
                     document.getElementById("lblContent").innerHTML = $("#txtContent").val();
                     if (emailStatus == "True") {
                         document.getElementById("lblEmailContent").innerHTML = $("#textarea-editor").val();
                         debugger;
                         var images = $("#lblEmailContent").find("img");
                         if (images.length > 0) {
                             images.each(function () {
                                 $(this).css("max-width", "100%");
                             });
                         }
                     }
                     $('#myPreviewModel').modal({ backdrop: "static" });
                     //$("#btnSubmit").click();
                 }
