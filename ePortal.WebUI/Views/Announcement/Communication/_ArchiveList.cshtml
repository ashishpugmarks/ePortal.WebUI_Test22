@model IEnumerable<ePortal.ViewModels.CommunicationViewModel>

@{
    Layout = null;
}
<style type="text/css" nonce="@Context.Items["StyleNonce_8"]">
    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    select.input-sm {
        line-height: 10px !important;
    }
</style>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
    $('.homeContent').removeClass('homeContent');
    $(document).ready(function () {
        $("#tbArchive").dataTable({
            //"bFilter": false,
            //"bLengthChange": false
        });

    });
</script>

@* CSP 3.0 Compliant changes *@
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
    $(document).ready(function () {
        $(document).on('click', '[data-ctrl="btn-det-req-par-al"]', function () {
            DetailRequest($(this)[0]);
        });
    });
</script>

<div class="panel-group">
    <div class="panel panel-primary">
        <div class="panel-heading">
            <h2 class="panel-title">
                <strong>Archive List</strong>
            </h2>
        </div>
        <div class="panel-body">
            <table class="table table-bordered table-hover" id="tbArchive">
                <thead>
                    <tr class="bg-info">
                        <th class="text-center" style="width:5%;">
                            @Html.DisplayNameFor(model => model.COMMUNICATIONID)
                        </th>
                        <th class="text-center" style="width:8%;">
                            @Html.DisplayNameFor(model => model.REQUESTNO)
                        </th>
                        <th class="text-center" style="width:15%;">
                            @Html.DisplayNameFor(model => model.COMM_CATID)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.SUBJECT)
                        </th>
                        @*<th class="text-center">
                                @Html.DisplayNameFor(model => model.CONTENT)
                            </th>*@
                        <th class="text-center" style="width:9%;">
                            @Html.DisplayName("Publish Date")
                            @*@Html.DisplayNameFor(model => model.CREATED_DATE)*@
                        </th>
                        @*<th class="text-center">
                                @Html.DisplayNameFor(model => model.STATUS)
                            </th>*@
                        <th class="text-center" style="width:6%;">View</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowNo = 0;
                    }
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center" style="width:3%;">
                                    @(rowNo += 1)
                                    @Html.HiddenFor(modelItem => item.COMMUNICATIONID)
                                </td>
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.REQUESTNO)
                                </td>
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.CATEGORY)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SUBJECT)
                                </td>
                                @*<td>
                                        @Html.DisplayFor(modelItem => item.CONTENT)
                                    </td>*@
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.MODIFIED_DATE)
                                </td>
                                @*<td class="text-center">
                                        @if (item.STATUS == 1)
                                                {
                                                <button class="btn btn-success btn-xs" style="cursor: text !important">Active</button>
                                                }
                                                else
                                                {
                                                <button class="btn btn-danger btn-xs" style="cursor: text !important">Deactive</button>
                                                }
                                    </td>*@
                                <td class="text-center">
                                    <button class="btn btn-info btn-xs glyphicon glyphicon-tasks" title="Click to detail" data-id="@item.COMMUNICATIONID" data-ctrl="btn-det-req-par-al"></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>