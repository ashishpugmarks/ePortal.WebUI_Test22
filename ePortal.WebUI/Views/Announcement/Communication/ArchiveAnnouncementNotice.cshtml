    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                Archive
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <table class="table table-bordered table-hover" id="tbArchive">
                <thead>
                    <tr class="bg-info">
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.COMMUNICATIONID)
                        </th>
                        <th class="text-center" style="width: 25%;">
                            @Html.DisplayNameFor(model => model.COMM_CATID)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.SUBJECT)
                        </th>
                        @*<th class="text-center">
                                @Html.DisplayNameFor(model => model.CONTENT)
                            </th>*@
                        <th class="text-center" style="width:10%;">
                            @*@Html.DisplayNameFor(model => model.CREATED_DATE)*@
