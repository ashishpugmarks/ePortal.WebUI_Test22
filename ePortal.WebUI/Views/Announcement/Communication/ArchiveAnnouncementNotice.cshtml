                                    <a id="Attachment1-link"></a>
                                    <a id="Attachment2-link"></a>
                                </div>
                            </div>
                            <div class="modal-right-content">
                                <h3 class="hidden-xs">
                                    <span id="lblSubject"></span>
                                    <span class="heading lblCreateDate"></span>
                                </h3>
                                <p id="lblDescription"></p>
                                <p class="venue-text" style="display:none;"></p>

                                <div class="download-links visible-xs">
                                    <h6>Download :</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>*@
        </div>
        <!-- Annoucements preview modal end -->
    </div>
@section Scripts {
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $('.homeContent').removeClass('homeContent');
    $(document).ready(function () {
        $("#tbArchive").dataTable();

    });

    function GetDetails(current) {
        var $buttonClicked = $(this);
        var _type = $(current).attr('data-type');
        $.ajax({
            type: "GET",
            url: "/Announcement/ArchiveAnnouncementNoticeDetails",
            data: { id: current.id },
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            success: function (data) {
                if (data == "error") {
                    sweetAlert("", "An error occurred while processing your request.", "error");
                }
                else if (data != "") {
                    //var img = "";
                    //$('#Attachment1-link').text('');
                    //$('#Attachment2-link').text('');
                    //$('#lblHeading').text(data.obj.CATEGORY);
                    ////$('#banner-img').attr('src', data.banner);
                    ////$('#Attachment1-link').text(data.obj.ATTACHMENT1_NAME != null ? data.obj.ATTACHMENT1_NAME : "");
                    ////$('#Attachment2-link').text(data.obj.ATTACHMENT2_NAME != null ? data.obj.ATTACHMENT2_NAME : "");
                    //$('#lblSubject').text(data.obj.SUBJECT);
                    //$('#lblDescription').text(data.obj.CONTENT);
                    //$('.lblCreateDate').text(data.date)
                    //$('#myAnnouncementsModal').modal({ backdrop: "static" });

                    $('#myAnnouncementsModal').html(data);
                    $('#myAnnouncementsModal').modal({ backdrop: "static" });
                }
            },
            error: function () {
                sweetAlert("Oops...", "Something went wrong!", "error");
            }
        });
    }

    //$("#closeModel").click(function () {
    //    $('#myAnnouncementsModal').modal('hide');
    //});
</script>
@* CSP 3.0 Compliant changes *@
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    $(document).ready(function () {
        $(document).on('click', '[data-ctrl="btn-get-detail"]', function () {
            GetDetails($(this)[0]);
        });
    });
</script>
}