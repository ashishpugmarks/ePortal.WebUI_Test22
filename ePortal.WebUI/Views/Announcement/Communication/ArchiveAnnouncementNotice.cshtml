                            <img src="/images/announcements_overlay_header_bg.png" alt="Announcements banner" title="Announcements banner" class="announcements-read-more-banner" />
                            <h2 id="lblHeading">Announcements</h2>
                        </div>
                        <div class="modal-body">
                            <div class="modal-left-content">
                                <h3 class="visible-xs lblSubject">
                                    <span class="heading lblCreateDate"></span>
