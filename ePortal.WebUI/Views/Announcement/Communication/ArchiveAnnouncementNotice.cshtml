                        </th>
                        @*<th class="text-center">
                                @Html.DisplayNameFor(model => model.STATUS)
                            </th>*@
                        <th class="text-center" style="width:6%;">View</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNo = 0; }
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center" style="width:3%;">
                                    @(rowNo += 1)
                                    @Html.HiddenFor(modelItem => item.COMMUNICATIONID)
                                </td>
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.CATEGORY)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SUBJECT)
                                </td>
                                @*<td>
                                        @Html.DisplayFor(modelItem => item.CONTENT)
                                    </td>*@
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.MODIFIED_DATE)
                                </td>
                                @*<td class="text-center">
                                        @if (item.STATUS == 1)
                                        {
                                            <button class="btn btn-success btn-xs" style="cursor: text !important">Active</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-danger btn-xs" style="cursor: text !important">Deactive</button>
                                        }
                                    </td>*@
                                <td class="text-center">
                                <button class="btn btn-info btn-xs glyphicon glyphicon-tasks" title="Click to detail" id="@item.COMMUNICATIONID" data-type="@item.CATEGORY" data-ctrl="btn-get-detail"></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Annoucements preview modal start -->
        <div id="myAnnouncementsModal" class="modal fade" tabindex="-1" role="dialog">
