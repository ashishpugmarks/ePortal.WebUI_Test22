@using System.Net
@using ePortal.Shared
@model IEnumerable<ePortal.ViewModels.CommunicationViewModel>

@{
    ViewBag.Title = "BrandCommunicationApproval";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
    </style>
}
   
    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Corporate Communication Approval</div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Request Approval List</strong>
                            <strong class="pull-right">
                                <button class="btn btn-default btn-xs" id="btnApprovalHistory">Approval History</button>
                            </strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <table class="table table-bordered table-hover table-responsive" id="tbBrandComm">
                            <thead>
                                <tr>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.COMMUNICATIONID)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.COMM_CATID)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.SUBJECT)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.COMM_MAILTYPEID)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.CREATED_BY)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.CREATED_DATE)
                                    </th>
                                    @*<th class="text-center">
                                        @Html.DisplayNameFor(model => model.PROCESS_STATUS)
                                    </th>*@
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNo = 0;
                                }
                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        @* var _reqId = Server.UrlEncode(Encryption.Encrypt(item.COMMUNICATIONID.ToString())).ToString(); *@
                                        var _reqId = WebUtility.UrlEncode(Encryption.Encrypt(item.COMMUNICATIONID.ToString()));

                                        var _AddedDate = string.Format("{0:yyyy-MM-dd}", item.CREATED_DATE);
                                        <tr>
                                            <td class="text-center" style="width:3%;">
                                                @(rowNo += 1)
                                                @Html.HiddenFor(modelItem => item.COMMUNICATIONID)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.CATEGORY)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.SUBJECT)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.MAILTYPE)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.CREATED_BY_NAME)
                                            </td>
                                            <td class="text-center">
                                                @_AddedDate
                                            </td>
                                            @*<td class="text-center">
                                                @Html.DisplayFor(modelItem => item.PROCESS_STATUS)
                                            </td>*@
                                            <td class="text-center">
                                                <button class="btn btn-warning btn-xs glyphicon glyphicon-edit" title="Click to edit" data-id="@item.COMMUNICATIONID" data-ctrl="btn-edit-request"></button>
                                                <button class="btn btn-info btn-xs glyphicon glyphicon-tasks" title="Click to detail" data-id="@_reqId" data-ctrl="btn-detail-request"></button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>

    </div>

    <form id="_form" action="@Url.Action("EditBrandCommunicationApproval", "Announcement")" method="post">
        <input type="hidden" id="hfHeaderId" name="id" value="0" />
    </form>

    <div id="myCreateModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header" style="padding:10px!important;">
                    <div class="pull-left">
                        <h5 class="modal-title"><span id="sp_type"></span></h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body" style="padding:10px!important;">
                    <div id="myCreateModelContent"></div>
                </div>
            </div>
        </div>
    </div>
@section Scripts {
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $(document).ready(function () {
        $('.homeContent').removeClass('homeContent');
        $("#tbBrandComm").dataTable({
            "bFilter": false,
            "bLengthChange": false
        });
    });

    function EditRequest(current) {
        var _disposalHeaderId = $(current).attr('data-id');
        if (_disposalHeaderId != undefined) {
            $('#hfHeaderId').val(_disposalHeaderId);
            $('#_form').submit();
        }
    }

    // function DetailRequest(current) {
