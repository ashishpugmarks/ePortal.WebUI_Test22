@model ePortal.ViewModels.CommMailTypeViewModel

@{
    Layout = null;
}
<!doctype html>
<html>
<head>
    <style type="text/css" nonce="@Context.Items["StyleNonce_8"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .validationError {
            border: 1px solid #a94442;
        }
    </style>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
        $(document).ready(function () {

        });

        function SaveData() {
            var isFormVaildation = CheckFormValidation();
            if (isFormVaildation) {
                $("#btnSave").attr("disabled", true);
                var commTypeId = $('#hfAssetOpId').val() || 0;
                var data = {
                    COMMTYPEID: commTypeId,
                    COMM_TYPE: $('#txtComType').val(),
                    COMM_EMAILID: $('#txtComEmailID').val(),
                    STATUS: $('#chkActive')[0].checked
                }
                $.ajax({
                    type: "POST",
                    url: "/Announcement/SaveCommunicationType",
                    // beforeSend: function () {
                    //     $("#ajaxLoader").addClass('loader');
                    // },
                    data: JSON.stringify(data),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        $('#myCreateModel').modal('hide');
                        if (data == 1) {
                            swal({
                                title: "",
                                text: "Record saved successfully.",
                                type: "success",
                            }, function (isConfirm) {
                                if (isConfirm) {
                                    window.location.href = "/Announcement/ManageCommunicationType";
                                }
                            });
                        }
                        else if (data == 2) {
                            sweetAlert("", "Record already exist.", "warning");
                        }
                        else {
                            sweetAlert("", "Record not saved.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function CheckFormValidation() {
            var isVailed = true;
            $("#txtComType").removeClass('validationError');
            if ($('#txtComType').val() == "") {
                $("#txtComType").addClass('validationError');
                isVailed = false;
            }

            $("#txtComEmailID").removeClass('validationError');
            if ($('#txtComEmailID').val() == "") {
                $("#txtComEmailID").addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }
    </script>

    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
        $(document).ready(function () {
            $('[data-ctrl="btn-save-part-ct"]').on('click', function () {
                SaveData();
            });
        });
    </script>
</head>

<body>
    <div class="body-content" style="padding:0px !important;">
        <div>
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group">
                    @Html.HiddenFor(model => model.COMMTYPEID, htmlAttributes: new { @id = "hfAssetOpId" })
                    @Html.LabelFor(model => model.COMM_TYPE, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-6">
                        @Html.TextBoxFor(model => model.COMM_TYPE, new { @id = "txtComType", @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.COMM_TYPE, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.COMM_EMAILID, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-6">
                        @Html.TextBoxFor(model => model.COMM_EMAILID, new { @id = "txtComEmailID", @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.COMM_EMAILID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.STATUS, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-6">
                        @Html.CheckBoxFor(model => model.STATUS, new { @id = "chkActive", @style = "width:20px; height:20px;" })
                        @Html.ValidationMessageFor(model => model.STATUS, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-4 col-md-8">
                        <input type="button" value="Save" class="btn btn-success" id="btnSave" data-ctrl="btn-save-part-ct" />
                        <button type="button" class="btn btn-default" data-dismiss="modal" aria-label="Close">Cancel</button>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div id="ajaxLoader"></div>

</body>
</html>
