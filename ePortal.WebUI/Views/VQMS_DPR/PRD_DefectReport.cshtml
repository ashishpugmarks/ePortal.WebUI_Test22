@section Styles {
    <link rel="stylesheet" type="text/css" href="../../css/index.css" media="print" />
    <style>
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .chart-container {
            width: 700px !important;
            height: 400px !important;
            background: oldlace;
            border: 0px solid rgba(26,59,105,1);
            border-radius: 10px;
            box-shadow: 6px 8px 10px rgba(0, 0, 0, 0.3);
            padding: 8px !important;
            margin: 10px;
        }

        .homeContent {
            padding: 0;
        }
    </style>
}
