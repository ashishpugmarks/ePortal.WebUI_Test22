@section Scripts {
    <script type="text/javascript" src="../../Js/CalendarPopup.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

        $(document).ready(function () {
            let SiteId = $("#ddlFactory").val();
            BindModelList(SiteId);
            $("#ddlFactory").change(function () {
                BindModelList($(this).val());
            });
            $("#txtDate").datepicker({
            format: "M-yyyy",
                autoclose: true,
                startView: "months",
                minViewMode: "months"
            }).datepicker("setDate", new Date());
            $("#S1").on("click", function (e) {
                e.preventDefault();
                $("#txtDate").datepicker("show");
            });
            $("#R1").on("click", function (e) {
                e.preventDefault();
                $("#txtDate").val("");
            });
            $("#btnSearch").click(function (e) {
                e.preventDefault();
                const data = {
                    txtDate: $('#txtDate').val(),
                    ddlModel: $('#ddlModel').val(),
                    ddlSite: $('#ddlFactory').val()
                }
                if (data.txtDate == "") {
                    alert("Please select Month and Year")
                    return;
                }
                window.location.href = `/VQMS_DPR/ExportDefectTrendRpt?txtDate=${data.txtDate}&ddlModel=${data.ddlModel}&ddlSite=${data.ddlSite}`;
            });
        });

        function BindModelList(SiteId) {
            $.ajax({
                url: '/VQMS_DPR/GetModels',
                type: 'GET',
                data: { SiteId: SiteId },
                success: function (data) {
                    var ddl = $('#ddlModel');
                    ddl.empty();
                    $.each(data, function (i, item) {
                        ddl.append($('<option>', {
                            value: item.Value,
                            text: item.Text
                        }));
                    });
                },
                error: function () {
                    alert('Error loading dropdown data');
                }
            });
        }
        //REMOVE DATES

        // var cal5 = new CalendarPopup();
        // cal5.setDisplayType("month");
        // cal5.setReturnMonthFunction("monthReturn");
        // cal5.showYearNavigation();

        // function monthReturn(y,m) {
        //     document.getElementById("<%=txtMonth.ClientID%>").value = m;
        //     document.getElementById("<%=txtYear.ClientID%>").value = y;
        // }

        function removefromdate() {
            document.getElementById('txtMonth').value = "";
            document.getElementById('txtYear').value = "";
        }

        function Readonly() {
            document.getElementById('txtMonth').readOnly = true;
            document.getElementById('txtYear').readOnly = true;
        }

    </script>
}
