@section Scripts
{
    <script nonce="@Context.Items["ScriptNonce_0"]">
                $(document).ready(function () {
            // Check if user already accepted
            if (!sessionStorage.getItem('caveatAcceptedAddItem')) {

                // Show modal only first time
                $('#caveatModal').modal({
                    backdrop: 'static',
                    keyboard: false
                });

                $('#acceptBtn').click(function () {
                    sessionStorage.setItem('caveatAcceptedAddItem', 'true'); // mark as accepted
                    $('#caveatModal').modal('hide');
                });
            }
        });
               $(document).on("click", ".photo-preview", function () {
                    const imgSrc = $(this).data("full") || $(this).attr("src");
                    $("#modalImage").attr("src", imgSrc);
                    $("#imageModal").modal("show");
                });
            $(document).ready(function () {
                        $('#LocationFound').select2({
            placeholder: "-- Select Location --",
            allowClear: true,
            width: '100%' // make it full-width like Bootstrap form-control
        });
        const today = new Date().toISOString().split('T')[0];

        // Set max date = today (no future date allowed)
        $('#DateFound').attr('max', today);

        // Set default date to today if not already set
        if (!$('#DateFound').val()) {
            $('#DateFound').val(today);
        }

         // Handle photo upload preview
        $('#ItemPhoto').change(function () {
            const files = this.files;

            // 🔹 Max 2 file limit
            if (files.length > 2) {
                sweetAlert("Limit Exceeded", "You can upload a maximum of 2 images only.", "warning");
                $(this).val(''); // clear selection
                return;
            }

            const previewContainer = $('#previewContainer');
            previewContainer.empty(); // clear old previews

            // 🔹 If no files, reset view
            if (files.length === 0) {
                $('#photoUpload').show();
                $('#photoPreview').hide();
                return;
            }

            let validFiles = [];

            // 🔹 Validate each file
            Array.from(files).forEach(file => {
                if (!file.type.startsWith('image/')) {
                    sweetAlert("Invalid File", `${file.name} is not an image file. Please select only images.`, "warning");
                } else if (file.size > 2 * 1024 * 1024) {
                    sweetAlert("File Too Large", `${file.name} is larger than 2 MB. Please upload a smaller file.`, "warning");
                } else {
                    validFiles.push(file);
                }
            });

            // 🔹 If all invalid, clear selection
            if (validFiles.length === 0) {
                $(this).val('');
                $('#photoUpload').show();
                $('#photoPreview').hide();
                return;
            }

            // 🔹 Show preview for valid images only
            $('#photoUpload').hide();
            $('#photoPreview').show();

                   validFiles.forEach((file, index) => {
            const reader = new FileReader();
            reader.onload = function (e) {
                // Create a container div for each image & icon
                const wrapper = $('<div>')
                    .addClass('preview-wrapper')
                    .css({ position: 'relative', display: 'inline-block', margin: '8px' })
                    .attr('data-index', index); // optional: for reference

                // Preview image
                const img = $('<img>')
                    .attr('src', e.target.result)
                    .addClass('photo-preview')
                    .css({ width: '120px', height: '120px', objectFit: 'cover', borderRadius: '8px', border: '1px solid #d3d3d3' });

                // Remove (cut) icon
                const removeBtn = $('<span>')
                    .addClass('remove-photo')
                    .html('<i class="fa fa-times-circle" style="font-size: 22px; color: #dc3545;"></i>')
                    .css({
                        position: 'absolute',
                        top: '-7px',
                        right: '-7px',
                        background: '#fff',
                        borderRadius: '50%',
                        cursor: 'pointer',
                        boxShadow: '0 1px 3px rgba(0,0,0,0.25)',
                        zIndex: 10
                    });

                // Click event to remove image
                removeBtn.click(function () {
                    // Remove this preview element from DOM
                    wrapper.remove();

                    // Remove file from input (and force re-render preview)
                    let dt = new DataTransfer();
                    Array.from($('#ItemPhoto')[0].files).forEach((f, idx) => {
                        if (idx !== index) dt.items.add(f);
                    });
                    $('#ItemPhoto')[0].files = dt.files;
                    $('#ItemPhoto').trigger('change');
                });

                wrapper.append(img, removeBtn);
                previewContainer.append(wrapper);
            };
            reader.readAsDataURL(file);
        });

        });


        // Remove all previews + reset input
        $('#removePhotoBtn').click(function () {
            $('#ItemPhoto').val('');
            $('#previewContainer').empty();
            $('#photoUpload').show();
            $('#photoPreview').hide();
        });


            // Form validation
            $('#addItemForm').submit(function (e) {
            e.preventDefault(); // prevent default form submission

            let isValid = true;
            const requiredFields = [
                'ItemType',
                'DateFound',
                'ProductName',
                'LocationFound',
                'MarkDescription',  
                'MaterialType'       
            ];

            requiredFields.forEach(function (field) {
                const value = $('#' + field).val();
                if (!value || value.trim() === '') {
                    $('#' + field).addClass('is-invalid');
                    isValid = false;
                } else {
                    $('#' + field).removeClass('is-invalid');
                }
            });

            if (!isValid) {
                sweetAlert("", "Please fill in all required fields marked with *.", "warning");
                return false;
            }

            // Show loading
            $('button[type="submit"]').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Saving...');

            var formData = new FormData(this);

            $.ajax({
                url: '@Url.Action("AddItem")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                 swal({
                    title: "Success",
                    text: "Item added successfully.",
                    type: "success"
                }, function() {
                    window.location.href = '/LostAndFound/Index';
                });
                    } else {
                        sweetAlert("Oops...", response.message || "Failed to add item.", "error");
                        $('button[type="submit"]').prop('disabled', false).html('<i class="fa fa-save"></i> Submit');
                    }
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong! Please try again.", "error");
                    $('button[type="submit"]').prop('disabled', false).html('<i class="fa fa-save"></i> Submit');
                }
            });
        });


