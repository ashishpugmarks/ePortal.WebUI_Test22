            function removePhoto() {
                $('#ItemPhoto').val('');
                $('#photoPreview').hide();
                $('#photoUpload').show();
            }
            $("#removePhotoBtn").on("click", function () {
                removePhoto();
            });
            $("#choosePhotoBtn").on("click", function () {
                $("#ItemPhoto").click();
