                        <div class="mb-3">
                            <label for="companyName" class="form-label">Company Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="companyName" placeholder="Enter company name" />
                        </div>
                        <div class="mb-3">
                            <label for="verificationDetails" class="form-label">Verification Details <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="verificationDetails" rows="2" placeholder="Enter verification details..."></textarea>
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-info" id="submitClaimedBtn">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script nonce="@Context.Items["ScriptNonce_1"]">
        var allRows = [];
        var currentPage = 1;
        var rowsPerPage = 20;

            


        $(document).ready(function() {

        $('#exportToExcel').on('click', function () {
            // Get filter values
            var data = {
                ItemType: $('#itemType').val(),
                Status: $('#status').val(),
                DateFrom: $('#dateFrom').val(),
                DateTo: $('#dateTo').val()
            };
			console.log(data);

            // First, request server to generate excel HTML and save in session
            $.ajax({
                url: '/LostAndFound/ExportToExcel',
                type: 'POST',
                data: data,
                success: function (response) {
                     if (response?.success) {
                        window.location.href = '/LostAndFound/DownloadExcelFile';
                    } else {
                        alert(response?.message || "Export failed or no data available.");
                    }
                },
                error: function () {
                    alert("Something went wrong during export.");
                }
            });
        });

            // Store all table rows
            allRows = $('#tableBody tr').toArray();
            var storedStatus = sessionStorage.getItem("statusFilter");
        if (storedStatus !== null) {
            $('#status').val(storedStatus);
        } else {
            $('#status').val('0'); 
        }

        var storedItemType = sessionStorage.getItem("itemTypeFilter");
        if (storedItemType !== null) {
            $('#itemType').val(storedItemType);
        }

        var storedDateFrom = sessionStorage.getItem("dateFromFilter");
        if (storedDateFrom !== null) {
            $('#dateFrom').val(storedDateFrom);
        }

        var storedDateTo = sessionStorage.getItem("dateToFilter");
        if (storedDateTo !== null) {
            $('#dateTo').val(storedDateTo);
        }
            applyFilters();

            $('#status').on('change', function () {
                sessionStorage.setItem("statusFilter", $(this).val());
            });

            // Initialize sorting functionality
            $("#lostFoundTable th").click(function () {
                if ($(this).find('i.fa-sort').length > 0) {
                    var table = $(this).parents("table").eq(0);
                    var rows = table.find("tbody tr").toArray().sort(comparer($(this).index()));
                    this.asc = !this.asc;
                    if (!this.asc) { rows = rows.reverse(); }

                    // Clear and re-append sorted rows
                    $('#tableBody').empty();
                    for (var i = 0; i < rows.length; i++) {
                        $('#tableBody').append(rows[i]);
                    }

                    // Update allRows with new order
                    allRows = rows;

                    // Re-apply pagination
                    showPage(1);
                }
            });

           $(document).ready(function () {
          $('#closeByEmpCode').on('change', function () {
            var empCode = $(this).val().trim();
            if (!empCode) {
              $('#employeeName, #department, #designation').val('');
              return;
            }
            $.ajax({
              url: '@Url.Action("GetEmployeeByCode", "LostAndFound")' + '?empCode=' + encodeURIComponent(empCode),
              method: 'GET',
              dataType: 'json',
              success: function (data) {                
                if (data && data.success) {
                  $('#employeeName').val(data.Name);           
                  $('#department').val(data.Department);       
                  $('#designation').val(data.Designation);     
                } else {
                  $('#employeeName, #department, #designation').val('');
                  if (data && data.Message) {
                    
                  }
                }
              },
              error: function () {
                $('#employeeName, #department, #designation').val('');
                console.error('Failed to fetch employee data.');
              }
            });
          });
        });








            // Auto-hide alerts after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Set default date range (last 30 days)
            var today = new Date();
            var thirtyDaysAgo = new Date();
            thirtyDaysAgo.setDate(today.getDate() - 30);
            $('#dateFrom').val(thirtyDaysAgo.toISOString().split('T')[0]);
            $('#dateTo').val(today.toISOString().split('T')[0]);
            // Filter functionality
            $('#btnFilter').on('click', function() {
                applyFilters();
            });

            $('#clearFiltersBtn').on('click', function() {
                clearFilters();
            });

            // Initialize pagination
            setTimeout(function() {
                showPage(1);
            }, 100);

            // Event listeners for security action buttons
            $(document).on('click', '.btn-approve', function() {
                var itemId = $(this).data('item-id');
                showApproveModal(itemId);
                // approveItem(itemId);
            });

            $(document).on('click', '.btn-sendback', function() {
                var itemId = $(this).data('item-id');
                showSendBackModal(itemId);
            });

            $(document).on('click', '.btn-reject', function() {
                var itemId = $(this).data('item-id');
                showRejectModal(itemId);
            });

            $(document).on('click', '.btn-close', function() {
                var itemId = $(this).data('item-id');
                showClaimedModal(itemId);
            });

            $(document).ready(function () {
            $('input[name="radioOption"]').change(function () {
                if ($(this).val() === "HMSI Associate") {
                    
                    $("#hmsiFields").show();
                    $("#otherFields").hide();                  
                    $("#employeeNameOther").val("");
                    $("#companyName").val("");
                    $("#otherFields #verificationDetails").val("");
                }
                else if ($(this).val() === "Other") {
                    
                    $("#hmsiFields").hide();
                    $("#otherFields").show();                    
                    $("#closeByEmpCode").val("");
                    $("#employeeName").val("");
                    $("#department").val("");
                    $("#designation").val("");
                    $("#hmsiFields #verificationDetails").val("");
                }
            });

            // Initial load condition (default selected radio)
            if ($('#radio1').is(':checked')) {
                $("#hmsiFields").show();
                $("#otherFields").hide();
            } else if ($('#radio2').is(':checked')) {
                $("#hmsiFields").hide();
                $("#otherFields").show();
            }
        });


            // Modal submit buttons
             $('#submitApproveBtn').on('click', function() {
                approveItem();
            });

            $('#submitSendBackBtn').on('click', function() {
                submitSendBack();
            });

            $('#submitRejectBtn').on('click', function() {
                submitReject();
            });

            $('#submitClaimedBtn').on('click', function() {
                submitClaimed();
            });
        });

        // Sorting functions
        function comparer(index) {
            return function (a, b) {
                var valA = getCellValue(a, index), valB = getCellValue(b, index);
                return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB);
            }
        }

        function getCellValue(row, index) {
            return $(row).children("td").eq(index).text();
        }

        // Pagination functions
        function showPage(page) {
            currentPage = page;
            var startIndex = (page - 1) * rowsPerPage;
            var endIndex = startIndex + rowsPerPage;

            // Hide all rows
            $('#tableBody tr').hide();

            // Show only rows for current page
            for (var i = startIndex; i < endIndex && i < allRows.length; i++) {
                $(allRows[i]).show();
            }

            updatePagination();
        }

        function updatePagination() {
            var totalPages = Math.ceil(allRows.length / rowsPerPage);
            var pagination = $('#pagination');
            pagination.empty();

            if (totalPages <= 1) {
                pagination.hide();
                return;
            }

            pagination.show();

            // Previous button
            if (currentPage > 1) {
                var prevItem = $('<li class="page-item"><a class="page-link" href="javascript:void(0);">Previous</a></li>');
                prevItem.find('a').click(function() {
                    showPage(currentPage - 1);
                });
                pagination.append(prevItem);
            }

            // Page numbers
            for (var i = 1; i <= totalPages; i++) {
                var listItem = $('<li></li>').addClass('page-item');
                var link = $('<a></a>').addClass('page-link').attr('href', 'javascript:void(0);').text(i);

                if (i === currentPage) {
                    listItem.addClass('active');
                }

                (function(pageNum) {
                    link.click(function() {
                        showPage(pageNum);
                    });
                })(i);

                listItem.append(link);
                pagination.append(listItem);
            }

            // Next button
            if (currentPage < totalPages) {
                var nextItem = $('<li class="page-item"><a class="page-link" href="javascript:void(0);">Next</a></li>');
                nextItem.find('a').click(function() {
                    showPage(currentPage + 1);
                });
                pagination.append(nextItem);
            }
        }

        function applyFilters() {
            var itemType = $('#itemType').val();
            var status = $('#status').val();
            var dateFrom = $('#dateFrom').val();
            var dateTo = $('#dateTo').val();

            sessionStorage.setItem("itemTypeFilter", itemType);
            sessionStorage.setItem("statusFilter", status);
            sessionStorage.setItem("dateFromFilter", dateFrom);
            sessionStorage.setItem("dateToFilter", dateTo);
            // Get all original rows
            var filteredRows = $('#tableBody tr').toArray().filter(function(row) {
                var $row = $(row);
                var rowItemType = $row.find('td:eq(0)').text().trim();
                var rowStatus = $row.find('td:eq(4)').text().trim();
                var rowDate = $row.find('td:eq(3)').text().trim();

                // Item type filter
                if (itemType) {
                    if (itemType === 'Found' && rowItemType !== 'Found') return false;
                    if (itemType === 'Lost' && rowItemType !== 'Lost') return false;
                }

                // Status filter
                if (status) {
                    var statusMap = {
                        '0': 'Pending Review',
                        '1': 'Approved',
                        '2': 'Sent Back',
                        '3': 'Rejected',
                        '4': 'Closed',
                    };

                    if (rowStatus.toLowerCase().trim() !== statusMap[status].toLowerCase()) {
                    return false;
                }
        }

                // Date filter (basic implementation)
                if (dateFrom || dateTo) {
                     var rowDateObj = new Date(rowDate);
                     var fromDateObj = dateFrom ? new Date(dateFrom) : null;
                     var toDateObj = dateTo ? new Date(dateTo) : null;
                 
                     // Normalize all to midnight (ignore time part)
                     rowDateObj.setHours(0, 0, 0, 0);
                     if (fromDateObj) fromDateObj.setHours(0, 0, 0, 0);
                     if (toDateObj) toDateObj.setHours(0, 0, 0, 0);
                 
                     if (fromDateObj && rowDateObj < fromDateObj) return false;
                     if (toDateObj && rowDateObj > toDateObj) return false;
                }

                return true;
            });

            allRows = filteredRows;
            showPage(1);
        }

        function clearFilters() {
            $('#itemType').val('');
            $('#status').val('');
            $('#dateFrom').val('');
            $('#dateTo').val('');

            // Reset to all rows
            allRows = $('#tableBody tr').toArray();
            showPage(1);
        }
                  function showApproveModal(itemId) {
                  $('#approveItemId').val(itemId);
                  $('#approveRemarks').val('');
                  $('#approveModal').modal('show');
                   }

                  function showSendBackModal(itemId) {
                      $('#sendBackItemId').val(itemId);
                      $('#sendBackRemarks').val('');
                      $('#sendBackModal').modal('show');
                  }

            function approveItem() {
            var itemId = $('#approveItemId').val();
            var remarks = $('#approveRemarks').val().trim();

            if (!itemId) {
                alert("Invalid item selected.");
                return;
            }

            $.ajax({
                url: '@Url.Action("ApproveItem", "LostAndFound")', 
                type: 'POST',
                data: {
                    id: itemId,
                    securityRemarks: remarks
                },
                success: function (response) {
                    if (response.success) {
                        $('#approveModal').modal('hide');
                         swal({
                         title: "Success",
                         text: "Item approved successfully.",
                         type: "success"
                     }, function () {
                         location.reload();
                     });
                    } else {
                        alert('Error: ' + (response.message || 'Failed to approve item.'));
                    }
                },
                error: function () {
                    alert('Error: Something went wrong while approving the item.');
                }
            });
        }




          function submitReject() {
            var itemId = $('#rejectItemId').val();
            var remarks = $('#rejectRemarks').val().trim();

            if (!remarks) {
                alert('Please provide remarks for rejecting the item.');
                return;
            }

            $.ajax({
                url: '@Url.Action("RejectItem", "LostAndFound")',
                type: "POST",
                data: {
                    id: itemId,
                    securityRemarks: remarks
                },
                success: function (response) {
                    if (response.success) {
                        $('#rejectModal').modal('hide');
                        $('#rejectRemarks').val("");
                           swal({
                            title: "Success",
                            text: "Item Reject successfully.",
                            type: "success"

                      }, function () {
                         location.reload();
                     });
                    } else {
                        alert('Error: ' + (response.message || 'Failed to reject the item.'));
                    }
                },
                error: function () {
                    alert('Error: Something went wrong while rejecting the item.');
                }
                });
            }

        function showRejectModal(itemId) {
            $('#rejectItemId').val(itemId);
            $('#rejectRemarks').val('');
            $('#rejectModal').modal('show');
            
        }

        function submitSendBack() {
            var itemId = $('#sendBackItemId').val();
            var remarks = $('#sendBackRemarks').val().trim();

            if (!remarks) {
                alert('Please provide remarks for sending back the item.');
                return;
            }

            $.ajax({
                url: "/LostAndFound/SendBackItem",
                type: "POST",
                data: {
                    id: itemId,
                    securityRemarks: remarks
                },
                success: function (response) {
                    if (response.success) {
                        $('#sendBackModal').modal('hide');
                                swal({
                                title: "Success",
                                text: "Item Send Back successfully.",
                                type: "success"
                            }, function () {
                         location.reload();
                     });
                    } else {
                        alert('Error: ' + (response.message || 'Failed to send back item'));
                    }
                },
                error: function () {
                    alert('Error: Failed to send back item');
                }
            });
        }


        function showClaimedModal(itemId) {
            $('#closeItemId').val(itemId);
            $('#employeeName').val('');
            $('#closeByEmpCode').val('');
            $('#verificationDetails').val('');
            $('#closeModal').modal('show');
        }
        function rejectItem(itemId) {
            if (confirm('Are you sure you want to reject this item?')) {
                $.ajax({
                    url: "/LostAndFound/RejectItem",
                    type: "POST",
                    data: { id: itemId },
                    success: function (response) {
                        if (response.success) {
                            location.reload();
                                swal({
                                    title: "Success",
                                    text: "Item Reject successfully.",
                                    type: "success"
                                
                                });
                        } else {
                            alert('Error: ' + (response.message || 'Failed to reject item'));
                        }
                    },
                    error: function () {
                        alert('Error: Failed to reject item');
                    }
                });
            }
        }

        function submitClaimed() {
            var itemId = $('#closeItemId').val();
            var selectedOption = $('input[name="radioOption"]:checked').val();

            var closeBy = "";
            var closeByEmpCode = "";
            var verificationDetails = "";
            var companyName = null;
            var empType = null;

            if (selectedOption === "HMSI Associate") {
                closeByEmpCode = $('#closeByEmpCode').val().trim();
                closeBy = ($('#employeeName').val() || '').trim();
                verificationDetails = $('#hmsiFields #verificationDetails').val().trim();
                empType = 1;

                if (!closeByEmpCode) {
                    alert("Employee code is required.");
                    return;
                }
                if (!employeeName) { alert('Please enter a valid employee code to retrieve employee details.'); return; }
                if (!verificationDetails) {
                    alert("Verification details are required.");
                    return;
                }
            } else if (selectedOption === "Other") {
                closeBy = ($('#employeeNameOther').val() || '').trim();
                companyName = ($('#companyName').val() || '').trim();
                verificationDetails = $('#otherFields #verificationDetails').val().trim();
                empType = 2;

                if (!closeBy) {
                    alert("Employee name is required.");
                    return;
                }
                if (!companyName) {
                    alert("Company name is required.");
                    return;
                }
                if (!verificationDetails) {
                    alert("Verification details are required.");
                    return;
                }
            }

            $.post('@Url.Action("CloseItem", "LostAndFound")', {
                id: itemId,
                closeItemBy: closeBy,
                closeByEmpCode: closeByEmpCode,
                verificationDetails: verificationDetails,
                companyName: companyName,
                empType: empType
            })
            .done(function (response) {
                if (response.success) {
                    $('#closeModal').modal('hide');
                          swal({
                           title: "Success",
                           text: "Item close successfully.",
                           type: "success"
                         }, function () {
                         location.reload();
                     });
                } else {
                    alert('Error: ' + (response.message || 'Failed to mark item as close'));
                }
            })
            .fail(function () {
                alert('Error: Failed to mark item as close');
            });
        }

    </script>
}
