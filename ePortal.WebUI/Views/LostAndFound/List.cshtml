@model List<ePortal.ViewModels.LostAndFoundViewModel>
@using ePortal.DomainClasses.Enums
@{
    ViewBag.Title = "All Lost & Found Items";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles
{
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">

        .empty-state {
            padding: 15px !important;
            text-align: center;
        }

            .empty-state p {
                font-size: 16px;
                padding: 11px 0;
            }

            .empty-state h4 {
                font-size: 22px;
                font-weight: 500;
            }

        .empty-state {
            background: #ffffff1c;
            border: 1px dashed #cfcfcf;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border-radius: 10px;
        }

            .empty-state a {
                margin: 0;
                font-size: 14px;
                background: #28a745;
                padding: 10px 15px;
            }

        /* Page title bar */
        .page-title-bar {
        background: #0073e6;
        color: #fff;
        padding: 15px 20px;
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 20px;
        border-radius: 5px;
        }

        .page-title-bar .subtitle {
        display: block;
        font-size: 14px;
        font-weight: normal;
        margin-top: 5px;
        }

        /* Action buttons */
        .action-buttons {
        margin-bottom: 20px;
        }

        .btn-primary {
        background: #0073e6;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        color: white;
        text-decoration: none;
        display: inline-block;
        margin-right: 10px;
        }

        .btn-primary:hover {
        background: #0056b3;
        color: white;
        text-decoration: none;
        }

        .btn-secondary {
        background: #6c757d;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        color: white;
        text-decoration: none;
        display: inline-block;
        margin-right: 10px;
        }

        .btn-secondary:hover {
