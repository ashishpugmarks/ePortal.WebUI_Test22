        font-size: 12px;
        font-weight: 500;
        }

        .status-pending {
        background: #fff3cd;
        color: #856404;
        }

        .status-approved {
        background: #d4edda;
        color: #155724;
        }

        .status-sendback {
        background: #ffeaa7;
        color: #d63031;
        }

        .status-rejected {
        background: #f8d7da;
        color: #721c24;
        }

        .status-close {
        background: #cce5ff;
        color: #004085;
        }

        .status-expired {
        background: #e9ecef;
        color: #6c757d;
        }

        .status-closed {
        background: #d1ecf1;
        color: #0c5460;
        }

        /* Item type badges */
        .item-type-badge {
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 500;
        }

        .type-found {
        background: #d1ecf1;
        color: #0c5460;
        }

        .type-lost {
