<div class="panel-body p15">
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-dismiss="alert"></button>
    </div>
}

<!-- Summary Statistics -->
<div class="stats-container">
    <div class="stat-card">
        <div class="stat-number">@(Model?.Count ?? 0)</div>
        <div class="stat-label">Total Items</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@(Model?.Count(x => x.Status == 0) ?? 0)</div>
        <div class="stat-label">Pending Items</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@(Model?.Count(x => x.Status == 1) ?? 0)</div>
        <div class="stat-label">Approved Items</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@(Model?.Count(x => x.Status == 4) ?? 0)</div>
                    <div class="stat-label">Closed Items</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@(Model?.Count(x => x.ItemType == LostAndFoundItemType.Found) ?? 0)</div>
        <div class="stat-label">Found Items</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@(Model?.Count(x => x.ItemType == LostAndFoundItemType.Lost) ?? 0)</div>
        <div class="stat-label">Lost Items</div>
    </div>
</div>

<!-- Filter Section -->
<div class="filter-section">
    <h5><i class="fas fa-filter"></i> Filter Items</h5>
    <form method="get" id="filterForm">
        <div class="filter-row">
            <div class="filter-group">
                <label for="itemType">Item Type</label>
                <select id="itemType" name="itemType" class="form-control">
                    <option value="">All Types</option>
                    <option value="Found">Found</option>
                    <option value="Lost">Lost</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="status">Status</label>
                <select id="status" name="status" class="form-control">
                    <option value="">All Status</option>
                    <option value="0">Pending</option>
                    <option value="1">Approved</option>
                    <option value="2">Send Back</option>
                    <option value="3">Rejected</option>
                    <option value="4">Closed</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="dateFrom">Lost/Found Date From</label>
                <input type="date" id="dateFrom" name="dateFrom" class="form-control" />
            </div>
            <div class="filter-group">
                <label for="dateTo">Lost/Found Date To</label>
                <input type="date" id="dateTo" name="dateTo" class="form-control" />
            </div>
            <div class="filter-actions">
                <button type="button" class="btn-filter" id="btnFilter">
                    <i class="fas fa-search"></i> Search
                </button>
                <button type="button" class="btn-clear" id="clearFiltersBtn">
                    <i class="fas fa-times"></i> Clear
                </button>
                            <button type="button" class="btn-export" id="exportToExcel">
                    <i class="fas fa-times"></i> Export Excel
                </button>
            </div>
        </div>
    </form>
</div>

<div class="table-container">
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table" id="lostFoundTable">
                <thead>
                    <tr>
                        <th style="cursor: pointer;"><div class="header-flex">Item Type <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"><div class="header-flex">Product Name <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"><div class="header-flex">Location <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"><div class="header-flex">Lost/Found Date <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"><div class="header-flex">Status <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"><div class="header-flex">Reported By <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"><div class="header-flex">Created Date <i class="fa fa-sort"></i></div></th>
                        @if (ViewBag.IsSecurityPersonnel == true)
                        {
                            <th>Security Actions</th>
                        }
                        <th>View</th>
                        <th>Edit</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="item-type-badge @(item.ItemType == LostAndFoundItemType.Found ? "type-found" : "type-lost")">
                                    @(item.ItemType.ToString())
                                </span>
                            </td>
                            <td>
                                <strong>@(item.ProductName ?? "N/A")</strong>
                                @if (!string.IsNullOrEmpty(item.MarkDescription))
                                {
                                    <br />
                                    <small class="text-muted">@item.MarkDescription</small>
                                }
                            </td>
                            <td>
                                @{
                                       @(item.location)
                                   // @(ViewBag.UserLocationName ?? "Unknown Location")
                                }
                            </td>
                            <td>@item.DateFound.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="status-badge @item.StatusClass">@item.StatusText</span>
                            </td>
                            <td>
                                @(item.ReportedBy ?? item.CreatedByName ?? "N/A")
                            </td>
                            <td>@item.CreatedDate.ToString("MMM dd, yyyy")</td>
                            @if (ViewBag.IsSecurityPersonnel == true)
                            {
                                <td>
                                    <div class="security-actions">
                                        @{
                                            var status = item.Status;
                                        }
                                        @switch (status)
                                        {
                                            case ePortal.DomainClasses.LostAndFoundStatus.Pending:
                                                <button class="btn-approve" data-item-id="@item.Id" data-action="approve">Approve</button>
                                                <button class="btn-sendback" data-item-id="@item.Id" data-action="sendback">Send Back</button>

                                                break;
                                            case ePortal.DomainClasses.LostAndFoundStatus.Approved:
                                                <button class="btn-close" data-item-id="@item.Id" data-action="close">Close</button>

                                                break;
                                            case ePortal.DomainClasses.LostAndFoundStatus.SendBack:
                                                if (item.IsResubmit == 0)
                                                {
                                                    <button class="btn-approve" data-item-id="@item.Id" data-action="approve">Approve</button>
                                                    <button class="btn-sendback" data-item-id="@item.Id" data-action="sendback">Send Back</button>
                                                }
                                                else
                                                {
                                                    <button class="btn-approve disabled" disabled  data-item-id="@item.Id" data-action="approve" disabled>Approve</button>
                                                    <button class="btn-sendback disabled" disabled data-item-id="@item.Id" data-action="sendback" disabled>Send Back</button>
                                                }
                                                break;
                                                        case ePortal.DomainClasses.LostAndFoundStatus.Closed:
                                                <button class="btn-close disabled" data-item-id="@item.Id" disabled data-action="close">Close</button>
                                                break;

                                            case ePortal.DomainClasses.LostAndFoundStatus.Rejected:
                                                <button class="btn-approve disabled" data-item-id="@item.Id" data-action="approve">Approve</button>
                                                <button class="btn-sendback disabled" data-item-id="@item.Id" data-action="sendback">Send Back</button>
                                                break;
                                        }
                                    </div>
                                </td>
                            }
                            <td class="view-icon">
                                <a href="@Url.Action("Details", "LostAndFound", new { id = item.Id })" class="action-link">
                                    <span class="glyphicon glyphicon-eye-open text-warning" aria-hidden="true"></span> 
                                </a>                               
                            </td>
                            <td class="view-icon">
                                @if (item.Status == ePortal.DomainClasses.LostAndFoundStatus.Pending)
                                {
                                    <a href='@Url.Action("EditItem", "LostAndFound", new { id = item.Id })' class="action-link">
                                        <span class="glyphicon glyphicon-pencil text-primary" aria-hidden="true"></span> 
                                    </a>
                                }
                                else
                                {
                                    <a href="javascript:void(0);" class="action-link disabled-icon" style="pointer-events:none; opacity:0.5;">
                                        <span class="glyphicon glyphicon-pencil text-primary" aria-hidden="true"></span> 
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="text-center" style="margin-top: 20px;">
            <ul class="pagination justify-content-center" id="pagination"></ul>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-search"></i>
            <h4>No Items Found</h4>
            <p>There are currently no lost and found items to display.</p>
            <a href="@Url.Action("AddItem", "LostAndFound")" class="btn-primary">
                <i class="fas fa-plus"></i> Add First Item
            </a>
        </div>
    }
</div>

        </div>

</div>
</div>

