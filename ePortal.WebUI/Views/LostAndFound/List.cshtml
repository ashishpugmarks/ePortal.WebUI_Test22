}



<div class="panel-group" style="padding: 0px 8px 0px 8px;">

    <div class="panel panel-primary panel-2">
        <div class="align-items-center d-flex justify-content-between p10 panel-heading custom-panel-heading mh-42">
            <h2 class="panel-title"> Lost and Found Showing items for: <strong>@ViewBag.UserLocationName</strong></h2>
            </div>

@* @if (!string.IsNullOrEmpty(ViewBag.UserLocationName) && ViewBag.UserLocationName != "All Locations")
{
    <div class="location-indicator" style="background: #e3f2fd; border: 1px solid #2196f3; border-radius: 5px; padding: 10px 15px; margin-bottom: 20px; display: flex; align-items: center;">
        <i class="fas fa-map-marker-alt" style="color: #2196f3; margin-right: 8px;"></i>
        <span style="color: #1976d2; font-weight: 500;"></span>
