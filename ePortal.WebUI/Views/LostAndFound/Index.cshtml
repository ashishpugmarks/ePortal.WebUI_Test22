@section Scripts {
<script nonce="@Context.Items["ScriptNonce_1"]">
    var allRows = [];
    var currentPage = 1;
    var rowsPerPage = 20;

         $(document).ready(function () {
                // Check if user already accepted
                if (!sessionStorage.getItem('caveatAcceptedindex')) {

                    // Show modal only first time
                    $('#caveatModal').modal({
                        backdrop: 'static',
                        keyboard: false
                    });

                    $('#acceptBtn').click(function () {
                            sessionStorage.setItem('caveatAcceptedindex', 'true'); // mark as accepted
                        $('#caveatModal').modal('hide');
                    });
                }
            });

    // Initialization function for sorting and pagination
    function initTable() {
        allRows = $('#tableBody tr').toArray();
        currentPage = 1;

        // Unbind previous handlers before rebinding
        $("#lostFoundTable th").off('click').on('click', function () {
            if ($(this).find('i.fa-sort').length > 0) {
                var table = $(this).parents("table").eq(0);
                var rows = table.find("tbody tr").toArray().sort(comparer($(this).index()));
                this.asc = !this.asc;
                if (!this.asc) { rows = rows.reverse(); }
                $('#tableBody').empty().append(rows);
                allRows = rows;
                showPage(1);
            }
        });

        showPage(1);
    }

    $(document).ready(function () {
        initTable();

             $(document).on("click", ".cancel-btn", function(e) {
                    e.preventDefault();
                    var id = $(this).data("id");
                    var row = $(this).closest("tr");
                    if (!confirm("Are you sure you want to cancel this request?")) {
                        return;
                    }

                    $.ajax({
                        url: '@Url.Action("CancelRequest", "LostAndFound")',
                        type: "POST",
                        data: { id: id },
                        success: function(response) {

                            if (response.sessionExpired) {
                            alert(response.message);
                             window.location.href = '@Url.Action("Index", "Login")';
                             return;
                                  }
                            if (response.success) {
                                alert(response.message);
                                row.fadeOut(400, function () {
                                $(this).remove();
                    });
                            } else {

                                alert(response.message);
                            }
                        },
                        error: function() {

                            alert("Something went wrong. Please try again.");
                        }
                    });
                });
    });

    // Sorting helper functions
    function comparer(index) {
        return function (a, b) {
            var valA = getCellValue(a, index), valB = getCellValue(b, index);
            return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB);
        }
    }

    function getCellValue(row, index) {
        return $(row).children("td").eq(index).text();
    }

    // Pagination functions
    function showPage(page) {
        currentPage = page;
        var startIndex = (page - 1) * rowsPerPage;
        var endIndex = startIndex + rowsPerPage;

        $('#tableBody tr').hide();
        for (var i = startIndex; i < endIndex && i < allRows.length; i++) {
            $(allRows[i]).show();
        }
        updatePagination();
    }

    function updatePagination() {
        var totalPages = Math.ceil(allRows.length / rowsPerPage);
        var pagination = $('#pagination');
        pagination.empty();

        if (totalPages <= 1) {
            pagination.hide();
            return;
        }

        pagination.show();

        if (currentPage > 1) {
            var prevItem = $('<li class="page-item"><a class="page-link" href="javascript:void(0);">Previous</a></li>');
            prevItem.find('a').click(function () {
                showPage(currentPage - 1);
            });
            pagination.append(prevItem);
        }

        for (var i = 1; i <= totalPages; i++) {
            var listItem = $('<li></li>').addClass('page-item');
            var link = $('<a></a>').addClass('page-link').attr('href', 'javascript:void(0);').text(i);

            if (i === currentPage) {
                listItem.addClass('active');
            }

            (function (pageNum) {
                link.click(function () {
                    showPage(pageNum);
                });
            })(i);

            listItem.append(link);
            pagination.append(listItem);
        }

        if (currentPage < totalPages) {
            var nextItem = $('<li class="page-item"><a class="page-link" href="javascript:void(0);">Next</a></li>');
            nextItem.find('a').click(function () {
                showPage(currentPage + 1);
            });
            pagination.append(nextItem);
        }
    }
</script>
}
