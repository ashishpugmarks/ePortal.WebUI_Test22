                }

        li.page-item.active:hover a {
            color: #000 !important;
        }

        .d-flex {
            display: flex;
        }

        .justify-content-between {
            justify-content: space-between;
        }

        .mb-0 {
            margin: 0;
        }

        .p15 {
            padding: 15px !important;
        }

        .align-items-center {
            align-items: center;
        }

        .panel-2 .panel-heading {
            padding: 3px 15px !important;
            background: #80a9ea;
        }

        .panel-2 {
            border-color: #80a9ea;
        }
        /* CAVEAT start */
