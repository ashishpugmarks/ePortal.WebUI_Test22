@model List<ePortal.ViewModels.LostAndFoundViewModel>
@{
    ViewBag.Title = "Lost & Found Items";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles
{

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        /* Page title bar */
        .empty-state {
            padding: 15px !important;
            text-align: center;
        }

            .empty-state p {
                font-size: 16px;
                padding: 11px 0;
            }

            .empty-state h4 {
                font-size: 22px;
                font-weight: 500;
            }

        .empty-state {
            background: #ffffff1c;
            border: 1px dashed #cfcfcf;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border-radius: 10px;
        }

            .empty-state a {
