<div class="container-fluid row-margin">
    <input type="hidden" id="PreviousUrl" value="@ViewBag.PreviousUrl" />

    <div class="form-section align-setting">
        <h5>Edit Lost and Found Information</h5>
    </div>

    <!-- Edit Item Form -->
    <div class="row align-setting">
        <div class="col-12">
            <div class="form-container left-space">

                <form id="editItemForm">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Id)

                    <div class="form-section">
                        <div class="row">
                            <div class="col-md-4 space-box">
                                <div class="form-group">
                                    <label for="ItemType" class="required-field">Item Type <span class="required-field">*</span></label>
                                    <select class="form-control" id="ItemType" name="ItemType" required>
                                        <option value="">-- Select Item Type --</option>
                                        <option value="1" selected="@(Model.ItemType == LostAndFoundItemType.Found)">Found</option>
                                        <option value="2" selected="@(Model.ItemType == LostAndFoundItemType.Lost)">Lost</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-4 space-box">
                                <div class="form-group">
                                    <label for="DateFound" class="required-field">Date <span class="required-field">*</span></label>
                                    <input type="date" class="form-control" id="DateFound" name="DateFound"
                                           value="@Model.DateFound.ToString("yyyy-MM-dd")" required>
                                </div>
                            </div>

                            <div class="col-md-4 space-box">
                                <div class="form-group">
                                    <label for="ProductName" class="required-field">Item Name <span class="required-field">*</span></label>
                                    <input type="text" class="form-control" id="ProductName" name="ProductName"
                                           value="@Model.ProductName"
                                           placeholder="e.g., Water Bottle, Mobile Phone, Keys" required>
                                </div>
                            </div>

                            <div class="col-md-4 space-box">
                                <div class="form-group">
                                    <label for="MarkDescription" class="required-field">Mark <span class="required-field">*</span></label>
                                    <input type="text" class="form-control" id="MarkDescription" name="MarkDescription"
                                           value="@Model.MarkDescription"
                                           placeholder="e.g., Silver color, Brand name, Size" required>
                                </div>
                            </div>

                            <div class="col-md-4 space-box">
                                <div class="form-group">
                                    <label for="MaterialType" class="required-field">Material Type <span class="required-field">*</span></label>
                                    <input type="text" class="form-control" id="MaterialType" name="MaterialType"
                                           value="@Model.MaterialType"
                                           placeholder="e.g., Plastic, Metal, Fabric, Glass" required>
                                </div>
                            </div>
                            <div class="col-md-4 space-box">
                                <div class="form-group">
                                    <label for="LocationFound" class="required-field">Location <span class="required-field">*</span></label>
                                    <select id="LocationFound" name="LocationFound" class="form-control" required>
                                        <option value="">-- Select Location --</option>
                                        @foreach (var location in Model.LocationOptions)
                                        {
                                            if (Model.LocationFound == location.Value)
                                            {
                                                <option value="@location.Value" selected="selected">@location.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@location.Value">@location.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>


                            <div class="col-md-12 space-box">
                                <div class="form-group">
                                    <label for="AdditionalDetails" class="required-field">Additional Details </label>
                                    <textarea class="form-control" id="AdditionalDetails" name="AdditionalDetails" rows="3"
                                              placeholder="Any additional information that might help identify the item">@Model.AdditionalDetails</textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section second-box">
                        <h5><i class="fa fa-camera"></i> Item Photo</h5>
                        <p class="image-upload-alert">Upload up to 2 images (Max size: 2 MB per image).</p>
                        <div class="row upload-box @(string.IsNullOrEmpty(Model.ItemPhotoPath) ? "" :"after-upload")">
                            <div class="col-md-12 col-box">
                                <div class="photo-upload" id="photoUpload" style="@(string.IsNullOrEmpty(Model.ItemPhotoPath) ? "" : "display:none;")">
                                    <i class="fa fa-cloud-upload"></i>
                                    <div class="upload-text">
                                        <p><strong>Click to upload a photo</strong></p>
                                        <p>Upload a clear photo of the item for better identification</p>
                                    </div>
                                    <input type="file" id="ItemPhoto" name="ItemPhoto" accept="image/*" multiple style="display: none;" />
                                    <button type="button" class="btn btn-outline-primary" id="choosePhotoBtn">
                                        <i class="fa fa-upload"></i> Choose Photo
                                    </button>
                                </div>

                                <div id="photoPreview" style="@(photos.Any() ? "display:block; text-align:center;" : " text-align:center; display:none;")">
                                    <div id="previewContainer" class="d-flex flex-wrap justify-content-center">
                                        @foreach (var photo in photos)
                                        {
                                            var fileName = System.IO.Path.GetFileName(photo);
                                            <div class="test">
                                            <img src="@Url.Action("GetImage", "LostAndFound", new { fileName })"
                                                 class="photo-preview"
                                                 data-full="@Url.Action("GetImage", "LostAndFound", new { fileName })" />
                                            </div>
                                        }
                                    </div>
                                    <br />
                                    <button type="button" class="btn btn-sm btn-outline-danger mt-2" id="removePhotoBtn">
                                        <i class="fa fa-trash"></i> Remove Photo
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="action-bar text-right">
                        <a href="@(string.IsNullOrEmpty(ViewBag.PreviousUrl) ? "/LostAndFound/Index" : ViewBag.PreviousUrl)" class="btn btn-secondary-custom">
                            <i class="fa fa-arrow-left"></i> Back
                        </a>
                        <button type="button" class="btn btn-security" id="updateItemBtn">
                            <i class="fa fa-save"></i> Update
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="imageModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-body text-center">
                <img id="modalImage" src="" class="img-fluid" style="max-height: 80vh;" />
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script nonce="@Context.Items["ScriptNonce_0"]">
        $(document).on("click", ".photo-preview", function () {
            const imgSrc = $(this).data("full") || $(this).attr("src");
            $("#modalImage").attr("src", imgSrc);
            $("#imageModal").modal("show");
        });
        $(document).ready(function () {
            $("#LocationFound").select2({
                placeholder: "-- Select Location --",
                allowClear: true,
                width: '100%' // ensures it matches bootstrap form-control width
            });
            // Same preview/remove logic as Add form
            // Handle photo upload preview
            $('#ItemPhoto').change(function () {
                const files = this.files;

                // 🔹 Max 2 file limit
                if (files.length > 2) {
                    sweetAlert("Limit Exceeded", "You can upload a maximum of 2 images only.", "warning");
                    $(this).val(''); // clear selection
                    return;
                }

                const previewContainer = $('#previewContainer');
                previewContainer.empty(); // clear old previews

                // 🔹 If no files, reset view
                if (files.length === 0) {
                    $('#photoUpload').show();
                    $('#photoPreview').hide();
                    return;
                }

                let validFiles = [];

                // 🔹 Validate each file
                Array.from(files).forEach(file => {
                    if (!file.type.startsWith('image/')) {
                        sweetAlert("Invalid File", `${file.name} is not an image file. Please select only images.`, "warning");
                    } else if (file.size > 2 * 1024 * 1024) {
                        sweetAlert("File Too Large", `${file.name} is larger than 2 MB. Please upload a smaller file.`, "warning");
                    } else {
                        validFiles.push(file);
                    }
                });

                // 🔹 If all invalid, clear selection
                if (validFiles.length === 0) {
                    $(this).val('');
                    $('#photoUpload').show();
                    $('#photoPreview').hide();
                    return;
                }

                // 🔹 Show preview for valid images only
                $('#photoUpload').hide();
                $('#photoPreview').show();

                validFiles.forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const img = $('<img>')
                            .attr('src', e.target.result)
                            .addClass('photo-preview');
                        previewContainer.append(img);
                    };
                    reader.readAsDataURL(file);
                });
            });

            $('#removePhotoBtn').click(function () {
                $('#ItemPhoto').val('');
                $('#previewContainer').empty();
                $('#photoUpload').show();
                $('#photoPreview').hide();
            });

            $('#updateItemBtn').click(function () {
                let isValid = true;
                const requiredFields = [
                    'ItemType',
                    'DateFound',
                    'ProductName',
                    'LocationFound',
                    'MarkDescription',
                    'MaterialType'
                ];

                requiredFields.forEach(function (field) {
                    const value = $('#' + field).val();
                    if (!value || value.trim() === '') {
                        $('#' + field).addClass('is-invalid');
                        isValid = false;
                    } else {
                        $('#' + field).removeClass('is-invalid');
                    }
                });

                if (!isValid) {
                    alert('Please fill in all required fields marked with *.');
                    return;
                }

                const $submitBtn = $(this);
                $submitBtn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Updating...');

                // const formData = new FormData($('#editItemForm')[0]);
                // const files = $('#ItemPhoto')[0].files;
                // for (let i = 0; i < files.length; i++) {
                //     formData.append('ItemPhoto', files[i]);
                // }

                const formData = new FormData();

                $('#editItemForm').serializeArray().forEach(function (field) {
                    formData.append(field.name, field.value);
                });

                const files = $('#ItemPhoto')[0].files;
                for (let i = 0; i < files.length; i++) {
                    formData.append('ItemPhoto', files[i]);
                }

                $.ajax({
                    url: '@Url.Action("EditItem", "LostAndFound")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    timeout: 30000,
                    success: function (response) {
                        if (response.success) {
                            swal({
                                title: "Updated",
                                text: "Item updated successfully.",
                                type: "success"

                            }, function () {
                                var previousUrl = $('#PreviousUrl').val();
                                if (!previousUrl || previousUrl === "") {
                                    previousUrl = "/LostAndFound/Index";
                                }
                                window.location.href = previousUrl;

                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to update item.'
                            });
                            $submitBtn.prop('disabled', false).html('<i class="fa fa-save"></i> Update');
                        }
                    },
                    error: function (xhr, status, error) {
                        let errorMessage = 'Something went wrong! Please try again.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        } else if (status === 'timeout') {
                            errorMessage = 'Request timed out. Please check your connection.';
                        } else if (xhr.status === 0) {
                            errorMessage = 'Network error. Please check your internet connection.';
                        }
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: errorMessage
                        });
                        $submitBtn.prop('disabled', false).html('<i class="fa fa-save"></i> Update');
                    }
                });
            });


            // Form validation
            // $('#editItemForm').submit(function (e) {
            //     let isValid = true;
            //     const requiredFields = [
            //     'ItemType',
            //     'DateFound',
            //     'ProductName',
            //     'LocationFound',
            //     'MarkDescription',
            //     'MaterialType'
            // ];

            //     requiredFields.forEach(function (field) {
            //         const value = $('#' + field).val();
            //         if (!value || value.trim() === '') {
            //             $('#' + field).addClass('is-invalid');
            //             isValid = false;
            //         } else {
            //             $('#' + field).removeClass('is-invalid');
            //         }
            //     });

            //     if (!isValid) {
            //         e.preventDefault();
            //         alert('Please fill in all required fields marked with *.');
            //         return false;
            //     }

            //     $('button[type="submit"]').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Updating...');
            // });

            $('input, select, textarea').on('input change', function () {
                $(this).removeClass('is-invalid');
            });

            $("#choosePhotoBtn").on("click", function () {
                $("#ItemPhoto").click();
            });
        });
    </script>
}
