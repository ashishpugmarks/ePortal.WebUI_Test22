@model ePortal.ViewModels.LostAndFoundViewModel
@using Newtonsoft.Json
@using ePortal.DomainClasses.Enums
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewBag.Title = "Edit Item - Lost & Found";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var photos = new List<string>();
    if (!string.IsNullOrEmpty(Model.ItemPhotoPath))
    {
        var value = Model.ItemPhotoPath.Trim();

        // Case 1: JSON array format → ["img1.png","img2.png"]
        if (value.StartsWith("[") && value.EndsWith("]"))
        {
            photos = JsonConvert.DeserializeObject<List<string>>(value) ?? new List<string>();
        }
        // Case 2: Comma-separated or single string → img1.png,img2.png
        else
        {
            photos = value.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                          .Select(x => x.Trim())
                          .ToList();
        }
    }


}
