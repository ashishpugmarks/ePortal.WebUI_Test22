@model List<ePortal.ViewModels.LostAndFoundViewModel>

<div class="table-container">
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table" id="lostFoundTable">
                <thead>
                    <tr>
                        <th style="cursor: pointer;"> <div class="header-flex">Item Type <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"> <div class="header-flex">Product Name <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"> <div class="header-flex">Location Found <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"> <div class="header-flex">Date Found <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"> <div class="header-flex">Status <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"> <div class="header-flex">Reported By <i class="fa fa-sort"></i></div></th>
                        <th>View</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="item-type-badge @(item.ItemType.ToString().ToLower() == "found" ? "type-found" : "type-lost")">
                                    @(item.ItemType.ToString() ?? "Unknown")
                                </span>
                            </td>
                            <td>
                                <strong>@(item.ProductName ?? "N/A")</strong>
                                @if (!string.IsNullOrEmpty(item.MarkDescription))
                                {
                                    <br />
                                    <small class="text-muted">@item.MarkDescription</small>
                                }
                            </td>
                            <td>
                                @{

                                    @(ViewBag.UserLocationName ?? "Unknown Location")
                                }
                            </td>
                            <td>@item.DateFound.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (item.Status == 1)
                                {
                                    <span class="status-badge status-active">Active</span>
                                }
                                else if (item.Status == 2)
                                {
                                    <span class="status-badge status-claimed">Claimed</span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">Inactive</span>
                                }
                            </td>
                            <td>
                                @(item.ReportedBy ?? item.CreatedBy ?? "N/A")
                            </td>
                            <td>
                                <a href="@Url.Action("Details", "LostAndFound", new { id = item.Id })" class="action-link">
                                    <span class="glyphicon glyphicon-eye-open text-warning" aria-hidden="true"></span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-center" style="margin-top: 20px;">
            <ul class="pagination justify-content-center" id="pagination"></ul>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-search"></i>
            <h4>No Items Found</h4>
            <p>There are currently no lost and found items to display.</p>
            <a href="@Url.Action("AddItem", "LostAndFound")" class="btn-primary">
                <i class="fas fa-plus"></i> Add First Item
            </a>
        </div>
    }
</div>

@section Scripts
{
    <script nonce="@Context.Items["ScriptNonce_1"]">
        var allRows = [];
        var currentPage = 1;
        var rowsPerPage = 20;

        $(document).ready(function() {
            // Store all table rows
            allRows = $('#tableBody tr').toArray();

            // Initialize sorting functionality
            $("#lostFoundTable th").click(function () {
                if ($(this).find('i.fa-sort').length > 0) {
                    var table = $(this).parents("table").eq(0);
                    var rows = table.find("tbody tr").toArray().sort(comparer($(this).index()));
                    this.asc = !this.asc;
                    if (!this.asc) { rows = rows.reverse(); }

                    // Clear and re-append sorted rows
                    $('#tableBody').empty();
                    for (var i = 0; i < rows.length; i++) {
                        $('#tableBody').append(rows[i]);
                    }

                    // Update allRows with new order
                    allRows = rows;

                    // Re-apply pagination
                    showPage(1);
                }
            });

            // Auto-hide alerts after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Initialize pagination
            setTimeout(function() {
                showPage(1);
            }, 100);

             $('#showMyRequest').prop('checked', '@(ViewBag.ShowMyRequest?.ToString().ToLower() ?? "false")' === 'true');

             $('#showMyRequest').on('change', function () {
                 var showMyRequest = this.checked;

                 $.ajax({
                     url: '@Url.Action("IndexPartial", "LostAndFound")',
                     data: { showMyRequest: showMyRequest },
                     type: 'GET',
                     success: function (result) {
                         $('#lostAndFoundList').html(result);
                     },
                     error: function () {
                         alert('Failed to load data');
                     }
                 });
             });
           });

        // Sorting functions
        function comparer(index) {
            return function (a, b) {
                var valA = getCellValue(a, index), valB = getCellValue(b, index);
                return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB);
            }
        }

        function getCellValue(row, index) {
            return $(row).children("td").eq(index).text();
        }

        // Pagination functions
        function showPage(page) {
            currentPage = page;
            var startIndex = (page - 1) * rowsPerPage;
            var endIndex = startIndex + rowsPerPage;

            // Hide all rows
            $('#tableBody tr').hide();

            // Show only rows for current page
            for (var i = startIndex; i < endIndex && i < allRows.length; i++) {
                $(allRows[i]).show();
            }

            updatePagination();
        }

        function updatePagination() {
            var totalPages = Math.ceil(allRows.length / rowsPerPage);
            var pagination = $('#pagination');
            pagination.empty();

            if (totalPages <= 1) {
                pagination.hide();
                return;
            }

            pagination.show();

            // Previous button
            if (currentPage > 1) {
                var prevItem = $('<li class="page-item"><a class="page-link" href="javascript:void(0);">Previous</a></li>');
                prevItem.find('a').click(function() {
                    showPage(currentPage - 1);
                });
                pagination.append(prevItem);
            }

            // Page numbers
            for (var i = 1; i <= totalPages; i++) {
                var listItem = $('<li></li>').addClass('page-item');
                var link = $('<a></a>').addClass('page-link').attr('href', 'javascript:void(0);').text(i);

                if (i === currentPage) {
                    listItem.addClass('active');
                }

                (function(pageNum) {
                    link.click(function() {
                        showPage(pageNum);
                    });
                })(i);

                listItem.append(link);
                pagination.append(listItem);
            }

            // Next button
            if (currentPage < totalPages) {
                var nextItem = $('<li class="page-item"><a class="page-link" href="javascript:void(0);">Next</a></li>');
                nextItem.find('a').click(function() {
                    showPage(currentPage + 1);
                });
                pagination.append(nextItem);
            }
        }
    </script>
}
