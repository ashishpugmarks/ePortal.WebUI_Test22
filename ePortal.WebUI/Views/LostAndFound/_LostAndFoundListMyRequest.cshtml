@model List<ePortal.ViewModels.LostAndFoundViewModel>

<div class="table-container">
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table" id="lostFoundTable">
                <thead>
                    <tr>
                        <th style="cursor: pointer;"><div class="header-flex">Item Type <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"><div class="header-flex">Request<i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"><div class="header-flex">Product Name <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"><div class="header-flex">Location Found <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"><div class="header-flex">Date Found <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"><div class="header-flex">Status <i class="fa fa-sort"></i></div></th>
                        <th style="cursor: pointer;"><div class="header-flex">Reported By <i class="fa fa-sort"></i></div></th>
                        <th>View</th>
                        <th>Edit</th>
                        <th>Cancel</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="item-type-badge @(item.ItemType.ToString().ToLower() == "found" ? "type-found" : "type-lost")">
                                    @(item.ItemType.ToString() ?? "Unknown")
                                </span>
                            </td>
                            <td class="text-center">
                                @item.Id
                            </td>
                            <td>
                                <strong>@(item.ProductName ?? "N/A")</strong>
                                @if (!string.IsNullOrEmpty(item.MarkDescription))
                                {
                                    <br />
                                    <small class="text-muted">@item.MarkDescription</small>
                                }
                            </td>
                            <td>
                                @{

                                    @(item.location ?? "Unknown Location")
                                }
                            </td>
                            <td>@item.DateFound.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="status-badge @item.StatusClass"> @ePortal.DomainClasses.LostAndFoundStatus.GetStatusMyRequest(item.Status)</span>
                            </td>
                            <td>
                                @(item.ReportedBy ?? item.CreatedBy ?? "N/A")
                            </td>
                            <td class="view-icon">
                                <a href="@Url.Action("Details", "LostAndFound", new { id = item.Id })" class="action-link">
                                    <span class="glyphicon glyphicon-eye-open text-warning" aria-hidden="true"></span>
                                </a>
                            </td>
                            <td class="view-icon">
                                <a href="@Url.Action("EditItem", "LostAndFound", new { id = item.Id })"
                                   class="action-link @(item.Status == ePortal.DomainClasses.LostAndFoundStatus.Approved || item.Status == ePortal.DomainClasses.LostAndFoundStatus.Closed ? "disabled-icon" : "")" style="@(item.Status == ePortal.DomainClasses.LostAndFoundStatus.Approved || item.Status == ePortal.DomainClasses.LostAndFoundStatus.Closed ? "pointer-events:none; opacity:0.5;" : "")">
                                    <span class="glyphicon glyphicon-pencil text-primary" aria-hidden="true"></span>
                                </a>                               
                            </td>
                            <td class="view-icon">
                                <a href="@Url.Action("Cancel", "LostAndFound")"
                                   class="action-link cancel-btn @(item.Status == ePortal.DomainClasses.LostAndFoundStatus.Approved || item.Status == ePortal.DomainClasses.LostAndFoundStatus.Closed ? "disabled-icon" : "")" style="@(item.Status == ePortal.DomainClasses.LostAndFoundStatus.Approved || item.Status == ePortal.DomainClasses.LostAndFoundStatus.Closed ? "pointer-events:none; opacity:0.5;" : "")"
                                   data-id="@item.Id">
                                    <span class="glyphicon glyphicon-erase text-danger" aria-hidden="true"></span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-center" style="margin-top: 20px;">
            <ul class="pagination justify-content-center" id="pagination"></ul>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-search"></i>
            <h4>No Items Found</h4>
            <p>There are currently no lost and found items to display.</p>
            <a href="@Url.Action("AddItem", "LostAndFound")" class="btn-primary">
                <i class="fas fa-plus"></i> Add First Item
            </a>
        </div>
    }
</div>

