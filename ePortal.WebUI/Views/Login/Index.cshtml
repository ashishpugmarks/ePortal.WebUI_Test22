@using ePortal.Shared
@model ePortal.Web.Models.LoginViewModel

@{
    Layout = "";
}

<!doctype html>
<html>
<head>
    <title>Employee Portal</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="autocomplete" content="off">@*Added by Aumento for SR79131*@
    <link rel="stylesheet" href="~/lib/bootstrap5/css/bootstrap.min.css" />
    <link href="~/lib/bootstrap5/css/bootstrap-datepicker.css" rel="stylesheet" />
    <link href="~/css/owl.carousel.min.css" rel="stylesheet" />
