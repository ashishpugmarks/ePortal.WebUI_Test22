<body style="background-color:rgba(102,111,117,1)">
    <div class="login-wrap">
        <!-- header code start -->
        <div class="header-section">
            <div class="logo_img">
                <a href="#"><img src="images/honda_logo_white.png" alt="Honda" title="Honda" class="d-none d-sm-block" /></a>
                <a href="#"><img src="images/login_honda_logo.png" alt="Honda" title="Honda" class="d-block d-sm-none" /></a>
            </div>

            <div class="portal_login">
                <div class="portal_login_img">
                    <img src="images/login_box_icon_batch.png" alt="login_icon" title="login_icon" class="login_icon mob_login_icon" />
                </div>

                @using (Html.BeginForm("Index", "Login", FormMethod.Post, new { @id = "frmlogin", enctype = "multipart/form-data", name = "D1", autocomplete = "off" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="login_form">
                        @*Added by Aumento for SR79131*@
                        <input type="text" name="fakeuser" style="display:none" autocomplete="off" />
                        <input type="password" name="fakepassword" style="display:none" autocomplete="off" />
                        @*Added by Aumento for SR79131*@
                        <div class="input_wrap">
                            @Html.TextBoxFor(m => m.Loginid, new { @class = "form-control", @placeholder = "Login ID", autocomplete = "new-password", @id = "txtlogin", @name = "txtlogin", @type = "number" })@*Added by Aumento for SR79131*@
                            <label for="#loginId">Login ID</label>
                            <span></span>
                        </div>
                        <div class="input_wrap">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = "Password", autocomplete = "new-password", @id = "txtPassword", @name = "txtpassword" })@*Added by Aumento for SR79131*@
                            <label for="#password">Password</label>
                            <span></span>

                        </div>
                        <div class="input_wrap">
                            @Html.DropDownListFor(m => m.selectedusertype, Model.usertype, new { @class = "form-control newStyle", @id = "ddlusertype", @name = "ddlusertype" })
                            <label for="#loginId">User Type</label>
                            <a href='#' data-target="#pwdModal" data-toggle="modal" class="forgot" id="btnPwdModal">Forgot Password?</a>
                            <span></span>
                        </div>
                        @Html.HiddenFor(m => m.APIaddress, new { @id = "hdnapiaddress", @name = "hdnapiaddress" })
                        @*@Html.ActionLink("LOGIN", "Index", "Home", new { @class = "login" })*@
                        <input type="button" value="Login" class="login" name="btnlogin" id="btnlogin" />
                    </div>

                }

            </div>
        </div>
        <!-- header code end -->

        <div class="clear-both">
        </div>
        <div class="content">
            <!-- left carousel code start -->
