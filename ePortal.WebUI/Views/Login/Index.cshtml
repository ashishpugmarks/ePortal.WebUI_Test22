                    <div id="owlLeftTop" class="owl-carousel owl-theme">
                        @foreach (var obj in Model.ContentList)
                        {
                            var base64 = Convert.ToBase64String(obj.BANNER);
                            var imgSrc = String.Format("data:" + obj.BANNER_CONTENTTYPE + ";base64,{0}", base64);
                            <div>
