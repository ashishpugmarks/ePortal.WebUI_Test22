    <!-- Scripts inclusion -->
    <script src="~/js/jquery.2.1.3.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.min.js"></script>
    @*<script src="~/js/video.min.js"></script>*@
    <script src="~/js/owl.carousel.js"></script>
    <script src="~/js/jquery.mCustomScrollbar.concat.min.js"></script>
    @*<script src="~/js/carousel.js"></script>*@
    <script src="~/js/bootbox.min.js"></script>
    <script src="~/js/moment.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script>

    <script nonce="@Context.Items["ScriptNonce_2"]">
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1; //January is 0!

        var yyyy = today.getFullYear();
        if (dd < 10) {
            dd = '0' + dd;
        }
        if (mm < 10) {
            mm = '0' + mm;
        }
        var today = dd + '/' + mm + '/' + yyyy;
        $('.input-group.date').datepicker({
            //format: "yyyy/mm/dd",
            format: "dd-M-yyyy",
            //startDate: "2012-01-01",
            endDate: today, //"2015-01-01",
            todayBtn: "linked",
            autoclose: true,
            todayHighlight: true
        });
    </script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_1"]">
        $(document).keypress(function (event) {
            var keycode = (event.keyCode ? event.keyCode : event.which);
            bootbox.hideAll();
            if (keycode == '13' && (event.target.nodeName == 'BODY' || event.target.name == 'Loginid' || event.target.name == 'Password')) {
                event.cancelBubble = true;
                event.returnValue = false;
                $("#btnlogin").trigger('click');
                //event.stopPropagation();
            }
        });

        $(document).ready(function () {
            var some_id = $('#txtlogin');
            some_id.prop('type', 'text');
            some_id.removeAttr('autocomplete');

            $('#pwdModal').modal('hide').on('hidden.bs.modal', function () {
                $('.modal-backdrop').remove(); // Remove the backdrop once the modal is fully hidden
                $("#btnUpdateMobile > i").hide();
            });
        });
        $("#btnUpdateMobile").click(function (event) {
            var selectedOtpMethod = $('input[name="otpMethod"]:checked').val();
            if (!selectedOtpMethod) {
                alert("No OTP method selected.");
                return;
            }
            var Jloginid = document.getElementById("MobileECode").value;
            var JDOB = document.getElementById("MobileDOB").value;
            var JMob = document.getElementById("Mobileno").value;
            if (Jloginid == "" || JDOB == "" || JMob == "") { bootbox.alert({ title: "Error", message: "Employee Code, Date of Birth and Mobile no are mandatory fields." }).find('.modal-header').css({ 'background-color': '#ff7c7c', 'font-weight': 'bold', 'color': '#ffffff', 'font-weight': 'bold', 'font-family': 'Calibri' }); }
            else
            {
                var Jloginid = document.getElementById("MobileECode").value;
                var JDOB = document.getElementById("MobileDOB").value;
                var JMob = document.getElementById("Mobileno").value;
                $("#btnUpdateMobile").attr('disabled', true);
                $("#btnUpdateMobile > i").show();
                $.ajax({
                    type: "POST",
                    url: "/Login/UpdateMobile",
                    data: JSON.stringify({ "uid": Jloginid, "dob": JDOB, "mobileno": JMob, "settype": selectedOtpMethod }),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data == 1) {
                            document.getElementById("MobileECode").value = "";
                            $("#forgotmodalclose").trigger('click');

                            $("#idmsg").text('A verification code has been sent to your Mobile/email. Verification code will be vaild for "' + @ViewBag.OTPMIN + '" minutes."')
                            minutes = $('#setTime').val();
                            target_date = new Date().getTime() + ((minutes * 60) * 1000); // set the countdown date
                            time_limit = ((minutes * 60) * 1000);
                            //set actual timer
                            setTimeout(
                                function () {
                                    document.getElementById("left").innerHTML = "Timer Stopped";
                                    window.location = '/Login';
                                }, time_limit);

                            countdown = document.getElementById("tiles"); // get tag element

                            getCountdown();

                            setInterval(function () { getCountdown(); }, 1000);

                            $("#div2").removeClass('disableDiv');
                            $(".div-disable").addClass('disableDiv');
                            $("#btnUpdateMobile").attr('disabled', false);
                            $("#btnUpdateMobile > i").hide();
                        }

                        else if (data == 2) {

                            bootbox.alert({ title: "Message", message: "Invalid data. Please enter valid Employee Code and D.O.B." }).find('.modal-header').css({ 'background-color': '#ff7c7c', 'font-weight': 'bold', 'color': '#ffffff', 'font-weight': 'bold', 'font-family': 'Calibri' });
                            $("#btnUpdateMobile").attr('disabled', false);
                            $("#btnUpdateMobile > i").hide();
                        }
                    },
                    error: function (err) {
                        $("#btnUpdateMobile").attr('disabled', false);
                        $("#btnUpdateMobile > i").hide();
                    }
                });
            }
        });

        $("#forgotmodalclose").click(function (event) {
            document.getElementById("MobileECode").value = "";
            document.getElementById("MobileDOB").value = "";
            document.getElementById("Mobileno").value = "";
            $("#pwdModal").hide(100);
        });
    </script>

    <script nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#imgResendOTP').on('click', function () {
                refreshOTPClick(@_OTP);
            });
            $('#btnOtpVerify').on('click', function () {
                OTPVerify($(this)[0]);
            });
            $('#imgRefresh').on('click', function () {
                refreshClick();
            });
            $('#btnVerifyCaptcha').on('click', function () {
                CAPCHAVerify($(this)[0]);
            });
        });
    </script>
</body>
</html>