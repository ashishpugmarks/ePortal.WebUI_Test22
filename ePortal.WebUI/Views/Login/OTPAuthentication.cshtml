    <script nonce="@Context.Items["ScriptNonce_0"]">
        var minutes, target_date, time_limit, countdown;
        var days, hours, minutes, seconds; // variables for time units
        $(document).ready(function () {
            $("#div2").addClass('disableDiv');
        });

        function getCountdown() {
            var current_date = new Date().getTime();
            var seconds_left = (target_date - current_date) / 1000;

            if (seconds_left >= 0) {
                console.log(time_limit);
                if ((seconds_left * 1000) < (time_limit / 2)) {
                    $('#tiles').removeClass('color-full');
                    $('#tiles').addClass('color-half');

                }
                if ((seconds_left * 1000) < (time_limit / 4)) {
                    $('#tiles').removeClass('color-half');
                    $('#tiles').addClass('color-empty');
                }

                days = pad(parseInt(seconds_left / 86400));
                seconds_left = seconds_left % 86400;

                hours = pad(parseInt(seconds_left / 3600));
                seconds_left = seconds_left % 3600;

                minutes = pad(parseInt(seconds_left / 60));
                seconds = pad(parseInt(seconds_left % 60));

                // format countdown string + set tag value
                countdown.innerHTML = "<span>" + hours + ":</span><span>" + minutes + ":</span><span>" + seconds + "</span>";
            }
        }

        function pad(n) {
            return (n < 10 ? '0' : '') + n;
        }

        function CAPCHAVerify(crnt) {
            var captcha = $("#txtcaptcha").val();
            var selectedOtpMethod = $('input[name="otpMethod"]:checked').val();
            if (!selectedOtpMethod) {
                alert("No OTP method selected.");
                return;
            }
            if (captcha.trim() == "") {
                alert("Entered Captcha is incorrect, Please retry.");
                return;
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Login/CaptchaAuthentication",
                    data: JSON.stringify({ captcha: captcha, settype: selectedOtpMethod }),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data == 1) {
                            $("#idmsg").text('A verification code has been send to your Mobile/email. OTP code will be vaild for "' + @ViewBag.OTPMIN + '" minutes."')
                            minutes = $('#setTime').val();
                            target_date = new Date().getTime() + ((minutes * 60) * 1000); // set the countdown date
                            time_limit = ((minutes * 60) * 1000);
                            //set actual timer
                            setTimeout(
                              function () {
                                  document.getElementById("left").innerHTML = "Timer Stopped";
                                  window.location = '/Login';
                              }, time_limit);

                            countdown = document.getElementById("tiles"); // get tag element

                            getCountdown();

                            setInterval(function () { getCountdown(); }, 1000);

                            $("#div2").removeClass('disableDiv');
                            $(".div-disable").addClass('disableDiv');
                        }
                        else if (data == 2) {
                            alert("Entered Captcha is incorrect, Please retry.");
                            refreshClick();
                        }
                        else if (data == 3) {
                            $("#idmsg").text('Mobile no. is mandatory for OTP. Click on below mentioned link "Update Mobile No."')
                            $(".div-disable").addClass('disableDiv');
                        }
                        else {
                            window.location = '/Login/Index';
                        }
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });

            }
        }

        function OTPVerify(crnt) {
            var otp = $("#txtOTP").val();
            if (otp.trim() == "") {
                return;
                //$(crnt).removeClass('btn-success');
                //$(crnt).addClass('btn-danger');
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Login/OTPAuthentication",
                    data: JSON.stringify({ OTP: otp }),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data == 1) {
                            window.location = '/Home/Home';
                        }
                        else if (data == 2) {
                            window.location = '/Home/Dashboard';
                        }
                        else if (data == 3) {
                            window.location = '/aspxview/Admin/Home.aspx';
                        }
                        else if (data == -1) {
                            // sweetAlert("", "Entered OTP is incorrect, Please retry.", "warning");
                            alert("Entered OTP is incorrect, Please retry.");
                        }
                        else {
                            window.location = '/Login/Index';
                        }
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });

                //$("#hfOTP").val(otp);
                //$("#_form").submit();
            }
        }


        function refreshClick() {
            $('#imgCapcha').attr('src', '/Login/GetCaptchaImage');
        }
        function refreshOTPClick(uid) {
            var selectedOtpMethod = $('input[name="otpMethod"]:checked').val();
            $.ajax({
                url: `/Login/REOTPTOKEN?uid=${uid}&settype=${selectedOtpMethod}`,
                data: JSON.stringify({ uid: uid, settype: selectedOtpMethod }),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {

                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
    </script>
</head>
<body style="background-color: aliceblue;">
