@model IEnumerable<ePortal.ViewModels.ContineousWorkingRowViewModel>


<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<div class="panel-group">
    <div class="panel panel-primary">
        <div class="panel-heading">
            <h2 class="panel-title">
                <strong>Continuous Working Report</strong>
            </h2>
        </div>
        <div class="panel-body" style="padding:5px;">
            <div class="table-responsive">
                <table class="table table-bordered table-hover " id="tbContineousWorkingList">
                    <thead>
                        <tr>
                            <th class="text-left">
                                @Html.DisplayName("Employee ID")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Associate Name")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Operation")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Division")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Department")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Section")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Designation")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Location")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Status")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Continuous Working From")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Date To")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Continuous Days")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Punch Date")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Punch IN")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Punch OUT")
                            </th>
                            <th class="text-left">
                                @Html.DisplayName("Shift")
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ADEMPCODE</td>
                                    <td>@item.ASSOCIATE_NAME</td>
                                    <td>@item.OPERATION</td>
                                    <td>@item.DIVISION</td>
                                    <td>@item.DEPARTMENT</td>
                                    <td>@item.SECTION</td>
                                    <td>@item.DESIGNATION</td>
                                    <td>@item.SITE_DESCRIP</td>
                                    <td>@item.STATUS</td>
                                    <td>@item.CONTINUOUS_WORKING_FROM</td>
                                    <td style="width: 80px;">@item.DATETO</td>
                                    <td>@item.CONTINUOUSDAYS</td>
                                    <td style="width: 80px;">@item.PUNCHDATE</td>
                                    <td style="width: 75px;">@item.PunchIN</td>
                                    <td style="width: 75px;">@item.PunchOUT</td>
                                    <td>@item.SHIFT</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="15" class="text-center text-danger">No records found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>











