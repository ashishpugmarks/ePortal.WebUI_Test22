   @*  @Styles.Render("~/bundle/css")
    @Scripts.Render("~/bundles/jquery") *@
    <link rel="stylesheet" href="~/bundle/style.min.css" />
    @* Bundle JS files  *@
    <script src="~/bundle/jquery.min.js"></script>

    <script nonce="@Context.Items["ScriptNonce_8"]">
        function GetPDF(filename, no) {
            var _pdfName = filename;
            if (_pdfName != "" && _pdfName != "Select") {
                $.ajax({
                    type: "GET",
                    url: "/PO/GetMultiPDF",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { fileName: _pdfName },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        debugger;
                        if (data.FILEPATH != "") {
                            document.getElementById("append_pdf" + no).innerHTML = data.FILEPATH;
                        }
                        else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }


    </script>

    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
        $(document).ready(function () {
            $('#ddlFile4').on('click', function () {
                GetPDF($(this).val(), 4);
            });
            $('#ddlFile1').on('change', function () {
                GetPDF($(this).val(), 1);
            });
            $('#ddlFile2').on('change', function () {
                GetPDF($(this).val(), 2);
            });
            $('#ddlFile3').on('change', function () {
                GetPDF($(this).val(), 3);
            });
        });
    </script>
    </head>
