                                        <tbody>
                                            @{ int row_No = 0; }
                                            @if (Model.poAppHis != null)
                                            {
                                                if (Model.poAppHis.Count > 0)
                                                {
                                                    foreach (var item in Model.poAppHis)
                                                    {
                                                        <tr>
                                                            <td class="text-center">
                                                                @(row_No += 1)
                                                                @Html.HiddenFor(modelItem => item.POAPPHISTORY_ID)
                                                            </td>
                                                            <td class="text-left" style="padding-left: 10px;">
                                                                @Html.HiddenFor(modelItem => item.POID)
                                                                @Html.DisplayFor(modelItem => item.APPEMP_NAME)
                                                            </td>
                                                            <td class="text-center" style="padding-left: 10px;">
                                                                @{
                                                                string _msg = "";
                                                                if (item.APPROVAL_STATUS == 1)
                                                                {
                                                                    _msg = "Approved";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 2)
                                                                {
                                                                    _msg = "Send back";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 3)
                                                                {
                                                                    _msg = "Rejected";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 0)
                                                                {
                                                                    _msg = "Pending";
                                                                }
                                                            <span>@_msg</span>
                                                                }
                                                            </td>
                                                            <td class="text-center">
                                                                @Html.DisplayFor(modelItem => item.APPROVALDATE)
                                                            </td>
                                                            <td class="text-left" style="padding-left: 10px;">
                                                                @Html.DisplayFor(modelItem => item.APPROVAL_REMARK)
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                    {
                                                      <tr><th colspan="5" class="text-center">No record found.</th></tr>
                                                    }
                                             }
                                             else
                                                 {
                                                   <tr><th colspan="5" class="text-center">No record found.</th></tr>
                                                 }
                                        </tbody>
                                    </table>
                                </div>
