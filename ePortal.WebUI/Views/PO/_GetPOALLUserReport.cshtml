@using ePortal.Shared
@using System.Net
@model ePortal.ViewModels.SearchPO
@{
    Layout = null;
}
<html>
    <head>
    <style type="text/css" nonce="@Context.Items["StyleNonce_9"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }
    </style>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $("#tbRequestReport").dataTable({
                "bFilter": true,
                "bLengthChange": false,
                "order": [[5, 'desc']],
                "columnDefs": [//date-fields
                                 {
                                     "searchable": false,
                                     "orderable": true,
                                     "targets": 5,
                                     "type": 'date'
                                 }
                ],
            });
        });
    </script>
    </head>
    <body>
    <div class="panel-group">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <table style="width:100%;">
                    <tr>
                        <td>
                            <h2 class="panel-title">
                                <strong>Request List</strong>
                            </h2>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="panel-body">
                <table class="table table-bordered table-hover table-responsive" id="tbRequestReport">
                    <thead>
                        <tr>
                            <th class="text-center">
                                @Html.DisplayName("PO No")
                            </th>
                            <th class="text-center">
                                @Html.DisplayName("Employee Name")
                            </th>
                            <th class="text-center">
                                @Html.DisplayName("Division/Department")
                            </th>
                            <th class="text-center">
                                @Html.DisplayName("Vendor Code")
                            </th>
                            <th class="text-center">
                                @Html.DisplayName("Vendor Name")
                            </th>
                            <th class="text-center">
                                @Html.DisplayName("Description")
                            </th>
                            <th class="text-center">
                                @Html.DisplayName("Remark")
                            </th>
                            <th class="text-center">
                                @Html.DisplayName("Ammendment No")
                            </th>
                            <th class="text-center">
                                @Html.DisplayName("Request Date")
                            </th>
                            <th class="text-center">
                                @Html.DisplayName("Last Updated Date")
                            </th>
                            <th class="text-center">
                                @Html.DisplayName("Status")
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowNo = 0;
                        }
                        @if (Model != null && Model.SearchResult != null)
                        {
                            foreach (var item in Model.SearchResult)
                            {
                                var _tId = WebUtility.UrlEncode(Encryption.Encrypt(item.POHEADERID.ToString())).ToString();
                                var _urlStr = "/PO/POViewDetail?id=" + _tId;
                                <tr>
                                    <td class="text-center" style="width:7%;">
                                        @*@(rowNo += 1)*@
                                        <a href="@_urlStr" target="_blank">@Html.DisplayFor(modelItem => item.PONO)</a>
                                    </td>
                                    <td class="text-left" style="width:15%;">
                                        @Html.DisplayFor(modelItem => item.ADDEDBYNAME) - (@Html.DisplayFor(modelItem => item.ADDEDBY))
                                    </td>
                                    <td class="text-left" style="width:15%!important;">
                                        @Html.DisplayFor(modelItem => item.DIVISION) / @Html.DisplayFor(modelItem => item.DEPARTMENT)
                                    </td>
                                    <td class="text-center">
                                        @Html.DisplayFor(modelItem => item.VENDORID)
                                    </td>
                                    <td class="text-left">
                                        @Html.DisplayFor(modelItem => item.VENDORNAME)
                                    </td>
                                    <td class="text-left">
                                        @Html.DisplayFor(modelItem => item.PO_DESC)
                                    </td>
                                    <td class="text-left">
                                        @Html.DisplayFor(modelItem => item.REMARK)
                                    </td>
                                    <td class="text-center">
                                        @Html.DisplayFor(modelItem => item.VERSION_NO)
                                    </td>
                                    <td class="text-center" style="width:10%!important;">
                                        @item.DATEADDED.ToString("dd-MMM-yyyy")
                                    </td>
                                    <td class="text-center" style="width:10%!important;">
                                        @if (item.UPDATEDATE != null)
                                        {
                                            @item.UPDATEDATE.Value.ToString("dd-MMM-yyyy")
                                        }
                                    </td>
                                    @*<td class="text-center">*@
                                    <td class="text-center">
                                        @if (item.PROCESS_STATUS == 2)
                                        {
                                            <button type="button" class="btn btn-success btn-xs" style="cursor: text !important">Approved</button>
                                        }
                                        @if (item.PROCESS_STATUS == 0 || item.PROCESS_STATUS == 1)
                                        {
                                            <button type="button" class="btn btn-info btn-xs" style="cursor: text !important">WIP</button>
                                        }
                                        @if (item.PROCESS_STATUS == 4)
                                        {
                                            <button class="btn btn-warning btn-xs" style="cursor: text !important">Cancelled</button>
                                        }
                                        @if (item.PROCESS_STATUS == 3)
                                        {
                                            <button class="btn btn-warning btn-xs" style="cursor: text !important">Rejected</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </body>
</html>
   



