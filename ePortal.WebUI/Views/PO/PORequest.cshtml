                    for (var i = 0; i < docTr.length; i += 1) {
                        var row = docTr[i];
                        if (row != undefined) {
                            var varificationText = row.cells[3].innerHTML.trim();
                            if (varificationText == "Not Verified") {
                                sweetAlert("", "Document not verified. Please open all document & verified", "warning");
                                return;
                            }
                        }
                    }
                }
                else {
                    sweetAlert("", "Please upload documents.", "warning");
                    return;
                }

                if (arrayList == null || arrayList.length == 0) {
                    $('#txtEmpcode').addClass('validationError');
                    sweetAlert("", "Please add approval authority.", "warning");
                    return;
                }
                else {
                    $("#btnSave").attr("disabled", true);
                    var data = {
                        POHEADERID: $("#hfPoHeaderId").val(),
                        REMARK: $("#txtRemark").val(),
                        STATUS: 1,
                        PROCESS_STATUS: 1,
                        IsFinalSubmit: 1,
                        poAuthSeq: arrayList,
                        poAuthSkipList: delAuthArray
                    }
                    $.ajax({
                        type: "POST",
                        url: "/PO/PORequest",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        data: JSON.stringify(data),
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (data) {
                            if (data == 1) {
                                swal({
                                    title: "",
                                    text: "Record saved successfully.",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                        window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                                    }
                                });
                            }
                            else if (data == 2) {
                                sweetAlert("", "This PO already processed.", "warning");
                                $("#btnSave").attr("disabled", false);
                            }
                            else if (data == 3) {
                                sweetAlert("", "Please upload PR document.", "warning");
                                $("#btnSave").attr("disabled", false);
                            }
                            else {
                                sweetAlert("", "Record not saved.", "warning");
                                $("#btnSave").attr("disabled", false);
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                            $("#btnSave").attr("disabled", false);
                        }
                    });
                }
            }
            else {
                $('#div_valid_msg').removeClass('hidden');
            }
        }

        function openInfo(url) {
            window.open(url, 'mywin', 'width=500,height=500');
        }

        function Reset() {
            window.location.href = "/PO/PORequest";
        }

        function PreviewPODtl() {
            $.ajax({
                type: "GET",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/PO/PreviewPODetail",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#sp_type').html("PO Detail's");
                        $('#myCreateModelContent').html(data);
                        $('#myCreateModel').modal({ backdrop: "static" });
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

    </script>

