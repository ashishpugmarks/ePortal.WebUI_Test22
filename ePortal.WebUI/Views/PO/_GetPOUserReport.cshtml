@using ePortal.Shared
@using System.Net
@model ePortal.ViewModels.Search_VW_PODASHBOARD_VWMODEL

@{
    Layout = null;
}
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }
    </style>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_5"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $("#tbRequestReport").dataTable({
                "bFilter": false,
                "bLengthChange": false,
                "order": [[6, 'desc']],
                "columnDefs": [//date-fields
                    {
                        "searchable": false,
                        "orderable": true,
                        "targets": 6,
                        "type": 'date'
                    }//,
                    ////{ "orderable": true,
                    ////    "render": $.fn.dataTable.render.number( ',', '', 0, '','' ),
                    ////    "targets":[5],
                    ////}
                ],
            })
        });
    </script>
    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_6"]">
        $(document).ready(function () {
            $(document).on('click', '[data-ctrl="anc-open-doc"]', function () {
                OpenDoc($(this)[0]);
            });
        });
    </script>

<div class="panel-group">
    <div class="panel panel-primary">
        <div class="panel-heading">
            <table style="width:100%;">
                <tr>
                    <td>
                        <h2 class="panel-title">
                            <strong>PO Request List</strong>
                        </h2>
                    </td>
                </tr>
            </table>
        </div>
        <div class="panel-body">
            <table class="table table-bordered table-hover table-responsive" id="tbRequestReport">
                <thead>
                    <tr>
                        <th class="text-center">
                            @Html.DisplayName("PO No")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Plant")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("Ammendment No")
                        </th>
                        <th class="text-left">
                            @Html.DisplayName("Vendor Name")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("PR No")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("PO Created By")
                        </th>
                        <th class="text-center">
                            @Html.DisplayName("PO Approval Date")
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.searchResult != null)
                    {
                        foreach (var item in Model.searchResult)
                        {
                            var _tId = WebUtility.UrlEncode(Encryption.Encrypt(item.POHEADERID.ToString())).ToString();
                            var _urlStr = "/PO/POViewDetail?id=" + _tId;
                            <tr>
                                <td class="text-left" style="width:110px;">
                                    <a href="@_urlStr" target="_blank">@item.PONO</a>&nbsp; @*Added By Aumento as on 12072024 for SRNO SR71654*@
                                    @*@item.PONO &nbsp;*@ @*Comment By Aumento as on 12072024 for SRNO SR71654*@
                                    <a id="ancOpenDoc" data-ctrl="anc-open-doc" data-name="@item.FILENAME" title="Click here to view approved PO.">
                                        <i class="glyphicon glyphicon-new-window" style="cursor:pointer;"></i>
                                    </a>
                                </td>
                                <td class="text-left" align="left">
                                    @item.PLANTID
                                </td>
                                <td class="text-left" align="left">
                                    @item.VERSION_NO
                                </td>
                                <td class="text-left" align="left">
                                    @item.VENDORNAME
                                </td>
                                <td class="text-center">
                                    @(string.IsNullOrEmpty(item.PRNO)?"":item.PRNO)
                                </td>
                                <td class="text-left">
                                    @item.ADDEDBYNAME
                                </td>
                                <td class="text-center">
                                    @item.UPDATEDATE.ToString("dd-MMM-yyyy")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
