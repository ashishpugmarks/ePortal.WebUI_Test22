@model ePortal.ViewModels.POHeaderViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewBag.Title = "POApproval";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string _path = "../../../Uploads/PO/";
    string _PRpath = "../../../Uploads/PR/";
    //var loginUser = Context.Session.GetString("userID") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userID").ToString()); 
    var loginUser = Context.Session.GetString("userID") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userID").ToString());
}

@section Styles{
   
    <link rel="stylesheet" href="~/css/new-aproval-page.css" asp-asp-append-version="true" />
}

@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            BindPRDocument($("#hfPoHeaderId").val());

            if ('@ViewBag.FnDesigId' == '3') //// 3 - Division Head
            {
                $("#div_urgency").removeClass('hidden');
            }
            else {
                $("#div_urgency").addClass('hidden');
            }
        });

        function SaveData(current) {
            var _IsValid = CheckValidation();
            if (!_IsValid) {
                return;
            }
            $("#btnSubmit").attr("disabled", true);
            var approvalData = {
                POID: $(current).attr('data-id'),
                //APPROVAL_STATUS: $("#ddApprovalStatus").val(),
                APPROVAL_STATUS:$(current).attr('data-status'),
                APPROVAL_REMARK: $("#txtRemarks").val(),
                PO_ATTACHMENT_NAME: $(current).attr('data-attachment'),
                High_Urgency: $('#chkHigh_Urgency')[0].checked?1:0
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/PO/POApproval",
                data: JSON.stringify(approvalData),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data == 1) {
                        GetNext($(current).attr('data-id'));
                        //window.location.href = "/ASPXView/ManageApproval.aspx";
                        //swal({
                        //    title: "",
                        //    text: "Record saved successfully",
                        //    type: "success",
                        //},
                        //function (isConfirm) {
                        //    if (isConfirm) {
                        //        window.location.href = "/ASPXView/ManageApproval.aspx";
                        //    }
                        //});
                    }
                    else if (data == 0 || data == -1) {
                        sweetAlert("", "Record not saved", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function CheckValidation() {
            var isVailed = true;
            $('#ddApprovalStatus').removeClass('validationError');
            if ($('#ddApprovalStatus').val() == "" || $('#ddApprovalStatus').val() == "0") {
                $('#ddApprovalStatus').addClass('validationError');
                isVailed = false;
            }
            $('#txtRemarks').removeClass('validationError');
            if ($('#ddApprovalStatus').val() == "2" || $('#ddApprovalStatus').val() == "3") {
                if ($('#txtRemarks').val() == "") {
                    $('#txtRemarks').addClass('validationError');
                    isVailed = false;
                }
            }
            return isVailed;
        }

        function GetPDF(current) {
            var _pdfName = $(current).attr('data-id');
            if (_pdfName != "") {
                $.ajax({
                    type: "GET",
                    url: "/PO/GetPDF",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { fileName: _pdfName },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.FILEPATH != "") {
                            document.getElementById("append_pdf").innerHTML = data.FILEPATH;
                        }
                        else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function openInfo(url) {
            window.open(url, 'mywin', 'width=800,height=600');
        }
        function CancelClick() {
            window.location.href = "/Home/Home";
        }

        function OpenConfirModel() {
            var chked_count = 0;
            var IsEnableForApp = document.getElementById("hdappaction").value;
            if (IsEnableForApp == 0) {
                swal({
                    title: "",
                    text: "You have already taken the action on this request.",
                    type: "info",
                    showCancelButton: false,
                    confirmButtonClass: "btn-info",
                    confirmButtonText: "OK",
                    cancelButtonText: "No",
                    closeOnConfirm: true,
                    closeOnCancel: true
                },
                function (isConfirm) {
                    if (isConfirm) {
                        window.location.href = "/Home/Home";
                    }
                    else {

                    }
                });
            }
            else {
                GetPDF(document.getElementById("poPDF"));
            }
        }

        function BindPRDocument(headerid) {
            var rows = "", rowId = 0;
            $.ajax({
                type: "GET",
                url: "/PO/GetPRATTDetail",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: { poID: headerid },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data != null) {
                        $.each(data.prDetail, function (i, item) {
                            rowId = i + 1;
                            var _fName = "@_PRpath" + item.FILENAME;
                            var additionalInfo = item.ADDITIONAL_INFO == null ? "" : item.ADDITIONAL_INFO;
                            rows += "<tr class='tr_doc1'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.DOC_TYPE + "</td>"
                            rows += "<td class='text-left'><a style='cursor: pointer;margin-right:10px;' data-ctrl='getprpdf' data-id='" + item.FILENAME + "'>" + "View Document" + "</a>"
                            rows += "<a data-ctrl='opendoc' data-path='" + _fName + "' data-name='PR' title='Click to open document'><i class='glyphicon glyphicon-new-window' style='cursor:pointer;'></a></i></td>"
                            rows += "<td class='text-left'>" + additionalInfo + "</td>"
                            rows += "</tr>"
                        });
                        document.getElementById("append_PRdocRow").innerHTML = rows;
                        @*CSP*@ 
                            $("[data-ctrl='opendoc']").on('click', function () {
                            OpenDoc($(this)[0]);
                        });
                        $("[data-ctrl='getprpdf']").on('click', function () {
                            GetPRPDF($(this)[0]);
                        });

                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    // sweetAlert("Oops...", "Error While Fetching PR Deatil !", "error");
                }
            });

        }

        function GetPRPDF(current) {
            var _pdfName = $(current).attr('data-id');
            if (_pdfName != "") {
                $.ajax({
                    type: "GET",
                    url: "/PR/GetPDF",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { fileName: _pdfName },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.FILEPATH != "") {
                            document.getElementById("append_pdf").innerHTML = data.FILEPATH;
                            //document.getElementById("myCreateModelContent").innerHTML = data.FILEPATH;
                            // $('#sp_type').html("PO Detail's");
                            // $('#myCreateModelContent').html(data);
                            //$('#myCreateModel').modal({ backdrop: "static" });
                        }
                        else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }
        function ddApprovalStatus(current) {
            if ($(current).val() == "2" || $(current).val() == "3") {
                $("#lblRemark").addClass('required');
            }
            else {
                $("#lblRemark").removeClass('required');
            }
        }

        function OpenDoc(current) {
            var _pdfPath = $(current).attr('data-path');
            var _pdfName = $(current).attr('data-name');
            var width = screen.width - 100;
            var height = screen.height - 100;
            var winTop = 50;
            var winLeft = 50;
            var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
            window.open(_pdfPath, _pdfName, windowFeatures);
        };

        function GetNext(POID_V) {
            var POIDCURR = POID_V;
            debugger;
            if (POIDCURR != "") {
                $.ajax({
                    type: "GET",
                    url: "/PO/PONextApproval",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { POID_PARAM: POIDCURR },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data != "") {
                            window.location.href = "/PO/POApproval?id=" + data;
                        }
                        else {
                            window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx";
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx";
                    }
                });
            }
        }
    </script>
    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        document.addEventListener('DOMContentLoaded', function () {
            OpenConfirModel();
        });
        $(document).ready(function () {
            $('#ddApprovalStatus').on('change', function () {
                ddApprovalStatus($(this)[0]);
            });
            $('#btnNext').on('click', function () {
                GetNext('@Model.POHEADERID');
            });
            $('#btnCancel').on('click', function () {
                CancelClick();
            });
            // $('#btnSubmit').on('click', function () {
            //     SaveData($(this)[0]);
            // });
            $('.action-btn').on('click', function () {
                SaveData($(this)[0]);
            });
            $('[data-ctrl="opendoc_1"]').on('click', function () {
                OpenDoc($(this)[0]);
            });
            $('[data-ctrl="getpdf"]').on('click', function () {
                GetPDF($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="anc-open-doc"]', function () {
                OpenDoc($(this)[0]);
            });
            $('#poPDF').on('click', function () {
                GetPDF($(this)[0]);
            });

        });
    </script>
}



