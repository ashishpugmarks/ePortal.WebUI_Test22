                                                            @{
                                                                string _msg = "";
                                                                if (item.APPROVAL_STATUS == 1)
                                                                {
                                                                    _msg = "Approved";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 2)
                                                                {
                                                                    _msg = "Send back";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 3)
                                                                {
                                                                    _msg = "Rejected";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 0)
                                                                {
                                                                    _msg = "Pending";
                                                                }
                                                                <span>@_msg</span>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @Html.DisplayFor(modelItem => item.APPROVALDATE)
                                                        </td>
                                                        <td class="text-left" style="padding-left: 10px;">
                                                            @Html.DisplayFor(modelItem => item.APPROVAL_REMARK)
                                                        </td>
                                                    </tr>
                                                                    }
                                                                }
                                        </tbody>
                                    </table>
                                </div>
                         </div>
                        <!-- Approval Skip -->
                        <div class="panel panel-shadow">
                            <div class="panel-heading" data-toggle="collapse" data-target="#ApprovalSkip">
                                <span class="panel-title">
                                    <i class="fa fa-caret-right caret-color"></i>Skip Authority
                                </span>       
                            </div>
                            <div id="ApprovalSkip" class="panel-body panel-collapse collapse in">
                                <table class="table table-bordered table-hover table-responsive approval-table" id="tbSkipAuth" style="margin-bottom: 0px;">
                                    <thead>
                                        <tr class="bg-info">
                                            <th class="text-center">
                                                @Html.DisplayNameFor(model => model.poAuthSkipList[0].POAPPSKIP_ID)
                                            </th>
                                            <th class="text-center">
                                                @Html.DisplayNameFor(model => model.poAuthSkipList[0].ADEMPCODE)
                                            </th>
                                            <th class="text-left">
                                                @Html.DisplayNameFor(model => model.poAuthSkipList[0].ADEMPNAME)
                                            </th>
                                            <th class="text-center">
                                                @Html.DisplayNameFor(model => model.poAuthSkipList[0].ADDEDDATE)
                                            </th>
                                            <th class="text-left">
                                                @Html.DisplayNameFor(model => model.poAuthSkipList[0].SKIPREMARK)
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                            @{ int row_No2 = 0; }
                                        @if (Model.poAuthSkipList != null)
                                        {
                                            if (Model.poAuthSkipList.Count > 0)
                                            {
                                                foreach (var item in Model.poAuthSkipList)
                                                {
                                                    <tr>
                                                        <td class="text-center">
                                                            @(row_No2 += 1)
                                                            @Html.HiddenFor(modelItem => item.POAPPSKIP_ID)
                                                        </td>
                                                        <td class="text-center">
                                                            @Html.HiddenFor(modelItem => item.POID)
                                                            @Html.DisplayFor(modelItem => item.ADEMPCODE)
                                                        </td>
                                                        <td class="text-left" style="padding-left: 10px;">
                                                            @Html.DisplayFor(modelItem => item.ADEMPNAME)
                                                        </td>
                                                        <td class="text-center">
                                                            @Html.DisplayFor(modelItem => item.ADDEDDATE)
                                                        </td>
                                                        <td class="text-left" style="padding-left: 10px;">
                                                            @Html.DisplayFor(modelItem => item.SKIPREMARK)
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><th colspan="5" class="text-center">No record found.</th></tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><th colspan="5" class="text-center">No record found.</th></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                            <!-- Approval Request -->
                            @{
                                var IsEnableForApp = Model.poAppHis.Any(a => a.ADEMPCODE == loginUser && a.APPROVAL_STATUS == 0);
                                <div class="panel panel-shadow">
                                    <div class="panel-heading" data-toggle="collapse" data-target="#ApprovalRequest">
                                        <span class="panel-title">
                                            <i class="fa fa-caret-right caret-color"></i>Approval
                                        </span>
                                    </div>
                                    <div id="approverAction" class="panel-body panel-collapse collapse in">
                                        <div class="remarks-box">
                                            @if (IsEnableForApp){
                                                var _poAttachment = Model.poDetail.FirstOrDefault(x => x.DOC_TYPE == "PO").FILENAME;
                                                <div class="text-center pnl-btn">
                                                    <button type="button" class="btn action-btn btn-md reject" data-id="@Model.POHEADERID" data-status="3"><i class="fa fa-times-circle-o"></i>REJECT</button>
                                                    <button type="button" class="btn action-btn btn-md approve flex-2_3_po" data-id="@Model.POHEADERID" data-status="1"><i class="fa fa-check-circle-o"></i>APPROVE</button>
                                                </div>
                                                <div class="text-center pnl-btn">
                                                    <div id="div_urgency" class="hidden">
                                                        <table class="table table-responsive approval-table table-curved">
                                                            <tr>
                                                                <th>@Html.LabelFor(model => model.HIGH_URGENCY, htmlAttributes: new { @class = "control-label" })</th>
                                                                <td>
                                                                    @Html.CheckBox("HIGH_URGENCY", Model?.HIGH_URGENCY == 1, new { id = "chkHigh_Urgency", style = "width:20px; height:20px;" })
                                                                    @* <input asp-for="HIGH_URGENCY" type="checkbox" id="chkHIGH_URGENCY" style="width:20px; height:20px;" />*@
                                                                    @* @Html.CheckBoxFor(model => model.HIGH_URGENCY, new { @id = "chkHigh_Urgency", @style = "width:20px; height:20px;" })*@
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </div>
                                                </div>

                                                <div>
                                                    <div class="well">
                                                        <textarea id="txtRemarks" class="form-control " placeholder="Enter Remarks."></textarea>
                                                    </div>
                                                </div>
                                            }
                                            <div class="text-center pnl-btn">
                                                <a title="Back" class="btn back" href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx"><i class="fa fa-arrow-left"></i>BACK</a>
                                                @if (IsEnableForApp){
                                                    <button type="button" class="btn action-btn btn-md sendback" data-id="@Model.POHEADERID" data-status="2"><i class="fa fa-undo"></i>SEND BACK</button>
                                                }
                                                <button id="btnNext" class="btn skip"><i class="fa fa-step-forward"></i>SKIP</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                    }

                         
                       
    
    <div id="ajaxLoader"></div>


