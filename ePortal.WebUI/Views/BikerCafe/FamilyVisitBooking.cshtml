                                        <th style="width:45%;">Member Name</th>
                                        <th class="text-center" style="width:20%;">Relation</th>
                                        <th style="width:15%;" class="hidden">Meal Type</th>
                                        <th style="width:32%;" class="hidden">Meal Desc</th>
                                        <th class="text-center">Booking</th>
                                    </tr>
                                </thead>
                                <tbody id="append_docRow">
                                    @{
                                        int rowNo = 0;
                                        if (Model.MEALBOOKING_DTL != null)
                                        {
                                            foreach (var item in Model.MEALBOOKING_DTL)
                                            {
                                                var bgColor = item.RELATION_TYPE.ToUpper() == "SELF" ? "background-color: rgb(245, 222, 179);" : "";
                                                <tr class="row_data" style="@bgColor">
                                                    <td class="text-center">@(rowNo += 1)</td>
