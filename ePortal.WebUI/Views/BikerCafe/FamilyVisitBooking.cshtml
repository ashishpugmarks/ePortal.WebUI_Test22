        function AddRow(crnt) {
            var isValid = true;
            $('#txtMemberName').removeClass('validationError');
            if ($('#txtMemberName').val() == '') {
                $('#txtMemberName').addClass('validationError');
                isValid = false;
            }
            //$('#ddlRelationType').removeClass('validationError');
            //if ($('#ddlRelationType').val() == '') {
            //    $('#ddlRelationType').addClass('validationError');
            //    isValid = false;
            //}

            var rows = "", rowId = 0;
            if (isValid) {
                rowId = $('#tbFamily').find('.row_data').length + 1;
                rows += '<tr class="row_data" style="background-color: rgb(245, 222, 179);"><td class="text-center">' + rowId + '</td><td>' + $('#txtMemberName').val() + '</td><td class="text-center"></td>';
                rows += '<td class="text-center">@Html.CheckBox("ChkSelect", new { @style = "width:20px; height:20px;", @checked = "checked", @data_ctrl = "chk-select-1" })</td></tr>'
                //rows += '<td class="text-center"></td><td></td><td class="text-center">@Html.CheckBox("ChkSelect", new { @style = "width:20px; height:20px;", @checked = "checked", @onclick = "ChkClick(this);" })</td></tr>'
                $("#tbFamily #append_docRow tr:last").before(rows);
                TotalBookCount += 1;

                $('#txtMemberName').val('');
                //$('#ddlRelationType').val('');

                //CSP 3.0 Compliant changes
                $(document).on('click', '[data_ctrl="chk-select-1"]', function () {
                    ChkClick($(this)[0]);
                });
            }
