                TotalBookCount += 1;
                //AddRecord(crnt);
            }
            else {
                if (TotalBookCount > 0) {
                    //$(_row.cells[3].firstElementChild).addClass('disableCSS');
                    _row.style.backgroundColor = "";
                    TotalBookCount = TotalBookCount - 1;
                    //DeleteItem(crnt);
                }
            }
        }

