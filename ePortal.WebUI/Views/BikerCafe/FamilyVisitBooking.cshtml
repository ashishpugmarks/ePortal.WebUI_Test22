                                                    <td class="text-center">@item.RELATION_TYPE</td>
                                                    <td class="text-center hidden">
                                                        @Html.DropDownListFor(model => item.MEALTYPEID, new SelectList(ViewBag.MEALTYPES.Items, "BC_MEALTYPEID", "MEAL_TYPE_DESC"), "- Select Meal Type-", new { @id = "ddlMealType", @class = "form-control disableCSS" })
