@model ePortal.ViewModels.FamilyMealBookingTrnViewModel

@{
    ViewBag.Title = "FamilyVisitBooking";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<ePortal.ViewModels.MealSlotViewModel> slotsModel = ViewBag.Slots;
    var imgSrc1 = "";
}

@section Styles {
    <link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        .table > tbody > tr:nth-of-type(even) {
            background: #d9edf7;
        }

        .table > thead > tr > th {
            padding: 6px 10px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            padding: 5px;
            line-height: 1.2;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        .table > tbody > tr > td {
            padding: 4px 6px;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .alert-error {
            background-color: antiquewhite;
            margin-left: 15px;
            margin-right: 15px;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .highlightBackground {
            background-color: #8bb55a !important;
            color: white;
        }

        .card-body {
            flex: 1 1 auto;
            padding: 0.2rem 0.2rem;
            height: auto;
            background-color: burlywood;
        }

        .card-title {
            margin-bottom: 0.3rem;
            font-weight: 600;
        }

        .card-text {
            font-size: small;
            line-height: normal;
        }

        .h-100 {
            height: 100% !important;
        }

        .ui-widget {
            overflow-y: scroll !important;
            max-height: 200px !important;
            min-height: 25px !important;
            width: 37.5% !important;
        }

        .ui-autocomplete {
            font-size: 15px !important;
            background-color: wheat !important;
        }

        .disableCSS {
            cursor: not-allowed !important;
            pointer-events: none;
            opacity: 0.7;
        }
    </style>
}


<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">
            Family Visit Booking
        </div>
    </div>

    <div class="body-content" style="overflow-x:auto!important;">
        <div class="panel-group">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title">
                        <strong>Booking Detail's</strong>
                        <strong class="pull-right">
                            <input type="button" class="btn btn-default btn-xs" id="btnOrderHistory" value="Booking History" />
                        </strong>
                    </h2>
                </div>
                <div class="panel-body">
                    <div class="col-md-7">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th class="text-right">
                                        @Html.LabelFor(model => model.MEAL_BOOKED_DATE, new { @class = "control-label", @style = "margin-top: 7px;padding-bottom: 5px;" })
                                    </th>
                                    <th colspan="2">
                                        @Html.TextBoxFor(model => model.strBOOKED_DATE, new { @class = "form-control datepic", @style = "width: 40%;", @name = "BookingDate", @id = "txtBookingDate", @readonly = "readonly", @placeholder = "Booking Date" })
                                    </th>
                                </tr>
                                <tr>
                                    <th class="text-right">
                                        @Html.LabelFor(model => model.SLOTID, new { @class = "control-label", @style = "margin-top: 7px;padding-bottom: 5px;" })
                                    </th>
                                    <th colspan="2">
                                        @* @Html.DropDownListFor(model => model.SLOTID, new SelectList(slotsModel.Where(x => x.MEALTYPEID == 3).ToList(), "BCSLOTMSTID", "SLOT_TIME"), "- Select Slot -", new { @id = "ddlSlot", @style = "width: 54%;", @class = "form-control" }) *@


                                        @Html.DropDownListFor(
                                                 model => model.SLOTID,
                                                 new SelectList(
                                                 slotsModel.Where(x => x.MEALTYPEID == 3).ToList(),
                                                 "BCSLOTMSTID",
                                                 "SLOT_TIME"
                                                 ),
                                                 "- Select Slot -",
                                                 new { id = "ddlSlot", style = "width: 54%;", @class = "form-control" }
                                                 )

                                    </th>
                                </tr>
                                <tr style="background-color: antiquewhite;">
                                    <th colspan="4" style="color: blue;">Note :-</th>
                                </tr>
                                <tr style="background-color: white;">
                                    <td colspan="4">
                                        <p style="color:#a94442;">
                                            @* <b>1).</b> Family Visit can be booked from 3<sup style="font-size:smaller;">rd</sup> Nov 2022 and will continue till 21<sup style="font-size:smaller;">st</sup> Dec 2022. This will be subject to no other scheduled event in evening. <br /> *@  @*CR 7220*@
                                            <b>1).</b> Family Visit can be booked from 1<sup style="font-size:smaller;">st</sup> Oct 2025 and will continue till 31<sup style="font-size:smaller;">st</sup> Oct 2025. This will be subject to no other scheduled event in evening. <br />  @*sa CR 7220*@
                                            <b>2).</b> Request should be given at least 1 day in advance (N-1) on E-portal, subject to maximum 150 booking per day. <br />
                                            @*sa CR 7220*@
                                            @*<b>3).</b> Associates can avail this facility one-time only. Associates & their spouse can bring family members within blood relations only. <br />*@
                                            <b>3).</b> Associates can avail this facility to all AE and Associates eligible only. Associates & their spouse can bring family members within blood relations only. The same person can't be booked the visit again during these schedule and time slot.<br />
                                            @*<b>4).</b> Family visit timing is 05:30pm ~ 08:30pm (Monday to Friday on working days only, except holidays). <br />*@
                                            <b>4).</b> Booking available on Thursday, Friday, Saturday (excluding HMSI holidays). <br />
                                            @*ea CR 7220*@
                                            <b>5).</b> All Family members shall park their Cars in Visitors Parking at Gate Number 1 & General parking. <br />
                                            <b>6).</b> Associates must do entry at security gate, further everyone shall gather in Welcome Hall. <br />
                                            <b>7).</b> Factory Visit will start at 05:45pm onwards in 3 Batches.(batch 1. 05:45 ~ 06:25pm, batch 2. 06:30 ~ 07:10, batch 3. 7:50 ~ 08:30) <br />
                                            <b>8).</b> Family members can visit the office area and Philosophy road also. <br />
                                            <b>9).</b> Dinner arrangement will be available from 06:30pm onwards in west wing canteen (Company sponsored) <br />
                                            <b>10).</b> Food & Beverages are also available in Dreams Café on payment basis. <br />
                                            <b>11).</b> Photography is prohibited on shop floor and office area.
                                        </p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-5">
                        <div class="form-group" style="margin-bottom: 0px;">
                            <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;" id="tbFamily">
                                <thead>
                                    <tr class="bg-info">
