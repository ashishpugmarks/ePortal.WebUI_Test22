            var enddays = parseInt(@ViewBag.MEAL_BOOKING_DURATION);
            var Startdays = parseInt(@ViewBag.GUEST_BOKING_DAY);
            var today = new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate() + Startdays);
            //var endDate = new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate() + enddays);
            //var endDate = new Date(2022, 11, 21);
            var _eDate = "@ViewBag.END_DATE".split("-");
            var endDate = new Date(_eDate[2], _eDate[1] - 1, _eDate[0])
            $('.datepic').datepicker({
                // dateFormat: "dd-M-yy",
                format: "dd-M-yyyy",
                startDate: today,
                endDate: endDate,
                autoclose: true,
                toolbarplacement: 'top'
            });

            var _days = datediff(today, endDate);
            if (_days < 0) {
                swal({
                    title: "",
                    text: "Family visit booking window closed.",
                    type: "info",
                    showCancelButton: false,
                    confirmButtonClass: "btn-info",
                    confirmButtonText: "OK",
                    cancelButtonText: "No",
                    closeOnConfirm: true,
                    closeOnCancel: true
                },
                function (isConfirm) {
                    if (isConfirm) {
                        window.location.href = "/Home/Home";
                    }
                    else {

                    }
                });
            }

            BindSlots($("#txtBookingDate"));

        });

        function datediff(first, second) {
            return Math.round((second - first) / (1000 * 60 * 60 * 24));
        }


        ////======== Bind Slots========////
        function BindSlots(crnt) {
            var bDATE = $(crnt).val();
            $.getJSON("/BikerCafe/BindSlotByBookingDate", { bDate: bDATE },
                   function (data) {
                       var select = $("#ddlSlot");
                       select.empty();
                       if (data.length > 0) {
                           select.append($('<option/>', {
                               value: "",
                               text: "--Select Slot--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: "",
                               text: "--No record--"
                           }));
                       }
                       $.each(data, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.BCSLOTMSTID,
                               text: itemData.SLOT_TIME
                           }));
                       });
                   });
        }

        function ChkClick(crnt) {
            var _row = $(crnt).closest("tr")[0];
            if (crnt.checked) {
                //$(_row.cells[3].firstElementChild).removeClass('disableCSS');
