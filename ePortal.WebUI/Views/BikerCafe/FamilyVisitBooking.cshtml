                                                        {
                                                            @Html.CheckBox("ChkSelect", new { @checked = "checked", @class = "disableCSS", @style = "width:20px; height:20px;", @data_ctrl = "chk-select" })
                                                        }
                                                        else
                                                        {
                                                            @Html.CheckBox("ChkSelect", new { @style = "width:20px; height:20px;", @data_ctrl = "chk-select" })
                                                        }
