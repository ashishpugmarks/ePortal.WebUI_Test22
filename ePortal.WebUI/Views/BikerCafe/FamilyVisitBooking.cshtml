        function AddArrayItem() {
            debugger;
            arrayBookList = new Array;
            var rowLength = $('#tbFamily').find('.row_data').length;
            var rows = $('#tbFamily').find('.row_data');
            for (var i = 0; i < rowLength; i += 1) {
                var row = rows[i];
                if (row != undefined) {
                    //$(row.cells[3].firstElementChild).removeClass('validationError');
                    if ($(row).find('input:checkbox')[0].checked) {
                        //if (row.cells[3].firstElementChild.value == "") {
                        //    sweetAlert("", "Please select meal type.", "warning");
                        //    $(row.cells[3].firstElementChild).addClass('validationError');
                        //    return;
                        //}
                        var data = {
                            MEMBER_NAME: row.cells[1].innerText,
                            RELATION_TYPE: row.cells[2].innerText,
                            MEALTYPEID: 0, //row.cells[3].firstElementChild.value,
                            MEALS_AVAILABILITY_ID: 0 //row.cells[4].firstChild.firstElementChild.value,
                        }
                        arrayBookList.push(data);
                    }
                }
            }
            return arrayBookList;
        }

        function SaveData(current) {
            var slot = $('#ddlSlot').val();
            $('#ddlSlot').removeClass('validationError');
            if (slot == '') {
                $('#ddlSlot').addClass('validationError');
                sweetAlert("", "Please select slot.", "warning");
                return;
            }

            var arrayItem = AddArrayItem();
            if (arrayItem.length == 0) {
                sweetAlert("", "Please select family member before submission.", "warning");
                return;
            }

            var ItemExist = $.grep(arrayBookList, function (e) {
                return e.RELATION_TYPE == "Self";
            });
            if (ItemExist.length == 0) {
                sweetAlert("", "Associate self booking mandatory.", "warning");
                return;
            }

            $("#btnSubmit").attr("disabled", true);
            var data = {
                // MEAL_BOOKED_DATE: $('#txtBookingDate').val(),
                strBOOKED_DATE: $('#txtBookingDate').val(),
                SLOTID: $('#ddlSlot').val(),
                MEAL_STATUS: 1,
                MEALBOOKING_DTL: arrayBookList
            }

            //console.log(data);

            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/BikerCafe/FamilyVisitBookingPUT",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.val == 1) {
                        swal({ title: "", text: "Family visit booked successfully.", type: "success" },
                        function (isConfirm) {
                            if (isConfirm) {
                                window.location.href = "/BikerCafe/ManageFamilyVisitBooking";
                            }
                        });
                    }
                    else if (data.val == 2) {
                        //sweetAlert("", "Family visit is already booked for " + data.msg + ".", "warning");
                        sweetAlert("", "Family visit is already booked.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data.val == 3) {
                        sweetAlert("", "Family visit cannot be booked for " + data.msg + ".", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data.val == 4) {
                        sweetAlert("", "Booking date should be equal or less than " + data.msg + ".", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data.val == 5) {
                        sweetAlert("", "Validation master not maintained, Kindly contact to SIS team.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data.val == 6) {
                        sweetAlert("", "Family visit booking for " + data.msg + " has exceeded the maximum limit.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data.val == 7) {
                        $("#btnSubmit").attr("disabled", false);
                        swal({
                            title: "",
                            text: data.msg,
                            type: "warning",
                        },
                        function (isConfirm) {
                            if (isConfirm) {
                                arrayBookList = new Array;
                                TotalBookCount = 0;
                            }
                        });
                    }
                    else if (data.val == 8) {
                        sweetAlert("", "Only " + data.msg + " members are allowed for booking.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    else if (data.val == 0 || data.val == -1) {
                        sweetAlert("", "Family visit not booked, Please try again.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    //sa CR7220
                    else if (data.val == 9) {
                        sweetAlert("", "Booking not allowed.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                    //ea CR7220
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function BookingHistory(current) {
            window.location.href = "/BikerCafe/ManageFamilyVisitBooking";
        }

