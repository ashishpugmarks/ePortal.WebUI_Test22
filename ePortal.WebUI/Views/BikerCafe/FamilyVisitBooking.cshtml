                                                               new SelectListItem{ Text="--Select Relation--", Value = "" },
                                                               new SelectListItem{ Text="Brother", Value = "Brother" },
                                                               new SelectListItem{ Text="Sister", Value = "Sister" },
                                                            }, new { @class = "form-control", @id = "ddlRelationType" })
                                                    </td>*@
                                            <td class="text-center hidden" colspan="2"></td>
                                            <td class="text-center">
                                                <button class="btn btn-success glyphicon glyphicon-plus" title="Click here to add member" id="btnAddRow"></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group text-center">
            <input type="button" id="btnSubmit" class="btn btn-success" value="Submit" />
            <input type="button" value="Reset" class="btn btn-default" id="btnReset" />
        </div>

        <div class="form-group">
            <div class="col-md-12 bg-info" style="border: 1px solid #61c0ed;border-radius: 0.25em;padding:8px;">
                <span>
                    <a title="Back" href="/BikerCafe/ManageFamilyVisitBooking">
                        <img src="~/images/icon_back.gif" border="0" alt="">
                        Back
                    </a>
                </span>
            </div>
        </div>

    </div>
</div>

