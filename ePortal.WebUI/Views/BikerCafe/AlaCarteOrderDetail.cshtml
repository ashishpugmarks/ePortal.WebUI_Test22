@model ePortal.ViewModels.AlaCarteHeaderViewModel

@{
    ViewBag.Title = "AlaCarteOrderDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 6px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        table.dataTable {
            clear: both;
            margin-top: 0px !important;
            margin-bottom: 0px !important;
            max-width: none !important;
            border-collapse: separate !important;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        #msform {
            /*text-align: center;*/
            position: relative;
        }

            #msform fieldset {
                background: #fff;
                border: 0 none;
                border-radius: 0px;
                box-shadow: 0 0 1px 1px #337ab7;
                /*padding: 8px 0px;*/
                box-sizing: border-box;
                width: 100%;
                position: relative;
            }

            #msform input, #msform textarea, #msform select {
                padding: 5px;
                border: 1px solid #ccc;
                border-radius: 0px;
                margin-bottom: 8px;
                /*width: 100%;*/
                box-sizing: border-box;
                font-family: arial;
                color: #000;
                font-size: 12px;
            }

        .panel-heading {
            padding: 8px 15px !important;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .div-heading {
            text-align: left;
            height: 2.2em;
            font-weight: bold;
            background-color: #91b4ff;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

            .div-heading div {
                padding: 8px;
            }


        .card {
            position: relative;
            display: flex;
            flex-direction: column;
            min-width: 0;
            word-wrap: break-word;
            /*background-color: #fff;*/
            background-clip: border-box;
            padding: 5px;
            /*border: 1px solid rgba(0,0,0,.125);
                 border-radius: 0.25rem;*/
        }

        .row-card {
            border: 1px solid rgba(0,0,0,.125);
            border-radius: 0.25rem;
            box-shadow: 0 0 10px 1px rgba(0, 0, 0, 0.4);
        }

            .row-card:hover + .booking-button {
                background-color: #f3f3f3;
                display: inline-block;
            }

        .card-body {
            flex: 1 1 auto;
            padding: 1rem 1rem;
            height: 115px;
        }

        .card-title {
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .card-text {
            font-size: small;
            line-height: normal;
        }

        .h-100 {
            height: 100% !important;
        }

        .card-img, .card-img-top {
            border-top-left-radius: calc(0.25rem - 1px);
            border-top-right-radius: calc(0.25rem - 1px);
        }

        .card-img, .card-img-bottom, .card-img-top {
            width: 100%;
        }

        img, svg {
            vertical-align: middle;
        }
    </style>

}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">A La Carte Order Detail</div>
    </div>
    <div class="body-content" style="overflow-x:auto!important;">
        <div class="panel-group">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title">
                        <strong>Order Detail</strong>
                    </h2>
                </div>
                <div class="panel-body">
                    <div id="msform">
                        <div class="form-group">
                            <fieldset>
                                <div class="div-heading">
                                    <div>Requestor Detail's</div>
                                </div>
                                <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                    <div class="col-sm-4 col-md-4 col-lg-4">
                                        @Html.Label("Emp Code") :-  @Model.Emp_Detail?._ECode
                                    </div>
                                    <div class="col-sm-4 col-md-4 col-lg-4">
                                        @Html.Label("Employee Name") :-  @Model.Emp_Detail?._EName
                                    </div>
                                    <div class="col-sm-4 col-md-4 col-lg-4">
                                        @Html.Label("Operation") :-  @Model.Emp_Detail?._OpDesc
                                    </div>
                                </div>
                                <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                    <div class="col-sm-4 col-md-4 col-lg-4">
                                        @Html.Label("Division") :-  @Model.Emp_Detail?._DivDesc
                                    </div>
                                    <div class="col-sm-4 col-md-4 col-lg-4">
                                        @Html.Label("Department") :-  @Model.Emp_Detail?._DepDesc
                                    </div>
                                    <div class="col-sm-4 col-md-4 col-lg-4">
                                        @Html.Label("Section") :-  @Model.Emp_Detail?._SecDescrip
                                    </div>
                                </div>
                            </fieldset>
                        </div>

                        <div class="form-group" style="box-shadow: 0 0 1px 1px #337ab7;">
                            <div class="div-heading">
                                <div>Item Detail's</div>
                            </div>
                            <div class="panel-body">
                                <table class="table table-bordered table-hover table-responsive" id="tbApprovalHis" style="margin-bottom: 0px;">
                                    <thead>
                                        <tr class="bg-info">
                                            <td colspan="8">
                                                <div class="col-md-2 text-right">
                                                    <strong>Order Number</strong>
                                                </div>
                                                <div class="col-md-2">
                                                    @Html.DisplayFor(modelItem => Model.ALACARTEFOODHDR_ID)
                                                </div>
                                                <div class="col-md-2 text-right">
                                                    <strong>Order Date</strong>
                                                </div>
                                                <div class="col-md-2">
                                                    @Html.DisplayFor(modelItem => Model.ORDER_DATE)
                                                </div>
                                                <div class="col-md-2 text-right">
                                                    <strong>Acceptance Date</strong>
                                                </div>
                                                <div class="col-md-2">
                                                    @Html.DisplayFor(modelItem => Model.ACCEPTED_DATE)
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th class="text-center" style="width:5%;">
                                                @Html.DisplayNameFor(model => model.TrnModel[0].ItemModel.BC_FOODMSTID)
                                            </th>
                                            <th class="text-center" style="width:10%;">
                                                @Html.DisplayNameFor(model => model.TrnModel[0].ItemModel.ITEM_CATEGORY)
                                            </th>
                                            <th class="text-center" style="width:15%;">
                                                @Html.DisplayNameFor(model => model.TrnModel[0].ItemModel.ITEM_NAME)
                                            </th>
                                            <th class="text-center" style="width:15%;">
                                                @Html.DisplayNameFor(model => model.TrnModel[0].ItemModel.LEAD_TIME)
                                            </th>
                                            <th class="text-center" style="width:10%;">
                                                @Html.DisplayNameFor(model => model.TrnModel[0].ItemModel.ITEM_PRICE)
                                            </th>
                                            <th class="text-center" style="width:15%;">
                                                @Html.DisplayNameFor(model => model.TrnModel[0].DELIVERY_TYPE)
                                            </th>
                                            <th class="text-center" style="width:15%;">
                                                @Html.DisplayNameFor(model => model.TrnModel[0].ITEM_STATUS)
                                            </th>
                                            <th class="text-center" style="width:15%;">
                                                @Html.DisplayName("Delivery Time")
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int row_No = 0;
                                        }
                                        @if (Model.TrnModel != null)
                                        {
                                            foreach (var item in Model.TrnModel)
                                            {
                                                <tr>
                                                    <td class="text-center">
                                                        @(row_No += 1)
                                                        @Html.HiddenFor(modelItem => item.ItemModel.BC_FOODMSTID)
                                                    </td>
                                                    <td class="text-center">
                                                        @if (item.ItemModel.ITEM_CATEGORY == 1)
                                                        {
                                                            <span>Veg</span>
                                                        }
                                                        else if (item.ItemModel.ITEM_CATEGORY == 1)
                                                        {
                                                            <span>Non Veg</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.ItemModel.ITEM_NAME)
                                                    </td>
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.ItemModel.LEAD_TIME)<span>&nbsp;Minute</span>
                                                    </td>
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.ITEM_PRICE)
                                                    </td>
                                                    <td class="text-center">
                                                        @if (item.DELIVERY_TYPE == 1)
                                                        {
                                                            <span>Dine-in</span>
                                                        }
                                                        else if (item.DELIVERY_TYPE == 2)
                                                        {
                                                            <span>Takeaway</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @if (item.ITEM_STATUS == 1)
                                                        {
                                                            <span class="text-primary">Pending for delivery</span>
                                                        }
                                                        else if (item.ITEM_STATUS == 2)
                                                        {
                                                            <span class="text-danger">Rejected</span>
                                                        }
                                                        else if (item.ITEM_STATUS == 3)
                                                        {
                                                            <span class="text-success">Delivered</span>
                                                        }
                                                        else if (item.ITEM_STATUS == 0)
                                                        {
                                                            <span class="text-warning">Pending for acceptance</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @{
                                                            var deliveryDate = "";
                                                            if (item.ITEM_STATUS == 1 || item.ITEM_STATUS == 3)
                                                            {
                                                                var leadTime = item.ItemModel.LEAD_TIME;
                                                                deliveryDate = Convert.ToDateTime(Model.ACCEPTED_DATE).AddMinutes(leadTime).ToString("hh:mm tt");
                                                            }
                                                            <span>@deliveryDate</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-12 bg-info" style="border: 1px solid #61c0ed;border-radius: 0.25em;padding:8px;">
                                <span>
                                    <a title="Back" href="/BikerCafe/AlaCarteOrderHistory">
                                        <img src="~/images/icon_back.gif" border="0" alt="">
                                        Back
                                    </a>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="ajaxLoader"></div>

@section Scripts {
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {

        });

        function CancelClick() {
            window.location.href = "/Home/Home";
        }
    </script>
}
