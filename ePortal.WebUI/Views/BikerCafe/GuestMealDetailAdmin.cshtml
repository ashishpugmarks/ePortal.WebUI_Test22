@model ePortal.ViewModels.GuestMealBookingTrnViewModel

@{
    ViewBag.Title = "GuestMealApproval";
    Layout = null;
    var imgSrc1 = "";
}

<html>
<head>
    <script src="~/js/jquery.3.6.3.js"></script>
    <script src="~/bootstrap/js/bootstrap.js"></script>
    <script src="~/bootstrap/js/dataTables.bootstrap.js"></script>
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/bootstrap/css/dataTables.bootstrap.css" rel="stylesheet" />

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 6px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        table.dataTable {
            clear: both;
            margin-top: 0px !important;
            margin-bottom: 0px !important;
            max-width: none !important;
            border-collapse: separate !important;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        #msform {
            /*text-align: center;*/
            position: relative;
        }

            #msform fieldset {
                background: #fff;
                border: 0 none;
                border-radius: 0px;
                box-shadow: 0 0 1px 1px #337ab7;
                /*padding: 8px 0px;*/
                box-sizing: border-box;
                width: 100%;
                position: relative;
            }

            #msform input, #msform textarea, #msform select {
                padding: 5px;
                border: 1px solid #ccc;
                border-radius: 0px;
                margin-bottom: 8px;
                /*width: 100%;*/
                box-sizing: border-box;
                font-family: arial;
                color: #000;
                font-size: 12px;
            }

        .panel-heading {
            padding: 8px 15px !important;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .div-heading {
            text-align: left;
            height: 2.2em;
            font-weight: bold;
            background-color: #91b4ff;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

            .div-heading div {
                padding: 8px;
            }


        .card {
            position: relative;
            display: flex;
            flex-direction: column;
            min-width: 0;
            word-wrap: break-word;
            /*background-color: #fff;*/
            background-clip: border-box;
            padding: 5px;
            /*border: 1px solid rgba(0,0,0,.125);
                    border-radius: 0.25rem;*/
        }

        .row-card {
            border: 1px solid rgba(0,0,0,.125);
            border-radius: 0.25rem;
            box-shadow: 0 0 10px 1px rgba(0, 0, 0, 0.4);
        }

            .row-card:hover + .booking-button {
                background-color: #f3f3f3;
                display: inline-block;
            }

        .card-body {
            flex: 1 1 auto;
            padding: 1rem 1rem;
            height: 115px;
        }

        .card-title {
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .card-text {
            font-size: small;
            line-height: normal;
        }

        .h-100 {
            height: 100% !important;
        }

        .card-img, .card-img-top {
            border-top-left-radius: calc(0.25rem - 1px);
            border-top-right-radius: calc(0.25rem - 1px);
        }

        .card-img, .card-img-bottom, .card-img-top {
            width: 100%;
        }

        img, svg {
            vertical-align: middle;
        }
    </style>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {

        });

        function CancelClick() {
            window.location.href = "/Home/Home";
        }
    </script>
</head>

<body>
    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Guest Meal Detail</div>
        </div>
        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Booking Request Detail</strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <div id="msform">
                            <div class="form-group">
                                <fieldset>
                                    <div class="div-heading">
                                        <div>Requestor Detail's</div>
                                    </div>
                                    <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Emp Code") :-  @Model.Emp_Detail._ECode
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Employee Name") :-  @Model.Emp_Detail._EName
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Operation") :-  @Model.Emp_Detail._OpDesc
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Division") :-  @Model.Emp_Detail._DivDesc
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Department") :-  @Model.Emp_Detail._DepDesc
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Section") :-  @Model.Emp_Detail._SecDescrip
                                        </div>
                                    </div>
                                </fieldset>
                            </div>

                            <div class="form-group" style="box-shadow: 0 0 1px 1px #337ab7;">
                                <div class="div-heading">
                                    <div class="col-sm-6 col-md-8 col-lg-9"> Guest Meal Detail's</div>
                                </div>
                                <div class="panel-body">
                                    <table class="table table-bordered table-hover table-responsive" style="margin-bottom: 0px;">
                                        <tbody>
                                            <tr>
                                                <td style="width:20%;">
                                                    @Html.LabelFor(model => model.MEAL_BOOKED_DATE, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.MEAL_BOOKED_DATE)
                                                </td>
                                                <td rowspan="5" width="40%;" style="vertical-align:top;">
                                                    @{
                                                        imgSrc1 = "";
                                                        var base164 = Convert.ToBase64String(Model.MealMst.MEAL_PHOTO);
                                                        var contentType = Model.MealMst.MEAL_PHOTO_NAME.Split('.')[1];
                                                        imgSrc1 = String.Format("data:" + contentType + ";base64,{0}", base164);

                                                        <div class="card col-xs-12 col-sm-12 col-md-12">
                                                            <div class="row-card">
                                                                <div class="col-md-5" style="background: #868e96; padding:0px;height: 135px;">
                                                                    <img src="@imgSrc1" class="card-img-top h-100" alt="@Model.MealMst.MEAL_PHOTO_NAME" />
                                                                </div>
                                                                <div class="col-md-7" style="padding:0px;">
                                                                    <div class="card-body">
                                                                        <h5 class="card-title">@Model.MealMst.MEAL_NAME&nbsp;(@Model.MealType.MEAL_TYPE_DESC)</h5>
                                                                        <p class="card-text">@Model.MealMst.MEAL_DESC</p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.PAYMENT_TYPE, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @{
                                                        if (Model.PAYMENT_TYPE == 1)
                                                        {
                                                            <span>Self Paid</span>
                                                        }
                                                        else if (Model.PAYMENT_TYPE == 2)
                                                        {
                                                            <span>Company Paid</span>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.MEAL_STATUS, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @if (Model.MEAL_STATUS == 1)
                                                    {
                                                        <button class="btn btn-success btn-xs" style="cursor: text !important">Booked</button>
                                                    }
                                                    else if (Model.MEAL_STATUS == 2)
                                                    {
                                                        <button class="btn btn-danger btn-xs" style="cursor: text !important">Cancelled</button>
                                                    }
                                                    else if (Model.MEAL_STATUS == 3)
                                                    {
                                                        <button class="btn btn-danger btn-xs" style="cursor: text !important">Rejected</button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-warning btn-xs" style="cursor: text !important">Pending for Approval</button>
                                                    }
                                                </td>
                                            </tr>
                                            @*<tr>
                                                <td>
                                                    @Html.LabelFor(model => model.APPROVE_STATUS, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @if (Model.APPROVE_STATUS == 1)
                                                    {
                                                        <sapn>Approved</sapn>
                                                    }
                                                    else if (Model.APPROVE_STATUS == 2)
                                                    {
                                                        <span>Rejected</span>
                                                    }
                                                    else if (Model.APPROVE_STATUS == 0)
                                                    {
                                                        <span>Pending for Approval</span>
                                                    }
                                                </td>
                                            </tr>*@
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.APPROVER_NAME, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.APPROVER_NAME)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.APPROVE_DATE, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.APPROVE_DATE)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.APPROVE_REMARK, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td colspan="2">
                                                    @Html.DisplayFor(model => model.APPROVE_REMARK)
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="form-group" style="box-shadow: 0 0 1px 1px #337ab7;">
                                <div class="div-heading">
                                    <div>Guest Detail's</div>
                                </div>
                                <div class="panel-body">
                                    <table class="table table-bordered table-hover table-responsive" id="tbApprovalHis" style="margin-bottom: 0px;">
                                        <thead>
                                            <tr class="bg-info">
                                                <th class="text-center" style="width:5%;">
                                                    @Html.DisplayNameFor(model => model.GuestDtlList[0].BC_GUESTID)
                                                </th>
                                                <th class="text-left" style="width:19%;">
                                                    @Html.DisplayNameFor(model => model.GuestDtlList[0].GUEST_NAME)
                                                </th>
                                                <th class="text-center" style="width:19%;">
                                                    @Html.DisplayNameFor(model => model.GuestDtlList[0].MOBILE_NUMBER)
                                                </th>
                                                <th class="text-left" style="width:19%;">
                                                    @Html.DisplayNameFor(model => model.GuestDtlList[0].COMPANY)
                                                </th>
                                                <th class="text-center" style="width:19%;">
                                                    @Html.DisplayNameFor(model => model.GuestDtlList[0].TOKEN_CODE)
                                                </th>
                                                <th class="text-center" style="width:19%;">
                                                    @Html.DisplayNameFor(model => model.GuestDtlList[0].MEAL_PRICE)
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int row_No = 0;
                                            }
                                            @if (Model.GuestDtlList != null)
                                            {
                                                foreach (var item in Model.GuestDtlList)
                                                {
                                                    <tr>
                                                        <td class="text-center">
                                                            @(row_No += 1)
                                                            @Html.HiddenFor(modelItem => item.BC_GUESTID)
                                                        </td>
                                                        <td class="text-left">
                                                            @Html.DisplayFor(modelItem => item.GUEST_NAME)
                                                        </td>
                                                        <td class="text-center">
                                                            @Html.DisplayFor(modelItem => item.MOBILE_NUMBER)
                                                        </td>
                                                        <td class="text-left">
                                                            @Html.DisplayFor(modelItem => item.COMPANY)
                                                        </td>
                                                        <td class="text-center">
                                                            @Html.DisplayFor(modelItem => item.TOKEN_CODE)
                                                        </td>
                                                        <td class="text-right">
                                                            @Html.DisplayFor(modelItem => item.MEAL_PRICE)
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="ajaxLoader"></div>

</body>

</html>
