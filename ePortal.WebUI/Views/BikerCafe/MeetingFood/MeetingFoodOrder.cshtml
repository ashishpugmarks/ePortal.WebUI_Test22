@section Scripts{
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        var arrayList = new Array, TotalRowCount = 0;


        $(document).ready(function () {
            $("#tbAlaCarteFood").dataTable({
                "ordering": false,
                "bFilter": false,
                "bLengthChange": false,
                "bInfo": false,
                "scrollY": 200,
                "scrollX": true,
                scrollCollapse: true,
                paging: false,
                "oLanguage": {
                    "sEmptyTable": "Food item not found"
                }
            });
            $('.dpDate').datepicker({
                 format: "dd-M-yyyy",
                //format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                clearBtn: true,
                startDate: "today"

            });
            $("#txtStartDate").val('@ViewBag.strFromDate');
        });

        function AddRecord(current) {
            if (arrayList == null || arrayList.length == 0) {
                arrayList = new Array;
            }

            var _itemName = "#hfitemName_" + current.id;
            var _price = "#hfPrice_" + current.id;
            var _qty = "#txtQty_" + current.id;

            if ($(_qty).val() > 0) {
                var data = {
                    ALACARTEFOODTRN_ID: 0,
                    ALACARTEFOODHDR_ID: 0,
                    ITEMID: current.id,
                    ITEM_NAME: $(_itemName).val(),
                    ITEM_PRICE: $(_price).val(),
                    ITEM_QTY: $(_qty).val()

                }

                var existArrayIbj = $.grep(arrayList, function (e) {
                    return e.ITEMID == data.ITEMID;
                });
                if (existArrayIbj.length > 0) {
                    sweetAlert("", "Item is already added", "warning");
                    return;
                }

                TotalRowCount += 1;
                arrayList.push(data);
                BindOrder(arrayList);
            }
            else {
                $(_qty).addClass('validationError');
            }
        }

        function DeleteItem(current) {
            arrayList = $.grep(arrayList, function (e) {
                return e.ITEMID != current.id;
            });
            TotalRowCount = TotalRowCount - 1;
            BindOrder(arrayList);
        }

        function BindOrder(attList) {
            var rows = "", rowId = 0; grandTotal = 0; price = 0;
            if (attList != null) {
                if (attList.length > 0) {
                    $.each(attList, function (i, item) {
                        rowId = i + 1;
                        price = (parseInt(item.ITEM_PRICE));
                        grandTotal = parseInt(grandTotal) + (parseInt(item.ITEM_PRICE) * parseInt(item.ITEM_QTY));
                        rows += "<tr class='tr_order'><td>" + item.ITEM_NAME + "</td>"
                        rows += "<td class='text-center'>" + item.ITEM_QTY + "</td>"
                        rows += "<td class='text-right'>" + price.toFixed(2) + "</td>"
                        rows += "<td class='text-center'><a class='glyphicon glyphicon-remove text-danger' id='" + item.ITEMID + "' style='cursor: pointer;' title='Click here to remove item.' data-ctrl='anc-del-item'></a></td>"
                        rows += "</tr>"
                    });
                    rows += "<tr><td colspan='3' class='text-right'><b>Grand Total :- " + grandTotal.toFixed(2) + "</b></td><td></td>"
                    document.getElementById("append_docRow").innerHTML = rows;

                    //CSP 3.0 Compliant changes
                    $(document).on("click", "[data-ctrl='anc-del-item']", function () {
                        DeleteItem($(this)[0]);
                    });
                }
                else {
                    var _row = '<tr class="odd"><td valign="top" colspan="4" class="dataTables_empty">Food item not found</td></tr>'
                    document.getElementById("append_docRow").innerHTML = _row;
                }
            }
        }

        function SaveData(current) {

               var selectedFromDate = $('#txtStartDate').val();
               
               if (!selectedFromDate) {
                     sweetAlert("", "Please select event date.", "warning");
                    return false;
                }

            if (TotalRowCount == 0) {
                sweetAlert("", "Item not found, Please add item.", "warning");
                return;
            }
            if ($("#txtVenue").val() == "") {
                sweetAlert("", "Venue is mandatory fields.", "warning");
                $("#txtVenue").focus();
                return;
            }

            if ($("#txtRemarks").val() == "") {
                sweetAlert("", "Remarks is mandatory fields.", "warning");
                $("#txtRemarks").focus();
                return;
            }
            if ($("#noOfGuests").val() == "") {
                sweetAlert("", "No of Guests is mandatory fields.", "warning");
                $("#noOfGuests").focus();
                return;
            }
            debugger;
            $("#btnSubmit").attr("disabled", true);

                    //var dateString = $('#txtStartDate').val(); // "24-May-2025"

        // // Convert it to JavaScript Date object
        // var parsedDate = $.datepicker.parseDate('dd-M-yy', dateString);
                
        // //var formattedDate = parsedDate.toISOString(); // "2025-05-24"
        //  var formattedDate = $.datepicker.formatDate('yy-mm-dd', parsedDate);


            var data1 = {

                EVENT_DATE: getLocalISOString($('#txtStartDate').val()),
                //EVENT_DATE_OFFSET:formattedDate,
                EVENTTIME: $('#ddStartHour').val() + ":" + $('#ddStartMinute').val(),
                VENUE: $('#txtVenue').val(),
                REMARKS: $('#txtRemarks').val(),
                TrnModel: arrayList,
                NoOfGuests: $('#noOfGuests').val()

            }

            $.ajax({
                type: "POST",

                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/BikerCafe/MeetingFoodOrder",

                // data: JSON.stringify({ model: data1 }),
                data: JSON.stringify(data1),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data.val == 1) {
                        swal({
                            title: "",
                            text: "Food is ordered successfully",
                            type: "success",
                        },
                        function (isConfirm) {
                            if (isConfirm) {
                                window.location.href = "/BikerCafe/MeetingFoodOrderHistory";
                            }
                        });
                    }
                    else if (data.val == 0 || data.val == -1) {
                        sweetAlert("", "Food not ordered, Please try again.", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function OrderHistory(current) {
            window.location.href = "/BikerCafe/MeetingFoodOrderHistory";
        }

                function getLocalISOString(dateStr) {
            let date = new Date(dateStr);
            date.setMinutes(date.getMinutes() - date.getTimezoneOffset());
            return date.toISOString();
        }
    </script>

    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#btnOrderHistory').on('click', function () {
                OrderHistory($(this)[0]);
            });
            $('#btnSubmit').on('click', function () {
                SaveData($(this)[0]);
            });
            $('#btnCancel').on('click', function () {
                location.href = '@Url.Action("MeetingFoodOrder", "BikerCafe")';
            });
            $('[data-ctrl="txt-qty-fmstid"]').on('input', function () {
                if ($(this).val().length > parseInt($(this).attr('maxlength')))
                    $(this).val($(this).val().slice(0, parseInt($(this).attr('maxlength'))));
            });
            $(document).on('click', '[data-ctrl="btn-add-record"]', function () {
                AddRecord($(this)[0]);
            });
        });
    </script>
}
