@model IEnumerable<ePortal.ViewModels.GuestMealBookingTrnViewModel>

@{
    ViewBag.Title = "ManageGuestMealBooking";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var imgSrc1 = "";
}

@section Styles{
    @* <link href="~/css/jquery-ui.min.css" rel="stylesheet" /> *@
    <link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet" />

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 6px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .card-title {
            margin-bottom: 0.2rem;
            font-weight: 600;
        }

        .card-text {
            font-size: small;
            line-height: normal;
        }
    </style>
}


    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                Manage Guest Meal Booking
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>List of Meal Booking</strong>
                            <strong class="pull-right">
                                <input type="button" class="btn btn-success btn-xs" id="btnMealBooking" value="Meal Booking" />
                            </strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <div class="form-group">
                            @* @Html.Label("Meal Type", new { @class = "control-label text-right col-xs-4 col-sm-2 col-md-1", @style = "margin-top: 7px;padding-bottom: 5px;" }) *@
                        <label class="control-label text-right col-xs-4 col-sm-2 col-md-1" style="margin-top: 7px;padding-bottom: 5px;">Meal Type</label>
                            <div class="col-xs-8 col-sm-2 col-md-2 col-lg-2" style="padding-bottom: 5px;">
                                @Html.DropDownList("MealType", new SelectList(ViewBag.MEALTYPES.Items, "BC_MEALTYPEID", "MEAL_TYPE_DESC"), "- All -", new { @id = "ddlMealType", @class = "form-control" })
                            </div>

                            @* @Html.Label("From Date", new { @class = "control-label text-right col-xs-4 col-sm-2 col-md-2", @style = "margin-top: 7px;padding-bottom: 5px; width: 14.67%;" }) *@
                        <label class="control-label text-right col-xs-4 col-sm-2 col-md-2" style="margin-top: 7px;padding-bottom: 5px; width: 14.67%;">From Date</label>
                            <div class="col-xs-8 col-sm-3 col-md-2 col-lg-2" style="padding-bottom: 5px;width: 13.67%;">
                                <input type="text" id="txtBookingFrom" readonly="readonly" class="form-control datepic" placeholder="From date" />
                                @*@Html.TextBox("FromDate", new { @class = "form-control datepic", @id = "txtBookingFrom", @readonly = "readonly", @placeholder = "From date" })*@
                            </div>

                            @* @Html.Label("To Date", new { @class = "control-label text-right col-xs-4 col-sm-2 col-md-2", @style = "margin-top: 7px;padding-bottom: 5px;width: 14.67%;" }) *@
                        <label class="control-label text-right col-xs-4 col-sm-2 col-md-2" style="margin-top: 7px;padding-bottom: 5px;width: 14.67%;">To Date</label>
                            <div class="col-xs-8 col-sm-3 col-md-2 col-lg-2" style="padding-bottom: 5px;width: 13.67%;">
                                @*@Html.TextBox("ToDate", new { @class = "form-control datepic", @id = "txtBookingTo", @readonly = "readonly", @placeholder = "To date" })*@
                                <input type="text" id="txtBookingTo" readonly="readonly" class="form-control datepic" placeholder="To date" />
                            </div>

                            <div class="col-xs-12 col-sm-3 col-md-2 col-lg-2 text-center">
                                <input type="button" id="btnSearch" class="btn btn-primary btn-sm" value="Search" />
                                <input type="button" value="Reset" class="btn btn-default btn-sm" id="btnReset" />
                            </div>
                        </div>


                        <table class="table table-bordered table-hover table-responsive" id="tbManageGuestMealBooking">
                            <thead>
                                <tr class="bg-info">
                                    <th class="text-center" style="width:4%;">
                                        @Html.DisplayNameFor(model => model.BC_GUEST_BOOKINGID)
                                    </th>
                                    <th class="text-center" style="width:8%;">
                                        @Html.DisplayNameFor(model => model.MEAL_BOOKED_DATE)
                                    </th>
                                    <th class="text-center" style="width:12%;">
                                        @Html.DisplayNameFor(model => model.SLOTMSTID)
                                    </th>
                                    <th style="width: 25%;">
                                        @Html.DisplayNameFor(model => model.MealMst.MEAL_DESC)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayNameFor(model => model.PAYMENT_TYPE)
                                    </th>
                                    <th class="text-center">
                                        @Html.DisplayName("No of Guest")
                                    </th>
                                    <th style="width: 17%;">
                                        @Html.DisplayName("Approval")
                                    </th>
                                    <th class="text-center" style="width:11%;">
                                        @Html.DisplayNameFor(model => model.MEAL_STATUS)
                                    </th>
                                    <th class="text-center" style="width:6%;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNo = 0;
                                }
                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        var NoOfGuest = item.GuestDtlList.Count();
                                        <tr>
                                            <td class="text-center">
                                                @(rowNo += 1)
                                                @Html.HiddenFor(modelItem => item.BC_GUEST_BOOKINGID)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.MEAL_BOOKED_DATE)
                                            </td>
                                            <td class="text-center">
                                                @Html.DisplayFor(modelItem => item.SLOT_TIME)
                                            </td>
                                            <td>
                                                <div class="card-body">
                                                    <h5 class="card-title">@item.MealMst.MEAL_NAME&nbsp;(@item.MealType.MEAL_TYPE_DESC)</h5>
                                                    <p class="card-text">@item.MealMst.MEAL_DESC</p>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                @{
                                                    if (item.PAYMENT_TYPE == 1)
                                                    {
                                                        <span>Self Paid</span>
                                                    }
                                                    else if (item.PAYMENT_TYPE == 2)
                                                    {
                                                        <span>Company Paid</span>
                                                    }
                                                }
                                            </td>
                                            <td class="text-center">
                                                @NoOfGuest
                                            </td>
                                            <td>
                                                <div class="card-body">
                                                    @{
                                                        var app_msg = "";
                                                        if (item.APPROVE_STATUS == 0)
                                                        {
                                                            if (item.MEAL_STATUS == 0)
                                                            {
                                                                app_msg = "Pending at " + item.APPROVER_NAME;
                                                            }
                                                            else if (item.MEAL_STATUS == 2)
                                                            {
                                                                app_msg = "Cancelled by user";
                                                            }
                                                        }
                                                        else if (item.APPROVE_STATUS == 1)
                                                        {
                                                            app_msg = "Approved by " + item.APPROVER_NAME;
                                                        }
                                                        else if (item.APPROVE_STATUS == 2)
                                                        {
                                                            app_msg = "Rejcted by " + item.APPROVER_NAME;
                                                        }
                                                        else
                                                        {
                                                            if (item.MEAL_STATUS == 2)
                                                            {
                                                                app_msg = "Cancelled by user";
                                                            }
                                                            else
                                                            {
                                                                app_msg = "Approval not required";
                                                            }
                                                        }

                                                        <h5 class="card-text">@app_msg</h5>
                                                        if (!string.IsNullOrEmpty(item.APPROVE_REMARK))
                                                        {
                                                            <span class="card-title">Remark:- </span>

                                                            <span class="card-text">@item.APPROVE_REMARK</span>
                                                        }
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                @if (item.MEAL_STATUS == 1)
                                                {
                                                    <button class="btn btn-success btn-xs" style="cursor: text !important">Booked</button>
                                                }
                                                else if (item.MEAL_STATUS == 2)
                                                {
                                                    <button class="btn btn-danger btn-xs" style="cursor: text !important">Cancelled</button>
                                                }
                                                else if (item.MEAL_STATUS == 3)
                                                {
                                                    <button class="btn btn-danger btn-xs" style="cursor: text !important">Rejected</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-warning btn-xs" style="cursor: text !important">Pending for Approval</button>
                                                }
                                            </td>

                                            <td class="text-center">
                                                @{
                                                    imgSrc1 = "";
                                                    var base164 = Convert.ToBase64String(item.MealMst.MEAL_PHOTO);
                                                    var contentType = item.MealMst.MEAL_PHOTO_NAME.Split('.')[1];
                                                    imgSrc1 = String.Format("data:" + contentType + ";base64,{0}", base164);
                                                }
                                                <button class="btn btn-info btn-xs glyphicon glyphicon-tasks" title="Click here to view detail" data-ctrl="view-booking-btn" data-guest-booking-id="@item.BC_GUEST_BOOKINGID"></button>
                                                @if ((item.MEAL_STATUS == 1 || item.MEAL_STATUS == 0) && item.IsEnableCancel)
                                                {
                                                    <button class="btn btn-danger btn-xs glyphicon glyphicon-remove" title="Click here to cancel" data-ctrl="cancel-booking-btn" data-guest-booking-id="@item.BC_GUEST_BOOKINGID"></button>
                                                }
                                                else if (item.MEAL_STATUS == 0 && item.PAYMENT_TYPE == 2)
                                                {
                                                    <button class="btn btn-danger btn-xs glyphicon glyphicon-remove" title="Click here to cancel" data-ctrl="cancel-booking-btn" data-guest-booking-id="@item.BC_GUEST_BOOKINGID"></button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <form id="_form" action="@Url.Action("ManageGuestMealBooking","BikerCafe")" method="post">
                <input type="hidden" id="hfMealTypeId" name="typeId" value="" />
                <input type="hidden" id="hfFromDate" name="fromDate" value="" />
                <input type="hidden" id="hfToDate" name="toDate" value="" />
            </form>

            <div class="form-group">
                <div class="col-md-12 bg-info" style="border: 1px solid #61c0ed;border-radius: 0.25em;padding:8px;">
                    <span>
                        <a title="Back" href="/Home/Home">
                            <img src="~/images/icon_back.gif" border="0" alt="">
                            Back
                        </a>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div id="ajaxLoader"></div>

@section Scripts{
    @* <script src="~/js/jquery-ui.min.js"></script> *@
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js" ></script>

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $("#tbManageGuestMealBooking").dataTable({
                "bFilter": true,
                "bLengthChange": true
            });

            $('.datepic').datepicker({
                format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top',
            });            

            $("#ddlMealType").val('@ViewBag.mealType');
            $("#txtBookingFrom").val('@ViewBag.strFromDate');
            $("#txtBookingTo").val('@ViewBag.strToDate');

        });

        function ViewDetail(id) {
            window.location.href = "/BikerCafe/GuestMealDetail?id=" + id;
        }

        function GetRecord(current) {

               var selectedFromDate = $('#txtBookingFrom').val();
                var selectedToDate = $('#txtBookingTo').val();

               if (!selectedFromDate || !selectedToDate) {
                     sweetAlert("", "Please select date!", "warning");
                    return false;
                }

            if ($("#ddlMealType").val() != "") {
                $('#hfMealTypeId').val($("#ddlMealType").val());
            }
            if ($("#txtBookingFrom").val() != "") {
                $('#hfFromDate').val($("#txtBookingFrom").val());
            }
            if ($("#txtBookingTo").val() != "") {
                $('#hfToDate').val($("#txtBookingTo").val());
            }
            $('#_form').submit();
        }

        function CancelBooking(row_id) {
            swal({
                title: "Do you want to cancel the booking ?",
                text: "",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, cancel it!",
                cancelButtonText: "No",
                closeOnConfirm: false,
                closeOnCancel: true
            },
            function (isConfirm) {
                if (isConfirm) {
                    $.ajax({
                        type: "POST",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        url: "/BikerCafe/CancelGuestMealBooking",
                        contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                        datatype: "json",
                        data: { id: row_id },
                        success: function (data) {
                            if (data == 1) {
                                swal({
                                    title: "",
                                    text: "Meal booking cancelled successfully.",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                        window.location.href = "/BikerCafe/ManageGuestMealBooking";
                                    }
                                });
                            }
                            else {
                                sweetAlert("", "Meal booking not cancelled, Please try again.", "warning");
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }
            });
        }

        function MealReservation(current) {
            window.location.href = "/BikerCafe/GuestMealBooking";
        }
    </script>

    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#btnReset').on('click', function () {
                location.href = '@Url.Action("ManageGuestMealBooking", "BikerCafe")';
            });
            $('#btnSearch').on('click', function () {
                GetRecord($(this)[0]);
            });
            $('#btnMealBooking').on('click', function () {
                MealReservation($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="cancel-booking-btn"]', function () {
                var bookingId = $(this).data('guest-booking-id');
                CancelBooking(bookingId);
            });
            $(document).on('click', '[data-ctrl="view-booking-btn"]', function () {
                var bookingId = $(this).data('guest-booking-id');
                ViewDetail(bookingId);
            });
        });
    </script>
}
