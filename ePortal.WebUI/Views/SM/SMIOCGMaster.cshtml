@model ePortal.ViewModels.SearchIOCGMaster
@{
    ViewBag.Title = "IOCG Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .form-control {
            height: 28px;
            padding: 3px 3px;
            font-size: 13px;
        }
    </style>
}
   
    
    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                IOCG Master
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Search</strong>
                        </h2>
                    </div>
                    <div class="panel-body" style="padding:5px;">
                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.KI, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.KI, new SelectList(ViewBag.KIList.Items, "Value", "Text"), new { @id = "ddlKI", @class = "form-control", @data_current_ki = "" + Model.curr_KI + "" })
                            </div>
                            @Html.LabelFor(model => model.OperationID, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.OperationID, new SelectList(ViewBag.OPList.Items, "ADORGLEVELID", "LEVELDESCRIP"), "- Select -", new { @id = "ddlOP", @class = "form-control" })
                            </div>
                            @Html.LabelFor(model => model.DivisionID, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.DivisionID, new SelectList(ViewBag.DivList.Items, "ADORGLEVELID", "LEVELDESCRIP"), "- Select -", new { @id = "ddlDiv", @class = "form-control" })
                            </div>
                        </div>
                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.DEPTID, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.DEPTID, new SelectList(ViewBag.DepList.Items, "ADORGLEVELID", "LEVELDESCRIP"), "- Select -", new { @id = "ddlDep", @class = "form-control" })
                            </div>
                            @Html.LabelFor(model => model.SECID, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.SECID, new SelectList(ViewBag.SecList.Items, "ADORGLEVELID", "LEVELDESCRIP"), "- Select -", new { @id = "ddlSec", @class = "form-control" })
                            </div>
                            @Html.LabelFor(model => model.STATUS, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                <select id="ddlStatus" class="form-control">
                                    <option value="1">Active</option>
                                    <option value="0">Deactive</option>
                                </select>
                            </div>
                        </div>
                        <div class="row" style="padding:2px;">
                            <div class="col-md-12 col-lg-12 text-center">
                                <button id="btnSubmit" class="btn btn-success btn-sm">Search</button>
                                @*<button id="btnExcel" onclick="GetExcel(this); return false" class="btn btn-primary btn-sm">Export To Excel</button>*@
                                <input type="button" value="Reset" class="btn btn-default btn-sm" id="btnReset" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="ajaxLoader"></div>
            <div id="div_append"></div>
        </div>
    </div>
    <div id="myCreateModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="padding:10px!important;">
                    <div class="pull-left">
                        <h5 class="modal-title"><span id="sp_type"></span></h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body" style="padding:10px!important;">
                    <div id="myCreateModelContent"></div>
                </div>
            </div>
        </div>
    </div>
@section Scripts{

    <script src="~/js/jquery.validate.min.js"></script>
    <script src="~/js/jquery.validate.unobtrusive.min.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $('.datepic').datepicker({
                format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top'
            });

            @*function GetExcel(crnt) {
                var data = {
                    OperationID: $('#ddlOp').val() == "" ? 0 : $('#ddlOp').val(),
                    DivisionID: $('#ddlDiv').val() == "" ? 0 : $('#ddlDiv').val(),
                    DEPTID: $('#ddlDep').val() == "" ? 0 : $('#ddlDep').val(),
                    SECID: $('#ddlSec').val() == "" ? 0 : $('#ddlSec').val(),
                    IndentNo: $('#txtIndentNo').val(),
                    ecode: $('#txtEmpCode').val() == "" ? 0 : $('#txtEmpCode').val(),
                    Startdate: $('#txtStartdate').val(),
                    ENDDATE: $('#txtENDDATE').val(),
                    PRStatus: $('#ddlPrStatus').val()
                }
                $.ajax({
                    type: "POST",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    url: "/PR/ExportToExcelUser",
                    data: JSON.stringify(data),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data == 1) {
                            window.location.href = "@Url.RouteUrl(new { Controller = "PR", Action = "DownloadExcelUser" })";
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }*@
        });
        ////======== Bind Section========////
        function BindKI(crnt, call) {
            debugger;
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            if (dID == call) {
                $("#ddlOP").attr("disabled", false);
                $("#ddlDiv").attr("disabled", false);
                $("#ddlDep").attr("disabled", false);
                $("#ddlSec").attr("disabled", false);
            }
            else {
                $("#ddlOP").attr("disabled", true);
                $("#ddlDiv").attr("disabled", true);
                $("#ddlDep").attr("disabled", true);
                $("#ddlSec").attr("disabled", true);
            }
        }
        ////======== Bind Division========////
        function BindDivision() {
            debugger;
            var dID = $("#ddlOP").val();
            if (dID == "") {
                dID = 0;
            }
            /// --- Clear Dropdown --- ///
            var divSelect = $("#ddlDiv");
            divSelect.empty();
            divSelect.append($('<option/>', {
                value: 0,
                text: "--No record--"
            }));

            var depSelect = $("#ddlDep");
            depSelect.empty();
            depSelect.append($('<option/>', {
                value: 0,
                text: "--No record--"
            }));

            var secSelect = $("#ddlSec");
            secSelect.empty();
            secSelect.append($('<option/>', {
                value: 0,
                text: "--No record--"
            }));

            $.getJSON("/SM/BindDivisionByOperationId", { id: dID },
                   function (data) {
                       var select = $("#ddlDiv");
                       select.empty();
                       if (data.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "-Select-"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.ADORGLEVELID,
                               text: itemData.LEVELDESCRIP
                           }));
                       });
                       @*if ('@Model.DivisionID' != '' && call == 1) {
                           $("#ddlDiv").val('@Model.DivisionID');
                       }*@
                   });
        }

        ////======== Bind Department========////
        function BindDepartment(crnt, call) {
            debugger;
            var dID = $(crnt).val();
            var opid_v = $("#ddlOP").val();
            if (dID == "") {
                dID = 0;
            }
            $.getJSON("/SM/BindDeptByDivisionId", { divid: dID, opid: opid_v },
                   function (data) {
                       var select = $("#ddlDep");
                       select.empty();
                       if (data.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.ADORGLEVELID,
                               text: itemData.LEVELDESCRIP
                           }));
                       });
                       @*if ('@Model.DEPTID' != '' && call == 1) {
                           $("#ddlDep").val('@Model.DEPTID');
                       }*@
                   });
        }

        ////======== Bind Section========////
        function BindSection(crnt, call) {
            debugger;
            var dID = $(crnt).val();
            var div = $('#ddlDiv').val();
            var opid_v = $("#ddlOP").val();
            if (dID == "") {
                dID = 0;
            }
            $.getJSON("/SM/BindSecByDepartmentId", { opid: opid_v, divid: div, deptid: dID },
                   function (data) {
                       var select = $("#ddlSec");
                       select.empty();
                       if (data.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.ADORGLEVELID,
                               text: itemData.LEVELDESCRIP
                           }));
                       });
                       @*if ('@Model.SECID' != '' && call == 1) {
                           $("#ddlSec").val('@Model.SECID');
                       }*@
                   });
        }
        function GetReportList(crnt) {
            debugger;
            var data = {
                OperationID: $('#ddlOP').val() == "" ? 0 : $('#ddlOP').val(),
                DivisionID: $('#ddlDiv').val() == "" ? 0 : $('#ddlDiv').val(),
                DEPTID: $('#ddlDep').val() == "" ? 0 : $('#ddlDep').val(),
                SECID: $('#ddlSec').val() == "" ? 0 : $('#ddlSec').val(),
                KI: $('#ddlKI').val(),
                STATUS: $('#ddlStatus').val(),
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SM/SMIOCGMASTER",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#div_append').html(data);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
        function EditMaster(row_id) {
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SM/EditIOCGMaster",
                //contentType: "application/json; charset=utf-8",
                //datatype: "json",
                data: { id: row_id },
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#sp_type').html("Edit Master");
                        $('#myCreateModelContent').html(data);
                        $('#myCreateModel').modal({ backdrop: "static" });
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
        function SaveMaster() {
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SM/SaveIOCGMaster",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#sp_type').html("Save Master");
                        $('#myCreateModelContent').html(data);
                        $('#myCreateModel').modal({ backdrop: "static" });
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
    </script>

    @* Adding event handlers to satisfy csp validation rules *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#btnReset').on('click', function () {
                location.href='@Url.Action("SMIOCGMaster", "SM")';
            });
            $('#btnSubmit').on('click', function (e) {
                e.preventDefault();
                GetReportList($(this)[0]);
                return false;
            });

            $('#ddlDep').on('change', function () {
                BindSection($(this)[0], 0);
            });
            $('#ddlDiv').on('change', function () {
                BindDepartment($(this)[0], 0);
            });
            $('#ddlOP').on('change', function () {
                BindDivision();
            });
            $('#ddlKI').on('change', function () {
                BindKI($(this)[0], $(this).data('current-ki'));
            });
        });
    </script>

}
