@model ePortal.ViewModels.SearchSMViewModel

@{
    ViewBag.Title = "SMDashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    @* <link href="~/lib/bootstrap/css/bootstrap-multiselect.css" rel="stylesheet" /> *@

    <link href="~/lib/bootstrap/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .form-control {
            height: 28px;
            padding: 3px 3px;
            font-size: 13px;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .ui-widget {
            overflow: auto;
            max-height: 200px;
        }

        .ui-autocomplete {
            position: absolute;
            top: 100%;
            left: 0;
            z-index: 1000;
            display: none;
            float: left;
            min-width: 160px;
            padding: 5px 0;
            margin: 2px 0 0;
            list-style: none;
            font-size: 14px;
            text-align: left;
            background-color: #ffffff;
            border: 1px solid #cccccc;
            border: 1px solid rgba(0, 0, 0, 0.15);
            border-radius: 4px;
            -webkit-box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
            background-clip: padding-box;
        }

            .ui-autocomplete > li > div {
                display: block;
                padding: 3px 20px;
                clear: both;
                font-weight: normal;
                line-height: 1.42857143;
                color: #333333;
                white-space: nowrap;
            }

        .ui-state-hover,
        .ui-state-active,
        .ui-state-focus {
            text-decoration: none;
            color: #262626;
            background-color: #f5f5f5;
            cursor: pointer;
        }

        .ui-helper-hidden-accessible {
            border: 0;
            clip: rect(0 0 0 0);
            height: 1px;
            margin: -1px;
            overflow: hidden;
            padding: 0;
            position: absolute;
            width: 1px;
        }
    </style>

}
    @* <link href="~/assets/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/assets/js/jquery-ui.js"></script>
    <link href="~/assets/lib/bootstrap/css/bootstrap-multiselect.css" rel="stylesheet" />
    <script src="~/assets/lib/bootstrap/js/bootstrap-multiselect.js"></script> *@
    
   
    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                SES/MRM Dashboard
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Search</strong>
                        </h2>
                    </div>
                    <div class="panel-body" style="padding:5px;">
                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.SMNo, new { @class = "control-label text-right col-md-1", @style = "width:140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.TextBoxFor(model => model.SMNo, new { @value = "", @id = "txtSMNo", @class = "form-control", @style = "width: 150px;" })
                            </div>

                            @Html.LabelFor(model => model.OperationID, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.OperationID, new SelectList(ViewBag.OpList.Items, "ADORGLEVELID", "LEVELDESCRIP"), "- Select -", new { @id = "ddlOp", @class = "form-control" })
                            </div>

                            @Html.LabelFor(model => model.DivisionID, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:19.66%;">
                                @Html.DropDownListFor(model => model.DivisionID, new SelectList(ViewBag.DivList.Items, "ADORGLEVELID", "LEVELDESCRIP"), "- Select -", new { @id = "ddlDiv", @class = "form-control" })
                            </div>
                        </div>
                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.DEPTID, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.DEPTID, new SelectList(ViewBag.DepList.Items, "ADORGLEVELID", "LEVELDESCRIP"), "- Select -", new { @id = "ddlDep", @class = "form-control" })
                            </div>

                            @Html.LabelFor(model => model.SECID, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.SECID, new SelectList(ViewBag.SecList.Items, "ADORGLEVELID", "LEVELDESCRIP"), "- Select -", new { @id = "ddlSec", @class = "form-control" })
                            </div>

                            @Html.LabelFor(model => model.ecode, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2">
                                @Html.TextBoxFor(model => model.ecode, new { @type = "number", @value = "", @id = "txtEmpCode", @class = "form-control", @style = "width: 110px;" })
                            </div>
                        </div>

                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.VendorCode, new { @class = "control-label text-right col-md-1", @style = "width:140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.TextBoxFor(model => model.VendorCode, new { @id = "txtVendorCode", @class = "form-control", @style = "width: 150px;" })
                            </div>

                            @Html.LabelFor(model => model.VendorName, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.TextBoxFor(model => model.VendorName, new { @id = "txtVendorName", @class = "form-control" })
                            </div>
                        <label class="control-label text-right col-md-1" style="width: 140px;margin-top: 7px;">Request Date</label>
                            @* @Html.Label("Request Date", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                           *@ <div class="col-md-1 col-lg-1"> 
                                <input id="txtStartdate" class="form-control datepic" style="width: 110px;background-color:white;" name="Startdate" type="text" value="" readonly="readonly" placeholder="From Date" />
                            </div>
                            <div class="col-lg-1 col-md-1" style="margin-left: 10px;">
                                <input id="txtENDDATE" class="form-control datepic" style="width: 110px;background-color:white;" name="ENDDATE" type="text" value="" readonly="readonly" placeholder="To Date" />
                            </div>
                        </div>

                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.ReqStatus, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.ReqStatus, new List<SelectListItem>
                                    {
                                    new SelectListItem{ Text="-All-", Value = "-1" },
                                    new SelectListItem{ Text="Pending", Value = "0", Selected=true }, //(2-pending, 5-pending at Finance, 8-Taxation Complete,)
                                    new SelectListItem{ Text="Hold", Value = "6" },
                                    new SelectListItem{ Text="Forwarded to Taxation", Value = "7" },
                                    new SelectListItem{ Text="Approved", Value = "9" },
                                     new SelectListItem{ Text="Rejected", Value = "3" },
                                    }, new { @class = "form-control", @id = "ddlReqStatus", @style = "width: 150px;" })
                            </div>

                            @Html.LabelFor(model => model.Doc_Status, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2">
                                @Html.DropDownListFor(model => model.Doc_Status, new List<SelectListItem>
                                    {
                                    new SelectListItem{ Text="-All-", Value = "-1" },
                                    new SelectListItem{ Text="Not Recevied", Value = "0" },
                                    new SelectListItem{ Text="Recevied", Value = "1" },
                                    }, new { @class = "form-control", @id = "ddlDocStatus", @style = "width: 110px;" })
                            </div>

                            @Html.LabelFor(model => model.RequestNumber, new { @class = "control-label text-right col-md-1", @style = "width: 205px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2">
                                @Html.TextBoxFor(model => model.RequestNumber, new { @type = "number", @value = "", @id = "txtReqNumber", @class = "form-control", @style = "width: 110px;" })
                            </div>
                        </div>
                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.KIID, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.KIID, new SelectList(ViewBag.KIList.Items, "Value", "Text"), new { @id = "ddlKI", @class = "form-control" })
                            </div>
                            @Html.LabelFor(model => model.INVOICENO, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2 " style="width:20.66%;">
                                @Html.TextBoxFor(model => model.INVOICENO, new { @type = "text", @value = "", @id = "txtInvNumber", @class = "form-control", @style = "width: 150px;" })
                            </div>
                            @Html.LabelFor(model => model.INVOICEDATE, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                <input id="txtInvDate" class="form-control datepic" style="width: 150px;background-color:white;" name="InvDate" type="text" value="" readonly="readonly" placeholder="Invoice Date" />   
                            </div>
                        </div>
                        <div class="row" style="padding:2px;">
                            <div class="col-md-12 col-lg-12 text-center">
                                <button id="btnSubmit" class="btn btn-success btn-sm">Search</button>
                                <button id="btnExcel" class="btn btn-primary btn-sm">Export To Excel</button>
                                <input type="button" value="Reset" class="btn btn-default btn-sm" id="btnReset" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="ajaxLoader"></div>
            <div id="div_append">
            </div>
        </div>
    </div>

    <form id="_form" action="@Url.Action("SMFinApproval","SM")" method="post">
        <input type="hidden" id="hfHeaderId" name="id" value="0" />
