@section Scripts{
    <script type="text/javascript" language="Javascript" src="~/js/jquery-ui.min.js"></script>
    @* <script src="~/lib/bootstrap/js/bootstrap-multiselect.js"></script> *@

    @* <script src="~/lib/bootstrap/js/bootstrap.js"></script> *@
    <script src="~/lib/bootstrap/js/dataTables.bootstrap.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(function () {
            $('input#txtVendorCode').keyup(function () {
                if (event.keyCode != 13) {
                    $('#txtVendorName').val('');
                }
            });

            $("input#txtVendorCode").autocomplete({
                source: "/SM/AutocompleteSuggestions",
                minLength: 3,
                open: function (event, ui) {
                    $('#txtVendorName').val('');
                },
                select: function (event, ui) {
                    $('#txtVendorName').val('');
                    if (ui.item) {
                        //$("#searchTerm").val(ui.item.value);
                        var strArray = ui.item.value.split('~');
                        if (strArray != null) {
                            this.value = strArray[0];
                            $('#txtVendorName').val(strArray[1]);
                        }
                    }
                    return false;
                }
            });
        });
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $('#txtEmpCode').val('');
            $('#txtReqNumber').val('');
            $('.datepic').datepicker({
                format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top',
                clearBtn: true
            });

            BindDivision($("#ddlOp"), 1);

            if ('@ViewBag.ISUSER_OPERATION' == '1') {
                BindDepartment($("#ddlDiv"), 1);

                BindSection($("#ddlDep"), 1);

                /// Operation
                if ('@Model.OperationID' != '') {
                    $("#ddlOp").addClass('div_disable');
                }
                else {
                    $("#ddlOp").removeClass('div_disable');
                }

                /// Division
                if ('@Model.DivisionID' != '') {
                    $("#ddlDiv").addClass('div_disable');
                }
                else {
                    $("#ddlDiv").removeClass('div_disable');
                }

                /// Department
                if ('@Model.DEPTID' != '') {
                    $("#ddlDep").addClass('div_disable');
                }
                else {
                    $("#ddlDep").removeClass('div_disable');
                }

                /// Section
                if ('@Model.SECID' != '') {
                    $("#ddlSec").addClass('div_disable');
                }
                else {
                    $("#ddlSec").removeClass('div_disable');
                }
            }

            $("#btnSubmit").click();

            $('#ddTaxationAuthority').multiselect({
                includeSelectAllOption: false,
                maxHeight: 137,
                buttonWidth: 350,
                dropUp: false,
                enableFiltering: false,
                enableCaseInsensitiveFiltering: false,
                includeSelectAllOption: false
            });
        });


        ////======== Bind Division========////
        function BindDivision(crnt, call) {
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            $.getJSON("/PR/BindDivisionByOperationId", { id: dID },
                   function (data) {
                       var select = $("#ddlDiv");
                       select.empty();
                       if (data.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.Value,
                               text: itemData.Text
                           }));
                       });
                       if ('@Model.DivisionID' != '' && call == 1) {
                           $("#ddlDiv").val('@Model.DivisionID');
                       }
                   });
        }

        ////======== Bind Department========////
        function BindDepartment(crnt, call) {
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            $.getJSON("/PR/BindDeptByDivisionId", { id: dID },
                   function (data) {
                       var select = $("#ddlDep");
                       select.empty();
                       if (data.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.Value,
                               text: itemData.Text
                           }));
                       });
                       if ('@Model.DEPTID' != '' && call == 1) {
                           $("#ddlDep").val('@Model.DEPTID');
                       }
                   });
        };

        ////======== Bind Section========////
        function BindSection(crnt, call) {
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            $.getJSON("/PR/BindSecByDepartmentId", { id: dID },
                   function (data) {
                       var select = $("#ddlSec");
                       select.empty();
                       if (data.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.Value,
                               text: itemData.Text
                           }));
                       });
                       if ('@Model.SECID' != '' && call == 1) {
                           $("#ddlSec").val('@Model.SECID');
                       }
                   });
        };

        function GetDashboardRecord(crnt) {
            var data = {
                OperationID: $('#ddlOp').val() == "" ? 0 :parseFloat($('#ddlOp').val()),
                DivisionID: $('#ddlDiv').val() == "" ? 0 : parseFloat($('#ddlDiv').val()),
                DEPTID: $('#ddlDep').val() == "" ? 0 : parseFloat($('#ddlDep').val()),
                SECID: $('#ddlSec').val() == "" ? 0 : parseFloat($('#ddlSec').val()),
                SMNo: $('#txtSMNo').val(),
                ecode: $('#txtEmpCode').val() == "" ? 0 : parseFloat($('#txtEmpCode').val()),
                Startdate: $('#txtStartdate').val(),
                ENDDATE: $('#txtENDDATE').val(),
                ReqStatus: parseFloat($('#ddlReqStatus').val()),
                VendorCode: $('#txtVendorCode').val(),
                VendorName: $('#txtVendorName').val(),
                Doc_Status: parseFloat($('#ddlDocStatus').val()),
                RequestNumber: $('#txtReqNumber').val() == "" ? 0 : parseFloat($('#txtReqNumber').val()),
                KIID: parseFloat($('#ddlKI').val()),
                INVOICENO: $('#txtInvNumber').val(),
                INVOICEDATE: $('#txtInvDate').val()
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SM/SMDashboard",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#div_append').html(data);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function GetExcel(crnt) {
            var data = {
                OperationID: $('#ddlOp').val() == "" ? 0 : $('#ddlOp').val(),
                DivisionID: $('#ddlDiv').val() == "" ? 0 : $('#ddlDiv').val(),
                DEPTID: $('#ddlDep').val() == "" ? 0 : $('#ddlDep').val(),
                SECID: $('#ddlSec').val() == "" ? 0 : $('#ddlSec').val(),
                SMNo: $('#txtSMNo').val(),
                ecode: $('#txtEmpCode').val() == "" ? 0 : $('#txtEmpCode').val(),
                Startdate: $('#txtStartdate').val(),
                ENDDATE: $('#txtENDDATE').val(),
                ReqStatus: $('#ddlReqStatus').val(),
                VendorCode: $('#txtVendorCode').val(),
                VendorName: $('#txtVendorName').val(),
                Doc_Status: $('#ddlDocStatus').val(),
                RequestNumber: $('#txtReqNumber').val() == "" ? 0 : $('#txtReqNumber').val(),
                KIID: $('#ddlKI').val()
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SM/ExportToExcel",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "SM", Action = "DownloadExcel" })";
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function ReceviedDoc(row_id) {
            swal({
                title: "Have you Received the documents ?",
                text: "",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, Recevied it!",
                cancelButtonText: "No",
                closeOnConfirm: false,
                closeOnCancel: true
            },
            function (isConfirm) {
                if (isConfirm) {
                    $.ajax({
                        type: "POST",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        url: "/SM/UpdateDocStatus",
                        //contentType: "application/json; charset=utf-8",
                        //datatype: "json",
                        //data: JSON.stringify({ headerId: row_id }),
                        data: { headerId: row_id },
                        success: function (data) {
                            if (data == 1) {
                                swal({
                                    title: "",
                                    text: "Document status updated successfully.",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                        $("#btnSubmit").click();
                                    }
                                });
                            }
                            else {
                                sweetAlert("", "Document status not updated.", "warning");
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }
            });
