            $.getJSON("/SM/BindTaxationAuth", { typeId: 3 },
                 function (data) {
                     var _options = '<option value="">-Select-</option>';
                     if (data.length > 0) {
                         $.each(data, function (index, itemData) {
                             _options += '<option value="' + itemData.ECODE + '">' + itemData.ENAME + '</option>'
                         });

                         /// --- Get Taxation Authority --- ///
                         $.getJSON("/SM/GetTaxationAuthById", { id: row_id },
                           function (data) {
                             if (data.length > 0) {
                                 $.each(data, function (index, itemData) {
                                     var _class = itemData.APPROVAL_STATUS == 0 ? "row_data" : "";
                                     rows += "<tr class='" + _class + "'><td class='text-left'><input type='hidden' value='" + itemData.ADEMPCODE + "' />" + itemData.APPEMP_NAME + "</td>";
                                     if (itemData.APPROVAL_STATUS == 0) {
                                         rows += "<td class='text-center'><select class='form-control ddlTaxAuth'>" + _options + "</select></td>";
                                     }
                                     else {
                                         rows += "<td class='text-left'></td>";
                                     }
                                     rows += "</tr>";
                                 });
                             }
                             else {
                                 rows += "<tr><td>No record found.</td></tr>"
                             }
                             document.getElementById("append_AppHis").innerHTML = rows;
                             $('#updateAuthModel').modal({ backdrop: "static" });
                             $("#ajaxLoader").removeClass('loader');
                           });
                         /// --- End ---///
                     }
                     else {
                         $("#ajaxLoader").removeClass('loader');
                         sweetAlert("", "Taxation Authority not found.", "warning");
                     }
                 });
        }

        function UpdateTaxationAuth() {
            var arrayList = new Array, _currentEcode = 0, _SelectedAuth = 0;
            var hId = $("#hfTaxationSMHid").val();
            var rowLength = $('#tbUpdateHis').find('.row_data').length;
            var rows = $('#tbUpdateHis').find('.row_data');
            for (var i = 0; i < rowLength; i += 1) {
                _currentEcode = 0; _SelectedAuth = 0;
                var row = rows[i];
                if (row != undefined) {
                    $(row.cells[1]).find('.ddlTaxAuth').removeClass('validationError');
                    _currentEcode = $(row.cells[0]).find('input[type=hidden]').val() == "" ? 0 : $(row.cells[0]).find('input[type=hidden]').val();
                    _SelectedAuth = $(row.cells[1]).find('.ddlTaxAuth').val() == "" ? 0 : $(row.cells[1]).find('.ddlTaxAuth').val();
                    if (_SelectedAuth != 0) {
                        var itemArray = $.grep(arrayList, function (e) {
                            return e.SELECTED_ADEMPCODE == _SelectedAuth;
                        });
                        if (itemArray.length > 0) {
                            $(row.cells[1]).find('.ddlTaxAuth').addClass('validationError');
                            $("#spn_msg").text("Same authority can not be selected.");
                            $("#spn_msg").removeClass('hidden');
                            return;
                        }
                        else {
                            var rowData = {
                                SMHEADERID: hId,
                                ADEMPCODE: _currentEcode,
                                SELECTED_ADEMPCODE: _SelectedAuth
                            }
                            arrayList.push(rowData);
                        }
                    }
                    else {
                        $(row.cells[1]).find('.ddlTaxAuth').addClass('validationError');
                    }
                }
            }

            if (arrayList.length > 0) {
                $('#updateAuthModel').modal('hide');

                $.ajax({
                    type: "POST",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    url: "/SM/UpdateTaxationAuth",
                    data: JSON.stringify(arrayList),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data == 1) {
                            swal({
                                title: "",
                                text: "Authority updated successfully",
                                type: "success",
                            })
                        }
                        else if (data == 0 || data == -1) {
                            swal({
                                title: "",
                                text: "Authority not updated",
                                type: "warning",
                            })
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }
        function RegenerateSESDoc(row_id) {
            debugger;
            swal({
                title: "Do you want to regenerate documents ?",
                text: "",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                closeOnConfirm: false,
                closeOnCancel: true
            },
            function (isConfirm) {
                if (isConfirm) {
                    $.ajax({
                        type: "POST",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        url: "/SM/ReGenerateDoc",
                        // contentType: "application/json; charset=utf-8",
                        // datatype: "json",
                        data: { id: row_id },
                        success: function (data) {
                            if (data.res == 1) {
                                swal({
                                    title: "",
                                    text: "Document regenerated successfully.",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                        $("#btnSubmit").click();
                                    }
                                });
                            }
                            else {
                                sweetAlert("Oops...", "Kindly share error message to SIS " + data.err_msg + ".\n and Please try again.", "error");
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }
            });
        }
