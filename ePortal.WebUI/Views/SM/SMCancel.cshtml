@model ePortal.ViewModels.SMHeaderViewModel

@{
    ViewBag.Title = "SMCancel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 3px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        table.dataTable {
            clear: both;
            margin-top: 0px !important;
            margin-bottom: 0px !important;
            max-width: none !important;
            border-collapse: separate !important;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        #msform {
            /*text-align: center;*/
            position: relative;
        }

            #msform fieldset {
                background: #fff;
                border: 0 none;
                border-radius: 0px;
                box-shadow: 0 0 1px 1px #337ab7;
                /*padding: 8px 0px;*/
                box-sizing: border-box;
                width: 100%;
                position: relative;
            }

            #msform input, #msform textarea, #msform select {
                padding: 5px;
                border: 1px solid #ccc;
                border-radius: 0px;
                margin-bottom: 8px;
                /*width: 100%;*/
                box-sizing: border-box;
                font-family: arial;
                color: #000;
                font-size: 12px;
            }

        .panel-heading {
            padding: 8px 15px !important;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .div-heading {
            text-align: left;
            height: 2.2em;
            font-weight: bold;
            background-color: #91b4ff;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

            .div-heading div {
                padding: 8px;
            }

        #pr_div {
            border: 1px solid #ccc;
            padding: 8px;
            /*margin-left: 10px;*/
            border-radius: 5px;
            background-color: #eee;
            overflow: auto;
            min-height: 35px;
            max-height: 92px;
            /*width: 73.30%;*/
        }
    </style>
}
    
    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">SES/MRN Cancellation</div>
        </div>
        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>SES/MRN Request Detail</strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <div id="msform">
                            <div class="form-group">
                                <fieldset>
                                    <div class="div-heading">
                                        <div>Requestor Detail's</div>
                                    </div>
                                    <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Emp Code") :-  @Model.Emp_Detail._ECode
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Employee Name") :-  @Model.Emp_Detail._EName
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Operation") :-  @Model.Emp_Detail._OpDesc
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Division") :-  @Model.Emp_Detail._DivDesc
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Department") :-  @Model.Emp_Detail._DepDesc
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Section") :-  @Model.Emp_Detail._SecDescrip
                                        </div>
                                    </div>
                                </fieldset>
                            </div>

                            <div class="form-group" style="box-shadow: 0 0 1px 1px #337ab7;">
                                <div class="div-heading">
                                    <div> SES/MRN Detail's</div>
                                </div>
                                <div class="panel-body">
                                    <table class="table table-bordered table-hover table-responsive" style="margin-bottom: 0px;">
                                        <tbody>
                                            <tr>
                                                <td>
                                                <label class="control-label">Request No</label>
                                                    @* @Html.Label("Request No", htmlAttributes: new { @class = "control-label" }) *@
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.SMHEADERID)
                                                </td>
                                                <td rowspan="10" id="append_pdf" width="60%;" style="vertical-align:top;"></td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.SM_TYPE, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @if (Model.SM_TYPE == 1)
                                                    {
                                                        <span>Service Entry Sheet</span>
                                                    }
                                                    else if (Model.SM_TYPE == 2)
                                                    {
                                                        <span>Material Receipt Note</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.SM_NO, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.SM_NO)
                                                    @{
                                                        var _smlst = Model.smDetail.Where(x => x.DOC_TYPE == "SM");
                                                        foreach (var obj in _smlst)
                                                        {
                                                            var _smAtt = obj.FILENAME;
                                                            var smno = (string.IsNullOrEmpty(Model.SM_NO) ? obj.SMNo : Model.SM_NO);
                                                            <span style="float:left;">
                                                                <a id="smPDF" data-id="@_smAtt" style="cursor: pointer;margin-right:10px;border: solid 1px;border-radius: 3px;padding: 1px;background-color: aliceblue;" title="Document preview" data-ctrl="anc-get-pdf-1">@smno</a>
                                                                <br />
                                                            </span>

                                                        }
                                                    }
                                                    @*@{
                                                        var _smAtt = Model.smDetail.FirstOrDefault(x => x.DOC_TYPE == "SM");
                                                        if (_smAtt != null)
                                                        {
                                                            <span style="margin-left:70px;">

                                                                <a id="smPDF" data-id="@_smAtt.FILENAME" style="cursor: pointer;" onclick="GetPDF(this);">View SES/MRN</a>
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <a id="smPDF">View SES/MRN</a>
                                                        }
                                                    }*@
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="width:10%;">
                                                    @Html.LabelFor(model => model.AMOUNT, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @{
                                                        string stra = "";
                                                        if (!string.IsNullOrEmpty(Model.SM_NO))
                                                        {
                                                            if (Model.AMOUNT <= 200000)
                                                            { stra = "<= 2 Lakh"; }
                                                            else if (Model.AMOUNT > 200000)
                                                            { stra = "> 2 Lakh"; }
                                                        }
                                                    }
                                                    @stra
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="width:10%;">
                                                    @Html.LabelFor(model => model.INVOICENO, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.INVOICENO)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="width:10%;">
                                                    @Html.LabelFor(model => model.INVOICEDATE, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.INVOICEDATE)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="width:10%;">
                                                    @Html.LabelFor(model => model.INVAMOUNT, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.INVAMOUNT)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.PONUMBER, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.PONUMBER)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="width:10%;">
                                                    @Html.LabelFor(model => model.VENDORCODE, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.VENDORCODE)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="width:10%;">
                                                    @Html.LabelFor(model => model.VENDORNAME, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.VENDORNAME)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.REMARK, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.REMARK)
                                                </td>
                                            </tr>
                                            @*//---------------Added by aumento for SESMRN as on 23112023-----------------------*@
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.SYSITE, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.SYSITE)
                                                </td>
                                            </tr>
                                            @*//---------------Added by aumento for SESMRN as on 23112023-----------------------*@
                                            <tr>
                                                <td colspan="2">
                                                    <div class="" style="box-shadow: 0 0 1px 1px #337ab7;">
                                                        <div class="div-heading">
                                                            <div>Approved PO & Supporting Document Detail's</div>
                                                        </div>
                                                        <div class="panel-body">
                                                            <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                                                                <thead>
                                                                    <tr class="bg-info">
                                                                        <th class="text-center">SNo.</th>
                                                                        <th class="text-center">Document Type</th>
                                                                        <th style="width:35%;">Attachment</th>
                                                                        <th>Additional Info</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody id="append_POdocRow">
                                                                    <tr><th colspan="4" class="text-center">No record found.</th></tr>
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="2">
                                                    <div class="" style="box-shadow: 0 0 1px 1px #337ab7;">
                                                        <div class="div-heading">
                                                            <div>Document Detail's</div>
                                                        </div>
                                                        <div class="panel-body">
                                                            <table class="table table-bordered table-hover table-responsive" id="tbDocDtl" style="margin-bottom: 0px;">
                                                                <thead>
                                                                    <tr class="bg-info">
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.smDetail[0].SMDTL_ID)
                                                                        </th>
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.smDetail[0].DOC_TYPE)
                                                                        </th>
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.smDetail[0].FILENAME)
                                                                        </th>
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.smDetail[0].ADDITIONAL_INFO)
                                                                        </th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @{ int _row_No = 0; }
                                                                    @if (Model.smDetail != null)
                                                                    {
                                                                        foreach (var item in Model.smDetail.Where(x => x.DOC_TYPE != "SM").ToList())
                                                                        {
                                                                            <tr>
                                                                                <td class="text-center">
                                                                                    @(_row_No += 1)
                                                                                    @Html.HiddenFor(modelItem => item.SMDTL_ID)
                                                                                </td>
                                                                                <td class="text-center" style="padding-left: 10px;">
                                                                                    @Html.HiddenFor(modelItem => item.SMHEADERID)
                                                                                    @Html.DisplayFor(modelItem => item.DOC_TYPE)
                                                                                </td>
                                                                                <td class="text-center" style="padding-left: 10px;">
                                                                                    <a id="smPDF_@item.SMDTL_ID" data-id="@item.FILENAME" style="cursor: pointer;" data-ctrl="anc-get-pdf">View Attachment</a>
                                                                                </td>
                                                                                <td class="text-left">
                                                                                    @Html.DisplayFor(modelItem => item.ADDITIONAL_INFO)
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="form-group" style="box-shadow: 0 0 1px 1px #337ab7;">
                                <div class="div-heading">
                                    <div>Approval/Review History</div>
                                </div>
                                <div class="panel-body">
                                    <table class="table table-bordered table-hover table-responsive" id="tbApprovalHis" style="margin-bottom: 0px;">
                                        <thead>
                                            <tr class="bg-info">
                                                <th class="text-center" style="width:5%;">
                                                    @Html.DisplayNameFor(model => model.smAppHis[0].SMAPPHISTORYID)
                                                </th>
                                                <th class="text-left" style="width:22%;">
                                                    @Html.DisplayNameFor(model => model.smAppHis[0].APPEMP_NAME)
                                                </th>
                                                <th class="text-center" style="width:13%;">
                                                    @Html.DisplayNameFor(model => model.smAppHis[0].APPROVAL_STATUS)
                                                </th>
                                                <th class="text-center" style="width:20%;">
                                                    @Html.DisplayNameFor(model => model.smAppHis[0].APPROVALDATE)
                                                </th>
                                                <th class="text-left">
                                                    @Html.DisplayNameFor(model => model.smAppHis[0].APPROVAL_REMARK)
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{ int row_No = 0; }
                                            @if (Model.smAppHis != null)
                                            {
                                                foreach (var item in Model.smAppHis.Where(s => s.APPTYPE == 1).ToList())
                                                {
                                                    <tr>
                                                        <td class="text-center">
                                                            @(row_No += 1)
                                                            @Html.HiddenFor(modelItem => item.SMAPPHISTORYID)
                                                        </td>
                                                        <td class="text-left" style="padding-left: 10px;">
                                                            @Html.HiddenFor(modelItem => item.SMHEADERID)
                                                            @Html.DisplayFor(modelItem => item.APPEMP_NAME)
                                                        </td>
                                                        <td class="text-center" style="padding-left: 10px;">
                                                            @{
                                                                string _msg = "";
                                                                if (item.APPROVAL_STATUS == 1)
                                                                {
                                                                    _msg = "Approved";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 2)
                                                                {
                                                                    _msg = "Send back";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 3)
                                                                {
                                                                    _msg = "Rejected";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 0)
                                                                {
                                                                    _msg = "Pending";
                                                                }
                                                                <span>@_msg</span>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @Html.DisplayFor(modelItem => item.APPROVALDATE)
                                                        </td>
                                                        <td class="text-left" style="padding-left: 10px;">
                                                            @Html.DisplayFor(modelItem => item.APPROVAL_REMARK)
                                                        </td>
                                                    </tr>
                                                                }
                                                                if (Model.smAppHis.Count(c => c.APPTYPE == 2) > 0)
                                                                {
                                                                    var IsApproved = Model.smAppHis.Any(d => d.APPTYPE == 2 && d.APPROVAL_STATUS == 1);
                                                                    string strLine = IsApproved ? "IOCG Approval" : "IOCG Approval (Only 1 Approval Required)";
                                                                    <tr style="background-color: #d9edf7 !important;">
                                                                        <th colspan="5" class="text-center">@strLine</th>
                                                                    </tr>
                                                                    foreach (var item in Model.smAppHis.Where(s => s.APPTYPE == 2).ToList())
                                                                    {
                                                                        <tr>
                                                                            <td class="text-center">
                                                                                @(row_No += 1)
                                                                                @Html.HiddenFor(modelItem => item.SMAPPHISTORYID)
                                                                            </td>
                                                                            <td class="text-left" style="padding-left: 10px;">
                                                                                @Html.HiddenFor(modelItem => item.SMHEADERID)
                                                                                @Html.DisplayFor(modelItem => item.APPEMP_NAME)
                                                                            </td>
                                                                            <td class="text-center" style="padding-left: 10px;">
                                                                                @{
                                                                                    string _msg = "";
                                                                                    if (item.APPROVAL_STATUS == 1)
                                                                                    {
                                                                                        _msg = "Approved";
                                                                                    }
                                                                                    else if (item.APPROVAL_STATUS == 2)
                                                                                    {
                                                                                        _msg = "Send back";
                                                                                    }
                                                                                    else if (item.APPROVAL_STATUS == 3)
                                                                                    {
                                                                                        _msg = "Rejected";
                                                                                    }
                                                                                    else if (item.APPROVAL_STATUS == 0)
                                                                                    {
                                                                                        _msg = "Pending";
                                                                                    }
                                                                                    <span>@_msg</span>
                                                                                }
                                                                            </td>
                                                                            <td class="text-center">
                                                                                @Html.DisplayFor(modelItem => item.APPROVALDATE)
                                                                            </td>
                                                                            <td class="text-left" style="padding-left: 10px;">
                                                                                @Html.DisplayFor(modelItem => item.APPROVAL_REMARK)
                                                                            </td>
                                                                        </tr>
                                                                                        }
                                                                                    }

                                                                                    if (Model.smAppHis.Count(c => c.APPTYPE == 3) > 0)
                                                                                    {
                                                                                        <tr style="background-color: #d9edf7 !important;">
                                                                                            <th colspan="5" class="text-center">Finance Approval</th>
                                                                                        </tr>
                                                                                        foreach (var item in Model.smAppHis.Where(s => s.APPTYPE == 3).ToList())
                                                                                        {
                                                                                            <tr>
                                                                                                <td class="text-center">
                                                                                                    @(row_No += 1)
                                                                                                    @Html.HiddenFor(modelItem => item.SMAPPHISTORYID)
                                                                                                </td>
                                                                                                <td class="text-left" style="padding-left: 10px;">
                                                                                                    @Html.HiddenFor(modelItem => item.SMHEADERID)
                                                                                                    @Html.DisplayFor(modelItem => item.APPEMP_NAME)
                                                                                                </td>
                                                                                                <td class="text-center" style="padding-left: 10px;">
                                                                                                    @{
                                                                                                        string _msg = "";
                                                                                                        if (item.APPROVAL_STATUS == 0)
                                                                                                        {
                                                                                                            _msg = "Pending";
                                                                                                        }
                                                                                                        else if (item.APPROVAL_STATUS == 1)
                                                                                                        {
                                                                                                            _msg = "Approved";
                                                                                                        }
                                                                                                        else if (item.APPROVAL_STATUS == 2)
                                                                                                        {
                                                                                                            _msg = "Send back";
                                                                                                        }
                                                                                                        else if (item.APPROVAL_STATUS == 3)
                                                                                                        {
                                                                                                            _msg = "Rejected";
                                                                                                        }
                                                                                                        else if (item.APPROVAL_STATUS == 4)
                                                                                                        {
                                                                                                            _msg = "Hold";
                                                                                                        }
                                                                                                        else if (item.APPROVAL_STATUS == 5)
                                                                                                        {
                                                                                                            _msg = "Forwarded to Taxation";
                                                                                                        }
                                                                                                        <span>@_msg</span>
                                                                                                    }
                                                                                                </td>
                                                                                                <td class="text-center">
                                                                                                    @Html.DisplayFor(modelItem => item.APPROVALDATE)
                                                                                                </td>
                                                                                                <td class="text-left" style="padding-left: 10px;">
                                                                                                    @Html.DisplayFor(modelItem => item.APPROVAL_REMARK)
                                                                                                </td>
                                                                                            </tr>
                                                                                                            }
                                                                                                        }

                                                                                                        if (Model.smAppHis.Count(c => c.APPTYPE > 3) > 0)
                                                                                                        {
                                                                                                            <tr style="background-color: #d9edf7 !important;">
                                                                                                                <th colspan="5" class="text-center">Taxation Review</th>
                                                                                                            </tr>
                                                                                                            foreach (var item in Model.smAppHis.Where(s => s.APPTYPE > 3).ToList())
                                                                                                            {
                                                                                                                <tr>
                                                                                                                    <td class="text-center">
                                                                                                                        @(row_No += 1)
                                                                                                                        @Html.HiddenFor(modelItem => item.SMAPPHISTORYID)
                                                                                                                    </td>
                                                                                                                    <td class="text-left" style="padding-left: 10px;">
                                                                                                                        @Html.HiddenFor(modelItem => item.SMHEADERID)
                                                                                                                        @Html.DisplayFor(modelItem => item.APPEMP_NAME)
                                                                                                                    </td>
                                                                                                                    <td class="text-center" style="padding-left: 10px;">
                                                                                                                        @{
                                                                                                                            string _msg = "";
                                                                                                                            if (item.APPROVAL_STATUS == 0)
                                                                                                                            {
                                                                                                                                _msg = "Pending";
                                                                                                                            }
                                                                                                                            else if (item.APPROVAL_STATUS == 1)
                                                                                                                            {
                                                                                                                                _msg = "Reviewed";
                                                                                                                            }
                                                                                                                            <span>@_msg</span>
                                                                                                                        }
                                                                                                                    </td>
                                                                                                                    <td class="text-center">
                                                                                                                        @Html.DisplayFor(modelItem => item.APPROVALDATE)
                                                                                                                    </td>
                                                                                                                    <td class="text-left" style="padding-left: 10px;">
                                                                                                                        @Html.DisplayFor(modelItem => item.APPROVAL_REMARK)
                                                                                                                    </td>
                                                                                                                </tr>
                                                                                                                                    }
                                                                                                                                }
                                                                                                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="form-group">
                                <fieldset>
                                    <div class="div-heading">
                                        <div>Cancellation</div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 col-lg-12" style="padding-top:8px;">
                                            <div class="col-xs-4 col-sm-3 col-md-3 col-lg-3 text-right">
                                                @* @Html.Label("Cancellation Remark", new { @class = "control-label" }) *@
                                            <label class="control-label">Cancellation Remark</label>
                                            </div>
                                            <div class="col-xs-8 col-sm-4 col-md-4 col-lg-4 text-left">
                                                <textarea id="txtRemarks" rows="2" class="form-control" placeholder="Please enter cancellation remarks." style="width: 100%;"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>

                            <div class="row">
                                <div class="col-md-12 col-lg-12 text-center">
                                    <button id="btnSubmit" class="btn btn-success btn-sm" data-id="@Model.SMHEADERID">Submit</button>
                                    <button id="btnCancel" class="btn btn-default btn-sm">Cancel</button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="ajaxLoader"></div>

@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            BindPODocument('@Model.PONUMBER');
        });

        function BindPODocument(poNo) {
            var rows = "", rowId = 0;
            $.ajax({
                type: "GET",
                url: "/SM/GetPOATTDetail",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: { poNo: poNo },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data != null) {
                        $.each(data.poDetail, function (i, item) {
                            rowId = i + 1;
                            var additionalInfo = item.ADDITIONAL_INFO == null ? "" : item.ADDITIONAL_INFO;
                            rows += "<tr class='tr_doc1'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.DOC_TYPE + "</td>"
                            rows += "<td class='text-left'><a style='cursor: pointer;' data-ctrl='anc-get-popdf' data-id='" + item.FILENAME + "'>" + "View Attachement" + "</a></td>"
                            rows += "<td class='text-left'>" + additionalInfo + "</td>"
                            rows += "</tr>"
                        });
                        document.getElementById("append_POdocRow").innerHTML = rows;

                        //CSP 3.0 Compliant changes
                        if (rowId > 0) {
                            $(document).on("click", "[data-ctrl='anc-get-popdf']", function () {
                                GetPOPDF($(this)[0]);
                            });
                        }
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    // sweetAlert("Oops...", "Error While Fetching PR Deatil !", "error");
                }
            });

        }

        function SaveData(current) {
            var _IsValid = CheckValidation();
            if (!_IsValid) {
                return;
            }
            $("#btnSubmit").attr("disabled", true);
            var data = {
                SMHEADERID:parseFloat($(current).attr('data-id')),
                REMARK: $("#txtRemarks").val()
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SM/SMCancel",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        swal({
                            title: "",
                            text: "Record saved successfully",
                            type: "success",
                        },
                        function (isConfirm) {
                            if (isConfirm) {
                                window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                            }
                        });
                    }
                    else if (data == 0 || data == -1) {
                        sweetAlert("", "Record not saved", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function CheckValidation() {
            var isVailed = true;
            $('#txtRemarks').removeClass('validationError');
            if ($('#txtRemarks').val() == "") {
                $('#txtRemarks').addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }

        function GetPDF(current) {
            var _pdfName = $(current).attr('data-id');
            if (_pdfName != "") {
                $.ajax({
                    type: "GET",
                    url: "/SM/GetPDF",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { fileName: _pdfName },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.FILEPATH != "") {
                            document.getElementById("append_pdf").innerHTML = data.FILEPATH;
                        }
                        else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function openInfo(url) {
            window.open(url, 'mywin', 'width=800,height=600');
        }
        function CancelClick() {
            window.location.href = "/Home/Home";
        }
        function GetPOPDF(current) {
            var _pdfName = $(current).attr('data-id');
            if (_pdfName != "") {
                $.ajax({
                    type: "GET",
                    url: "/PO/GetPDF",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { fileName: _pdfName },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.FILEPATH != "") {
                            document.getElementById("append_pdf").innerHTML = data.FILEPATH;
                        }
                        else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }
    </script>

    @* Adding event handlers to satisfy csp validation rules *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#btnCancel').on('click', function () {
                CancelClick();
            });
            $('#btnSubmit').on('click', function () {
                SaveData($(this)[0]);
            });

            $(document).on('click', '[data-ctrl="anc-get-pdf"]', function () {
                GetPDF($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="anc-get-pdf-1"]', function () {
                GetPDF($(this)[0]);
            });
        });
    </script>

}
