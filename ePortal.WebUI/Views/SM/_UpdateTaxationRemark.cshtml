@model ePortal.ViewModels.SMAppHistoryViewModel

    @{
        Layout = null;
    }
    <!doctype html>
    <html>
    <head>
        <style type="text/css" nonce="@Context.Items["StyleNonce_8"]">
            .loader {
                position: fixed;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                z-index: 9999;
                background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
                opacity: .7;
            }

            .validationError {
                border: 1px solid #a94442;
            }
        </style>
        <script type="text/javascript" nonce="@Context.Items["ScriptNonce_8"]">
            $(document).ready(function () {

            });

            function SaveData() {
                var isFormVaildation = CheckFormValidation();
                if (isFormVaildation) {
                    $("#btnSave").attr("disabled", true);
                    var data = {
                        SMAPPHISTORYID: $('#hfAppHisId').val(),
                        SMHEADERID: $('#hfSMHId').val(),
                        APPROVAL_STATUS: 1,
                        APPROVAL_REMARK: $('#txtAppRemark').val(),
                    }

                    $('#myCreateModel').modal('hide');
                    $.ajax({
                        type: "POST",
                        url: "/SM/SMTaxationApproval",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        data: JSON.stringify(data),
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (data) {

                            if (data == 1) {
                                swal({
                                    title: "",
                                    text: "Record saved successfully.",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                        $("#btnSubmit").click();
                                    }
                                });
                            }
                            else if (data == -2) {
                                swal({
                                    title: "",
                                    text: "Record saved successfully, But mail not sent.",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                        $("#btnSubmit").click();
                                    }
                                });
                            }
                            else {
                                sweetAlert("", "Record not saved.", "warning");
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }
            }

            function CheckFormValidation() {
                var isVailed = true;
                $("#txtAppRemark").removeClass('validationError');
                if ($('#txtAppRemark').val() == "") {
                    $("#txtAppRemark").addClass('validationError');
                    isVailed = false;
                }
                return isVailed;
            }
        </script>

        @* CSP 3.0 Compliant changes *@
        <script type="text/javascript" nonce="@Context.Items["ScriptNonce_9"]">
            $(document).ready(function () {
                $('[data-ctrl="btn-save-utr"]').on('click', function () {
                    SaveData();
                });
            });
        </script>
    </head>

    <body>
        <div class="body-content" style="padding:0px !important;">
            <div>
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="form-group">
                        @Html.HiddenFor(model => model.SMAPPHISTORYID, htmlAttributes: new { @id = "hfAppHisId" })
                        @Html.HiddenFor(model => model.SMHEADERID, htmlAttributes: new { @id = "hfSMHId" })
                    
                        @Html.LabelFor(model => model.APPROVAL_REMARK, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-8">
                            @Html.TextAreaFor(model => model.APPROVAL_REMARK, new { @class = "form-control", @id = "txtAppRemark", @style = "max-width:354px; min-height:110px;" })
                            @Html.ValidationMessageFor(model => model.APPROVAL_REMARK, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-4 col-md-8">
                            <input type="button" value="Save" class="btn btn-success" data-ctrl="btn-save-utr" id="btnSave" />
                            <button type="button" class="btn btn-default" data-dismiss="modal" aria-label="Close">Cancel</button>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div id="ajaxLoader"></div>

    </body>
</html>
