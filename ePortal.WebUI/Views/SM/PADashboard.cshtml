@model ePortal.ViewModels.VM_PaymentAdvise_Master
@{
    ViewBag.Title = "PADashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    @* <link href="~/lib/bootstrap/css/bootstrap-multiselect.css" rel="stylesheet" /> *@

    @* <link href="~/lib/bootstrap/css/dataTables.bootstrap.min.css" rel="stylesheet" /> *@
    <link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet" />
    <style nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
        .ui-widget {
            overflow: auto;
            max-height: 200px;
        }

        .ui-autocomplete {
            position: absolute;
            top: 100%;
            left: 0;
            z-index: 1000;
            display: none;
            float: left;
            min-width: 160px;
            padding: 5px 0;
            margin: 2px 0 0;
            list-style: none;
            font-size: 14px;
            text-align: left;
            background-color: #ffffff;
            border: 1px solid #cccccc;
            border: 1px solid rgba(0, 0, 0, 0.15);
            border-radius: 4px;
            -webkit-box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
            background-clip: padding-box;
        }

            .ui-autocomplete > li > div {
                display: block;
                padding: 3px 20px;
                clear: both;
                font-weight: normal;
                line-height: 1.42857143;
                color: #333333;
                white-space: nowrap;
            }

        .ui-state-hover,
        .ui-state-active,
        .ui-state-focus {
            text-decoration: none;
            color: #262626;
            background-color: #f5f5f5;
            cursor: pointer;
        }

        .ui-helper-hidden-accessible {
            border: 0;
            clip: rect(0 0 0 0);
            height: 1px;
            margin: -1px;
            overflow: hidden;
            padding: 0;
            position: absolute;
            width: 1px;
        }
    </style>
}
    @* <link href="~/assets/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/assets/js/jquery-ui.js"></script> *@


    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                Payment Advice Dashboard
            </div>
        </div>
        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Search</strong>
                        </h2>
                    </div>
                    <div class="panel-body" style="padding:5px;">
                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.PAYMENTADVISE_NO, new { @class = "control-label text-right col-md-1", @style = "width:140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.TextBoxFor(model => model.PAYMENTADVISE_NO, new { @value = "", @id = "PANO", @class = "form-control", @style = "width: 150px;" })
                            </div>

                            @Html.LabelFor(model => model.SES_MRN_NO, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.TextBoxFor(model => model.SES_MRN_NO, new { @id = "sesNo", @class = "form-control" })
                            </div>

                            @Html.LabelFor(model => model.VENDORCODE, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-2 col-lg-2" style="width:20.66%;">
                            <input type="text" class="form-control" id="txtVendorCode" data-id="txtVCode" placeholder="Search Vendor" maxlength="10" />
                            <span id="searchTerm"></span>
                        </div>
                        </div>
                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.Invoiceno, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.TextBoxFor(model => model.Invoiceno, new { @id = "InvoiceNo", @class = "form-control", @style = "width: 150px;" })
                            </div>

                            @* @Html.Label("Advise Date", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" }) *@
                            <label class="control-label text-right col-md-1" style ="width: 140px;margin-top: 7px;">Advise Date</label>
                            <div class="col-md-1 col-lg-1">
                                <input id="txtStartdate" class="form-control datepic" style="width: 110px;background-color:white;" name="Startdate" type="text" value="" readonly="readonly" placeholder="From Date" />
                            </div>
                            <div class="col-lg-1 col-md-1" style="margin-left: 10px;">
                                <input id="txtENDDATE" class="form-control datepic" style="width: 110px;background-color:white;" name="ENDDATE" type="text" value="" readonly="readonly" placeholder="To Date" />
                            </div>
                        </div>
                    </div>

                    <div class="row" style="padding:2px;">
                        <div class="col-md-12 col-lg-12 text-center">
                            <button id="btnSubmit" class="btn btn-success btn-sm">Search</button>
                            <input type="button" value="Reset" class="btn btn-default btn-sm" id="btnReset" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="ajaxLoader"></div>
        <div id="div_append">
        </div>
    </div>
    <div id="myCreateModel" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="padding:10px!important;">
                    <div class="pull-left">
                        <h5 class="modal-title"><span id="sp_type"></span></h5>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                </div>
                <div class="modal-body" style="padding:10px!important;">
                    <div id="myCreateModelContent"></div>
                </div>
            </div>
        </div>
    </div>

@section Scripts{
    <script type="text/javascript" language="Javascript" src="~/js/jquery-ui.min.js"></script>
    @* <script src="~/lib/bootstrap/js/bootstrap-multiselect.js"></script> *@

    @* <script src="~/lib/bootstrap/js/bootstrap.js"></script> *@
    @* <script src="~/lib/bootstrap/js/dataTables.bootstrap.min.js"></script> *@
    <script src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script>
    <script nonce="@Context.Items["ScriptNonce_3"]">

        $(document).ready(function () {
            $('.datepic').datepicker({
                format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top',
                clearBtn: true
            });
        
             $('input#txtVendorCode').keyup(function () {
                if (event.keyCode != 13) {
                    $('#txtVendorName').val('');
                }
            });

            $("input#txtVendorCode").autocomplete({
                source: "/SM/AutocompleteSuggestions",
                minLength: 3,
                open: function (event, ui) {
                    $('#txtVendorName').val('');
                },
                select: function (event, ui) {
                    $('#txtVendorName').val('');
                    if (ui.item) {
                        //$("#searchTerm").val(ui.item.value);
                        var strArray = ui.item.value.split('~');
                        if (strArray != null) {
                            this.value = strArray[0];
                            $('#txtVendorName').val(strArray[1]);
                        }
                    }
                    return false;
                }
            });
        });

        $('.homeContent').removeClass('homeContent');
        function GetDashboardRecord(crnt) {
            var data = {
                PAYMENTADVISE_NO: $("#PANO").val(),
                SES_MRN_NO: parseFloat($("#sesNo").val()),
                VENDORCODE: $("#txtVendorCode").val(),
                ENDDATE: $("#txtENDDATE").val(),
                Startdate: $("#txtStartdate").val(),
                Invoiceno: $('#InvoiceNo').val()
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SM/PADashboard",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#div_append').html(data);
                        
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }
    </script>


    @* CSP 3.0 Compliant changes *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#btnReset').on('click', function () {
                location.href = '@Url.Action("PADashboard", "SM")';
            });
            $('#btnSubmit').on('click', function () {
                GetDashboardRecord($(this)[0]);
                return false;
            });
        });
    </script>
}