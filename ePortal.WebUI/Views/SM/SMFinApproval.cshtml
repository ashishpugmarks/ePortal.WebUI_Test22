    <div id="ajaxLoader"></div>

@section Scripts{
    <script type="text/javascript" language="Javascript" src="~/js/jquery-ui.js"></script>
    <script type="text/javascript" language="Javascript" src="~/js/jquery-ui.min.js"></script>
    <script type="text/javascript" src="~/lib/bootstrap/js/bootstrap.min.js"></script>
    <script type="text/javascript" src="~/lib/bootstrap/js/bootstrap-multiselect.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        var _taxationAuthCount = 0;
        $(document).ready(function () {
            GetPDF($("#smPDF"));
            BindPODocument('@Model.PONUMBER');

            $('#ddTaxationAuth').multiselect({
                includeSelectAllOption: false,
                maxHeight: 137,
                buttonWidth: 350,
                dropUp: false,
                enableFiltering: false,
                enableCaseInsensitiveFiltering: false,
                includeSelectAllOption: false
            });

            @*if(@Model.PROCESS_STATUS == 7 || @Model.PROCESS_STATUS == 8){
                $("#ddApprovalStatus option[value='5']").remove();
            }*@

            //$(".dropdown-menu li a").click(function(){
            //    _taxationAuthCount = $(".dropdown-menu li").find("input:checkbox:checked").length;
            //    if($("#ddTaxType").val() == 1){
            //        if(_taxationAuthCount != 1){
            //            sweetAlert("", "In case of Direct tax select only 1 Taxation authority.", "warning");
            //        }
            //    }
            //    else if($("#ddTaxType").val() == 2){
            //        if(_taxationAuthCount != 1){
            //            sweetAlert("", "In case of Indirect tax select only 1 Taxation authority.", "warning");
            //        }
            //    }
            //    else if($("#ddTaxType").val() == 3){
            //        if(_taxationAuthCount != 2){
            //            sweetAlert("", "In case of Both (Indirect & Direct tax) select maximun 2 Taxation authority.", "warning");
            //        }
            //    }
            //});

        });

        function BindPODocument(poNo) {
            var rows = "", rowId = 0;
            $.ajax({
                type: "GET",
                url: "/SM/GetPOATTDetail",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                data: { poNo: poNo },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data != null) {
                        $.each(data.poDetail, function (i, item) {
                            rowId = i + 1;
                            var _fName = "@_POpath" + item.FILENAME;
                            var additionalInfo = item.ADDITIONAL_INFO == null ? "" : item.ADDITIONAL_INFO;
                            rows += "<tr class='tr_doc1'><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.DOC_TYPE + "</td>"
                            rows += "<td class='text-left'><a style='cursor: pointer;margin-right:10px;' data-ctrl='anc-get-popdf' data-id='" + item.FILENAME + "'>" + "View Document" + "</a>"
                            rows += "<a data-ctrl='anc-open-doc-2' data-path='" + _fName + "' data-name='PO' title='Click to open document'><i class='glyphicon glyphicon-new-window' style='cursor:pointer;'></a></i></td>"
                            rows += "<td class='text-left'>" + additionalInfo + "</td>"
                            rows += "</tr>"
                        });
                        document.getElementById("append_POdocRow").innerHTML = rows;

                        //CSP 3.0 Compliant changes
                        if (rowId > 0) {
                            $(document).on("click", "[data-ctrl='anc-open-doc-2']", function () {
                                OpenDoc($(this)[0]);
                            });
                            $(document).on("click", "[data-ctrl='anc-get-popdf']", function () {
                                GetPOPDF($(this)[0]);
                            });
                        }
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    // sweetAlert("Oops...", "Error While Fetching PR Deatil !", "error");
                }
            });

        }

        function SaveData(current) {
            var _IsValid = CheckValidation();
            if (!_IsValid) {
                return;
            }
            _taxationAuthCount = $(".dropdown-menu li").find("input:checkbox:checked").length;
            if($("#ddTaxType").val() == 1){
                if(_taxationAuthCount != 1){
                    sweetAlert("", "In case of Indirect tax select only 1 Taxation authority.", "warning");
                    return;
                }
            }
            else if($("#ddTaxType").val() == 2){
                if(_taxationAuthCount != 1){
                    sweetAlert("", "In case of Direct tax select only 1 Taxation authority.", "warning");
                    return;
                }
            }
            else if($("#ddTaxType").val() == 3){
                if(_taxationAuthCount != 2){
                    sweetAlert("", "In case of Both (Indirect & Direct tax) select maximun 2 Taxation authority.", "warning");
                    return;
                }
            }

            $("#btnSubmit").attr("disabled", true);
            var approvalData = {
                SMHEADERID:parseFloat($(current).attr('data-id')),
                APPROVAL_STATUS: $("#ddApprovalStatus").val(),
                APPROVAL_REMARK: $("#txtRemarks").val(),
                SM_ATTACHMENT_NAME: $(current).attr('data-attachment'),
                TAXATION_AUTHORITY: $('#ddTaxationAuth').val(),
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/SM/SMFinFinalApproval",
                data: JSON.stringify(approvalData),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        swal({
                            title: "",
                            text: "Record saved successfully",
                            type: "success",
                        },
                        function (isConfirm) {
                            if (isConfirm) {
                                window.location.href = "/SM/SMDashboard";
                            }
                        });
                    }
                    else if (data == 0 || data == -1) {
                        sweetAlert("", "Record not saved", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function CheckValidation() {
            var isVailed = true;
            $('#ddApprovalStatus').removeClass('validationError');
            if ($('#ddApprovalStatus').val() == "") {
                $('#ddApprovalStatus').addClass('validationError');
                isVailed = false;
            }

            if ($('#ddApprovalStatus').val() == "5") {
                $('#ddTaxType').removeClass('validationError');
                if ($('#ddTaxType').val() == "") {
                    $('#ddTaxType').addClass('validationError');
                    isVailed = false;
                }
                $('#ddTaxationAuth').removeClass('validationError');
                if ($('#ddTaxationAuth').val() == "") {
                    $('#ddTaxationAuth').addClass('validationError');
                    isVailed = false;
                }
            }

            $('#txtRemarks').removeClass('validationError');
            if ($('#txtRemarks').val() == "") {
                $('#txtRemarks').addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }

        function readBackupFile(input) {
            var _URL = window.URL || window.webkitURL;
            var file = input.files[0];
            var image = new Image();
            image.src = _URL.createObjectURL(file);
            var extension = $(input).val().split('.').pop().toLowerCase();
            var validFileExtensions = ['pdf'];
            if ($.inArray(extension, validFileExtensions) == -1) {
                sweetAlert(" ", "Sorry! Upload only 'pdf' file", "warning");
                $(input).replaceWith($(input).val('').clone(true));
            }
        }

        function UploadAttachment() {
            $('#txtApprvalAttachment').removeClass('validationError');
            if ($('#txtApprvalAttachment').val() == "") {
                $('#txtApprvalAttachment').addClass('validationError');
                return;
            }
            var formData = new FormData();
            formData.append("FILE", document.getElementById("txtApprvalAttachment").files[0]);
            formData.append("DOC_TYPE", "FIN");
            formData.append("ADDITIONAL_INFO", "Uploaded By Finance");
            formData.append("SMNo", $("#hfSmNo").val());
            $.ajax({
                type: "POST",
                url: "/SM/UploadSM",
                data: formData,
                datatype: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data == 1) {
                        $("#span-attachmentMsg").text('Attachment uploaded successfully. ').css('color', 'green').show().delay(5000).fadeOut();
                    }
                    else if (data == 0 || data == -1) {
                        $("#span-attachmentMsg").text('Attachment not uploaded, Please try again. ').css('color', '#a94442').show().delay(5000).fadeOut();
                    }
                },
                error: function () {
                    $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                }
            });
        }

        function GetPDF(current) {
            var _pdfName = $(current).attr('data-id');
            if (_pdfName != "") {
                $.ajax({
                    type: "GET",
                    url: "/SM/GetPDF",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { fileName: _pdfName },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.FILEPATH != "") {
                            document.getElementById("append_pdf").innerHTML = data.FILEPATH;
                        }
                        else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function openInfo(url) {
            window.open(url, 'mywin', 'width=800,height=600');
        }

        function CancelClick() {
            window.location.href = "/SM/SMDashboard";
        }

        function OpenConfirModel() {
            var chked_count = 0;

            var IsEnableForApp = document.getElementById("hdappaction").value;
            if (IsEnableForApp == 0) {
                swal({
                    title: "",
                    text: "You have already taken the action on this request.",
                    type: "info",
                    showCancelButton: false,
                    confirmButtonClass: "btn-info",
                    confirmButtonText: "OK",
                    cancelButtonText: "No",
                    closeOnConfirm: true,
                    closeOnCancel: true
                },
                function (isConfirm) {
                    if (isConfirm) {
                        window.location.href = "/Home/Home";
                    }
                    else {

                    }
                });
            }
            else {
                //GetPDF(document.getElementById("smPDF"));
            }
        }

        function ddApprovalStatus(current) {
            if ($(current).val() == "5") {
                $("#row_taxation").removeClass('hidden');
            }
            else {
                $("#row_taxation").addClass('hidden');
            }
        }

        function GetPOPDF(current) {
            var _pdfName = $(current).attr('data-id');
            if (_pdfName != "") {
                $.ajax({
                    type: "GET",
                    url: "/PO/GetPDF",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { fileName: _pdfName },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.FILEPATH != "") {
                            document.getElementById("append_pdf").innerHTML = data.FILEPATH;
                        }
                        else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function OpenDoc(current) {
            var _pdfPath = $(current).attr('data-path');
            var _pdfName = $(current).attr('data-name');
            var width = screen.width - 100;
            var height = screen.height - 100;
            var winTop = 50;
            var winLeft = 50;
            var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
            window.open(_pdfPath, "_blank", windowFeatures);
        };

        ////======== Bind Taxation Authority ========////
        function BindTaxationAuthority(crnt, call) {
            var tID = $(crnt).val();
            if (tID == "") {
                tID = 0;
            }


            $.getJSON("/SM/BindTaxationAuth", { typeId: tID },
                   function (data) {
                       var select = $("#ddTaxationAuth");
                       select.empty();
                       var _options = "";
                       $(".dropdown-menu").html(_options);
                       if (data.length > 0) {
                           $.each(data, function (index, itemData) {
                               select.append($('<option/>', {
                                   value: itemData.ECODE,
                                   text: itemData.ENAME
                               }));
                               _options += '<li><a tabindex="0"><label class="checkbox" title="'+itemData.ENAME+'"><input type="checkbox" value="'+itemData.ECODE+'">'+itemData.ENAME+'</label></a></li>'
                           });
                       }
                       else {
                           select.empty();
                           _options = "";
                       }
                       $(".dropdown-menu").html(_options);
                       $("#ddTaxationAuth").multiselect('refresh');
                   });
        };
    </script>

    @* Adding event handlers to satisfy csp validation rules *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        document.addEventListener('DOMContentLoaded', function () {
            OpenConfirModel();
        });
        $(document).ready(function () {
            $('#btnCancel').on('click', function () {
                CancelClick();
            });
            $('#btnSubmit').on('click', function () {
                SaveData($(this)[0]);
            });
            $('#upload').on('click', function () {
                UploadAttachment();
            });
            $(document).on('click', '[data-ctrl="anc-open-doc"]', function () {
                OpenDoc($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="anc-get-pdf"]', function () {
                GetPDF($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="anc-open-doc-1"]', function () {
                OpenDoc($(this)[0]);
            });
            $(document).on('click', '[data-ctrl="anc-get-pdf-1"]', function () {
                GetPDF($(this)[0]);
            });
            $('#txtApprvalAttachment').on('change', function () {
                readBackupFile($(this)[0]);
            });
            $('#ddApprovalStatus').on('change', function () {
                ddApprovalStatus($(this)[0]);
            });
            $('#ddTaxType').on('change', function () {
                BindTaxationAuthority($(this)[0], 0);
            });
        });
    </script>

}