                                    @{
                                    var _smAttachment = Model.smDetail.FirstOrDefault(x => x.DOC_TYPE == "SM").FILENAME;

                                        <button id="btnSubmit" class="btn btn-success btn-sm" data-id="@Model.SMHEADERID" data-attachment="@_smAttachment">Submit</button>
                                    }
                                    <button id="btnCancel" class="btn btn-default btn-sm">Cancel</button>
                                </div>
