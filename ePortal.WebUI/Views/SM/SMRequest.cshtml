        function typeChange(crnt) {
            if (crnt.checked == true && crnt.value == "1") {
                $('#div-mrn').removeClass('highlightBackground');
                $('#div-ses').addClass('highlightBackground');
                _type = 1;
                return;
            }
            else if (crnt.checked == true && crnt.value == "2") {
                $('#div-ses').removeClass('highlightBackground');
                $('#div-mrn').addClass('highlightBackground');
                _type = 2;
                return;
            }
        }
        function POTypeChange(crnt){
            if(crnt.value == "1"){
                $("#txtPOno").attr("readonly", false);
            }
            else{
                $("#txtPOno").val('');
                $("#txtPOno").attr("readonly", true);
            }
        }
        function doctypechange(crnt){
            if(crnt.value == "SM"){
                $("#txtdocsmno").attr("readonly", false);
            }
            else{
                $("#txtdocsmno").val('');
                $("#txtdocsmno").attr("readonly", true);
            }
        }
    </script>

