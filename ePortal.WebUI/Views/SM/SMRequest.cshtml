        function BindData(arrayList) {
            var rows = "", rowId = 0;
            if (arrayList != null) {
                if (arrayList.length > 0) {
                    var USER_LIST = $.grep(arrayList, function (e) { return e.APPTYPE == 1 });
                    if(USER_LIST != null){
                        $.each(USER_LIST, function (i, item) {
                            rowId = i + 1;
                            rows += "<tr><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.ADEMPCODE + "</td>"
                            rows += "<td class='text-left'>" + item.ADEMPNAME + "</td><td class='text-center'>" + item.ADDESIGNATION + "</td>"
                            //rows += "<td class='text-center'>" + item.APP_SEQ + "</td>"
                            //rows += "<td class='text-center'><a id='" + item.ADEMPCODE + "' style='cursor: pointer;' onclick='DeleteItem(this)'>Skip</a></td>"
                            rows += "</tr>"
                        });
                    }

                    i = 0;
                    var IOCG_LIST = $.grep(arrayList, function (e) { return e.APPTYPE == 2 });
                    if(IOCG_LIST != null && ISIOCGBLOCK!=1){
                        rows += "<tr  style='background-color: #d9edf7 !important;'><th class='text-center' colspan='4'>IOCG Approval (Only 1 Approval Required)</th></tr>"
                        $.each(IOCG_LIST, function (i, item) {
                            rowId = i + 1;
                            rows += "<tr><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.ADEMPCODE + "</td>"
                            rows += "<td class='text-left'>" + item.ADEMPNAME + "</td><td class='text-center'>" + item.ADDESIGNATION + "</td>"
                            //rows += "<td class='text-center'>" + item.APP_SEQ + "</td>"
                            //rows += "<td class='text-center'><a id='" + item.ADEMPCODE + "' style='cursor: pointer;' onclick='DeleteItem(this)'>Skip</a></td>"
                            rows += "</tr>"
                        });
                    }

                    i = 0;
                    var FIN_LIST = $.grep(arrayList, function (e) { return e.APPTYPE == 3 });
                    if(FIN_LIST != null){
                        //rows += "<tr  style='background-color: #d9edf7 !important;'><th class='text-center' colspan='4'>Request will be go for finance approval after approved by IOCG</th></tr>"
                        rows += "<tr  style='background-color: #d9edf7 !important;'><th class='text-center' colspan='4'>Finance Approval</th></tr>"
                        $.each(FIN_LIST, function (i, item) {
                            rowId = i + 1;
                            rows += "<tr><td class='text-center'>" + rowId + "</td><td class='text-left'>" + item.ADEMPNAME + "</td>"
                            rows += "<td class='text-left'></td><td class='text-center'></td>"
                            rows += "</tr>"
                        });
                    }
                }
                else {
                    rows += "<tr id='div-table'><td colspan='4' class='text-center'>No record found.</td></tr>"
                }
                document.getElementById("append_row").innerHTML = rows;
            }
        }

