        function submitForm() {
            $("#ddDocType").removeClass('validationError');
            $("#txtFile").removeClass('validationError');
            var isFormVaildation = CheckFormValidation();
            if (isFormVaildation) {
                var poDocTr = $("#append_POdocRow .tr_doc1");
                if(poDocTr.length == 0){
                    var poDoc_obj = $.grep(attachmentArray, function (e) {
                        return e.DOC_TYPE == "PO";
                    });
                    if(poDoc_obj==null || poDoc_obj.length==0){
                        sweetAlert("", "PO document not exist. Please add PO document", "warning");
                        $("#ddDocType").addClass('validationError');
                        $("#txtFile").addClass('validationError');
                        return;
                    }
                }
                else{
                    var IsPOAExist = false;
                    for (var i = 0; i < poDocTr.length; i += 1) {
                        var row = poDocTr[i];
                        if (row != undefined) {
                            var docTypeText = row.cells[1].innerHTML.trim();
                            if(docTypeText == "POA"){
                                IsPOAExist = true;
                            }
                        }
                    }
                    var _poDoc_obj = $.grep(attachmentArray, function (e) {
                        return e.DOC_TYPE == "PO";
                    });
                    if(!IsPOAExist && (_poDoc_obj==null || _poDoc_obj.length==0)){
                        sweetAlert("", "PO document not exist. Please add PO document", "warning");
                        $("#ddDocType").addClass('validationError');
                        $("#txtFile").addClass('validationError');
                        return;
                    }
                }

                var IPDocuemntrequired=$('#chkIPServiceMatSISAppStatus')[0].checked;
                var IPDocCount=0;
                var docTr = $("#append_docRow .tr_doc");
                if(docTr.length > 0){
                    var IsVendorInvoiceExist = false, IsDocVerified = true,ISSMDocumentExist=false;
                    for (var i = 0; i < docTr.length; i += 1) {
                        var row = docTr[i];
                        if (row != undefined) {
                            var docTypeText = row.cells[1].innerHTML.trim();
                            if(docTypeText == "VendorInvoice"){
                                IsVendorInvoiceExist = true;
                            }
                            if(docTypeText == "SM"){
                                ISSMDocumentExist = true;
                            }
                            if(docTypeText=="IPCHECKLIST")
                            {
                                IPDocCount=1;
                            }
                            var varificationText = row.cells[3].innerHTML.trim();
                            if(varificationText == "Not Verified"){
                                IsDocVerified = false;
                            }
                        }
                    }
                    if(!IsVendorInvoiceExist){
                        sweetAlert("", "Vendor Invoice document is mandatory. Please add Vendor Invoice document", "warning");
                        $("#ddDocType").addClass('validationError');
                        $("#txtFile").addClass('validationError');
                        return;
                    }
                    if(!ISSMDocumentExist){
                        sweetAlert("", "SES/MRN document is mandatory. Please add SES/MRN document", "warning");
                        $("#ddDocType").addClass('validationError');
                        $("#txtFile").addClass('validationError');
                        return;
                    }
                    if(IPDocuemntrequired && IPDocCount==0)
                    {
                        sweetAlert("", "Please upload IP Checklist documents.", "warning");
                        return;
                    }
                    if(!IsDocVerified){
                        sweetAlert("", "Document not verified. Please open all document & verified", "warning");
                        return;
                    }
                }
                else{
                    sweetAlert("", "Please upload documents.", "warning");
                    $("#ddDocType").addClass('validationError');
                    $("#txtFile").addClass('validationError');
                    return;
                }


                if (arrayList == null || arrayList.length == 0) {
                    sweetAlert("", "Please add approval authority.", "warning");
                    return;
                }
                else if(arrayList.filter(v => v.APPTYPE === 1).length == 0){
                    sweetAlert("", "User approval authority does not exist. So you can't raise this request.", "warning");
                    return;
                }
                else if(arrayList.filter(v => v.APPTYPE === 2).length == 0 && ISIOCGBLOCK!=1){
                    sweetAlert("", "IOCG authority does not exist. So you can't raise this request.", "warning");
                    return;
                }
                else {
                    var dropdown = document.getElementById("ddSite");
                    var sitevalue=dropdown.options[dropdown.selectedIndex].text;
                    swal({
                        title: "Are you sure?",
                        type: "warning",
                        showCancelButton: true,
                        confirmButtonColor: '#DD6B55',
                        confirmButtonText: 'OK',
                        cancelButtonText: "Cancel",
                        closeOnConfirm: false,
                        closeOnCancel: true,
                        text: "You are submitting request to "+sitevalue+".Please varify.",
                     }, function (isConfirm) {
                         if (isConfirm) {
                             $("#btnSave").attr("disabled", true);
                             var data = {
                                 SMHEADERID :parseFloat($("#hfSmHeaderId").val()),
                                 //REMARK : $("#txtRemark").val(),
                                 INVOICEDATE :convertToIsoDate($("#txtInvDate").val()),
                                 STATUS : 1,
                                 PROCESS_STATUS : 1,
                                 IsFinalSubmit : 1,
                                 smAuthSeq : arrayList,
                                 IPServiceMatDeclaration : $('#chkIPServiceMatSISAppStatus')[0].checked,
                             }
                             $.ajax({
                                 type: "POST",
                                 url: "/SM/SMRequest",
                                 beforeSend: function () {
                                     $("#ajaxLoader").addClass('loader');
                                 },
                                 data: JSON.stringify(data),
                                 contentType: "application/json; charset=utf-8",
                                 datatype: "json",
                                 success: function (data) {
                                     if (data == 1) {
                                         swal({
                                             title: "",
                                             text: "Record saved successfully.",
                                             type: "success",
                                         }, function (isConfirm) {
                                             if (isConfirm) {
                                                 window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                                             }
                                         });
                                     }
                                     else if (data == 2) {
                                         sweetAlert("", "This SES/MRN request already processed.", "warning");
                                         $("#btnSave").attr("disabled", false);
                                     }
                                     else if (data == 3) {
                                         sweetAlert("", "Please upload SES/MRN document", "warning");
                                         $("#btnSave").attr("disabled", false);
                                     }
                                     else {
                                         sweetAlert("", "Record not saved.", "warning");
                                         $("#btnSave").attr("disabled", false);
                                     }
                                 },
                                 complete: function () {
                                     $("#ajaxLoader").removeClass('loader');
                                 },
                                 error: function () {
                                     sweetAlert("Oops...", "Something went wrong!", "error");
                                     $("#btnSave").attr("disabled", false);
                                 }
                             });
                         }

                     });


                }
            }
            else {
                $('#div_valid_msg').removeClass('hidden');
            }
        }

        function openInfo(url) {
            window.open(url, 'mywin', 'width=500,height=500');
        }

        function Reset(){
            window.location.href = "/SM/SMRequest";
