        function nextBtnClick(){
            var isFormVaildation = CheckFormValidation();
            if (!isFormVaildation) {
                $('#div_valid_msg').removeClass('hidden');
                return;
            }
            //---------------Added by aumento for SESMRN as on 23112023-----------------------
