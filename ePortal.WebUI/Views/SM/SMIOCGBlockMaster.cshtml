@model ePortal.ViewModels.SMDGIT_SMIOCGBLOCKViewModel
@{
    ViewBag.Title = "SES/MRN IOCG Block Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        /*table Css*/
        .table > thead > tr > th {
            padding: 6px 10px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            padding: 5px;
            line-height: 1.5;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
            border: 1px solid #8ac2de;
            font-size: 70% !important;
        }

        .table-bordered {
            border: 1px solid #8ac2de;
        }

        .table > tbody > tr > td {
            /*padding: 4px 3px;*/
            /*padding: 0px 3px !important;*/
            padding: 5px 6px -2px 3px !important;
        }

        .table > tbody > tr:nth-of-type(even) {
            background: #e9e9e9;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .validationBackground {
            background-color: #a94442 !important;
            color: white;
        }

        .highlightBackground {
            background-color: #8bb55a !important;
            color: white;
        }
        /*basic reset*/
        * {
            margin: 0;
            padding: 0;
        }

        html {
            height: 100%;
            background: white; /* fallback for old browsers */
            background: -webkit-linear-gradient(to left, #6441A5, #2a0845); /* Chrome 10-25, Safari 5.1-6 */
        }

        body {
            font-family: montserrat, arial, verdana;
            background: transparent;
        }

        /*form styles*/
        #msform {
            text-align: center;
            position: relative;
        }

            #msform fieldset {
                background: white;
                border: 0 none;
                border-radius: 0px;
                box-shadow: 0 0 15px 1px rgba(0, 0, 0, 0.4);
                padding: 8px 0px;
                box-sizing: border-box;
                width: 100%;
                position: relative;
            }

                /*Hide all except first fieldset*/
                #msform fieldset:not(:first-of-type) {
                    display: none;
                }

        /*headings*/
        .fs-title {
            font-size: 18px;
            text-transform: uppercase;
            color: #2C3E50;
            margin-bottom: 10px;
            letter-spacing: 2px;
            font-weight: bold;
        }

        .fs-subtitle {
            font-weight: normal;
            font-size: 13px;
            color: #666;
            margin-bottom: 20px;
        }

        /*progressbar*/
        #progressbar {
            margin-bottom: 20px;
            overflow: hidden;
            /*CSS counters to number the steps*/
            counter-reset: step;
        }

            #progressbar li {
                list-style-type: none;
                color: #6080dc;
                text-transform: uppercase;
                font-size: 9px;
                font-weight: 800;
                /*width: 33.33%;*/
                width: 50%;
                float: left;
                position: relative;
                letter-spacing: 1px;
            }

                #progressbar li:before {
                    content: counter(step);
                    counter-increment: step;
                    width: 40px;
                    height: 24px;
                    line-height: 26px;
                    display: block;
                    font-size: 12px;
                    color: #333;
                    background: #ccc;
                    border-radius: 25px;
                    margin: 0 auto 6px auto;
                }

                /*progressbar connectors*/
                #progressbar li:after {
                    content: '';
                    width: 100%;
                    height: 8px;
                    background: #ccc;
                    position: absolute;
                    left: -50%;
                    top: 8px;
                    z-index: -1; /*put it behind the numbers*/
                }

                #progressbar li:first-child:after {
                    /*connector not needed before the first step*/
                    content: none;
                }

                /*marking active/completed steps green*/
                /*The number of the step and the connector before it = green*/
                #progressbar li.active:before, #progressbar li.active:after {
                    background: #6080dc;
                    color: white;
                }


        /* Not relevant to this form */
        .dme_link {
            margin-top: 30px;
            text-align: center;
        }

            .dme_link a {
                background: #FFF;
                font-weight: bold;
                color: #6080dc;
                border: 0 none;
                border-radius: 25px;
                cursor: pointer;
                padding: 5px 25px;
                font-size: 12px;
            }

                .dme_link a:hover, .dme_link a:focus {
                    background: #C5C5F1;
                    text-decoration: none;
                }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .panel-heading {
            padding: 8px 15px;
        }

        #pr_div {
            border: 1px solid #ccc;
            padding: 8px; /*15px 0px 15px 0px;*/
            margin-left: 10px;
            border-radius: 5px;
            background-color: #eee;
            overflow: auto;
            min-height: 35px;
            max-height: 92px;
            width: 73.30%;
        }

        .alert-error {
            background-color: antiquewhite;
            margin-left: 15px;
            margin-right: 15px;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .required::after {
            content: "*";
            font-weight: 800;
            color: red;
            margin-left: 5px;
        }

        .ui-widget {
            font-family: Verdana,Arial,sans-serif;
            font-size: 0.6em !important;
            overflow: auto;
            max-height: 150px;
        }

        /*Below CSS form toggle button added*/
        input[type="checkbox"] {
            position: relative;
            width: 40px;
            height: 20px;
            -webkit-appearance: none;
            appearance: none;
            /*background: red;*/
            /*background: #ef1515cf;*/
            background: #808080;
            outline: none;
            border-radius: 2rem;
            cursor: pointer;
            box-shadow: inset 0 0 5px rgb(0 0 0 / 50%);
            margin-top: 4px !important;
        }

            input[type="checkbox"]::before {
                content: "";
                width: 20px;
                height: 20px;
                border-radius: 50%;
                background: #fff;
                position: absolute;
                top: 0;
                left: 0;
                transition: 0.5s;
            }

            input[type="checkbox"]:checked::before {
                transform: translateX(100%);
                background: #fff;
            }

            input[type="checkbox"]:checked {
                /* background: #00ed64;*/
                /*background: #00ed127a;*/
                background: #2196F3;
            }
    </style>

}
    @* <script src="~/assets/lib/bootstrap/js/bootstrap-multiselect.js"></script>
    <link href="~/assets/lib/bootstrap/css/bootstrap-multiselect.css" rel="stylesheet" />
    <link href="~/assets/css/jquery-ui.css" rel="stylesheet" />
    <script src="~/assets/js/jquery-ui.js"></script> *@
   
  

    <div class="row ">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                IOCG Block Master
            </div>
        </div>
        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Manage IOCG Block Master</strong>
                        </h2>
                    </div>
                    <div class="panel-body" style="padding:5px;">
                        <div class="form-group">
                            <div class="col-md-2 col-sm-3 col-xs-3 text-right">
                                <label style="margin-top: 10px;margin-right:10px;font-size:80%;padding-top:4px;padding-bottom:4px;">ORG Level Type</label>
                            </div>
                            <div class="col-md-2 col-sm-4 col-xs-5" style="padding-top:8px">
                                <select class="form-control" id="ddOLvType">
                                    <option value="">-Select-</option>
                                    <option value="1">Operation</option>
                                    <option value="2">Division</option>
                                    <option value="3">Department</option>
                                    <option value="4">Section</option>
                                </select>
                            </div>
                            <div class="col-md-2 col-sm-3 col-xs-3 text-right">
                                <label style="margin-top: 10px;margin-right:10px;font-size:80%;padding-top:4px;padding-bottom:4px;">Organization</label>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-5" style="padding-top:8px">
                                <select id="ddOrganization" class="form-control" style="padding-right:50px;"></select>
                                <span style="width:80%!important" id="OsearchTerm"></span>
                            </div>
                            <div class="col-md-1 col-sm-4 col-xs-5" style="padding-top:8px;padding-left:20px">
                                <input type="button" name="Save" class="btn btn-success" value="Save" id="Save" />
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 0px;font-size:18px;">
                    <form id="myform">
                        <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                            <thead>
                                <tr class="bg-info">
                                    <th class="text-center">SNo.</th>
                                    <th class="text-center">Oganization Level Type</th>
                                    <th class="text-center">Oganization Description</th>
                                    <th class="text-center">Active/DeActive</th>
                                </tr>
                            </thead>
                            <tbody id="append_POARow"></tbody>
                        </table>
                    </form>
                </div>

            </div>
        </div>
    </div>
@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        var selectedText, selectedValue;
        $(function () {

            $("#ddOLvType").change(function () {

                var ddOrganization = $("#ddOrganization");
                selectedText = ddOLvType.options[ddOLvType.selectedIndex].innerHTML;
                selectedValue = ddOLvType.value;
                //var ddOLvType = $('#ddOLvType').find(":selected").value();
                var URL = "/SM/GetOrganization/?ddOLvType=" + selectedValue;

                ddOrganization.empty().append('<option selected="selected" value="0" disabled="disabled">Loading.....</option>');
                var i = 0;
                $.ajax({
                    type: "POST",
                    url: URL,
                    //url: "/ITDIncomeTaxDeclaration/GetAllSubDocType",
                    //data: '{}',
                    //data: { Category: Category },
                    success: function (response) {
                        //console.log(response);
                        ddOrganization.empty().append('<option selected="selected" value="0">Select</option>');
                        $.each(response.Item2, function () {
                            //alert(response.Item2[i].DOCTYPE);
                            ddOrganization.append($("<option></option>").val(response.Item2[i].LEVELDESCRIP).html(response.Item2[i].LEVELDESCRIP));
                            i++;
                        });
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    },
                    error: function (response) {
                        alert(response.responseText);
                    }
                });
            });
        });
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {

            LoadData();

            $("#Save").click(function () {
                selectedText = ddOLvType.options[ddOLvType.selectedIndex].innerHTML;
                selectedValue = ddOLvType.value;
                var Organization = parseInt($('#ddOrganization :selected').text().split("-")[0].trim());
                $.ajax({
                    type: "GET",
                    url: "/SM/SaveAdorglevel",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { ddOLvType: selectedValue, Organization: Organization },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.res == 1) {
                            swal({
                                title: "",
                                text: "Data Saved Successfully...!",
                                type: "success"
                            },
                                function () {
                                    location.reload();
                                }
                            );
                        }
                        else if (data.res == 0) {
                            swal({
                                title: "",
                                text: "Organization already exist...!",
                                type: "error"
                            },

                                function () {
                                    location.reload();
                                }
                            );
                        }
                        //location.reload();
                    },
                    complete: function () {
                        //BindData(arrayList);
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            });
        });


        function LoadData() {

            $.ajax({
                type: "POST",
                url: "/SM/GetSMIOCGBLOCKData",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data != "[]") {
                        var Data1 = JSON.parse(data);
                        console.log(Data1);
                        $("#append_POARow").empty();
                        debugger;
                        $.each(Data1, function (i, r) {

                            //$("#append_POARow").append("<tr><td><center>" + (i + 1) + "</center></td><td>" + r.SMIOCGBLOCKID + "</td><td> " + r.ADORGLEVELID + "</td><td class='text-center'><a data-name='" + r.POWERCODE + "' data-type='" + r.POWERNAME + "' data-id='" + (i + 1) + "' style='cursor: pointer;color:red;' onclick='DeleteDoc(this)'><span id='btnDelete' class='glyphicon glyphicon-trash '></span></a></td></tr>")
                            if (r.STATUS == 1) {

                                //$("#append_POARow").append("<tr><td><center>" + (i + 1) + "</center></td><td>" + r.LevelType + "</td><td> " + r.LevelDesc + "</td><td class='text-center'><a data-name='" + r.SMIOCGBLOCKID + "' data-type='" + r.ADORGLEVELID + "' data-id='" + (i + 1) + "' style='cursor: pointer;color:red;padding-top:2%;padding-bottom:2%;' onchange='Checkbox(this)'><label class='switch'> <input type='checkbox' checked>  <span class='slider round'></span></label></a></td></tr>")
                                $("#append_POARow").append("<tr><td><center>" + (i + 1) + "</center></td><td>" + r.LevelType + "</td><td> " + r.LevelDesc + "</td><td class='text-center'><a data-name='" + r.SMIOCGBLOCKID + "' data-type='" + r.ADORGLEVELID + "' data-animal-type='" + r.SRNO + "' data-id='" + (i + 1) + "' style='cursor: pointer;color:red;padding-top:2%;padding-bottom:2%;' data-ctrl='chk-select'> <input type='checkbox' checked></a></td></tr>")


                            }
                            else {
                                //$("#append_POARow").append("<tr><td><center>" + (i + 1) + "</center></td><td>" + r.LevelType + "</td><td> " + r.LevelDesc + "</td><td class='text-center'><a data-name='" + r.SMIOCGBLOCKID + "' data-type='" + r.ADORGLEVELID + "' data-id='" + (i + 1) + "' style='cursor: pointer;color:red;padding-top:2%;padding-bottom:2%;' onchange='Checkbox(this)'><label class='switch'> <input type='checkbox'>  <span class='slider round'></span></label></a></td></tr>")
                                $("#append_POARow").append("<tr><td><center>" + (i + 1) + "</center></td><td>" + r.LevelType + "</td><td> " + r.LevelDesc + "</td><td class='text-center'><a data-name='" + r.SMIOCGBLOCKID + "' data-type='" + r.ADORGLEVELID + "' data-animal-type='" + r.SRNO + "' data-id='" + (i + 1) + "' style='cursor: pointer;color:red;padding-top:2%;padding-bottom:2%;' data-ctrl='chk-select'> <input type='checkbox'></a></td></tr>")
                            }


                        });
                    }

                    else {
                        $("#append_POARow").empty();
                        $("#append_POARow").append("<tr><td colspan='5' class='text-center'>No record found.</td></tr>")
                    }
                },
                complete: function () {

                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }


        function Checkbox(crnt) {

            var SMIOCGBLOCKID = $(crnt).attr('data-name');
            var ADORGLEVELID = $(crnt).attr('data-type');
            // var SRNO = $(crnt).attr('data-id');
            var SRNO = $(crnt).attr('data-animal-type');

            //alert(SMIOCGBLOCKID);
            //alert(ADORGLEVELID);
            //alert(SRNO);

            let text = "Are you sure you want to Active/Deactive..?";

            if (confirm(text) == true) {
                $.ajax({
                    async: false,
                    url: '/SM/UpdateStatus',
                    type: 'POST',
                    data: { SMIOCGBLOCKID: SMIOCGBLOCKID, ADORGLEVELID: ADORGLEVELID, SRNO: SRNO },
                    success: function (data) {
                        if (data.res == 1) {
                            swal({
                                title: "",
                                text: "Data updated Successfully...!",
                                type: "success"
                            },
                                function () {
                                    LoadData();
                                    // location.reload();
                                }
                            );
                        }
                        else if (data.res == 0 || data.res == -1) {
                            $("#span-attachmentMsg").text('Attachment not uploaded, Please try again. ').css('color', '#a94442').show().delay(5000).fadeOut();
                        }
                        $("#btnUpload").attr("disabled", false);
                    },
                    complete: function () {
                        //BindData(arrayList);
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
            else {
                location.reload();
                return false;
            }
        }

    </script>

    @* Adding event handlers to satisfy csp validation rules *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $(document).on("click", "[data-ctrl='chk-select']", function () {
                Checkbox($(this)[0]);
            });
        });
    </script>

}
