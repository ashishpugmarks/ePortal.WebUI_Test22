@{
    ViewBag.Title = "BirthdayListReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Styles
{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        * {
            font-family: Helvetica Neue, Arial, sans-serif;
        }

        /*body {
                    background-image: linear-gradient(#aaa 25%, #000);
                }*/

        h1, table {
            text-align: center;
        }

        table {
            border-collapse: collapse;
            width: 70%;
            margin: 0 auto 5rem;
        }

        th, td {
            padding: 1.5rem;
            font-size: 0.9rem;
        }

        tr {
            background: hsl(50, 50%, 80%);
        }

        tr, td {
            transition: .4s ease-in;
        }

            tr:nth-child(even) {
                background: hsla(50, 50%, 80%, 0.7);
            }

            /*td:empty {
                        background: hsla(50, 25%, 60%, 0.7);
                    }*/

            tr:hover:not(#firstrow), tr:hover td:empty {
                background: #ff0;
                pointer-events: visible;
            }

            tr:hover:not(#firstrow) {
                transform: scale(1.0);
                font-weight: 500;
                box-shadow: 0px 3px 7px rgba(0, 0, 0, 0.5);
            }
    </style>
}


<div class="panel-group">
    <div class="panel panel-primary">
        <div class="panel-heading">
            <h2 class="panel-title" style="line-height:3.2;font-size:17px;background-color:#f8e604;color:black;">
                <strong>&nbsp;&nbsp;Today's Birthday List</strong>
            </h2>
        </div>

        <div class="panel-body">
            <div style="padding-bottom: 30px; color:#fff; background-image:url('/images/birthday_doddle_bg.jpg');">
                <br />
                <div class="col-md-12 col-sm-6 col-xs-6 text-center">
                    <label><b>HEARTIEST WISHES ON YOUR BIRTHDAY</b></label>
                </div><br /><br />

                <div class="col-md-12 col-sm-6 col-xs-6 text-center">
                    <label>HAPPY BIRTHDAY TO ALL OF YOU</label>
                </div><br /><br />
                <div class="col-md-12 col-sm-6 col-xs-6 text-center">
                    <label>On @DateTime.Now.ToString("dd MMMM yyyy")</label>
                </div>
            </div>
        </div>

        <div class="panel-body">
            <div class="form-group" style="margin-bottom: 0px;">
                <form id="myform">
                    <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;" id="racetimes">
                        <thead>
                            <tr style="background-color:#f8e604;">
                                <th class="text-center">#</th>
                                <th class="text-center">Emp Code</th>
                                <th class="text-center">Name</th>
                                <th class="text-center">Operation</th>
                                <th class="text-center">Division</th>
                                <th class="text-center">Department</th>
                                <th class="text-center">Section</th>
                            </tr>
                        </thead>
                        <tbody id="append_POARow">
                            <tr><th colspan="5" class="text-center">No record found.</th></tr>
                        </tbody>
                    </table>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/jquery-ui.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_0"]">
        $(document).ready(function () {
               LoadData();
           });

           function LoadData() {
               $.ajax({
                   type: "POST",
                   url: "/BirthdayList/GetBirthdayListData",
                   beforeSend: function () {
                       $("#ajaxLoader").addClass('loader');
                   },
                   contentType: "application/json; charset=utf-8",
                   datatype: "json",
                   success: function (data) {
                       if (data != "[]") {
                           debugger;
                           var Data1 = data;
                           console.log(Data1);
                           $("#append_POARow").empty();
                           $.each(Data1, function (i, r) {
                               if (r.Section == null) {
                                   r.Section = "";
                               }
                               $("#append_POARow").append("<tr><td><center>" + (i + 1) + "</center></td><td>" + r.ADEMPCODE_ + "</td><td> " + r.ADEMPCODE + "</td><td>" + r.operation + "</td><td>" + r.Division + "</td><td>" + r.Department + "</td><td>" + r.Section + "</td></tr>")
                           });
                       }
                       else {
                           $("#append_POARow").empty();
                           $("#append_POARow").append("<tr><td colspan='5' class='text-center'>No record found.</td></tr>")
                       }
                   },
                   complete: function () {
                       $("#ajaxLoader").removeClass('loader');
                   },
                   error: function () {
                       sweetAlert("Oops...", "Something went wrong!", "error");
                   }
               });
           }
    </script>
}
