@model ePortal.ViewModels.ACRHeaderViewModel

@{
    ViewBag.Title = "ACRCancel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 3px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        table.dataTable {
            clear: both;
            margin-top: 0px !important;
            margin-bottom: 0px !important;
            max-width: none !important;
            border-collapse: separate !important;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        #msform {
            /*text-align: center;*/
            position: relative;
        }

            #msform fieldset {
                background: #fff;
                border: 0 none;
                border-radius: 0px;
                box-shadow: 0 0 1px 1px #337ab7;
                /*padding: 8px 0px;*/
                box-sizing: border-box;
                width: 100%;
                position: relative;
            }

            #msform input, #msform textarea, #msform select {
                padding: 5px;
                border: 1px solid #ccc;
                border-radius: 0px;
                margin-bottom: 8px;
                /*width: 100%;*/
                box-sizing: border-box;
                font-family: arial;
                color: #000;
                font-size: 12px;
            }

        .panel-heading {
            padding: 8px 15px !important;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .div-heading {
            text-align: left;
            height: 2.2em;
            font-weight: bold;
            background-color: #91b4ff;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

            .div-heading div {
                padding: 8px;
            }

        #pr_div {
            border: 1px solid #ccc;
            padding: 8px;
            /*margin-left: 10px;*/
            border-radius: 5px;
            background-color: #eee;
            overflow: auto;
            min-height: 35px;
            max-height: 92px;
            /*width: 73.30%;*/
        }
    </style>
}
    
    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">ACR Cancellation</div>
        </div>
        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>ACR Detail</strong>
                        </h2>
                    </div>
                    <div class="panel-body">
                        <div id="msform">
                            <div class="form-group">
                                <fieldset>
                                    <div class="div-heading">
                                        <div>Requestor Detail's</div>
                                    </div>
                                    <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Emp Code") :-  @Model.Emp_Detail._ECode
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Employee Name") :-  @Model.Emp_Detail._EName
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Operation") :-  @Model.Emp_Detail._OpDesc
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-12 col-lg-12 text-left" style="padding:5px 0px 5px 0px;">
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Division") :-  @Model.Emp_Detail._DivDesc
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Department") :-  @Model.Emp_Detail._DepDesc
                                        </div>
                                        <div class="col-sm-4 col-md-4 col-lg-4">
                                            @Html.Label("Section") :-  @Model.Emp_Detail._SecDescrip
                                        </div>
                                    </div>
                                </fieldset>
                            </div>

                            <div class="form-group" style="box-shadow: 0 0 1px 1px #337ab7;">
                                <div class="div-heading">
                                    <div> Advance Cheque Detail's</div>
                                </div>
                                <div class="panel-body">
                                    <table class="table table-bordered table-hover table-responsive" style="margin-bottom: 0px;">
                                        <tbody>
                                            <tr>
                                                <td>
                                                    @Html.HiddenFor(model => model.ACRHEADERID, new { @id = "hfAcrHeaderId" })
                                                    @Html.LabelFor(model => model.ACRNO, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.ACRNO)
                                                    @{
                                                        var _poAtt = Model.acrDetail.FirstOrDefault(x => x.DOC_TYPE == "ACR").FILENAME;
                                                        <span style="margin-left:70px;">
                                                            <a id="acrPDF" data-id="@_poAtt" style="cursor: pointer;">View Document</a>
                                                        </span>
                                                    }
                                                </td>
                                                <td rowspan="9" id="append_pdf" width="60%;"></td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.AMOUNT, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.AMOUNT)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="width:10%;">
                                                    @Html.LabelFor(model => model.PONO, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.PONO) @*[@Html.DisplayFor(model => model.VENDORID)]*@
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.SUPPLIER_CODE, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.SUPPLIER_CODE)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.SUPPLIER_NAME, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.SUPPLIER_NAME)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.ACR_DESC, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.ACR_DESC)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    @Html.LabelFor(model => model.REMARK, htmlAttributes: new { @class = "control-label" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(model => model.REMARK)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="2">
                                                    <div class="" style="box-shadow: 0 0 1px 1px #337ab7;">
                                                        <div class="div-heading">
                                                            <div>Approved PO & Supporting Document Detail's</div>
                                                        </div>
                                                        <div class="panel-body">
                                                            <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                                                                <thead>
                                                                    <tr class="bg-info">
                                                                        <th class="text-center">SNo.</th>
                                                                        <th class="text-center">Document Type</th>
                                                                        <th style="width:35%;">Attachment</th>
                                                                        <th>Additional Info</th>

                                                                    </tr>
                                                                </thead>
                                                                <tbody id="append_PRdocRow">
                                                                    <tr><th colspan="4" class="text-center">No record found.</th></tr>
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="2">
                                                    <div class="" style="box-shadow: 0 0 1px 1px #337ab7;">
                                                        <div class="div-heading">
                                                            <div>Document Detail's</div>
                                                        </div>
                                                        <div class="panel-body">
                                                            <table class="table table-bordered table-hover table-responsive" id="tbDocDtl" style="margin-bottom: 0px;">
                                                                <thead>
                                                                    <tr class="bg-info">
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.acrDetail[0].ACRDTL_ID)
                                                                        </th>
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.acrDetail[0].DOC_TYPE)
                                                                        </th>
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.acrDetail[0].FILENAME)
                                                                        </th>
                                                                        <th class="text-center">
                                                                            @Html.DisplayNameFor(model => model.acrDetail[0].ADDITIONAL_INFO)
                                                                        </th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @{ int _row_No = 0; }
                                                                    @if (Model.acrDetail != null)
                                                                    {
                                                                        foreach (var item in Model.acrDetail.Where(x => x.DOC_TYPE != "ACR").ToList())
                                                                        {
                                                                            <tr>
                                                                                <td class="text-center">
                                                                                    @(_row_No += 1)
                                                                                    @Html.HiddenFor(modelItem => item.ACRDTL_ID)
                                                                                </td>
                                                                                <td class="text-center" style="padding-left: 10px;">
                                                                                    @Html.HiddenFor(modelItem => item.ACRHEADERID)
                                                                                    @Html.DisplayFor(modelItem => item.DOC_TYPE)
                                                                                </td>
                                                                                <td class="text-center" style="padding-left: 10px;">
                                                                                    <a id="acrPDF_@item.ACRDTL_ID" data-ctrl-id="doc-det-view" data-id="@item.FILENAME" style="cursor: pointer;">View Attachment</a>
                                                                                </td>
                                                                                <td class="text-left">
                                                                                    @Html.DisplayFor(modelItem => item.ADDITIONAL_INFO)
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="form-group" style="box-shadow: 0 0 1px 1px #337ab7;">
                                <div class="div-heading">
                                    <div>Approval History</div>
                                </div>
                                <div class="panel-body">
                                    <table class="table table-bordered table-hover table-responsive" id="tbApprovalHis" style="margin-bottom: 0px;">
                                        <thead>
                                            <tr class="bg-info">
                                                <th class="text-center">
                                                    @Html.DisplayNameFor(model => model.acrAppHis[0].ACRAPPHISTORY_ID)
                                                </th>
                                                <th class="text-left">
                                                    @Html.DisplayNameFor(model => model.acrAppHis[0].APPEMP_NAME)
                                                </th>
                                                <th class="text-center">
                                                    @Html.DisplayNameFor(model => model.acrAppHis[0].APPROVAL_STATUS)
                                                </th>
                                                <th class="text-center">
                                                    @Html.DisplayNameFor(model => model.acrAppHis[0].ADDEDDATE)
                                                </th>
                                                <th class="text-left">
                                                    @Html.DisplayNameFor(model => model.acrAppHis[0].APPROVAL_REMARK)
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{ int row_No = 0; }
                                            @if (Model.acrAppHis != null)
                                            {
                                                foreach (var item in Model.acrAppHis)
                                                {
                                            <tr>
                                                <td class="text-center">
                                                    @(row_No += 1)
                                                    @Html.HiddenFor(modelItem => item.ACRAPPHISTORY_ID)
                                                </td>
                                                <td class="text-left" style="padding-left: 10px;">
                                                    @Html.HiddenFor(modelItem => item.ACRID)
                                                    @Html.DisplayFor(modelItem => item.APPEMP_NAME)
                                                </td>
                                                <td class="text-center" style="padding-left: 10px;">
                                                    @{
                                                                string _msg = "";
                                                                if (item.APPROVAL_STATUS == 1)
                                                                {
                                                                    _msg = "Approved";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 2)
                                                                {
                                                                    _msg = "Send back";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 3)
                                                                {
                                                                    _msg = "Rejected";
                                                                }
                                                                else if (item.APPROVAL_STATUS == 0)
                                                                {
                                                                    _msg = "Pending";
                                                                }
                                                            <span>@_msg</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (item.APPROVAL_STATUS == 0)
                                                            {
                                                            @Html.DisplayFor(modelItem => item.ADDEDDATE)
                                                            }
                                                            else
                                                            {
                                                            @Html.DisplayFor(modelItem => item.UPDATEDATE)
                                                            }
                                                </td>
                                                <td class="text-left" style="padding-left: 10px;">
                                                    @Html.DisplayFor(modelItem => item.APPROVAL_REMARK)
                                                </td>
                                            </tr>
                                                                    }
                                                                }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="form-group">
                                <fieldset>
                                    <div class="div-heading">
                                        <div>Cancellation</div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 col-lg-12" style="padding-top:8px;">
                                            @*<div class="col-xs-4 col-sm-3 col-md-2 col-lg-2 text-right">
                                                    @Html.LabelFor(model => model.poAppHis[0].APPROVAL_STATUS, htmlAttributes: new { @class = "control-label" })
                                                </div>
                                                <div class="col-xs-8 col-sm-2 col-md-2 col-lg-2 text-left" style="width: 11.666667%;">
                                                    <select id="ddApprovalStatus" style="width: 100%;">
                                                        <option value="0">--Select--</option>
                                                        <option value="1">Approve</option>
                                                        <option value="2">Send back</option>
                                                        <option value="3">Reject</option>
                                                    </select>
                                                </div>*@
                                            <div class="col-xs-4 col-sm-3 col-md-3 col-lg-3 text-right">
                                                @* Html.Label("Cancellation Remark", new { @class = "control-label" }) *@
                                            <label class="control-label">Cancellation Remark</label>
                                            </div>
                                            <div class="col-xs-8 col-sm-4 col-md-4 col-lg-4 text-left">
                                                <textarea id="txtRemarks" rows="2" class="form-control" placeholder="Please enter cancellation remarks." style="width: 100%;"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>

                            <div class="row">
                                <div class="col-md-12 col-lg-12 text-center">
                                    <button id="btnSubmit" class="btn btn-success btn-sm" data-id="@Model.ACRHEADERID">Submit</button>
                                    <button id="btnCancel" class="btn btn-default btn-sm">Cancel</button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="ajaxLoader"></div>

@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {

        });

        function SaveData(current) {
            var _IsValid = CheckValidation();
            if (!_IsValid) {
                return;
            }
            $("#btnSubmit").attr("disabled", true);
            var data = {
                ACRHEADERID: parseFloat($(current).attr('data-id')),
                REMARK: $("#txtRemarks").val()
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/ACR/ACRCancel",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        swal({
                            title: "",
                            text: "Record saved successfully",
                            type: "success",
                        },
                            function (isConfirm) {
                                if (isConfirm) {
                                    window.location.href = "/Home/Home";
                                }
                            });
                    }
                    else if (data == 0 || data == -1) {
                        sweetAlert("", "Record not saved", "warning");
                        $("#btnSubmit").attr("disabled", false);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function CheckValidation() {
            var isVailed = true;
            //$('#ddApprovalStatus').removeClass('validationError');
            //if ($('#ddApprovalStatus').val() == "" || $('#ddApprovalStatus').val() == "0") {
            //    $('#ddApprovalStatus').addClass('validationError');
            //    isVailed = false;
            //}
            $('#txtRemarks').removeClass('validationError');
            if ($('#txtRemarks').val() == "") {
                $('#txtRemarks').addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }

        function GetPDF(current) {
            var _pdfName = $(current).attr('data-id');
            if (_pdfName != "") {
                $.ajax({
                    type: "GET",
                    url: "/ACR/GetPDF",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { fileName: _pdfName,FileTyp:"ACR" },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.FILEPATH != "") {
                            document.getElementById("append_pdf").innerHTML = data.FILEPATH;
                        }
                        else {
                            sweetAlert("", "File not found.", "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function openInfo(url) {
            window.open(url, 'mywin', 'width=800,height=600');
        }
        function CancelClick() {
            window.location.href = "/Home/Home";
        }

    </script>

    @* Adding event handlers to satisfy csp validation rules *@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {

            $('#btnSubmit').on('click', function () {
                SaveData($(this)[0]);
            });
            $('#btnCancel').on('click', function () {
                CancelClick();
            });

            $('[data-ctrl-id="doc-det-view"]').on('click', function () {
                GetPDF($(this)[0]);
            });

            $('#acrPDF').on('click', function () {
                GetPDF($(this)[0]);
            });

        });
    </script>

}
