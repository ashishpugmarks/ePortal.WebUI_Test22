@{
    Layout = null;
}

<style nonce="@Context.Items["StyleNonce_1"]">
    .sweet-alert {
        z-index: 1000000;
        border: 1px solid;
    }
</style>
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_7"]">
    function submitForm() {
        debugger;

        var formData = new FormData();
        formData.append("CsvDoc", document.getElementById("file").files[0]);



        $.ajax({
            type: "POST",
            url: "/ACR/ConvertCSVtoDataTable",
            data: formData,
            datatype: "json",
            contentType: false,
            processData: false,
            success: function (data) {
                if (data.res == 1) {
                    swal({
                        title: "",
                        text: "Record saved successfully.",
                        type: "success",
                    }, function (isConfirm) {
                        if (isConfirm) {
                            window.location.href = "../ACR/PADashboard";
                        }
                    });
                }
                else if (data.res == 0 || data.res == -1) {
                    sweetAlert("Oops..", "Error in Uploaded Data.", "error");
                }
                else if (data.res == 3) {
                    sweetAlert("Oops..", data.errmsg, "error");
                }
                $("#btnUpload").attr("disabled", false);
            },
            error: function () {
                $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                $("#btnUpload").attr("disabled", false);
            }
        })
    }
</script>

