                </tr>
                <tr style="background-color:white;">
                    <td style=" border: 0px;">
                        <input type="button" value="Submit" class="submit btn btn-success" id="btnSave" data-ctrl="save-btn-upld" style="float:right;" />
                    </td>
                    <td style=" border: 0px;">
                        <input type="button" value="Cancel" class="submit btn btn-danger" data-dismiss="modal" id="btnSave" />
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>


