                $('#ddDesignation').addClass('validationError');
                $('#spn_auth_msg').text('Please select designation.');
                return;
            }
            $('#txtEmpcode').removeClass('validationError');
            if ($('#txtEmpcode').val() == "") {
                $('#txtEmpcode').addClass('validationError');
                $('#spn_auth_msg').text('Please enter employee code.');
                return;
            }
            if (arrayList.length > 0) {
                var itemArray = $.grep(arrayList, function (e) {
                    return e.ADEMPCODE == $('#txtEmpcode').val();
                });
                if (itemArray.length > 0) {
                    $('#txtEmpcode').addClass('validationError');
                    $('#spn_auth_msg').text('This approval authority already added.');
                    return;
                }

                var itemArray2 = $.grep(arrayList, function (e) {
                    return e.APP_SEQ == $('#ddDesignation').val();
                });
                if (itemArray2.length > 0) {
                    $('#ddDesignation').addClass('validationError');
                    $('#spn_auth_msg').text('This designation already added.');
                    return;
                }
