        function CheckFormValidation() {
            $('#div_valid_msg').addClass('hidden');
            var isVailed = true; validationMsg = "";
            $('#txtAcrNo').removeClass('validationError');
            if ($('#txtAcrNo').val() == "") {
                $('#txtAcrNo').addClass('validationError');
                isVailed = false;
                validationMsg = " ACR No, "
            }
            $("#txtAcrFile").removeClass('validationError');
            if ($('#txtAcrFile').val() == "") {
                $("#txtAcrFile").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "ACR Attachment, "
            }
            $("#txtAmount").removeClass('validationError');
            if ($('#txtAmount').val() == "") {
                $("#txtAmount").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "Amount, "
            }
            $("#txtPONumber").removeClass('validationError');
            if ($('#txtPONumber').val() == "") {
                $("#txtPONumber").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "PO Number, "
            }
            //Addded by aumento for new Payment processing site----------
            $("#ddSite").removeClass('validationError');
            //SR80086 Start
            var e = document.getElementById("ddSite");
            if ($('#ddSite').val() == null || e.options[e.selectedIndex].text =="Select")
          //if ($('#ddSite').val() == null)
            //SR80086 end
            {
                $("#ddSite").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "Payment Processing Site, "
            }
            //-------------------End Payment processing site-------------
            $("#txtAcrDesc").removeClass('validationError');
            if ($('#txtAcrDesc').val() == "") {
                $("#txtAcrDesc").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "ACR Description"
            }
            validationMsg = validationMsg + (isVailed == true ? "" : " feild(s) is/are mandatory.");
            $('#spn_valid_msg').text(validationMsg);
            return isVailed;
        }

        function submitForm() {
            $('#txtEmpcode').removeClass('validationError');
            $("#ddDocType").removeClass('validationError');

            var isFormVaildation = CheckFormValidation();
            if (isFormVaildation) {
                var poDocTr = $("#append_PRdocRow .tr_doc1");
                if(poDocTr.length == 0){
                    var poDoc_obj = $.grep(attachmentArray, function (e) {
                        return e.DOC_TYPE == "PO";
                    });
                    if(poDoc_obj==null || poDoc_obj.length==0){
                        sweetAlert("", "PO & Supporting Documents not exist. Please add PO document", "warning");
                        $("#ddDocType").addClass('validationError');
                        return;
                    }
                }

                var docTr = $("#append_docRow .tr_doc");
                if(docTr.length > 0){
                    for (var i = 0; i < docTr.length; i += 1) {
                        var row = docTr[i];
                        if (row != undefined) {
                            var varificationText = row.cells[3].innerHTML.trim();
                            if(varificationText == "Not Verified"){
                                sweetAlert("", "Document not verified. Please open all document & verified", "warning");
                                return;
                            }
                        }
                    }
                }
                //else{
                //    sweetAlert("", "Please upload documents.", "warning");
                //    return;
                //}

                if (arrayList == null || arrayList.length == 0) {
                    $('#txtEmpcode').addClass('validationError');
                    sweetAlert("", "Please add approval authority.", "warning");
                    return;
                }
                else {
                    $("#btnSave").attr("disabled", true);
                    var data = {
        ACRHEADERID : parseFloat($("#hfAcrHeaderId").val()),
        REMARK : $("#txtRemark").val(),
        STATUS : 1,
        PROCESS_STATUS : 1,
        IsFinalSubmit : 1,
        acrAuthSeq : arrayList,
        //skipAuthList: delAuthArray
        }
                    $.ajax({
                        type: "POST",
                        url: "/ACR/ACRRequest",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        data: JSON.stringify(data),
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (data) {
                            if (data == 1) {
                                swal({
                                    title: "",
                                    text: "Record saved successfully.",
                                    type: "success",
                                }, function (isConfirm) {
                                    if (isConfirm) {
                                       // window.location.href = "/ASPXView/ManageRequest.aspx";
                                       //window.location.href = "/ManageRequest/ManageRequest";
                                         window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                                    }
                                });
                            }
                            else if (data == 2) {
                                sweetAlert("", "This ACR already processed.", "warning");
                                $("#btnSave").attr("disabled", false);
                            }
                            else if (data == 3) {
                                sweetAlert("", "Please upload ACR document.", "warning");
                                $("#btnSave").attr("disabled", false);
                            }
                            else {
                                sweetAlert("", "Record not saved.", "warning");
                                $("#btnSave").attr("disabled", false);
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                            $("#btnSave").attr("disabled", false);
                        }
                    });
                }
            }
            else {
                $('#div_valid_msg').removeClass('hidden');
            }
        }

        function openInfo(url) {
            window.open(url, 'mywin', 'width=500,height=500');
        }

