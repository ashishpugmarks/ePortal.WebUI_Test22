                    BindData(arrayList);
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }


        function DeleteItem(current) {
            var deleteRemarks = "";
            swal({
                title: "",
                text: "Remark",
                type: "input",
                showCancelButton: true,
                closeOnConfirm: false,
                inputPlaceholder: "Please enter remark"
            }, function (inputValue) {
                if (inputValue === false) return false;
                if (inputValue === "") {
                    swal.showInputError("You need to write something!");
                    return false
                }
                else{
                    deleteRemarks = inputValue;
                    $.ajax({
                        type: "GET",
                        url: "/ACR/DeleteAppAuthority",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        data: { eCode: current.id, remark: deleteRemarks },
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (data) {
                            if (data.RESULT == 1) {
                                arrayList = data.SEQ_LIST;
                                swal("", "Authority skip successfully.", "success");
                            }
                            else {
                                $('#spn_auth_msg').text('Record not deleted.');
                            }
                        },
                        complete: function () {
                            BindData(arrayList);
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }
            });
        }

        function BindData(arrayList) {
            debugger;
            var rows = "", rowId = 0;
            if (arrayList != null) {
                if (arrayList.length > 0) {
                    $.each(arrayList, function (i, item) {
                        rowId = i + 1;
                        rows += "<tr><td class='text-center'>" + rowId + "</td><td class='text-center'>" + item.ADEMPCODE + "</td>"
                        rows += "<td class='text-left'>" + item.ADEMPNAME + "</td><td class='text-center'>" + item.ADDESIGNATION + "</td>"
                        //rows += "<td class='text-center'>" + item.APP_SEQ + "</td>"
                        rows += "<td class='text-center'><a id='" + item.ADEMPCODE + "' style='cursor: pointer;' data-ctrl-id='del-emp-id'>Skip</a></td>"
                        rows += "</tr>"
                    });
                }
                else {
                    rows += "<tr id='div-table'><td colspan='5' class='text-center'>No record found.</td></tr>"
                }
                document.getElementById("append_row").innerHTML = rows;

                //Adding event listeners for the inline events to satisfy csp validation rules.
                $("[data-ctrl-id='del-emp-id']").on('click', function () {
                    DeleteItem($(this)[0]);
                });
            }
        }
