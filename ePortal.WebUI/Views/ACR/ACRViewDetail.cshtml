                                                                                    }
                                                                                    else if (item.APPROVAL_STATUS == 1)
                                                                                    {
                                                                                        _msg = "Approved";
                                                                                    }
                                                                                    else if (item.APPROVAL_STATUS == 2)
                                                                                    {
                                                                                        _msg = "Send back";
                                                                                    }
                                                                                    else if (item.APPROVAL_STATUS == 3)
                                                                                    {
                                                                                        _msg = "Rejected";
                                                                                    }
                                                                                    else if (item.APPROVAL_STATUS == 4)
