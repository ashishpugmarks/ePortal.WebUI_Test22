        ////======== Bind Taxation Authority ========////
        function BindTaxationAuthority(crnt, call) {
            var tID = $(crnt).val();
            if (tID == "") {
                tID = 0;
            }


            $.getJSON("/SM/BindTaxationAuth", { typeId: tID },
                   function (data) {
                       var select = $("#ddTaxationAuth");
                       select.empty();
                       var _options = "";
                       $(".dropdown-menu").html(_options);
                       if (data.length > 0) {
                           $.each(data, function (index, itemData) {
                               select.append($('<option/>', {
                                   value: itemData.ECODE,
                                   text: itemData.ENAME
                               }));
                               _options += '<li><a tabindex="0"><label class="checkbox" title="' + itemData.ENAME + '"><input type="checkbox" value="' + itemData.ECODE + '">' + itemData.ENAME + '</label></a></li>'
                           });
                       }
                       else {
                           select.empty();
                           _options = "";
                       }
                       $(".dropdown-menu").html(_options);
                       $("#ddTaxationAuth").multiselect('refresh');
                   });
        };
    </script>

