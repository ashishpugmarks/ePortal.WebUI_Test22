@model ePortal.ViewModels.SearchACRViewModel

@{
    ViewBag.Title = "ACRDashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap-multiselect.css" rel="stylesheet" />

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .form-control {
            height: 28px;
            padding: 3px 3px;
            font-size: 13px;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .ui-widget {
            overflow: auto;
            max-height: 200px;
        }
        /* Added by Aumento start :: SR111540 */
        .ui-autocomplete.ui-widget {
            overflow: auto;
            max-height: 200px;
        }

        .ui-datepicker {
            font-size: 12px !important;
            padding: 4px !important;
        }

            .ui-datepicker table {
                width: auto !important;
            }

            .ui-datepicker td, .ui-datepicker th {
                padding: 2px !important;
            }

                .ui-datepicker td span,
                .ui-datepicker td a {
                    padding: 2px 4px !important;
                }

        .ui-datepicker-prev span::before {
            content: "◀";
            font-size: 13px !important;
            font-weight: bold;
            color: #333;
        }

        .ui-datepicker-next span::before {
            content: "▶";
            font-size: 13px !important;
            font-weight: bold;
            color: #333;
        }

        .ui-datepicker-prev span,
        .ui-datepicker-next span {
            width: auto !important;
            height: auto !important;
            line-height: normal !important;
            display: inline !important;
            text-indent: 0 !important;
            overflow: visible !important;
        }

        .ui-datepicker-prev,
        .ui-datepicker-next {
            font-size: 0 !important;
        }

        .ui-datepicker-prev,
        .ui-datepicker-next {
            width: 18px !important;
            height: 18px !important;
            top: 6px !important;
        }

        .ui-datepicker-prev {
            left: 6px !important;
        }

        .ui-datepicker-next {
            right: 6px !important;
        }
        #txtVendorSearch {
            margin-left: 21px !important;
        }

        /* Added by Aumento End :: SR111540 */

        .ui-autocomplete {
            position: absolute;
            top: 100%;
            left: 0;
            z-index: 1000;
            display: none;
            float: left;
            min-width: 160px;
            padding: 5px 0;
            margin: 2px 0 0;
            list-style: none;
            font-size: 14px;
            text-align: left;
            background-color: #ffffff;
            border: 1px solid #cccccc;
            border: 1px solid rgba(0, 0, 0, 0.15);
            border-radius: 4px;
            -webkit-box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
            background-clip: padding-box;
        }

            .ui-autocomplete > li > div {
                display: block;
                padding: 3px 20px;
                clear: both;
                font-weight: normal;
                line-height: 1.42857143;
                color: #333333;
                white-space: nowrap;
            }

        .ui-state-hover,
        .ui-state-active,
        .ui-state-focus {
            text-decoration: none;
            color: #262626;
            background-color: #f5f5f5;
            cursor: pointer;
        }

        .ui-helper-hidden-accessible {
            border: 0;
            clip: rect(0 0 0 0);
            height: 1px;
            margin: -1px;
            overflow: hidden;
            padding: 0;
            position: absolute;
            width: 1px;
        }
    </style>



}


