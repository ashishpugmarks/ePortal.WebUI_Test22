        $(function () {

            $("#txtVendorSearch").autocomplete({
                minLength: 1,
                delay: 300,
                source: function (request, response) {

                    $.ajax({
                        url: "/ACR/AutocompleteSuggestionsVendor",
                        data: { term: request.term },
                        dataType: "json",
                        method: "GET",
                        success: function (data) {
                           //console.log("API raw data:", data);
                            const VendorList = data?.VendorList ?? data?.resultObject?.VendorList ?? [];
                            const suggestions = VendorList.map(x => ({
                                label: x.VENDORCODE + " - " + x.NAME1,
                                value: x.VENDORCODE,
                                name: x.NAME1
                            }));
                            response(suggestions);
                        },
                        error: function (error) {
                            console.error("Autocomplete error:", error);
                            response([]);
                        }
                    });

                },
                select: function (event, ui) {

                    $("#txtVendorSearch").val(ui.item.label);
                    $("#txtVendorSearch").data("vendorcode", ui.item.value);
                    $("#txtVendorSearch").data("vendorname", ui.item.name);

                    return false;
                }
            });

        });

