                           }));
                       });
                       if ('@Model.DEPTID' != '' && call == 1) {
                           $("#ddlDep").val('@Model.DEPTID');
                       }
                   });
        };

        ////======== Bind Section========////
        function BindSection(crnt, call) {
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            $.getJSON("/PR/BindSecByDepartmentId", { id: dID },
                   function (data) {
                       var select = $("#ddlSec");
                       select.empty();
                       if (data.length > 0) {
                           select.append($('<option/>', {
