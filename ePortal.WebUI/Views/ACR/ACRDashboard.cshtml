        function UpdateTaxationAuth() {
            var arrayList = [], _currentEcode = 0, _SelectedAuth = 0;
            var hId = $("#hfTaxationSMHid").val();
            var rowLength = $('#tbUpdateHis').find('.row_data').length;
            var rows = $('#tbUpdateHis').find('.row_data');
            for (var i = 0; i < rowLength; i += 1) {
                _currentEcode = 0; _SelectedAuth = 0;
                var row = rows[i];
                if (row != undefined) {
                    debugger;
                    $(row.cells[1]).find('.ddlTaxAuth').removeClass('validationError');
                    _currentEcode = $(row.cells[0]).find('input[type=hidden]').val() == "" ? 0 : $(row.cells[0]).find('input[type=hidden]').val();
                    _SelectedAuth = $(row.cells[1]).find('.ddlTaxAuth').val() == "" ? 0 : $(row.cells[1]).find('.ddlTaxAuth').val();
                    if (_SelectedAuth != 0) {
                        var itemArray = $.grep(arrayList, function (e) {
                            return e.SELECTED_ADEMPCODE == _SelectedAuth;
                        });
                        if (itemArray.length > 0) {
                            $(row.cells[1]).find('.ddlTaxAuth').addClass('validationError');
                            $("#spn_msg").text("Same authority can not be selected.");
                            $("#spn_msg").removeClass('hidden');
                            return;
                        }
                        else {
                            var rowData = {
                                SMHEADERID: parseFloat(hId),
                                ADEMPCODE: parseFloat(_currentEcode),
                                SELECTED_ADEMPCODE: parseFloat(_SelectedAuth)
                            }
                            arrayList.push(rowData);
                        }
                    }
                    else {
                        $(row.cells[1]).find('.ddlTaxAuth').addClass('validationError');
                    }
                }
            }

            if (arrayList.length > 0) {
                $('#updateAuthModel').modal('hide');

                $.ajax({
                    type: "POST",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    url: "/SM/UpdateTaxationAuth",
                    data: JSON.stringify(arrayList),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data == 1) {
                            swal({
                                title: "",
                                text: "Authority updated successfully",
                                type: "success",
                            })
                        }
                        else if (data == 0 || data == -1) {
                            swal({
                                title: "",
                                text: "Authority not updated",
                                type: "warning",
                            })
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }
