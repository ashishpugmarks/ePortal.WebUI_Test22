    <script src="~/lib/bootstrap/js/bootstrap-multiselect.js"></script>
    @*   Uncomment by Aumento End :: SR111540  *@


    @*CSP 3.0 Compliant changes*@
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#ddlDep').on('change', function () {
                BindSection($(this)[0], 0);
            });
            $('#ddlDiv').on('change', function () {
                BindDepartment($(this)[0], 0);
            });
            $('#ddlOp').on('change', function () {
                BindDivision($(this)[0], 0);
            });

            $('#btnUpdate').on('click', function () {
                UpdateTaxationAuth();
            });
            $('#btnReset').on('click', function () {
                location.href = '@Url.Action("ACRDashboard", "ACR")';
            });
            $('#btnExcel').on('click', function () {
                GetExcel($(this)[0]);
            });
            $('#btnSubmit').on('click', function () {
                GetDashboardRecord($(this)[0]);
                return false;
            });
        });
    </script>
