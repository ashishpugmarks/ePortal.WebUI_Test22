<div id="updateAuthModel" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="padding:10px!important;">
                <div class="pull-left">
                    <h5 class="modal-title">Update Taxation Authority</h5>
                </div>
                <div class="pull-right">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
            <div class="modal-body">
                <div id="updateAuthModelContent">
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-12">
                                <input type="hidden" id="hfTaxationSMHid" />
                                <table class="table table-bordered" id="tbUpdateHis" style="font-size: small">
                                    <thead>
                                        <tr class="bg-primary">
                                            <th colspan="2">
                                                <span id="spn_row_id"></span>
                                            </th>
                                        </tr>
                                        <tr class="bg-info">
                                            <th width="50%">
                                                Current Authority
                                            </th>
                                            <th>
                                                Change Authority
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody id="append_AppHis"></tbody>
                                </table>
                                <span id="spn_msg" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <input type="button" value="Update" class="btn btn-success" id="btnUpdate" />
                <button type="button" class="btn btn-default" data-dismiss="modal" aria-label="Close">Cancel</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @*  Uncomment  by Aumento start :: SR111540   *@  
