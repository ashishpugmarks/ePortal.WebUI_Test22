@model List<ePortal.ViewModels.APPX.OrgChartItem>

@{
    ViewData["Title"] = "HMSI Organisation";
    Layout = null;
}


<style>
    /* Define row1/row2 if you used them for alternating colors */
    .row1 {
        background-color: #f7f7f7;
    }

    .row2 {
        background-color: #ffffff;
    }
</style>


<table cellspacing="0" cellpadding="1" width="100%" border="0">
    <tbody>
        @if (Model == null || Model.Count == 0)
        {
            <tr><td><em>No active organisation records found.</em></td></tr>
        }
        else
        {
            @for (var i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                var cssClass = (i % 2 == 0) ? "row1" : "row2"; // alternate rows

                <tr class="@cssClass">
                    <td>
                        <table>
                            <tr>
                                <td>
                                    <span style="color: red;">@item.Description</span>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:50%; text-align:left; color:#0000FF">
                                        <img src="@Url.Content($"~/Uploads/HMSIOrganisation/{@item.FileName}")" alt="HMSI Organisation" border="1" />                                                                            
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
