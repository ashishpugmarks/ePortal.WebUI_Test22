@model ePortal.ViewModels.APPX.EmpSearchViewModel


<div style="width: 100%;">
    @if (Model.SummaryList != null && Model.SummaryList.Count > 0)
    {
        <table id="summaryTable" class="table table-bordered table-striped table-condensed table-hover" cellpadding="4" cellspacing="1" style="width: 100%;">
            <thead style="background-color:#337ab7;color:white;">
                <tr>
                    <th>Emp Code</th>
                    <th>Name</th>
                    <th>Operation/Div./Dept.</th>
                    <th>Designation</th>
                    <th>Fnc. Designation</th>
                    <th>Mobile No.</th>
                    <th>Email Id</th>
                    <th>Blood Group</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var entry in Model.SummaryList.Select((item, index) => new { item, index }))
                {
                    <tr>                        
                        <td>
<a href="#"
                   class="employee-detail-link"
                               data-empcode="@entry.item.Ecode"
                   data-winwidth="500"
                   data-winheight="490" >
                                <img id="img1" style="padding-right: 2px; vertical-align: middle" src="~/images/icon_ticketbullet.gif"
                                     alt="Ticket" />&nbsp;<b>@entry.item.Ecode</b>
                            </a>
                        </td>
                        <td>@entry.item.Name</td>
                        <td>@entry.item.Operation</td>
                        <td>@entry.item.Designation</td>
                        <td>@entry.item.FunDesignation</td>
                        <td>@entry.item.Mobile</td>
                        <td>@entry.item.EmailId</td>
                        <td>@entry.item.BloodGroup</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <h4 class="mt-4">No Record Found.</h4>
    }   
    <br />
</div>

