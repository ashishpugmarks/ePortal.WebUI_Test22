@model ePortal.ViewModels.APPX.AppEmpSearchViewModel


<div style="width: 100%;">
    @if (Model.SummaryList != null && Model.SummaryList.Count > 0)
    {
        <table id="summaryTable" class="table table-bordered table-striped table-condensed table-hover" cellpadding="4" cellspacing="1" style="width: 100%;">
            <thead style="background-color:#337ab7;color:white;">
                <tr>
                    <th>Emp Code</th>
                    <th>Name</th>
                    <th>Operation/Div./Dept.</th>
                    <th>Designation</th>
                    <th>DOB</th>
                    <th>DOJ</th>
                    <th>Location</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var entry in Model.SummaryList.Select((item, index) => new { item, index }))
                {
                    <tr>
                        <td><b>@entry.item.Ecode</b></td>
                        <td>@entry.item.Name</td>
                        <td>@entry.item.Operation</td>
                        <td>@entry.item.Designation</td>
                        <td>@entry.item.DOB</td>
                        <td>@entry.item.DOJ</td>
                        <td>@entry.item.Location</td>                       
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <h4 class="mt-4">No Record Found.</h4>
    }   
    <br />
</div>

