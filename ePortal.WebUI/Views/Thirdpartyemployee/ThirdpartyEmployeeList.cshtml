           function exportToExcel() {
               let table = document.getElementById("mappingTable");
               let rows = table.getElementsByTagName("tr");
               let data = [];

               for (let i = 1; i < rows.length; i++) { // Start from index 1 to skip header
                   let cells = rows[i].getElementsByTagName("td");
                   let rowData = [];
                   for (let j = 0; j < cells.length; j++) {
                       rowData.push(cells[j].innerText);
                   }
                   data.push(rowData);
               }

               $.ajax({
                   url: '/ThirdpartyEmployee/ExportToExcel',
                   type: 'POST',
                   contentType: 'application/json',
                   data: JSON.stringify({ tableData: data }),
                   xhrFields: { responseType: 'blob' }, // FIX: Handle binary response properly
                   success: function (response) {
                       let a = document.createElement("a");
                       let url = window.URL.createObjectURL(response);
                       a.href = url;
                       a.download = "Associates.xlsx";
                       document.body.appendChild(a);
                       a.click();
                       document.body.removeChild(a);
                       window.URL.revokeObjectURL(url);
                   },
                   error: function () {
                       alert("Failed to export data.");
                   }
               });
           }
