@section Scripts{
    <script src="~/js/jquery.dataTables.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
           $(document).ready(function () {
               //Function For Sorting//
               $("th").click(function () {
                   var table = $(this).parents("table").eq(0)
                   var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()))
                   this.asc = !this.asc
                   if (!this.asc) { rows = rows.reverse() }
                   for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
               })

               //Function For Sorting//
               function comparer(index) {
                   return function (a, b) {
                       var valA = getCellValue(a, index), valB = getCellValue(b, index)
                       return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
                   }
               }
               //Function For Sorting//
               function getCellValue(row, index) {
                   return $(row).children("td").eq(index).html()
               }
               $("#btnSearch").click(function () {

                   var Searchvalue = $("#searchInput").val().toLowerCase();
                   PreLoadData(Searchvalue);
               });
               PreLoadData("");
               $("#btnAdd").on("click", function(){
               //onclick="return ADD()"
               ADD();
               });
           });


           // Added by TTL SR94104 - CR6022
           document.getElementById("excelFile").addEventListener("change", function () {
               
               var file = $("#excelFile")[0].files[0];
               if (!file) {
                   alert("Please select a file first.");
                   return;
               }

               var formData = new FormData();
               formData.append("file", file);

               $.ajax({
                   url: '/ThirdpartyEmployee/UploadMappings',
                   type: 'POST',
                   data: formData,
                   beforeSend: function () {
                       $("#ajaxLoader").addClass('loader');
                   },
                   contentType: false,
                   processData: false,
                   success: function (data) {
                       
                       var table = $("#mappingTable");
                       var btn = $("#submit");
                       var tbody = table.find("tbody");
                       //if ($.fn.DataTable.isDataTable('#mappingTable')) {
                       //    $('#mappingTable').DataTable().clear().destroy();
                       //}
                       tbody.empty();

                       const mappings = data.mappings || [];
                       const duplicateErrors = data.duplicateErrors || [];
                       const validationErrors = data.validationErrors || [];
                       const invalidEmails = data.invalidEmails || [];
                       const existRecords = data.existRecords || [];
                       const invalidOwner = data.invalidOwner || [];
                       var hasError = false;

                       if (mappings.length === 0) {
                           table.hide();
                           btn.hide();
                           $("#legend").hide();
                           sweetAlert("", "File is empty, please add data and try again", "warning");
                           return;
                       }

                       $.each(mappings, function (i, row) {
                           let trClass = "";

                           if (row.ErrorFlag == 1) {
                               trClass = " style='background-color: #f7a3ab;'"; // for Validation error for Empty data or Invalid Email or Invalid Ownership
                               hasError = true;
                           } else if (row.ErrorFlag == 2) {
                               trClass = " style='background-color: #fce38a;'"; // Duplicate data in excel
                               hasError = true;
                           } else if (row.ErrorFlag == 3) {
                               trClass = " style='background-color: #dddddd;'"; // Already exists data in DB
                               hasError = true;
                           }
                           else {
                               trClass = " style='background-color: transparent !important;'"; // transparent: for no Error
                           }

                           var tr = "<tr" + trClass + ">" +
                               "<td></td>" +
                               "<td>" + (row.AssociateName ?? "") + "</td>" +
                               "<td>" + (row.Designation ?? "") + "</td>" +
                               "<td>" + (row.CompanyName ?? "") + "</td>" +
                               "<td>" + (row.AssociateCompanyId ?? "") + "</td>" +
                               "<td>" + (row.ProjectManagerName ?? "") + "</td>" +
                               "<td>" + row.ProjectManagerMailID + "</td>" +
                               "<td>" + row.AccoountManagerName + "</td>" +
                               "<td>" + row.AccountManagerMailID + "</td>" +
                               "<td>" + row.OwnerEmpCode + "</td>" +
                               "<td>" + row.OwnerEmpName + "</td>" +
                               "</tr>";
                           tbody.append(tr);
                       });
                       //$('#mappingTable').DataTable({
                       //    searching: false,
                       //    bPaginate: true,
                       //    pageLength: 10,
                       //    lengthChange: false,
                       //    info: false,
                       //    ordering: false
                       //});
                       table.show();
                       $("#legend").show();

                       if (hasError) {
                           btn.hide();
                           if (duplicateErrors.length > 0) {
                               //sweetAlert("Duplicates Found", duplicateErrors.join("<br/>"), "warning");
                               swal({
                                   type: 'warning',
                                   title: 'Duplicates Found',
                                   text: duplicateErrors.length + " Duplicate records found in Excel file.",
                                   confirmButtonText: 'OK',
                                   html: true
                               });
                           } else if (validationErrors.length > 0) {
                               //sweetAlert("Warning", "Some Employee(s) are not exist.", "warning");
                               swal({
                                   type: 'warning',
                                   title: 'Empty Fields Found',
                                   text: "Empty fields found in " + validationErrors.length + " records",
                                   confirmButtonText: 'OK',
                                   html: true
                               });
                           }
                           else if (invalidEmails.length > 0) {
                               //sweetAlert("Warning", "Some Employee(s) are not exist.", "warning");
                               swal({
                                   type: 'warning',
                                   title: 'Email Id Not Valid',
                                   text: 'Invalid Email Id(s) found in ' + invalidEmails.length + ' records',
                                   confirmButtonText: 'OK',
                                   html: true
                               });
                           }
                           else if (existRecords.length > 0) {
                               //sweetAlert("Warning", "Some Employee(s) are not exist.", "warning");
                               swal({
                                   type: 'warning',
                                   title: 'Records Exist',
                                   text: existRecords.length + ' records are already exist in DB',
                                   confirmButtonText: 'OK',
                                   html: true
                               });
                           }
                           else if (invalidOwner.length > 0) {
                               //sweetAlert("Warning", "Some Employee(s) are not exist.", "warning");
                               swal({
                                   type: 'warning',
                                   title: 'Invalid Ownership',
                                   text: invalidOwner.length + ' records have invalid Ownership',
                                   confirmButtonText: 'OK',
                                   html: true
                               });
                           }
                           //else {
                           //    sweetAlert("Warning", "Some Employee(s) are already mapped with respective Application Id.", "warning");
                           //}
                       } else {
                           btn.show();
                       }
                   },
                   complete: function () {
                       $("#ajaxLoader").removeClass('loader');
                   },
                   error: function () {
                       sweetAlert("Oops...", "Something went wrong!", "error");
                   }
               });

               event.target.value = ""; // Reset file input
           });

           document.getElementById('submitBtn').addEventListener('click', function (e) {
               swal({
                   title: 'Are you sure?',
                   text: "Do you want to submit?",
                   type: 'info',
                   showCancelButton: true,
                   confirmButtonColor: '#28a745', // Bootstrap success green
                   cancelButtonColor: '#d33',
                   confirmButtonText: 'Yes, submit it!'
               }, function (isConfirm) {
                   if (isConfirm) {
                       
                       var data = [];
                       //var Owner = $('#txtownership').val();
                       $('#mappingTable tbody tr').each(function () {
                           var row = $(this).find('td');
                           var record = {
                               AssociateName: row.eq(1).text().trim(),
                               Designation: row.eq(2).text().trim(),
                               CompanyName: row.eq(3).text().trim(),
                               AssociateCompanyId: row.eq(4).text().trim(),
                               ProjectManagerName: row.eq(5).text().trim(),
                               ProjectManagerMailID: row.eq(6).text().trim(),
                               AccoountManagerName: row.eq(7).text().trim(),
                               AccountManagerMailID: row.eq(8).text().trim(),
                               Ownership: row.eq(9).text().trim()
                           };
                           data.push(record);
                       });

                       $("#btnSubmit").attr("disabled", true);
                       $.ajax({
                           type: "POST",
                           url: "/ThirdpartyEmployee/BulkIdUpload",
                           beforeSend: function () {
                               $("#ajaxLoader").addClass('loader');
                           },
                           data: JSON.stringify(data),
                           contentType: "application/json; charset=utf-8",
                           datatype: "json",
                           success: function (data) {
                               
                               const resFlag = data.resFlag;
                               const errmsg = data.err;
                               const result = data.res;

                               var _title = "";
                               var _text = "";
                               var _type = "";

                               if (resFlag == 0) {
                                   //_title = "Not Saved";
                                   //_text = "No Records Saved";
                                   //_type = "info";
                                   sweetAlert("Not Saved", "No Records Saved !", "info");
                               }
                               else if (resFlag == -1) {
                                   //_title = "Error";
                                   //_text = "Error occurred while saving";
                                   //_type = "error";
                                   sweetAlert("Error", "Error occurred while saving !", "error");
                               }
                               else if (resFlag == 1) {
                                   //_title = "Saved";
                                   _text = result.length + " Record(s) Saved successfully. <br/> Click Ok button for export data.";

                                   $("#legend").hide();
                                   $("#submit").hide();

                                   var table = $("#mappingTable");
                                   var tbody = table.find("tbody");
                                   tbody.empty();

                                   $.each(result, function (i, row) {
                                       trClass = " style='background-color: transparent !important;'"; // transparent: for no Error

                                       var tr = "<tr" + trClass + ">" +
                                           "<td>" + (row.Ecode ?? "") + "</td>" +
                                           "<td>" + (row.AssociateName ?? "") + "</td>" +
