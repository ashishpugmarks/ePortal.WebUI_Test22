@model  ePortal.ViewModels.ThirdpartyEmployeeViewModel
@{
    ViewBag.Title = "View";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";
}
@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .ui-widget-content {
            max-height: 200px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .homeContent {
            padding: 0.52em 0.3em 0.78em !important;
        }

        label {
            font-weight: normal !important;
            font-size: 17px !important;
        }
    </style>
}


<div class="panel panel-primary top-margin-10">
    <div class="panel-heading">
        <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px;">View Third Party Employee</h2>

    </div>
    <div class="panel-body" style="padding: 12px;">
        <span id="span-attachmentMsg" style="font-weight:600;"></span>
        <form name="Addemp" id="Addemp" method="post" enctype="multipart/form-data">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px; ">Third Party Employee Registration</h2>
                </div>
                <div class="row" style="margin:10px; display:flex">
                    <input type="hidden" id="txtID" value="@Model.ID" />

                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Associate Unique Code<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtEcode" value="@Model.Ecode" autocomplete="off" disabled />
                    </div>

                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Associate Name<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtAssociateName" value="@Model.AssociateName" placeholder="Enter Associate Name" autocomplete="off" disabled />
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Designation<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtdesignation" value="@Model.Designation" placeholder="Enter Designation" autocomplete="off" disabled />
                    </div>


                </div>
                <div class="row" style="margin:10px; display:flex">

                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Company Name<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtcompanyname" value="@Model.CompanyName" placeholder="Enter Company Name" autocomplete="off" disabled />
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Associate Company ID<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" value="@Model.AssociateCompanyId" placeholder="Enter Associate Company ID" id="txtasscompanyid" autocomplete="off" disabled />
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">

                    </div>

                </div>
                <div class="row" style="margin:10px; display:flex">

                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Project Manager Name<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtprojectmanager" value="@Model.ProjectManagerName" autocomplete="off" placeholder="Enter Project Manager Name" disabled />
                    </div>

                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">
                            Project Manager Mail ID<span style="color:red;font-weight:bold"> *</span>
                        </label>
                        <input type="email" class="form-control" id="txtprojectmanagermailid" autocomplete="off" value="@Model.ProjectManagerMailID" required placeholder="Enter email address" disabled />
                        <div id="emailError" style="color: red; display: none;">Please enter a valid email address.</div>
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">

                    </div>
                </div>
                <div class="row" style="margin:10px; display:flex">
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Account Manager Name<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtaccountmanager" value="@Model.AccoountManagerName" placeholder="Account Manager Name" autocomplete="off" disabled />
                    </div>

                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">
                            Account Manager Mail ID<span style="color:red;font-weight:bold"> *</span>
                        </label>
                        <input type="email" class="form-control" id="txtAccmanagermailid" value="@Model.AccountManagerMailID" autocomplete="off" required placeholder="Enter email address" disabled/>
                        <div id="emailError2" style="color: red; display: none;">Please enter a valid email address.</div>
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">

                    </div>
                </div>
            </div>


            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px; ">Belongs To HMSI</h2>
                </div>
                <div class="row" style="margin:10px; display:flex">
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">OwnerShip<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtownership" value="@Model.Ownership" placeholder="Owner Ship" autocomplete="off" disabled />
                    </div>

                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">

                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">

                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
