@model  ePortal.ViewModels.ThirdpartyEmployeeViewModel
@{
    ViewBag.Title = "ThirdpartyEmployeeEdit";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";
}
@section Styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
        .ui-widget-content {
            max-height: 200px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .homeContent {
            padding: 0.52em 0.3em 0.78em !important;
        }

        label {
            font-weight: normal !important;
            font-size: 17px !important;
        }
    </style>
}

<div class="panel panel-primary top-margin-10">
    <div class="panel-heading">
        <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px;">
            @{
                if (@ViewBag.flag == "OWN")
                {
                    <text>Update Ownership</text>
                }
                else
                {
                    <text>Update Third Party Employee</text>
                }
            }
        </h2>

    </div>
    <div class="panel-body" style="padding: 12px;">
        <span id="span-attachmentMsg" style="font-weight:600;"></span>
       @*  <form name="Addemp" id="Addemp" method="post" enctype="multipart/form-data"> *@
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px; ">Third Party Employee Registration</h2>
                </div>
                <div class="row" style="margin:10px; display:flex">
                    <input type="hidden" id="txtID" value="@Model.ID" />

                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Associate Unique Code<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtEcode" value="@Model.Ecode" autocomplete="off" disabled />
                    </div>

                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Associate Name<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtAssociateName" value="@Model.AssociateName" placeholder="Enter Associate Name" autocomplete="off" />
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Designation<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtdesignation"  value="@Model.Designation"  placeholder="Enter Designation" autocomplete="off" />
                    </div>


                </div>
                <div class="row" style="margin:10px; display:flex">

                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Company Name<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtcompanyname" value="@Model.CompanyName" placeholder="Enter Company Name" autocomplete="off" />
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Associate Company ID<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" value="@Model.AssociateCompanyId" placeholder="Enter Associate Company ID" id="txtasscompanyid" autocomplete="off" />
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">

                    </div>

                </div>
                <div class="row" style="margin:10px; display:flex">

                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Project Manager Name<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtprojectmanager" value="@Model.ProjectManagerName"  autocomplete="off" placeholder="Enter Project Manager Name" />
                    </div>

                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">
                            Project Manager Mail ID<span style="color:red;font-weight:bold"> *</span>
                        </label>
                        <input type="email" class="form-control" id="txtprojectmanagermailid" autocomplete="off" value="@Model.ProjectManagerMailID" required placeholder="Enter email address" />
                        <div id="emailError" style="color: red; display: none;">Please enter a valid email address.</div>
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">

                    </div>
                </div>
                <div class="row" style="margin:10px; display:flex">
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">Account Manager Name<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtaccountmanager" value="@Model.AccoountManagerName"  placeholder="Account Manager Name" autocomplete="off" />
                    </div>

                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">
                            Account Manager Mail ID<span style="color:red;font-weight:bold"> *</span>
                        </label>
                        <input type="email" class="form-control" id="txtAccmanagermailid" value="@Model.AccountManagerMailID"  autocomplete="off" required placeholder="Enter email address" />
                        <div id="emailError2" style="color: red; display: none;">Please enter a valid email address.</div>
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">

                    </div>
                </div>
            </div>


            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px; ">Belongs To HMSI</h2>
                </div>
                <div class="row" style="margin:10px; display:flex">
                    @*<div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">OwnerShip<span style="color:red;font-weight:bold"> *</span></label>
                        <input type="text" class="form-control" id="txtownership" value="@Model.Ownership"  placeholder="Owner Ship" autocomplete="off" />
                    </div>*@
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">
                        <label style="padding-bottom:5px">OwnerShip<span style="color:red;font-weight:bold"> *</span></label>

                     @if (ViewBag.OwnshipList != null)
                     {
                         var ownershipList = ViewBag.OwnshipList as IEnumerable<SelectListItem>;

                         if (ownershipList != null)
                         {
                            <select class="form-control" id="txtownership" autocomplete="off" @(@ViewBag.DisabledDropdown ? "disabled" : "")>

                                @foreach (var item in ownershipList)
                                {
                                    if (Model.Ownership.ToString() == @item.Value.ToString())
                                    {
                                        <option value="@item.Value" selected>@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }

                                }
                            </select>
                         }
                         if (ViewBag.DisabledDropdown == true)
                         {
                            <span style="color:red; font-weight:bold">Team member cannot change ownership for this request</span>
                         }
                     }
                     else
                     {
                            <input type="text" class="form-control" id="txtownership" placeholder="Owner Ship" autocomplete="off" disabled />
                            <span style="color:red; font-weight:bold">Team member cannot change ownership for this request</span>
                     }
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">

                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4" style="margin:10px;">

                    </div>
                </div>
            </div>
            <div class="row" style="margin:10px; display:flex">

                <div class="col-1" style="margin:10px;">
                    <button type="submit" id="btnsubmit" class="btn btn-block btn-success"><i class="menu-icon fa fa-save"></i> &nbsp; Update</button>
                </div>

                <div class="col-1" style="margin:10px;">
                    <button type="button" id="btnCancel" class="btn btn-block btn-danger"><i class="menu-icon fa fa-close"></i> &nbsp; Cancel</button>
                </div>

            </div>
       @*  </form> *@
    </div>
</div>

@section Scripts{
    <script src="~/js/jquery-ui.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $(document).ready(function () {
        debugger;
        var flag =  '@ViewBag.flag';
        if (flag == 'OWN')
        {
            $('#txtAssociateName').prop('disabled', true);
            $('#txtdesignation').prop('disabled', true);
            $('#txtcompanyname').prop('disabled', true);
            $('#txtasscompanyid').prop('disabled', true);
            $('#txtprojectmanager').prop('disabled', true);
            $('#txtprojectmanagermailid').prop('disabled', true);
            $('#txtaccountmanager').prop('disabled', true);
            $('#txtAccmanagermailid').prop('disabled', true);
        }

        AutoSuggest($("#txtcompanyname"));
        AutoSuggestProjectManager($("#txtcompanyname"), $("#txtprojectmanager"));
        AutoSuggestAccountManager($("#txtcompanyname"), $("#txtaccountmanager"));
        AutoSuggestProManMailID($("#txtprojectmanager"), $("#txtprojectmanagermailid"));
        AutoSuggestAccManMailID($("#txtaccountmanager"), $("#txtAccmanagermailid"));
        AutoSuggestOwner($("#txtownership"));

        $('#txtAccmanagermailid').on('input', function () {
            var emailField = $(this);
            var emailError = $('#emailError2');
            // Check if the email input is valid
            if (!emailField[0].checkValidity()) {
                emailError.show();
            } else {
                emailError.hide();
            }
        });
        $('#txtprojectmanagermailid').on('input', function () {
            var emailField = $(this);
            var emailError = $('#emailError');
            // Check if the email input is valid
            if (!emailField[0].checkValidity()) {
                emailError.show();
            } else {
                emailError.hide();
            }
        });
            $('#btnsubmit').on('click', function(){
                    Save();
            });
            $('#btnCancel').on('click', function(){
                            Cancel();
            });
    });

    function Save() {
        var Ecode = $('#txtEcode').val();
        var AssociateName = $('#txtAssociateName').val();
        var Designation = $('#txtdesignation').val();
        var ComapanyName = $('#txtcompanyname').val();
        var CompanyID = $('#txtasscompanyid').val();
        var ProjectManagerName = $('#txtprojectmanager').val();
        var ProjectManagerMailId = $('#txtprojectmanagermailid').val();
        var AccountManagerName = $('#txtaccountmanager').val();
        var AccountManagerMailId = $('#txtAccmanagermailid').val();
        var Ownership = $('#txtownership').val();
        var errpar = "";

        if (Ecode == "") {
            errpar += "Associate Unique Code, ";
        }
        if (AssociateName == "") {
            errpar += "Associate Name, ";
        }
        if (Designation == "") {
            errpar += "Designation, ";
        }
        if (ComapanyName == "") {
            errpar += "Comapany Name, ";
        }
        if (CompanyID == "") {
            errpar += "Associate Company ID, ";
        }
        if (ProjectManagerName == "") {
            errpar += "Project Manager Name, ";
        }
        if (ProjectManagerMailId == "") {
            errpar += "Project Manager Mail-ID, ";
        }
        if (AccountManagerName == "") {
            errpar += "Account Manager Name, ";
        }
        if (AccountManagerMailId == "") {
            errpar += "Account Manager Mail-ID, ";
        }
        if (Ownership == "" ) {
            errpar += "Ownership, ";
        }

        if (errpar.length > 0) {
            errpar = errpar.slice(0, -2);
        }


        if (errpar == "") {

            var jsonData = JSON.stringify({
                Ecode : Ecode!=""?parseInt(Ecode):0,
                AssociateName : AssociateName,
                Designation : Designation,
                CompanyName: ComapanyName,
                AssociateCompanyId : CompanyID,
                ProjectManagerName : ProjectManagerName,
                ProjectManagerMailID : ProjectManagerMailId,
                AccoountManagerName : AccountManagerName,
                AccountManagerMailID : AccountManagerMailId,
                Ownership : Ownership!=""?parseInt(Ownership):0
            });

            var URL = '/ThirdpartyEmployee/ThirdpartyEmployeeEdit';

            $.ajax({
                type: "POST",
                url: URL,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: jsonData,
                // data: {
                //     Data: jsonData
                // },
                success: function (data) {
                    if (data.res == 1) {
                        alert("Data Updated Successfully");
                         $('#btnsubmit').prop('disabled', true);
                        //parent.jQuery.fancybox.close();
                    }
                    else if (data.res == 0) {
                        alert("Associate Company ID: " + CompanyID + " already exists in company: " + ComapanyName);
                    }
                    else {
                        alert("Error: " + data.error);
                    }

                },
                error: function (err) {
                    alert("Error: " + err.responseText);
                }

            });
        }
        else {
            alert("Must fill the data for Field: " + errpar);
        }
        return false;
    }

    function Cancel() {
        parent.jQuery.fancybox.close();
    }

    function AutoSuggest(CompanyName) {

        CompanyName.autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/ThirdpartyEmployee/AutocompleteCompanyName",
                    data: { term: request.term },
                    dataType: "json",
                    method: "GET",
                    success: function (data) {
                        if (data && data.length > 0) {
                            const suggestions = data.map(function (suggestion) {
                                return {
                                    label: suggestion.COMPANYNAME,
                                    value: suggestion.COMPANYNAME,
                                };
                            });
                            response(suggestions.slice(0, 15));
                        } else {
                            response([]);
                        }
                    },
                    error: function (error) {
                        console.error("Error fetching autocomplete suggestions:", error);
                        response([]);
                    },
                });
            },


            select: function (event, ui) {
                CompanyName.val(ui.item.value);
            },

        });
    }

    function AutoSuggestProjectManager(CompanyName, ProjectManagerName) {

        ProjectManagerName.autocomplete({
            source: function (request, response) {

                $.ajax({
                    url: "/ThirdpartyEmployee/AutoCompleteProjectManager",
                    data: {
                        term: request.term,
                        companyName: CompanyName.val()
                    },
                    dataType: "json",
                    method: "GET",
                    success: function (data) {
                        if (data && data.length > 0) {
                            const suggestions = data.map(function (suggestion) {
                                return {
                                    label: suggestion.PROJECTMANAGERNAME,
                                    value: suggestion.PROJECTMANAGERNAME,
                                };
                            });
                            response(suggestions.slice(0, 15));
                        } else {
                            response([]);
                        }
                    },
                    error: function (error) {
                        console.error("Error fetching autocomplete suggestions:", error);
                        response([]);
                    },
                });
            },


            select: function (event, ui) {
                ProjectManagerName.val(ui.item.value);
            },

        });
    }

    function AutoSuggestAccountManager(CompanyName, AccountManagerName) {

        AccountManagerName.autocomplete({
            source: function (request, response) {

                $.ajax({
                    url: "/ThirdpartyEmployee/AutoCompleteAccountManager",
                    data: {
                        term: request.term,
                        companyName: CompanyName.val()
                    },
                    dataType: "json",
                    method: "GET",
                    success: function (data) {
                        if (data && data.length > 0) {
                            const suggestions = data.map(function (suggestion) {
                                return {
                                    label: suggestion.ACCOUNTMANAGERNAME,
                                    value: suggestion.ACCOUNTMANAGERNAME,
                                };
                            });
                            response(suggestions.slice(0, 15));
                        } else {
                            response([]);
                        }
                    },
                    error: function (error) {
                        console.error("Error fetching autocomplete suggestions:", error);
                        response([]);
                    },
                });
            },


            select: function (event, ui) {
                AccountManagerName.val(ui.item.value);
            },

        });
    }

    function AutoSuggestProManMailID(ProjectManagerName, projectmanagermailid) {

        projectmanagermailid.autocomplete({
            source: function (request, response) {

                $.ajax({
                    url: "/ThirdpartyEmployee/AutoCompleteProjectManagerMailid",
                    data: {
                        term: request.term,
                        ProjectManagerName: ProjectManagerName.val()
                    },
                    dataType: "json",
                    method: "GET",
                    success: function (data) {
                        if (data && data.length > 0) {
                            const suggestions = data.map(function (suggestion) {
                                return {
                                    label: suggestion.PROJECTMANAGERMAILID,
                                    value: suggestion.PROJECTMANAGERMAILID,
                                };
                            });
                            response(suggestions.slice(0, 15));
                        } else {
                            response([]);
                        }
                    },
                    error: function (error) {
                        console.error("Error fetching autocomplete suggestions:", error);
                        response([]);
                    },
                });
            },


            select: function (event, ui) {
                projectmanagermailid.val(ui.item.value);
                var emailField = $('#txtprojectmanagermailid');
                var emailError = $('#emailError');

                if (!emailField[0].checkValidity()) {
                    emailError.show();
                } else {
                    emailError.hide();
                }
            },

        });
    }

    function AutoSuggestAccManMailID(AccountManagerName, Accountmanagermailid) {

        Accountmanagermailid.autocomplete({
            source: function (request, response) {

                $.ajax({
                    url: "/ThirdpartyEmployee/AutoCompleteAccountManagerMailid",
                    data: {
                        term: request.term,
                        AccountManagerName: AccountManagerName.val()
                    },
                    dataType: "json",
                    method: "GET",
                    success: function (data) {
                        if (data && data.length > 0) {
                            const suggestions = data.map(function (suggestion) {
                                return {
                                    label: suggestion.ACCOUNTMANAGERMAILID,
                                    value: suggestion.ACCOUNTMANAGERMAILID,
                                };
                            });
                            response(suggestions.slice(0, 15));
                        } else {
                            response([]);
                        }
                    },
                    error: function (error) {
                        console.error("Error fetching autocomplete suggestions:", error);
                        response([]);
                    },
                });
            },


            select: function (event, ui) {
                Accountmanagermailid.val(ui.item.value);
                var emailField = $('#txtAccmanagermailid');
                var emailError = $('#emailError2');
                if (!emailField[0].checkValidity()) {
                    emailError.show();
                } else {
                    emailError.hide();
                }
            },

        });
    }

    function AutoSuggestOwner(Owner) {

        Owner.autocomplete({
            source: function (request, response) {

                $.ajax({
                    url: "/ThirdpartyEmployee/AutocompleteOwner",
                    data: { term: request.term },
                    dataType: "json",
                    method: "GET",
                    success: function (data) {
                        const resobj = data.resultObject
                        if (resobj && resobj.length > 0) {

                            const suggestions = resobj.map(function (r) {
                                return {
                                    label: r.ecode + ' - ' + r.name,
                                    value: r.ecode,
                                };

                            });
                            response(suggestions.slice(0, 15));
                        } else {
                            response([]);
                        }
                    },
                    error: function (error) {
                        console.error("Error fetching autocomplete suggestions:", error);
                        response([]);
                    },
                });
            },


            select: function (event, ui) {
                Owner.val(ui.item.value);
            },

        });
    }
</script>
}