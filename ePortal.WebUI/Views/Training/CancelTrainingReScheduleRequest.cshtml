@section Scripts {
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
         $(document).ready(function(){
            $("#btnCancel").click(function(e){
                e.preventDefault();
                let isValid =  validateForm();
                if(isValid){
                    submitCancel();
                }
            });
        });
        function validateForm()
        {
            var objRemarks = $("#txtRemarks").val();

            if(trim(objRemarks)=="" || trim(objRemarks).length==0 )
            {
                alert('Please Fill Remarks.');
                return false;
            }
            return true;
        }

        function submitCancel(){
            let data = {
                strRequestID : $("#hdnReqId").val(),
                strCancelRemarks :  $("#txtRemarks").val(),
            };
            $.ajax({
                url: '@Url.Action("SubmitCancelReScheduleRequest", "Training")',
                type: 'POST',
                data: data,
                success: function (response) {
                    if (response.ToString() == "")
                    {
                        window.location.href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                    }
                    else
                    {
                        alert("Request canceled successfully")
                    }
                },
                error: function () {
                    alert('An error occurred while submitting the form.');
                }
            });
        }
        // Removes leading whitespaces
         function LTrim( value ) {
             var re = /\s*((\S+\s*)*)/;
             return value.replace(re, "$1");
         }

         // Removes ending whitespaces
         function RTrim( value ) {
             var re = /((\s*\S+)*)\s*/;
             return value.replace(re, "$1");
         }

         // Removes leading and ending whitespaces
         function trim( value ) {
             return LTrim(RTrim(value));
         }
    </script>
