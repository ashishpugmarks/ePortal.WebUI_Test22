@section Scripts{
    <script type="text/javascript" language="javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function(){
            $("#txtAPPRemarks").change(validateForm);
            $("#btnUpdate").click(function (e) {
                e.preventDefault();
                update();
            });

            $("#btnCancel").click(function (e) {
                e.preventDefault();
                cancel();
            });
        });
        function update(){
            let data = {
                strRemarks :  $("#txtAPPRemarks").val(),
                strRequestID : $("#hdnReqId").val(),
                strStatus : $("input[name='STATUS']:checked").val(),
                EmpCode : $("#ltlECode").text()
            };
            $.ajax({
                url: '@Url.Action("UpdateRescheduleReqByApp", "Training")',
                type: 'POST',
                // contentType: 'application/json',
                data: data,
                success: function (response) {
                    if (response == "0")
                    {
                        $("#errorpanel").show();
                        status.Text = "There is error in scheduling this request. Please contact to HR.";
                    }
                    else
                    {
                        alert("Request update successfully")
                        window.location.href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx";
                    }
                },
                error: function () {
                    alert('An error occurred while submitting the form.');
                }
            });
        }
        function cancel(){
           window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx";
        }
        function validateForm() {
            var objRemarks = $("#txtAPPRemarks").val();
            if (trim(objRemarks) == "" || trim(objRemarks).length == 0) {
                // document.getElementById("<%=errorpanel.ClientID%>").style.display = "inline";
                $("#errorpanel").show();
                $("#status").innerHTML = "Remarks is a required field.";
                $("#txtAPPRemarks").focus();
                returnStatus = false;
                return false;
            }
            else {
                // document.getElementById("<%=errorpanel.ClientID%>").style.display = "none";
                $("#errorpanel").hide();
            }
        }

        // Removes leading whitespaces
        function LTrim(value) {
            var re = /\s*((\S+\s*)*)/;
            return value.replace(re, "$1");
        }

        // Removes ending whitespaces
        function RTrim(value) {
            var re = /((\s*\S+)*)\s*/;
            return value.replace(re, "$1");
        }

        // Removes leading and ending whitespaces
        function trim(value) {
            return LTrim(RTrim(value));
        }
    </script>
}