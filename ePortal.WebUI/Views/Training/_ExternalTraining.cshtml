@using ePortal.ViewModels.APPX.Training
@model List<ExternalTrngViewModel>
@if (Model != null && Model.Any())
{
    <table id="grd_extrnltrng" style="width:100%" class="table table-responsive table-borderd table-condensed table-striped">
        <tr>
            <td>
                <table class="table table-responsive table-borderd" id="tbl_Target">
                    <tr class="tcat" style="height:20px;">
                        <td class="font12" style="color: #ffffff; font-weight: bold; width: 10%">
                            Name
                        </td>
                        <td class="font12" style="color: #ffffff; font-weight: bold; width: 15%">
                            External Trng
                        </td>
                        <td class="font12" style="color: #ffffff; font-weight: bold; width: 10%">
                            Section
                        </td>
                        <td class="font12" style="color: #ffffff; font-weight: bold; width: 10%">
                            Venue
                        </td>
                        <td class="font12" style="color: #ffffff; font-weight: bold; width: 10%">
                            Time Period
                        </td>
                    </tr>
                </table>
                <table class="table table-responsive table-borderd" border="0">
                    @foreach (var item in Model)
                    {
                        
                    <tr>
                        <td width="10%" align="left">
                            @item.EmpName
                        </td>
                        <td width="15%" align="left">
                           @item.Topic
                        </td>
                        <td width="10%" align="left">
                           @item.Section
                        </td>
                        <td width="10%" align="left">
                           @item.Agency
                        </td>
                        <td width="10%" align="left">
                            @item.TimePeriod
                        </td>
                    </tr>
                    }
                </table>
            </td>
        </tr>
    </table>
}
else
{
    <table style="width:100%" class="table table-responsive table-borderd table-condensed table-striped" >
        <tr class="text-center">
            <td colspan="7" style="font-family:Calibri; font-weight:bold; text-align:center;" >
                No Extarnal Training is found.
            </td>
        </tr>
    </table>
}

