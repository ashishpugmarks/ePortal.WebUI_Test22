@using ePortal.ViewModels.APPX.Training
@{
    ViewBag.Title = "Evalution List";
    var Pending = ViewBag.Pending as List<EvaluationListViewModel>;
    var Complete = ViewBag.Complete as List<EvaluationListViewModel>;
}
@section Styles {
    <style>
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .homeContent {
            padding: 0;
        }

        table {
            font-size: 14px;
        }

        .table-hover tbody tr:hover {
            background-color: #F5F3DA;
        }

        #grdcompletedtrnlist_info, #grdMyTraining_info {
            margin-left: 15px;
        }

        .table-hover tbody tr:hover {
            background-color: #F5F3DA;
        }

    </style>
}
<form action="" method="post" id="frmMyTrainings">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Training Evaluation List</span>
    </div>
    <div id="up1">
        @* <ContentTemplate> *@
        <table id="tblMyTraining" class="table table-bordered table-condensed table-striped table-responsive">
            <tr>
                <td style="padding-top: 5px;">
                    <div id="errorpanel" style="width:100%;display:none;">
                        <table class="table table-bordered table-condensed table-striped table-responsive">
                            <tbody>
                                <tr class="errorbox">
                                    <td width="16" align="left" valign="middle">
                                        <img src="../../images/icon_error.gif" border="0" alt="" />
                                    </td>
                                    <td align="left" class="errorbox">
                                        <span class="smalltext">
                                            &nbsp;
                                            @*   <asp:TextBox Width="2px" BackColor="#ffeaea" BorderColor="#ffeaea"
                                                                     BorderWidth="0" id="status1"></asp:TextBox> *@

                                            <input type="text" id="status1" name="status1"
                                                   style="width:2px; background-color:#ffeaea; border:0;" />

                                            <b>
                                                @* <label id="status" ForeColor="Red" Text=""></label> *@
                                                <label id="status" class="text-danger"></label>
                                            </b>
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </td>
            </tr>
            <tr>
                <td align="center">

                    <div id="updatepnlmain2">
                        @* <ContentTemplate> *@
                        <div id="Panel1" class="roundedPanel" style="background-color:white;width:100%;text-align:center;">
                            <table class="table table-bordered table-condensed table-striped table-responsive" style="background-color: Transparent; border: 10px solid #C3DDFA;">
                                <tbody>
                                    <tr>
                                        <td style="width: 100%; text-align: center;">
                                            <div style="background-color:#F5F3F0;height:25px;width:99.8%;text-align:left;" id="Panel2top" class="roundedPanel">
                                                <div style="float: left; width: 350px; margin-top: 5px;">&nbsp;&nbsp;<label id="Label2" style="color:#A17832">Pending Training Evaluation List</label></div>
                                            </div>

                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-center">
                                            @if (Pending != null && Pending.Count > 0)
                                            {
                                                <table style="width: 98%;" class="table-hover table table-bordered table-condensed table-striped table-responsive" id="grdMyTraining">
                                                    <thead>
                                                        <tr>
                                                            <th>Emp Name</th>
                                                            <th style="width:30%">Training</th>
                                                            <th style="width:15%">Trng Period</th>
                                                            <th style="width:10%">Trng Time</th>
                                                            <th style="width:20%">Venue</th>
                                                            <th style="width:30px"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>

                                                        @foreach (var item in Pending)
                                                        {
                                                            <tr>
                                                                <td>@item.ENAME [@item.EMPCODE]</td>
                                                                <td>@item.TRAINING</td>
                                                                <td>@item.TRAININGPERIOD</td>
                                                                <td>@item.TRAININGTIME</td>
                                                                <td>@item.TRAININGVENUE</td>
                                                                <td class="text-center">
                                                                    <a href="TrainingEvaluation?batchid=@item.TRANSID&amp;empcode=@item.EMPCODE&status=0&red=2" style="">
                                                                        <img img src='../../Images/feedback.png' width='20' height='20' alt='Click to View' />
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        }

                                                    </tbody>
                                                </table>
                                            }
                                            else
                                            {
                                                <table>
                                                    <tr class="text-center">
                                                        <td colspan="6" class="text-center">No Record Found.</td>
                                                    </tr>
                                                </table>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width: 100%; text-align: center;">
                                            <div style="background-color:#F5F3F0;height:25px;width:100%;text-align:Center;" id="Panel3bottom" class="roundedPanel">
                                            </div>

                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        @* </ContentTemplate> *@
                    </div>

                </td>
            </tr>


            <tr>
                <td align="center">
                    <br />
                    <div id="UpdatePanel1">
                        @* <ContentTemplate> *@
                        <div style="background-color:white;width:100%;text-align:center;" id="Panel2" class="roundedPanel">
                            <table class="table table-bordered table-condensed table-striped table-responsive" style="background-color: Transparent; border: 10px solid #C3DDFA;"
                                   width="98%">
                                <tbody>
                                    <tr>
                                        <td style="width: 100%; text-align: center;">
                                            <div style="background-color:#F5F3F0;height:25px;width:99.8%;text-align:left;" id="Panel3" class="roundedPanel">
                                                <div style="float: left; width: 350px; margin-top: 5px;">&nbsp;&nbsp;<label id="Label1" style="color:#A17832">Completed Training Evaluation List</label></div>
                                            </div>

                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-center">

                                            @if (Complete != null && Complete.Count > 0)
                                            {
                                                    <table style="width: 98%;" class="table table-bordered table-condensed table-striped table-responsive" id="grdcompletedtrnlist">
                                                    <thead>
                                                        <tr>
                                                            <th>Emp Name</th>
                                                            <th style="width:30%">Training</th>
                                                            <th style="width:15%">Trng Period</th>
                                                            <th style="width:10%">Trng Time</th>
                                                            <th style="width:20%">Venue</th>
                                                            <th style="width:30px"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in Complete)
                                                        {
                                                            <tr>
                                                                <td>@item.ENAME [@item.EMPCODE]</td>
                                                                <td>@item.TRAINING</td>
                                                                <td>@item.TRAININGPERIOD</td>
                                                                <td>@item.TRAININGTIME</td>
                                                                <td>@item.TRAININGVENUE</td>
                                                                <td class="text-center">
                                                                    <a href="TrainingEvaluation?batchid=@item.TRANSID&amp;empcode=@item.EMPCODE&status=1&red=2" style="">
                                                                        <img img src='../../Images/feedback.png' width='20' height='20' alt='Click to View' />
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        }

                                                    </tbody>
                                                </table>
                                            }
                                            else
                                            {
                                                <table>
                                                    <tr class="text-center">
                                                        <td colspan="6" class="text-center">No Record Found.</td>
                                                    </tr>
                                                </table>
                                            }


                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width: 100%; text-align: center;">
                                            <div BackColor="#F5F3F0" id="Panel4" Height="25px" Width="100%"
                                                 class="roundedPanel" HorizontalAlign="Center">
                                            </div>

                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        @* </ContentTemplate> *@
                    </div>

                </td>
            </tr>

            @*    <%----------%> *@

            <tr>
                <td style="padding-left: 5px; padding-right: 5px; padding-bottom: 5px; padding-top: 5px;">
                    <table class="table table-bordered table-condensed table-striped table-responsive">
                        <tbody>
                            <tr>
                                <td style="height: 24px; width: 23px;" valign="middle" align="left">
                                    <a title="Back" href="/Home/Home" id="LinkButton1">
                                        <img src="../../Images/icon_back.gif" border="0" alt="" />
                                    </a>
                                </td>
                                <td style="height: 24px; width: 758px;" align="left">
                                    <span class="smalltext">
                                        <a title="Back" id="a1Back" href="/Home/Home">
                                            Back
                                        </a>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </table>
        @* </ContentTemplate> *@
    </div>
</form>

<div id="ajaxLoader"></div>

@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function(){
            $("#grdMyTraining").DataTable({
                "bFilter": false,
                "bLengthChange": false,
                "paging": true,
                "pageLength": 10,
                "ordering": false,
                "autoWidth": false
            });
            $("#grdcompletedtrnlist").DataTable({
                "bFilter": false,
                "bLengthChange": false,
                "paging": true,
                "pageLength": 10,
                "ordering": false,
                "autoWidth": false
            });
        });
       
    </script>
}