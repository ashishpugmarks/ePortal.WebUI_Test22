@using ePortal.ViewModels.APPX.Training
@model TrainingEvaluationViewModel
@{
    ViewBag.Title = "Employee Portal :: Honda Motorcycle & Scooter India Pvt. Ltd.";
}
@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <style>
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .homeContent {
            padding: 0;
        }

        table {
            font-size: 14px;
        }

        .action-msg-fontg {
            padding: 5px !important;
        }
        /* .table-hover tbody tr:hover {
                                                    background-color: #F5F3DA;
                                                } */
    </style>
}
<form id="frmFeedbackform">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Training Evaluation</span>
    </div>
    <table class="table table-bordered table-condensed table-striped table-responsive">
        <tr>
            <td style="padding-top: 5px;">
                <div id="errorpanel" style="width:100%; display:none;">
                    <table class="table table-bordered table-condensed table-striped table-responsive">
                        <tbody>
                            <tr class="errorbox">
                                <td width="16" align="left" valign="middle">
                                    <img src="../../images/icon_error.gif" border="0" alt="" />
                                </td>
                                <td align="left" class="errorbox">
                                    <span class="smalltext">
                                        &nbsp;
                                        @*   <asp:TextBox Width="2px" BackColor="#ffeaea" BorderColor="#ffeaea"
                                                                     BorderWidth="0" id="status1"></asp:TextBox> *@

                                        <input type="text" id="status1" name="status1"
                                               style="width:2px; background-color:#ffeaea; border:0;" />

                                        <b>
                                            @* <label id="status" ForeColor="Red" Text=""></label> *@
                                            <label id="status" class="text-danger"></label>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </td>
        </tr>
        @* <%--<tr>
                <td align="center">
                    <asp:Panel id="PnlUpper11" >
                        <table class="table table-bordered table-condensed table-striped table-responsive">
                            <tr>
                                <td class="smalltext" style="padding: 2px; height: 18px;" align="center">
                                    <b><font color="#707070">&nbsp;Training Evaluation </font></b>
                                </td>
                            </tr>
                        </table>
                    </asp:Panel>
                    <%--<ajaxToolkit:RoundedCornersExtender id="RoundedCornersExtender3"  BehaviorID="RoundedCornersBehavior_Panel1"
                        TargetControlID="PnlUpper11" Radius="6" Corners="All" />--%>
        <%--        </td>
            </tr>--%> *@

        <tr>
            <td>
                <table class="table table-bordered table-condensed table-striped table-responsive">
                    <thead>
                        <tr class="HeaderStyle123">
                            <td style="padding: 6px 0px 6px 0px;" colspan="4">
                                &nbsp;Training Details
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="tr_1" class="info" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Trainee Name :-
                            </td>
                            <td class="smalltext" style="width: 30%; color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;@Model.TrngDetails.EMPNAME
                            </td>
                            <td style="width: 20%; text-align: right; vertical-align: top;" class="font12">
                                &nbsp; Trainee Ecode :-
                            </td>
                            <td class="smalltext" style="width: 25%; color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;@Model.TrngDetails.ADEMPCODE
                            </td>
                        </tr>
                        <tr class="active" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Training :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;@Model.TrngDetails.TRAINING
                            </td>
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Training Time :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;@Model.TrngDetails.TRAININGTIME
                            </td>
                        </tr>
                        <tr class="info" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp; Training Date :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;<asp:Literal id="ltlDate" />@Model.TrngDetails.TRDATE
                            </td>
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Training Venue :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;@Model.TrngDetails.TRAININGVENUE
                            </td>
                        </tr>
                        <tr class="active" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp; Trainer1 :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                @* <asp:Literal  id="ltlTrainer1" /> *@
                                @Model.TrngDetails.TRAINER1
                            </td>
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Trainer2 :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp; @Model.TrngDetails.TRAINER2
                            </td>
                        </tr>
                        <tr class="info" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Training Objective :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;" colspan="3">
                                &nbsp;@Model.TrngDetails.TRAININGOBJECTIVE
                            </td>

                        </tr>
                    </tbody>
                </table>
                <br />
                <table class="table table-bordered table-condensed table-striped table-responsive">
                    <thead>
                        <tr>
                            <td class="HeaderStyle123" style="padding: 6px 0px 6px 0px;">
                                &nbsp;Evaluation Content
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="action-msg-fontg"><span><b>Key Score:-&gt; 5-Exceptional 4-Highly Effective 3-Meets Requirement 2-Need Improvement 1-unsatisfactory.</b></span></div>

                                @if (@Model.IsgridEvalutionVisible)
                                {
                                    <table id="gridEvalution" class="table table-bordered table-condensed table-striped table-responsive" style="width:100%">
                                        <thead>
                                            <tr class="tcat" style="height:20px;">
                                                <th>S.No</th>
                                                <th>Question</th>
                                                <th>Review</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.gridEvalution != null && Model.gridEvalution.Any())
                                            {
                                                for (int i = 0; i < Model.gridEvalution.Count; i++)
                                                {
                                                    <tr>
                                                        <td style="text-align:center">@(@i + 1)</td>
                                                        <input type="hidden" id="hdnBatchId" value="@ViewBag.batchid" />
                                                        <input type="hidden" id="hdnEmpCode" value="@ViewBag.empcode" />
                                                        <input type="hidden" id="hdnRed" value="@ViewBag.red" />
                                                        @Html.HiddenFor(m => m.gridEvalution[i].HRTRAININGQUEID, new { @class = "question-id" })
                                                        <td><span class="question-text">@Model.gridEvalution[i].QUESTION</span></td>
                                                        <td>
                                                            @for (int score = 5; score >= 1; score--)
                                                            {
                                                                @Html.RadioButtonFor(m => m.gridEvalution[i].SCORE1, score) @score
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="3">No Questions found.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                @if (Model.IsANSWERGRIDVisible)
                                {
                                    <table class="table table-bordered table-condensed table-striped table-responsive" style="width:100%" id="ANSWERGRID">
                                        <thead>
                                            <tr class="tcat" style="height:20px;">
                                                <th>S.No</th>
                                                <th>Question</th>
                                                <th>Review</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model != null && Model.ANSWERGRID.Any())
                                            {
                                                for (int i = 0; i < Model.ANSWERGRID.Count; i++)
                                                {
                                                    <tr>
                                                        <td style="text-align:center">@(@i + 1)</td>
                                                        @Html.HiddenFor(m => m.ANSWERGRID[i].HRTRAININGQUEID)
                                                        <td>@Model.ANSWERGRID[i].QUESTION</td>
                                                        <td>
                                                            @for (int score = 5; score >= 1; score--)
                                                            {
                                                                @Html.RadioButtonFor(m => m.ANSWERGRID[i].SCORE1, score, new { disabled = "disabled" }) @score
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="3">No Questions found.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                <div style="width: 100%; text-align:center">
                                    @if (Model.IsBtnSubbmitVisible)
                                    {
                                        <button type="button" id="btnSubmit" class="btn btn-primary">Submit</button>
                                    }
                                    &nbsp;&nbsp;&nbsp;&nbsp;
                                    @if (Model.IsBtnSubbmitVisible)
                                    {
                                        <button type="button" id="btnReset" class="btn btn-secondary" onclick="btnReset_Click">Reset</button>
                                        <input type="hidden" id="HdnValue" />
                                    }
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <table class="table table-bordered table-condensed table-striped table-responsive">
                    <tbody>
                        <tr>
                            <td style="height: 24px; width: 23px;" valign="middle" align="left">
                                <a title="Back" href="/Training/TrainingEvaluationList" id="LinkButton1">
                                    <img src="../../Images/icon_back.gif" border="0" alt="" />
                                </a>
                            </td>
                            <td style="height: 24px; width: 750px;" align="left">
                                <span class="smalltext" style="font-weight: bold;">
                                    <a title="Back" id="LinkButton2">Back </a>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</form>

<script type="text/javascript" language="javascript" nonce="@Context.Items["ScriptNonce_4"]">

    $(document).ready(function () {

        $('#btnSubmit').click(function () {
            let isValid = true;
            let answers = [];

            $('#gridEvalution tbody tr').each(function () {
                let questionId = $(this).find('.question-id').val();
                let selectedScore = $(this).find('input[type="radio"]:checked').val();
                let questionText = $(this).find('.question-text').text().trim();
                if (!selectedScore) {
                    isValid = false;
                    //$(this).css('border', '1px solid #f8d7da'); // Highlight unanswered
                } else {
                    //$(this).css('background-color', '');
                }

                answers.push({
                    HRTRAININGQUEID: questionId,
                    SCORE1: selectedScore,
                    QUESTION: questionText
                });
            });

            if (!isValid) {
                alert('Please select all answers.');
                return;
            }

            let data = {
                TrngDetails:{
                    BATCHID: $('#hdnBatchId').val(),
                    ADEMPCODE: $('#hdnEmpCode').val(),
                },
                Redirection: $('#hdnRed').val(),
                gridEvalution: answers
            };

            $.ajax({
                url: '@Url.Action("SubmitEvaluation", "Training")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (response) {
                    alert(response.message);
                    if (response.success) {
                        window.location.href = response.redirectUrl;
                    }
                },
                error: function () {
                    alert('An error occurred while submitting the form.');
                }
            });
        });

        $("LinkButton2").click(function(){
            var Redirection= $('#hdnRed').val();
            if (Redirection == "2")
            { 
                window.location.href="/Training/TrainingEvaluationList";
            }
            else if (Redirection == "1")
            { 
                window.location.href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx";
            }
            else if (Redirection == "3")
            {
                window.location.href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApprovalHistory.aspx?id=TrngEvals";
            }
        });

        $('#btnReset').click(function () {  
            // Uncheck all radio buttons
            $('#gridEvalution tbody tr').each(function () {
                $(this).find('input[type="radio"]').prop('checked', false);
            });
        });

    });



    function Check1() {
        var first = document.getElementById('<%=HdnValue.ClientID %>');

        if (first.value <= 3) {
            var retvalue = confirm("According to your Evalution, The Candidate score is below 3. So, He/She will be Reschedule for same training. Are your want to Sure. ?");
            if (retvalue == true) {
                first.value = Math.random() * 11;
                __doPostBack("HdnValue", '');
            }
        }
    }
</script>

