@using ePortal.ViewModels.APPX.Training
@model TrainningDetailsViewModel
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head >
    <title>Training Details</title>
    <link href="../../css/index.css" rel="stylesheet" />
    <link href="../../lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="../../Styles/ModalDialogs.css" type="text/css" rel="stylesheet" />
    <link href="../../Styles/GridView.css" type="text/css" rel="stylesheet" />
    <base target="_self" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="-1" />
</head>
<body style="background-color: White; background-image: none">
    <form id="form1" >
        <div>
            <div  id="UP1">
                <div>
                    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
                        <span style="padding-left: 10px;">Training Details</span>
                    </div>
                    <table class="table table-responsive table-borderd">
                        <tr>
                            <td style="width: 100%" align="center">
                                <table class="table table-responsive table-borderd table-condensed table-striped">
                                    <thead>
                                        <tr>
                                            <td class="HeaderStyle123" colspan="4">Training Details -
                                            <span  id="lblEmployeeName">@Model.EMPNAME</span>
                                            </td>
                                        </tr>
                                    </thead>
                                    <tbody style="background-color: #f1f5f6;">
                                        <tr>
                                            <td colspan="4">
                                                <table class="table table-responsive table-borderd table-condensed table-striped">
                                                    <tr>
                                                        <td style="width: 100px; text-align: left; vertical-align: middle; text-align: center; padding: 2px;">
                                                            <table style="background-image: url(../../images/calendar/1273661077_Calendar.png); width: 59px; height: 60px;">
                                                                <tr>
                                                                    <td style="text-align: center; vertical-align: top; color: White;">
                                                                        <span id="lblCalMonth">@Model.TRMONTH</span>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="text-align: center; vertical-align: top; color: Black; font-size: 16px; font-weight: bold;">
                                                                        <span id="lblCalDate">@Model.TRDATE</span>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </td>
                                                        <td align="left" style="width: 1px; border-right-color: White; border-right-width: 1px; border-right-style: solid;">
                                                            <img height="1" src="../../images/space.gif" width="1" alt="space" />
                                                        </td>
                                                        <td>
                                                            <table class="table table-responsive table-borderd table-condensed table-striped">
                                                                <tr>
                                                                    <td style="width: 80px; padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: right; width: 90px;">
                                                                        <span style="font-style: italic;">Training</span>&nbsp;:&nbsp;
                                                                    </td>
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: left; color: #1953FF; width: 150px">
                                                                        <span id="lblTraining">@Model.TRAINING</span>
                                                                    </td>
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: right; width: 90px;">
                                                                        <span style="font-style: italic;">Venue</span>&nbsp;:&nbsp;
                                                                    </td>
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: left; color: #1953FF; width: 25%">
                                                                        <span id="lblVenue">@Model.TRAININGVENUE</span>
                                                                    </td>
                                                                </tr>
                                                                <tr class="row1">
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: right; width: 90px;">
                                                                        <span style="font-style: italic;">Start Date</span>&nbsp;:&nbsp;
                                                                    </td>
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: left; color: #1953FF;">
                                                                        <span id="lblStartDate">@Model.STARTDATE</span>
                                                                    </td>
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: right; width: 90px;">
                                                                        <span style="font-style: italic;">End Date</span>&nbsp;:&nbsp;
                                                                    </td>
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: left; color: #1953FF;">
                                                                        <span id="lblEndDate">@Model.ENDDATE</span>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: right; width: 90px;">
                                                                        <span style="font-style: italic;">Start Time</span>&nbsp;:&nbsp;
                                                                    </td>
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: left; color: #1953FF;">
                                                                        <span id="lblStartTime">@Model.TRAININGSTARTTIME</span>
                                                                    </td>
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: right; width: 90px;">
                                                                        <span style="font-style: italic;">End Time</span>&nbsp;:&nbsp;
                                                                    </td>
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: left; color: #1953FF;">
                                                                        <span id="lblEndTime">@Model.TRAININGENDTIME</span>
                                                                    </td>
                                                                </tr>
                                                                <tr class="row1">
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: right; width: 90px;">
                                                                        <span style="font-style: italic;">Trainer1</span>&nbsp;:&nbsp;
                                                                    </td>
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: left; color: #1953FF;">
                                                                        <span id="lblTrainer1">@Model.TRAINER1</span>
                                                                    </td>
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: right; width: 90px;">
                                                                        <span style="font-style: italic;">Trainer2</span>&nbsp;:&nbsp;
                                                                    </td>
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: left; color: #1953FF;">
                                                                        <span id="lblTrainer2">@Model.TRAINER2</span>
                                                                    </td>
                                                                </tr>
                                                                <tr class="row2">
                                                                    <td style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: right; width: 90px;">
                                                                        <span style="font-style: italic;">Status</span>&nbsp;:&nbsp;
                                                                    </td>
                                                                    <td colspan="3" style="padding-bottom: 5px; padding-top: 5px; border-bottom-color: White; border-bottom-width: 1px; border-bottom-style: solid; text-align: left; color: #1953FF;">
                                                                        <span id="lblStatus">@Model.STATUS</span>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                        <tr class="bstatus1">
                                            <td colspan="4">&nbsp;
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </form>
</body>
</html>
