@using ePortal.ViewModels.APPX.Training
@model ReScheduleRequestViewModel
@{
}
@section Styles {
@* <link href="../../css/index.css" rel="stylesheet" type="text/css" /> *@
    <link rel="stylesheet" href="~/css/new-aproval-page.css" />
    <style>
        .homeContent {
            padding: 0;
        }

        table {
            font-size: 14px;
        }
    </style>

}
<!-- Requester Details -->
<div class="panel panel-shadow">
    <div class="panel-heading" data-toggle="collapse" data-target="#reqDetails">
        <span class="panel-title">
            <i class="fa fa-caret-right caret-color"></i>Requester's Details
        </span>
    </div>
    <div id="reqDetails" class="panel-body panel-collapse collapse in">
        <table class="table table-responsive approval-table table-curved">
            <tbody>
                <tr>
                    <th width="15%">@Html.Label("Employee Code")</th>
                    <td width="35%"><span id="ltlECode">@Model.ADEMPCODE</span></td>
                    <th width="15%">@Html.Label("Employee Name")</th>
                    <td width="35%">@Model.EMP_NAME</td>
                </tr>
                <tr>
                    <th>@Html.Label("Operation")</th>
                    <td>@Model.OPERATION</td>
                    <th>@Html.Label("Division")</th>
                    <td>@Model.DIVISION</td>
                </tr>
                <tr>
                    <th>@Html.Label("Department")</th>
                    <td>@Model.DEPARTMENT</td>
                    <th>@Html.Label("Section")</th>
                    <td>@Model.SECTION</td>
                </tr>
                <tr>
                    <th>@Html.Label("Extension No")</th>
                    <td>@Model.EXTENSIONNO</td>
                    <th>@Html.Label("Phone No")</th>
                    <td>@Model.TMOBILE</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Training Details -->
<div class="panel panel-shadow">
    <div class="panel-heading" data-toggle="collapse" data-target="#trnDetails">
        <span class="panel-title">
            <i class="fa fa-caret-right caret-color"></i>Training & Approval Details
        </span>
    </div>
    <div id="trnDetails" class="panel-body panel-collapse collapse in">
        <table class="table table-responsive approval-table table-curved">
            <tbody>
                <tr>
                    <th width="15%">@Html.Label("Training")</th>
                    <td width="35%">@Model.TRAINING</td>
                    <th width="15%">@Html.Label("Training Period")</th>
                    <td width="35%">@Model.TRAINING_DATE</td>
                </tr>
                <tr>
                    <th>@Html.Label("Training Time")</th>
                    <td>@Model.TRAINING_TIME</td>
                    <th>@Html.Label("Training Venue")</th>
                    <td>@Model.TRAININGVENUE</td>
                </tr>
                <tr>
                    <th>@Html.Label("Reason")</th>
                    <td>@Model.REQREMARKS</td>
                    <th>@Html.Label("Recommendation Authority")</th>
                    <td>@Model.RECEMPNAME</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div id="ViewPanel" style="display:none; width:100%">
    <table class="table table-bordered table-responsive table-condensed table-striped">
        <tr>
            <td width="16" align="left" valign="middle">
                <img src="../../Images/warning_16.png" border="0" alt="" />
            </td>
            <td align="left">
                <span>
                    &nbsp;
                    <input type="text" style="width:2px;background-color:#fff8e9;border:0px solid #fff8e9" id="TextBox1" />
                    <b><label id="lblView" style="color:black"></label></b>
                </span>
            </td>
        </tr>
    </table>

</div>
<!-- Approver Action-->
<div class="panel panel-shadow">
    <div class="panel-heading" data-toggle="collapse" data-target="#approverAction">
        <span class="panel-title"><i class="fa fa-caret-right caret-color"></i>Approval</span>
    </div>
    <div id="approverAction" class="panel-body panel-collapse collapse in">
        <div class="remarks-box">
            <div class="well form-group row" style="width:100%; margin:10px auto;font-size:14px;">
                <input type="hidden" id="hdnReqId" value="@ViewBag.ReqId" />
                <div class="col-sm-3">
                   Available Dates:
                </div>
                <div class="col-sm-9">
                    <select id="ddlAvailableDates" name="AvailableDates" class="form-control"
                            asp-items="@(new SelectList(ViewBag.AvailableDates ?? new List<SelectListItem>(), "Value", "Text"))">
                    </select>
                </div>
            </div>
            <div class="text-center pnl-btn last-row-btn">
                <button type="button" name="rblStatus" class="btn action-btn btn-md reject" data-status="2"><i class="fa fa-times-circle-o"></i>REJECT</button>
                <button type="button" name="rblStatus" class="btn action-btn btn-md approve" data-status="1"><i class="fa fa-check-circle-o"></i>APPROVE</button>
            </div>
            
            <div>
                <div class="well">
                    <textarea id="txtAPPRemarks" class="form-control " placeholder="Enter Remarks."></textarea>
                </div>
            </div>

            <div class="text-center pnl-btn">
                <a title="Back" class="btn back" href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx"><i class="fa fa-arrow-left"></i>BACK</a>
                <a title="Skip" class="btn skip" href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx"><i class="fa fa-step-forward"></i>SKIP</a>
            </div>
        </div>

    </div>
</div>

<script type="text/javascript" language="javascript" nonce="@Context.Items["ScriptNonce_3"]">

    $(document).ready(function(){
        var selectedText = $("#ddlAvailableDates option:selected").text();
        if (selectedText == "No Dates Available")
        {
            // $("[name=rblStatus][value=2]").prop("checked", true);
            $(".approve").prop("disabled", true);
            $("#ViewPanel").show();
            $("#lblView").text("No dates are available for rescheduling, therefore request can't be approved.")
        }
        $("#txtReason").change(validateForm)

        $("#txtAPPRemarks").change(validateForm);
        $(".action-btn").click(function (e) {
            e.preventDefault();
            if(validateForm()){
                update($(this)[0]);
            }
        });

        $("#btnCancel").click(function (e) {
            e.preventDefault();
            cancel();
        });
         $('#reqDetails, #trnDetails, #approval').on('show.bs.collapse', function () {
                $(this).prev('.panel-heading').find('.caret-color').removeClass('fa-caret-right').addClass('fa-caret-down');
        });

        $('#reqDetails, #trnDetails, #approval').on('hide.bs.collapse', function () {
            $(this).prev('.panel-heading').find('.caret-color').removeClass('fa-caret-down').addClass('fa-caret-right');
        });

        setPanelWidth();
    });
    function update(crnt){
        let data = {
            strRequestID : $("#hdnReqId").val(),
            strRemarks :  $("#txtAPPRemarks").val(),
            strAvailableDate: $("#ddlAvailableDates").val(),
            strStatus : $(crnt).attr('data-status'),
            strEmpCode : $("#ltlECode").text()
        };
        $.ajax({
            url: '@Url.Action("UpdateRescheduleReqRec", "Training")',
            type: 'POST',
            // contentType: 'application/json',
            data: data,
            success: function (response) {
                if (response == "0")
                {
                    $("#errorpanel").show();
                    // status.Text = "There is error in scheduling this request. Please contact to HR.";
                    alert('There is error in scheduling this request. Please contact to HR.');
                }
                else
                {
                    alert("Request update successfully")
                    window.location.href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx";
                }
            },
            error: function () {
                alert('An error occurred while submitting the form.');
            }
        });
    }
    function cancel(){
       window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx";
    }
    function validateForm() {
        var objRemarks = document.getElementById("txtAPPRemarks");
        if (trim(objRemarks.value) == "" || trim(objRemarks.value).length == 0) {
            // document.getElementById("errorpanel").style.display = "inline";
            // document.getElementById("status").innerHTML = "Remarks is a required field.";
            sweetAlert("", "Remarks is a required field.", "warning");
            document.getElementById("txtAPPRemarks").focus();
            //returnStatus = false;
            return false;
        }
        else {
            return true;
            //document.getElementById("errorpanel").style.display = "none";
        }
    }

    // Removes leading whitespaces
    function LTrim(value) {
        var re = /\s*((\S+\s*)*)/;
        return value.replace(re, "$1");
    }

    // Removes ending whitespaces
    function RTrim(value) {
        var re = /((\s*\S+)*)\s*/;
        return value.replace(re, "$1");
    }

    // Removes leading and ending whitespaces
    function trim(value) {
        return LTrim(RTrim(value));
    }
    $(window).resize(function(){
            setPanelWidth();
        });
        function setPanelWidth() {
            var btnApproveClientWidth = $('.pnl-btn .approve').prop('clientWidth');
            if (window.innerWidth < 1024) { // Mobile layout
                $('.last-row-btn .btn').css({
                    'maxWidth': `auto`
                });
            }
            else {
                $('.last-row-btn .btn').css({
                    'maxWidth': `${btnApproveClientWidth}px`
                });
            }
        }
</script>

