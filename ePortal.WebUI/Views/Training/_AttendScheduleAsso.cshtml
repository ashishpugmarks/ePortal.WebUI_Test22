@using ePortal.ViewModels.APPX.Training
@model List<InternalTrngViewModel>
        @if (Model != null && Model.Any())
        {
<table class="GridViewStyle" style="width:99%;">
    <thead class="HeaderStyle" style="height:20px;">
        <tr>
            <th>Name</th>
            <th>Section</th>
            <th>Venue</th>
            <th>Period</th>
            <th>Time</th>
        </tr>
    </thead>
    <tbody>

            @foreach (var item2 in Model)
            {
                <tr class="RowStyle">
                    <td>
                        @item2.EMPNAME
                        <input type="hidden" name="hdftrainingid" value="@item2.HRTRAININGID" />
                    </td>
                    <td>@item2.SECTION</td>
                    <td>@item2.VENUE</td>
                    <td>@item2.TRAININGPERIOD</td>
                    <td>@item2.TRAININGTIME</td>
                </tr>
            }

        
    </tbody>
</table>
}
else
{
    <table>
        <thead>
            <tr style="display:none;">
                <td ></td>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="text-align:center;">No Record Found.</td>
            </tr>
        </tbody>
    </table>
    

}