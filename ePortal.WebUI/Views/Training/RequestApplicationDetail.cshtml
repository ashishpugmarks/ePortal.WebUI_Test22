@using ePortal.ViewModels.APPX.Training
@model RequestHistoryDetailsViewModel
@{
    Layout = null;
}

<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1">
    <title>Training Re-Schedule Request Detail : Workflow History</title>
    <link href="../../lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <form id="form1">
        <div>

            <table class="table table-bordered table-condensed table-striped table-responsive">
                <tbody>
                    <tr>
                        <td>
                            <table class="table table-bordered ta table-condensed table-striped table-responsive">

                                <tr class="HeaderStyle123">
                                    <td colspan="2">Training Request Detail</td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                        <span class="smalltext">Employee Name:</span>&nbsp;
                                    </td>
                                    <td>
                                        @* &nbsp;<asp:Literal ID="ltlEmpName" ></asp:Literal> *@
                                        &nbsp;@Model.empname
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                        <span class="smalltext">Training Period:</span>&nbsp;
                                    </td>
                                    <td>
                                        @* &nbsp;<asp:Literal ID="ltlPeriod" ></asp:Literal> *@
                                        &nbsp;@Model.trainingperiod
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 30%; text-align: right;">
                                        <span class="smalltext">Trainig Time:</span>&nbsp;
                                    </td>
                                    <td>
                                        @* &nbsp;<asp:Literal ID="ltlTime" ></asp:Literal> *@
                                        &nbsp;@Model.trainingtime
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 30%; text-align: right;">
                                        <span class="smalltext">Request Date:</span>&nbsp;
                                    </td>
                                    <td>
                                        @* &nbsp;<asp:Literal ID="ltlRequestDate" ></asp:Literal> *@
                                        &nbsp;@Model.dateadded
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 30%; text-align: right;">
                                        <span class="smalltext">Reason:</span>&nbsp;
                                    </td>
                                    <td>
                                        @* &nbsp;<asp:Literal ID="ltlRemarks" ></asp:Literal> *@
                                        &nbsp;@Model.reqremarks
                                    </td>
                                </tr>
                            </table>
                            <asp:Panel ID="pnlRecAuth">
                                <table class="table table-bordered table-responsive table-condensed table-striped">
                                    <tr class="HeaderStyle123">
                                        <td colspan="2">Training Re-Schedule Recommendation Detail</td>
                                    </tr>
                                    <tr>
                                        <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                            <span class="smalltext">Recommendation Authority Name:</span>&nbsp;
                                        </td>
                                        <td width="70%" valign="middle">
                                            @* &nbsp;<asp:Literal ID="ltlRecAuth" ></asp:Literal> *@
                                            &nbsp;@Model.recempname
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                            <span class="smalltext">Recommendation Authority Email ID:</span>&nbsp;
                                        </td>
                                        <td width="70%" valign="middle">
                                            @* &nbsp;<asp:Literal ID="ltlRecEmail" ></asp:Literal> *@
                                            &nbsp;@Model.recemail
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                            <span class="smalltext">Status:</span>&nbsp;
                                        </td>
                                        <td width="70%" valign="middle">
                                            @* &nbsp;<asp:Literal ID="ltlRecStatus" ></asp:Literal> *@
                                            &nbsp;@Model.recstatus
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                            <span class="smalltext">Recommended Rescheduled Date:</span>&nbsp;
                                        </td>
                                        <td width="70%" valign="middle">
                                            @* &nbsp;<asp:Literal ID="ltlRescheduleDate" ></asp:Literal> *@
                                            &nbsp;@Model.RecmdRescheduledDate
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                            <span class="smalltext">Recommendation Authority Remarks:</span>&nbsp;
                                        </td>
                                        <td width="70%" valign="middle">
                                            @* &nbsp;<asp:Literal ID="ltlRecRem" ></asp:Literal> *@
                                            &nbsp;@Model.recremarks
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                            <span class="smalltext">Recommendation Date:</span>&nbsp;

                                        </td>
                                        <td width="70%" valign="middle">
                                            @* &nbsp;<asp:Literal ID="ltlRecDate" ></asp:Literal> *@
                                            &nbsp;@Model.recdate
                                        </td>
                                    </tr>
                                </table>
                            </asp:Panel>
                            <table class="table table-bordered table-responsive table-condensed table-striped">
                                <tr class="HeaderStyle123">
                                    <td colspan="2">Training Re-Schedule Approval Detail</td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="smalltext">Approval Authority Name:</span>&nbsp;
                                    </td>
                                    <td width="70%" valign="middle">
                                        @* &nbsp;<asp:Literal ID="ltlAppName" ></asp:Literal> *@
                                        &nbsp;@Model.appempname
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="smalltext">Approval Authority Email ID:</span>&nbsp;
                                    </td>
                                    <td width="70%" valign="middle">
                                        @* &nbsp;<asp:Literal ID="ltlAppEmail" ></asp:Literal> *@
                                        &nbsp;@Model.appemailid
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="smalltext">Status:</span>&nbsp;
                                    </td>
                                    <td width="70%" valign="middle">
                                        @* &nbsp;<asp:Literal ID="ltlAppStatus" ></asp:Literal> *@
                                        &nbsp;@Model.appstatus
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="smalltext">Approval Authority Remarks:</span>&nbsp;
                                    </td>
                                    <td width="70%" valign="middle">
                                        @* &nbsp;<asp:Literal ID="ltlAppRemarks" ></asp:Literal> *@
                                        &nbsp;@Model.appremarks
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="smalltext">Approval Date:</span>&nbsp;
                                    </td>
                                    <td width="70%" valign="middle">
                                        @* &nbsp;<asp:Literal ID="ltlAppDate" ></asp:Literal> *@
                                        &nbsp;@Model.appdate
                                    </td>
                                </tr>
                            </table>
                            <table class="table table-bordered table-responsive table-condensed table-striped">
                                <tr class="HeaderStyle123">
                                    <td colspan="2">Training Re-Schedule HR Approval Detail</td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="smalltext">HR Authority Name:</span>&nbsp;
                                    </td>
                                    <td width="70%" valign="middle">
                                        @* &nbsp;<asp:Literal ID="ltrHRName" ></asp:Literal> *@
                                        &nbsp;@Model.hrempname
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="smalltext">HR Authority Email ID:</span>&nbsp;
                                    </td>
                                    <td width="70%" valign="middle">
                                        @* &nbsp;<asp:Literal ID="ltrHREmail" ></asp:Literal> *@
                                        &nbsp;@Model.hrappemailid
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="smalltext">Status:</span>&nbsp;
                                    </td>
                                    <td width="70%" valign="middle">
                                        @* &nbsp;<asp:Literal ID="ltrStatus" ></asp:Literal> *@
                                        &nbsp;@Model.hrstatus
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="smalltext">Rescheduled Date:</span>&nbsp;
                                    </td>
                                    <td width="70%" valign="middle">
                                        @* &nbsp;<asp:Literal ID="ltrRescheduledDate" ></asp:Literal> *@
                                        &nbsp;@Model.RescheduledDate
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="smalltext">HR Remarks:</span>&nbsp;
                                    </td>
                                    <td width="70%" valign="middle">
                                        @* &nbsp;<asp:Literal ID="ltrHRRemarks" ></asp:Literal> *@
                                        &nbsp;@Model.hrappremarks
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="smalltext">HR Approval Date:</span>&nbsp;
                                    </td>
                                    <td width="70%" valign="middle">
                                        @* &nbsp;<asp:Literal ID="ltrHRApprovalDt" ></asp:Literal> *@
                                        &nbsp;@Model.hrappdate
                                    </td>
                                </tr>
                            </table>
                        </td>

                    </tr>
                </tbody>
            </table>
        </div>
    </form>
</body>
</html>
