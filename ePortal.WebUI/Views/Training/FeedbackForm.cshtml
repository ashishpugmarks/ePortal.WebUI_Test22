<div id="ajaxLoader"></div>

@section Scripts {
    <script type="text/javascript" language="javascript" nonce="@Context.Items["ScriptNonce_3"]">
        var isValid = true;
        $(document).ready(function(){
            if($("#hdnIsFilled").val() == "1"){
                $('input, textarea').prop('disabled', true);
            }
            $("#btnSubmit").on("click",function(e){
               if(!validateForm()){
                   e.preventDefault();
               }
            });

            $("#ancTop").on('click',function(){
                scroll(0,0);
            });
            $('#txtlike,#txttopics,#TxtFeedback,#txtImprovementFeedback').on('keypress', function(e) {
              if (this.value.length >= 250) {
                e.preventDefault();
              }
            });
            $('#txtlike,#txttopics,#TxtFeedback,#txtImprovementFeedback').on('paste', function(e) {
              e.preventDefault();
            });

        });

        function validateForm(){

            const questions = [
                { name: "FeedbackDetails.Rdolst1", label: "Ques-1" },
                { name: "FeedbackDetails.Rdolst2", label: "Ques-2" },
                { name: "FeedbackDetails.Rdolst3", label: "Ques-3" },
                { name: "FeedbackDetails.Rdolst4", label: "Ques-4" },
                { name: "FeedbackDetails.Rdolst5", label: "Ques-5" },
                { name: "FeedbackDetails.Rdolst6", label: "Ques-6" },
                { name: "FeedbackDetails.Rdolst7_1", label: "Ques-7 (Trainer1)" },
                { name: "FeedbackDetails.Rdolst7_2", label: "Ques-7 (Trainer2)" },
                { name: "FeedbackDetails.Rdolst8_1", label: "Ques-8 (Trainer1)" },
                { name: "FeedbackDetails.Rdolst8_2", label: "Ques-8 (Trainer2)" },
                { name: "FeedbackDetails.Rdolst9_1", label: "Ques-9 (Trainer1)" },
                { name: "FeedbackDetails.Rdolst9_2", label: "Ques-9 (Trainer2)" },
                { name: "FeedbackDetails.Rdolst10_1", label: "Ques-10 (Trainer1)" },
                { name: "FeedbackDetails.Rdolst10_2", label: "Ques-10 (Trainer2)" },
                { name: "FeedbackDetails.Rdolst11_1", label: "Ques-11 (Trainer1)" },
                { name: "FeedbackDetails.Rdolst11_2", label: "Ques-11 (Trainer2)" },
                { name: "FeedbackDetails.Rdolst12", label: "Ques-12" },
                { name: "FeedbackDetails.Rdolst13", label: "Ques-13" },
                { name: "FeedbackDetails.Rdolst14", label: "Ques-14" },
                { name: "FeedbackDetails.Rdolst14", label: "Ques-14" }

            ];

            for (let q of questions) {
                if(!$(`input[name="${q.name}"]:checked`).val()){
                    sweetAlert("", `${q.label} is a mandatory field.`, "warning");
                    return false;
                }
            }
            if(!$("#txtlike").val()){
                sweetAlert("", "Comment1 is a mandatory field.", "warning");
                return false;
            }
            if(!$("#txttopics").val()){
                sweetAlert("", "Comment2 is a mandatory field.", "warning");
                return false;
            }
            return true;
        }

        // Removes leading whitespaces
        function LTrim(value) {
            var re = /\s*((\S+\s*)*)/;
            return value.replace(re, "$1");
        }

        // Removes ending whitespaces
        function RTrim(value) {
            var re = /((\s*\S+)*)\s*/;
            return value.replace(re, "$1");
        }

        // Removes leading and ending whitespaces
        function trim(value) {
            return LTrim(RTrim(value));
        }
    </script>
}

