<script type="text/javascript" language="javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $(document).ready(function(){
        $("#btnSearch").on("click",function(e){
            if(!validateForm()){
                e.preventDefault();
            }
        });
        if($("#hdnRecAuth").val() != ""){
            $("#tr1").hide();
        }
    });

    function validateForm() {
        var objRemarks = document.getElementById("txtReason");
        var objResCount = document.getElementById("hdnRescheduleCount");
        var var_empname = document.getElementById("ltlEName").innerText;
        var var_training = document.getElementById("hdnTraining").innerText;

        var msg, msg1, msg2;

        if (trim(objRemarks.value) == "" || trim(objRemarks.value).length == 0) {
            document.getElementById("errorpanel").style.display = "inline";
            document.getElementById("status").innerHTML = "Reason is a required field.";
            document.getElementById("txtReason").focus();
            returnStatus = false;
            return false;
        }

        var_reschedulecount = objResCount.value;

        if (var_reschedulecount == "0") {
            return confirm("Are you sure want to reschedule the training?");
        }
        else {
            if (var_reschedulecount == "1") {
                msg1 = var_training + " for " + var_empname + " has already been rescheduled " + var_reschedulecount + " time.\r\n";
                msg2 = "Are you want to reschedule the training for one more time?";
                msg = msg1 + msg2;
            }
            else {
                msg1 = var_training + " for " + var_empname + " has already been rescheduled " + var_reschedulecount + " times.\r\n";
                msg2 = "Do you want to reschedule one more time?";
                msg = msg1 + msg2;
            }

            return confirm(msg1);
        }
    }

    // Removes leading whitespaces
    function LTrim(value) {
        var re = /\s*((\S+\s*)*)/;
        return value.replace(re, "$1");
    }

    // Removes ending whitespaces
    function RTrim(value) {
        var re = /((\s*\S+)*)\s*/;
        return value.replace(re, "$1");
    }

    // Removes leading and ending whitespaces
    function trim(value) {
        return LTrim(RTrim(value));
    }
</script>
