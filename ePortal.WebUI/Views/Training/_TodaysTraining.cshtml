@using ePortal.ViewModels.APPX.Training
@model List<TodaysTrainingViewModel>
@if (Model != null && Model.Any())
{
    <table class="table table-responsive table-bordered table-condensed table-striped" style="width:100%" cellspacing="1" cellpadding="4">
        <thead>
            <tr>
                <th style="width:2%; text-align:center; background-color:#F5F3DA;">S.No.</th>
                <th style="width:10%">Name</th>
                <th style="width:13%">Section</th>
                <th style="width:10%">Training</th>
                <th style="width:14%">Trng Period</th>
                <th style="width:14%">Trng Time</th>
                <th style="width:10%">Venue</th>
            </tr>
        </thead>
        <tbody>
            @{
                var index = 1;
            }
            @foreach (var item in Model ?? new List<TodaysTrainingViewModel>())
            {
                <tr>
                    <td style="text-align:center; background-color:#F5F3DA; color:#40528C;"><b>@(index++)</b></td>
                    <td>@item.EMPNAME</td>
                    <td>@item.SECTION</td>
                    <td>@item.TRAINING</td>
                    <td>@item.TRAININGPERIOD</td>
                    <td>@item.TRAININGTIME</td>
                    <td>@item.VENUE</td>
                </tr>
            }

        </tbody>
    </table>
}
else
{
    <table class="table table-responsive table-bordered table-condensed table-striped" style="width:100%" cellspacing="1" cellpadding="4">
        <tr class="text-center">
            <td colspan="7" style="font-family:Calibri; font-weight:bold; text-align:center;" >
                No Today's Training is found.
            </td>
        </tr>
    </table>
}
