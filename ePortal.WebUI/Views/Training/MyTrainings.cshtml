                    success: function (data) {
                        console.log(data);
                        $("#divTrainingTable").html(data);
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function (xhr) {
                        sweetAlert("Oops...", "Something went wrong!"+xhr, "error");
                    }
                });
