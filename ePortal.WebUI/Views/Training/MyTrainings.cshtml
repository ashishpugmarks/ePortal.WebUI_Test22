@{
    ViewBag.Title = "My Trainings";
}
@section Styles {
    <link href="../../css/index.css" rel="stylesheet" type="text/css" />
    <style>
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .homeContent {
            padding: 0;
        }

        table {
            font-size: 14px;
        }
        .table-hover tbody tr:hover {
            background-color: #F5F3DA;
        }
    </style>
}

<form action="" method="post" id="frmMyTrainings">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">My Training's</span>
    </div>
    <div class="table-responsive" style="padding-right: 10px; padding-left: 10px; padding-top: 5px;">
        <table id="tblMyTraining" style="width:100%;">
            <tr>
                <td style="padding-top: 5px;">
                    <div id="errorpanel" style="display:none; width:100%">
                        <table class="table table-bordered table-condensed table-striped">
                            <tbody>
                                <tr class="errorbox">
                                    <td>
                                        <table class="table table-bordered table-condensed table-striped">
                                            <tr>
                                                <td width="16" align="left" valign="middle">
                                                    <img src="../../images/icon_error.gif" border="0" alt="" />
                                                </td>
                                                <td align="left" class="errorbox">
                                                    <span>
                                                        @*   <asp:TextBox Width="2px" BackColor="#ffeaea" BorderColor="#ffeaea"
                                                                     BorderWidth="0" id="status1"></asp:TextBox> *@

                                                        <input type="text" id="status1" name="status1"
                                                               style="width:2px; background-color:#ffeaea; border:0;" />

                                                        <b>
                                                            @* <label id="status" ForeColor="Red" Text=""></label> *@
                                                            <label id="status" class="text-danger"></label>
                                                        </b>
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </td>
            </tr>
            <tr>
                <td align="center">
                    <table class="table table-bordered table-condensed table-striped" width="98%">
                        <tbody>
                            <tr class="HeaderStyle123">
                                <td colspan="4">Search Content</td>
                            </tr>
                            <tr>
                                <td style="text-align: right; width: 211px; color: #575757; vertical-align: middle;">
                                    <label id="lblTraining" for="cboTraining">
                                        Training :-
                                    </label>
                                </td>
                                <td style="width: 25%;">
                                    <select id="cboTraining" class="form-control" disabled>
                                        @foreach (var item in ViewBag.AllTraining)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </td>
                                <td style="text-align: right; width: 211px; color: #575757; vertical-align: middle;">
                                    <label id="Label1" for="cboTrainingStatus">
                                        Training Status :-
                                    </label>
                                </td>
                                <td style="width: 25%;">
                                    <select id="cboTrainingStatus" class="form-control">
                                        <option Value="All">-All-</option>
                                        <option Value="1">Scheduled</option>
                                        <option Value="3">Attended</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td align="center" colspan="4">
                                    <button id="btnSearch" class="btn btn-primary">Search</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-bordered table-condensed table-striped" width="98%">
                        <tbody>
                            <tr>
                                <td class="HeaderStyle123" colspan="4">
                                    Training Feedback List
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <table class="table table-condensed table-bordered" style="border: solid 1px #CCDCE0; float: right; margin-bottom:2px;">
                                        <tr>
                                            <td style="width:50%;"></td>
                                            <td style="text-align:center;">
                                                <img src="../../Images/account.png" height="16" width="16" />
                                            </td>
                                            <td>Reschedule Count</td>
                                            <td style="text-align:center;">
                                                <img src="../../Images/Reschedule.png" height="16" width="16" />
                                            </td>
                                            <td>Reschedule Training</td>
                                            <td style="text-align:center;">
                                                <img src="../../Images/re_view.png" height="16" width="16" />
                                            </td>
                                            <td>View Feedback</td>
                                            <td style="text-align:center;">
                                                <img src="../../Images/re_edit.png" height="16" width="16" />
                                            </td>
                                            <td>Pending Feedback</td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div style="width:98%;margin:auto;" id="divTrainingTable">
                                        @* <table class="table table-bordered table-responsive table-striped table-hover" id="TainingTable">
                                            <thead class="bg-info">
                                                <tr>
                                                    <th>S.No.</th>
                                                    <th>Training</th>
                                                    <th>Trng Period</th>
                                                    <th>Trng Time</th>
                                                    <th>Venue</th>
                                                    <th>Status</th>
                                                    <th><img id="img_count" title="Reschedule Count" src="../../images/account.png" height="20" width="20" /></th>
                                                    <th><img title="Reschedule Training" src="../../Images/Reschedule.png" height="20" width="20" /></th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tranningBody">
                                            </tbody>
                                        </table> *@
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </td>
            </tr>
        </table>
    </div>
    <div style="margin-left: 0.8em; margin-right: 0.8em;" class="well well-sm">
        <table border="0" style="width: 100%;">
            <tr>
                <td style="height: 20px;">
                    <table style="width: 100%;">
                        <tbody>
                            <tr>
                                <td style="width: 20px; vertical-align: middle; text-align: center;">
                                    <a title="Back" href="/Home/Home">
                                        <img src="../../images/icon_back.gif" border="0" alt="" />
                                    </a>
                                </td>
                                <td style="vertical-align: middle; font-size: 15px;">
                                    <span><a title="Back" href="/Home/Home">Back</a></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</form>

<div id="ajaxLoader"></div>
@if (ViewBag.isSaved =="1")
{
    <script nonce="@Context.Items["ScriptNonce_3"]">
            sweetAlert("", "Thanks for your feedback.Your feedback form has been submitted to HR.", "success");
    </script>
}

