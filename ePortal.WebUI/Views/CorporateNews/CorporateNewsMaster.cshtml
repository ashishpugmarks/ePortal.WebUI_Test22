@model ePortal.ViewModels.CorporateNewsMasterViewModel

@{
	ViewBag.Title = "CorporateNewsMaster";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
	<link href="~/css/login.css" rel="stylesheet" />
	<link href="~/lib/bootstrap/css/bootstrap-datepicker.css" rel="stylesheet" />
	<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
		.scrollit {
			overflow-y: auto;
			max-height: 100px;
		}

		select.input-sm {
			line-height: 10px !important;
		}
	</style>
}

<div class="row">
	<div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
		<div style="padding:8px;">Corporate News Master</div>
	</div>

	@if (TempData["AlertMessage"] != null)
	{
		<script type="text/javascript">
				if(@Html.Raw(Json.Serialize(TempData["AlertMessage"])) == 1){
					sweetAlert(" ", "Record saved successfully", "success");
				}
			else if(@Html.Raw(Json.Serialize(TempData["AlertMessage"])) == -1){
					sweetAlert(" ", "Record not saved", "warning");
				}
				else{
					sweetAlert(@Html.Raw(Json.Serialize(TempData["AlertMessage"])));
				}
		</script>
	}

	<div class="body-content" style="overflow-x:auto!important;">
		@using (Html.BeginForm("CorporateNewsMaster", "CorporateNews", FormMethod.Post))
		{
			@Html.AntiForgeryToken()
			<table class="table table-bordered table-hover table-striped table-responsive" style="width:100%">
				<thead>
					<tr class="info">
						<th colspan="10">
							<b class="pull-left">Search</b>
						</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>
							<div class="row">
								<div class="col-xs-12 col-sm-11 col-md-8 col-lg-8">
									<div class="col-xs-6 col-sm-3 col-md-3 col-lg-3">
										@Html.Label("Subject")
										@* @Html.EditorFor(model => model.SearchViewModel.Name, new { htmlAttributes = new { @id = "txtSubject", @class = "form-control" } }) *@
										@Html.TextBoxFor(model => model.SearchViewModel.Name, new { @id = "txtSubject", @class = "form-control" })
									</div>
									<div class="col-xs-6 col-sm-3 col-md-3 col-lg-2">
										@Html.Label("From Date")
										@* @Html.EditorFor(model => model.SearchViewModel.FromDate, new { htmlAttributes = new { @id = "dpFromDate", @class = "form-control", @readonly = "readonly", placeholder = "Search From" } }) *@
										@Html.TextBoxFor(model => model.SearchViewModel.FromDate, new { @class = "form-control datepic mr-b", @id = "dpFromDate", @readonly = "readonly", @placeholder = "Search From" })
									</div>

									<div class="col-xs-6 col-sm-3 col-md-3 col-lg-2">
										@Html.Label("To Date")
										@Html.TextBoxFor(model => model.SearchViewModel.ToDate, new { @class = "form-control datepic mr-b", @id = "dpToDate", @readonly = "readonly", @placeholder = "Search To" })

									</div>
									<div class="col-xs-6 col-sm-3 col-md-3 col-lg-2">
										@Html.Label("Status")
										@Html.DropDownListFor(x => x.SearchViewModel.Status, new List<SelectListItem>
									{
									new SelectListItem() {Text = "All", Value="-1"},
									new SelectListItem() {Text = "DeActive", Value="0"},
									new SelectListItem() {Text = "Active", Value="1"},
									new SelectListItem() {Text = "WIP", Value="2"},
									new SelectListItem() {Text = "Reject", Value="3"},
									new SelectListItem() {Text = "Obsolete", Value="4"},
									}, new { @id = "ddStatus", @class = "form-control" })
									</div>
									<div class="col-xs-6 col-sm-3 col-md-3 col-lg-3" style="margin-top:20px;">
										<div class="form-group">
											<input type="submit" value="Search" class="btn btn-info" />
											<input id="reset" type="button" value="Reset" class="btn btn-secondary" />
										</div>
									</div>
								</div>
							</div>
						</td>
					</tr>
				</tbody>
			</table>
		}
		<table id="tblCorporateNewsList" class="table table-bordered table-hover table-striped table-responsive" style="width:100%">
			<thead>
				<tr class="info">
					<th colspan="10">
						<b class="pull-left">Corporate News List</b>
						<b class="pull-right">
							<button class="btn btn-primary btn-xs" id="createNew">Create New</button>
						</b>
					</th>
				</tr>
				<tr>
					<th class="text-center">
						@Html.DisplayName("SNo")
					</th>
					@*<th>
                                @Html.DisplayNameFor(model => model.PROCESSID)
                            </th>*@
					<th>
						@Html.DisplayNameFor(model => model.SUBJECT)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.BRIEF)
					</th>
					@*<th>
                                @Html.DisplayNameFor(model => model.DESCRIPTION)
                            </th>*@
					@*<th>
                                @Html.DisplayNameFor(model => model.BANNER_CONTENTTYPE)
                            </th>*@
					@*<th>
                                @Html.DisplayNameFor(model => model.BANNER_NAME)
                            </th>*@
					@*<th>
                                @Html.DisplayNameFor(model => model.ATTACHMENT1_CONTENTTYPE)
                            </th>*@
					@*<th>
                                @Html.DisplayNameFor(model => model.ATTACHMENT1_NAME)
                            </th>*@
					@*<th>
                                @Html.DisplayNameFor(model => model.ATTACHMENT2_CONTENTTYPE)
                            </th>*@
					@*<th>
                                @Html.DisplayNameFor(model => model.ATTACHMENT2_NAME)
                            </th>*@
					<th class="text-center">
						@Html.DisplayNameFor(model => model.START_DATE)
					</th>
					<th class="text-center">
						@Html.DisplayNameFor(model => model.END_DATE)
					</th>
					<th class="text-center">
						@Html.DisplayNameFor(model => model.CREATED_DATE)
					</th>
					<th class="text-center">
						@Html.DisplayNameFor(model => model.STATUS)
					</th>

					@* <th>
                                @Html.DisplayNameFor(model => model.CREATED_BY)
                            </th>
                            <th>
                                    @Html.DisplayNameFor(model => model.MODIFIED_BY)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.MODIFIED_DATE)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.FUNCTIONAL_DESIGNATION)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.DESIGNATION)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.SITE)
                                </th>*@
					<th class="text-center">Action</th>
				</tr>
			</thead>
			<tbody>
				@{
					int rowNo = 0;
				}
				@foreach (var item in Model.CorporateNews)
				{
					<tr>
						<td style="width:3%;" class="text-center">
							@(rowNo += 1)
							@Html.HiddenFor(modelItem => item.ATTACHMENTID)
						</td>
						@*<td>
                                    @Html.DisplayFor(modelItem => item.PROCESSID)
                                </td>*@
						<td style="width:25%;">
							@Html.DisplayFor(modelItem => item.SUBJECT)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.BRIEF)
						</td>
						@*<td style="width:25%;">
                                    <div class="scrollit">
                                        @Html.DisplayFor(modelItem => item.DESCRIPTION)
                                    </div>
                                </td>*@
						@*<td>
                                    @Html.DisplayFor(modelItem => item.BANNER_CONTENTTYPE)
                                </td>*@
						@*<td>
                                    @Html.DisplayFor(modelItem => item.BANNER_NAME)
                                </td>*@
						@*<td>
                                    @Html.DisplayFor(modelItem => item.ATTACHMENT1_CONTENTTYPE)
                                </td>*@
						@*<td>
                                    @Html.DisplayFor(modelItem => item.ATTACHMENT1_NAME)
                                </td>*@
						@*<td>
                                    @Html.DisplayFor(modelItem => item.ATTACHMENT2_CONTENTTYPE)
                                </td>*@
						@*<td>
                                    @Html.DisplayFor(modelItem => item.ATTACHMENT2_NAME)
                                </td>*@
						<td class="text-center">
							@Html.DisplayFor(modelItem => item.START_DATE)
						</td>
						<td class="text-center">
							@Html.DisplayFor(modelItem => item.END_DATE)
						</td>
						<td class="text-center">
							@Html.DisplayFor(modelItem => item.CreateDate)
						</td>
						<td class="text-center">
							@if (item.STATUS == 0)
							{
								<button class="btn btn-danger btn-xs" style="cursor: text !important">Deactive</button>
							}
							else if (item.STATUS == 1)
							{
								if (DateTime.Now > Convert.ToDateTime(item.END_DATE))
								{
									<button class="btn btn-warning btn-xs" style="cursor: text !important">Obsolete</button>
								}
								else
								{
									<button class="btn btn-success btn-xs" style="cursor: text !important">Active</button>
								}
							}
							else if (item.STATUS == 2)
							{
								<button class="btn btn-warning btn-xs" style="cursor: text !important">WIP</button>
							}
							else if (item.STATUS == 3)
							{
								<button class="btn btn-danger btn-xs" style="cursor: text !important">Rejected</button>
							}
						</td>

						@*<td>
                                    @Html.DisplayFor(modelItem => item.CREATED_BY)
                                </td>
                                <td>
                                        @Html.DisplayFor(modelItem => item.MODIFIED_BY)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.MODIFIED_DATE)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.FUNCTIONAL_DESIGNATION)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.DESIGNATION)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.SITE)
                                    </td>*@
						<td class="text-center" style="width:8%;">
							@if (item.STATUS == 1)
							{
								if (DateTime.Now > Convert.ToDateTime(item.END_DATE))
								{
									<button class="btn glyphicon btn-xs glyphicon-remove text-danger open-confirm-model" title="Click to Deactive" id="@item.ATTACHMENTID" data-confirm-id="@item.ATTACHMENTID" style="color:#d43f3a; display:none"></button>
								}
								else
								{
									<button class="btn glyphicon btn-xs glyphicon-remove text-danger open-confirm-model" title="Click to Deactive" id="@item.ATTACHMENTID" data-confirm-id="@item.ATTACHMENTID" style="color:#d43f3a;"></button>
								}
							}
							@*  <button class="btn glyphicon glyphicon-edit btn-xs text-primary" title="Clic to Edit" onclick="openEditPopup(this);" id="@item.ATTACHMENTID"
                                @{
                                    if (item.STATUS == 0 || item.STATUS == 1 || item.STATUS == 3)
                                    {
                                        @: style="display: none;"
                                    }
                                }></button> *@

							<button class="btn glyphicon glyphicon-edit btn-xs text-primary edit-btn" title="Clic to Edit" data-id="@item.ATTACHMENTID" id="@item.ATTACHMENTID"
							@{
								if (item.STATUS == 0 || item.STATUS == 1 || item.STATUS == 3)
								{
									@: style="display: none;"
								}
							}></button>
							<button class="btn glyphicon glyphicon-eye-open btn-xs text-info view-btn" title="Click to View Detail" data-id="@item.ATTACHMENTID" id="@item.ATTACHMENTID"></button>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<div id="myModal" class="modal" tabindex="-1" role="dialog">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<div id="myModelHeader"></div>
				</div>
				@*<label id="closbtn" class="modal-close" for="modal-toggle">&#x2715;</label>*@
				<div class="modal-body">
					<div id="myModalContent"></div>
				</div>
			</div>
		</div>
	</div>

	<div id="myDetailsModel" class="modal" tabindex="-1" role="dialog">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<div class="pull-left">
						<h5 class="modal-title">Details</h5>
					</div>
					<div class="pull-right">
						<button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
							<span aria-hidden="true">&times;</span>
						</button>
					</div>
				</div>
				<div class="modal-body">
					<div id="myDetailModalContent" style="font-size:14px;"></div>
				</div>
			</div>
		</div>
	</div>
	<div class="modal" id="confirmModal" tabindex="-1" role="dialog">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-body" id="confirmMessage">
					<input type="hidden" id="hfAttachmentId" />
					Are you sure want to Deactive?
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-primary" id="confirmOk">Yes</button>
					<button type="button" class="btn btn-secondary" data-dismiss="modal" aria-label="Close">No</button>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/lib/bootstrap/js/bootstrap-datepicker.js"></script>
	<script src="~/js/jquery.validate.min.js"></script>
	<script src="~/js/jquery.validate.unobtrusive.min.js"></script>
	<script src="~/js/jquery.validate-vsdoc.js"></script>

	<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
			$(document).ready(function () {

				$("#confirmOk").on("click", function(){
				DeactiveCorporateNews();
				});

				//$("#tbAnnouncementList").dataTable();
				$('#tblCorporateNewsList').DataTable({
					//"scrollY": "300px",
					//"scrollCollapse": true,
					"pagingType": "full_numbers",
					"bPaginate": true,
					"bInfo": true,
					"bFilter": false,
					"bLengthChange": false,
					"iDisplayLength": 4
				});
				$('.homeContent').removeClass('homeContent');
				$("#reset").click(function () {
					$("#txtSubject").val("");
					$("#dpFromDate").val("");
					$("#dpToDate").val("");
					$("#ddStatus")[0].selectedIndex = 0;
				});

				$('#dpFromDate').datepicker({
					format: 'dd-M-yyyy',
							todayHighlight: true,
						autoclose: true,
				toolbarplacement: 'top'

					// showClose: true,
					// showClear: true,
					// autoclose: true,
					// toolbarPlacement: 'top'
				});
				$('#dpToDate').datepicker({
					format: 'dd-M-yyyy',
												todayHighlight: true,
						autoclose: true,
				toolbarplacement: 'top'
					// showClose: true,
					// showClear: true,
					// autoclose: true,
					// toolbarPlacement: 'top'
				});

				// $('.datePicker').datepicker({
				// 	format: 'dd-M-yyyy',
				// 		todayHighlight: true,
				// 		autoclose: true
				// 	// showClose: true,
				// 	// showClear: true,
				// 	// autoclose: true,
				// 	// toolbarPlacement: 'top'
				// });


				$(".edit-btn").on("click", function(){

			let id= $(this).data("id");


			$.ajax({
					type: "GET",
					url: "/CorporateNews/EditCorporateNews",
					data: { id: id},
					contentType: "application/json; charset=utf-8",
					datatype: "json",
					success: function (data) {
						var headerHtml = '<div class="pull-left"><h5 class="modal-title">Edit Corporate News</h5></div><div class="pull-right"><button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px"><span aria-hidden="true">&times;</span></button></div>'
						$('#myModelHeader').html(headerHtml);
						$('#myModalContent').html(data);
						//$('#myModal').modal(options);
						$('#myModal').modal({ backdrop: "static" });
					},
					error: function () {
						sweetAlert("Oops...", "Something went wrong!", "error");
					}
				});
		});


		$(".open-confirm-model").on("click", function(){
			let id= $(this).data("confirm-id");
			OpenConfirModel(id);
		});

		   $(".view-btn").on("click", function(){

				let id= $(this).data("id");

				$.ajax({
					type: "GET",
					url: "/CorporateNews/CorporateNewsDetails",
					data: { id: id },
					contentType: "application/json; charset=utf-8",
					datatype: "json",
					success: function (data) {
						$('#myDetailModalContent').html(data);
						$('#myDetailsModel').modal({ backdrop: "static" });
					},
					error: function () {
						sweetAlert("Oops...", "Something went wrong!", "error");
					}
				});
			});

						$("#createNew").on("click", function(){

				$.ajax({
					type: "GET",
					url: "/CorporateNews/CreateCorporateNews",
					contentType: "application/json; charset=utf-8",
					datatype: "json",
					success: function (data) {
						var headerHtml = '<div class="pull-left"><h5 class="modal-title">Create New Corporate News</h5></div><div class="pull-right"><button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px"><span aria-hidden="true">&times;</span></button></div>'
						$('#myModelHeader').html(headerHtml);
						$('#myModalContent').html(data);
						//$('#myModal').modal(options);
						$('#myModal').modal({ backdrop: "static" });
					},
					error: function () {
						sweetAlert("Oops...", "Something went wrong!", "error");
					}
				});
			});


			});


			// $("#createNew").on("click", function(){

			// 	alert('in');

			// $.ajax({
			// 		type: "GET",
			// 		url: "/CorporateNews/CreateCorporateNews",
			// 		contentType: "application/json; charset=utf-8",
			// 		datatype: "json",
			// 		success: function (data) {
			// 			var headerHtml = '<div class="pull-left"><h5 class="modal-title">Create New Corporate News</h5></div><div class="pull-right"><button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px"><span aria-hidden="true">&times;</span></button></div>'
			// 			$('#myModelHeader').html(headerHtml);
			// 			$('#myModalContent').html(data);
			// 			//$('#myModal').modal(options);
			// 			$('#myModal').modal({ backdrop: "static" });
			// 		},
			// 		error: function () {
			// 			sweetAlert("Oops...", "Something went wrong!", "error");
			// 		}
			// 	});
			// });

			function openImagePopup(current) {
				var $buttonClicked = $(this);
				//var options = {
				//    "backdrop": "static",
				//    keyboard: true
				//};
				$('#myModalContent').html('<img src="' + current.id + '" />');
				//$('#myModal').modal(options);
				$('#myModal').modal('show');
			}

			function OpenConfirModel(id) {
				swal({
					title: "",
					text: "Are you sure want to deactivate?",
					type: "warning",
					showCancelButton: true,
					confirmButtonClass: "btn-danger",
					confirmButtonText: "Yes, deactivate it!",
					closeOnConfirm: false
				},function(){
					DeactiveCorporateNews(id);
				});
				//var $buttonClicked = $(this);
				//$('#hfAttachmentId').val(current.id);
				//$('#confirmModal').modal({ backdrop: "static" });
			}

					function DeactiveCorporateNews(id) {

				$.ajax({
					type: "POST",
					url: "/CorporateNews/DeactiveCorporateNews",
					// data: JSON.stringify(data),
					contentType: "application/x-www-form-urlencoded; charset=UTF-8",
					datatype: "json",
						data: { ATTACHMENTID: id },
					success: function (data) {
						window.location.href = "/CorporateNews/CorporateNewsMaster";
					},
					error: function () {
						sweetAlert("Oops...", "Something went wrong!", "error");
					}
				});
			}

	</script>
}