@model ePortal.ViewModels.NewsLetterViewModel
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@* Added By Bhupesh - NTT for CR-4894*@
@section Styles{
    @* <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.css" /> *@
    <style nonce="@Context.Items["StyleNonce_0"]">
        .panel-title {
            margin-top: 0;
            margin-bottom: 0;
            font-size: 16px;
            color: inherit;
            padding-top: 9px;
            padding-left: 14px;
        }

        .panel-heading {
            height: 2.5em;
        }

        #newsHeader {
            height: 2.2em;
            margin-top: -0.6em;
            margin-left: -1.4em;
            margin-right: -1.4em;
            font-size: large;
            font-weight: bold;
            font-family: Roboto-Regular;
            background-color: #8A8A8A;
            color: #FFF;
            vertical-align: middle;
        }

        #newsHeaderContent {
            padding: 8px;
        }

        #panelTitle {
            font-size: 16px;
            color: inherit;
            padding-top: 9px;
            padding-left: 14px
        }

        #tblPanel {
            padding-left: 27px;
            padding-right: 27px;
            padding-top: 17px;
            padding-bottom: 17px;
        }

        #tbNewsLetter_length {
            padding-left: 10px;
        }

        #tbNewsLetter_info {
            padding-left: 10px;
        }

        .panel-primary > .panel-heading {
            height: 37px;
        }

        #tbNewsLetter_filter {
            padding-right: 10px;
        }

        .homeContent div {
            padding: 1.0px;
        }
    </style>
    }

<div id="newsHeader">
    <div id="newsHeaderContent">
        NewsLetter Section
    </div>
</div>

@using (Html.BeginForm("CreateNews", "CorporateNews", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="body-content" style="overflow-x:auto!important;">
        <div class="panel-group">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title">
                        <strong>Create</strong>
                    </h2>
                </div>
                <div class="panel-body" style="padding:5px;">

                    <div class="row" style="padding:4px;">
                        @Html.HiddenFor(m => m.Id)
                        @Html.LabelFor(m => m.Description, new { @class = "control-label text-right col-md-1", @style = "width:130px;margin-top: 7px;" })
                        <div class="col-md-2 col-lg-2" style="width:20.66%;">
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", style = "width:235px;height:74px;" })
                            @Html.ValidationMessageFor(m => m.Description, null, new { @style = "color:red;" })
                        </div>

                        @Html.LabelFor(m => m.Document, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-2 col-lg-2" style="width:20.66%;">
                            <input type="file" name="document" class="form-control" style="width:240px;height:30px;" />
                            @Html.ValidationMessageFor(m => m.Document, null, new { @style = "color:red;" })
                        </div>

                        @Html.LabelFor(m => m.Status, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                        <div class="col-md-2 col-lg-2" style="width:20.66%;">
                            @Html.DropDownListFor(m => m.Status, new SelectList(new[] { "Active", "Inactive" }), "Select Status", new { @class = "form-control", style = "width:118px;height:30px;" })
                            @Html.ValidationMessageFor(m => m.Status, null, new { @style = "color:red;" })
                        </div>

                    </div>
                    <div class="row" style="padding:2px;">
                        <div class="col-md-12 col-lg-12 text-center">
                            <button type="Submit" class="btn btn-primary">
                                @(Model.Id == 0 ? "Create" : "Update")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<hr />
@if (Model.NewsLetters != null && Model.NewsLetters.Count > 0)
{
    <div class="panel-group">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <table style="width: 100%;">
                    <tbody>
                        <tr>
                            <td>
                                <h2 class="panel-title" id="panelTitle">
                                    <strong>News Letters</strong>
                                </h2>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="panel-body" style="font-size: 15px;">
                <div id="tbNewsLetter wrapper" class="dataTables_wrapper form-inline dt-bootstrap no-footer">
                    <div class="row">
                        <div class="col-sm-12" id="tblPanel">
                            <table class="table table-bordered table-hover table-responsive dataTable no-footer" id="tbNewsLetter" role="grid" aria-describedby="tbNewsLetter_info">
                                <thead>
                                    <tr role="row">
                                        <th class="text-center sorting" tabindex="0" aria-controls="tbNewsLetter" rowspan="1" colspan="1" aria-label="Description: activate to sort column ascending" style="width: 42.3333px;">Description</th>
                                        <th class="text-center sorting" tabindex="0" aria-controls="tbNewsLetter" rowspan="1" colspan="1" aria-label="Document Name: activate to sort column ascending" style="width: 42.3333px;">Document Name</th>
                                        <th class="text-center sorting" tabindex="0" aria-controls="tbNewsLetter" rowspan="1" colspan="1" aria-label="Added Date: activate to sort column ascending" style="width: 42.3333px;">Added Date</th>
                                        <th class="text-center sorting" tabindex="0" aria-controls="tbNewsLetter" rowspan="1" colspan="1" aria-label="Status: activate to sort column ascending" style="width: 42.3333px;">Change Status</th>
                                        <th class="text-center sorting" tabindex="0" aria-controls="tbNewsLetter" rowspan="1" colspan="1" aria-label="Status: activate to sort column ascending" style="width: 42.3333px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.NewsLetters)
                                    {
                                        <tr style="background-color: #d6fbd6;" role="row" class="odd">
                                            <td class="text-center">@item.DESCRIPTION</td>
                                            <td class="text-center">@item.DOCUMENT_NAME</td>
                                            <td class="text-center">
                                                @item.ADDED_DATE.Value.ToString("MM/dd/yyyy")
                                            </td>
                                            <td style="text-align: center;">
                                                <a href="javascript:void(0);" class="toggle-status" data-id="@item.ID"> @item.STATUS</a>
                                            </td>
                                            <td style="text-align: center;">
                                                <a href="@Url.Action("EditNewsletter", "CorporateNews", new {id=item.ID})"> Edit</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $(document).ready(function () {
        $('#tbNewsLetter').DataTable();
        $(document).on('click', '.toggle-status', function () {
            var id = $(this).data('id');
            var statusLable = $(this).closest('td').find('.status-label');
                $.ajax({
                    url: '@Url.Action("ToggleStatus", "CorporateNews")',
                    type: 'POST',
                    data: {id: id},
                    success: function (responce) {
                        window.location.reload();
                        if (responce.status==="Active") {
                            statusLable.text("Active");
                        }
                        else {
                            statusLable.text("Inactive");
                        }
                    },
                    error: function () {
                        alert('Error while updating status.');
                    }
                });
        });
    });
</script>
}