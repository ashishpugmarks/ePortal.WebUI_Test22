@model IEnumerable<ePortal.ViewModels.CorporateNewsApprovalViewModel>

@{
    ViewBag.Title = "CorporateNewsApproval";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .scrollit {
            overflow-y: auto;
            max-height: 100px;
        }

        select.input-sm {
            line-height: 10px !important;
        }
    </style>
}


    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">Corporate News Approval</div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <table class="table table-bordered table-hover table-responsive" id="tblCorporateNewsApprovalList" style="width:100%">
                <thead>
                    <tr class="info">
                        <th colspan="10">
                            <b class="pull-left">Approval List</b>
                            @*<b class="pull-right">
                                    <button class="btn btn-primary btn-xs" onclick="openCreatePopup(this);">Create New</button>
                                </b>*@
                        </th>
                    </tr>
                    <tr>
                        <th class="text-center">
                            @Html.DisplayName("SNo")
                        </th>
                        @*<th>
                                @Html.DisplayNameFor(model => model.ATTACHMENTID)
                            </th>*@
                        <th class="text-left">
                            @Html.DisplayNameFor(model => model.SUBJECT)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.BRIEF)
                        </th>
                        <th class="text-left">
                            @Html.DisplayNameFor(model => model.INITIATED_BY)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.INITIATED_DATE)
                        </th>
                        @*<th class="text-left">
                                @Html.DisplayNameFor(model => model.INITIATOR_REMARKS)
                            </th>*@
                        @*<th class="text-center">
                                @Html.DisplayNameFor(model => model.APPAUTH1_DATE)
                            </th>
                            <th class="text-center">
                                @Html.DisplayNameFor(model => model.APPAUTH2_DATE)
                            </th>*@
                        @*<th>
                                @Html.DisplayNameFor(model => model.APPAUTH1_ECODE)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.APPAUTH1_REMARKS)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.APPAUTH2_ECODE)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.APPAUTH2_REMARKS)
                            </th>*@
                        @*<th class="text-left">
                                @Html.DisplayName("Assign By")
                            </th>
                            <th class="text-center">
                                @Html.DisplayName("Assign Date")
                            </th>*@
                        @*<th class="text-left">
                                @Html.DisplayName("Remarks")
                            </th>*@
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.STATUS)
                        </th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowNo = 0;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                @(rowNo += 1)
                                @Html.HiddenFor(modelItem => item.ATTACHMENTAPPID)
                            </td>
                            @*<td>
                                    @Html.DisplayFor(modelItem => item.ATTACHMENTID)
                                </td>*@
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.SUBJECT)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.BRIEF)
                            </td>
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.INITIATED_User)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.INITIATED_DATE)
                            </td>
                            @*<td class="text-left">
                                    <div class="scrollit">
                                        @Html.DisplayFor(modelItem => item.INITIATOR_REMARKS)
                                    </div>
                                </td>*@
                            @*<td class="text-center" style="width:7%;">
                                    @Html.DisplayFor(modelItem => item.APPAUTH1_DATE)
                                </td>
                                <td class="text-center" style="width:7%;">
                                    @Html.DisplayFor(modelItem => item.APPAUTH2_DATE)
                                </td>*@
                            @*<td>
                                    @Html.DisplayFor(modelItem => item.APPAUTH1_ECODE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.APPAUTH1_REMARKS)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.APPAUTH2_ECODE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.APPAUTH2_REMARKS)
                                </td>*@
                            @*<td class="text-left" style="width:14%;">
                                    @Html.DisplayFor(modelItem => item.HRAPP_User)
                                </td>
                                <td class="text-center" style="width:7%;">
                                    @Html.DisplayFor(modelItem => item.HRAPP_DATE)
                                </td>*@
                            @*<td class="text-left">
                                    @Html.DisplayFor(modelItem => item.HRAPP_REMARKS)
                                </td>*@
                            <td style="text-align:center">
                                @if (@item.STATUS == 1)
                                {
                                    <span class="label-warning btn-xs">Initiated</span>
                                    @*@Html.DisplayFor(modelItem => item.STATUS, new { @class="btn btn-xs btn-primery"})*@
                                }
                                else if (@item.STATUS == 2)
                                {
                                    <span class="label-success btn-xs">Approved</span>
                                    @*@Html.DisplayFor(modelItem => item.STATUS ,new { @class = "btn btn-xs btn-warning" })*@
                                }
                                else if (@item.STATUS == 3)
                                {
                                    <span class="label-warning btn-xs">Canceled by User</span>
                                    @*@Html.DisplayFor(modelItem => item.STATUS)*@
                                }
                                else if (@item.STATUS == 4)
                                {
                                    <span class="label-danger btn-xs">Rejected</span>
                                    @*@Html.DisplayFor(modelItem => item.STATUS)*@
                                }
                            </td>
                            <td class="text-center" style="width:10%;">
                                @*<button class="btn glyphicon glyphicon-edit btn-xs" data-subject="@item.SUBJECT" @(item.STATUS != 1 ? "disabled='disabled'" : "") data-status="@item.STATUS" title="Click to Approve/Reject" onclick="OpenUpdateStatusPopup(this);" id="@item.ATTACHMENTAPPID"></button>*@
                                <button class="btn btn-xs glyphicon glyphicon-edit btn-edit" @(item.STATUS != 1 ? "disabled='disabled'" : "") title="Click to Approve/Reject/Sendback" data-attachmentId="@item.ATTACHMENTID" data-subject="@item.SUBJECT" data-brief="@item.BRIEF"
                                        data-description="@item.DESCRIPTION" data-banner="@item.BANNER_NAME" data-attachment1="@item.ATTACHMENT1_NAME"
                                        data-attachment2="@item.ATTACHMENT2_NAME" data-status="@item.STATUS" data-id="@item.ATTACHMENTAPPID" id="@item.ATTACHMENTAPPID"></button>
                            <button class="btn glyphicon glyphicon-eye-open btn-xs btn-view" name="Details" data-id="@item.ATTACHMENTAPPID" id="@item.ATTACHMENTAPPID" title="Click to view details"></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="myApprovalModal" class="modal" tabindex="-1" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="pull-left">
                            <h5 class="modal-title">Approve / Reject</h5>
                        </div>
                        <div class="pull-right">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    </div>
                    <div class="modal-body">
                        <div id="myApproveModalContent" style="font-size:14px;">
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <input type="hidden" id="hfAttachmentAppId" />
                                        <label>Subject :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <span id="lblSubject"></span>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">

                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <label>Brief :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <span id="lblBrief"></span>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <label>Description :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <span id="lblDescription"></span>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <label>Banner :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        @*@Html.ActionLink("Download", "Download", "Announcement", new { @class = "link-banner", type = "Banner" }, null)*@
                                        <span id="lblBanner"></span>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <label>Attachment 1 :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <span id="lblAttachment1"></span>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <label>Attachment 2 :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <span id="lblAttachment2"></span>
                                    </div>
                                </div>

                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="col-xs-5 col-sm-4 col-md-3 col-lg-3 text-right">
                                        <input type="hidden" id="hfCurrentStatus" />
                                        <label>Remarks :</label>
                                    </div>
                                    <div class="col-xs-7 col-sm-8 col-md-9 col-lg-9">
                                        <textarea id="txtRemarks" class="form-control" rows="3"></textarea>
                                        <span id="lblMessage" class="text-danger hidden"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success btn-status" data-header="approve" id="btnApprove" >Approve</button>
                    <button type="button" class="btn btn-danger btn-status" data-header="reject"  id="btnReject">Reject</button>
                        @*<button type="button" class="btn btn-warning" id="btnSendBack" onclick="UpdateStatus(this);">Send Back</button>*@
                        <button type="button" class="btn btn-secondary" data-dismiss="modal" aria-label="Close">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

        <div id="myDetailsModel" class="modal" tabindex="-1" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="pull-left">
                            <h5 class="modal-title">Details</h5>
                        </div>
                        <div class="pull-right">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-top:3px">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    </div>
                    <div class="modal-body">
                        <div id="myDetailModalContent" style="font-size:14px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#tblCorporateNewsApprovalList').DataTable({
                //"scrollY": "300px",
                //"scrollCollapse": true,
                "pagingType": "full_numbers",
                "bPaginate": true,
                "bInfo": true,
                "bFilter": true,
                "bLengthChange": false,
                "iDisplayLength": 5
            });
            $('.homeContent').removeClass('homeContent');

               $(".btn-edit").on("click", function(){

                   let id= $(this).data("id");

                    $("#lblMessage").text("");
                    $("#lblMessage").addClass("hidden");
                    $('#hfAttachmentAppId').val(id);
                    //$('.link-banner').attr('id', $(current).attr("data-attachmentId"));
                    $('#hfCurrentStatus').val($(this).data("status"));
                    $('#lblSubject').text($(this).data("subject"));
                    $('#lblBrief').text($(this).data("brief"));
                    $('#lblDescription').text($(this).data("description"));
                    var banner = $(this).data("banner") == null || $(this).data("banner") == "" ? "N/A" : $(this).data("banner");
                    $('#lblBanner').text(banner);
                    var attachment1 = $(this).data("attachment1") == null || $(this).data("attachment1") == "" ? "N/A" : $(this).data("attachment1");
                    $('#lblAttachment1').text(attachment1);
                    var attachment2 = $(this).data("attachment2") == null || $(this).data("attachment2") == "" ? "N/A" : $(this).data("attachment2");
                    $('#lblAttachment2').text(attachment2);
                    $('#myApprovalModal').modal({ backdrop: "static" });
        });

        $(".btn-view").on("click", function(){
            let id= $(this).data("id");

            $.ajax({
                type: "GET",
                url: "/CorporateNews/CorporateNewsApprovalDetails",
                data: { id: id },
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    $('#myDetailModalContent').html(data);
                    $('#myDetailsModel').modal({ backdrop: "static" });
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        });


        $(".btn-status").on("click", function(){

            let headerText= $(this).data("header");

            var remarks = $('#txtRemarks').val();
            if (remarks == "") {
                $("#lblMessage").text("Please enter remarks");
                $("#lblMessage").removeClass("hidden");
                return;
            }
            var status = "";
            var currentStatus = $('#hfCurrentStatus').val()

            status = headerText == "approve" ? 2 : 4 // status 2 : Approved by Authority , 4 : Reject,
            var data = {
                ATTACHMENTAPPID: $('#hfAttachmentAppId').val(),
                APPAUTH1_REMARKS: $('#txtRemarks').val(),
                STATUS: status
            }
            var $buttonClicked = $(this);
            $.ajax({
                type: "POST",
                url: "/CorporateNews/UpdateCorporateNewsStatus",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    $('#myApprovalModal').modal('hide');
                    $('#hfAttachmentAppId').val("");
                    $('#lblSubject').text("");
                    $('#txtRemarks').text("");
                    window.location.href = "/CorporateNews/CorporateNewsApproval";
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        });


        });

