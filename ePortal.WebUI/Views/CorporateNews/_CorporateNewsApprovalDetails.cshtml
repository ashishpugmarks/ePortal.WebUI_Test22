@model ePortal.ViewModels.CorporateNewsApprovalViewModel

<style type="text/css" nonce="@Context.Items["StyleNonce_2"]">
    .scrollit {
        overflow-y: auto;
        max-height: 100px;
    }
</style>

<div class="body-content">
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.SUBJECT)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.SUBJECT)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.BRIEF)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.BRIEF)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.DESCRIPTION)
        </dt>

        <dd class="scrollit">
            @Html.DisplayFor(model => model.DESCRIPTION)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.STATUS)
        </dt>

        <dd>

            @if (Model.STATUS == 1)
            {
                <span class="label-warning btn-xs">Pending for Approval</span>
            }
            else if (Model.STATUS == 2)
            {
                <span class="label-success btn-xs">Approved </span>
            }
            else if (Model.STATUS == 3)
            {
                <span class="label-warning btn-xs">Cancelled By User</span>
            }
            else if (Model.STATUS == 4)
            {
                <span class="label-danger btn-xs">Rejected by Approval Authority</span>
            }

        </dd>
        <hr />
        <dt>
            @Html.DisplayNameFor(model => model.INITIATED_BY)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.INITIATED_User)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.INITIATED_DATE)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.INITIATED_DATE)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.INITIATOR_REMARKS)
        </dt>

        <dd>
            <div class="scrollit">
                @Html.DisplayFor(model => model.INITIATOR_REMARKS)
            </div>
        </dd>

        <hr />
        <dt>
            @Html.DisplayNameFor(model => model.BANNER_CONTENTTYPE)
        </dt>

        <dd>
            @if (Model.BANNER != null)
            {
                @Html.ActionLink("Download", "Download", "CorporateNews", new { id = Model.ATTACHMENTID, type = "BANNER" }, null)
                @*<a id="@Model.ATTACHMENTID" name="Attachment2" onclick="DownloadFile(this);">Download</a>*@
                <span>( @Html.DisplayFor(model => model.BANNER_NAME))</span>
            }
            else
            {
                <span>N/A</span>
            }
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.ATTACHMENT1_CONTENTTYPE)
        </dt>

        <dd>
            @if (Model.ATTACHMENT1 != null)
            {
                @Html.ActionLink("Download", "Download", "CorporateNews", new { id = Model.ATTACHMENTID, type = "Attachment1" }, null)
                @*<a id="@Model.ATTACHMENTID" name="Attachment2" onclick="DownloadFile(this);">Download</a>*@
                <span>( @Html.DisplayFor(model => model.ATTACHMENT1_NAME))</span>
            }
            else
            {
                <span>N/A</span>
            }
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.ATTACHMENT2_CONTENTTYPE)
        </dt>

        <dd>
            @if (Model.ATTACHMENT2 != null)
            {
                @Html.ActionLink("Download", "Download", "CorporateNews", new { id = Model.ATTACHMENTID, type = "Attachment2" }, null)
                @*<a id="@Model.ATTACHMENTID" name="Attachment2" onclick="DownloadFile(this);">Download</a>*@
                <span>( @Html.DisplayFor(model => model.ATTACHMENT2_NAME))</span>
            }
            else
            {
                <span>N/A</span>
            }
        </dd>
        <hr />
        <dt>
            @Html.DisplayNameFor(model => model.APPAUTH1_ECODE)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.APPAUTH1_User)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.APPAUTH1_DATE)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.APPAUTH1_DATE)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.APPAUTH1_REMARKS)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.APPAUTH1_REMARKS)
        </dd>
        @*<dt>
                @Html.DisplayNameFor(model => model.APPAUTH2_ECODE)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.APPAUTH2_User)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.APPAUTH2_DATE)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.APPAUTH2_DATE)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.APPAUTH2_REMARKS)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.APPAUTH2_REMARKS)
            </dd>*@

    </dl>
</div>

