@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        var _totalWorkingDay = 0, _totalWorkingHour = "";
        $(document).ready(function () {
            $('.dpDate').datepicker({
                format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                clearBtn: true,
                endDate: "today"
            });

            $('#btnCancel').click(function () {
                location.reload();
            });
        });

        function ChkOnClick(crnt) {
            if (crnt.checked) {
                $('#btnSave').removeClass('btn_disable');
            }
            else {
                $('#btnSave').addClass('btn_disable');
            }
        }

        function OnDateChange() {
            if ($('#txtStartDate').val() != "" && $('#txtEndDate').val() != "") {
                $.ajax({
                    type: "GET",
                    url: "/WFH/GetOffDays",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { startDate: $('#txtStartDate').val(), endDate: $('#txtEndDate').val() },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.TOTALDAYS != -1 && data.OFFDAYS != -1 && data.WORKINGDAYS != -1) {
                            $('#spanTotalDays').text(data.TOTALDAYS.toString());
                            $('#spanTotalOff').text(data.OFFDAYS.toString());
                            $('#spanWorkingDays').text(data.WORKINGDAYS.toString());
                            _totalWorkingDay = data.WORKINGDAYS;
                        }
                        if (!data.ISVALID) {
                            //$('#spn_date_msg').text('Invalid date :- End date should be greater than start date.');
                            $('#spn_date_msg').text('Request can be applied with in N+2 working day only'); //SR86752
                            $('#div_date_msg').removeClass('hidden');
                            $("#btnSave").attr("disabled", true);
                        }
                        else if ($('#ddDuration').val() == 2 && data.TOTALDAYS > 1) {
                            //$('#spn_date_msg').text('Invalid date :- Start date should be equal to end date.');
                            $('#spn_date_msg').text('Request can be applied with in N+2 working day only');//SR86752
                            $('#div_date_msg').removeClass('hidden');
                            $("#btnSave").attr("disabled", true);
                        }
                        else {
                            $('#spn_date_msg').text('');
                            $('#div_date_msg').addClass('hidden');
                            $("#btnSave").attr("disabled", false);
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                        if ($('#ddRequestType').val() == 2 || $('#ddApplyFor').val() == 2) {
                            CalculateTotalHour();
                        }
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        };

        function CalculateTotalHour() {
            if ($('#txtStartDate').val() != "" && $('#txtEndDate').val() != "") {
                var _startHour, _startMinute, _endHour, _endMinute;
                _startHour = parseInt($('#ddStartHour').val() == "" ? -1 : $('#ddStartHour').val());
                _startMinute = parseInt($('#ddStartMinute').val() == "" ? -1 : $('#ddStartMinute').val());
                _endHour = parseInt($('#ddEndHour').val() == "" ? -1 : $('#ddEndHour').val());
                _endMinute = parseInt($('#ddEndMinute').val() == "" ? -1 : $('#ddEndMinute').val());
                if (_startHour != -1 && _startMinute != -1 && _endHour != -1 && _endMinute != -1) {
                    $.ajax({
                        type: "GET",
                        url: "/WFH/GetHours",
                        beforeSend: function () {
                            $("#ajaxLoader").addClass('loader');
                        },
                        data: { startDate: $('#txtStartDate').val(), endDate: $('#txtEndDate').val(), startTime: (_startHour + ":" + _startMinute), endTime: (_endHour + ":" + _endMinute) },
                        contentType: "application/json; charset=utf-8",
                        datatype: "json",
                        success: function (data) {
                            if (data.TOTALHOURS != -1) {
                                $('#spanTotalHour').text(data.TOTALHOURS.toFixed(2));
                                _totalWorkingHour = data.TOTALHOURS.toFixed(2);
                            }
                            if (!data.ISVALID && data.TOTALHOURS < 0) {
                                $('#spn_date_msg').text('Invalid :- End time should be greater than start time.');
                                //$('#spn_date_msg').text('Request can be applied with in N+2 working day only'); //SR86752
                                $('#div_date_msg').removeClass('hidden');
                                $("#btnSave").attr("disabled", true);
                            }
                            else if (!data.ISVALID && $('#ddDuration').val() == 3) {
                                $('#spn_date_msg').text('Invalid date :- End date should not be greater than start date + 1.');
                                //$('#spn_date_msg').text('Request can be applied with in N+2 working day only'); //SR86752
                                $('#div_date_msg').removeClass('hidden');
                                $("#btnSave").attr("disabled", true);
                            }
                            else {
                                $('#spn_date_msg').text('');
                                $('#div_date_msg').addClass('hidden');
                                $("#btnSave").attr("disabled", false);
                            }
                        },
                        complete: function () {
                            $("#ajaxLoader").removeClass('loader');
                        },
                        error: function () {
                            sweetAlert("Oops...", "Something went wrong!", "error");
                        }
                    });
                }
            }
        }

