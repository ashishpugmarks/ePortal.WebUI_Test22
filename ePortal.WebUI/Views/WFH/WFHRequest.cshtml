        function convertToIsoDate(dateString) {
                            const rawDate = dateString; // e.g., "03-Sep-2025"
                const parsedDate = new Date(rawDate + " 12:00:00"); // force local time
                return parsedDate.toISOString();
                }
        function SaveData() {
            var isFormVaildation = CheckFormValidation();
            if (isFormVaildation) {
                $('#div_date_msg').addClass('hidden');
                if (_totalWorkingDay <= 0 && $('#ddApplyFor').val() == 1) {
                    return sweetAlert("", "This request can not submit, Please select correct date.", "warning");
                }
                $("#btnSave").attr("disabled", true);
                var data = {
                    REQUESTTYPE:parseFloat( $('#ddRequestType').val()),
                    APPLYFOR: parseFloat($('#ddApplyFor').val()),
                    Duration: parseFloat($('#ddDuration').val()),
                    WEHSHIFTID: parseFloat($('#ddShift').val()),
                    STARTDATE: convertToIsoDate($('#txtStartDate').val()),
                    ENDDATE: convertToIsoDate($('#txtEndDate').val()),
                    STARTTIME: $('#ddStartHour').val() + ":" + $('#ddStartMinute').val(),
                    ENDTIME: $('#ddEndHour').val() + ":" + $('#ddEndMinute').val(),
                    REMARKS: $('#txtRemarks').val(),
                    STATUS: 1, // 0 = Deactive, 1 = Active
                    WorkingDays: (($('#ddRequestType').val() == 1 && $('#ddApplyFor').val() == 1) ? _totalWorkingDay : _totalWorkingHour).toString(),
                    WFH_REQUESTTYPE:parseFloat( $('#ddWFHRequestType').val()), //SR86752
                    WFH_REQUESTTYPEREMARKS: $('#txtRequestTypeRemarks').val().trim() //SR86752
                }
                $.ajax({
                    type: "POST",
                    url: "/WFH/WFHRequest",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: JSON.stringify(data),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data == 1) {
                            swal({
                                title: "",
                                text: "Record saved successfully.",
                                type: "success",
                            }, function (isConfirm) {
                                if (isConfirm) {
                                    window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                                }
                            });
                        }
                        else if (data == 2) {
                            sweetAlert("", "Record already exist.", "warning");
                        }
                        else if (data == 3) {
                            sweetAlert("", "Start date should not be less than 20-May-2020.", "warning");
                        }
                        else if (data == 4) {
                            sweetAlert("", "Start date should not be less than 01-Jun-2020.", "warning");
                        }
                        else if (data == 5) {
                            sweetAlert("", "Flexi shift applicable from  01-Nov-2021.", "warning");
                        }
                       
                        else if (data == -5) {
                            sweetAlert("", "The entered data does not comply with WFH guidelines. Please review and correct it.", "warning");
                        }
                        else if (data == 6) {
                            sweetAlert("", "Record already exist. Please check My Pendency list.", "warning");
                        }
                           
                        else {
                            sweetAlert("", "Record not saved.", "warning");
                        }
                        $("#btnSave").attr("disabled", false);
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
            else {
                $('#div_date_msg').removeClass('hidden');
            }
        }

        function CheckFormValidation() {
            $('#div_date_msg').addClass('hidden');
            var isVailed = true; validationMsg = "";
            $('#ddRequestType').removeClass('validationError');
            if ($('#ddRequestType').val() == "") {
                $('#ddRequestType').addClass('validationError');
                isVailed = false;
                validationMsg = " Request type, "
            }
            $("#ddApplyFor").removeClass('validationError');
            if ($('#ddRequestType').val() == 1) {
                if ($('#ddApplyFor').val() == "") {
                    $("#ddApplyFor").addClass('validationError');
                    isVailed = false;
                    validationMsg = validationMsg + "Applied for, "
                }
            }
            $("#ddDuration").removeClass('validationError');
            if ($('#ddDuration').val() == "") {
                $("#ddDuration").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "Duration, "
            }

            if ($('#ddDuration').val() == 2) {
                $("#ddHalfDay").removeClass('validationError');
                if ($('#ddHalfDay').val() == "") {
                    $("#ddHalfDay").addClass('validationError');
                    isVailed = false;
                    validationMsg = validationMsg + "Half day type, "
                }
            }

            $("#ddShift").removeClass('validationError');
            if ($('#ddRequestType').val() == 1 && $('#ddApplyFor').val() == 1) {
                if ($('#ddShift').val() == "") {
                    $("#ddShift").addClass('validationError');
                    isVailed = false;
                    validationMsg = validationMsg + "Shift, "
                }
            }
            $("#txtStartDate").removeClass('validationError');
            if ($('#txtStartDate').val() == "") {
                $("#txtStartDate").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "Start date, "
            }
            $("#txtEndDate").removeClass('validationError');
            if ($('#txtEndDate').val() == "") {
                $("#txtEndDate").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "End date, "
            }
            $("#ddStartHour").removeClass('validationError');
            if ($('#ddStartHour').val() == "") {
                $("#ddStartHour").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "Start hours, "
            }
            $("#ddStartMinute").removeClass('validationError');
            if ($('#ddStartMinute').val() == "") {
                $("#ddStartMinute").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "Start minute, "
            }
            $("#ddEndHour").removeClass('validationError');
            if ($('#ddEndHour').val() == "") {
                $("#ddEndHour").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "End hours, "
            }
            $("#ddEndMinute").removeClass('validationError');
            if ($('#ddEndMinute').val() == "") {
                $("#ddEndMinute").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "End minute, "
            }
            //SR86752 Start
            $('#ddWFHRequestType').removeClass('validationError');
            if ($('#ddWFHRequestType').val() == "") {
                $('#ddWFHRequestType').addClass('validationError');
                isVailed = false;
                validationMsg = " Request type, "
            }
            $("#txtRequestTypeRemarks").removeClass('validationError');
            if ($('#ddWFHRequestType').val() == 2) {
                if ($('#txtRequestTypeRemarks').val().trim() == "") {
                    $("#txtRequestTypeRemarks").addClass('validationError');
                    isVailed = false;
                    validationMsg = validationMsg + "Specify remarks, "
                }
            }
            //SR86752 End
            $("#txtRemarks").removeClass('validationError');
            if ($('#txtRemarks').val() == "") {
                $("#txtRemarks").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "Remarks"
            }
            debugger;
            if ($("#app_auth")[0].innerText == "") {

                $("#app_auth").addClass('validationError');
                isVailed = false;
                validationMsg = validationMsg + "Kindly set your approval authority first "
            }
            validationMsg = validationMsg + (isVailed == true ? "" : " feild(s) is/are mandatory.");
            $('#spn_date_msg').text(validationMsg);
            return isVailed;
        }

