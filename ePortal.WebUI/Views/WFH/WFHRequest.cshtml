        function ShiftOnChange() {
            debugger;
            if ($('#ddShift').val() != "") {
                $.ajax({
                    type: "GET",
                    url: "/WFH/GetShift",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },

                    data: { id: $('#ddShift').val() },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",

                    success: function (data) {
                        if (data.STARTTIME != "" && data.ENDTIME != "" && data.SEC_HALF_TIME != "") {
                            var startHour_starMinute = data.STARTTIME.split(':');
                            var secHalfHour_Minute = data.SEC_HALF_TIME.split(':');
                            var endHour_endMinute = data.ENDTIME.split(':');
                            if ($('#ddShift').val() == "80" || $('#ddShift').val() == "81" || $('#ddShift').val() == "82" || $('#ddShift').val() == "83" || $('#ddShift').val() == "84" || $('#ddShift').val() == "85" || $('#ddShift').val() == "86" || $('#ddShift').val() == "87" || $('#ddShift').val() == "88" || $('#ddShift').val() == "89" || $('#ddShift').val() == "90" || $('#ddShift').val() == "91" || $('#ddShift').val() == "92" || $('#ddShift').val() == "93" || $('#ddShift').val() == "94" || $('#ddShift').val() == "95" || $('#ddShift').val() == "96" || $('#ddShift').val() == "97" || $('#ddShift').val() == "98" || $('#ddShift').val() == "99" || $('#ddShift').val() == "100" || $('#ddShift').val() == "101" || $('#ddShift').val() == "102" || $('#ddShift').val() == "103" || $('#ddShift').val() == "104") {
                                $('#ddStartHour').removeClass('div_disable');
                                $('#ddStartMinute').removeClass('div_disable');
                            }
                            else {
                                $('#ddStartHour').addClass('div_disable');
                                $('#ddStartMinute').addClass('div_disable');
                            }
                            if ($('#ddDuration').val() == 1) {
                                $('#ddStartHour').val(startHour_starMinute[0]);
                                $('#ddStartMinute').val(startHour_starMinute[1]);
                                $('#ddEndHour').val(endHour_endMinute[0]);
                                $('#ddEndMinute').val(endHour_endMinute[1]);
                            }
                            else if ($('#ddDuration').val() == 2) {
                                if ($('#ddHalfDay').val() == 2) {
                                    $('#ddStartHour').val(secHalfHour_Minute[0]);
                                    $('#ddStartMinute').val(secHalfHour_Minute[1]);
                                    $('#ddEndHour').val(endHour_endMinute[0]);
                                    $('#ddEndMinute').val(endHour_endMinute[1]);
                                }
                                else if ($('#ddHalfDay').val() == 1) {
                                    $('#ddStartHour').val(startHour_starMinute[0]);
                                    $('#ddStartMinute').val(startHour_starMinute[1]);
                                    $('#ddEndHour').val(secHalfHour_Minute[0]);
                                    $('#ddEndMinute').val(secHalfHour_Minute[1]);
                                }
                                else {
                                    $('#ddStartHour').val('');
                                    $('#ddStartMinute').val('');
                                    $('#ddEndHour').val('');
                                    $('#ddEndMinute').val('');
                                }
                            }
                            else {
                                $('#ddStartHour').val('');
                                $('#ddStartMinute').val('');
                                $('#ddEndHour').val('');
                                $('#ddEndMinute').val('');
                            }
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                        if ($('#ddRequestType').val() == 2 || $('#ddApplyFor').val() == 2) {
                            CalculateTotalHour();
                        }
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
            else {
                $('#ddStartHour').val('');
                $('#ddStartMinute').val('');
                $('#ddEndHour').val('');
                $('#ddEndMinute').val('');
            }
        }
