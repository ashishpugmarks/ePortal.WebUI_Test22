@model IEnumerable<ePortal.ViewModels.ASRWFH_HEADER_ViewModel>

@{
    Layout = null;
}

<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
    table.dataTable thead th, table.dataTable thead td {
        padding: 8px 12px;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        line-height: 1.0;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial;
    }

    table.dataTable tbody td {
        padding: 4px 3px;
    }

    .table > tbody > tr:nth-of-type(odd) {
        background: #e9e9e9;
    }

    select.input-sm {
        line-height: 10px !important;
    }

</style>

<script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    $('.homeContent').removeClass('homeContent');
    $(document).ready(function () {
        $("#tbRequestReport").dataTable({
            "bFilter": false,
            "bLengthChange": false
        });

    });
</script>

<div class="panel-group">
    <div class="panel panel-primary">
        <div class="panel-heading">
            <h2 class="panel-title">
                <strong>WFH Request List</strong>
            </h2>
        </div>
        <div class="panel-body">
            <table class="table table-bordered table-hover table-responsive" id="tbRequestReport">
                <thead>
                    <tr>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.ASRWFHID)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.ADEMPCODE)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.EmpName)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.REQUESTTYPE)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.APPLYFOR)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.STARTDATE)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.ENDDATE)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.STARTTIME)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.ENDTIME)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.OffDays)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.WFH_REQUESTTYPE)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.WFH_REQUESTTYPEREMARKS)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.STATUS)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.DATEADDED)
                        </th>
						<th class="text-center">
                            @Html.DisplayNameFor(model => model.RECOMMENDEDBY)
                        </th>
						@*<th class="text-center">
                            @Html.DisplayNameFor(model => model.ISRECAPPROVED)
                        </th>
						<th class="text-center">
                            @Html.DisplayNameFor(model => model.RECREMARKS)
                        </th>*@
						<th class="text-center">
                            @Html.DisplayNameFor(model => model.RECAPPROVEDDATE)
                        </th>
						<th class="text-center">
                            @Html.DisplayNameFor(model => model.APPROVALBY)
                        </th>
						@*<th class="text-center">
                            @Html.DisplayNameFor(model => model.ISAPPAPPROVED)
                        </th>
						<th class="text-center">
                            @Html.DisplayNameFor(model => model.APPREMARKS)
                        </th>*@
						<th class="text-center">
                            @Html.DisplayNameFor(model => model.APPAPPROVEDDATE)
                        </th>
						<th class="text-center">
                            @Html.DisplayNameFor(model => model.AUTO_WFH_STATUS)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNo = 0; }
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            var _StartDate = string.Format("{0:dd-MM-yyyy}", item.STARTDATE);
                            var _EndDate = string.Format("{0:dd-MM-yyyy}", item.ENDDATE);
                            var _AddedDate = string.Format("{0:dd-MM-yyyy}", item.DATEADDED);
                            var _TotalDay = ((Convert.ToDateTime(item.ENDDATE).AddDays(1)) - Convert.ToDateTime(item.STARTDATE)).TotalDays;
                            var _WorkingDays = (_TotalDay - item.OffDays);
							var _RecDate = string.Format("{0:dd-MM-yyyy}", item.RECAPPROVEDDATE);
							var _AppDate = string.Format("{0:dd-MM-yyyy}", item.APPAPPROVEDDATE);
                            <tr>
                                <td class="text-center" style="width:3%;">
                                    @(rowNo += 1)
                                    @Html.HiddenFor(modelItem => item.ASRWFHID)
                                </td>
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.ADEMPCODE)
                                </td>
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.EmpName)
                                </td>
                                <td class="text-center">
                                    @{
                                        if (item.REQUESTTYPE == 1)
                                        {
                                            @Html.DisplayName("Work from Home")
                                        }
                                        else if (item.REQUESTTYPE == 2)
                                        {
                                            @Html.DisplayName("Remote Support")
                                        }
                                    }
                                    @*@Html.DisplayFor(modelItem => item.REQUESTTYPE)*@
                                </td>
                                <td class="text-center">
                                    @{
                                        if (item.APPLYFOR == 1)
                                        {
                                            @Html.DisplayName("Business Working Days")
                                        }
                                        else if (item.APPLYFOR == 2)
                                        {
                                            @Html.DisplayName("Off Days")
                                        }
                                    }
                                    @*@Html.DisplayFor(modelItem => item.APPLYFOR)*@
                                </td>
                                <td class="text-center">
                                    @_StartDate
                                    @*@Html.DisplayFor(modelItem => item.STARTDATE)*@
                                </td>
                                <td class="text-center">
                                    @_EndDate
                                    @*@Html.DisplayFor(modelItem => item.ENDDATE)*@
                                </td>
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.STARTTIME)
                                </td>
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.ENDTIME)
                                </td>
                                <td class="text-center">
                                    @_WorkingDays
                                </td>
                                <td class="text-center">
                                    @{
                                        if (item.WFH_REQUESTTYPE == 1)
                                        {
                                            @Html.DisplayName("As per roster")
                                        }
                                        else if (item.WFH_REQUESTTYPE == 2)
                                        {
                                            @Html.DisplayName("Apart from roster")
                                        }
                                    }
                                </td>
                                <td class="text-center">
                                    @Html.DisplayFor(modelItem => item.WFH_REQUESTTYPEREMARKS)
                                </td>
                                <td class="text-center">
                                   @{ 
                                       if (item.STATUS == 0)
                                       {
                                             @Html.DisplayName("In Progress")
                                       }
                                       else if (item.STATUS == 1)
                                       {
                                             @Html.DisplayName("Approved")
                                       }
                                    }
                                </td>
                                <td class="text-center">
                                    @_AddedDate
                                    @*@Html.DisplayFor(modelItem => item.DATEADDED)*@
                                </td>
								<td class="text-center">
                                    @Html.DisplayFor(modelItem => item.RECADEMPCODE) @Html.DisplayName("-") @Html.DisplayFor(modelItem => item.RECOMMENDEDBY)
                                </td>
								@*<td class="text-center">
								 @{ 
                                       if (item.ISRECAPPROVED == 0)
                                       {
                                             @Html.DisplayName("Pending")
                                       }
                                       else if (item.ISRECAPPROVED == 1)
                                       {
                                             @Html.DisplayName("Approved")
                                       }else if (item.ISRECAPPROVED == 2)
                                       {
                                             @Html.DisplayName("Rejected")
                                       }else if (item.ISRECAPPROVED == 3)
                                       {
                                             @Html.DisplayName("Cancelled By Requestor")
                                       }
                                  }                                    
                                </td>
								<td class="text-center">
                                    @Html.DisplayFor(modelItem => item.RECREMARKS)
                                </td>*@
								<td class="text-center">
                                    @_RecDate
                                </td>
								<td class="text-center">
                                    @Html.DisplayFor(modelItem => item.APPADEMPCODE) @Html.DisplayName("-") @Html.DisplayFor(modelItem => item.APPROVALBY)
                                </td>
								@*<td class="text-center">                                   
									@{ 
                                       if (item.ISAPPAPPROVED == 0 && item.ISRECAPPROVED == 1)
                                       {
                                             @Html.DisplayName("Pending")
                                       }
                                       else if (item.ISAPPAPPROVED == 1)
                                       {
                                             @Html.DisplayName("Approved")
                                       }else if (item.ISAPPAPPROVED == 2)
                                       {
                                             @Html.DisplayName("Rejected")
                                       }else if (item.ISAPPAPPROVED == 3)
                                       {
                                             @Html.DisplayName("Cancelled By Requestor")
                                       }else{
									   @Html.DisplayName("-")
									   }
                                  } 
                                </td>
								<td class="text-center">
                                    @Html.DisplayFor(modelItem => item.APPREMARKS)
                                </td>*@
								<td class="text-center">
                                   @_AppDate
                                </td>
								<td class="text-center">
								 @{    
										if (item.AUTO_WFH_STATUS == null)
                                       {
                                             @Html.DisplayName("Self")
                                       }                                      
                                       else if (item.AUTO_WFH_STATUS == 0)
                                       {
                                             @Html.DisplayName("Self")
                                       }
                                       else if (item.AUTO_WFH_STATUS == 1)
                                       {
                                             @Html.DisplayName("Auto")
                                       }
									   else if (item.AUTO_WFH_STATUS == 2)
                                       {
                                             @Html.DisplayName("Cancelled by User")
                                       }
                                    }                                    
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


