@model ePortal.ViewModels.ASRWFH_APPROVALHIS_ViewModel
@{
    ViewBag.Title = "WFHApproval";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var _APPROVAL_AUTHORITY = (ePortal.ViewModels.WFHAppAuthViewModel)TempData["APPROVAL_AUTHORITY"];

}

@section Styles{
    <link href="~/css/new-aproval-page.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .validationError {
            border: 1px solid #a94442;
        }

        .mr-top {
            margin-top: 7px;
        }

        #msform fieldset {
            background: white;
            border: 0 none;
            border-radius: 0px;
            box-shadow: 0 0 15px 1px rgba(0, 0, 0, 0.4);
            padding: 15px 50px 0px 50px; /*8px 0px;*/
            box-sizing: border-box;
            width: 80%;
            margin: 0 10%;
            position: relative;
        }

        .span-box {
            padding: 5px;
            background-color: #eee;
            border: 1px solid #ccc9c9;
            border-radius: 5px;
            /* color: #0949b7; */
            font-weight: 600;
        }

        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }
    </style>
}
   
   
@* Header and Breadcrumb *@
<div class="app-header">
    <div>WFH & Remote Support Request Approval</div>
    <div class="pull-right"><span style="color:#e6dede91"> <i class="fa fa-home"></i> <i class="fa fa-angle-right"></i> WFH <i class="fa fa-angle-right"></i> </span>WFH Approval</div>
</div>

@* WFH Request Details *@
<div class="panel panel-shadow">
    <div class="panel-heading" data-toggle="collapse" data-target="#wfhReqDetails">
        <span class="panel-title">
            <i class="fa fa-caret-down caret-color"></i>Request Details
        </span>
    </div>
    <div id="wfhReqDetails" class="panel-body panel-collapse collapse in">
        <table class="table table-responsive approval-table table-curved">
            <tbody>
                <tr>
                    <th width="15%">
                        @Html.LabelFor(model => model.ASRWFH_HEADER.ADEMPCODE, htmlAttributes: new { @class = "control-label" })
                    </th>
                    <td width="35%">
                        @Html.DisplayFor(model => model.ASRWFH_HEADER.ADEMPCODE)
                    </td>
                    <th width="15%">
                        @Html.LabelFor(model => model.ASRWFH_HEADER.EmpName, htmlAttributes: new { @class = "control-label" })
                    </th>
                    <td width="35%">
                        @Html.DisplayFor(model => model.ASRWFH_HEADER.EmpName)
                    </td>
                </tr>
                <tr>
                    <th>
                        @Html.HiddenFor(model => model.ASRWFH_HEADER.ASRWFHID, htmlAttributes: new { @id = "hfAsrWfhId" })
                        @Html.LabelFor(model => model.ASRWFH_HEADER.REQUESTTYPE, htmlAttributes: new { @class = "control-label" })
                    </th>
                    <td>
                        @Html.HiddenFor(model => model.ASRWFH_HEADER.REQUESTTYPE, htmlAttributes: new { @id = "hfReqType" })
                        @{
                            if (Model.ASRWFH_HEADER.REQUESTTYPE == 1)
                            {
                                @Html.DisplayName("Work from Home")
                            }
                            else
                            {
                                @Html.DisplayName("Remote Support")
                            }
                        }
                    </td>
                    <th>
                        @Html.LabelFor(model => model.ASRWFH_HEADER.APPLYFOR, htmlAttributes: new { @class = "control-label" })
                    </th>
                    <td>
                        @Html.HiddenFor(model => model.ASRWFH_HEADER.APPLYFOR, htmlAttributes: new { @id = "hfApplyFor" })
                        @{
                            if (Model.ASRWFH_HEADER.APPLYFOR == 1)
                            {
                                @Html.DisplayName("Business Working Days")
                            }
                            else if (Model.ASRWFH_HEADER.APPLYFOR == 2)
                            {
                                @Html.DisplayName("Off Days")
                            }
                        }
                    </td>
                </tr>
                <tr>
                    <th>
                        @Html.LabelFor(model => model.ASRWFH_HEADER.DURATION, htmlAttributes: new { @class = "control-label" })
                    </th>
                    <td>
                        @{
                            if (Model.ASRWFH_HEADER.DURATION == 1)
                            {
                                @Html.DisplayName("Full Day")
                            }
                            else if (Model.ASRWFH_HEADER.DURATION == 2)
                            {
                                @Html.DisplayName("Half Day")
                            }
                            else
                            {
                                @Html.DisplayName("Others")
                            }
                        }
                    </td>
                    <th>
                        @Html.LabelFor(model => model.ASRWFH_HEADER.WEHSHIFTID, htmlAttributes: new { @class = "control-label" })
                    </th>
                    <td>
                        @Html.DisplayFor(model => model.ASRWFH_HEADER.WEHSHIFT)
                    </td>
                </tr>
                <tr>
                    <th>
                        @Html.LabelFor(model => model.ASRWFH_HEADER.STARTDATE, htmlAttributes: new { @class = "control-label" })
                    </th>
                    <td>
                        <div id="div-StartDate">
                            @Html.DisplayFor(model => model.ASRWFH_HEADER.STARTDATE)
                        </div>
                    </td>
                    <th>
                        @Html.LabelFor(model => model.ASRWFH_HEADER.ENDDATE, htmlAttributes: new { @class = "control-label" })
                    </th>
                    <td>
                        <div id="div-EndDate">
                            @Html.DisplayFor(model => model.ASRWFH_HEADER.ENDDATE)
                        </div>
                    </td>
                </tr>
                <tr>
                    <th>
                        @Html.LabelFor(model => model.ASRWFH_HEADER.STARTTIME, htmlAttributes: new { @class = "control-label" })
                    </th>
                    <td>
                        @Html.DisplayFor(model => model.ASRWFH_HEADER.STARTTIME)
                    </td>
                    <th>
                        @Html.LabelFor(model => model.ASRWFH_HEADER.ENDTIME, htmlAttributes: new { @class = "control-label" })
                    </th>
                    <td>
                        @Html.DisplayFor(model => model.ASRWFH_HEADER.ENDTIME)
                    </td>
                </tr>
                @if (Model.ASRWFH_HEADER.REQUESTTYPE == 1 && Model.ASRWFH_HEADER.APPLYFOR == 1)
                {
                    <tr>
                        <td colspan="4">
                            <table class="table table-responsive approval-table table-curved">
                                <tbody>
                                    <tr>
                                        <th>
                                            <label class="control-label">Total Days</label>
                                        </th>
                                        <td>
                                            <span id="spanTotalDays"></span>
                                        </td>
                                        <th>
                                            <label class="control-label">Off Days</label>
                                        </th>
                                        <td>
                                            <span id="spanTotalOff"></span>
                                        </td>
                                        <th>
                                            <label class="control-label">Working Days</label>
                                        </th>
                                        <td colspan="3">
                                            <span id="spanWorkingDays"></span>
                                        </td>
                                    </tr>
                                    <tr class="hidden">
                                        @if (false) /*It was hidden by default <div class="form-group hidden" id="div_working_hour">*/
                                        {
                                            <th>
                                                <label class="control-label">Total Working Hours</label>
                                            </th>
                                            <td>
                                                <span id="spanTotalHour"></span>
                                            </td>
                                        }
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                }
                else
                {
                    if (false) /* It was hidden by default <div class="form-group hidden" id="div_working_days"> */
                    {
                        <tr class="hidden">
                            <th>
                                <label class="control-label">Total Days</label>
                            </th>
                            <td>
                                <span id="spanTotalDays"></span>
                            </td>
                            <th>
                                <label class="control-label">Off Days</label>
                            </th>
                            <td>
                                <span id="spanTotalOff"></span>
                            </td>
                        </tr>
                        <tr class="hidden">
                            <th>
                                <label class="control-label">Working Days</label>
                            </th>
                            <td>
                                <span id="spanWorkingDays"></span>
                            </td>
                        </tr>
                    }
                    <tr>
                        <th>
                            <label class="control-label">Total Working Hours</label>
                        </th>
                        <td colspan="3">
                            <span id="spanTotalHour"></span>
                        </td>
                    </tr>
                }

                <tr>
                    <th>
                        @Html.LabelFor(model => model.ASRWFH_HEADER.WFH_REQUESTTYPE, htmlAttributes: new { @class = "control-label" })
                    </th>
                    <td colspan="@(Model.ASRWFH_HEADER.WFH_REQUESTTYPE == 2 ? 0 : 3)">
                        @Html.HiddenFor(model => model.ASRWFH_HEADER.WFH_REQUESTTYPE, htmlAttributes: new { @id = "hfWFHReqType" })
                        @{
                            if (Model.ASRWFH_HEADER.WFH_REQUESTTYPE == 1)
                            {
                                @Html.DisplayName("As per roster")
                            }
                            else if (Model.ASRWFH_HEADER.WFH_REQUESTTYPE == 2)
                            {
                                @Html.DisplayName("Apart from roster")
                            }
                            else
                            {
                                @Html.DisplayName("")
                            }
                        }
                    </td>
                    @if (Model.ASRWFH_HEADER.WFH_REQUESTTYPE == 2)
                    {
                        <th>
                            @Html.LabelFor(model => model.ASRWFH_HEADER.WFH_REQUESTTYPEREMARKS, htmlAttributes: new { @class = "control-label" })
                        </th>
                        <td>
                            <p style="white-space: pre-wrap; overflow-y: auto; max-height: 100px; min-height:50px;">
                                @Model.ASRWFH_HEADER.WFH_REQUESTTYPEREMARKS
                            </p>
                        </td>
                    }
                </tr>
                @*SR86752 End*@
                <tr>
                    <th>
                        @Html.LabelFor(model => model.ASRWFH_HEADER.REMARKS, htmlAttributes: new { @class = "control-label" })
                    </th>
                    <td colspan="3">
                        <p style="white-space: pre-wrap; overflow-y: auto; max-height: 100px; min-height:50px;">@Model.ASRWFH_HEADER.REMARKS</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@* Approval *@
<div class="panel panel-shadow">
    <div class="panel-heading" data-toggle="collapse" data-target="#approval">
        <span class="panel-title"><i class="fa fa-caret-down caret-color"></i>Approval Details</span>
    </div>
    <div id="approval" class="panel-body panel-collapse collapse in">
        <div class="remarks-box">

            @{

                if (true)
                {
                    <div class="text-center pnl-btn">
                        <button type="button" class="btn action-btn btn-md reject" data-id="0" data-status="2"><i class="fa fa-times-circle-o"></i>REJECT</button>
                        <button type="button" class="btn btn-md hold hidden" data-id="0" data-status="0"><i class="fa fa-pause"></i>HOLD</button>
                        <button type="button" class="btn btn-md sendback hidden" data-id="0" data-status="0"><i class="fa fa-undo"></i>SEND BACK</button>
                        <button type="button" class="btn action-btn btn-md approve" data-id="0" data-status="1"><i class="fa fa-check-circle-o"></i>APPROVE</button>
                    </div>
                    <div>
                        <div class="well">
                            <table class="table table-responsive approval-table table-curved" style="margin-bottom: 5px;">
                                <tbody>
                                    <tr>
                                        <th width="35%">
                                            @{
                                                if (Model.ASRWFH_HEADER.ASRWFH_APPROVALHIS.ISRECAPPROVED == 0)
                                                {
                                                    <label class="control-label">Forward To</label>
                                                }
                                                else
                                                {
                                                    <label class="control-label">Recommended By</label>
                                                }
                                            }
                                        </th>
                                        <td width="65%">
                                            @{
                                                if (Model.ASRWFH_HEADER.ASRWFH_APPROVALHIS.ISRECAPPROVED == 0)
                                                {
                                                    <span class="span-box">
                                                        @_APPROVAL_AUTHORITY.EmpName
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        @_APPROVAL_AUTHORITY.RecEmpName
                                                    </span>
                                                }
                                            }
                                        </td>
                                    </tr>
                                    @{
                                        if (Model.ASRWFH_HEADER.ASRWFH_APPROVALHIS.ISRECAPPROVED == 1)
                                        {
                                            <tr>
                                                <th width="35%">
                                                    <label class="control-label">Recommended Date</label>
                                                </th>
                                                <td width="65%">
                                                    @Html.DisplayFor(model => model.ASRWFH_HEADER.ASRWFH_APPROVALHIS.RECAPPROVEDDATE)
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>
                                                    <label class="control-label">Remarks</label>
                                                </th>
                                                <td>
                                                    @Html.DisplayFor(model => model.ASRWFH_HEADER.ASRWFH_APPROVALHIS.RECREMARKS)
                                                </td>
                                            </tr>
                                        }
                                    }
                                    <tr>
                                        <td colspan="2">
                                            @Html.TextAreaFor(model => model.APPREMARKS, new { @id = "txtApprovalRemarks", @class = "form-control", @placeholder = "Please enter approval remarks." })
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
            <div class="text-center pnl-btn last-row-btn">
                <a title="Back" class="btn back" href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx"><i class="fa fa-arrow-left"></i>BACK</a>
                <a title="Skip" class="btn skip" href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx"><i class="fa fa-step-forward"></i>SKIP</a>
            </div>
        </div>
    </div>
</div>


<div id="ajaxLoader"></div>

@section Scripts{

    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        var _totalWorkingDay = 0, _totalWorkingHour = "";
        $(document).ready(function () {
            OnDateChange();
            CalculateTotalHour();
        });

        function OnDateChange() {
            var _startDate, _endDate;
            _startDate = '@Model.ASRWFH_HEADER.StartDateStr'; ////$('#div-StartDate')[0].innerText;
            _endDate = '@Model.ASRWFH_HEADER.EndDateStr';  ////$('#div-EndDate')[0].innerText;
            if (_startDate != "" && _endDate != "") {
                $.ajax({
                    type: "GET",
                    url: "/WFH/GetOffDays",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { startDate: _startDate, endDate: _endDate },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        debugger;
                        if (data.TOTALDAYS != -1 && data.OFFDAYS != -1 && data.WORKINGDAYS != -1) {
                            $('#spanTotalDays').text(data.TOTALDAYS.toString());
                            $('#spanTotalOff').text(data.OFFDAYS.toString());
                            $('#spanWorkingDays').text(data.WORKINGDAYS.toString());
                            _totalWorkingDay = data.WORKINGDAYS;
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        };

        function CalculateTotalHour() {
            var _startDate, _endDate, _startTime, _endTime;
            _startDate = '@Model.ASRWFH_HEADER.StartDateStr'; ////$('#div-StartDate')[0].innerText;
            _endDate = '@Model.ASRWFH_HEADER.EndDateStr';  ////$('#div-EndDate')[0].innerText;
            _startTime = '@Model.ASRWFH_HEADER.STARTTIME';
            _endTime = '@Model.ASRWFH_HEADER.ENDTIME';
            if (_startDate != "" && _endDate != "" && _startTime != "" && _endTime != "") {
                $.ajax({
                    type: "GET",
                    url: "/WFH/GetHours",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { startDate: _startDate, endDate: _endDate, startTime: _startTime, endTime: _endTime },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.TOTALHOURS != -1) {
                            $('#spanTotalHour').text(data.TOTALHOURS.toFixed(2));
                            _totalWorkingHour = data.TOTALHOURS.toFixed(2);
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function UpdateData(current) {
            //var isFormVaildation = CheckFormValidation(current);
            if (true) {
                $("#btnSave, .action-btn").attr("disabled", true);
                var data = {
                    ASRWFHID: $('#hfAsrWfhId').val(),
                    ISAPPAPPROVED: $(current).attr('data-status'),
                    APPREMARKS: $('#txtApprovalRemarks').val(),
                    ISRECAPPROVED: $(current).attr('data-status'),
                    RECREMARKS: $('#txtApprovalRemarks').val(),
                    ASRWFH_HEADER: {
                        WorkingDays: (($('#hfReqType').val() == 1 && $('#hfApplyFor').val() == 1) ? _totalWorkingDay : _totalWorkingHour).toString()
                    }
                }
                //@*Auto WFH start*@
                if ($(current).attr('data-status') == 2) {
                    var r = confirm("Are you sure you want to reject this request?")
                    if (r == false) {
                        $("#btnSave, .action-btn").attr("disabled", false);
                        return false;
                    }
                }
                //@*Auto WFH end*@

                $.ajax({
                    type: "PUT",
                    url: "/WFH/WFHApproval",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: JSON.stringify(data),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data == 1) {
                           window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx";

                        }
                        else {
                            sweetAlert("", "Record not saved.", "warning");
                        }
                        $("#btnSave, .action-btn").attr("disabled", false);
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function CheckFormValidation(current) {
            var isVailed = true;
            $('#ddStatus').removeClass('validationError');
            if ($(current).attr('data-status') == "") {
                $('#ddStatus').addClass('validationError');
                isVailed = false;
            }

            return isVailed;
        }
    </script>
    @* CSP 3.0 Compliant changes *@
    <script nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('.action-btn').on('click', function () {
                UpdateData($(this)[0]);
            });
            $('#reqDetails, #wfhReqDetails, #approval').on('show.bs.collapse', function () {
                $(this).prev('.panel-heading').find('.caret-color').removeClass('fa-caret-right').addClass('fa-caret-down');
            });

            $('#reqDetails, #wfhReqDetails, #approval').on('hide.bs.collapse', function () {
                $(this).prev('.panel-heading').find('.caret-color').removeClass('fa-caret-down').addClass('fa-caret-right');
            });

            setPanelWidth();
        });
        $(window).resize(function () {
            setPanelWidth();
        });
        function setPanelWidth() {
            var btnApproveClientWidth = $('.pnl-btn .approve').prop('clientWidth');
            if (window.innerWidth < 1024) { // Mobile layout
                $('.last-row-btn .btn').css({
                    'maxWidth': `auto`
                });
            }
            else {
                $('.last-row-btn .btn').css({
                    'maxWidth': `${btnApproveClientWidth}px`
                });
            }
        }
    </script>

}
