@model ePortal.ViewModels.WFHReportViewModel

@{
    ViewBag.Title = "WFHIRReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .form-control {
            height: 28px;
            padding: 3px 3px;
            font-size: 13px;
        }
    </style>
}
@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $('#txtEmpCode').val('');
            $('.datepic').datepicker({
                format: "dd-M-yyyy",
                todayHighlight: true,
                autoclose: true,
                toolbarplacement: 'top'
            });

            BindDivision($("#ddlOp"), 1);

            BindDepartment($("#ddlDiv"), 1);

            BindSection($("#ddlSec"), 1);

        });


        ////======== Bind Division========////
        function BindDivision(crnt, call) {
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            $.getJSON("/WFH/BindDivisionByOperationId", { id: dID },
                   function (data) {
                       var select = $("#ddlDiv");
                       select.empty();
                       if (data.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.DIVISIONID,
                               text: itemData.DIVISION
                           }));
                       });
                       if ('@Model.DivId' != '' && call == 1) {
                           $("#ddlDiv").val('@Model.DivId');
                       }
                   });
        }

        ////======== Bind Department========////
        function BindDepartment(crnt, call) {
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            $.getJSON("/WFH/BindDeptByDivisionId", { id: dID },
                   function (data) {
                       var select = $("#ddlDep");
                       select.empty();
                       if (data.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.DEPARTMENTID,
                               text: itemData.DEPARTMENT
                           }));
                       });
                       if ('@Model.DepId' != '' && call == 1) {
                           $("#ddlDep").val('@Model.DepId');
                       }
                   });
        };

        ////======== Bind Section========////
        function BindSection(crnt, call) {
            var dID = $(crnt).val();
            if (dID == "") {
                dID = 0;
            }
            $.getJSON("/WFH/BindSecByDepartmentId", { id: dID },
                   function (data) {
                       var select = $("#ddlSec");
                       select.empty();
                       if (data.length > 0) {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--Select--"
                           }));
                       }
                       else {
                           select.append($('<option/>', {
                               value: 0,
                               text: "--No record--"
                           }));
                       }
                       $.each(data, function (index, itemData) {
                           select.append($('<option/>', {
                               value: itemData.SECTIONID,
                               text: itemData.SECTION
                           }));
                       });
                       if ('@Model.SecId' != '' && call == 1) {
                           $("#ddlSec").val('@Model.SecId');
                       }
                   });
        };

        function GetReportList(crnt) {
            var data = {
                OpId: $('#ddlOp').val() == "" ? 0 : $('#ddlOp').val(),
                DivId: $('#ddlDiv').val() == "" ? 0 : $('#ddlDiv').val(),
                DepId: $('#ddlDep').val() == "" ? 0 : $('#ddlDep').val(),
                SecId: $('#ddlSec').val() == "" ? 0 : $('#ddlSec').val(),
                RequestType: $('#ddRequestType').val() == "" ? 0 : $('#ddRequestType').val(),
                Employee: $('#txtEmpCode').val() == "" ? 0 : $('#txtEmpCode').val(),
				RequestStatus: $('#ddRequestStatus').val() == "" ? null : $('#ddRequestStatus').val(), //SR86752
                FromDate: $('#txtFromDate').val(),
                ToDate: $('#txtToDate').val(),
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                url: "/WFH/WFHIRReport",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == "error") {
                        sweetAlert("", "An error occurred while processing your request.", "error");
                    }
                    else {
                        $('#div_append').html(data);
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

        function GetExcel(crnt) {
            var data = {
                OpId: $('#ddlOp').val() == "" ? 0 : $('#ddlOp').val(),
                DivId: $('#ddlDiv').val() == "" ? 0 : $('#ddlDiv').val(),
                DepId: $('#ddlDep').val() == "" ? 0 : $('#ddlDep').val(),
                SecId: $('#ddlSec').val() == "" ? 0 : $('#ddlSec').val(),
                RequestType: $('#ddRequestType').val() == "" ? 0 : $('#ddRequestType').val(),
                Employee: $('#txtEmpCode').val() == "" ? 0 : $('#txtEmpCode').val(),
				RequestStatus: $('#ddRequestStatus').val() == "" ? null : $('#ddRequestStatus').val(), //SR86752
                FromDate: $('#txtFromDate').val(),
                ToDate: $('#txtToDate').val(),
            }
            $.ajax({
                type: "POST",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                //url: "/WFH/ExportToExcel",
				url: "/WFH/AdminExportToExcel",//SR86752
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    if (data == 1) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "WFH", Action = "DownloadExcel" })";
                    }
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                },
                error: function () {
                    sweetAlert("Oops...", "Something went wrong!", "error");
                }
            });
        }

    </script>

    @* CSP 3.0 Compliant changes *@
<script nonce="@Context.Items["ScriptNonce_4"]">
    $(document).ready(function () {
        $('#btnSubmit').on('click', function() {
            GetReportList(this);
        });

        $('#btnExcel').on('click', function() {
            GetExcel(this);
        }); 

        $('#btnReset').on('click', function() {
            location.href = '@Url.Action("WFHReport", "WFH")';
        });

        $(document).off("change", "[data-ctrl='ddl-op']");
        $(document).on("change", "[data-ctrl='ddl-op']", function () {
            BindDivision(this, 0);
        });

        $(document).off("change", "[data-ctrl='ddl-div']");
        $(document).on("change", "[data-ctrl='ddl-div']", function () {
            BindDepartment(this, 0);
        });

        $(document).off("change", "[data-ctrl='ddl-dep']");
        $(document).on("change", "[data-ctrl='ddl-dep']", function () {
            BindSection(this, 0);
        });


    });
</script>
}
    <div class="row">
        <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <div style="padding:8px;">
                WFH & Remote Support Report
            </div>
        </div>

        <div class="body-content" style="overflow-x:auto!important;">
            <div class="panel-group">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title">
                            <strong>Search</strong>
                        </h2>
                    </div>
                    <div class="panel-body" style="padding:5px;">
                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.RequestType, new { @class = "control-label text-right col-md-1", @style = "width:130px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.RequestType, new List<SelectListItem>{
                                                         new SelectListItem{ Text="-Select Request Type-", Value = "" },
                                                         new SelectListItem{ Text="Work from Home", Value = "1" },
                                                         new SelectListItem{ Text="Remote Support", Value = "2" }},
                                                         new { @id = "ddRequestType", @class = "form-control" })
                            </div>

                            @Html.LabelFor(model => model.OpId, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.OpId, new SelectList(ViewBag.OpList.Items, "ADORGLEVELID", "LEVELDESCRIP"), "- Select -", new { id = "ddlOp", data_ctrl = "ddl-op", @class = "form-control" })
                            </div>


                            @Html.LabelFor(model => model.DivId, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.DivId, new SelectList(ViewBag.DivList.Items, "ADORGLEVELID", "LEVELDESCRIP"), "- Select -", new { id = "ddlDiv", data_ctrl = "ddl-div", @class = "form-control" })
                            </div>


                        </div>
                        <div class="row" style="padding:4px;">
                            @Html.LabelFor(model => model.DepId, new { @class = "control-label text-right col-md-1", @style = "width: 130px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.DepId, new SelectList(ViewBag.DepList.Items, "ADORGLEVELID", "LEVELDESCRIP"), "- Select -", new { id = "ddlDep", data_ctrl = "ddl-dep", @class = "form-control" })
                            </div>


                            @Html.LabelFor(model => model.SecId, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2" style="width:20.66%;">
                                @Html.DropDownListFor(model => model.SecId, new SelectList(ViewBag.SecList.Items, "ADORGLEVELID", "LEVELDESCRIP"), "- Select -", new { @id = "ddlSec", @class = "form-control" })
                            </div>

                            @Html.LabelFor(model => model.Employee, new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" })
                            <div class="col-md-2 col-lg-2">
                                @Html.TextBoxFor(model => model.Employee, new { @type = "number", @value = "", @id = "txtEmpCode", @class = "form-control", @style = "width: 110px;" })
                            </div>
                        </div>
                        <div class="row" style="padding:4px;">
                            <label class="control-label text-right col-md-1" style="width: 140px;margin-top: 7px;">From Date</label>
                            @* @Html.Label("From Date", new { @class = "control-label text-right col-md-1", @style = "width: 140px;margin-top: 7px;" }) *@
                            <div class="col-md-2 col-lg-2">
                                @*@Html.TextBox("FromDate", new { @id = "txtFromDate", @class = "form-control datepic", @style = "width: 120px;", @readonly = "readonly" })*@
                                <input id="txtFromDate" class="form-control datepic" style="width: 120px;" name="Fromdate" type="text" value="" readonly="readonly" />
                            </div>
                            <label class="control-label text-right col-md-1" style="width: 190px;margin-top: 7px;">To Date</label>
                            @* @Html.Label("To Date", new { @class = "control-label text-right col-md-1", @style = "width: 190px;margin-top: 7px;" }) *@
                            <div class="col-lg-2 col-md-2">
                                @*    @Html.TextBox("ToDate", new { @id = "txtToDate", @class = "form-control datepic", @style = "width: 120px;", @readonly = "readonly" })*@
                                <input id="txtToDate" class="form-control datepic" style="width: 120px;" name="Todate" type="text" value="" readonly="readonly" />
                            </div>
							<!--SR86752 Start-->
                            <label class="control-label text-right col-md-1" style="width: 242px;margin-top: 7px;">Request Status</label>
							@* @Html.LabelFor(model => model.RequestStatus, new { @class = "control-label text-right col-md-1", @style = "width:242px;margin-top: 7px;" })
                           *@ <div class="col-md-2 col-lg-2" style="width:20.66%;"> 
                                @Html.DropDownListFor(model => model.RequestStatus, new List<SelectListItem>{
                                                         new SelectListItem{ Text="-Select Request Status-", Value = "" },
                                                         new SelectListItem{ Text="In Progress", Value = "0" },
                                                         new SelectListItem{ Text="Approved", Value = "1" }},
                                                         new { @id = "ddRequestStatus", @class = "form-control" })
                            </div>
							<!--SR86752 End-->
                        </div>

                        <div class="row" style="padding:2px;">
                            <div class="col-md-12 col-lg-12 text-center">
                                <button id="btnSubmit" class="btn btn-success btn-sm">Search</button>
                                <button id="btnExcel" class="btn btn-primary btn-sm">Export To Excel</button>
                                <input type="button" value="Reset" id="btnReset" class="btn btn-default btn-sm" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="ajaxLoader"></div>
            <div id="div_append"></div>
        </div>
   
