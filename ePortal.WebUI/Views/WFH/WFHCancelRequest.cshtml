@section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            OnDateChange();
            CalculateTotalHour();
        });

        function OnDateChange() {
            var _startDate, _endDate;
            _startDate = '@Model.ASRWFH_HEADER.StartDateStr'; ////$('#div-StartDate')[0].innerText;
            _endDate = '@Model.ASRWFH_HEADER.EndDateStr';  ////$('#div-EndDate')[0].innerText;
            if (_startDate != "" && _endDate != "") {
                $.ajax({
                    type: "GET",
                    url: "/WFH/GetOffDays",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { startDate: _startDate, endDate: _endDate },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.TOTALDAYS != -1 && data.OFFDAYS != -1 && data.WORKINGDAYS != -1) {
                            $('#spanTotalDays').text(data.TOTALDAYS.toString());
                            $('#spanTotalOff').text(data.OFFDAYS.toString());
                            $('#spanWorkingDays').text(data.WORKINGDAYS.toString());
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        };

        function CalculateTotalHour() {
            var _startDate, _endDate, _startTime, _endTime;
            _startDate = '@Model.ASRWFH_HEADER.StartDateStr'; ////$('#div-StartDate')[0].innerText;
            _endDate = '@Model.ASRWFH_HEADER.EndDateStr';  ////$('#div-EndDate')[0].innerText;
            _startTime = '@Model.ASRWFH_HEADER.STARTTIME';
            _endTime = '@Model.ASRWFH_HEADER.ENDTIME';
            if (_startDate != "" && _endDate != "" && _startTime != "" && _endTime != "") {
                $.ajax({
                    type: "GET",
                    url: "/WFH/GetHours",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: { startDate: _startDate, endDate: _endDate, startTime: _startTime, endTime: _endTime },
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data.TOTALHOURS != -1) {
                            $('#spanTotalHour').text(data.TOTALHOURS.toFixed(2));
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function UpdateData() {
            var isFormVaildation = CheckFormValidation();
            if (isFormVaildation) {
                $("#btnSave").attr("disabled", true);
                var data = {
                    ASRWFHID: $('#hfAsrWfhId').val(),
                    ISAPPAPPROVED: $('#ddStatus').val(),
                    APPREMARKS: $('#txtCancelRemarks').val(),
                }
                $.ajax({
                    type: "PUT",
                    url: "/WFH/WFHCancelRequest",
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    data: JSON.stringify(data),
                    contentType: "application/json; charset=utf-8",
                    datatype: "json",
                    success: function (data) {
                        if (data == 1) {
                            swal({
                                title: "",
                                text: "Request cancelled successfully.",
                                type: "success",
                            }, function (isConfirm) {
                                if (isConfirm) {
                                    window.location.href = "/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx";
                                }
                            });
                        }
                        else {
                            sweetAlert("", "Record not saved.", "warning");
                        }
                        $("#btnSave").attr("disabled", false);
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function () {
                        sweetAlert("Oops...", "Something went wrong!", "error");
                    }
                });
            }
        }

        function CheckFormValidation() {
            var isVailed = true;
            $('#ddStatus').removeClass('validationError');
            if ($('#ddStatus').val() == "") {
                $('#ddStatus').addClass('validationError');
                isVailed = false;
            }
            $("#txtCancelRemarks").removeClass('validationError');
            if ($('#txtCancelRemarks').val() == "") {
                $("#txtCancelRemarks").addClass('validationError');
                isVailed = false;
            }
            return isVailed;
        }
    </script>

    @* CSP 3.0 Compliant changes *@
    <script nonce="@Context.Items["ScriptNonce_4"]">
        $(document).ready(function () {
            $('#btnSave').on('click', function () {
                UpdateData();
            });
        });
    </script>
