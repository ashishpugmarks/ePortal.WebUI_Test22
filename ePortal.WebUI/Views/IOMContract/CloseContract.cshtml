@model ePortal.ViewModels.APPX.IOM.CloseContractViewModel
@{
    ViewBag.Title = "Employee Portal - Contract Management :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/css/newasset.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/iomcontract/css/closecontract.css" rel="stylesheet" asp-append-version="true" />

}

<div class="row">
    @* Heading Start *@
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">Close Contract Form </div>
    </div>

    <div class="body-content" style="overflow-x:hidden; padding: 0px !important;">
        <div id="errorpanel" class="roundedPanel" style="background-color:#ED243B;width:100%; display: none;">
            <div style="padding-left: 6px;">
                <div id="ctl00_InnerContent_pnlError" class="roundedPanel" style="background-color:#FFEAEA;width:99%;">
                    <table cellpadding="0" cellspacing="0" border="0" width="100%">
                        <tbody>
                            <tr id="tr_ErrorRow">
                                <td style="padding: 2px; padding-left: 5px; color: Black;">
                                    <input type="text" id="txtup" style="width: 0px; border:0px;" />
                                    <span id="status" style="font-size: 13px; font-family: Trebuchet MS"></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


        @* Heading End *@

        <div class="headmain" style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
            <table class="table table-bordered table-condensed table-striped" width="100%">
                <thead>
                    <tr class="HeaderStyle12">
                        <td colspan="4">
                            &nbsp; Contract Detail`s
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <tr style="line-height: 25px;">

                        <td width="20%" style="text-align: right; vertical-align: top;" class="font12">
                            From :-
                        </td>
                        <td width="30%" style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                            &nbsp;
                            <span class="lblcss" id="lblfrom">@Model.lblfrom</span>
                        </td>
                        <td width="20%" style="text-align: right; vertical-align: top;" class="font12">
                            To :-
                        </td>
                        <td width="30%" style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                            &nbsp;
                            <span class="lblcss" id="lblto">@Model.lblto</span>
                        </td>
                    </tr>

                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="style3">
                            Contact Type :-
                        </td>
                        <td style="color: #6299c5; vertical-align: top; text-align: left;" class="style3">
                            &nbsp;
                            <span class="lblcss" id="lblcontracttype">@Model.lblcontracttype</span>
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="style3">
                            Manner of Payment :-
                        </td>
                        <td style="color: #6299c5; vertical-align: top; text-align: left;" class="style3">
                            &nbsp;
                            <span class="lblcss" id="lblmannerofpayment">@Model.lblmannerofpayment</span>
                        </td>
                    </tr>

                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            Effective Date:-
                        </td>
                        <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                            &nbsp;
                            <span class="lblcss" id="lbleffdate">@Model.lblexpdate</span>
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            Term :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss" id="lblterm">@Model.lblterm</span>
                        </td>
                    </tr>


                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="style1">
                            Vendor Name :-
                        </td>
                        <td class="style2" style="color: #6299c5; vertical-align: top; text-align: left;"
                            colspan="3">
                            &nbsp;
                            <span class="lblcss" id="lblvendorname">@Model.lblvendorname</span>
                        </td>
                    </tr>
                    
                    
                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" width="20%" class="font12">
                            Agreement:-
                        </td>
                        <td class="smalltext" width="30%" style="color: #6299c5; vertical-align: top; text-align: left;word-break: break-all;" colspan="3">
                            &nbsp;
                            <a id="Agreementlink" data-url="@Model.Agreementlink">@Model.AgreementlinkText</a>
                        </td>
                    </tr>
                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" width="20%" class="font12">
                            Approval Note:-
                        </td>
                        <td class="smalltext" width="30%" style="color: #6299c5; vertical-align: top; text-align: left;word-break: break-all;" colspan="3">
                            &nbsp;
                            <a id="approvalnotelink" data-url="@Model.approvalnotelink">@Model.approvalnotelinkText</a>
                        </td>
                    </tr>

                     <tr  style="line-height: 25px;" id="trantibribery">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Anti Bribery Policy:-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;word-break: break-all;" colspan="3">
                                &nbsp;
                            <a id="antibriberylink" data-url="@Model.antibriberylink">@Model.antibriberylinkText</a>
                            </td>
                      </tr>

                    <tr style="line-height: 25px;" id="tr1">
                        <td style="text-align: right; vertical-align: top;" class="font12">Non Disclosure Agreement:-</td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;word-break: break-all;" colspan="3">
                            &nbsp;
                            <a id="ndadocumentlink" data-url="@Model.ndadocumentlink">@Model.ndadocumentlinkText</a>
                        </td>
                    </tr>

                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            Purpose :-
                        </td>
                        <td class="smalltext" style="color: #6299c5;line-height:13px!Important;padding:4px 4px 4px 0px!Important;"
                            colspan="3">
                            &nbsp;
                            <span class="lblcss" id="lblpurpose">@Model.lblpurpose</span>
                        </td>
                    </tr>
                    @if (Convert.ToBoolean(ViewBag.trmstagrVisible ?? false))
                    {
                        <tr id="trmstagr" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Master Agreement :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                                colspan="3">
                                &nbsp;
                                <span class="lblcss" id="lblmstagr">@Model.lblmstagr</span>
                            </td>
                        </tr>
                    }
                   
                </tbody>
            </table>

            <table class="tableGridView" style="border-color: #CCDCE0; border-width: 1px; border-style: solid;
                        margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;" cellpadding="0"
                   cellspacing="0" width="100%">
                <thead>
                    <tr>
                        <td class="HeaderStyle12" style="padding: 0px 0px 0px 0px;" colspan="4">
                            &nbsp; Contract Close Detail
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Close Remarks :-<span class="mandatory">*</span>
                        </td>
                        <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                            &nbsp;
                            @Html.TextAreaFor(
                                     model => model.txt_closeRemarks,
                                     new
                                     {
                                         @class = "font12 onpaste",
                                         style = "margin: 3px; width: 450px; height: 60px; border-color:#888888;",
                                         maxlength = "499"
                                     }
                                     )
                            <input asp-for="HDAGREEMENTID" type="hidden" />
                        </td>
                    </tr>
            </table>

            <table class="table table-bordered table-condensed table-striped" width="100%">
                <tr>
                    <td class="buttonwrapper" align="center" colspan="4">
                        <button class="assetbtn" id="cmdSubmit">Submit</button>
                            &nbsp;
                        <button class="assetbtn" id="cmdcancel">Cancel</button>
                    </td>
                </tr>
            </table>
        </div>


        @* ---Back Button Start---- *@
        <div class="clear"></div>
        <div class="backrowdiv"><a asp-controller="Home" asp-action="Home" title="Go to Home">Back</a></div>

        <div class="clear"></div>
        @* ----Back Button End---- *@

    </div>
</div>


@section Scripts {

    <script src="~/app/iomcontract/js/closecontract.js" asp-append-version="true"></script>
}
