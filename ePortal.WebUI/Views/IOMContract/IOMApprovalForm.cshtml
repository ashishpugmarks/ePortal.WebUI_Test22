            </table>
            <table class="table table-bordered table-condensed table-striped" width="99%">
                <thead>
                    <tr class="HeaderStyle12">
                        <td colspan="4">
                            &nbsp; Approval History
                        </td>
                    </tr>
                </thead>
                <tr style="line-height: 25px;">
                    <td style="width: 100%; text-align: center;">
                        <table class="someCss tableGridView" style="width: 100%; margin: 1px 0px 1px 0px; border: solid 0px #FFD152;">
                            <tr>
                                <td>
                                    <b>&nbsp;SM :- Section Manager</b>
                                </td>
                                <td>
                                    <b>DH :- Department Head</b>
                                </td>
                                <td>
                                    <b>DIVH :- Division Head</b>
                                </td>
                                <td>
                                    <b>OH :- Operating Head</b>
                                </td>
                            </tr>
                        </table>


                        <table class="tableGridView" cellspacing="0" cellpadding="2" rules="all" border="1" id="grdApprovalDetails" style="width:100%;border-collapse:collapse;">
                            <thead>
                                <tr class="grdHeader" style="height:25px;">
                                    <th>Date</th>
                                    <th>Employee</th>
                                    <th>Status</th>
                                    <th>Remarks</th>
                                    <th><img src="~/images/icons/attachment.gif"></th>
                                </tr>
                            </thead>
                            @if (Model.grdApprovalDetails != null && Model.grdApprovalDetails.Any())
                            {
                                <tbody>
                                    @foreach (var item in Model.grdApprovalDetails)
                                    {
                                        <tr class="txtstyle" style="height:20px;">
                                            <td align="center" style="width:12%;">@item.ADDEDDATE</td>
                                            <td style="width:15%;">@item.ADDEDBY</td>
                                            <td style="width:15%;">@item.STATUSNAME</td>
                                            <td style="width:55%;">@item.REMARKS</td>
                                            <td style="width:3%;">
                                                @if (!string.IsNullOrWhiteSpace(item.ATTACHMENTPATH))
                                                {
                                                    <a class="linkagreement" data-attachmentpath="@item.ATTACHMENTPATH">
                                                        <img src="~/images/icon_document.gif" alt="Doc" width="15">
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            }
                            else
                            {
                                <tfoot>
                                    <tr>
                                        <td colspan="5" style="color:#274D14; background-color: #F5FFF0; font-family: Calibri">
                                            No Approval Found
                                        </td>
                                    </tr>
                                </tfoot>
                            }
                        </table>



                    </td>
                </tr>
            </table>


            <table class="table table-bordered table-condensed table-striped" width="99%">
                <thead>
                    <tr class="HeaderStyle12">
                        <td colspan="4">
                            &nbsp; IOM Approval Detail
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <tr style="line-height: 25px;">
                        <td width="25%" style="text-align: right; vertical-align: top;" class="font12">
                            Status :-<span class="mandatory">*</span>
                        </td>
                        <td width="75%" style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                            <div>
                                <input asp-for="rdoStatus" type="radio" value="1" /> Approve
                                <input asp-for="rdoStatus" type="radio" value="2" /> Reject
                                <input asp-for="rdoStatus" type="radio" value="3" /> Send back
                            </div>
                        </td>
                    </tr>

                    @if (Convert.ToBoolean(ViewBag.trbackdateremarkVisiable ?? true))
                    {
                        <tr id="trbackdateremark">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Back Date Remarks :-<span class="mandatory">*</span>
                            </td>
                            <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                                &nbsp;
                                @Html.TextAreaFor(
                                         model => model.txtbackdateremark,
                                         new
                                         {
                                             @class = "font12 onpaste",
                                             style = "width: 450px; height: 60px; border-color:#888888;",
                                             maxlength = "499"
                                         }
                                         )
                            </td>
                        </tr>

                    }
                    <tr>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Remarks :-<span class="mandatory">*</span>
                        </td>
                        <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                            &nbsp;

                            @Html.TextAreaFor(
                                     model => model.txt_Remarks,
                                     new
                                     {
                                         @class = "font12 onpaste",
                                         style = "width: 450px; height: 60px; border-color:#888888;",
                                         maxlength = "499"
                                     }
                                     )
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Approving Authority :-<span class="mandatory">*</span>
                        </td>
                        <td style="color: #6299c5; vertical-align: top; text-align: left;" colspan="3">

                            @if (Convert.ToBoolean(ViewBag.lbl_appauthVisiable ?? false))
                            {
                                <span id="lbl_appauth" class="swifttext" Style="width: 250px;
                                        margin-left: 4px!Important; background-color: #F6F8FA; color: Gray; padding: 0px 0px!Important;">@Model.lbl_appauth</span>
                            }
                            @if (Convert.ToBoolean(ViewBag.ddl_appauthVisiable ?? false))
                            {
                                @Html.DropDownListFor(
                                         model => model.ddl_appauth,
                                         Model.ddl_appauthList,
                                         new { style = "width: 250px; margin-left: 4px!Important; color: Gray; padding: 0px 0px!Important;", @class = "swifttext" }
                                         )
                            }


                          
                            <input type="hidden" id="hdempdesign" value="@ViewBag.encdesign" />
                            <input asp-for="hdauthcode" type="hidden" />
                            <input asp-for="hdauthemailid" type="hidden" />
                            <input asp-for="hdauthname" type="hidden" />
                            <input asp-for="hdiomid" type="hidden" />
                            <input asp-for="hdbackdate" type="hidden" />
                            <input asp-for="hdauthlevel" type="hidden" />
                            <input asp-for="hddelaydate" type="hidden" />

                           
                        </td>
                    </tr>

                    @if (Convert.ToBoolean(ViewBag.tr_ackVisiable ?? true))
                    {
                        <tr id="tr_ack"  style="background-color:#eba134">
                            <td style="text-align: right; vertical-align: top; font:100; font-size:14px">
                                <input asp-for="chkTerms" type="checkbox" />
                            </td>
                            <td style="color: black; vertical-align: top; text-align: left; font:100; font-size:14px;">
                                &nbsp;"I do hereby acknowledge the delayed request and approving it with my responsibility".
                            </td>

                        </tr>
                    }

                  
            </table>
            <table class="table table-bordered table-condensed table-striped" width="99%">
                <tr>
                    <td class="buttonwrapper" align="center" colspan="4">
                        <button class="assetbtn" id="cmdSubmit">Submit</button>
                            &nbsp;
                        <button class="assetbtn" id="cmdcancel">Cancel</button>
                    </td>
                </tr>
            </table>

        </div>




        @* ---Back Button Start---- *@
        <div class="clear"></div>
        <div class="backrowdiv"><a asp-controller="Home" asp-action="Home" title="Go to Home">Back</a></div>

        <div class="clear"></div>
        @* ----Back Button End---- *@

    </div>
</div>


