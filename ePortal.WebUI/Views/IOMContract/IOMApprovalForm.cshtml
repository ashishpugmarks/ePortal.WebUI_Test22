@model ePortal.ViewModels.APPX.IOM.IOMApprovalFormViewModel
@{
    ViewBag.Title = "Employee Portal - Contract Management :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/css/newasset.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/NewMasterStyleSheet.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/iomcontract/css/iomapprovalform.css" rel="stylesheet" asp-append-version="true" />
}

<div class="row">
    @* Heading Start *@
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">Interoffice Memorandum Approval Form</div>
    </div>

    <div class="body-content" style="overflow-x:hidden; padding: 0px !important;">

        <div id="errorpanel" class="roundedPanel" style="background-color:#ED243B;width:100%; display: none;">
            <div style="padding-left: 6px;">
                <div id="ctl00_InnerContent_pnlError" class="roundedPanel" style="background-color:#FFEAEA;width:99%;">
                    <table cellpadding="0" cellspacing="0" border="0" width="100%">
                        <tbody>
                            <tr id="tr_ErrorRow">
                                <td style="padding: 2px; padding-left: 5px; color: Black;">
                                    <input type="text" id="txtup" style="width: 0px; border:0px;" />
                                    <span id="status" style="font-size: 13px; font-family: Trebuchet MS"></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* Heading End *@

        <div class="headmain">
            <table class="table table-bordered table-condensed table-striped" width="99%">
                <thead>
                    <tr class="HeaderStyle12">
                        <td colspan="4">
                            &nbsp;Requestor Detail's
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <tr style="line-height: 25px;">
                        <td width="22%" style="text-align: right; vertical-align: top;" class="style1">
                            &nbsp;Name :-
                        </td>
                        <td width="28%" class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss" id="lbl_assname">@Model.lbl_assname</span>
                            <input asp-for="hdreqname" type="hidden" />
                            <input asp-for="hdreqcode" type="hidden" />
                            <input asp-for="hdreqemail" type="hidden" />
                        </td>
                        <td width="20%" style="text-align: right; vertical-align: top;" class="style1">
                            &nbsp;Site :-
                        </td>
                        <td width="30%" class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss" id="lbl_site">@Model.lbl_site</span>
                        </td>
                    </tr>
                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="style1">
                            &nbsp;Operation :-
                        </td>
                        <td class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss">@Html.DisplayFor(model => model.lbl_op)</span>
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="style1">
                            &nbsp;Division :-
                        </td>
                        <td class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss">@Html.DisplayFor(model => model.lbl_div)</span>
                        </td>
                    </tr>
                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Department :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss">@Html.DisplayFor(model => model.lbl_dept)</span>
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Section :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss">@Html.DisplayFor(model => model.lbl_sec)</span>
                        </td>
                    </tr>
                </tbody>
            </table>


            @if(Convert.ToBoolean(ViewBag.tblprevcontractVisiable ?? true))
            {
                <table id="tblprevcontract" class="table table-bordered table-condensed table-striped" width="99%">
                    <thead>
                        <tr class="HeaderStyle12">
                            <td colspan="4">
                                &nbsp; Previous Contract Detail's
                            </td>
                        </tr>
                    </thead>
                    <tr style="line-height: 25px;">
                        <td width="20%" style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Agreement ID :-
                        </td>
                        <td width="30%" class="style1" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss" id="lblagreementid">@Model.lblagreementid</span>
                        </td>
                        <td width="20%" style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Agreement Period :-
                        </td>
                        <td width="30%" class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss" id="lblprevagrperiod">@Model.lblprevagrperiod</span>
                        </td>
                    </tr>
                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Approval Note :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                        colspan="3">
                            &nbsp;
                            <a id="prevappnotelink" data-url="@Model.prevappnotelink">@Model.prevappnotelinkText</a>
                        </td>
                    </tr>
                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Final Document :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                        colspan="3">
                            &nbsp;
                            <a id="prevfinaldoclink" data-url="@Model.prevfinaldoclink">@Model.prevfinaldoclinkText</a>
                        </td>
                    </tr>
                </table>
            }
           
            
            @if (Convert.ToBoolean(ViewBag.tblPrevContHistoryVisiable ?? true))
            {
                <table id="tblPrevContHistory" class="table table-bordered table-condensed table-striped" width="100%">
                    <thead>
                        <tr id="pch"  class="HeaderStyle12">
                            <td colspan="4">
                                &nbsp; Previous Contract History
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="4" class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                <table class="grd tableGridView" id="grdPrivContractHistory" cellspacing="0" cellpadding="2" rules="all" border="1" style="width:100%;border-collapse:collapse;">
                                    <thead>
                                        <tr class="grdHeader" style="height:25px;">
                                            <th></th>
                                            <th>Agreement</th>
                                            <th>Vendor Name</th>
                                            <th>Effective Date</th>
                                            <th>Expiry date</th>
                                            <th>Status</th>
                                            <th>Requested By</th>
                                            <th>FDOC</th>
                                        </tr>
                                    </thead>
                                    @if (Model.grdPrivContractHistory != null && Model.grdPrivContractHistory.Any())
                                    {
                                        <tbody>
                                            @foreach (var item in Model.grdPrivContractHistory)
                                            {
                                                <tr class="txtstyle" style="height:20px;" data-iomid="@item.IOMID">
                                                    <td>
                                                        <a class="view_iom_details">
                                                            <img src="~/images/icon_ticketbullet.gif" style="padding-right: 2px; vertical-align: middle">
                                                        </a>
                                                    </td>
                                                    <td style="width:12%;">@item.AGREEMENTTYPEDESC</td>
                                                    <td style="width:15%;">@item.VENDORNAME</td>
                                                    <td style="width:15%;">@item.EFFECTIVEDATE</td>
                                                    <td style="width:55%;">@item.EXPIRYDATE</td>
                                                    <td style="width:3%;">
                                                        @if (item.processstatusid.ToString() == "24")
                                                        {
                                                            <span id="lbl_completed" style="color: Green;">@item.STATUSNAME</span>
                                                        }
                                                        else
                                                        {
                                                            <span id="lbl_pending" style="color: Red;">@item.STATUSNAME</span>
                                                        }
                                                    </td>
                                                    <td>@item.REQUESTDBY</td>
                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(item.finaldoc))
                                                        {
                                                            <a class="finaldoclink" data-finaldoc="@item.finaldoc">
                                                                <img src="~/images/attachment.gif" style="padding-right: 2px; vertical-align: middle" alt="Final Document">
                                                            </a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    }

                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            }


            
            <table class="table table-bordered table-condensed table-striped" width="99%">
                <thead>
                    <tr class="HeaderStyle12">
                        <td colspan="4">
                            &nbsp; Interoffice Memorandum Detail's
