@model ePortal.ViewModels.APPX.IOM.ViewAgreementViewModel
@{
    ViewBag.Title = "";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";
}
@section Styles {

    <link href="~/css/newmasterstylesheet.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/iomcontract/css/viewagreement.css" rel="stylesheet" asp-append-version="true" />
}

<div class="row">


    <div class="body-content" style="overflow-x:hidden; padding: 0px !important;">
        <div class="maincontainer" id="Div1">
            <div style="border: 0px solid #6393DF; margin-bottom: 20px; clear: both;">
                <div class="HeaderStyle12">
                    Contract Details
                </div>
                <table class="tableGridView" width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tbody>
                        <tr class="row1" style="line-height: 25px;">
                            <td width="35%" style="text-align: right; vertical-align: top;" class="font12">
                                From:-
                            </td>
                            <td width="65%" style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                                &nbsp;
                                <span>@Model.lblfrom</span>
                            </td>
                        </tr>
                        <tr class="row2" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="style1">
                                To:-
                            </td>
                            <td style="color: #6299c5; vertical-align: top; text-align: left;" class="style1">
                                &nbsp;
                                <span>@Model.lblto</span>
                            </td>
                        </tr>
                        <tr class="row1" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Contact Type:-
                            </td>
                            <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                                &nbsp;
                                <span>@Model.lblcontracttype</span>
                            </td>
                        </tr>
                        <tr class="row2" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Expiry Date:-
                            </td>
                            <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                                &nbsp;
                                <span>@Model.lblexpdate</span>
                            </td>
                        </tr>
                        <tr class="row1" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Term:-
                            </td>
                            <td class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                <span>@Model.lblterm</span>
                            </td>
                        </tr>
                        <tr class="row2" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Vendor Name:-
                            </td>
                            <td class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                <span>@Model.lblvendorname</span>
                            </td>
                        </tr>
                        <tr class="row1" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="style1">
                                Manner of Payment:-
                            </td>
                            <td class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                <span>@Model.lblmannerofpayment</span>
                            </td>
                        </tr>


                        @if (Convert.ToBoolean(ViewBag.trappnoteVisible ?? true))
                        {
                            <tr id="trappnote" class="row2" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    Approval Note:-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;
                                    <a id="appnotelink" data-url="@Model.appnotelink">@Model.appnotelinkText</a>
                                </td>
                            </tr>
                        }


                        @if (Convert.ToBoolean(ViewBag.trfinaldocVisible ?? true))
                        {
                            <tr id="trfinaldoc" class="row1" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    Final Document:-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;
                                    <a id="finaldoclink" data-url="@Model.finaldoclink">@Model.finaldoclinkText</a>
                                </td>
                            </tr>
                        }

                        @if (Convert.ToBoolean(ViewBag.trantibriberyVisible ?? true))
                        {
                            <tr id="trantibribery" class="row2" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    Anti Bribery Policy:-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;
                                    <a id="antibriberylink" data-url="@Model.antibriberylink">@Model.antibriberylinkText</a>
                                </td>
                            </tr>
                        }
                        @if (Convert.ToBoolean(ViewBag.trndadocumentVisible ?? true))
                        {
                            <tr id="trndadocument" class="row1" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    Non Disclosure Agreement:-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;
                                    <a id="ndadocumentlink" data-url="@Model.ndadocumentlink">@Model.ndadocumentlinkText</a>
                                </td>
                            </tr>
                        }
                       
                        <tr class="row2" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                PurposPurpose:-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                <span>@Model.lblpurpose</span>
                            </td>
                        </tr>

                        @if (Convert.ToBoolean(ViewBag.trmstagrVisible ?? false))
                        {
                            <tr id="trmstagr" class="row1" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    Master Agreement:-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;
                                    <span>@Model.lblmstagr</span>
                                </td>
                            </tr>
                        }
                       
                    </tbody>
                </table>
            </div>

        </div>
       
    </div>
</div>


@section Scripts {

    <script src="~/app/iomcontract/js/viewagreement.js" asp-append-version="true"></script>

}
