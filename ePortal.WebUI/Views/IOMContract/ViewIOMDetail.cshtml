@model ePortal.ViewModels.APPX.IOM.ViewIOMDetail
@{
    ViewBag.Title = "IOMViewDetail";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";
}
@section Styles {

    <link href="~/css/newmasterstylesheet.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/iomcontract/css/viewiomdetail.css" rel="stylesheet" asp-append-version="true" />
}

<div class="row">
    

    <div class="body-content" style="overflow-x:hidden; padding: 0px !important;">
        <div class="maincontainer" id="Div1">
            <div style="border: 0px solid #6393DF; margin-bottom: 20px; clear: both;">
                <div class="HeaderStyle12">
                    Requestor Details
                </div>
                <table class="tableGridView" width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tbody>
                        <tr class="row1" style="line-height: 25px;">
                            <td width="22%" style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Name :-
                            </td>
                            <td width="28%" class="style1" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                <span class="lblcss" id="lbl_assname">@Model.lbl_assname</span>
                            </td>
                            <td width="20%" style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Site :-
                            </td>
                            <td width="30%" class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                <span class="lblcss" id="lbl_site">@Model.lbl_site</span>
                            </td>
                        </tr>
                        <tr class="row2" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Operation :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                <span class="lblcss" id="lbl_op">@Model.lbl_op</span>
                            </td>
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Division :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                <span class="lblcss" id="lbl_div">@Model.lbl_div</span>
                            </td>
                        </tr>
                        <tr class="row1" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Department :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                <span class="lblcss" id="lbl_dept">@Model.lbl_dept</span>
                            </td>
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Section :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                <span class="lblcss" id="lbl_sec">@Model.lbl_sec</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <br />
                @if (Convert.ToBoolean(ViewBag.Prevcontractdiv ?? true))
                {
                    <div id="Prevcontractdiv">
                        <div class="HeaderStyle12">
                            Previous Contract Detail
                        </div>
                        <table class="tableGridView" width="100%" border="0" cellspacing="0" cellpadding="0">
                            <tbody>
                                <tr class="row1" style="line-height: 25px;">
                                    <td width="20%" style="text-align: right; vertical-align: top;" class="font12">
                                        &nbsp;Agreement ID :-
                                    </td>
                                    <td width="30%" class="style1" style="color: #6299c5; vertical-align: top; text-align: left;">
                                        &nbsp;
                                        <span class="lblcss" id="lblagreementid">@Model.lblagreementid</span>
                                    </td>
                                    <td width="20%" style="text-align: right; vertical-align: top;" class="font12">
                                        &nbsp;Agreement Period :-
                                    </td>
                                    <td width="30%" class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                                        &nbsp;
                                        <span class="lblcss" id="lblprevagrperiod">@Model.lblprevagrperiod</span>
                                    </td>
                                </tr>
                                <tr class="row2" style="line-height: 25px;">
                                    <td style="text-align: right; vertical-align: top;" class="font12">
                                        &nbsp;Approval Note :-
                                    </td>
                                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                                        colspan="3">
                                        &nbsp;
                                        <a id="prevappnotelink" data-url="@Model.prevappnotelink">@Model.prevappnotelinkText</a>
                                    </td>
                                </tr>
                                <tr class="row1" style="line-height: 25px;">
                                    <td style="text-align: right; vertical-align: top;" class="font12">
                                        &nbsp;Final Document :-
                                    </td>
                                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                                        colspan="3">
                                        &nbsp;
                                        <a id="prevfinaldoclink" data-url="@Model.prevfinaldoclink">@Model.prevfinaldoclinkText</a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <br />
                    </div>
                }
                
                <div class="HeaderStyle12">
                    Interoffice Memorandum Details
                </div>
                <table class="tableGridView" width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tbody>
                        <tr class="row2" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Contract No. :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                                colspan="3">
                                &nbsp;
                                <span class="lblcss" id="lblUNIQUEID">@Model.lblUNIQUEID</span>
                            </td>
                        </tr>
                        <tr class="row1" style="line-height: 25px;">
                            <td width="22%" style="text-align: right; vertical-align: top;" class="font12">
                                From :-
                            </td>
                            <td width="28%" style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                                &nbsp;
                                <span class="lblcss" id="lblfrom">@Model.lblfrom</span>
                            </td>
                            <td width="20%" style="text-align: right; vertical-align: top;" class="font12">
                                To :-
                            </td>
                            <td width="30%" style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                                &nbsp;
                                <span class="lblcss" id="lblto">@Model.lblto</span>
                            </td>
                        </tr>
                        <tr class="row2" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Agreement Type :-
                            </td>
                            <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                                &nbsp;
                                <span class="lblcss" id="lblagreementtype">@Model.lblagreementtype</span>
                            </td>
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Contact Type :-
                            </td>
                            <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                                &nbsp;
                                <span class="lblcss" id="lblcontracttype">@Model.lblcontracttype</span>
                            </td>
                        </tr>
                        <tr class="row1" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Effective Date:-
                            </td>
                            <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                                &nbsp;
                                <span class="lblcss" id="lbleffdate">@Model.lbleffdate</span>
                            </td>
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Expiry Date :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                <span class="lblcss" id="lblexpdate">@Model.lblexpdate</span>
                            </td>
                        </tr>
                        <tr class="row2" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Term :-
                            </td>
                            <td class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                <span class="lblcss" id="lblterm">@Model.lblterm</span>
                            </td>
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                &nbsp;Vendor Name :-
                            </td>
                            <td class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                                &nbsp;
                                <span class="lblcss" id="lblvendorname">@Model.lblvendorname</span>
                            </td>
                        </tr>
                        <tr class="row1" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Manner of Payment :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                                colspan="3">
                                &nbsp;
                                <span class="lblcss" id="lblmannerofpayment">@Model.lblmannerofpayment</span>
                            </td>
                        </tr>
                        @if (Convert.ToBoolean(ViewBag.trrefdoc ?? true))
                        {
                            <tr id="trrefdoc"  class="row2" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    Approval Note :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                                    colspan="3">
                                    &nbsp;
                                    <a id="agreementlink" data-url="@Model.agreementlink">@Model.agreementlinkText</a>
                                </td>
                            </tr>
                        }

                       @if (Convert.ToBoolean(ViewBag.trantibribery ?? true))
                       {
                            <tr id="trantibribery" class="row1" style="line-height: 25px;">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    Anti Bribery Policy :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                                    colspan="3">
                                    &nbsp;
                                    <a id="antibriberylink" data-url="@Model.antibriberylink">@Model.antibriberylinkText</a>
                                </td>
                            </tr>
                       }
                        
                        
                        @* <tr id="trndadocument" runat="server" class="row2" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Non Disclosure Agreement:-
                            </td>
                            <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                                colspan="3">
                                &nbsp;<a id="ndadocumentlink" runat="server" target="_blank" onclick="open(this.href, this.target, 'width=800, height=550, top=90, left=200'); return false;"></a>
                            </td>
                        </tr> *@
                        <tr class="row1" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Consideration :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; line-height: 13px!Important; padding: 4px!Important;"
                                colspan="3">
                                &nbsp;
                                <span class="lblcss" id="Iblconsiderable">@Model.Iblconsiderable</span>
                            </td>
                        </tr>

                        <tr class="row1" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Purpose :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; line-height: 13px!Important; padding: 4px!Important;"
                                colspan="3">
                                &nbsp;
                                <span class="lblcss" id="lblpurpose">@Model.lblpurpose</span>
                            </td>
                        </tr>
                        <tr class="row2" style="line-height: 25px;">
                            <td style="text-align: right; vertical-align: top;" class="font12">
                                Remarks :-
                            </td>
                            <td class="smalltext" style="color: #6299c5; line-height: 13px!Important; padding: 4px!Important;"
                                colspan="3">
                                &nbsp;
                                <span class="lblcss" id="lblremarks">@Model.lblremarks</span>
                            </td>
                        </tr>
                        @if(Convert.ToBoolean(ViewBag.trmstagr ?? false))
                        {
                            <tr id="trmstagr" class="row1" style="line-height: 25px;" >
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    Master Agreement :-
                                </td>
                                <td class="smalltext" style="color: #6299c5;"
                                    colspan="3">
                                    &nbsp;
                                    <span class="lblcss" id="lblmstagr">@Model.lblmstagr</span>
                                </td>
                            </tr>
                        }
                        @if (Convert.ToBoolean(ViewBag.trt1 ?? false))
                        {
                            <tr style="line-height: 25px;" id="trt1" class="row2">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    &nbsp;Ecode :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    <span class="lblcss" id="lblcontractcode">@Model.lblcontractcode</span>
                                </td>
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    &nbsp;Name :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    <span class="lblcss" id="lblcontractname">@Model.lblcontractname</span>
                                </td>
                            </tr>
                        }

                        @if (Convert.ToBoolean(ViewBag.trt2 ?? false))
                        {
                            <tr style="line-height: 25px;" class="row1" id="trt2">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    &nbsp;Surety Amount :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                                    colspan="3">
                                    <span class="lblcss" id="lblsuretyamount">@Model.lblsuretyamount</span>
                                </td>
                            </tr>
                        }

                        @if (Convert.ToBoolean(ViewBag.trt3 ?? false))
                        {
                            <tr style="line-height: 25px;" class="row2" id="trt3">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    &nbsp;Name of Surety :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                                    colspan="3">
                                    <span class="lblcss" id="lblnameofsurety">@Model.lblnameofsurety</span>
                                </td>
                            </tr>
                        }

                        @if (Convert.ToBoolean(ViewBag.trt4 ?? false))
                        {
                            <tr style="line-height: 25px;" class="row1" id="trt4">
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    &nbsp;From date :-

                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;
                                    <span class="lblcss" id="lblretureddateF">@Model.lblretureddateF</span>
                                </td>
                                <td style="text-align: right; vertical-align: top;" class="font12">
                                    &nbsp;To date :-
                                </td>
                                <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                                    &nbsp;
                                    <span class="lblcss" id="lblretureddateT">@Model.lblretureddateT</span>
                                </td>

                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            @* IOM History Detail *@
            <table class="tableGridView" style="border-color: #CCDCE0; border-width: 1px; border-style: solid; margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;"
                   cellpadding="0"
                   cellspacing="0" width="100%">
                <thead>
                    <tr>
                        <td class="HeaderStyle12" style="padding: 0px 0px 0px 0px;" colspan="2">
                            &nbsp;Process History
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="2">
                            <table class="someCss" style="width: 100%; margin: 0px 0px 0px 0px; border: solid 1px #FFD152;">
                                <tr>
                                    <td style="border: none;">
                                        <b>&nbsp;SM :- Section Manager</b>
                                    </td>
                                    <td style="border: none;">
                                        <b>DH :- Department Head</b>
                                    </td>
                                    <td style="border: none;">
                                        <b>DIVH :- Division Head</b>
                                    </td>
                                    <td style="border: none;">
                                        <b>OH :- Operating Head</b>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div style="width: 100%; padding: 5px;">
                                <table class="tableGridView" cellspacing="0" cellpadding="2" rules="all" border="1" id="grdApprovalDetails" style="width:100%;border-collapse:collapse;">
                                       <thead>
                                            <tr class="grdHeader" style="height:25px;">
                                                <th style="text-align: center">Date</th>
                                                <th style="text-align: center">Employee</th>
                                                <th style="text-align: center">Status</th>
                                                <th style="text-align: center">Remarks</th>
                                                <th style="text-align: center"><img src="~/images/icons/attachment.gif"></th>
                                            </tr>
                                       </thead>
                                       @if (Model.grdApprovalDetails != null && Model.grdApprovalDetails.Any())
                                       {
                                           <tbody>
                                                @foreach (var item in Model.grdApprovalDetails)
                                                {
                                                <tr class="txtstyle" style="height:20px;">
                                                    <td align="center" style="width:12%;">@item.ADDEDDATE</td>
                                                    <td style="width:15%;">@item.ADDEDBY</td>
                                                    <td style="width:15%;">@item.STATUSNAME</td>
                                                    <td style="width:55%;">@item.REMARKS</td>
                                                    <td style="width:3%;">
                                                        @if (!string.IsNullOrWhiteSpace(item.ATTACHMENTPATH))
                                                        {
                                                            <a class="linkagreement" data-attachmentpath="@item.ATTACHMENTPATH">
                                                                <img src="~/images/icon_document.gif" alt="Doc" width="15">
                                                            </a>
                                                        }

                                                    </td>
                                                </tr>
                                                }
                                           </tbody>
                                       }
                                       else
                                       {
                                            <tfoot>
                                                <tr>
                                                    <td colspan="5" style="color:#274D14; background-color: #F5FFF0; font-family: Calibri">
                                                        No Approval Found
                                                    </td>
                                                </tr>
                                            </tfoot>
                                       }
                                    </table>
                            </div>
                            
                        </td>
                    </tr>
                </tbody>
            </table>
            @* Approval History Detail *@
            <table class="tableGridView" style="border-color: #CCDCE0; border-width: 1px; border-style: solid; margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;"
                   cellpadding="0"
                   cellspacing="0" width="100%">
                <thead>
                    <tr>
                        <td class="HeaderStyle12" style="padding: 0px 0px 0px 0px;" colspan="2">
                            &nbsp;Communication History
                        </td>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td>
                            <div style="width: 100%; padding: 5px;">
                                @if (Model.grdCommunicationHistory != null && Model.grdCommunicationHistory.Any())
                                {
                                  <table class="grdCommunicationHistory" cellspacing="0" cellpadding="2" rules="all" border="1" id="grdCommunicationHistory" style="width:100%;border-collapse:collapse;">
                                    <thead>
                                        <tr class="grdHeader" style="height:25px;">
                                            <th style="text-align: center">Date</th>
                                            <th style="text-align: center">Employee</th>
                                            <th style="text-align: center">User Type</th>
                                            <th style="text-align: center">Remarks</th>
                                            <th style="text-align: center"><img src="~/images/icons/attachment.gif"></th>
                                        </tr>
                                    </thead>
                                    @if (Model.grdCommunicationHistory != null && Model.grdCommunicationHistory.Any())
                                    {
                                        <tbody>
                                            @foreach (var item in Model.grdCommunicationHistory)
                                            {
                                                <tr class="txtstyle" style="height:20px;">
                                                    <td align="center" style="width:12%;">@item.ADDEDDATE</td>
                                                    <td style="width:15%;">@item.ADDEDBY</td>
                                                    <td style="width:15%;">@item.USERTYPE</td>
                                                    <td style="width:55%;">@item.REMARKS</td>
                                                    <td style="width:3%;">
                                                        @if (!string.IsNullOrWhiteSpace(item.ATTACHMENT))
                                                        {
                                                            <a class="linkagreement" data-attachmentpath="@item.ATTACHMENT">
                                                                <img src="~/images/icon_document.gif" alt="Doc" width="15">
                                                            </a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    }
                                    else
                                    {
                                        <tfoot>
                                            <tr>
                                                <td colspan="5" style="color:#274D14; background-color: #F5FFF0; font-family: Calibri">
                                                    <div style="border: 1px solid #C0C0C0; width: 100%; color: Red; font-weight: bold;">
                                                        No Approval Found
                                                    </div>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    }
                                </table>
                                }
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
       </div>
       
    </div>
</div>


@section Scripts {

    <script src="~/app/iomcontract/js/viewiomdetail.js" asp-append-version="true"></script>

}
