@using System.Net
@using ePortal.Shared

@model IEnumerable<ePortal.ViewModels.APPX.IOM.ManageContractViewModel>
@{
    ViewBag.Title = "Employee Portal - Contract Management :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/css/newmasterstylesheet.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/newasset.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/iomcontract/css/managecontract.css" rel="stylesheet" asp-append-version="true" />
}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">Manage Contract Requests</div>
    </div>

    <div class="body-content" style="overflow-x:hidden; padding: 0px !important;">


        <div class="headmain">
            <table cellspacing="0" cellpadding="0" class="tableView" width="99%">
                <tbody>
                    <tr>
                        <td>
                            <table cellpadding="0" cellspacing="0" style="background-color: Transparent; border: 10px solid #C3DDFA;"
                            width="100%">
                                <tbody>
                                    <tr>
                                        <td style="width: 100%; text-align: center;">
                                            <div id="Panel2top" class="roundedPanel" style="background-color:#F5F3F0; height:25px; width:99.8%; text-align:left;">
                                                <div style="float: left; width: 350px; margin-top: 5px;">
                                                    &nbsp;&nbsp;<span id="Label2" style="color:#A17832;">Manage Contract</span>
                                                </div>
                                                <div style="float: right; width: 84px; margin-top: 5px;">
                                                    <a id="history">
                                                        <img id="Img1" src="~/images/mimeico_script.gif" style="padding-right: 2px; float: left; vertical-align: middle" alt="History" />
                                                        History
                                                    </a>
                                                </div>
                                            </div>
                                            @* 
                                            <asp:Panel BackColor="#F5F3F0" ID="Panel2top" runat="server" Height="25px" Width="99.8%"
                                                       CssClass="roundedPanel" HorizontalAlign="Left">
                                                <div style="float: left; width: 350px; margin-top: 5px;">
                                                    &nbsp;&nbsp;<asp:Label ID="Label2" Text="Manage Contract" runat="server" ForeColor="#A17832"></asp:Label>
                                                </div>
                                                <div style="float: right; width: 84px; margin-top: 5px;">
                                                    <asp:LinkButton ID="LINKBTNHISTORY" runat="server" OnClick="LINKBTNHISTORY_CLICK">
                                                        <img id="Img1" style="padding-right: 2px; float: left; vertical-align: middle" src="../../assets/images/mimeico_script.gif"
                                                             runat="server" alt="History" />
                                                        History
                                                    </asp:LinkButton>
                                                </div>
                                            </asp:Panel> *@
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width: 100%;">
                                            <table class="someCss" style="width: 100%; margin: 0px 0px 0px 0px; border: solid 1px #FFD152; text-align: center;">
                                                <tbody>
                                                    <tr>
                                                        <td>
                                                            <b>&nbsp;SM :- Section Manager</b>
                                                        </td>
                                                        <td>
                                                            <b>DH :- Department Head</b>
                                                        </td>
                                                        <td>
                                                            <b>DIVH :- Division Head</b>
                                                        </td>
                                                        <td>
                                                            <b>OH :- Operating Head</b>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>

                                            <div>
                                                <table id="grdiomrequest" class="border" cellspacing="0" cellpadding="2" border="1" style="width:100%;border-collapse:collapse;">
                                                    <thead>
                                                        <tr class="grdHeader" style="height:25px;">
                                                            <th>&nbsp;</th>
                                                            <th style="width:60px;">Agt Type</th>
                                                            <th>Contract Type</th>
                                                            <th style="width:100px;">Effective Date</th>
                                                            <th style="width:100px;">Expiry date</th>
                                                            <th>Vendor Name</th>
                                                            <th style="width:120px;">Status</th>
                                                            <th>&nbsp;</th>
                                                            <th style="height:25px;">Comm.</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (Model != null && Model.Any())
                                                        {
                                                            foreach(var item in Model)
                                                            {
                                                                <tr class="grdrow" style="height:20px;" data-iomid="@WebUtility.UrlEncode(Encryption.Encrypt(item.IOMID.ToString()))">
                                                                    <td align="center">
                                                                        <a class="view_iom_details" data-iomid="@item.IOMID">
                                                                            <img src="~/images/icon_ticketbullet.gif" style="padding-right: 2px; vertical-align: middle" alt="View IOM Detail" />
                                                                        </a>
                                                                    </td>
                                                                    <td>@item.AGREEMENTTYPEDESC</td>
                                                                    <td>@item.CONTRACTTYPEDESC</td>
                                                                    <td>@item.EFFECTIVEDATE</td>
                                                                    <td>@item.EXPIRYDATE</td>
                                                                    <td>@item.VENDORNAME</td>
                                                                    <td style="color:Red;">@item.STATUSNAME</td>
                                                                    <td align="left">

                                                                        @if (Convert.ToString(item.processstatusid) == "1")
                                                                        {
                                                                            <a class="linkedit">
                                                                                <img src="~/images/icon_edit.gif" alt='Edit interoffice memo' />
                                                                            </a>
                                                                        }

                                                                        @if (Convert.ToString(item.processstatusid) == "21")
                                                                        {
                                                                            <a class="LINKUSERACK">
                                                                                <img src="~/images/assigned_tickets.gif" alt='User Acknowledgement' />
                                                                            </a>
                                                                        }


                                                                        @if (Convert.ToString(item.processstatusid) == "23")
                                                                        {
                                                                            <a class="LINKFINALDOC">
                                                                                <img src="~/images/icon_topic.gif" alt='Final Documentation' />
                                                                            </a>
                                                                        }

                                                                    </td>
                                                                    <td align="left">
                                                                        @if (item.USERTYPE == "admin")
                                                                        {
                                                                            <a class="linkCommEdit" title="Edit Communication">
                                                                                <img src="~/images/icon_edit.gif" alt='Edit' />
                                                                            </a>
                                                                        }
                                                                        @if (item.USERTYPE == "user")
                                                                        {

                                                                            <a class="LinkCommView" title="View Communication">
                                                                                <img src="~/images/icon_view.gif" alt='View' />
                                                                            </a>
                                                                        }
                                                                      

                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <tr>
                                                                <td colspan="9" class="text-danger text-center font-weight-bold">
                                                                    No Request Found
                                                                </td>
                                                            </tr>
                                                        }

                                                        
                                                    </tbody>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
        @* ---Back Button Start---- *@
        <div class="clear"></div>
        <div class="backrowdiv"><a asp-controller="Home" asp-action="Home" title="Go to Home">Back</a></div>

        <div class="clear"></div>
        @* ----Back Button End---- *@
       
    </div>
</div>

<div id="ajaxLoader"></div>

@section Scripts {
    <script src="~/app/iomcontract/js/managecontract.js" asp-append-version="true"></script>
}
