@model ePortal.ViewModels.APPX.IOM.IOMRequestFormViewModel
@{
    ViewBag.Title = "Employee Portal - Contract Management :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/css/newasset.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/iomcontract/css/iomrequestform.css" rel="stylesheet" asp-append-version="true" />
}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">Interoffice Memorandum</div>
    </div>

    <div class="body-content" style="overflow-x:hidden; padding: 0px !important;">

        <div id="errorpanel" class="roundedPanel" style="background-color:#ED243B;width:100%; display: none;">
            <div style="padding-left: 6px;">
                <div id="ctl00_InnerContent_pnlError" class="roundedPanel" style="background-color:#FFEAEA;width:99%;">
                    <table cellpadding="0" cellspacing="0" border="0" width="100%">
                        <tbody>
                            <tr id="tr_ErrorRow">
                                <td style="padding: 2px; padding-left: 5px; color: Black;">
                                    <input type="text" id="txtup" style="width: 0px; border:0px;" />
                                    <span id="status" style="font-size: 13px; font-family: Trebuchet MS"></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="causedoc">
            Caution: Do not provide incomplete information or missing link for submitting request to legal for preparation of contract.
            You are working on company's secure and protected data. Please follow instructions before making a request for preparation / renewal
            of contract.
        </div>

        <div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
            <table class="table table-bordered table-condensed table-striped" style="width: 100%;">
                <thead>
                    <tr class="HeaderStyle12">
                        <td colspan="4">
                            &nbsp; Interoffice Memorandum Detail's
                        </td>
                    </tr>
                </thead>
              
                <tbody>
                    <tr id="tr1" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;From :-&nbsp;&nbsp;
                        </td>
                        <td colspan="3" class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                           
                            @Html.DropDownListFor(
                                     model => model.ddlfrom,
                                     Model.ddlFromList,
                                     ViewBag.ddlfromEnable == true
                                     ? new { @class = "swiftselect", style = "width:220px;"}
                                     : new { @class = "swiftselect", style = "width:220px;", disabled = "disabled" }
                                     )

                           @*   <a class="tooltip" href="#">
                                <span>
                                    This memo should be submitted at least 15 days prior
                                    to the date from which an agreement will have to take effect or the date of expiry
                                    of an existing agreement, as the case may be.
                                </span>
                            </a> *@
                        </td>
                    </tr>
                    <tr id="tr3" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;To :-&nbsp;&nbsp;
                        </td>
                        <td colspan="3" class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                           
                            @Html.TextBoxFor(
                                     model => model.txtTo,
                                     new
                                     {
                                         style = "width:220px; height:25px; border-color:#888888;",
                                         @readonly = "readonly",
                                         disabled = "disabled",
                                     }
                                     )

                        </td>
                    </tr>
                    <tr id="tr2" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Agreement Type :-<span class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            @Html.DropDownListFor(
                                     model => model.ddlagreement,
                                     Model.ddlagreementList,
                                     new { @class = "swiftselect", style = "width:220px;" }
                                     )
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            Contract Type :-<span class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            @Html.DropDownListFor(
                                     model => model.ddlcontract,
                                     Model.ddlcontractList,
                                     new { @class = "swiftselect", style = "width:220px;"}
                                     )
                        </td>
                    </tr>
                    <tr style="line-height: 25px; display: none;" id="trt1">

                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Ecode :-<span class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            @Html.TextBoxFor(
                                     model => model.txtcontactecode,
                                     new
                                     {
                                         @class = "font12 onpaste numeric",
                                         style = "margin: 3px; width: 150px; border-color:#888888;"
                                     }
                                     )

                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Name :-<span class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            <span id="lblcontactname"></span>
                            @Html.HiddenFor(model => model.HDFTRINING)

                        </td>

                    </tr>
                    <tr style="line-height: 25px; display: none;" id="trt2">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Surety Amount :-<span class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                            colspan="3">
                            @Html.TextBoxFor(
                                     model => model.txtsuretyamount,
                                     new
                                     {
                                         @class = "font12 numeric",
                                         style = "margin: 3px; width: 150px; border-color:#888888;"
                                     }
                                     )
                        </td>
                    </tr>
                    <tr style="line-height: 25px; display: none;" id="trt3">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Name of Surety :-<span class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                            colspan="3">
                            @Html.TextAreaFor(
                                     model => model.txtnamesurety,
                                     new
                                     {
                                         @class = "font12 onpaste",
                                         style = "margin: 3px; width: 500px; height: 50px; border-color:#888888;",
                                         maxlength = "499"
                                     }
                                     )
                        </td>
                    </tr>
                    <tr style="line-height: 25px; display: none;" id="trt4">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;From date :-<span class="mandatory">*</span>

                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                              @Html.DropDownListFor(
                                     model => model.ddlreturnd,
                                     Model.ddlreturndList,
                                     new { @class = "swiftselect cclickED", style = "font-size: 8pt; width:40px;" }
                               )

                               @Html.DropDownListFor(
                                     model => model.ddlreturnm,
                                     Model.ddlreturnmList,
                                     new { @class = "swiftselect cclickED", style = "font-size: 8pt; width:50px;" }
                               )

                            @Html.DropDownListFor(
                                     model => model.ddlreturny,
                                     Model.ddlreturnyList,
                                     new { @class = "swiftselect cclickED", style = "font-size: 8pt; width:55px;" }
                            )
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;To date :-<span class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            @Html.DropDownListFor(
                                     model => model.ddlreturn2d,
                                     Model.ddlreturn2dList,
                                     new { @class = "swiftselect cclickED", style = "font-size: 8pt; width:40px;" }
                            )

                            @Html.DropDownListFor(
                                     model => model.ddlreturn2m,
                                     Model.ddlreturn2mList,
                                     new { @class = "swiftselect cclickED", style = "font-size: 8pt; width:50px;" }
                                     )
                            @Html.DropDownListFor(
                                     model => model.ddlreturn2y,
                                     Model.ddlreturn2yList,
                                     new { @class = "swiftselect cclickED", style = "font-size: 8pt; width:55px;" }
                                     )
                        </td>

                    </tr>
                    <tr id="tr4"  style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Effective Date :-<span class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            
                            @Html.DropDownListFor(
                                     model => model.optED,
                                     Model.optEDList,
                                     new { @class = "swiftselect cclickED", style = "font-size: 8pt; width:40px;" }
                            )

                            @Html.DropDownListFor(
                                     model => model.optEM,
                                     Model.optEMList,
                                     new { @class = "swiftselect cclickED", style = "font-size: 8pt; width:50px;" }
                            )

                            @Html.DropDownListFor(
                                     model => model.optEY,
                                     Model.optEYList,
                                     new { @class = "swiftselect cclickED", style = "font-size: 8pt; width:55px;" }
                                     )
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Term :-<span class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="vertical-align: top; text-align: left;">
                            &nbsp;Year:- &nbsp;
                           
                            <select id="ddlTermyear" name="ddlTermyear" class="swiftselect changeterm" style="font-size:8pt; width:60px;">
                                <option value="0">0</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                                <option value="6">6</option>
                                <option value="7">7</option>
                                <option value="8">8</option>
                                <option value="9">9</option>
                                <option value="10">10</option>
                                <option value="100">Lifetime</option>
                            </select>
                            &nbsp;Month:-&nbsp;
                            <select id="ddlTermmonth" name="ddlTermmonth" class="swiftselect changeterm" style="font-size:8pt; width:40px;">
                                <option value="0">0</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                                <option value="6">6</option>
                                <option value="7">7</option>
                                <option value="8">8</option>
                                <option value="9">9</option>
                                <option value="10">10</option>
                                <option value="11">11</option>
                            </select>

                           
                        </td>
                    </tr>
                    <tr id="tr6" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Date of expiry :-<span class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            @Html.DropDownListFor(
                                     model => model.optDay,
                                     Model.optDayList,
                                     new { @class = "swiftselect cclick", style = "font-size: 8pt; width:40px;", @disabled = "disabled" }
                                     )

                            @Html.DropDownListFor(
                                     model => model.optMonth,
                                     Model.optMonthList,
                                     new { @class = "swiftselect cclick", style = "font-size: 8pt; width:50px;", @disabled = "disabled" }
                                     )

                            @Html.DropDownListFor(
                                     model => model.optYear,
                                     Model.optYearList,
                                     new { @class = "swiftselect cclick", style = "font-size: 8pt; width:55px;", @disabled = "disabled" }
                                     )

                            @Html.HiddenFor(model => model.hdnexpiryday)
                            @Html.HiddenFor(model => model.hdnexpirymon)
                            @Html.HiddenFor(model => model.hdnexpiryyear)

                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Vendor Name :-<span class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            @Html.TextBoxFor(
                                     model => model.txtvendorname,
                                     new
                                     {
                                         @class = "swifttext onpaste",
                                         style = "width:220px;",
                                         maxlength = "99"
                                     }
                                     )
                        </td>
                    </tr>
                    <tr id="tr8" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Manner of payment :-<span class="mandatory">*</span>
                        </td>
                        <td colspan="3" class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            @Html.DropDownListFor(
                                     model => model.ddlMannerOfPayment,
                                     Model.ddlMannerOfPaymentList,
                                     new {@class = "swiftselect", style = "font-size: 8pt; width:220px;"}
                                     )
                        </td>
                    </tr>

                    <tr id="tr5" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Agreement Attachment :-<span id="spn_mandatory" class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                            colspan="3">
                            <input type="file" asp-for="fileUploadAttachmentAA" style="width: 350px" /><span style="color:gray;">[Max File Limit 6 MB]</span>
                        </td>
                    </tr>
                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Approval Note :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                            colspan="3">
                            <input type="file" asp-for="fileUploadAttachmentRA" style="width: 350px" />
                        </td>
                    </tr>
                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Master Agreement :-&nbsp;&nbsp;
                        </td>
                        <td colspan="3" class="smalltext" style="vertical-align: top; text-align: left;">
                            <div>
                                <input asp-for="rdomaster" type="radio" value="1" /> Yes
                                <input asp-for="rdomaster" type="radio" value="0" /> No
                            </div>

                          
                            <span style="color:gray;">[If Master Agreement is Existing]</span>
                        </td>
                    </tr>
                    <tr id="tr11" style="line-height: 25px; ">
                        <td style="text-align: right; vertical-align: top;" class="font12">&nbsp;</td>
                        <td colspan="3" class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            <div id="updatepnl_agr">
                                &nbsp;
                                @Html.DropDownListFor(
                                         model => model.ddlmstagreement,
                                         Model.ddlmstagreementList,
                                         new { @class = "swiftselect", style = "width:220px;" }
                                         )
                                &nbsp;&nbsp;
                                <a class="sampfrmt" id="anch_mstagrfinaldoc"></a>
                            </div>
                        </td>
                    </tr>

                    <tr id="tr9" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Consideration :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                            colspan="3">
                            @Html.TextBoxFor(
                                     model => model.txtconsiderable,
                                     new
                                     {
                                         id = "txtconsiderable",
                                         @class = "font12",
                                         style = "margin: 3px; width: 500px; height: 50px; border-color:#888888;"
                                     }
                                     )
                        </td>
                    </tr>

                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Purpose :-<span class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                            colspan="3">
                           
                            @Html.TextAreaFor(
                                     model => model.txtPurpose,
                                     new
                                     {
                                         @class = "font12 onpaste",
                                         style = "margin: 3px; width: 500px; height: 50px; border-color:#888888;",
                                         maxlength = "499"
                                     }
                                     )
                        </td>
                    </tr>
                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Remarks :-<span class="mandatory">*</span>
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                            colspan="3">
                        
                            @Html.TextAreaFor(
                                     model => model.txtRemarks,
                                     new
                                     {
                                         @class = "font12 onpaste",
                                         style = "margin: 3px; width: 500px; height: 50px; border-color:#888888;",
                                         maxlength = "499"
                                     }
                                     )
                        </td>
                    </tr>

                    <tr>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Approving Authority :-<span class="mandatory">*</span>
                        </td>
                        <td style="color: #6299c5; vertical-align: top; text-align: left;" colspan="3">
                         
                            @if (ViewBag.lbl_appauthVisiable == true)
                            {
                                 <span id="lbl_appauth" class="swifttext" style="width: 250px; margin-left: 4px!Important; background-color: #F6F8FA; color: Gray; padding: 0px 0px!Important;">
                                    @Html.DisplayFor(model => model.lbl_appauth)
                                 </span>
                            }

                            @if (ViewBag.ddl_appauthVisiable == true){
                                @Html.DropDownListFor(
                                         model => model.ddl_appauth,
                                         Model.ddl_appauthList,
                                         new { style = "margin-left:3px;margin-top:2px;" }
                                         )
                            }

                            <input asp-for="hdauthcode" type="hidden" />
                            <input asp-for="hdauthemailid" type="hidden" />
                            <input asp-for="hdauthname" type="hidden" />
                            <input asp-for="hdauthlevel" type="hidden" />

                        </td>
                    </tr>
                </tbody>
            </table>
          @* Start Added by Aumento :: SR79956 *@
            <div class="form-control"
                 style="color: blue; padding: 2px; border: 1px solid; border-radius: 3px; font-size: larger; background-color: #f9f9f9c7; display: none;"
                 id="DeclarationDiv">
                <div style="padding: 6px;">
                    <input asp-for="CheckDeclaration" type="checkbox" />
                    <span>&nbsp;<b style="color: black">Declaration:-</b> I will ensure to incorporate required clauses from Approved Standard clauses document in this attached agreement/SOW.</span>
                </div>
            </div>
            @* End Added by Aumento :: SR79956 *@
            <table class="tableGridView" style="border-color: #CCDCE0; border-width: 1px; border-style: solid;
                        margin-bottom: 2px; margin-left: 0px; margin-right: 2px; margin-top: 2px;" cellpadding="0"
                   cellspacing="0" width="100%">
                <tr>
                    <td class="HeaderStyle12" style="padding: 0px 0px 0px 0px;" colspan="4">
                        &nbsp; Note :-
                    </td>
                </tr>
                <tr style="background-color: #FFFDF1;">
                    <td colspan="4">
                        <ul style="margin-left: 5px; font-size: 1em;" class="noteli">
                            <li>
                                This memo should be submitted <u>at least 15 days</u> prior to the date from which an agreement
                                will have to take effect or the date of expiry of an existing agreement, as the
                                case may be.<br />
                            </li>
                            <li>
                                This document is a confidential property of the company &amp; to be disclosed only
                                on a “Need to Know Basis” to other associates.<br />
                            </li>
                            <li>
                                In case Live agreement is not reflecting on the system this means that previously
                                agreement was not shared with Legal Dept. due to any reason. In case you wish to upload or add agreement in Live contract list then please contact Legal Dept.
                            </li>
                        </ul>
                    </td>
                </tr>
                <tr>
                    <td class="buttonwrapper" align="center" colspan="4">
                        <button class="assetbtn" id="cmdSubmit">Submit</button>
                        &nbsp;
                        <button class="assetbtn" id="cmdReset">Reset</button>

                    </td>
                </tr>
            </table>
        </div>

        @* ---Back Button Start---- *@
        <div class="clear"></div>
        <div class="backrowdiv"><a asp-controller="Home" asp-action="Home" title="Go to Home">Back</a></div>

        <div class="clear"></div>
        @* ----Back Button End---- *@
       
    </div>
</div>


@section Scripts {
    <script src="~/js/calendarpopup.js" asp-append-version="true"></script>
    <script src="~/js/jquery-ui.js" asp-append-version="true"></script>
    <script src="~/js/calendarpopup.js" asp-append-version="true"></script>
    <script src="~/app/iomcontract/js/iomrequestform.js" asp-append-version="true"></script>
}
