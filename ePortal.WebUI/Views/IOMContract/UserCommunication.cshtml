@model ePortal.ViewModels.APPX.IOM.UserCommunicationViewModel
@{
    ViewBag.Title = "Employee Portal - Contract Management :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/css/newasset.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/app/iomcontract/css/usercommunication.css" rel="stylesheet" asp-append-version="true" />

}

<div class="row">
    @* Heading Start *@
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">Interoffice Memorandum Communication Form</div>
    </div>

    <div class="body-content" style="overflow-x:hidden; padding: 0px !important;">



        @* Heading End *@

        <div class="headmain">
            <table class="table table-bordered table-condensed table-striped" width="100%">
                <thead>
                    <tr class="HeaderStyle12">
                        <td colspan="4">
                            &nbsp;Requestor Detail's
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <tr style="line-height: 25px;">
                        <td width="22%" style="text-align: right; vertical-align: top;" class="style1">
                            &nbsp;Name :-
                        </td>
                        <td width="28%" class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss" id="lbl_assname">@Model.lbl_assname</span>
                           
                        </td>
                        <td width="20%" style="text-align: right; vertical-align: top;" class="style1">
                            &nbsp;Site :-
                        </td>
                        <td width="30%" class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss" id="lbl_site">@Model.lbl_site</span>
                        </td>
                    </tr>
                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="style1">
                            &nbsp;Operation :-
                        </td>
                        <td class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss">@Html.DisplayFor(model => model.lbl_op)</span>
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="style1">
                            &nbsp;Division :-
                        </td>
                        <td class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss">@Html.DisplayFor(model => model.lbl_div)</span>
                        </td>
                    </tr>
                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Department :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss">@Html.DisplayFor(model => model.lbl_dept)</span>
                        </td>
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Section :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss">@Html.DisplayFor(model => model.lbl_sec)</span>
                        </td>
                    </tr>
                </tbody>
            </table>


            @if (Convert.ToBoolean(ViewBag.PrevcontractdivVisible ?? true))
            {
                <table id="Prevcontractdiv" class="table table-bordered table-condensed table-striped" width="100%">
                    <thead>
                        <tr class="HeaderStyle12">
                            <td colspan="4">
                                &nbsp; Previous Contract Detail's
                            </td>
                        </tr>
                    </thead>
                    <tr style="line-height: 25px;">
                        <td width="20%" style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Agreement ID :-
                        </td>
                        <td width="30%" class="style1" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss" id="lblagreementid">@Model.lblagreementid</span>
                        </td>
                        <td width="20%" style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Agreement Period :-
                        </td>
                        <td width="30%" class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                            &nbsp;
                            <span class="lblcss" id="lblprevagrperiod">@Model.lblprevagrperiod</span>
                        </td>
                    </tr>
                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Approval Note :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                        colspan="3">
                            &nbsp;
                            <a id="prevappnotelink" data-url="@Model.prevappnotelink">@Model.prevappnotelinkText</a>
                        </td>
                    </tr>
                    <tr style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            &nbsp;Final Document :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                        colspan="3">
                            &nbsp;
                            <a id="prevfinaldoclink" data-url="@Model.prevfinaldoclink">@Model.prevfinaldoclinkText</a>
                        </td>
                    </tr>
                </table>
            }
           
            
            
            <table class="table table-bordered table-condensed table-striped" width="100%">
                <thead>
                    <tr class="HeaderStyle12">
                        <td colspan="4">
                            &nbsp; Interoffice Memorandum Detail's
                        </td>
                    </tr>
                </thead>
                <tr style="line-height: 25px;">

                    <td width="22%" style="text-align: right; vertical-align: top;" class="font12">
                        From :-
                    </td>
                    <td width="28%" style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                        &nbsp;
                        <span class="lblcss" id="lblfrom">@Model.lblfrom</span>
                    </td>
                    <td width="20%" style="text-align: right; vertical-align: top;" class="font12">
                        To :-
                    </td>
                    <td width="30%" style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                        &nbsp;
                        <span class="lblcss" id="lblto">@Model.lblto</span>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        Agreement Type :-
                    </td>
                    <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                        &nbsp;
                        <span class="lblcss" id="lblagreementtype">@Model.lblagreementtype</span>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        Contact Type :-
                    </td>
                    <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                        &nbsp;
                        <span class="lblcss" id="lblcontracttype">@Model.lblcontracttype</span>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        Effective Date:-
                    </td>
                    <td style="color: #6299c5; vertical-align: top; text-align: left;" class="font12">
                        &nbsp;
                        <span class="lblcss" id="lbleffdate">@Model.lbleffdate</span>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        Expiry Date :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;
                        <span class="lblcss" id="lblexpdate">@Model.lblexpdate</span>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="style1">
                        Term :-
                    </td>
                    <td class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;
                        <span class="lblcss" id="lblterm">@Model.lblterm</span>
                    </td>
                    <td style="text-align: right; vertical-align: top;" class="style1">
                        Vendor Name :-
                    </td>
                    <td class="style2" style="color: #6299c5; vertical-align: top; text-align: left;">
                        &nbsp;
                        <span class="lblcss" id="lblvendorname">@Model.lblvendorname</span>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        Manner of Payment :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                        colspan="3">
                        &nbsp;
                        <span class="lblcss" id="lblmannerofpayment">@Model.lblmannerofpayment</span>
                    </td>
                </tr>

                @if (Convert.ToBoolean(ViewBag.trreferencedocVisible ?? true))
                {
                    <tr id="trreferencedoc"  style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            Approval Note:-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                            colspan="3">
                            &nbsp;
                            <a id="agreementlink" data-url="@Model.agreementlink">@Model.agreementlinkText</a>
                        </td>
                    </tr>
                }
                @if (Convert.ToBoolean(ViewBag.trantibriberyVisiable ?? true))
                {
                    <tr id="trantibribery"  style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            Anti Bribery Policy:-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                            colspan="3">
                            &nbsp;
                            <a id="antibriberylink" data-url="@Model.antibriberylink">@Model.antibriberylinkText</a>
                        </td>
                    </tr>
                }

                @if (Convert.ToBoolean(ViewBag.trndadocumentVisible ?? true))
                {
                    <tr id="trndadocument" style="line-height: 25px;">
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            Non Disclosure Agreement:-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                            colspan="3">
                            &nbsp;
                            <a id="ndadocumentlink" data-url="@Model.ndadocumentlink">@Model.ndadocumentlinkText</a>
                        </td>
                    </tr>
                }
                
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="style1">
                        Purpose :-
                    </td>
                    <td class="style2" style="color: #6299c5; line-height: 13px!Important; padding: 4px!Important;"
                        colspan="3">
                        &nbsp;
                        <span class="lblcss" id="lblpurpose">@Model.lblpurpose</span>
                    </td>
                </tr>
                <tr style="line-height: 25px;">
                    <td style="text-align: right; vertical-align: top;" class="font12">
                        Remarks :-
                    </td>
                    <td class="smalltext" style="color: #6299c5; line-height: 13px!Important; padding: 4px!Important;"
                        colspan="3">
                        &nbsp;
                        <span class="lblcss" id="lblremarks">@Model.lblremarks</span>
                    </td>
                </tr>

                @if (Convert.ToBoolean(ViewBag.trmstagrVisible ?? false))
                {
                    <tr id="trmstagr"  style="line-height: 25px;" >
                        <td style="text-align: right; vertical-align: top;" class="font12">
                            Master Agreement :-
                        </td>
                        <td class="smalltext" style="color: #6299c5; vertical-align: top; text-align: left;"
                            colspan="3">
                            &nbsp;
                            <span class="lblcss" id="lblmstagr">@Model.lblmstagr</span>
                        </td>
                    </tr>
                }
            </table>


            <table class="table table-bordered table-condensed table-striped" width="100%">
                <thead>
                    <tr class="HeaderStyle12">

                        <td class="HeaderStyle12" colspan="4" style="padding: 0px">
                            &nbsp;Communication History
                            <span class="pull-right">
                                @if (Convert.ToBoolean(ViewBag.btnCommunicationVisible ?? true) ) 
                                {
                                    <button class="btn btn-info btn-sm" id="btnCommunication" Style="padding:2px; margin-right:5px" title="Communicate to user">Send Comm.</button>

                                }
                            </span>
                        </td>
                    </tr>
                </thead>
                <tr style="line-height: 25px;">
                    <td colspan="4" style="text-align: left; vertical-align: top">
                        <div style="overflow-y: auto; max-height: 200px;">
                            <table class="grdCommunicationHistory tableGridView" cellspacing="0" cellpadding="2" rules="all" border="1" id="grdCommunicationHistory" style="width:100%;border-collapse:collapse;">
                                <thead>
                                    <tr class="grdHeader" style="height:25px;">
                                        <th style="text-align: center">Date</th>
                                        <th style="text-align: center">Employee</th>
                                        <th style="text-align: center">User Type</th>
                                        <th style="text-align: center">Remarks</th>
                                        <th style="text-align: center"><img src="~/images/icons/attachment.gif"></th>
                                    </tr>
                                </thead>
                                @if (Model.grdCommunicationHistory != null && Model.grdCommunicationHistory.Any())
                                {
                                    <tbody>
                                        @foreach (var item in Model.grdCommunicationHistory)
                                        {
                                            <tr class="txtstyle" style="height:20px;">
                                                <td align="center" style="width:12%;">@item.ADDEDDATE</td>
                                                <td style="width:15%;">@item.ADDEDBY</td>
                                                <td style="width:15%;">@item.USERTYPE</td>
                                                <td style="width:55%;">@item.REMARKS</td>
                                                <td style="width:3%;">
                                                    @if (!string.IsNullOrWhiteSpace(item.ATTACHMENT))
                                                    {
                                                        <a class="linkagreement" data-attachmentpath="@item.ATTACHMENT">
                                                            <img src="~/images/icon_document.gif" alt="Doc" width="15">
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                }
                                else
                                {
                                    <tfoot>
                                        <tr>
                                            <td colspan="5" style="color:#274D14; background-color: #F5FFF0; font-family: Calibri">
                                                <div style="border: 1px solid #C0C0C0; width: 100%; color: Red; font-weight: bold;">
                                                    No Approval Found
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    </td>
                </tr>

            </table>

            <table class="table table-bordered table-condensed table-striped" width="100%">
                <tr>
                    <td class="buttonwrapper" align="center" colspan="4">
                        <button class="assetbtn" id="cmdcancel">Cancel</button>
                    </td>
                </tr>
            </table>

            <input type="hidden" asp-for="hdiomid" />
            <input type="hidden" asp-for="HDENAME" />
            <input type="hidden" asp-for="HDEMAILID" />

        </div>

     
    
    
        <section>
            <div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true" data-backdrop="static" and data-keyboard="false">
                <div class="modal-dialog modal-md" role="document">
                    <div class="modal-content" style="border: 4px solid;">
                        <div id="EditCaption" class="HeaderStyle123 headerborder">
                            <span>
                                Communication Form
                            </span>
                        </div>

                        <div class="modal-body" style="padding: 0px !important;">
                            <table class="tableGridView" width="100%" cellpadding="0" cellspacing="0">
                                <tr class="row1">
                                    <td style="text-align: Left; padding: 2px; vertical-align: middle; height: 39px; width: 30%;">
                                        Communicate To:
                                    </td>
                                    <td style="text-align: Left; padding: 2px; vertical-align: middle; height: 39px;">
                                        <span id="lblRequesterName">@Model.lblRequesterName</span>
                                        <input type="hidden" asp-for="hd_Requester" />
                                        <input type="hidden" asp-for="hd_Email" />
                                    </td>
                                </tr>
                                <tr class="row2">
                                    <td style="text-align: right; padding: 2px; vertical-align: middle; height: 39px;width: 30%;">
                                        Remarks:
                                    </td>
                                    <td style="text-align: Left; padding: 2px; vertical-align: middle; height: 39px;">
                                        @Html.TextAreaFor(
                                                 model => model.txtMessageRemarks,
                                                 new
                                                 {
                                                     @class = "form-control",
                                                     style = "max-width: 300px"
                                                 }
                                                 )
                                    </td>
                                </tr>
                                <tr class="row1">
                                    <td style="text-align: right; padding: 2px; vertical-align: middle; height: 39px;">
                                        Upload
                                        Document:
                                    </td>
                                    <td style="text-align: Left; padding: 2px; vertical-align: middle; height: 39px;">

                                        <input type="file" asp-for="RefUploadDocument" class="form-control" Style="max-width: 300px" />
                                    </td>
                                </tr>
                                <tr class="row2">
                                    <td style="text-align: right; padding: 2px; vertical-align: middle;" colspan="4">
                                        &nbsp;
                                    </td>
                                </tr>
                                <tr class="row1">
                                    <td colspan="2" width="100%" align="center" style="text-align: center; border-bottom: solid 1px #C0C0C0;border-left: solid 1px #C0C0C0; padding: 4px;" class="style1">
                                        <button type="button" id="submitbtn" class="btn btn-success btn-sm">Submit</button>
                                        <button type="button" id="btnCancel close" data-dismiss="modal" class="btn btn-secondry btn-sm">Cancel</button>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>


   

@section Scripts {

    <script src="~/app/iomcontract/js/usercommunication.js" asp-append-version="true"></script>
}
