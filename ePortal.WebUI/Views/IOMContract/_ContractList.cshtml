@model IEnumerable<ePortal.ViewModels.APPX.IOM.grdSubcontractlist>


@{
    Layout = null;
}

<div>
    @if (Model != null && Model.Any())
    {
        <table class="border grd tablesubcontractGridView" cellspacing="0" cellpadding="2" border="1" style="width:100%;border-collapse:collapse;">
            <thead>
                <tr class="grdHeader" style="height:25px;">
                    <th>&nbsp;</th>
                    <th>Agreement</th>
                    <th>Vendor Name</th>
                    <th>Effective Date</th>
                    <th>Expiry date</th>
                    <th>Status</th>
                    <th>Requested By</th>
                    <th>Unique No.</th>
                    <th>FDOC</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="grdrow" style="20px;">
                        <td>
                            <a class="view_iom_details" data-iomid="@item.IOMID">
                                <img src="~/images/icon_ticketbullet.gif" style="padding-right: 2px; vertical-align: middle" alt="View IOM Detail" />
                            </a>

                            @*  <a href="javascript:openPopup('ViewIOMDetail.aspx?IOMID=<%# Eval(" IOMID") %>
                                ',820,590)">
                                <img id="Img1" style="padding-right: 2px; vertical-align: middle" src="../../assets/images/icon_ticketbullet.gif"
                                     runat="server" alt="View IOM Detail" />
                            </a> *@
                        </td>
                        <td>
                            @item.AGREEMENTTYPEDESC
                        </td>
                        <td>
                            @item.VENDORNAME
                        </td>
                        <td>
                            @item.EFFECTIVEDATE
                        </td>
                        <td>
                            @item.EXPIRYDATE
                        </td>
                        <td style="text-align: center; vertical-align:middle;">
                            @if (item.processstatusid == "24")
                            {
                                <span class="lbl_completed" Style="color: Green;">@item.STATUSNAME</span>
                            }
                            else
                            {
                                <span class="lbl_pending" Style="color: red;">@item.STATUSNAME</span>
                            }

                            @*  <asp:Label ID="lbl_pending" runat="server" Visible='<%# DataBinder.Eval(Container.DataItem, "processstatusid" ).ToString() != "24" ? true : false %>'
                                       Style="color: Red;"><%# Eval("STATUSNAME")%></asp:Label>
                            <asp:Label ID="lbl_completed" runat="server" Visible='<%# DataBinder.Eval(Container.DataItem, "processstatusid" ).ToString() == "24" ? true : false %>'
                                       Style="color: Green;"><%# Eval("STATUSNAME")%></asp:Label> *@
                        </td>
                        <td>
                            @item.REQUESTDBY
                        </td>
                        <td style="text-align: center; vertical-align:middle;">
                            <span class="lbl_uniqueid">@item.UNIQUEID</span>
                            @* <asp:Label ID="lbl_uniqueid" Text='<%# Eval("UNIQUEID") %>' runat="server"></asp:Label></ItemTemplate> *@

                        </td>
                        <td style="text-align: center; vertical-align:middle;">
                            @if (!string.IsNullOrWhiteSpace(item.finaldoc))
                            {
                                <a class="subcontracter_finaldoclink" data-finaldoc="@item.finaldoc">
                                    <img id="imgplus" src="~/images/attachment.gif" alt="Final Document" />
                                </a>
                            }

                            @*  <a id="finaldoclink" runat="server" visible='<%# DataBinder.Eval(Container.DataItem, "finaldoc" ).ToString() == "" ? false : true %>'
                               href='<%# "../../Uploads/IOM/"+Eval("finaldoc") %>' target="_blank" onclick="open(this.href, this.target, 'width=800, height=550, top=90, left=200'); return false;">
                                <img src="../../assets/images/attachment.gif" alt="Final Document" />
                            </a> *@
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    }
    
</div>