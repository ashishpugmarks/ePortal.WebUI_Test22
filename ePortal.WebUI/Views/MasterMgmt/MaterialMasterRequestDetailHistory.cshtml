@{
    Layout = null;
}
<html>
<head>
    <title>Material Master Request : Details</title>
    <link media="all" href="../styles/index.css" type="text/css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_2"]">
        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
            line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
            font-size: 11px;
            border-collapse: collapse;
            color: #000000;
            font-family: Verdana, Tahoma;
        }

            .tableMainInner tr td {
                border: solid 1px #FFFFFF;
                padding: 0;
            }

                .tableMainInner tr td.heading {
                    text-align: right;
                }

        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
        }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                line-height: 20px;
                font-family: Verdana, Arial, Helvetica;
                font-size: 11px;
                padding: 2px;
            }

            .tableGridView tr th {
                background: url(../images/bg_header.jpg) #cae8ea no-repeat;
            }
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
    </style>
</head>
<body>
    <div style="background-color: White; min-height: 662px;">
        <table cellspacing="0" cellpadding="0" width="100%" border="0">
            <tbody>
                <tr>
                    <td valign="top" align="left" style="width: 980px; background-color: #FFFFFF; overflow:auto">
                        <table cellspacing="0" cellpadding="0" width="100%" border="0" id="maintable">
                            <tbody>
                                <tr>
                                    <td bgcolor="#ffffff" style="padding: 10px">
                                        <!-- Start Extend -->
                                        @if (ViewBag.ReqType == "E")
                                        {
                                            <div id="lbl_ExtendDetails">
                                                Material Extend Details
                                                (@(ViewBag.Id)))
                                            </div>

                                            <table id="gvMaterialDetails" class="tableGridView" width="100%" cellspacing="0" cellpadding="0" border="1">
                                                <thead class="grdHeader">
                                                    <tr>
                                                        <th>MM ID</th>
                                                        <th>Material Code</th>
                                                        <th>Description</th>
                                                        <th>Specification</th>
                                                        <th>Plant</th>
                                                        <th>HSN Code</th>
                                                        <th>Indicator</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in ViewBag.gvMaterialDetails)
                                                    {
                                                        <tr class="grdrow">
                                                            <td>@item.MMDETAILHID</td>
                                                            <td>@item.MATERIALCODE</td>
                                                            <td>@item.MATERIALDISCRIPTION</td>
                                                            <td>@item.MATERIALSPECIFICATION</td>
                                                            <td>@item.PLANTNAME</td>
                                                            <td>@item.HSNCODE</td>
                                                            <td>@item.MMINDICATOR</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            @if (ViewBag.IsSales == "Y")
                                            {
                                                <b id="b2">
                                                    <span id="lblExtendSales">Material Extend Details for Sales view</span>
                                                    (@(ViewBag.Id)
                                                </b>
                                                <br />
                                                <table id="grdExtendSales" class="tableGridView" width="100%" cellspacing="0" cellpadding="0" border="1" style="display:none;">
                                                    <thead class="grdHeader">
                                                        <tr>
                                                            <th>MM. ID</th>
                                                            <th>Mat. Code</th>
                                                            <th>Plant</th>
                                                            <th>Description</th>
                                                            <th>Specification</th>
                                                            <th>M.Type</th>
                                                            <th>M.Group</th>
                                                            <th>Trans. Grp</th>
                                                            <th>Loading Grp</th>
                                                            <th>Base Unit</th>
                                                            <th>Profit Centre</th>
                                                            <th>Distri. Ch.</th>
                                                            <th>Item Categ</th>
                                                            <th>Gen. Item Catg Grp</th>
                                                            <th>Avl. Chk</th>
                                                            <th>Storage Loc</th>
                                                            <th>Tax Class.</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in ViewBag.grdExtendSales)
                                                        {
                                                            <tr class="grdrow">
                                                                <td>@item.MMDETAILHID</td>
                                                                <td>@item.MATERIALCODE</td>
                                                                <td>@item.PLANTNAME</td>
                                                                <td>@item.MATERIALDISCRIPTION</td>
                                                                <td>@item.MATERIALSPECIFICATION</td>
                                                                <td>@item.MATERIALTYPE</td>
                                                                <td>@item.MATERIALGROUP</td>
                                                                <td>@item.TRANSPORTATIONGROUP</td>
                                                                <td>@item.LOADINGGROUP</td>
                                                                <td>@item.BASEUNITOFMEASURE</td>
                                                                <td>@item.PROFITCENTER</td>
                                                                <td>@item.DISTRI_CHN</td>
                                                                <td>@item.ITEM_CATG_GRP</td>
                                                                <td>@item.GEN_ITEM_CAT_GRP</td>
                                                                <td>@item.AVAIL_CHK</td>
                                                                <td>@item.STORAGE_LOC</td>
                                                                <td>@item.TAX_CLASSIFICATION</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                            <br />
                                            <!-- End Extend -->
                                        }

                                        else if (ViewBag.ReqType == "C" || ViewBag.ReqType == "U")
                                        {
                                            <!-- Start Create Request -->
                                            <b id="lbl_Createdatails">
                                                <span id="Label1">@(ViewBag.GenMessage)</span>
                                                (@(ViewBag.Id))
                                            </b>
                                            <br />

                                            <table id="gvMMCreationDetail" class="tableGridView" width="100%" cellspacing="0" cellpadding="0" border="1">
                                                <thead class="grdHeader">
                                                    <tr>
                                                        <th>MM. ID</th>
                                                        <th>Mat. Code</th>
                                                        <th>Plant</th>
                                                        <th>Description</th>
                                                        <th>Specification</th>
                                                        <th>M.Type</th>
                                                        <th>M.Group</th>
                                                        <th>V. Class</th>
                                                        <th>HSN Code</th>
                                                        <th>Indicator</th>
                                                        <th>UOM</th>
                                                        <th>MPN Profile</th>
                                                        <th>Profite Centre</th>
                                                        <th>Sp. Mat. Status</th>
                                                        <th>Int. Material No.</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="grdrow">
                                                    @foreach (var item in ViewBag.gvMMCreationDetail)
                                                    {
                                                        <tr class="grdrow">
                                                            <td>@item.MMDETAILHID</td>
                                                            <td>@item.MATERIALCODE</td>
                                                            <td>@item.PLANTNAME</td>
                                                            <td>@item.MATERIALDISCRIPTION</td>
                                                            <td>@item.MATERIALSPECIFICATION</td>
                                                            <td>@item.MATERIALTYPE</td>
                                                            <td>@item.MATERIALGROUP</td>
                                                            <td>@item.VALUATIONCLASS</td>
                                                            <td>@item.HSNCODE</td>
                                                            <td>@item.MMINDICATOR</td>
                                                            <td>@item.UOM</td>
                                                            <td>@item.MPN_PROFILE</td>
                                                            <td>@item.PROFITCENTER</td>
                                                            <td>@item.PLANT_SP_MAT_STATUS</td>
                                                            <td>@item.INT_MATERIAL_NO</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            @if (ViewBag.IsSales == "IsSales")
                                            {
                                                <br />
                                                <b id="b1">
                                                    <span id="lblSalesView">@ViewBag.SalesView</span>
                                                    (@ViewBag.Id)
                                                </b>
                                                <br />
                                                <table id="gvMMSalesView" class="tableGridView" width="100%" cellspacing="0" cellpadding="0" border="1" style="display:none;">
                                                    <thead class="grdHeader">
                                                        <tr>
                                                            <th>MM. ID</th>
                                                            <th>Mat. Code</th>
                                                            <th>Plant</th>
                                                            <th>Description</th>
                                                            <th>Specification</th>
                                                            <th>M.Type</th>
                                                            <th>M.Group</th>
                                                            <th>Trans. Grp</th>
                                                            <th>Loading Grp</th>
                                                            <th>Base Unit</th>
                                                            <th>Profit Centre</th>
                                                            <th>Distri. Ch.</th>
                                                            <th>Item Categ</th>
                                                            <th>Gen. Item Catg Grp</th>
                                                            <th>Avl. Chk</th>
                                                            <th>Storage Loc</th>
                                                            <th>Tax Class.</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="grdrow">
                                                        @foreach (var item in ViewBag.gvMMSalesView)
                                                        {
                                                            <tr class="grdrow">
                                                                <td>@item.MMDETAILHID</td>
                                                                <td>@item.MATERIALCODE</td>
                                                                <td>@item.PLANTNAME</td>
                                                                <td>@item.MATERIALDISCRIPTION</td>
                                                                <td>@item.MATERIALSPECIFICATION</td>
                                                                <td>@item.MATERIALTYPE</td>
                                                                <td>@item.MATERIALGROUP</td>
                                                                <td>@item.TRANSPORTATIONGROUP</td>
                                                                <td>@item.LOADINGGROUP</td>
                                                                <td>@item.BASEUNITOFMEASURE</td>
                                                                <td>@item.PROFITCENTER</td>
                                                                <td>@item.DISTRI_CHN</td>
                                                                <td>@item.ITEM_CATG_GRP</td>
                                                                <td>@item.GEN_ITEM_CAT_GRP</td>
                                                                <td>@item.AVAIL_CHK</td>
                                                                <td>@item.STORAGE_LOC</td>
                                                                <td>@item.TAX_CLASSIFICATION</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }

                                            <!-- End Create Request -->
                                        }

                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div id="ajaxLoader"></div>
</body>
</html>
  


