@section Scripts{
    <script language="javascript" type="text/javascript">
        function ValidateUploadFile() {
            var uploadfile = document.getElementById("<% =fileuploadCreate.ClientID %>").value;
            if ((uploadfile == null || uploadfile == '')) {
                alert('Please upload the attachment');
                return false;
            }
        }
        function ValidateUploadFileExt() {
            var uploadfile = document.getElementById("<% =fileuploadExtend.ClientID %>").value;
            if ((uploadfile == null || uploadfile == '')) {
                alert('Please upload the attachment');
                return false;
            }
        }
        function ReqCreValidate() {
            var rtrn = false;
            // Material Req No is mandatory
            if (false == FnValidateTextRquired(document.getElementById("<% =txtCreateRequestNo.ClientID %>"), "Material Create Request No is mandatory")) {
                return false;
            }
            else {
                return true;
            }
        }

        function ReqExtValidate() {
            var rtrn = false;
            // Material Req No is mandatory
            if (false == FnValidateTextRquired(document.getElementById("<% =txtExtendRequestNo.ClientID %>"), "Material Extend Request No is mandatory")) {
                return false;
            }
            else {
                return true;
            }
        }

        // To check validation for textbox for required
        function FnValidateTextRquired(ctrlText, msg) {
            if (ctrlText.value == "") {
                return ShowError(ctrlText, msg);
            }
        }

        function validatePageDownLoad() {
            if (false == FnValidateDDLRequired(document.getElementById("<% =ddlRequestType.ClientID %>"), "Request Type is mandatory")) {
                return false;
            }
            var ctrlDayFrom = document.getElementById("<%= ddlDayFrom.ClientID %>");
            var ctrlMonthFrom = document.getElementById("<%= ddlMonthFrom.ClientID %>");
            var ctrlYearFrom = document.getElementById("<%= ddlYearFrom.ClientID %>");
            if (!(ctrlDayFrom.selectedIndex == 0 && ctrlMonthFrom.selectedIndex == 0 && ctrlYearFrom.selectedIndex == 0) && !(ctrlDayFrom.selectedIndex != 0 && ctrlMonthFrom.selectedIndex != 0 && ctrlYearFrom.selectedIndex != 0)) {
                return ShowError(ctrlDayFrom, 'From date is not in correct format');
            }
            var ctrlDayTo = document.getElementById("<%= ddlDayTo.ClientID %>");
            var ctrlMonthTo = document.getElementById("<%= ddlMonthTo.ClientID %>");
            var ctrlYearTo = document.getElementById("<%= ddlYearTo.ClientID %>");
            if (!(ctrlDayTo.selectedIndex == 0 && ctrlMonthTo.selectedIndex == 0 && ctrlYearTo.selectedIndex == 0) && !(ctrlDayTo.selectedIndex != 0 && ctrlMonthTo.selectedIndex != 0 && ctrlYearTo.selectedIndex != 0)) {
                return ShowError(ctrlDayTo, 'To date is not in correct format');
            }

            if ((ctrlDayFrom.selectedIndex != 0 && ctrlMonthFrom.selectedIndex != 0 && ctrlYearFrom.selectedIndex != 0) && (ctrlDayTo.selectedIndex != 0 && ctrlMonthTo.selectedIndex != 0 && ctrlYearTo.selectedIndex != 0)) {
                var fromDate = ctrlMonthFrom.options.value + '-' + ctrlDayFrom.options.value + '-' + ctrlYearFrom.options.value; //Format: 12-31-2014
                var toDate = ctrlMonthTo.options.value + '-' + ctrlDayTo.options.value + '-' + ctrlYearTo.options.value; //Format: 12-31-2014
                if (new Date(fromDate) > new Date(toDate)) {
                    return ShowError(ctrlDayTo, 'To date can not less than from date');
                }
            }

            return true;
        }

        function validatePage() {

            if (false == FnValidateDDLRequired(document.getElementById("<% =ddlRequestType.ClientID %>"), "Request Type is mandatory")) {
                return false;
            }
            var ctrlDayFrom = document.getElementById("<%= ddlDayFrom.ClientID %>");
            var ctrlMonthFrom = document.getElementById("<%= ddlMonthFrom.ClientID %>");
            var ctrlYearFrom = document.getElementById("<%= ddlYearFrom.ClientID %>");
            if (!(ctrlDayFrom.selectedIndex == 0 && ctrlMonthFrom.selectedIndex == 0 && ctrlYearFrom.selectedIndex == 0) && !(ctrlDayFrom.selectedIndex != 0 && ctrlMonthFrom.selectedIndex != 0 && ctrlYearFrom.selectedIndex != 0)) {
                return ShowError(ctrlDayFrom, 'From date is not in correct format');
            }
            var ctrlDayTo = document.getElementById("<%= ddlDayTo.ClientID %>");
            var ctrlMonthTo = document.getElementById("<%= ddlMonthTo.ClientID %>");
            var ctrlYearTo = document.getElementById("<%= ddlYearTo.ClientID %>");
            if (!(ctrlDayTo.selectedIndex == 0 && ctrlMonthTo.selectedIndex == 0 && ctrlYearTo.selectedIndex == 0) && !(ctrlDayTo.selectedIndex != 0 && ctrlMonthTo.selectedIndex != 0 && ctrlYearTo.selectedIndex != 0)) {
                return ShowError(ctrlDayTo, 'To date is not in correct format');
            }

            if ((ctrlDayFrom.selectedIndex != 0 && ctrlMonthFrom.selectedIndex != 0 && ctrlYearFrom.selectedIndex != 0) && (ctrlDayTo.selectedIndex != 0 && ctrlMonthTo.selectedIndex != 0 && ctrlYearTo.selectedIndex != 0)) {
                var fromDate = ctrlMonthFrom.options.value + '-' + ctrlDayFrom.options.value + '-' + ctrlYearFrom.options.value; //Format: 12-31-2014
                var toDate = ctrlMonthTo.options.value + '-' + ctrlDayTo.options.value + '-' + ctrlYearTo.options.value; //Format: 12-31-2014
                if (new Date(fromDate) > new Date(toDate)) {
                    return ShowError(ctrlDayTo, 'To date can not less than from date');
                }
            }

            return true;
        }
        // To show validation message and focus the control validating
        function ShowError(ctrl, msg) {
            document.getElementById("<% =infoPanel.ClientID %>").style.display = "none";
            document.getElementById("<% =errorPanel.ClientID %>").style.display = "inline";
            document.getElementById("<% =errorMsg.ClientID %>").innerHTML = msg;
            ctrl.focus();
            return false;
        }

        // To check validation for Drop Down List for required
        function FnValidateDDLRequired(ctrlDDL, msg) {
            if (ctrlDDL.options[ctrlDDL.selectedIndex].value == "0") {
                return ShowError(ctrlDDL, msg);
            }
        }
        //Check if the date exist for From Date
        function cclick() {
            for (var i = 0; i < document.getElementById("<%=ddlMonthFrom.ClientID %>").options.length; i++) {
                if (document.getElementById("<%=ddlMonthFrom.ClientID %>").options[i].selected == true) {
                    if (document.getElementById("<%=ddlMonthFrom.ClientID %>").options[i].value == 2) {
                        for (var j = 0; j < document.getElementById("<%=ddlDayFrom.ClientID %>").options.length; j++) {
                            if (document.getElementById("<%=ddlDayFrom.ClientID %>").options[j].selected == true) {
                                if (document.getElementById("<%=ddlDayFrom.ClientID %>").options[j].value > 28) {
                                    if (document.getElementById("<%=ddlDayFrom.ClientID %>").options[j].value == 29 & (document.getElementById("<%=ddlYearFrom.ClientID %>").options.value == 2008 || document.getElementById("<%=ddlYearFrom.ClientID %>").options.value == 2012 || document.getElementById("<%=ddlYearFrom.ClientID %>").options.value == 2016 || document.getElementById("<%=ddlYearFrom.ClientID %>").options.value == 2020 || document.getElementById("<%=ddlYearFrom.ClientID %>").options.value == 2024 || document.getElementById("<%=ddlYearFrom.ClientID %>").options.value == 2028)) {
                                    }
                                    else {
                                        document.getElementById("<%=ddlDayFrom.ClientID %>").options[27].selected = true;
                                    }
                                }
                            }
                        }
                    }
                    if (document.getElementById("<%=ddlMonthFrom.ClientID %>").options[i].value == 4 || document.getElementById("<%=ddlMonthFrom.ClientID %>").options[i].value == 6 || document.getElementById("<%=ddlMonthFrom.ClientID %>").options[i].value == 9 || document.getElementById("<%=ddlMonthFrom.ClientID %>").options[i].value == 11) {
                        for (var j = 0; j < document.getElementById("<%=ddlDayFrom.ClientID %>").options.length; j++) {
                            if (document.getElementById("<%=ddlDayFrom.ClientID %>").options[j].selected == true) {
                                if (document.getElementById("<%=ddlDayFrom.ClientID %>").options[j].value > 30) {
                                    document.getElementById("<%=ddlDayFrom.ClientID %>").options[29].selected = true;
                                }
                            }
                        }
                    }
                }
            }
        }


        //Check if the date exist for To Date
        function cclickDT() {
            for (var i = 0; i < document.getElementById("<%=ddlMonthTo.ClientID %>").options.length; i++) {
                if (document.getElementById("<%=ddlMonthTo.ClientID %>").options[i].selected == true) {
                    if (document.getElementById("<%=ddlMonthTo.ClientID %>").options[i].value == 2) {
                        for (var j = 0; j < document.getElementById("<%=ddlDayTo.ClientID %>").options.length; j++) {
                            if (document.getElementById("<%=ddlDayTo.ClientID %>").options[j].selected == true) {
                                if (document.getElementById("<%=ddlDayTo.ClientID %>").options[j].value > 28) {
                                    if (document.getElementById("<%=ddlDayTo.ClientID %>").options[j].value == 29 & (document.getElementById("<%=ddlYearTo.ClientID %>").options.value == 2008 || document.getElementById("<%=ddlYearTo.ClientID %>").options.value == 2012 || document.getElementById("<%=ddlYearTo.ClientID %>").options.value == 2016 || document.getElementById("<%=ddlYearTo.ClientID %>").options.value == 2020 || document.getElementById("<%=ddlYearTo.ClientID %>").options.value == 2024 || document.getElementById("<%=ddlYearTo.ClientID %>").options.value == 2028)) {
                                    }
                                    else {
                                        document.getElementById("<%=ddlDayTo.ClientID %>").options[27].selected = true;
                                    }
                                }
                            }
                        }
                    }
                    if (document.getElementById("<%=ddlMonthTo.ClientID %>").options[i].value == 4 || document.getElementById("<%=ddlMonthTo.ClientID %>").options[i].value == 6 || document.getElementById("<%=ddlMonthTo.ClientID %>").options[i].value == 9 || document.getElementById("<%=ddlMonthTo.ClientID %>").options[i].value == 11) {
                        for (var j = 0; j < document.getElementById("<%=ddlDayTo.ClientID %>").options.length; j++) {
                            if (document.getElementById("<%=ddlDayTo.ClientID %>").options[j].selected == true) {
                                if (document.getElementById("<%=ddlDayTo.ClientID %>").options[j].value > 30) {
                                    document.getElementById("<%=ddlDayTo.ClientID %>").options[29].selected = true;
                                }
                            }
                        }
                    }
                }
            }
        }

        function openPopup(strOpenUrl, width, height) {
            window.open(strOpenUrl, "mywindow", "TOOLBAR=no,MENUBAR=no,RESIZABLE=no,SCROLLBARS=yes,LOCATION=no,DIRECTORIES=no,STATUS=no,width=" + width + ",height=" + height);
        }
    </script>
}
