@{
}
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title>Material Master Request : Details</title>
    <link media="all" href="../styles/index.css" type="text/css" rel="stylesheet" />
    <style type="text/css">
        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
            line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
            font-size: 11px;
            border-collapse: collapse;
            color: #000000;
            font-family: Verdana, Tahoma;
        }

            .tableMainInner tr td {
                border: solid 1px #FFFFFF;
                padding: 0;
            }

                .tableMainInner tr td.heading {
                    text-align: right;
                }

        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
        }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                line-height: 20px;
                font-family: Verdana, Arial, Helvetica;
                font-size: 11px;
                padding: 2px;
            }

            .tableGridView tr th {
                background: url(../images/bg_header.jpg) #cae8ea no-repeat;
            }
    </style>
</head>
<body style="background-color: White;">
    <form id="form1" runat="server" style="background-color:White;height:680px !important; ">
        <div style="background-color:White;height:680px !important;width:980px; ">
            <table cellspacing="0" cellpadding="0" width="100%" border="0">
                <tbody>
                    <tr>
                        <td valign="top" align="left" style="width: 980px; background-color:#FFFFFF">
                            <table cellspacing="0" cellpadding="0" width="100%" border="0" id="maintable">
                                <tbody>
                                    <tr>
                                        <td bgcolor="#ffffff" style="padding: 10px">
                                            <br />
                                            <b id="lbl_Createdatails">
                                                <span id="Label1">Material Creation Details</span>
                                                &nbsp;(<span id="lbl_requestNoCreate">@Model.RequestNo</span>)
                                            </b>
                                            <br />
                                            <!-- Replacing WebForms GridView with a Razor-friendly table while preserving original id/class -->
                                            <table id="gvMMCreationDetail"
                                                   width="100%" cellpadding="0" cellspacing="0" border="0"
                                                   class="tableGridView">
                                                <thead>
                                                    <tr class="grdHeader" style="height:22px;">
                                                        <th style="vertical-align:top; text-align:left;">MM. ID</th>
                                                        <th style="vertical-align:top; text-align:left;">Description</th>
                                                        <th style="vertical-align:top; text-align:left;">Specification</th>
                                                        <th style="vertical-align:top; text-align:left;">Old M.Type</th>
                                                        <th style="vertical-align:top; text-align:left;">New M.Type</th>
                                                        <th style="vertical-align:top; text-align:left;">Old M.Group</th>
                                                        <th style="vertical-align:top; text-align:left;">New M.Group</th>
                                                        <th style="vertical-align:top; text-align:left;">OldV. Class</th>
                                                        <th style="vertical-align:top; text-align:left;">NewV.Class</th>
                                                    </tr>
                                                </thead>

                                                @if (Model.CreationDetails == null || !Model.CreationDetails.Any())
                                                {
                                                    <!-- EmptyDataTemplate equivalent -->
                                                    <tbody>
                                                        <tr>
                                                            <td colspan="9">
                                                                <div style="text-align: center; background-color: Aqua;">
                                                                    No Data Changes by PPC
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                }
                                                else
                                                {
                                                    <tbody>
                                                        @{
                                                            var alt = false;
                                                        }
                                                        @foreach (var item in Model.CreationDetails)
                                                        {
                                                            var rowClass = "grdrow"; // preserving RowStyle class for each row
                                                            alt = !alt;              // alternation kept if you style via CSS

                                                            <tr class="@rowClass" style="background-color:White; color:#5D838C;">
                                                                <td style="vertical-align:top; text-align:left;">@item.MMDETAILHID</td>
                                                                <td style="vertical-align:top; text-align:left;">@item.MATERIALDISCRIPTION</td>
                                                                <td style="vertical-align:top; text-align:left;">@item.MATERIALSPECIFICATION</td>
                                                                <td style="vertical-align:top; text-align:left;">@item.MATERIALTYPE</td>
                                                                <td style="vertical-align:top; text-align:left;">@item.MOD_MATERIALTYPE</td>
                                                                <td style="vertical-align:top; text-align:left;">@item.MATERIALGROUP</td>
                                                                <td style="vertical-align:top; text-align:left;">@item.MOD_MATERIALGROUP</td>
                                                                <td style="vertical-align:top; text-align:left;">@item.VALUATIONCLASS</td>
                                                                <td style="vertical-align:top; text-align:left;">@item.MOD_VALUATIONCLASS</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                }

                                                <!-- PagerStyle equivalent placeholder (hook up to your paging logic as needed) -->
                                                <tfoot>
                                                    <tr class="PagerStyle">
                                                        <td colspan="9">
                                                            @* Place your pager controls here to mimic gvMMCreationDetail_PageIndexChanging *@
                                                            @if (Model.Pager != null)
                                                            {
                                                                <div>
                                                                    <a class="pager-prev" href="@Model.Pager.PreviousUrl" aria-label="Previous">Prev</a>
                                                                    <span class="pager-page">@Model.Pager.CurrentPage</span>
                                                                    <a class="pager-next" href="@Model.Pager.NextUrl" aria-label="Next">Next</a>
                                                                </div>
                                                            }
                                                        </td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                           </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </form>
</body>
</html>