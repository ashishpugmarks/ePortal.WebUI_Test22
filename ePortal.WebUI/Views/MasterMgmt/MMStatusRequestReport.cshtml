@{
    ViewBag.Title = "Materila Master Create Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
   // Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles{
    <link href="~/css/index.css" rel="stylesheet" type="text/css" />
    <link href="~/app/CSS/MasterMgmt/MMStatusRequestReport.css" rel="stylesheet" type="text/css" />
}
@section Scripts{
    @*<script src="~/bundle/jquery.min.js"></script>*@
    <script src="~/app/JS/MasterMgmt/MMStatusRequestReport.js" type="text/javascript"></script>  
}
<div>
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Material Master -Status Report</span>
    </div>
    <table class="table table-responsive" style="width: 100%">
        <tbody>
            <tr>
                <td align="left">
                    <div id="infoPanel" style="width: 100%; display: none;">
                        <table width="100%" style="margin-left:0px;" border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td align="center" valign="top">
                                    <table cellpadding="3" cellspacing="0" border="0" width="100%" class="tborder">
                                        <tr class="row4">
                                            <td>
                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                    <tr>
                                                        <td width="16" align="left" valign="middle">
                                                            <img src="../images/icon_info.gif" border="0" alt="" />
                                                        </td>
                                                        <td align="left" class="row4">
                                                            <span class="smalltext">
                                                                <span id="infoMsg"></span>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div id="errorPanel" style="width:100%;display:none;">
                        <table width="100%" style="margin-left:0px;" border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td align="left" valign="top">
                                    <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                        <tr class="errorbox">
                                            <td>
                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                    <tr>
                                                        <td width="16" align="left" valign="middle">
                                                            <img src="../images/icon_error.gif" border="0" alt="" />
                                                        </td>
                                                        <td align="left" class="errorbox">
                                                            <span class="smalltext">
                                                                <span id="errorMsg"></span>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <table class="table table-bordered table-hover table-responsive">
                        <tr class="row1">
                            <td valign="middle" class="smalltext" style="text-align: right; padding: 3px;">Request Id</td>
                            <td align="left" style="height: 22px; padding: 3px; padding-left: 7px !important;" valign="middle">
                                <input id="txtMMId" class="swifttext" style="width:218px;" type="text" />
                            </td>
                            <td valign="middle" class="smalltext" style="text-align: right; padding: 3px;">&nbsp;Request Type</td>
                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                &nbsp;
                                <select id="ddlRequestType" class="swiftselect" style="width:218px;">
                                    <option value="0" selected>---Select---</option>
                                    <option value="Create">Create</option>
                                    <option value="Extend">Extend</option>
                                    <option value="Update">Update</option>
                                </select>
                            </td>
                        </tr>

                        <tr class="row2">
                            <td valign="middle" class="smalltext" style="text-align: right; padding: 3px;">Material Group</td>
                            <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                &nbsp;<select id="ddlMaterialGroup" class="swiftselect" style="width:218px;">
                                    <option value="0" selected>--Select--</option>
                                    @foreach (var item in ViewBag.ddlMaterialGroup)
                                    {
                                        <option value="@item.Id">@item.Description</option>
                                    }
                                </select>
                            </td>
                            <td valign="middle" class="smalltext" style="text-align: right; padding: 3px;">&nbsp;Material Type</td>
                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                &nbsp;<select id="ddlMaterialType" class="swiftselect" style="width:218px;">
                                    <option value="0" selected>--Select--</option>
                                    @foreach (var item in ViewBag.ddlMaterialType)
                                    {
                                        <option value="@item.Id">@item.Description</option>
                                    }
                                </select>
                            </td>
                        </tr>

                        <tr class="row1">
                            <td valign="middle" class="smalltext" style="text-align: right; padding: 3px;">Valuation Class</td>
                            <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                &nbsp;<select id="ddlValuationClass" class="swiftselect" style="width:218px;">
                                    <option value="0" selected>--Select--</option>
                                    @foreach (var item in ViewBag.ddlValuationClass)
                                    {
                                        <option value="@item.Id">@item.Description</option>
                                    }
                                </select>
                            </td>
                            <td valign="middle" class="smalltext" style="text-align: right; padding: 3px;">Plant</td>
                            <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                &nbsp;<select id="ddlPlantMst" class="swiftselect" style="width:218px;">
                                    <option value="0" selected>--Select--</option>
                                    @foreach (var item in ViewBag.ddlPlantMst)
                                    {
                                        <option value="@item.Id">@item.Description</option>

                                    }
                                </select>
                            </td>
                        </tr>

                        <tr class="row2">
                            <td valign="middle" class="smalltext" style="text-align: right; padding: 3px;">Status</td>
                            <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                &nbsp;
                                <select id="ddlStatus" class="swiftselect" style="width:218px;">
                                    <option value="0" selected>---Select---</option>
                                    <option value="Closed">Closed</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Deleted">Deleted</option>
                                    <option value="Rejected">Rejected</option>
                                </select>
                            </td>
                            @{
                                var tdRequestor1 = ViewBag.tdRequestor1 ?? false;
                                var tdRequestor2 = ViewBag.tdRequestor2 ?? false;
                                var tdRequestor3 = ViewBag.tdRequestor3 ?? false;
                                var tdRequestor4 = ViewBag.tdRequestor4 ?? false;


                            }
                            @if (tdRequestor1)
                            {
                                <td id="tdRequestor1" valign="middle" class="smalltext" style="text-align: right; padding: 3px;">Requestor</td>
                            }
                            @if (tdRequestor2)
                            {
                                <td id="tdRequestor2" style="height: 22px; padding: 3px;">
                                    &nbsp;<input id="txtRequestorId" class="swifttextnew" style="width:218px;" type="text" />
                                </td>
                            }
                            @if (tdRequestor3)
                            {
                                <td id="tdRequestor3" valign="middle" class="smalltext" style="text-align: right; padding: 3px;"></td>
                            }
                            @if (tdRequestor4)
                            {
                                <td id="tdRequestor4"></td>
                            }

                        </tr>

                        <tr class="row1">
                            <td valign="middle" class="smalltext" style="text-align: right; padding: 3px;">From Date</td>
                            <td align="left" style="height: 22px; padding: 3px; padding-left: 7px !important;" valign="middle">
                                <select id="ddlDayFrom" class="swiftselect" style="width:54px;">
                                    <option value="0" selected>-DD-</option>
                                    @foreach (var item in ViewBag.ddlDayFrom)
                                    {
                                        <option value="@item.Id">@item.Code</option>
                                    }
                                </select>
                                <select id="ddlMonthFrom" class="swiftselect" style="width:70px;">
                                    <option value="0" selected>-MM-</option>
                                    @foreach (var item in ViewBag.ddlMonthFrom)
                                    {
                                        <option value="@item.Id">@item.Code</option>
                                    }
                                </select>
                                <select id="ddlYearFrom" class="swiftselect" style="width:86px;">
                                    <option value="0" selected>-YYYY-</option>
                                    @foreach (var item in ViewBag.ddlYearFrom)
                                    {
                                        <option value="@item.Id">@item.Code</option>
                                    }
                                </select>
                            </td>
                            <td valign="middle" class="smalltext" style="text-align: right; padding: 3px;">To Date</td>
                            <td align="left" style="height: 22px; padding: 3px; padding-left: 7px !important;" valign="middle">
                                <select id="ddlDayTo" class="swiftselect" style="width:54px;">
                                    <option value="0" selected>-DD-</option>
                                    @foreach (var item in ViewBag.ddlDayTo)
                                    {
                                        <option value="@item.Id">@item.Code</option>
                                    }
                                </select>
                                <select id="ddlMonthTo" class="swiftselect" style="width:70px;">
                                    <option value="0" selected>-MM-</option>
                                    @foreach (var item in ViewBag.ddlMonthTo)
                                    {
                                        <option value="@item.Id">@item.Code</option>
                                    }
                                </select>
                                <select id="ddlYearTo" class="swiftselect" style="width:86px;">
                                    <option value="0" selected>-YYYY-</option>
                                    @foreach (var item in ViewBag.ddlYearTo)
                                    {
                                        <option value="@item.Id">@item.Code</option>
                                    }
                                </select>
                            </td>
                        </tr>

                        <!-- CR5865 -->
                        <tr class="row2">
                            <td valign="middle" class="smalltext" style="text-align: right; padding: 3px;">Material Code</td>
                            <td colspan="3" align="left" style="height: 22px; padding: 3px; padding-left: 7px !important;" valign="middle">
                                <input id="txtMetrialCode" class="swifttext" maxlength="10" style="width:218px;" type="text" />
                            </td>
                        </tr>

                        <tr>
                            <td colspan="4" align="center">
                                <button id="btnSubmit" class="btn btn-success btn-sm" type="button">Search</button>
                                <button id="btnCancel" class="btn btn-secondary btn-sm" type="button">Cancel</button>
                                <button id="btnExport" class="btn btn-primary btn-sm" type="button" disabled>Export</button>

                                <span id="lblrecordfound" style="float: right; color: Green; font-weight: bold; padding-right: 10px;"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4">
                                <div id="tableApprovalGrids" style="padding-left: 1px; padding-right: 1px;">
                                </div>
                            </td>
                        </tr>
                    </table>
                    <!-- Approval Grid -->

                    <table cellspacing="0" cellpadding="0" width="100%" border="0" class="table table-bordered table-hover table-responsive">
                        <tbody>
                            <tr>
                                <td style="height: 24px; width: 23px;" valign="middle" align="left">
                                    <a title="Back" href="/Home/home">
                                        <img src="~/images/icon_back.gif" border="0" alt="" />
                                    </a>
                                </td>
                                <td style="height: 24px; width: 758px;" align="left">
                                    <span class="smalltext"><a title="Back" href="../../Home/home">Back</a></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
    <div id="ajaxLoader"></div>
</div>