@section Scripts{
  
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

        $(document).ready(function () {
            $('#ddlMasterType').on('change', function () {
                GetReportDetails();
            });
        });

       

        function GetReportDetails() {
                    
            const $ddl = $('#ddlMasterType');
            const $uomPanel = $('#uomPanel');
            const $groupPanel = $('#groupPanel');
            const $typePanel = $('#typePanel');
            const $valuationPanel = $('#valuationPanel');
            const $sitePanel = $('#sitePanel');
            const $submitPanel = $('#submitPanel');
            const $trSales = $('#trSales');
            const $trPlantName = $('#trPlantName');
            const $errorPanel = $('#errorpanel');
            const $infoPanel = $('#infoPanel');
            const $lblHeadSales = $('#lblHeadSales');//dataList
            const $dataList = $('#dataList');

            function hideAllPanels() {
                $uomPanel.hide();
                $groupPanel.hide();
                $typePanel.hide();
                $valuationPanel.hide();
                $sitePanel.hide();
                $submitPanel.hide();
                $trSales.hide();
                $trPlantName.hide();
                $dataList.hide();
            }
            hideAllPanels();
            const val = parseInt($ddl.val(), 10) || 0;
            if (val == 0) {
                return;
            }
            switch (val) {
                case 1:
                    $uomPanel.show();
                    $submitPanel.show();
                    $dataList.show();
                    break;

                case 2:
                    $groupPanel.show();
                    $submitPanel.show();
                    $dataList.show();
                    break;

                case 3:
                    $typePanel.show();
                    $submitPanel.show();
                    $dataList.show();
                    break;

                case 4:
                    $valuationPanel.show();
                    $submitPanel.show();
                    $dataList.show();
                    break;

                case 5:
                    $sitePanel.show();
                    $submitPanel.show();
                    $dataList.show();
                    break;

                case 11:
                    $trPlantName.show();
                    $trSales.show();
                    $submitPanel.show();
                    $dataList.show();
                    //setSalesHeaderFromDdl();
                    //refreshGrid(val);
                    break;

                case 6:
                case 7:
                case 8:
                case 9:
                case 10:
                case 12:
                    $trPlantName.hide();
                    $trSales.show();
                    $submitPanel.show();
                    //setSalesHeaderFromDdl();
                    //refreshGrid(val);
                    $dataList.show();
                    break;

                default:
                   
            }


                var data = {
                    SelectedMasterEntry: $('#ddlMasterType').val()
                };
            $.ajax({
                type: "POST",
                url: "/MasterMgmt/MMUOMGroupTypeValuationMatrixIndexChanged",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                dataType: "html",
                beforeSend: function () {
                    $("#ajaxLoader").addClass('loader');
                },
                success: function (response) {
                    $('#div_gvList').html(response);
                },
                error: function (xhr, status, errorThrown) {
                    console.error("AJAX error:", status, errorThrown);
                    sweetAlert("Oops...", "Something went wrong!", "error");
                },
                complete: function () {
                    $("#ajaxLoader").removeClass('loader');
                }
            });
        }

        function FnValidate() {
            var selectval = document.getElementById("ddlMasterType").value;
            var rtrn = false;
            if (selectval == 1) {
                //  type is mandatory
                if (false == FnValidateTextRquired(document.getElementById("txtUOM"), "unit of measurement type is mandatory")) {
                    return false;
                }
                // Description is mandatory
                else if (false == FnValidateTextRquired(document.getElementById("txtUOMDesc"), "unit of measurement description is mandatory")) {
                    return false;
                }
                else {
                    document.getElementById("txtUOM").focus();
                    return true;
                }
            }
            else if (selectval == 2) {
                //  type is mandatory
                if (false == FnValidateTextRquired(document.getElementById("txtMaterialGroup"), "Material Group type is mandatory")) {
                    return false;
                }
                // Description is mandatory
                else if (false == FnValidateTextRquired(document.getElementById("txtMaterialGroupDesc"), "Material Group description is mandatory")) {
                    return false;
                }
                else {
                    document.getElementById("txtMaterialGroup").focus();
                    return true;
                }
            }
            else if (selectval == 3) {
                //  type is mandatory
                if (false == FnValidateTextRquired(document.getElementById("txtMaterialType"), "Material type  is mandatory")) {
                    return false;
                }
                // Description is mandatory
                else if (false == FnValidateTextRquired(document.getElementById("txtMaterialTypeDesc"), "Material type description is mandatory")) {
                    return false;
                }
                else if (false == FncheckInp(document.getElementById("txtMaterialType"), "Enter alphanumeric value is mandatory")) {
                    return false;
                }
                else {
                    document.getElementById("txtMaterialType").focus();
                    return true;
                }
            }
            else if (selectval == 4) {
                //  type is mandatory
                if (false == FnValidateTextRquired(document.getElementById("txtValuation"), "Valuation Class type is mandatory")) {
                    return false;
                }
                // Description is mandatory
                else if (false == FnValidateTextRquired(document.getElementById("txtValuationDesc"), "Valuation Class description is mandatory")) {
                    return false;
                }
                else if (false == FncheckInp(document.getElementById("txtValuation"), "Enter alphanumeric value is mandatory")) {
                    return false;
                }
                else {
                    document.getElementById("txtValuation").focus();
                    return true;
                }
            }
            else if (selectval == 11) {
                if (false == FnValidateDDLRequired(document.getElementById("ddlPlantSL"), "Plant is mandatory")) {
                    return false;
                }
                //  type is mandatory
                if (false == FnValidateTextRquired(document.getElementById("txtCodeSales"), "Code is mandatory")) {
                    return false;
                }
                // Description is mandatory
                else if (false == FnValidateTextRquired(document.getElementById("txtCodeSales"), "Description is mandatory")) {
                    return false;
                }
                else {
                    document.getElementById("txtCodeSales").focus();
                    return true;
                }
            }
            else if (selectval == 6 || selectval == 7 || selectval == 8 || selectval == 9 || selectval == 10 || selectval == 12) {
                //  type is mandatory
                if (false == FnValidateTextRquired(document.getElementById("txtCodeSales"), "Code is mandatory")) {
                    return false;
                }
                // Description is mandatory
                else if (false == FnValidateTextRquired(document.getElementById("txtCodeSales"), "Description is mandatory")) {
                    return false;
                }
                else {
                    document.getElementById("txtCodeSales").focus();
                    return true;
                }
            }
            else if (selectval == 5) {
                var btn = document.getElementById('btnSubmit').value;
                if (btn == "Submit") {
                    //Site name is mandatory
                    if (false == FnValidateDDLRequired(document.getElementById("ddlPlantMst"), "Site Name is mandatory")) {
                        return false;
                    }
                    // Description is mandatory
                    else if (false == FnValidateTextRquired(document.getElementById("txtPlantName"), "Plant Name is mandatory")) {
                        return false;
                    }
                    else if (false == FnValidateTextRquired(document.getElementById("txtPlantCode"), "Plant Code is mandatory")) {
                        return false;
                    }
                    else if (false == FnValidateTextRquired(document.getElementById("txtProfitCenter"), "Profit Center is mandatory")) {
                        return false;
                    }
                    else {
                        document.getElementById("txtPlantName").focus();
                        return true;
                    }

                }
                else if (btn == "Update") {
                    // Description is mandatory
                    if (false == FnValidateTextRquired(document.getElementById("txtPlantName"), "Plant Name is mandatory")) {
                        return false;
                    }
                    else if (false == FnValidateTextRquired(document.getElementById("txtPlantCode"), "Plant Code is mandatory")) {
                        return false;
                    }
                    else if (false == FnValidateTextRquired(document.getElementById("txtProfitCenter"), "Profit Center is mandatory")) {
                        return false;
                    }
                    else {
                        document.getElementById("txtPlantName").focus();
                        return true;
                    }
                }
                else {
                    return true;
                }

            }
            else {
                return true;
            }
        }
      
        function FnValidateDDLRequired(ctrlDDL, msg) {
            if (ctrlDDL.options[ctrlDDL.selectedIndex].value == "0") {
                return ShowError(ctrlDDL, msg);
            }
        }

        function FnValidateTextRquired(ctrlText, msg) {
            if (ctrlText.value == "") {
                return ShowError(ctrlText, msg);
            }
        }
      
        function ShowError(ctrl, msg) {
            document.getElementById("infoPanel").style.display = "none";
            document.getElementById("errorpanel").style.display = "inline";
            document.getElementById("errorMsg").innerHTML = msg;
            ctrl.focus();
            return false;
        }

        function FncheckInp(ctrlTxt, msg) {
            var alphanum = ctrlTxt.value;
            var regex = /^[A-Za-z0-9\s]+$/;
            if (!alphanum.match(regex)) {
                return ShowError(ctrlTxt, msg);
            }
        }

    </script>
}


