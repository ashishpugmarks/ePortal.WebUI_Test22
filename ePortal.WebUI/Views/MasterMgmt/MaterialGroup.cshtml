
@{
    ViewBag.Title = "";
}
<link href="..//css/index.css" rel="stylesheet" type="text/css" />
<script type="text/javascript" src="../includes/Js/CalendarPopup.js"></script>
<div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
    <span style="padding-left: 10px;">Material Group</span>
</div>
<div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
    
    <table style="width: 100%">
        <tbody>
            <tr>
                <td colspan="8">
                    <!-- asp:Panel -> div; same id -->
                    <div id="errorpanel" style="width:100%">
                        <table class="table table-hover table-responsive" style="width: 98%; margin-left: 9px;" cellspacing="0" cellpadding="0">
                            <tr>
                                <td align="left" valign="top">
                                    <table cellpadding="3" cellspacing="0" border="0" width="100%" class="table table-bordered table-hover table-responsive">
                                        <tbody>
                                            <tr class="errorbox">
                                                <td>
                                                    <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                        <tr>
                                                            <td width="16" align="left" valign="middle">
                                                                ../images/icon_error.gif
                                                            </td>
                                                            <td align="left" class="errorbox">
                                                                <!-- asp:Label -> span; same id -->
                                                                <span class="smalltext">&nbsp;<span id="status"></span></span>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>

            <tr>
                <td class="smalltext" colspan="8">
                    <table class="table table-bordered table-hover table-responsive" width="99%">
                        <tr class="row1">
                            <td colspan="4" class="HeaderStyle123">Material Group Details</td>
                        </tr>

                        <tr class="row2">
                            <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                Material Group<span style="color: #ff0000">*</span>
                            </td>
                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                <!-- asp:TextBox -> input; same id and class -->
                                <input id="TextBox5" rows="5" class="form-control" maxlength="40" style="width:300px" />
                            </td>
                        </tr>

                        <tr class="row2">
                            <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                Description<span style="color: #ff0000">*</span>
                            </td>
                            <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                <!-- asp:TextBox -> input; same id and class -->
                                <input id="TextBox1" rows="5" class="form-control" maxlength="40" style="width:300px" />
                            </td>
                        </tr>

                        <tr>
                            <td align="center" colspan="2">
                                <!-- asp:Button -> button; same id and class -->
                                <button id="Button1" class="btn btn-success btn-sm" type="submit">Submit</button>
                                <input class="btn btn-secondary btn-sm" type="reset" value="Cancel" id="cmdReset" onclick="fnReset();" />
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            <tr>
                <td align="left" colspan="8" style="padding-bottom: 5px; padding-left: 5px; padding-right: 5px; padding-top: 3px;">
                    <table cellpadding="0" cellspacing="0" border="0" width="99%">
                        <tr>
                            <td align="center" style="padding-top: 5px; padding-bottom: 5px;" colspan="4">
                                <!-- asp:GridView -> plain table; same id -->
                                <table id="gvList" style="width:100%;" cellpadding="4">
                                    <thead>
                                        <tr style="background-color:#5D7B9D; color:white; font-weight:bold;">
                                            <th style="vertical-align:top; text-align:left;">&nbsp;Material Group</th>
                                            <th style="vertical-align:top; text-align:left;">&nbsp;Description</th>
                                            <th>Edit</th>
                                            <th>Delete</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @* Example row rendering; replace with your data *@
                                        @*
                                            @foreach (var row in Model.Items)
                                            {
                                                <tr style="background-color:#F7F6F3; color:#333333;">
                                                    <td style="vertical-align:top; text-align:left;">@row.dPlant</td>
                                                    <td style="vertical-align:top; text-align:left;">@row.dMaterialDesc</td>
                                                    <td>
                                                        ../images/icon_edit.gif
                                                    </td>
                                                    <td>
                                                        ../Images/icon_delete.gif
                                                    </td>
                                                </tr>
                                            }
                                        *@
                                    </tbody>
                                </table>
                                @* Styles from original GridView preserved via inline styles above *@
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            <tr>
                <td colspan="8">
                    <table class="table table-bordered table-hover table-responsive">
                        <tbody>
                            <tr>
                                <td style="height: 24px; width: 23px;" valign="middle" align="left">
                                    /Home/Home
                                    ../images/icon_back.gif
                                    </a>
                                </td>
                                <td style="height: 24px;" align="left">
                                    <span class="smalltext">
                                        /Home/HomeBack</a>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>

    

    </div>