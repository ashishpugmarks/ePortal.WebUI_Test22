@model ePortal.ViewModels.APPX.MasterMgmt.MMUOMGroupTypeValuationMatrix
@{
    ViewBag.Layout = null;
}
<script type="text/javascript" nonce="@Context.Items["ScriptNonce_4"]">
    $('.homeContent').removeClass('homeContent');
    $(document).ready(function () {
        if ($.fn.DataTable.isDataTable("#tbRequestReport")) {
            $("#tbRequestReport").DataTable().clear().destroy();
        }
       

        $("#tbRequestReport").DataTable({
            "bFilter": false,
            "bLengthChange": false,
            "paging": true,
            "pageLength": 10,
            "ordering": false,
            "autoWidth": false
        });
      

        $('#tbRequestReport tbody').on('click', '[data-ctrl-id="bt-edit-dt"]', function (e) {
            e.preventDefault();
            EditMasterData(this);
        });


    });
</script>

<table id="tbRequestReport" class="tableMainInner tableGridView" cellpadding="0" cellspacing="0" border="0" width="100%">
    <thead class="grdHeader">
        <tr>
            @if (Model.Col1.IsVisible ?? false)
            {
                <th>&nbsp;@(Model.Col1.Header?? "Type")</th>
            }
            @if (Model.Col2.IsVisible ?? false)
            {
                <th>&nbsp;@(Model.Col2.Header?? "Description")</th>
            }
            @if (Model.Col3.IsVisible ?? false)
            {
                <th>&nbsp;@(Model.Col3.Header?? "Profit Center")</th>
            }
            @if (Model.Col4.IsVisible ?? false)
            {
                <th>&nbsp;@(Model.Col4.Header?? "SITENAME")</th>
            }
            @if (Model.Col5.IsVisible ?? false)
            {
                <th>&nbsp;@(Model.Col5.Header?? "SITEDESC")</th>
            }

            <th style="text-align:center;">Edit</th>
            <th style="text-align:center;">Delete</th>
        </tr>
    </thead>
    <tbody>
        @{
            int rowNo = 0;
        }
        @foreach (var item in Model?.MaterialGroupRecords)
        {
            string clname = "";
            int r = rowNo + 1;
            if (r % 2 == 0)
            {
                clname = "background-color: White;color: #5D838C;";
            }

            <tr class="grdrow" style="@clname">
                @if (Model.Col1.IsVisible ?? false)
                {
                    <td>@item.TYPE</td>
                }
                @if (Model.Col2.IsVisible ?? false)
                {
                    <td>@item.DESC</td>
                }
                @if (Model.Col3.IsVisible ?? false)
                {
                    <td>@item.Code</td>
                }
                @if (Model.Col4.IsVisible ?? false)
                {
                    <td>@item.SITENAME</td>
                }
                @if (Model.Col5.IsVisible ?? false)
                {
                    <td>@item.SITEDESC</td>
                }

                <td style="text-align:center;">
                    <a asp-action="Edit" asp-route-id="@item.TYPEID"
                       onclick="return confirm('Are you sure to edit this record?');">
                        <img src="~/images/icon_edit.gif" alt="edit" title="Click here to edit record" />
                    </a>
                </td>
                <td style="text-align:center;">
                    <a asp-action="Delete" asp-route-id="@item.TYPEID"
                       onclick="return confirm('Are you sure to delete this record?');">
                        <img src="~/images/icon_delete.gif" alt="delete" title="Click here to delete record" />
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
