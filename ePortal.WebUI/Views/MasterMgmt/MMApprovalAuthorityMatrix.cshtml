@section Scripts{
    <script type="text/javascript">
        // To validate the form for Add more

        function FnValidate() {
            var rtrn = false;
            var radioButtonlist = document.getElementById("<%=RadioBtnApprovalAuth.ClientID%>");
            var radio = radioButtonlist.getElementsByTagName("input");
            var label = radioButtonlist.getElementsByTagName("label");
            for (var i = 0; i < radio.length; i++) {

                if (radio[i].checked) {
                    if (label[i].innerHTML == "PPC") {
                        // Plant Type is mandatory
                        if (false == FnValidateDDLRequired(document.getElementById("<% =ddlPlantMst.ClientID %>"), "Plant Type is mandatory")) {
                            return false;
                        }
                        // Master Type is mandatory
                        else if (false == FnValidateDDLRequired(document.getElementById("<% =ddlMastertype.ClientID %>"), "Master Type is mandatory")) {
                            return false;
                        }
                        // Authorization Authority Type code is mandatory
                        else if (false == FnValidateTextRquired(document.getElementById("<% =TxtEmpCode.ClientID %>"), "Authorization Authority Type is mandatory")) {
                            return false;
                        }
                        // Master Type is mandatory
                        else if (false == FnValidateDDLRequired(document.getElementById("<% =ddlOperation.ClientID %>"), "Operation Type is mandatory")) {
                            return false;
                        }
                        // Master Type is mandatory
                        else if (false == FnValidateDDLRequired(document.getElementById("<% =ddlDivision.ClientID %>"), "Division Type is mandatory")) {
                            return false;
                        }
                        // Authorization Authority Type code is mandatory
                        else if (false == FnValidateTextRquired(document.getElementById("<% =TxtEmpCode.ClientID %>"), "Authorization Authority Type is mandatory")) {
                            return false;
                        }
                        else {
                            return true;
                        }
                    }
                    else if (label[i].innerHTML == "FINANCE") {
                        var rtrn = false;

                        // Plant Type is mandatory
                        if (false == FnValidateDDLRequired(document.getElementById("<% =ddlPlantMst1.ClientID %>"), "Plant Type is mandatory")) {
                            return false;
                        }
                        // Master Type is mandatory
                        else if (false == FnValidateDDLRequired(document.getElementById("<% =ddlMastertype1.ClientID %>"), "Master Type is mandatory")) {
                            return false;
                        }
                        // Authorization Type Emp code is mandatory
                        else if (false == FnValidateTextRquired(document.getElementById("<% =TxtEmpCode1.ClientID %>"), "Authorization Authority Type is mandatory")) {
                            return false;
                        }
                        else {
                            return true;
                        }
                    }

                    else if (label[i].innerHTML == "SIS") {
                        var rtrn = false;

                        // Authorization Type Emp code is mandatory
                        //Changed by TTL on 05-Sep-2025 against SR106375 > CR6998
                        if (false == FnValidateTextRquired(document.getElementById("<% =TxtSISUser.ClientID %>"), "IT Authority Type is mandatory")) {
                            return false;
                        }
                        // Authorization Type Emp code is mandatory
                        //Changed by TTL on 05-Sep-2025 against SR106375 > CR6998
                        else if (false == FnValidateTextRquired(document.getElementById("<% =lblSISEmp.ClientID %>"), "IT Authority Name is mandatory")) {
                            return false;
                        }
                        else {
                            return true;
                        }
                    }

                    //alert("SelectedText = " + label[i].innerHTML);  alert("SelectedValue = " + radio[i].value);

                }

            }

        }


        // To check validation for Drop Down List for required
        function FnValidateDDLRequired(ctrlDDL, msg) {
            if (ctrlDDL.options[ctrlDDL.selectedIndex].value == "0") {
                return ShowError(ctrlDDL, msg);
            }
        }

        // To check validation for textbox for required
        function FnValidateTextRquired(ctrlText, msg) {
            if (ctrlText.value == "") {
                return ShowError(ctrlText, msg);
            }
        }

        // To show validation message and focus the control validating
        function ShowError(ctrl, msg) {
            document.getElementById("<% =infoPanel.ClientID %>").style.display = "none";
            document.getElementById("<% =errorpanel.ClientID %>").style.display = "inline";
            document.getElementById("<% =errorMsg.ClientID %>").innerHTML = msg;
            ctrl.focus();
            return false;
        }

    </script>
}
