@{
}
@section Scripts{
    <script type="text/javascript">
        function ValidatePage() {
            if (document.getElementById("<%= txtMaterialType.ClientID %>").value == '') {
                return ShowError(document.getElementById("<%= txtMaterialType.ClientID %>"), 'Material Type is mandatory field');
            }
            if (document.getElementById("<%= txtDescription.ClientID %>").value == '') {
                return ShowError(document.getElementById("<%= txtDescription.ClientID %>"), 'Material Description is mandatory field');
            }
            return true;
        }
        function ShowError(ctrl, msg) {
            document.getElementById("<%= errorpanel.ClientID %>").style.display = "inline";
            document.getElementById("<%= status.ClientID %>").innerHTML = msg;
            ctrl.focus();
            return false;
        }
    </script>
    <script type="text/javascript">
        function fnReset() {
            document.getElementById("<%=errorpanel.ClientID%>").style.display = "none";
        }
    </script>

}

<table class="table table-responsive" width="100%">
    <tbody>
        <tr>
            <td colspan="8">

                <div id="errorpanel" style="width:100%;">
                    <table width="98%" style="margin-left: 9px;" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td align="left" valign="top">
                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                    <tbody>
                                        <tr class="errorbox">
                                            <td>
                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                    <tr>
                                                        <td width="16" align="left" valign="middle">
                                                            <img src="../images/icon_error.gif" border="0" alt="" />
                                                        </td>
                                                        <td align="left" class="errorbox">
                                                            <span class="smalltext">&nbsp;<span id="status"></span></span>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>

                <table class="table table-bordered table-hover table-responsive" width="99%">
                    <tr class="row1">
                        <td class="HeaderStyle123" colspan="4" style="padding: 5px;">
                            <span>&nbsp;Material Type Details</span>
                        </td>
                    </tr>

                    <tr class="row2">
                        <td class="smalltext" style="text-align:right; padding:3px;">
                            Material Type<span style="color:#ff0000">*</span>
                        </td>
                        <td colspan="3" style="padding:3px;">
                            &nbsp;<input id="txtMaterialType" class="swifttext" maxlength="40" style="width:300px;" />
                        </td>
                    </tr>

                    <tr class="row2">
                        <td class="smalltext" style="text-align:right; padding:3px;">
                            Description<span style="color:#ff0000">*</span>
                        </td>
                        <td colspan="3" style="padding:3px;">
                            &nbsp;<input id="txtDescription" class="swifttext" maxlength="40" style="width:300px;" />
                        </td>
                    </tr>
                </table>

                <table class="table table-bordered table-hover table-responsive" width="99%">
                    <tr>
                        <td align="center" colspan="2" style="padding-top:5px; padding-bottom:5px;">
                            <button id="btnSubmit" class="btn btn-success">Submit</button>
                            <input class="btn btn-secondary" type="reset" value="Cancel" id="cmdReset" onclick="fnReset();" />
                        </td>
                    </tr>
                </table>

                <table class="table table-bordered table-hover table-responsive" width="99%">
                    <tr>
                        <td class="HeaderStyle123">Material Type List</td>
                    </tr>
                    <tr>
                        <td align="center" colspan="4">
                            <table id="gvList" width="100%" class="tableGridView">
                                <thead>
                                    <tr>
                                        <th>&nbsp;Plant</th>
                                        <th>&nbsp;Material Description</th>
                                        <th>Edit</th>
                                        <th>Delete</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>

                <table width="100%" class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <tr>
                            <td style="height:24px; width:23px;" valign="middle" align="left">
                                <a title="Back" href="Home/Home">
                                    <img src="../images/icon_back.gif" border="0" alt="" />
                                </a>
                            </td>
                            <td style="height:24px;" align="left">
                                <span class="smalltext">
                                    <a title="Back" href="Home/Home">Back</a>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </td>
        </tr>
    </tbody>
</table>


