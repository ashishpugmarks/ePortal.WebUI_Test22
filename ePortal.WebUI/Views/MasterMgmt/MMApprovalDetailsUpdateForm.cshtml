@model ePortal.ViewModels.APPX.MasterMgmt.MaterialApprovalUserUpdateModel

@{
    ViewBag.Title = "Materila Master Create Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
}
@section Styles{
    <link href="~/css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
        }

            .tableGridView tr th {
                color: #000000;
            }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                padding: 2px;
                line-height: 10px;
            }

        .PagerStyle table tr td {
            border: none;
            padding: 0;
        }

        .uppercase {
            text-transform: uppercase;
            BORDER-RIGHT: #888888 1px solid;
            PADDING-RIGHT: 2px;
            BORDER-TOP: #888888 1px solid;
            PADDING-LEFT: 2px;
            FONT-SIZE: 12px;
            height: 20px;
            PADDING-BOTTOM: 2px;
            BORDER-LEFT: #888888 1px solid;
            COLOR: #000000;
            PADDING-TOP: 2px;
            BORDER-BOTTOM: #888888 1px solid;
            FONT-FAMILY: Verdana, Tahoma;
            BACKGROUND-COLOR: #ffffff;
        }
        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('~/images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
    </style>
}
@section Scripts{
    <script type="text/javascript" src="~/app/js/MasterMgmt/MMApprovalDetailsUpdateForm.js" ></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
   
    </script>
}


<table class="table table-responsive">
    <tbody>
        <tr>
            <td align="left">
                <table class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <tr>
                            <td class="HeaderStyle123">
                                <h1>Material Code Approval Details Updation (PPC &amp; FIN)</h1>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="8">

                                <div id="infoPanel" style="width:100%;display:none">
                                    <table width="100%" style="margin-left: 2px;margin-right:2px" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td align="center" valign="top">
                                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="tborder">
                                                    <tbody>
                                                        <tr class="row4">
                                                            <td>
                                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                                    <tr>
                                                                        <td width="16" align="left" valign="middle">
                                                                            <img src="../images/icon_info.gif" border="0" alt="" />
                                                                        </td>
                                                                        <td align="left" class="row4">
                                                                            <span class="smalltext">
                                                                                <span id="infoMsg"></span>
                                                                            </span>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                                <div id="errorPanel" style="width:100%;display:none">
                                    <table width="100%" style="margin-left: 2px; margin-right: 2px" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td align="left" valign="top">
                                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                                    <tbody>
                                                        <tr class="errorbox">
                                                            <td>
                                                                <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                                    <tr>
                                                                        <td width="16" align="left" valign="middle">
                                                                            <img src="../images/icon_error.gif" border="0" alt="" />
                                                                        </td>
                                                                        <td align="left" class="errorbox">
                                                                            <span class="smalltext">&nbsp;<span id="errorMsg"></span></span>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                            </td>
                        </tr>

                        <tr>
                            <td class="smalltext" colspan="8">
                                <div id="tableApprovalGrids">
                                    <table class="tableMainInner table table-bordered table-hover table-responsive" width="100%">
                                        <tr class="row1">
                                            <td colspan="4" style="padding: 5px;">
                                                <h4>&nbsp;Material Details</h4>
                                            </td>
                                        </tr>

                                        <tr class="row1">
                                            <td class="smalltext" style="text-align:right;padding:3px;">Request. Id</td>
                                            <td style="padding:3px;">
                                                &nbsp;<input id="txtMMID" class="swifttext" style="width:218px;color:Gray;" value="@Model.MMHeaderDetailId" readonly />
                                            </td>
                                            <td class="smalltext" style="text-align:right;padding:3px;">Requestor ID</td>
                                            <td style="padding:3px;">
                                                &nbsp;<span id="lbl_RequestorID" style="width:193px;display:inline-block;">@Model.RequesterId</span>
                                            </td>
                                        </tr>

                                        <tr class="row2">
                                            <td class="smalltext" style="text-align:right;padding:3px;">Requestor Name</td>
                                            <td style="padding:3px;">
                                                &nbsp;<span id="lbl_RequestorName" style="width:193px;display:inline-block;">@Model.RequestorName</span>
                                            </td>
                                            <td class="smalltext" style="text-align:right;padding:3px;">Requestor Date</td>
                                            <td style="padding:3px;">
                                                &nbsp;<span id="lbl_RequestorDate" style="width:193px;display:inline-block;">@Model.RequestDate</span>
                                            </td>
                                        </tr>

                                        <tr class="row1">
                                            <td class="smalltext" style="text-align:right;padding:2px;">Status</td>
                                            <td colspan="3" style="padding:3px;">
                                                &nbsp;<span id="lbl_Status" style="width:193px;display:inline-block;">@Model.Status</span>
                                            </td>
                                        </tr>

                                        <tr class="row1">
                                            <td class="smalltext" style="text-align:right;padding:3px;">PPC User</td>
                                            <td style="padding:3px;">
                                                &nbsp;<select id="ddlPPC_User"  style="width:193px;" @(Model.EnablePPCUser?"":"disabled") >
                                                @foreach(var item in Model.PPCUsers)
                                                    {
                                                        <option value="@item.Value" selected="@item.Selected" >@item.Text</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="smalltext" style="text-align:right;padding:3px;">Finance User</td>
                                            <td style="padding:3px;">
                                                &nbsp;<select id="ddlFIN_User" style="width:193px;" @(Model.EnableFinanceUser?"":"disabled")>
                                                        @foreach (var item in Model.FinanceUsers)
                                                        {
                                                            <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                                        }
                                                    </select>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td align="center" colspan="8" style="padding-top:5px;padding-bottom:5px;">
                                <button id="btnSubmit" class="btn btn-success btn-sm">Submit</button>
                                <button id="btnCancel" class="btn btn-secondary btn-sm">Cancel</button>
                                <input type="hidden" id="hdMMHeaderIdApprove" value="@Model.MMHeaderIdApprove" />
                            </td>
                        </tr>

                        <tr>
                            <td colspan="8">
                                <table class="table table-bordered table-hover table-responsive" width="100%">
                                    <tbody>
                                        <tr>
                                            <td style="height:24px;width:23px;">
                                                <a href="/Home/Home">
                                                    <img src="../images/icon_back.gif" border="0" alt="" />
                                                </a>
                                            </td>
                                            <td>
                                                <span class="smalltext"><a href="/Home/Home">Back</a></span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </td>
        </tr>
    </tbody>
</table>
<div id="ajaxLoader"></div>

