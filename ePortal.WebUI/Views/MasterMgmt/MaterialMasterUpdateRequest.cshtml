                                                                    <option value="@item.Id" selected>@item.Description</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@item.Id">@item.Description</option>
                                                                }

                                                            }
                                                        </select>
                                                    </td>
                                                    <td class="smalltext" valign="middle" style="text-align: right; padding: 3px;width:15%;">MPN Profile</td>
