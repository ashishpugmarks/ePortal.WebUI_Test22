                                                    <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                                        &nbsp;
                                                        <select id="ddlGenItemCatgGrp" name="ddlGenItemCatgGrp" class="smalltext" style="width:193px;">
                                                            <option value="" selected>--Select--</option>
                                                            @foreach (var item in ViewBag.ddlGenItemCatgGrp)
                                                            {
                                                                <option value="@item.Code">@item.Description</option>
                                                            }
                                                        </select>
                                                    </td>
                                                </tr>

