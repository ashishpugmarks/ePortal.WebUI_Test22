                                                            @foreach (var item in ViewBag.ddlindicator)
                                                            {
                                                                <option value="@item.Id">@item.Description</option>
                                                            }
                                                        </select>
                                                    </td>
                                                </tr>

                                                <tr class="row2">
                                                    <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Specification</td>
                                                    <td align="left" style="height: 22px; padding: 3px;width:40%;" valign="middle">
                                                        &nbsp;
