                                            <table id="gvMMUpdateDraftDetail"
                                                   class="tableGridView" style="width:100%; border-collapse:collapse;">
                                                <thead  class="grdHeader" style="height:10px;">
                                                    <tr>
                                                        <th style="vertical-align:top; text-align:left;">Plant</th>
                                                        <th style="vertical-align:top; text-align:left; width:5%;">Is Sales</th>
                                                        <th style="vertical-align:top; text-align:left;">Material Code</th>
                                                        <th style="vertical-align:top; text-align:left;">Description</th>
                                                        <th style="vertical-align:top; text-align:left;">Specification</th>
                                                        <th style="vertical-align:top; text-align:left;">MPN Profile</th>
                                                        <th style="vertical-align:top; text-align:left; width:5%;">HSN Code</th>
                                                        <th style="vertical-align:top; text-align:left; width:5%;">Indicator</th>
                                                        <th style="vertical-align:top; text-align:left; width:5%;">Profit Centre</th>
                                                        <th style="vertical-align:top; text-align:left; width:5%;">UOM</th>
                                                        <th style="vertical-align:top; text-align:left;">Sp. Mat. Status</th>
                                                        <th style="vertical-align:top; text-align:left;">Distr. Chanel</th>
                                                        <th style="vertical-align:top; text-align:left;">Item Catg. Grp</th>
                                                        <th style="vertical-align:top; text-align:left;">Trans. Grp</th>
                                                        <th style="vertical-align:top; text-align:left;">Avail. Check</th>
                                                        <th style="vertical-align:top; text-align:left;">Tax Class.</th>
                                                        <th style="vertical-align:top; text-align:left;">Loading Grp.</th>
                                                        <th style="vertical-align:top; text-align:left;">Edit</th>
                                                        <th style="vertical-align:top; text-align:left;">Delete</th>
                                                    </tr>
                                                </thead>

                                                <tbody id="gvMMUpdateDraftDetailBody">
                                                    @if (ViewBag.gvMMUpdateDraftDetail != null)
                                                    {
                                                        @foreach (var row in ViewBag.gvMMUpdateDraftDetail)
                                                        {
                                                            <tr class="grdrow" style="background-color:White; color:#5D838C;">
                                                                <td style="vertical-align:top; text-align:left;">@row.PLANTNAMEDESC</td>
                                                                <td style="vertical-align:top; text-align:left; width:5%;">@row.IsSales</td>
                                                                <td style="vertical-align:top; text-align:left;">@row.MATERIALCODE</td>
                                                                <td style="vertical-align:top; text-align:left;">@row.MATERIALDISCRIPTION</td>
                                                                <td style="vertical-align:top; text-align:left;">@row.MATERIALSPECIFICATION</td>
                                                                <td style="vertical-align:top; text-align:left;">@row.MPN_PROFILE</td>
                                                                <td style="vertical-align:top; text-align:left; width:5%;">@row.HSNCODE</td>
                                                                <td style="vertical-align:top; text-align:left; width:5%;">@row.INDICATOR</td>
                                                                <td style="vertical-align:top; text-align:left; width:5%;">@row.PROFITCENTER</td>
                                                                <td style="vertical-align:top; text-align:left; width:5%;">@row.UOM</td>
                                                                <td style="vertical-align:top; text-align:left;">@row.PLANT_SP_MAT_STATUS</td>
                                                                <td style="vertical-align:top; text-align:left;">@row.DISTRI_CHN</td>
                                                                <td style="vertical-align:top; text-align:left;">@row.ITEM_CATG_GRP</td>
                                                                <td style="vertical-align:top; text-align:left;">@row.TRANSPORTATIONGROUP</td>
                                                                <td style="vertical-align:top; text-align:left;">@row.AVAIL_CHK</td>
                                                                <td style="vertical-align:top; text-align:left;">@row.TAX_CLASSIFICATION</td>
                                                                <td style="vertical-align:top; text-align:left;">@row.LOADINGGROUP</td>
                                                                <td>                                                                   
                                                                    <img src="../images/icon_edit.gif" data-ctr-edit="EditItem" data-id="@row.MMDETAILID" alt="Edit" style="cursor:pointer" />
                                                                </td>
                                                                <td>
                                                                    <img src="../Images/icon_delete.gif" data-ctr-delete="DeleteItem" data-id="@row.MMDETAILID" alt="Delete" style="cursor:pointer" />                                                                    
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr class="grdrow">
                                                            <td colspan="19" style="text-align:center;">No records found.</td>
                                                        </tr>
                                                    }
                                                </tbody>


                                            </table>
                                        </td>
                                    </tr>

                                </table>

                            </div>
                        </td>
                    </tr>
