                                                        &nbsp;
                                                        <select id="ddlMPNProfile" class="smalltext" name="ddlMPNProfile">
                                                            @foreach (var item in ViewBag.ddlMPNProfile)
                                                            {
                                                                <option value="@item.Code">@item.Description</option>
                                                            }
                                                        </select>
                                                    </td>
                                                </tr>

                                                <tr class="row2">
                                                    <td valign="middle" class="smalltext" style="text-align: right; padding: 3px;width:15%;">HSN Code</td>
