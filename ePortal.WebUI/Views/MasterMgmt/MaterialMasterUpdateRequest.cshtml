                                        <td style="width:40%;">&nbsp;<input id="txtMaterialCode" class="swifttext" maxlength="10" style="width:193px;" /></td>
                                        <td id="lbl_textDesc" class="smalltext" style="text-align:right;width:15%;">
                                            <span id="lblDescL" style="display:none;">Description</span>
                                        </td>
                                        <td>&nbsp;<span id="lbl_Description" style="width:193px;"></span></td>
                                    </tr>

                                    <tr class="row2">
                                        <td class="smalltext" style="text-align:right;width:15%;"><span id="lblMaterialType">Material Type</span></td>
                                        <td style="width:40%;">&nbsp;
