@model ePortal.ViewModels.APPX.MasterMgmt.MMApprovalViewModel
@{
    Layout = null;
}
<html>
<head>
    <title>Material Master Request : Details</title>
    <link media="all" href="~/ASPXView/Styles/index.css" type="text/css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_2"]">
        table {
        }

        .tableMainInner tr td, .tableMainOuter tr td {
            line-height: 20px;
        }

        .tableMainInner, .tableMainInner textarea, .tableMainInner input, select.swiftselect, select.swiftselect option {
            font-size: 11px;
            border-collapse: collapse;
            color: #000000;
            font-family: Verdana, Tahoma;
        }

            .tableMainInner tr td {
                border: solid 1px #CCDCE0;
                padding: 0;
            }

                .tableMainInner tr td.heading {
                    text-align: right;
                }

        .oneRow {
            white-space: nowrap;
            padding: 0 2px 0 2px;
        }

        .tableGridView {
            border-collapse: collapse;
        }

            .tableGridView tr th, .tableGridView tr td {
                border: 1px solid Silver;
                line-height: 20px;
                font-family: Verdana, Arial, Helvetica;
                font-size: 11px;
                padding: 2px;
            }

            .tableGridView tr th {
                background: url(../images/bg_header.jpg) #cae8ea no-repeat;
            }

        .style1 {
            width: 780px;
            height: 582px;
        }
    </style>
    <script type="text/javascript" nonce="">
        $(document).ready(function () {
            $("#gvMMApprovalDetail tbody").on('click', '[data-ctrl="ViewDetails"]', function (e) {
                e.preventDefault();
                let urlvar = $(this).attr('data-id');
                let IsEnable = $(this).attr('data-ctrl-id');
                if (IsEnable) {
                    openPopup(urlvar, 980, 760);
                }
                
            });
        });
        function openPopup(strOpenUrl, width, height) {
            window.open(
                strOpenUrl,
                'mywindow',
                'TOOLBAR=no,MENUBAR=no,RESIZABLE=no,SCROLLBARS=yes,LOCATION=no,DIRECTORIES=no,STATUS=no' +
                `,width=${width},height=${height}`
            );
        }
    </script>
</head>
<body>
    <div>
        <table cellspacing="0" cellpadding="0" width="100%" border="0">
            <tbody>
                <tr>
                    <td valign="top" align="left" class="style1">
                        <table cellspacing="0" cellpadding="0" width="100%" border="0" id="maintable">
                            <tbody>
                                <tr>
                                    <td bgcolor="#ffffff" style="padding: 10px">
                                        <br />
                                        <b>Request Details</b>
                                        <table class="tableGridView" width="100%" border="0" cellspacing="0" cellpadding="0">
                                            <tr class="row1">
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    Requestor
                                                </td>
                                                <td align="left" valign="middle">
                                                    <span id="lblRequestor">@Model.Requestor</span>
                                                </td>
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    Requested Date
                                                </td>
                                                <td align="left" valign="middle">
                                                    <span id="lblRequestedDate">@Model.RequestedDate</span>
                                                </td>
                                            </tr>
                                            <tr class="row1">
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    Reviewed By
                                                </td>
                                                <td align="left" valign="middle">
                                                    <span id="lblRecomendationBy">@Model.RecommendationBy</span>
                                                </td>
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    Approved By
                                                </td>
                                                <td align="left" valign="middle">
                                                    <span id="lblApprovedBy">@Model.ApprovedBy</span>
                                                </td>
                                            </tr>
                                            <tr class="row2">
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    PPC Approval Authority
                                                </td>
                                                <td align="left" valign="middle">
                                                    <span id="lblPPCApprovalAuthority">@Model.PPCApprovalAuthority</span>
                                                </td>
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    Finance Approval Authority
                                                </td>
                                                <td align="left" valign="middle">
                                                    <span id="lblFinanceApprovalAuthority">@Model.FinanceApprovalAuthority</span>
                                                </td>
                                            </tr>
                                        </table>

                                        <br />
                                        <b>Approval Status</b>
                                        <table class="tableGridView" width="100%" border="0" cellspacing="0" cellpadding="0">
                                            <tr class="row1">
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    Recomendation Status
                                                </td>
                                                <td align="left" valign="middle">
                                                    <span id="lblRecomendationStatus">@Model.RecommendationStatus</span>
                                                </td>
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    Approval Status
                                                </td>
                                                <td align="left" valign="middle">
                                                    <span id="lblApprovalStatus">@Model.ApprovalStatus</span>
                                                </td>
                                            </tr>
                                            <tr class="row1">
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    PPC Status
                                                </td>
                                                <td align="left" valign="middle">
                                                    <span id="lblPPCStatus">@Model.PPCStatus</span>
                                                </td>
                                                <td valign="top" class="smalltext" style="text-align: right;">
                                                    Finance Status
                                                </td>
                                                <td align="left" valign="middle">
                                                    <span id="lblFinanceStatus">@Model.FinanceStatus</span>
                                                </td>
                                            </tr>
                                        </table>

                                        <br />
                                        <b>
                                            <span id="Label1">@("Approval Details")</span>
                                            &nbsp;(<span id="lbl_requestNo">@Model.RequestNo</span>)
                                        </b>
                                        <br />

                                        <table id="gvMMApprovalDetail" width="100%" cellpadding="0" cellspacing="0" class="tableGridView" border="0">
                                            <thead>
                                                <tr class="grdHeader" style="height:22px;">
                                                    <th style="vertical-align:top; text-align:left;">Date</th>
                                                    <th style="vertical-align:top; text-align:left;">User Id</th>
                                                    <th style="vertical-align:top; text-align:left;">User Name</th>
                                                    <th style="vertical-align:top; text-align:left;">Action</th>
                                                    <th style="vertical-align:top; text-align:left;">Remark</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.ApprovalDetails != null)
                                                {
                                                    var alt = false;
                                                    foreach (var item in Model.ApprovalDetails)
                                                    {
                                                        var rowClass = alt ? "grdrow" : "grdrow";
                                                        alt = !alt;
                                                        <tr class="@rowClass">
                                                            <td style="vertical-align:top; text-align:left;">@item.DATEADDED</td>
                                                            <td style="vertical-align:top; text-align:left;">@item.REQUESTERID</td>
                                                            <td style="vertical-align:top; text-align:left;">@item.EMPNAME</td>
                                                            <td style="vertical-align:top; text-align:left;">
                                                                <a id="hlPPCEdit" data-ctrl="ViewDetails" 
                                                                   data-ctrl-id="@item.LINKSTATUS" data-id="/MasterMgmt/MMPPCRequestChangeHistory?id=@item.STATUS&amp;Name=@item.MMHEADERDETAILID&amp;Date=@item.DATEADDED">
                                                                    <span id="lblDescriptionC1" style="text-decoration:none;">@item.STATUS</span>
                                                                </a>
                                                            </td>
                                                            <td style="vertical-align:top; text-align:left;">@item.REMARKS</td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr class="PagerStyle">
                                                    <td colspan="5"></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </td>
                                </tr>
                            </tbody>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</body>
</html>