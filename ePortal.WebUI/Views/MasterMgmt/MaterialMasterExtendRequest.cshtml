@{
    ViewBag.Title = "Material Code Extend Request (General Purchase)";
   // Layout = "~/Views/Shared/_LayoutInnerPage.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    <script type="text/javascript" src="~/app/JS/MasterMgmt/MaterialMasterExtendRequest.js"></script>
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
    </script>

}
@section Styles{
    <link type="text/css" href="~/app/CSS/MasterMgmt/MaterialMasterExtendRequest.css" rel="stylesheet" />
    <link href="~/css/index.css" rel="stylesheet" type="text/css" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_1"]">
    </style>
}
<div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
    <span style="padding-left: 10px;">Material Code Extend Request (General Purchase)</span>
    <span class="usermn">
        <a href="~/app/JS/MasterMgmt/User Manual.pdf" target="_blank">User Manual</a>
    </span>
</div>
<table style="width:100%">
    <tbody>
        <tr>
            <td colspan="8">
                <div id="infoPanel" style="width: 100%; display: none;">
                    <table width="100%" style="margin-left:0px;" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td align="center" valign="top">
                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="tborder">
                                    <tr class="row4">
                                        <td>
                                            <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                <tr>
                                                    <td width="16" align="left" valign="middle">
                                                        <img src="../images/icon_info.gif" border="0" alt="" />
                                                    </td>
                                                    <td align="left" class="row4">
                                                        <span class="smalltext">
                                                            <span id="infoMsg"></span>
                                                        </span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
                <div id="errorPanel" style="width:100%;display:none;">
                    <table width="100%" style="margin-left:0px;" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td align="left" valign="top">
                                <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                    <tr class="errorbox">
                                        <td>
                                            <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                <tr>
                                                    <td width="16" align="left" valign="middle">
                                                        <img src="../images/icon_error.gif" border="0" alt="" />
                                                    </td>
                                                    <td align="left" class="errorbox">
                                                        <span class="smalltext">
                                                            <span id="errorMsg"></span>
                                                        </span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </td>
        </tr>
        <!-- Material Details Section -->
        <tr>
            <td colspan="8" class="smalltext">
                <table cellpadding="0" cellspacing="1" border="0" width="100%">
                    <tr class="row2">
                        <td valign="middle" class="smalltext" style="text-align: right; padding: 3px;">
                            Material Code<span style="color: #ff0000">*</span>
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            <span class="mattext">
                                <input type="text" id="txtMaterialCode" class="swifttext" maxlength="10" style="width:193px" />
                            </span>
                            <span class="mattext">
                                <div id="lstSales" style="display:none">
                                    <label style="margin-right: 12px;">
                                        <input type="checkbox" id="lstSales1" name="lstSales" value="1" />
                                        Sales View with Purchase View&nbsp;&nbsp;
                                    </label>
                                    <label>
                                        <input type="checkbox" id="lstSales2" name="lstSales" value="2" />
                                        Sales View without Purchase View
                                    </label>
                                </div>
                            </span>
                        </td>

                        <td id="lbl_textDesc" valign="middle" class="smalltext" style="text-align: right; padding: 3px;display:none">
                            Description
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;<span id="lbl_Description"></span>
                        </td>
                    </tr>

                    <tr class="row1">
                        <td valign="middle" class="smalltext" style="text-align: right; padding: 3px;">
                            Plant<span style="color: #ff0000">*</span>
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;
                            <select id="ddlPlantMst" style="width:193px" class="swifttext">
                                <option value="0" selected>--Select--</option>
                                @{
                                    string selectedPlant = ViewBag.SELECTEDPLANT ?? "0";
                                }
                                @foreach (var item in ViewBag.ddlPlantMst)
                                {
                                    if (item.Id.ToString() == selectedPlant)
                                    {
                                        <option value="@item.Id" selected>@item.Description</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Id">@item.Description</option>
                                    }

                                }
                            </select>
                        </td>

                        <td id="lbl_textSpec" valign="middle" class="smalltext" style="text-align: right; padding: 3px;display:none">
                            Specification
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;<span id="lbl_Specification"></span>
                        </td>
                    </tr>

                    <tr class="row2" id="txtEmail" style="display:none;">
                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Email Id</td>
                        <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                            &nbsp;
                            <input type="text" id="txtEmailId" class="swifttext" readonly style="color: Gray; width:300px;" maxlength="40" />
                        </td>
                    </tr>

                    <tr class="row2" id="Tr101" style="display:none">
                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                            Sales Org.<span style="color: #ff0000;">*</span>
                        </td>
                        <td colspan="3" align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;
                            <input type="text" id="txtSalesOrg" class="swifttext" style="color: Gray; width:100px;" maxlength="20"
                                   value="HMSI" disabled />
                        </td>
                    </tr>

                    <tr class="row1" id="Tr102" style="display:none">
                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                            Item category group<span style="color: #ff0000;">*</span>
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;
                            <select id="ddlItemCategGroup" style="width:193px" class="swifttext">
                                <option value="" selected>--Select--</option>
                                @foreach (var item in ViewBag.ddlItemCategGroup)
                                {
                                    <option value="@item.Code">@item.Description</option>
                                }
                            </select>
                        </td>

                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                            Gen. Item Cat. Grp
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;
                            <select id="ddlGenItemCatgGrp" class="swifttext" style="width:193px;">
                                <option value="" selected>--Select--</option>
                                @foreach (var item in ViewBag.ddlGenItemCatgGrp)
                                {
                                    <option value="@item.Code">@item.Description</option>
                                }
                            </select>
                        </td>
                    </tr>

                    <tr class="row2" id="Tr103" style="display:none">
                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                            Availability check<span style="color: #ff0000;">*</span>
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;
                            <select id="ddlCheckAvailCheck" style="width:193px" class="swifttext" >
                                <option value="" selected>--Select--</option>
                                @foreach (var item in ViewBag.ddlCheckAvailCheck)
                                {
                                    <option value="@item.Code">@item.Description</option>
                                }
                            </select>
                        </td>

                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                            Tax Classification<span style="color: #ff0000;">*</span>
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;
                            <select id="ddlTaxClassiFication" style="width:193px" class="swifttext">
                                <option value="" selected>--Select--</option>
                                @foreach (var item in ViewBag.ddlTaxClassiFication)
                                {
                                    <option value="@item.Code">@item.Description</option>
                                }
                            </select>
                        </td>
                    </tr>

                    <tr class="row1" id="Tr104" style="display:none">
                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                            Transportation Group<span style="color: #ff0000;">*</span>
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;
                            <select id="ddlTrasnsportGrp" style="width:193px" class="swifttext">
                                <option value="" selected>--Select--</option>
                                @foreach (var item in ViewBag.ddlTrasnsportGrp)
                                {
                                    <option value="@item.Code">@item.Description</option>
                                }
                            </select>
                        </td>

                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                            Loading Group<span style="color: #ff0000;">*</span>
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;
                            <select id="ddlLoadingGrp" style="width:193px" class="swifttext">
                                <option value="" selected>--Select--</option>
                                @foreach (var item in ViewBag.ddlLoadingGrp)
                                {
                                    <option value="@item.Code">@item.Description</option>
                                }
                            </select>
                        </td>
                    </tr>

                    <tr class="row2" id="Tr105" style="display:none">
                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                            Storage Location<span style="color: #ff0000;">*</span>
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;
                            <select id="ddlStorageLoc" style="width:193px" class="swifttext">
                                <option value="" selected>--Select--</option>
                                @foreach (var item in ViewBag.ddlStorageLoc)
                                {
                                    <option value="@item.Code">@item.Description</option>
                                }
                            </select>
                        </td>

                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                            Profit Centre<span style="color: #ff0000;">*</span>
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;
                            <input type="text" id="txtProfitCentre" class="swifttext" style="color: Gray; width:193px;"
                                   maxlength="10" value="" disabled />
                        </td>
                    </tr>

                    <tr class="row2" id="Tr107" style="display:none">
                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                            Distribution Channel<span style="color: #ff0000;">*</span>
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            <select id="ddlDisbChnn" style="width:193px" class="swifttext">
                                <option value="" selected>--Select--</option>
                                @foreach (var item in ViewBag.ddlDisbChnn)
                                {
                                    <option value="@item.Code">@item.Description</option>
                                }
                            </select>
                        </td>

                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                            Base Unit of Measure<span style="color: #ff0000;">*</span>
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;
                            <select id="ddlBaseUnitOfMeasure" style="width:193px" class="swifttext">
                                <option value="" selected>--Select--</option>
                                @foreach (var item in ViewBag.ddlBaseUnitOfMeasure)
                                {
                                    <option value="@item.Code">@item.Description</option>
                                }
                            </select>
                        </td>
                    </tr>

                    <tr class="row2" id="Tr106" style="display:none">
                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                            Mat. Grp Pack. Matls<span style="color: #ff0000;">*</span>
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            <input type="text" id="txtMatGrpPack" class="swifttext" style="color: Gray; width:100px;"
                                   maxlength="20"
                                   value="" />
                        </td>

                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                            Packaging mat. type<span style="color: #ff0000;">*</span>
                        </td>
                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                            &nbsp;
                            <input type="text" id="txtPackagingMatType" class="swifttext" style="color: Gray; width:193px;" maxlength="10"
                                   value="" />
                        </td>
                    </tr>

                    <tr class="row2">
                        <td style="text-align: right; padding: 3px;">
                            <span style="color: #ff0000">*</span>
                        </td>
                        <td colspan="4" style="padding: 4px; color: Blue;">
                            &nbsp; Check in ZMM60 before material extend request for required plant
                        </td>
                    </tr>

                    <tr class="row1">
                        <td align="center" style="padding-top: 5px; padding-bottom: 5px;" colspan="4">
                            <button id="btnAddMore"
                                    class="btn btn-success btn-sm">Add More</button>
                            <input type="hidden" id="hdMMHeaderID" value="@ViewBag.MMHeaderIdE" />
                            <input type="hidden" id="hdMMDetailID" value="" />
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding-top: 5px; padding-bottom: 5px;" colspan="4">

                            <table id="gvList" class="tableGridView" width="100%" cellpadding="0" cellspacing="0">
                                <thead class="grdHeader">
                                    <tr style="height:22px;">
                                        <th style="text-align:left; vertical-align:top;">Plant</th>
                                        <th style="text-align:left; vertical-align:top;">Material Code</th>
                                        <th style="text-align:left; vertical-align:top;">Is Sales</th>
                                        <th style="text-align:left; vertical-align:top;">&nbsp;Material Description</th>
                                        <th style="text-align:left; vertical-align:top;">Distri. Chanel</th>
                                        <th style="text-align:left; vertical-align:top;">&nbsp;Item Catg Grp</th>
                                        <th style="text-align:left; vertical-align:top;">&nbsp;Gen. Item Catg Grp</th>
                                        <th style="text-align:left; vertical-align:top;">&nbsp;Loading Grp.</th>
                                        <th style="text-align:left; vertical-align:top;">&nbsp;Tax Class.</th>
                                        <th style="text-align:left; vertical-align:top;">&nbsp;Base Unit Measurement</th>
                                        <th style="text-align:left; vertical-align:top;">&nbsp;Availability Check</th>
                                        <th style="text-align:left; vertical-align:top;">Edit</th>
                                        <th style="text-align:left; vertical-align:top;">Delete</th>
                                    </tr>
                                </thead>
                                <tbody id="gvListtbody">

                                    @if (ViewBag.GvList != null)
                                    {
                                        foreach (var row in ViewBag.GvList)
                                        {
                                            <tr class="grdrow">
                                                <td style="vertical-align:top; text-align:left;">@row.PLANTNAME</td>
                                                <td style="vertical-align:top; text-align:left;">@row.MATERIALCODE</td>
                                                <td style="vertical-align:top; text-align:left;">@row.SALES_ORG</td>
                                                <td style="vertical-align:top; text-align:left;">@row.MATERIALDISCRIPTION</td>
                                                <td style="vertical-align:top; text-align:left;">@row.DISTRI_CHN</td>
                                                <td style="vertical-align:top; text-align:left;">@row.ITEM_CATG_GRP</td>
                                                <td style="vertical-align:top; text-align:left;">@row.GEN_ITEM_CAT_GRP</td>
                                                <td style="vertical-align:top; text-align:left;">@row.LOADINGGROUP</td>
                                                <td style="vertical-align:top; text-align:left;">@row.TAX_CLASSIFICATION</td>
                                                <td style="vertical-align:top; text-align:left;">@row.BASEUNITOFMEASURE</td>
                                                <td style="vertical-align:top; text-align:left;">@row.AVAIL_CHK</td>
                                                <td><img src="../images/icon_edit.gif" data-ctr-edit="EditItem" data-id="@row.MMDETAILID" alt="Edit" style="cursor:pointer" /></td>
                                                <td><img src="../Images/icon_delete.gif" data-ctr-delete="DeleteItem" data-id="@row.MMDETAILID" alt="Delete" style="cursor:pointer" /></td>
                                                
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr class="grdrow">
                                            <td colspan="13" style="text-align:center;">No records found.</td>
                                        </tr>
                                    }

                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        <!-- Terms and Conditions -->
        <tr>
            <td colspan="8">
                <table class="tableMainInner" cellpadding="0" cellspacing="0" border="0" width="100%">

                    <tr class="row1" id="txtapprovalauthority">
                        <td valign="top" style="text-align: right; padding: 3px;">
                            @* Approval Authority *@
                        </td>
                        <td align="left" class="smalltext" style="height: 22px; padding: 3px;" valign="middle">
                            &emsp;&emsp;&emsp;&emsp;&emsp;&emsp;&emsp;&emsp;&emsp;&emsp;&emsp;&emsp;Check Authority
                            &nbsp;

                            <select id="ddlApprovalAuthority" style="width:193px" class="swifttext">
                                <option value="0" selected>--Select--</option>                               
                                @foreach (var item in ViewBag.ddlApprovalAuthority)
                                {
                                    <option value="@item.Id">@item.Description</option> 
                                }
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="2" style="padding: 3px;">
                            <h4>Terms and conditions</h4>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="2" class="smalltext">
                            <li style="line-height: 16px; margin-top: 1px; padding-right: 5px; padding-left: 5px;">
                                I have checked/verified listed Material descriptions/specifictions doesn't exist in SAP system.
                            </li>
                            <li style="line-height: 16px; margin-top: 1px; padding-right: 5px; padding-left: 5px;">
                                Correction in (UOM/Description/Specification) can't be done, if once material code has been created in SAP system.
                            </li>
                            @*
                            <li style="line-height: 16px; margin-top: 1px; padding-right: 5px; padding-left: 5px;">
                                Material Master request will be proceed for creation and extend which finally approved
                                before 8:30 AM and result can be check
                                <br />
                                &nbsp;&nbsp;&nbsp;&nbsp;after 10:00 AM in eportal.
                            </li>
                            *@
                        </td>
                    </tr>

                    <tr>
                        <td width="3%" style="padding: 3px;">
                            <input type="checkbox" id="chkTerms" />
                        </td>
                        <td class="smalltext" style="padding-top: 4px; text-align: left;" width="97%">
                            I have read, understood &amp; agree with the above terms &amp; conditions.
                        </td>
                    </tr>

                    <tr>
                        <td align="center" style="padding-top: 5px; padding-bottom: 5px;" colspan="2">
                          
                            <button id="btnSubmit" class="btn btn-success" >
                                Submit
                            </button>
                            <button id="btnCancel" class="btn btn-secondary" type="button">
                                Cancel
                            </button>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
        <!-- Rejected Extend Material request -->
        <tr>
            <td colspan="8">
                <table class="table table-bordered table-hover table-responsive" width="100%">
                    <tr class="row1">
                        <td colspan="4" style="padding: 5px;">
                            <h4>&nbsp;Extend Request Reject Details</h4>
                        </td>
                    </tr>

                    <tr id="gridRejectExtendData" class="row1">
                        <td align="center" style="padding-top: 5px; padding-bottom: 5px;" colspan="4">


                            <table id="gvMMExtendRequest"
                                   class="tableGridView"
                                   width="100%"
                                   cellpadding="0"
                                   cellspacing="0">
                                <thead class="grdHeader" style="height:22px;">
                                    <tr>
                                        <th style="text-align:left; vertical-align:top;">Edit</th>
                                        <th style="text-align:left; vertical-align:top;">MM. ID</th>
                                        <th style="text-align:left; vertical-align:top;">Requestor ID</th>
                                        <th style="text-align:left; vertical-align:top;">Requestor Name</th>
                                        <th style="text-align:left; vertical-align:top;">Req. date</th>
                                        <th style="text-align:left; vertical-align:top;">Histroy</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @if (ViewBag.gvMMExtendRequest != null)
                                    {
                                        foreach (var row in ViewBag.gvMMExtendRequest)
                                        {
                                            <tr class="grdrow">
                                                <td style="vertical-align:top; text-align:left;">                                                   
                                                    <button id="EditMMExtendRej" class="btn p-0" type="button"
                                                            data-command="EditMMExtendRej"
                                                            data-id="@row.MMHEADERDETAILID"
                                                            style="background:none; border:none;">
                                                        <img src="../images/icon_edit.gif" alt="Initiated" />
                                                    </button>
                                                </td>

                                                <td style="vertical-align:top; text-align:left;">                                                   
                                                    <a data-id="/MasterMgmt/MaterialMasterRequestDetailHistory?id=@row.MMHEADERDETAILID">
                                                        <span id="lblDescriptionE" style="text-decoration:underline;">@row.MMHEADERDETAILID</span>
                                                    </a>
                                                </td>

                                                <td style="vertical-align:top; text-align:left;">@row.REQUESTERID</td>
                                                <td style="vertical-align:top; text-align:left;">@row.REQUESTERNAME</td>
                                                <td style="vertical-align:top; text-align:left;">@row.REQUESTDATE</td>

                                                <td style="vertical-align:top; text-align:left;">
                                                    <a data-id="/MasterMgmt/MMRequestHistoryDetails?id=@row.MMHEADERDETAILID">
                                                        <span id="lblDescriptionE1" style="text-decoration:underline;">@row.MMHEADERDETAILID</span>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                       
                                        <tr>
                                            <td colspan="6">
                                                <div style="text-align: center; background-color: #ffffff;">
                                                    No Data Found
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>


                            </table>

                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <!-- Back Button -->
        <tr>
            <td colspan="8">
                <table cellspacing="0" cellpadding="0" width="100%" border="0" class="table table-bordered table-hover table-responsive">
                    <tbody>
                        <tr>
                            <td style="height: 24px; width: 23px;" valign="middle" align="left">
                                <a title="Back" href="/Home/Home">
                                    <img src="~/images/icon_back.gif" border="0" alt="" />
                                </a>
                            </td>
                            <td style="height: 24px;" align="left">
                                <span class="smalltext"><a title="Back" href="/Home/Home">Back</a></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </tbody>
</table>
<div id="ajaxLoader"></div>