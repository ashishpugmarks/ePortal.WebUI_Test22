
@{
    ViewBag.Title = "Materila Master Create Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/ASPXView/Styles/VendorMaster.css" rel="stylesheet" type="text/css" />
    <link href="~/css/index.css" rel="stylesheet" type="text/css" />
    <link href="~/app/CSS/MasterMgmt/MaterialMasterCreateRequest.css" type="text/css" />
}

@section Scripts{
    <script type="text/javascript" src="~/app/JS/MasterMgmt/MaterialMasterCreateRequest.js"></script>
}
<div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;margin-right:15px;">
    <span style="padding-left: 10px;">Material Code Creation Request (General Purchase/Sales)</span>
    <span class="usermn" style="float:right; margin-right:10px;">
        <a href="~/app/JS/MasterMgmt/User Manual.pdf" target="_blank">User Manual</a>
    </span>
</div>

<table class="table table-responsive">
    <tr>
        <td>
            <table width="100%">
                <tbody>

                    <!-- Info Panel -->
                    <tr>
                        <td colspan="8">
                            <div id="infoPanel" style="width: 100%; display: none;">
                                <table width="100%" style="margin-left:0px;" border="0" cellspacing="0" cellpadding="0">
                                    <tr>
                                        <td align="center" valign="top">
                                            <table cellpadding="3" cellspacing="0" border="0" width="100%" class="tborder">
                                                <tr class="row4">
                                                    <td>
                                                        <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                            <tr>
                                                                <td width="16" align="left" valign="middle">
                                                                    <img src="../images/icon_info.gif" border="0" alt="" />
                                                                </td>
                                                                <td align="left" class="row4">
                                                                    <span class="smalltext">
                                                                        <span id="infoMsg"></span>
                                                                    </span>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <div id="errorPanel" style="width:100%;display:none;">
                                <table width="100%" style="margin-left:0px;" border="0" cellspacing="0" cellpadding="0">
                                    <tr>
                                        <td align="left" valign="top">
                                            <table cellpadding="3" cellspacing="0" border="0" width="100%" class="redborder">
                                                <tr class="errorbox">
                                                    <td>
                                                        <table border="0" cellpadding="5" height="25" cellspacing="1" width="100%">
                                                            <tr>
                                                                <td width="16" align="left" valign="middle">
                                                                    <img src="../images/icon_error.gif" border="0" alt="" />
                                                                </td>
                                                                <td align="left" class="errorbox">
                                                                    <span class="smalltext">
                                                                        <span id="errorMsg"></span>
                                                                    </span>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                    </tr>

                    <!-- Material Details -->
                    <tr>
                        <td class="smalltext" colspan="8">
                            <div id="tableApprovalGrids">
                                <table class="table table-bordered table-hover table-responsive" width="99%">
                                    <tr class="row2">
                                        <td class="HeaderStyle123" colspan="4" style="padding:5px;">
                                            <span>&nbsp;Material Details</span>
                                            <div style="text-align:right; float:right; padding:0; margin:0;">
                                                <a href="MMStatusRequestReport">
                                                    <div style="float:left; cursor:pointer;">
                                                        Search<img alt="Search MM Status" src="../Images/search.png" />
                                                    </div>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>

                                    <tr class="row1">
                                        <td class="smalltext" style="text-align:right; padding:3px;">
                                            Plant<span style="color:#ff0000">*</span>
                                        </td>
                                        <td style="padding:3px;">
                                            <select id="ddlPlantMst" style="width:193px;">
                                                <option value="0" selected>--Select--</option>
                                                @{
                                                    string selectedPlant = ViewBag.SELECTEDPLANT ?? "0";
                                                }
                                                @foreach (var item in ViewBag.ddlPlantMst)
                                                {
                                                    if (item.Id.ToString() == selectedPlant)
                                                    {
                                                        <option value="@item.Id" selected>@item.Description</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@item.Id">@item.Description</option>
                                                    }

                                                }
                                            </select>
                                        </td>
                                        <td class="smalltext" style="text-align:right; padding:3px;">
                                            Material Type<span style="color:#ff0000">*</span>
                                        </td>
                                        <td style="padding:3px;">
                                            <select id="ddlMaterialType" style="width:193px;">
                                                <option value="0" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlMaterialType)
                                                {
                                                    <option value="@item.Id">@item.Description</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>

                                    <tr class="row2">
                                        <td class="smalltext" style="text-align:right; padding:3px;">
                                            Material Group<span style="color:#ff0000">*</span>
                                        </td>
                                        <td style="padding:3px;">
                                            <select id="ddlMaterialGroup" style="width:193px;">
                                                <option value="0" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlMaterialGroup)
                                                {
                                                    <option value="@item.Id">@item.Description</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="smalltext" style="text-align:right; padding:3px;">
                                            Valuation Class<span style="color:#ff0000">*</span>
                                        </td>
                                        <td style="padding:3px;">
                                            <select id="ddlValuationClass" style="width:193px;">
                                                <option value="0" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlValuationClass)
                                                {
                                                    <option value="@item.Id">@item.Description</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>

                                    <tr class="row1" id="p001">
                                        <td class="smalltext" style="text-align:right; padding:3px;">
                                            Material Price
                                        </td>
                                        <td style="padding:3px;">
                                            <input type="text" id="txtPrice" class="swifttext" style="width:100px;" />
                                        </td>
                                        <td class="smalltext" style="text-align:right; padding:3px;">
                                            UOM<span style="color:#ff0000">*</span>
                                        </td>
                                        <td style="padding:3px;">
                                            <select id="ddlUOM" style="width:193px;">
                                                <option value="0" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlUOM)
                                                {
                                                    <option value="@item.Id">@item.Description</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>

                                    <tr class="row2" id="p002">
                                        <td class="smalltext" style="text-align:right; padding:3px;">
                                            HSN Code<span style="color:#ff0000">*</span>
                                        </td>
                                        <td style="padding:3px;">
                                            <input type="text" id="txthsncode" class="swifttext" style="width:100px;" />
                                        </td>
                                        <td class="smalltext" style="text-align:right; padding:3px;">
                                            Indicator<span style="color:#ff0000">*</span>
                                        </td>
                                        <td style="padding:3px;">
                                            <select id="ddlindicator" style="width:193px;">
                                                <option value="0" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlindicator)
                                                {
                                                    <option value="@item.Id">@item.Description</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>

                                    <tr class="row1">
                                        <td class="smalltext" style="text-align:right; padding:3px;">
                                            Description<span style="color:#ff0000">*</span>
                                        </td>
                                        <td colspan="3" style="padding:3px;">
                                            <input type="text" id="txtMaterialDescription"
                                                      class="uppercase"
                                                      style="font-size:10px !important; width:300px;"
                                                      maxlength="40"/>
                                        </td>
                                    </tr>

                                    <tr class="row1" id="p003" style="display: none;">
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                            Int. material number <span style="color: #ff0000">*</span>
                                        </td>
                                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            &nbsp;
                                            <input type="text" id="txtZMPNIntMaterialNo" maxlength="15" class="swifttext" style="width:150px;" />
                                        </td>
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">
                                            Description Details
                                        </td>
                                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            &nbsp;
                                            <span id="lblZMPNDesc"></span>
                                        </td>

                                    <tr class="row2" id="p004">
                                        <td class="smalltext" style="text-align:right; padding:3px;">
                                            Specification
                                        </td>
                                        <td colspan="3" style="padding:3px;">
                                            <input type="text" id="txtMaterialSpecification"
                                                      class="uppercase"
                                                      style="font-size:10px !important; width:300px;"
                                                      maxlength="40"/>
                                            &nbsp;&nbsp;&nbsp;&nbsp;
                                            <input type="checkbox" id="chSales" /> Sales View
                                        </td>
                                    </tr>

                                    <tr class="row1" id="txtEmailHide" style="display:none">
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Email Id</td>
                                        <td align="left" style="height: 22px; padding: 3px;" colspan="3" valign="middle">
                                            &nbsp;<input type="text" id="txtEmailId" style="color: Gray;" readonly rows="5" maxlength="40" class="swifttext" width="300px" />
                                        </td>
                                    </tr>

                                    <tr class="row2" id="Tr101" style="display:none;">
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Sales Org.<span style="color: #ff0000;">*</span></td>
                                        <td colspan="3" align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            &nbsp;<input type="text" id="txtSalesOrg" style="color: Gray;" maxlength="20" class="swifttext" width="100px" value="HMSI" disabled />
                                        </td>
                                    </tr>

                                    <tr class="row1" id="Tr102" style="display:none;">
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Item category group<span style="color: #ff0000;">*</span></td>
                                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            &nbsp;<select id="ddlItemCategGroup" style="width:193px;">
                                                <option value="" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlItemCategGroup)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            </select>
                                        </td>
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Gen. Item Cat. Grp<span style="color: #ff0000;">*</span></td>
                                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            &nbsp;<select id="ddlGenItemCatgGrp" style="width:193px;">
                                                <option value="" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlGenItemCatgGrp)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>

                                    <tr class="row2" id="Tr103" style="display:none;">
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Availability check<span style="color: #ff0000;">*</span></td>
                                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            &nbsp;<select id="ddlCheckAvailCheck" style="width:193px;">
                                                <option value="" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlCheckAvailCheck)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            </select>
                                        </td>
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Tax Classification<span style="color: #ff0000;">*</span></td>
                                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            &nbsp;<select id="ddlTaxClassiFication" style="width:193px;">
                                                <option value="" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlTaxClassiFication)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>

                                    <tr class="row1" id="Tr104" style="display:none;">
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Transportation Group<span style="color: #ff0000;">*</span></td>
                                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            &nbsp;<select id="ddlTrasnsportGrp" style="width:193px;">
                                                <option value="" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlTrasnsportGrp)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            </select>
                                        </td>
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Loading Group<span style="color: #ff0000;">*</span></td>
                                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            &nbsp;<select id="ddlLoadingGrp" style="width:193px;">
                                                <option value="" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlLoadingGrp)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            </select>
                                        </td>
                                    </tr>

                                    <tr class="row2" id="Tr105" style="display:none;">
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Storage Location<span style="color: #ff0000;">*</span></td>
                                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            &nbsp;<select id="ddlStorageLoc" style="width:193px;">
                                                <option value="" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlStorageLoc)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            </select>
                                        </td>
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Profit Centre<span style="color: #ff0000;">*</span></td>
                                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            &nbsp;<input type="text" id="txtProfitCentre" style="color: Gray;" maxlength="10" value="@ViewBag.PROFITCENTER" class="swifttext" width="193px" disabled />
                                        </td>
                                    </tr>

                                    <tr class="row2" id="Tr107" style="display:none;">
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Distribution Channel<span style="color: #ff0000;">*</span></td>
                                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            <select id="ddlDisbChnn" style="width:193px;">
                                                <option value="" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlDisbChnn)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            </select>

                                        </td>
                                        <td valign="top" class="smalltext" style="text-align: right; padding: 3px;">Base Unit of Measure<span style="color: #ff0000;">*</span></td>
                                        <td align="left" style="height: 22px; padding: 3px;" valign="middle">
                                            &nbsp;<select id="ddlBaseUnitOfMeasure" style="width:193px;">
                                                <option value="" selected>--Select--</option>
                                                @foreach (var item in ViewBag.ddlBaseUnitOfMeasure)
                                                {
                                                    <option value="@item.Code">@item.Description</option>
                                                }
                                            </select>

                                        </td>
                                    </tr>

                                    <tr class="row2" id="Tr106" style="display:none;">
                                        <td valign="top" class="auto-style1" style="text-align: right; padding: 3px;">Mat. Grp Pack. Matls<span style="color: #ff0000;">*</span></td>
                                        <td align="left" style="padding: 3px;" valign="middle" class="auto-style2">
                                            <input type="text" id="txtMatGrpPack" style="color: Gray;" maxlength="20" class="swifttext" width="100px" />
                                        </td>
                                        <td valign="top" class="auto-style1" style="text-align: right; padding: 3px;">Packaging mat. type<span style="color: #ff0000;">*</span></td>
                                        <td align="left" style="padding: 3px;" valign="middle" class="auto-style2">
                                            &nbsp;<input type="text" id="txtPackagingMatType" style="color: Gray;" maxlength="10" class="swifttext" width="193px" />
                                        </td>
                                    </tr>
                                    <tr class="row1">
                                        <td align="center" colspan="4" style="padding-top:5px; padding-bottom:5px;">
                                            <button id="btnAddMore"
                                                    class="btn btn-success btn-sm">
                                                Add More
                                            </button>
                                            <input type="hidden" id="hdMMHeaderID" value="@ViewBag.MMHeaderId" />
                                            <input type="hidden" id="hdMMDetailID" value="" />
                                        </td>
                                    </tr>
                                    <!-- GRID -->
                                    <tr>
                                        <td colspan="4">
                                            <table id="tblMaterialList" class="table tableGridView">
                                                <thead class="grdHeader">
                                                    <tr>
                                                        <th>Plant</th>
                                                        <th>Is Sales</th>
                                                        <th>Description</th>
                                                        <th>Specification</th>
                                                        <th>M.Type</th>
                                                        <th>M.Group</th>
                                                        <th>V.Class</th>
                                                        <th>UOM</th>
                                                        <th>Edit</th>
                                                        <th>Delete</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="draftTableBody2">
                                                    @foreach (var item in ViewBag.DraftDetails)
                                                    {
                                                        <tr>
                                                            <td>@item.PLANTNAME</td>
                                                            <td>@item.IsSales</td>
                                                            <td>@item.MATERIALDISCRIPTION</td>
                                                            <td>@item.MATERIALSPECIFICATION</td>
                                                            <td>@item.MATERIALTYPE</td>
                                                            <td>@item.MATERIALGROUP</td>
                                                            <td>@item.VALUATIONCLASS</td>
                                                            <td>@item.UOM</td>
                                                            <td><img data-ctr-edit="EditItem" data-id="@item.MMDETAILID" src="../images/icon_edit.gif" /></td>
                                                            <td><img data-ctr-delete="DeleteItem" data-id="@item.MMDETAILID" src="../Images/icon_delete.gif" /></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                    </tr>

                    <!-- Terms -->
                    <tr>
                        <td colspan="8">
                            <table class="table table-bordered table-hover table-responsive" width="99%">
                                <tr class="row1" id="txtapprovalauthority" runat="server">
                                    <td valign="top" style="text-align: right; padding: 3px;">
                                        @*Approval Authority*@
                                    </td>
                                    <td colspan="2" align="left" class="smalltext" style="height: 22px; padding: 3px;" valign="middle">
                                        &emsp; &emsp;&emsp;&emsp;&emsp;&emsp;&emsp;&emsp;&emsp;&emsp;&emsp;&emsp;Check Authority
                                        &nbsp;<select id="ddlApprovalAuthority" style="width:193px">
                                            <option value="" selected>--Select--</option>
                                            @foreach (var item in ViewBag.ddlApprovalAuthority)
                                            {
                                                <option value="@item.Id">@item.Description</option>
                                            }
</select>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="padding:3px;">
                                        <h4>Terms and conditions</h4>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" class="smalltext">
                                        <li style="line-height: 16px; margin-top: 1px; padding-right: 5px; padding-left: 5px;">
                                            I have checked/verified that requested material description/specification doesn't exists in SAP system.
                                        </li>
                                        <li style="line-height: 16px; margin-top: 1px; padding-right: 5px; padding-left: 5px;">
                                            Correction in (UOM/Description/Specification) can't be done,if once material code has been created in SAP system.
                                        </li>
                                        @*<%--<li style="line-height: 16px; margin-top: 1px; padding-right: 5px; padding-left: 5px;">
                                Material Master request will be proceed for creation and extend which finally approved
                                before 8:30 AM and result can be check
                                <br />
                                &nbsp;&nbsp;&nbsp;&nbsp;after 10:00 AM in eportal.
                            </li>--%>*@
                                    </td>
                                </tr>
                                <tr>
                                    <td width="3%" style="padding:3px;">
                                        <input type="checkbox" id="chkTerms" />
                                    </td>
                                    <td class="smalltext" style="padding-top: 4px; text-align: left;" width="97%">
                                        I have read, understood & agree with the above terms & conditions.
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" align="center" style="padding-top:5px; padding-bottom:5px;">
                                        <input type="button" id="btnSubmit" class="btn btn-success" value="Submit" />
                                        <input type="button" id="btnCancel" class="btn btn-secondary" value="Cancel" />
                                       
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td class="smalltext" colspan="8">
                            <table class="table table-bordered table-hover table-responsive" width="99%">
                                <tr class="row1">
                                    <td colspan="4" style="padding: 5px;">
                                        <h4>&nbsp;Material Create Request Reject Details</h4>
                                    </td>
                                </tr>
                                <tr id="gridRejectCreateData" runat="server" class="row1">
                                    <td align="center" colspan="4" style="padding-top: 5px; padding-bottom: 5px;">

                                        <table id="draftTable" class="table table-bordered table-hover table-responsive" width="99%">
                                            <thead class="grdHeader">
                                                <tr>
                                                    <th>Edit</th>
                                                    <th>MM. ID</th>
                                                    <th>REQUESTERID</th>
                                                    <th>REQUESTERNAME</th>
                                                    <th>REQUESTDATE</th>
                                                    <th>Histroy</th>
                                                </tr>
                                            </thead>
                                            <tbody id="draftTableBody" class="grdrow">
                                                @{
                                                    int rowNo = 0;
                                                }
                                                @if (ViewBag.RejectedDataList != null)
                                                {
                                                    foreach (var item in ViewBag.RejectedDataList)
                                                    {
                                                        string clname = "";
                                                        int r = rowNo + 1;
                                                        if (r % 2 == 0)
                                                        {
                                                            clname = " background-color: White;color: #5D838C";
                                                        }
                                                        <tr class="grdrow" style="@clname">
                                                            <td>
                                                                <img id="btnEdit" alt="RejectRequest" data-id='@item.MMHEADERID' src="../images/icon_edit.gif" />

                                                            </td>
                                                            <td>
                                                                <a data-id="/MasterMgmt/MaterialMasterRequestDetailHistory?id=@item.MMHEADERDETAILID">
                                                                    @item.MMHEADERDETAILID
                                                                </a>
                                                            </td>
                                                            <td>@item.REQUESTERID </td>
                                                            <td>@item.REQUESTERNAME </td>
                                                            <td>@item.REQUESTDATE </td>
                                                            <td>
                                                                <a data-id="/MasterMgmt/MMRequestHistoryDetails?id=@item.MMHEADERDETAILID',780,660)">
                                                                    @item.MMHEADERDETAILID
                                                                </a>
                                                            </td>

                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr style="text-align: center; background-color: #ffffff;"><td colspan="6" class="text-center">No Data Loaded</td></tr>
                                                }

                                            </tbody>
                                        </table>

                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                            <!-- Back -->
                    <tr>
                        <td colspan="8">
