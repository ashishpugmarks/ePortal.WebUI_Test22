@{
    ViewBag.Title = "LocalConveyanceList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .tableHD {
            padding: 6px 10px;
            text-align: center;
        }

        .tableHDPurpose {
            padding: 6px 10px;
            text-align: center;
            white-space: nowrap;
        }

        .table th i {
            margin-left: 5px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            padding: 5px;
            padding: 5px;
            width: initial;
            line-height: 1.2;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
            border: 1px solid #8ac2de;
            align-content: center;
            font-size: 65% !important;
        }

        .table-bordered {
            border: 1px solid #8ac2de;
        }


        .table > tbody > tr:nth-of-type(even) {
            background: #e9e9e9;
        }

        body {
            font-family: montserrat, arial, verdana;
            background: transparent;
        }

        .Headepanel {
            padding: 0px !important;
            margin: 2px;
        }

        .homeContent div {
            padding: 0px;
        }

        label {
            font-weight: normal !important;
            font-size: 17px !important;
        }

        #tblData tbody td:first-child {
            text-align: center;
        }

        /* Style for the action column */
        #tblData tbody td:last-child {
            text-align: center;
        }

        /* Style for the hidden columns */
        #tblData tbody td.hidden {
            display: none;
        }

        /* Style for the edit button */
        #tblData tbody td:last-child a.btn-primary {
            color: #fff;
            background-color: #428bca;
            border-color: #357ebd;
            padding: 6px 12px;
            margin: 2px;
            font-size: 12px;
            cursor: pointer;
            text-decoration: none;
            border-radius: 3px;
        }

        /* Style for the search input */
        #searchInput {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }



        /* Style for the search button */
        #btnSearch {
            width: 100px;
            height: 34px;
            margin-left: 15px;
            margin-top: -5px;
        }


        .panel-bodyHeader {
            border: solid 1px #7ac7f9;
            background-color: #c7e8f3;
            color: black;
            padding: 15px;
            margin-top: -7px;
        }

        .Headepanel {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
        }

        input {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }


        #tblData thead th {
            position: sticky;
            top: 0;
            background-color: inherit; /* Change the background color as needed */
            z-index: 1; /* Ensure the header stays above the content */
        }

        .tblScroll {
            height: 400px !important;
            display: block;
            overflow-y: scroll;
        }

        .ui-autocomplete {
            max-height: 200px; /* Set the maximum height of the dropdown */
            overflow-y: auto; /* Enable vertical scrolling if the content exceeds the maximum height */
            width: 300px; /* Set the width of the dropdown */
            font-size: 14px;
            font-family: montserrat, arial, verdana;
        }
    </style>
    <link href="~/css/loading_spinner.css" rel="stylesheet" />
}

<div id="loader_new" class="loading hidden overlayer">
    <div class="loading-text">
        <span class="loading-text-words">L</span>
        <span class="loading-text-words">O</span>
        <span class="loading-text-words">A</span>
        <span class="loading-text-words">D</span>
        <span class="loading-text-words">I</span>
        <span class="loading-text-words">N</span>
        <span class="loading-text-words">G</span>
    </div>
</div>

<div class="panel-group" style="padding: 0px 8px 0px 8px;">

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Local Conveyance Form - Admin Operation Head</h2>
        </div>

        <div class="panel-bodyHeader">
            <div class="row Headepanel">
                <div class="col-md-2" style="padding-left: 16px; padding-right: 10px;">
                    <label>Search ECode:</label>
                    <input type="hidden" id="selectedECode" name="selectedECode">
                    <input type="text" style="width:85%;" class="form-control " id="txtECode" placeholder="Enter Ecode" autocomplete="off" />
                </div>
                <div class="col-md-2" style="padding-left: 16px; padding-right: 10px;">
                    <label>From Date:</label>
                    <input type="date" style="width:85%;" class="form-control" id="txtFromDate" autocomplete="off" />
                </div>
                <div class="col-md-2" style="padding-left: 16px; padding-right: 10px;">
                    <label>To Date:</label>
                    <input type="date" style="width:85%;" class="form-control" id="txtToDate" autocomplete="off" />
                </div>
                <div class="col-md-2" style="padding-left: 16px; padding-right: 10px;">
                    <label>Status:</label>
                    <select id="ddlStatus" class="form-control">
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="SendBack">Send Back</option>
                        <option value="Rejected">Rejected</option>
                    </select>
                </div>
                <div class="col-md-2" style="padding-top:34px">
                    <button type="submit" id="btnSearch" style="width: 100px;height: 34px;margin-left: 15px;margin-top: -13px;" class="btn btn-block btn-primary"><i class="menu-icon fa fa-search"></i> &nbsp; Search</button>
                </div>
            </div>

        </div>

    </div>

    <br />
    <div class="panel-body" style="padding: 0px 0px 0px 0px;">
        <div class="form-group">
            <div class="col-md-2 col-sm-2 col-xs-2">
                <input type="text" class="form-control" placeholder="Search Here.." id="searchInput">

            </div>
            <table class="table table-bordered table-responsive " id="tblData" style="margin-bottom: 0px!important; ">
                <thead>
                    <tr class="bg-info">
                        <th class="text-center tableHD">E-Code<i class="fa fa-sort"></i></th>
                        <th class="text-center tableHD">E-Name<i class="fa fa-sort"></i></th>
                        <th class="text-center tableHD">Request No<i class="fa fa-sort"></i></th>
                        <th class="text-center tableHD">Request Date<i class="fa fa-sort"></i></th>
                        <th class="text-center tableHD">Designation<i class="fa fa-sort"></i></th>
                        <th class="text-center tableHD">No. Of Hours<i class="fa fa-sort"></i></th>
                        <th class="text-center tableHD">Total Km Covered<i class="fa fa-sort"></i></th>
                        <th class="text-center tableHD">Fuel Reimbursement <i class="fa fa-sort"></i></th>
                        <th class="text-center tableHD">Action<i class="fa fa-sort"></i></th>
                    </tr>

                </thead>
                <tbody id="append_Data">
                    <tr><th colspan="17" class="text-center">No record found.</th></tr>
                </tbody>
            </table>

        </div>
    </div>

</div>

<div>
</div>

@section Scripts{
    <script src="~/js/jquery-ui.js"></script>
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

        $(document).ready(function () {

            const currentDate = new Date();
            const firstDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
            const lastDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);

            $("#txtFromDate").val(formatDateForSeach(firstDayOfMonth));
            $("#txtToDate").val(formatDateForSeach(lastDayOfMonth));

            //Function For Searching//
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("table tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            //Function For Sorting//
            $("th").click(function () {
                var table = $(this).parents("table").eq(0)
                var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()))
                this.asc = !this.asc
                if (!this.asc) { rows = rows.reverse() }
                for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
            })


            //Function For Sorting//
            function comparer(index) {
                return function (a, b) {
                    var valA = getCellValue(a, index), valB = getCellValue(b, index)
                    return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
                }
            }

            //Function For Sorting//
            function getCellValue(row, index) {
                return $(row).children("td").eq(index).html()
            }


            PreLoadData();

            $('#btnSearch').click(function () {
                PreLoadData();
            });

            $(document).on("change", "#tblData tbody input[type=checkbox]", function () {
                calculateTotalAmount();
            });

            const searchTermInput = $("#txtECode");
            const selectedECodeInput = $("#selectedECode");

            searchTermInput.autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/LocalConveyance/AutocompleteSuggestions",
                        data: { term: request.term },
                        dataType: "json",
                        method: "GET",
                        success: function (data) {
                            if (data.resultObject && data.resultObject.length > 0) {

                                const suggestions = data.resultObject.map(function (suggestion) {
                                    return {
                                        label: suggestion.ecode + " - " + suggestion.name,
                                        value: suggestion.ecode,
                                    };
                                });
                                response(suggestions);
                            } else {
                                response([]);
                            }
                        },
                        error: function (error) {
                            console.error("Error fetching autocomplete suggestions:", error);
                            response([]);
                        },
                    });
                },
                select: function (event, ui) {
                    selectedECodeInput.val(ui.item.value);
                },
            });
        });


        function PreLoadData() {
            //var ToDate = formatDate($("#txtToDate").val());
            var FromDate = $("#txtFromDate").val();
            var ToDate = $("#txtToDate").val();
            var Ecode = $("#txtECode").val() == "" ? 0 : Number($("#txtECode").val());
            var Status = $("#ddlStatus").val();
            $('#loader_new').removeClass('hidden');

            debugger;
            //var FromDate = '01-Jan-2023';
            //var ToDate = '15-Feb-2023';
            $.ajax({

                type: "GET",
                url: "/LocalConveyance/GetLCAdminOH_ListDATA",
                data: { Ecode: Ecode, FromDate: FromDate, ToDate: ToDate, Status: Status },

                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    debugger;
                    if (JSON.parse(data).length != 0) {
                        var Data = JSON.parse(data);

                        $("#append_Data").empty();
                        $.each(Data, function (i, r) {
                            $("#append_Data").append('<tr><td><center>' + r.EMPCODE + '</center></td><td><center>' + r.EMPNAME + '</center></td><td><center>' + r.LCTRANNO + '</center></td><td><center>' + formatDate(r.LCTRANDATE) + '</center></td><td><center>' + r.DESIGNATION + '</center></td><td><center>' + r.TOTAL_NOOFHOURS + '</center></td><td><center>' + r.TOTAL_KMCOVERED + '</center></td><td><center>' + r.FUAL + '</center></td><td>' + EditorFormatter(r.LCTRANNO, r.EMPCODE) + '</td></tr>');

                        });

                        // CSP 3.0 Compliant changes
                        $('[data-ctrl-id="Edit-Employee"]').on('click', function () {
                            const itemId = $(this).data('item-id');
                            const empCode = $(this).data('emp-code');
                            Edit(itemId, empCode);
                        });


                    }
                    else {

                        $("#append_Data").empty();
                        $("#append_Data").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>")
                        $("#tblData").removeClass("tblScroll");
                    }
                    $('#loader_new').addClass('hidden');
                },
                complete: function () {
                },
                error: function () {
                    alert("Oops...", "Something went wrong!");
                }
            });



        }


        function EditorFormatter(i, EmpCode) {
            return '<center><a title="Edit" data-ctrl-id="Edit-Employee" data-item-id="' + i + '" data-emp-code="' + EmpCode + '" class="btn btn-link"><i class="ace-icon fa fa-edit"></i></a></center>';
        }



        function Edit(id, EmpCode) {

            var URL = '/LocalConveyance/LCAdminOH_Edit/?id=' + id + '&EmpCode=' + EmpCode;

            $.fancybox.open({

                href: URL,
                type: 'iframe',
                padding: 1,
                maxWidth: 1300,
                maxHeight: 1200,
                fitToView: false,
                width: '1300px',
                height: '1200px',
                autoSize: true,
                closeClick: true,
                openEffect: 'elastic',
                openSpeed: 120,
                closeEffect: 'elastic',
                closeSpeed: 100,
                helpers:
                {
                    overlay: { closeClick: false }
                },
                afterClose: function () {
                    PreLoadData();
                }

            });

            return false;
        }


        function formatDate(inputDateString) {
            const inputDate = new Date(inputDateString);

            const day = inputDate.getDate();
            const month = inputDate.toLocaleString('default', { month: 'short' });
            const year = inputDate.getFullYear();

            return `${day}-${month}-${year}`;
        }
        function formatDateForSeach(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }
        function tableToJson(controlID) {
            const table = document.querySelector(controlID);
            const headers = Array.from(table.querySelectorAll("th")).map(header => header.textContent);
            const jsonData = Array.from(table.querySelectorAll("tr"))
                .slice(1)
                .map(row => {
                    const columns = row.querySelectorAll("td");
                    const obj = {};
                    columns.forEach((column, index) => {
                        obj[headers[index]] = column.textContent;
                    });
                    return obj;
                });
            return jsonData;
        }


    </script>
}

