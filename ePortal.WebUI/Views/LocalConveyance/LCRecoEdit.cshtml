</div>


<!-- Amount Details -->
<div class="panel panel-shadow">
    <div class="panel-heading" data-toggle="collapse" data-target="#amountDetails">
        <span class="panel-title">
            <i class="fa fa-caret-right caret-color"></i>Amount Details
        </span>
    </div>
    <div id="amountDetails" class="panel-body panel-collapse collapse in">
        <table class="table table-responsive approval-table table-curved">
            <tbody>
                <tr>
                    <th width="15%">@Html.Label("Total Amount in Words")</th>
                    <td width="35%"><span id="txtAmountInWords"></span></td>
                    <th width="15%">@Html.Label("Total Amount")</th>
                    <td width="35%"><span id="txtTotalAmount"></span></td>
                </tr>
                <tr style="display:none;">
                    <th width="15%"> </th>
                    <td width="35%"><input type="hidden" id="txtTotalKMCovered" class="form-control" readonly /></td>
                    <th width="15%"></th>
                    <td width="35%"><input type="hidden" id="txtTotalNoOfHours" class="form-control" readonly /></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Approver Action-->
<div class="panel panel-shadow">
    <div class="panel-heading" data-toggle="collapse" data-target="#approverAction">
        <span class="panel-title"><i class="fa fa-caret-right caret-color"></i>Approval</span>
    </div>
    <div id="approverAction" class="panel-body panel-collapse collapse in">
        <div class="remarks-box">
            <div class="text-center pnl-btn">
                <button type="button" class="btn action-btn btn-md reject" id="btnReject"><i class="fa fa-times-circle-o"></i>REJECT</button>
                <button type="button" class="btn action-btn btn-md approve flex-2_3_po" id="btnApprove"><i class="fa fa-check-circle-o"></i>APPROVE</button>
            </div>
            <div>
                <div class="well">
                    <textarea id="txtAppRemark" class="form-control " placeholder="Enter Remarks."></textarea>
                </div>
            </div>
            <div class="text-center pnl-btn">
                <a title="Back" class="btn back" href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx"><i class="fa fa-arrow-left"></i>BACK</a>
                <button type="button" class="btn action-btn btn-md sendback" id="btnSendback"><i class="fa fa-undo"></i>SEND BACK</button>
                <a title="Skip" class="btn skip" href="/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageApproval.aspx"><i class="fa fa-step-forward"></i>SKIP</a>
            </div>
        </div>
    </div>
</div>

<div id="ajaxLoader"></div>

@section Scripts {

    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_2"]">

        $(document).ready(function () {

            //Function For Searching//
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("table tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            //Function For Sorting//
            $("th").click(function () {
                var table = $(this).parents("table").eq(0)
                var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()))
                this.asc = !this.asc
                if (!this.asc) { rows = rows.reverse() }
                for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
            })


            //Function For Sorting//
            function comparer(index) {
                return function (a, b) {
                    var valA = getCellValue(a, index), valB = getCellValue(b, index)
                    return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
                }
            }

            //Function For Sorting//
            function getCellValue(row, index) {
                return $(row).children("td").eq(index).html()
            }


            PreLoadData();

            $('#btnSearch').click(function () {
                PreLoadData();
            });

            $(document).on("change", "#tblData tbody input[type=checkbox]", function () {
                calculateTotalAmount();
            });




        });

        //amountDetails
         $('#reqDetails,#documentDetail,#amountDetails,#approverAction').on('show.bs.collapse', function () {
            $(this).prev('.panel-heading').find('.caret-color').removeClass('fa-caret-down').addClass('fa-caret-right');
        });

        $('#reqDetails,#appNoteDetails,#documentDetail,#amountDetails,#approverAction').on('hide.bs.collapse', function () {
            $(this).prev('.panel-heading').find('.caret-color').removeClass('fa-caret-right').addClass('fa-caret-down');
        });

        function PreLoadData() {
            ;
            $.ajax({
                async: false,
                type: "GET",
                url: "/LocalConveyance/GetLCRecoDATA",
                data: {ID: @ViewBag.id,EMPCODE:@ViewBag.EmpCode},
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    debugger;
                    if (JSON.parse(data).length != 0) {
                        var EMPDATA = JSON.parse(data).Empdata;
                        var HEADERDATA = JSON.parse(data).HeaderData;
                        var Remark = ( HEADERDATA["RECOMM_REMARKS"] == null ? "" : HEADERDATA["RECOMM_REMARKS"]);

                        if(HEADERDATA["RECOMM_STATUS"] != "Pending")
                        {
                            $("#btnclass").addClass("hidden");
                            $("#txtAppRemark").prop("disabled",true);
                        }

                        $("#txtEcode").text(EMPDATA.resultObject[0].ADEMPCODE);
                        $("#txtEname").text(EMPDATA.resultObject[0].EmpName);
                        $("#txtDesignation").text(EMPDATA.resultObject[0].ADDESIGNATION);
                        $("#txtDate").text(formatDate(HEADERDATA["LCTRANDATE"])); // chnages on 03-05-2024
                        $("#txtDivision").text(EMPDATA.resultObject[0].DIVISION);
                        $("#txtDepartment").text(EMPDATA.resultObject[0].DEPARTMENT);
                        $("#txtSection").text(EMPDATA.resultObject[0].SECTION);
                        $("#txtMobile").text(EMPDATA.resultObject[0].TMOBILE);

                        $("#ReqNo").text(HEADERDATA["LCTRANNO"]);
                        $("#txtAmountInWords").text(HEADERDATA["TOTAL_AMT_IN_WORD"]);
                        $("#txtAmountInWords").text(HEADERDATA["TOTAL_AMT_IN_WORD"]);
                        $("#txtTotalAmount").text(HEADERDATA["TOTAL_AMOUNT"]);
                        $("#txtAppRemark").text(Remark);
                        var ODDATA = JSON.parse(data).DtData;
                        $("#append_Data").empty();




                        $("#append_Data").empty();
                        $.each(ODDATA, function (i, r) {

                            debugger;
                            var _FROMCITY = r.FROMCITY == "Other" ? r.FROMCITY_OTHER : r.FROMCITY;
                            var _TOCITY = r.TOCITY == "Other" ? r.TOCITY_OTHER : r.TOCITY;
                            var _ModelOfTravel = r.MODEOFTRAVEL == "Other" ? r.MODEOFTRAVEL_OTHER : r.MODEOFTRAVEL;
                            //var TotalAmount  =  Number(r.TRAVELREIMBURSEMENT) + Number(r.REFRESHMENTMEALALLOWANCE) + Number(r.TOLLTAXMISCAMOUNT);
                            var MealAllowance_Refresh = (r.LUNCH_ALLW_AMOUNT == null ? 0 : Number(r.LUNCH_ALLW_AMOUNT))
                                      + (r.DINNER_ALLW_AMOUNT == null ? 0 : Number(r.DINNER_ALLW_AMOUNT))
                                      + (r.REFRESHMENTMEALALLOWANCE == null ? 0: Number(r.REFRESHMENTMEALALLOWANCE));

                            var TotalAmount = Number(r.TOLLTAXMISCAMOUNT) + Number(MealAllowance_Refresh) + Number(r.TRAVELREIMBURSEMENT);


                            $("#append_Data").append('<tr><td>' + EditorFormatter(i) + '</td><td><center>' + formatDate(r.DATEOFEXPENDITURE) + '</center></td><td><center>' + r.PURPOSE + '</center></td><td><center>' + _FROMCITY + '</center></td><td><center>' + _TOCITY + '</center></td><td><center>' + r.TIMEIN + '</center></td><td><center>' + r.TIMEOUT + '</center></td><td><center>' + r.NOOFHOURS + '</center></td><td><center>' + _ModelOfTravel + '</center></td><td><center>' + r.KMCOVERED + '</center></td><td><center>' + r.RATEPERKM + '</center></td><td><center>' + r.TRAVELREIMBURSEMENT + '</center></td><td><center>' + MealAllowance_Refresh + '</center></td><td><center>' + r.TOLLTAXMISCAMOUNT + '</center></td><td><center>' + r.FUEL_REIMBURSMENT + '</center></td><td><center>' + TotalAmount + '</center></td><td class="hidden">' + r.DT + '</td><td class="hidden"><center>' + r.FROMCITYID + '</center></td><td class="hidden"><center>' + r.TOCITYID + '</center></td><td class="hidden"><center>' + r.EMPCODE + '</center></td><td class="hidden"><center>' + r.EMPNAME + '</center></td><td class="hidden"><center>' + r.ASOFFODID + '</center></td><td class="hidden">' + (r.FROMCITY_OTHER == null ? "" : r.FROMCITY_OTHER) + '</td><td class="hidden">' + (r.TOCITY_OTHER == null ? "" : r.TOCITY_OTHER) + '</td><td class="hidden">' + (r.MODEOFTRAVEL_OTHER == null ? "" : r.MODEOFTRAVEL_OTHER) + '</td><td class="hidden">' + r.FROMCITY + '</td><td class="hidden">' + r.TOCITY + '</td><td class="hidden">' + r.MODEOFTRAVEL + '</td><td class="hidden">' + (r.MEAL_REFRE_ALLW_CLAIM == null ? "NO" : r.MEAL_REFRE_ALLW_CLAIM) + '</td><td class="hidden">' + (r.FUEL_ALLW_CLAIM == null ? "NO" : r.FUEL_ALLW_CLAIM) + '</td><td class="hidden">' + (r.DINNER_ALLW_CLAIM == null ? "NO" : r.DINNER_ALLW_CLAIM) + '</td><td class="hidden">' + (r.LUNCH_ALLW_CLAIM == null ? "NO" : r.LUNCH_ALLW_CLAIM) + '</td> <td class="hidden">' + (r.DINNER_ALLW_AMOUNT == null ? "0" : r.DINNER_ALLW_AMOUNT) + '</td><td class="hidden">' + (r.LUNCH_ALLW_AMOUNT == null ? "0" : r.LUNCH_ALLW_AMOUNT) + '</td><td class="hidden">' + (r.REFRESHMENTMEALALLOWANCE == null ? "0" : r.REFRESHMENTMEALALLOWANCE) + '</td><td class="hidden">' + (r.TOURSTARTFROMHOMEKM == null ? 0 : Number(r.TOURSTARTFROMHOMEKM)) +
                                                             '</td></tr>');

                        });


                        // CSP 3.0 Compliant changes
                        $('[data-ctrl-id="Edit-Item"]').on('click', function () {
                            Edit($(this).data('item-id'));
                        });


                    }
                    else {

                        $("#append_Data").empty();
                        $("#append_Data").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>")
                        $("#tblData").removeClass("tblScroll");
                    }
                },
                complete: function () {
                },
                error: function () {
                    alert("Oops...", "Something went wrong!");
                }
            });



        }





        function EditorFormatter(i) {
            return '<center><a title="Edit" data-ctrl-id="Edit-Item" data-item-id="' + i + '" class="btn btn-link"><i class="fa fa-eye" aria-hidden="true"></i></a></center>';
        }

        function Edit(id) {
            debugger;

            localStorage.clear();
            var tabledata = tableToJson("#tblData");
            localStorage.setItem("LCRECODATA", JSON.stringify(tabledata));

            var URL = '/LocalConveyance/LCRecoODItemView/?id=' + id;

             $.fancybox.open({

                 href: URL,
                 type: 'iframe',
                 padding: 2,
                 maxWidth: 1000,
                 maxHeight: 700,
                 fitToView: false,
                 width: '1000px',
                 height: '700px',
                 autoSize: true,
                 closeClick: true,
                 openEffect: 'elastic',
                 openSpeed: 120,
                 closeEffect: 'elastic',
                 closeSpeed: 100,
                 helpers:
                 {
                     overlay: { closeClick: false }
                 },
                 afterClose: function () {

                     PreLoadData();
                 }

             });

             return false;
         }


         function formatDate(inputDateString) {
             const inputDate = new Date(inputDateString);

             const day = inputDate.getDate();
             const month = inputDate.toLocaleString('default', { month: 'short' });
             const year = inputDate.getFullYear();

             return `${day}-${month}-${year}`;
         }
         function formatDateForSeach(date) {
             const year = date.getFullYear();
             const month = String(date.getMonth() + 1).padStart(2, '0');
             const day = String(date.getDate()).padStart(2, '0');
             return `${year}-${month}-${day}`;
         }
         function tableToJson(controlID) {
             const table = document.querySelector(controlID);
             const headers = Array.from(table.querySelectorAll("th")).map(header => header.textContent);
             const jsonData = Array.from(table.querySelectorAll("tr"))
               .slice(1)
               .map(row => {
                   const columns = row.querySelectorAll("td");
                   const obj = {};
                   columns.forEach((column, index) => {
                       obj[headers[index]] = column.textContent;
                   });
                   return obj;
               });
             return jsonData;
         }

         function calculateTotalAmount() {
             var totalAmount = 0;
             var totalKmCovred = 0;
             var totalNoOfHours = 0;

             // Iterate through checked checkboxes and sum up the total amount
             $("table tbody input[type=checkbox]:checked").each(function () {
                 var rowIndex = $(this).closest("tr").index();
                 totalAmount += parseFloat($("#tblData tbody tr:eq(" + rowIndex + ") td:eq(14)").text());
                 totalKmCovred += parseFloat($("#tblData tbody tr:eq(" + rowIndex + ") td:eq(9)").text());
                 totalNoOfHours += parseFloat($("#tblData tbody tr:eq(" + rowIndex + ") td:eq(7)").text());
             });

             // Display the total amount in the first textbox
             $("#txtTotalAmount").val(totalAmount.toFixed(2));
             $("#txtTotalKMCovered").val(totalKmCovred.toFixed(2));
             $("#txtTotalNoOfHours").val(totalNoOfHours.toFixed(2));
             // Convert the total amount to words and display in the second textbox
             var amountInWords = convertNumberToWords(totalAmount);
             $("#txtAmountInWords").val(amountInWords);
         }

         function convertNumberToWords(number) {
             const units = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine'];
             const teens = ['Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
             const tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

             function convertLessThanThousand(num) {
                 if (num === 0) return '';
                 if (num < 10) return units[num];
                 if (num < 20) return teens[num - 11];
                 if (num < 100) return tens[Math.floor(num / 10)] + ' ' + convertLessThanThousand(num % 10);
                 if (num < 1000) {
                     return units[Math.floor(num / 100)] + ' Hundred ' + convertLessThanThousand(num % 100);
                 }
                 return ''; // Added this line for numbers greater than or equal to 1000
             }


             function convert(number) {
                 console.log(number);
                 if (number === 0) return 'Zero';
                 let result = '';
                 if (number < 0) {
                     result += 'Negative ';
                     number = Math.abs(number);
                 }
                 //if (number < 1000000000) {
                 //    result += convertLessThanThousand(Math.floor(number / 1000000)) + ' Million ';
                 //    number %= 1000000;
                 //}
                 if (number < 1000000) {
                     result += convertLessThanThousand(Math.floor(number / 1000)) + ' Thousand ';
                     number %= 1000;
                 }
                 result += convertLessThanThousand(number);
                 return result.trim();
             }

             const integerPart = Math.floor(number);
             const decimalPart = Math.round((number - integerPart) * 100);

             let result = convert(integerPart);

             if (decimalPart > 0) {
                 result += ` and ${decimalPart}/100`;
             }

             return result;
         }

         function ApproveReject(Response) {

             var Remark =  $("#txtAppRemark").val();
             if ((Response == 'Rejected' || Response == 'SendBack') && Remark == "")
             {
                 alert("Remark is mandatory for rejection or Send Back.");
                 return;
             }
             else{
                 $("#btnApprove").attr("disabled", true);
                 $("#btnSendback").attr("disabled", true);
                 $("#btnReject").attr("disabled", true);
                 $.ajax({
                     async: false,
                     type: "GET",
                     url: "/LocalConveyance/ApproveRejectReco",
                     beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                     data: {ID: @ViewBag.id,EMPCODE:@ViewBag.EmpCode,Response:Response,Remark: Remark},
                     contentType: "application/json; charset=utf-8",
                     datatype: "json",
                     success: function (res) {
                         var data = JSON.parse(res);
                         if(data.hasError == false)
                         {
                             alert(data.errorMessage);

                         }
                         else
                         {
                             alert(data.errorMessage);

                         }
                         $("#btnApprove").attr("disabled", false);
                         $("#btnSendback").attr("disabled", false);
                         $("#btnReject").attr("disabled", false);
                         parent.jQuery.fancybox.close();
                     },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                     error: function () {
                         alert("Oops...", "Something went wrong!");
                     }
                 });
             }



         }

    </script>


    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#btnApprove').on('click', function () {
                ApproveReject('Approved');
            });
            $('#btnSendback').on('click', function () {
                ApproveReject('SendBack');
            });
            $('#btnReject').on('click', function () {
                ApproveReject('Rejected');
            });
        });
    </script>

         }