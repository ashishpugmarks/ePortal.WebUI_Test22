    <div id="documentDetail" class="panel-body  panel-collapse collapse in" style="overflow-x: auto;">
        <table class="table table-responsive approval-table table-curved" id="tblData">
            <thead>
                <tr>
                    <th class="text-center">View<i class="fa fa-sort"></i></th>
                    <th class="text-center ">Date Of Expenditure<i class="fa fa-sort"></i></th>
                    <th class="text-center">Purpose<i class="fa fa-sort"></i></th>
                    <th class="text-center ">From (City)<i class="fa fa-sort"></i></th>
                    <th class="text-center ">To (City)<i class="fa fa-sort"></i></th>
                    <th class="text-center ">Time In<i class="fa fa-sort"></i></th>
                    <th class="text-center ">Time Out<i class="fa fa-sort"></i></th>
                    <th class="text-center ">No. Of Hours<i class="fa fa-sort"></i></th>
                    <th class="text-center ">Mode Of Travel<i class="fa fa-sort"></i></th>
                    <th class="text-center ">Km Covered<i class="fa fa-sort"></i></th>
                    <th class="text-center ">Rate Per Km<i class="fa fa-sort"></i></th>
                    <th class="text-center ">Travel Reimburse.(Rs.)<i class="fa fa-sort"></i></th>
                    <th class="text-center ">Refreshment/Meal Allow.<i class="fa fa-sort"></i></th>
                    <th class="text-center ">Toll Tax /Mis.<i class="fa fa-sort"></i></th>
                    <th class="text-center  ">Fuel Reimburse.<i class="fa fa-sort"></i></th>
                    <th class="text-center ">Total<i class="fa fa-sort"></i></th>
                    @*<th class="text-center tableHD">Doc <i class="fa fa-sort"></i></th>*@
                    <th class="text-center hidden">DT<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">FromCityId<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">ToCityId<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">EmpCode<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">EmpName<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">ASOFFODID<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">FromCityOther<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">ToCityOther<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">ModeOfTravelOther<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">FromCity<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">ToCity<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">ModeOfTravel<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">MealRefreAllowClaim<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">FuelAllowClaim<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">DinnerAllowClaim<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">LunchAllowClaim<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">DinnerAllowAmount<i class="fa fa-sort"></i></th>
                    <th class="text-center hidden">LunchAllowAmount<i class="fa fa-sort"></i></th>
