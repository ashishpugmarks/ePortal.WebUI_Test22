@{
    ViewBag.Title = "LCRecoEdit";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";
}


<link rel="stylesheet" href="~/css/new-aproval-page.css" />
<!-- Header -->
<div class="app-header">
    <div class="pull-right">Local Conveyance Form - Recommandation For Request No : <span id="ReqNo"></span></div>
</div>

<!-- Requester Details -->
