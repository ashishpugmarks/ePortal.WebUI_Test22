               if ($("#txtTimeIn").val() == "00:00") {
                   alert("Please Select Time-In");
                   return;
               }

               if ($("#txtTimeOut").val() == "00:00") {
                   alert("Please Select Time-Out");
                   return;
               }

               if ($("#txtPurpose").val() == "") {
                   alert("Please Enter Purpose");
                   return;
               }
               if ($("#ddlModeofTravel").val() == "Other" && $("#txtModeOfTravelOther").val() == "") {
                   alert("Please Enter ModeOfTravel (Other)");
