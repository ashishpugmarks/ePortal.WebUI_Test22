                           parent.jQuery.fancybox.close();
                       }
                       else {
                           alert(data.result.errorMessage);
                           parent.jQuery.fancybox.close();
                       }
                       $("#btnSubmit").attr("disabled", false);
                   },
                   error: function (error) {
                       // Handle error
                       alert(error);
                       return;
                   }
               });
           }
