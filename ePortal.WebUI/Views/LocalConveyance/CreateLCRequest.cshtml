                   TOCITY_OTHER: $("#txtToCityOther").val() || "",
                   MODEOFTRAVEL_OTHER: $("#txtModeOfTravelOther").val() || "",
                   MEAL_REFRE_ALLW_CLAIM: $("#ChkMealRefreAllow").prop('checked') ? "YES" : "NO",
                   REFRESHMENTMEALALLOWANCE: $("#txtRefre_MealAllow").val(),
                   FUEL_ALLW_CLAIM: ($("#ChkFuelAllow").prop('checked') ? "YES" : "NO"),
                   FUEL_REIMBURSMENT: $("#txtFuelReimbursement").val(),
                   DINNER_ALLW_CLAIM: ($("#ChkDinnerAllowClaim").prop('checked') ? "YES" : "NO"),
                   DINNER_ALLW_AMOUNT: $("#txtDinnerAllowAmount").val(),
                   LUNCH_ALLW_CLAIM: ($("#ChkLunchAllowClaim").prop('checked') ? "YES" : "NO"),
                   LUNCH_ALLW_AMOUNT: $("#txtLunchAllowAmount").val(),
                   TOURSTARTFROMHOMEKM: $("#txtTourstartFromHomeKM").val()
               };

               debugger;
               $.ajax({
                   type: "POST",
                   url: "/LocalConveyance/CreateLCRequestSave",
                   data: { ModelData: JSON.stringify(dataToSend) },
                   success: function (data) {
                       debugger;
                       if (data.result.hasError == false) {
