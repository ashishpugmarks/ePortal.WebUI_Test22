@{
    ViewBag.Title = "LCRecoODItemView";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";
}

@section Styles {
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .panel-heading {
            background-color: #008080 !important;
        }

        .homeContent {
            padding: 0.52em 0.3em 0.78em !important;
        }

            .homeContent div {
                padding: 5px;
            }

        label {
            font-size: 13px !important;
        }
    </style>
}



<div class="panel panel-primary top-margin-10">
    <div class="panel-heading">
        <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px;"><label>Details of Expenditure Date: </label><label id="lblDateOfExpenditure"></label> - Recommandation</h2>
    </div>
    <div class="panel-body">

        <span id="span-attachmentMsg" style="font-weight:600;"></span>
        <div>
            <div class="row">
                <!-- From City -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label>From City:</label>
                    <input type="text" class="form-control" id="ddlFromCity" autocomplete="off" disabled />
                </div>

                <!-- From City (Other) -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3 hidden" id="divFromCityOther">
                    <label>From City (Other):</label>
                    <input type="text" class="form-control" id="txtFromCityOther" autocomplete="off" disabled />
                </div>

                <!-- To City -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label>To City:</label>
                    <input type="text" class="form-control" id="ddlToCity" autocomplete="off" disabled />
                </div>

                <!-- To City (Other) -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3 hidden" id="divToCityOther">
                    <label>To City (Other):</label>
                    <input type="text" class="form-control" id="txtToCityOther" autocomplete="off" disabled />
                </div>

                <!-- Time In -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Time In:</label>
                    <input type="time" id="txtTimeIn" class="form-control" disabled>
                </div>

                <!-- Time Out -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Time Out:</label>
                    <input type="time" id="txtTimeOut" class="form-control" disabled>
                </div>

            </div>
            <div class="row">
                <!-- Mode Of Travel -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Mode of Travel:</label>
                    <select id="ddlModeofTravel" class="form-control" readonly>
                        <option value="Taxi">Taxi</option>
                        <option value="Bus">Bus</option>
                        <option value="Auto">Auto</option>
                        <option value="Self Car">Self Car</option>
                        <option value="Self Bike/Scooter">Self Bike/Scooter</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <!-- Mode Of Travel (Other) -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2 hidden" id="divModeOfTravelOther">
                    <label>Other:</label>
                    <input type="text" class="form-control" id="txtModeOfTravelOther" readonly autocomplete="off" />
                </div>

                <!-- KM Covered -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>KM Covered:</label>
                    <input type="text" class="form-control" readonly id="txtKMCovered" autocomplete="off" />
                </div>


                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label for="txtTourstartFromHomeKM">Distance round trip from home to plant :</label>
                    <input type="text" class="form-control fixed-size" id="txtTourstartFromHomeKM" style="width:64%;" autocomplete="off" disabled />

                </div>
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <span style="color: red;"> * Required in case of tour start from home </span>
                </div>



            </div>
            <div class="row">
                <!-- Refresh./Meal Allow. -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Claim Refreshment Allowance?</label>
                    <input type="checkbox" id="ChkMealRefreAllow" disabled>
                </div>

                <!-- Meal Allowance Amount -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label for="txtRefre_MealAllow">Refreshment Amount:</label>
                    <input type="text" class="form-control" id="txtRefre_MealAllow" readonly autocomplete="off" pattern="\d*" />
                </div>
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Claim Fuel Allowance?</label>
                    <input type="checkbox" id="ChkFuelAllow" disabled>
                </div>
                <!-- Fuel Reimbursement -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label>Fuel Reimbursment Amont:</label>
                    <input type="text" class="form-control" id="txtFuelReimbursement" readonly autocomplete="off" pattern="\d*" />
                </div>
            </div>
            <div class="row">
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Claim Lunch Allowance?</label>
                    <input type="checkbox" id="ChkLunchAllowClaim" disabled>
                </div>
                <!-- Fuel Reimbursement -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label>Lunch Allowance Amont:</label>
                    <input type="text" class="form-control" id="txtLunchAllowAmount" readonly autocomplete="off" pattern="\d*" />
                </div>
                <!-- Refresh./Meal Allow. -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Claim Dinner Allowance?</label>
                    <input type="checkbox" id="ChkDinnerAllowClaim" disabled>
                </div>

                <!-- Meal Allowance Amount -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label for="txtDinnerAllowAmount">Dinner Allowance Amount:</label>
                    <input type="text" class="form-control" id="txtDinnerAllowAmount" readonly autocomplete="off" pattern="\d*" />
                </div>

            </div>

            <div class="row">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Summary of bills</h2>
                    </div>

                    <div class="panel-body">
                        <div style="padding-left:inherit">
                            <table id="tbltolltaxDt" class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                                <thead>
                                    <tr class="bg-info">
                                        <th class="text-center">ReceiptNo</th>
                                        <th class="text-center">Date</th>
                                        <th class="text-center">Service Provider Name</th>
                                        <th class="text-center">Amount</th>
                                        <th class="text-center">DocType</th>
                                        <th class="text-center">Attachement</th>
                                        <th class="text-center hidden">RowID</th>
                                    </tr>
                                </thead>
                                <tbody id="append_tolltaxDtRow">
                                    <tr><th colspan="7" class="text-center">No record found</th></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section  Scripts {
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_2"]">
        var Rowid;
        var fileName = "";
        var LoadData;
        var FuelReimbursPerLeter;

        $(document).ready(function () {
            debugger;


            Rowid = @ViewBag.id;

            LoadData = JSON.parse(localStorage.getItem("LCRECODATA"));

            console.log(LoadData);

            if (LoadData.length != 0)
            {
                if(LoadData[Rowid]["DT"] != null && LoadData[Rowid]["DT"] != "" && LoadData[Rowid]["DT"] !=  "[{}]" && LoadData[Rowid]["DT"] !=  "[]")
                {
                    var TableData =  JSON.parse(LoadData[Rowid]["DT"]);
                    $("#append_tolltaxDtRow").empty();
                    $.each(TableData, function (i, r) {
                        debugger;
                        var downloadIcon = '';

                        var Attachment = r.Attachement || r.Attachment;

                        var ReceiptNo = r["Receipt No"] || r["ReceiptNo"];

                        if ( Attachment != "" &&  Attachment != "No files selected.") {
                            downloadIcon = '<a href="#" data-ctrl-id="Download-Attachment" data-attachment="' + Attachment + '"><label style="display:none">' + Attachment + '</label><i class="fa fa-download"></i></a>';
                        }

                        $("#append_tolltaxDtRow").append('<tr><td><center>' + ( ReceiptNo  == null ? "" : ReceiptNo)  + ' </center></td><td><center>' + (r["Date"] == null ? "" : r["Date"]) + '</center></td><td><center>' + (r["Service Provider Name"] == null ? "" : r["Service Provider Name"]) + '</center></td><td><center>' + r["Amount"] + '</center></td><td><center> ' + r["DocType"]  +'</center></td><td><center>' + downloadIcon + '</center></td><td class="hidden">' + Rowid + '</td></tr>');
                        //  $("#append_tolltaxDtRow").append('<tr><td><center>' + r["Amount"] + '</center></td><td><center>' + r["Remarks"] + '</center></td><td><center><a href="#" onClick="return Download(\''+ r["Attachement"] +'\')"><label style="display:none">'+r["Attachement"]+'</label><i class="fa fa-download"></i></a></center></td><td><center><a href="#" class="delete-button"><i class="fa fa-trash-o"></i></a></center></td><td class="hidden">'+r["RowID"]+'</td></tr>');
                    });

                    // CSP 3.0 Compliant Changes
                    $('[data-ctrl-id="Download-Attachment"]').on("click", function () {
                        const attachment = $(this).data("attachment");
                        return Download(attachment);
                    });
                }


                $("#lblDateOfExpenditure").text(LoadData[Rowid]["Date Of Expenditure"]);
                $("#txtTimeIn").val(LoadData[Rowid]["Time In"]);
                $("#txtTimeOut").val(LoadData[Rowid]["Time Out"]);
                $("#txtKMCovered").val(LoadData[Rowid]["Km Covered"]);
                $("#txtTourstartFromHomeKM").val(LoadData[Rowid]["TOURSTARTFROMHOMEKM"]);


                $("#ddlModeofTravel").val(LoadData[Rowid]["ModeOfTravel"]);

                $("#txtFromCityOther").val(LoadData[Rowid]["FromCityOther"]);
                $("#txtToCityOther").val(LoadData[Rowid]["ToCityOther"]);
                $("#txtModeOfTravelOther").val(LoadData[Rowid]["ModeOfTravelOther"]);
                debugger;

                if (LoadData[Rowid]["FromCityId"] == '0') {
                    $("#divFromCityOther").removeClass('hidden');

                } else {
                    $("#divFromCityOther").addClass('hidden');
                }

                if (LoadData[Rowid]["ToCityId"] == '0') {
                    $("#divToCityOther").removeClass('hidden');


                } else {
                    $("#divToCityOther").addClass('hidden');
                }


                if ( LoadData[Rowid]["ModeOfTravel"] == 'Other') {
                    $("#divModeOfTravelOther").removeClass('hidden');
                } else {
                    $("#divModeOfTravelOther").addClass('hidden');
                }

                $("#ddlFromCity").val(LoadData[Rowid]["FromCity"]);
                $("#ddlToCity").val(LoadData[Rowid]["ToCity"]);

                if (LoadData[Rowid]["MealRefreAllowClaim"] != "NO")
                {
                    $("#ChkMealRefreAllow").prop('checked', true);
                    $("#txtRefre_MealAllow").val(LoadData[Rowid]["RefreshmentAmount"]);
                }
                else
                {
                    $("#ChkMealRefreAllow").prop('checked', false);
                    $("#txtRefre_MealAllow").val(0);
                }

                if (LoadData[Rowid]["FuelAllowClaim"] != "NO")
                {
                    $("#ChkFuelAllow").prop('checked', true);
                    $("#txtFuelReimbursement").val(LoadData[Rowid]["Fuel Reimburse."]);
                }
                else
                {
                    $("#ChkFuelAllow").prop('checked', false);
                    $("#txtFuelReimbursement").val(0);
                }

                if (LoadData[Rowid]["DinnerAllowClaim"] != "NO")
                {
                    $("#ChkDinnerAllowClaim").prop('checked', true);
                    $("#txtDinnerAllowAmount").val(LoadData[Rowid]["DinnerAllowAmount"]);
                }
                else
                {
                    $("#ChkDinnerAllowClaim").prop('checked', false);
                    $("#txtDinnerAllowAmount").val(0);
                }

                if (LoadData[Rowid]["LunchAllowClaim"] != "NO")
                {
                    $("#ChkLunchAllowClaim").prop('checked', true);
                    $("#txtLunchAllowAmount").val(LoadData[Rowid]["LunchAllowAmount"]);
                }
                else
                {
                    $("#ChkLunchAllowClaim").prop('checked', false);
                    $("#txtLunchAllowAmount").val(0);
                }

            }

        });


        function Download(FileName) {
            //var link = document.createElement("a");
            //link.href = "../../Uploads/LCODD/"+FileName;
            //link.download = FileName;
            //link.click();
            var fullFilePath = "../../Uploads/LCODD/" + FileName;

            var width = screen.width - 100;
            var height = screen.height - 100;
            var winTop = 50;
            var winLeft = 50;
            var windowFeatures = "location=no,status=no,width=" + width + ",height=" + height;
            windowFeatures = windowFeatures + ",left = " + winLeft + ",";
            windowFeatures = windowFeatures + "top=" + winTop + ",resizable=yes" + ",scrollbars=yes";
            window.open(fullFilePath, "_blank", windowFeatures);


        }


        function GetDate(dateStr) {
            debugger;
            var components = dateStr.split(' ');
            var dateComponents = components[0].split('/');
            var month = dateComponents[0];
            var day = dateComponents[1].length == 1 ? "0" + dateComponents[1] : dateComponents[1];
            var year = dateComponents[2];
            var formattedDate = year + '-' + month + '-' + day;

            return formattedDate
        }



    </script>



    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#txtKMCovered').on('input', function () {
                $(this).val($(this).val().replace(/[^0-9]/g, ''));
            });
            $('#txtTourstartFromHomeKM').on('input', function () {
                $(this).val($(this).val().replace(/[^0-9]/g, ''));
            });
        });
    </script>
}

