            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }


        #tblData thead th {
            position: sticky;
            top: 0;
            background-color: inherit; /* Change the background color as needed */
            z-index: 1; /* Ensure the header stays above the content */
        }

        .tblScroll {
            height: 400px !important;
            display: block;
            overflow-y: scroll
        }

        .homeContent {
            padding: 0.30em 0.3em 0.78em !important;
