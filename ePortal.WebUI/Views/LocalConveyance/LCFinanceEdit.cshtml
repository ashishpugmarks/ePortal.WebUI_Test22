            background: #e9e9e9;
        }

        body {
            font-family: montserrat, arial, verdana;
            background: transparent;
        }

        .Headepanel {
            padding: 0px !important;
            margin: 2px;
        }

        .homeContent div {
            padding: 0px;
        }

        label {
            font-weight: normal !important;
            font-size: 17px !important;
        }

        #tblData tbody td:first-child {
            text-align: center;
        }

        /* Style for the action column */
        #tblData tbody td:last-child {
            text-align: center;
        }

        /* Style for the hidden columns */
        #tblData tbody td.hidden {
            display: none;
        }

        /* Style for the edit button */
        #tblData tbody td:last-child a.btn-primary {
            color: #fff;
            background-color: #428bca;
            border-color: #357ebd;
            padding: 6px 12px;
            margin: 2px;
