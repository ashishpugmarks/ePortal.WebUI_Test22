        function tableToJsonRow(rowIndex) {
            const headers = Array.from($("#tblData thead th")).map(header => header.textContent.trim());
            const columns = $("#tblData tbody tr:eq(" + rowIndex + ") td");

            const mapping = {

                "Date Of Expenditure": "DATEOFEXPENDITURE",
                "Final Conv. Amount" :  "FIN_CONV_AMOUNT",
                "Final Meal/refresh Amount" :  "FIN_MEAL_REFRE_AMOUNT"

            };





            const rowData = {};
            debugger;
            columns.each(function (index) {
                const columnName = headers[index];
                const propertyName = mapping[columnName];

                var cellValue;
                if(propertyName == "FIN_CONV_AMOUNT" || propertyName == "FIN_MEAL_REFRE_AMOUNT")
                {
                    //cellValue = $(this).text().trim();
                    cellValue = $(this).find('input').val().trim();

                }
                else
                {
                    cellValue = $(this).text().trim();
                }

                rowData[propertyName] = cellValue != '' ? cellValue : null;
            });

            return rowData;
        }


