@section Scripts{
    <script src="~/js/jquery-ui.js"></script>
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

        $(document).ready(function () {

            const currentDate = new Date();
            const firstDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
            const lastDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);

            $("#txtFromDate").val(formatDateForSeach(firstDayOfMonth));
            $("#txtToDate").val(formatDateForSeach(lastDayOfMonth));

            //Function For Searching//
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("table tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            //Function For Sorting//
            $("th").click(function () {
                var table = $(this).parents("table").eq(0)
                var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()))
                this.asc = !this.asc
                if (!this.asc) { rows = rows.reverse() }
                for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
            })


            //Function For Sorting//
            function comparer(index) {
                return function (a, b) {
                    var valA = getCellValue(a, index), valB = getCellValue(b, index)
                    return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
                }
            }

            //Function For Sorting//
            function getCellValue(row, index) {
                return $(row).children("td").eq(index).html()
            }


            PreLoadData();

            $('#btnSearch').click(function () {
                PreLoadData();
            });

            $(document).on("change", "#tblData tbody input[type=checkbox]", function () {
                calculateTotalAmount();
            });

            const searchTermInput = $("#txtECode");
            const selectedECodeInput = $("#selectedECode");

            searchTermInput.autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/LocalConveyance/AutocompleteSuggestions",
                        data: { term: request.term },
                        dataType: "json",
                        method: "GET",
                        success: function (data) {
                            if (data.resultObject && data.resultObject.length > 0) {

                                const suggestions = data.resultObject.map(function (suggestion) {
                                    return {
                                        label: suggestion.ecode + " - " + suggestion.name,
                                        value: suggestion.ecode,
                                    };
                                });
                                response(suggestions);
                            } else {
                                response([]);
                            }
                        },
                        error: function (error) {
                            console.error("Error fetching autocomplete suggestions:", error);
                            response([]);
                        },
                    });
                },
                select: function (event, ui) {
                    selectedECodeInput.val(ui.item.value);
                },
            });
        });


        function PreLoadData() {
            //var ToDate = formatDate($("#txtToDate").val());
            var FromDate = $("#txtFromDate").val();
            var ToDate = $("#txtToDate").val();
            var Ecode = $("#txtECode").val() == "" ? 0 : Number($("#txtECode").val());
            var Status = $("#ddlStatus").val();
            $('#loader_new').removeClass('hidden');

            debugger;
            //var FromDate = '01-Jan-2023';
            //var ToDate = '15-Feb-2023';
            $.ajax({

                type: "GET",
                url: "/LocalConveyance/GetLCAdminListDATA",
                data: { Ecode: Ecode, FromDate: FromDate, ToDate: ToDate, Status: Status },

                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    debugger;
                    if (JSON.parse(data).length != 0) {
                        var Data = JSON.parse(data);

                        $("#append_Data").empty();
                        $.each(Data, function (i, r) {
                            $("#append_Data").append('<tr><td><center>' + r.EMPCODE + '</center></td><td><center>' + r.EMPNAME + '</center></td><td><center>' + r.LCTRANNO + '</center></td><td><center>' + formatDate(r.LCTRANDATE) + '</center></td><td><center>' + r.DESIGNATION + '</center></td><td><center>' + r.TOTAL_NOOFHOURS + '</center></td><td><center>' + r.TOTAL_KMCOVERED + '</center></td><td><center>' + r.FUAL + '</center></td><td>' + EditorFormatterHistory(r.LCTRANNO) + '</td><td>' + EditorFormatter(r.LCTRANNO, r.EMPCODE) + '</td></tr>');// {EditorFormatterHistory added} SR107643 :: LC ENHANCEMENT ::  AUMENTO
                        });

                        // CSP 3.0 Compliant changes
                        $('[data-ctrl-id="Edit-Employee"]').on('click', function () {
                            const itemId = $(this).data('item-id');
                            const empCode = $(this).data('emp-code');
                            Edit(itemId, empCode);
                        });

                                // START :: SR107643 :: LC ENHANCEMENT ::  AUMENTO
                           $('[data-ctrl-id="History"]').on('click', function () {
                               debugger;
                               const itemId = $(this).data('item-id');
                               History(itemId);
                           });
                           $("#btnExport").attr("disabled", false);
        // END :: SR107643 :: LC ENHANCEMENT ::  AUMENTO
                    }
                    else {

                        $("#append_Data").empty();
                        $("#append_Data").append("<tr><td colspan='15' class='text-center'>No record found.</td></tr>")//Add 15 column no. SR107643 :: LC ENHANCEMENT ::  AUMENTO
                        $("#tblData").removeClass("tblScroll");
                    }
                    $('#loader_new').addClass('hidden');
                },
                complete: function () {
                },
                error: function () {
                    alert("Oops...", "Something went wrong!");
                }
            });



        }


        function EditorFormatter(i, EmpCode) {
            return '<center><a title="Edit" data-ctrl-id="Edit-Employee" data-item-id="' + i + '" data-emp-code="' + EmpCode + '" class="btn btn-link"><i class="ace-icon fa fa-edit"></i></a></center>';
        }



        function Edit(id, EmpCode) {

            var URL = '/LocalConveyance/LCAdminEdit/?id=' + id + '&EmpCode=' + EmpCode;

            $.fancybox.open({

                href: URL,
                type: 'iframe',
                padding: 1,
                maxWidth: 1300,
                maxHeight: 1200,
                fitToView: false,
                width: '1300px',
                height: '1200px',
                autoSize: true,
                closeClick: true,
                openEffect: 'elastic',
                openSpeed: 120,
                closeEffect: 'elastic',
                closeSpeed: 100,
                helpers:
                {
                    overlay: { closeClick: false }
                },
                afterClose: function () {
                    PreLoadData();
                }

            });

            return false;
        }


          function formatDate(inputDateString) {
            if (inputDateString == "") // SR107643 :: LC ENHANCEMENT ::  AUMENTO
                return ""; // SR107643 :: LC ENHANCEMENT ::  AUMENTO
            const inputDate = new Date(inputDateString);

            const day = inputDate.getDate();
            const month = inputDate.toLocaleString('default', { month: 'short' });
            const year = inputDate.getFullYear();

            return `${day}-${month}-${year}`;
        }

        function formatDateForSeach(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }
        function tableToJson(controlID) {
            const table = document.querySelector(controlID);
            const headers = Array.from(table.querySelectorAll("th")).map(header => header.textContent);
            const jsonData = Array.from(table.querySelectorAll("tr"))
                .slice(1)
                .map(row => {
                    const columns = row.querySelectorAll("td");
                    const obj = {};
                    columns.forEach((column, index) => {
                        obj[headers[index]] = column.textContent;
                    });
                    return obj;
                });
            return jsonData;
        }

        // START :: SR107643 :: LC ENHANCEMENT ::  AUMENTO
