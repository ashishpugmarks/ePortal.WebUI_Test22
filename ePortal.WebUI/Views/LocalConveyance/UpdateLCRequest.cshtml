@model ePortal.ViewModels.LocalConveyanceRequestViewModel

@{
    ViewBag.Title = "UpdateLCRequest";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";

}

@section Styles{
        <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">

        .homeContent {
            padding: 0.52em 0.3em 0.78em !important;
        }

            .homeContent div {
                padding: 5px;
            }

        label {
            font-size: 13px !important;
        }
    </style>
}


<div class="panel panel-primary top-margin-10">
    <div class="panel-heading">
        <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px;">
            <label>Add Details of Expenditure Date: </label><label id="lblDateOfExpenditure"></label>
        </h2>

    </div>
    <div class="panel-body">
        <span id="span-attachmentMsg" style="font-weight:600;"></span>

        <div id="btndiv">
            <div class="row hidden">
                @Html.TextBoxFor(model => model.EMPCODE, new { @class = "form-control", type = "text", id = "txtEmpCode" })
                @Html.TextBoxFor(model => model.EMPNAME, new { @class = "form-control", type = "text", id = "txtEmpName" })
                @Html.TextBoxFor(model => model.RATEPERKM, new { @class = "form-control", type = "text", id = "txtRatePerKM" })
                @Html.TextBoxFor(model => model.TRAVELREIMBURSEMENT, new { @class = "form-control", type = "text", id = "txtTravelReibursement" })
                @Html.TextBoxFor(model => model.DATEOFEXPENDITURE, new { @class = "form-control", type = "text", id = "txtDateOfExpenditure" })
                @Html.TextBoxFor(model => model.ASOFFODID, new { @class = "form-control", type = "text", id = "txtASOFFODID" })
                @Html.TextBoxFor(model => model.NOOFHOURS, new { @class = "form-control", type = "text", id = "txtNonfHours" })
                @Html.TextBoxFor(model => model.DT, new { @class = "form-control", type = "text", id = "txtDT" })
                @Html.TextBoxFor(model => model.TOLLTAXMISCAMOUNT, new { @class = "form-control", type = "text", id = "txttolltaxAmount" })
                @Html.TextBoxFor(model => model.TOTAL, new { @class = "form-control", type = "text", id = "txtTotal" })
                @Html.TextBoxFor(model => model.FromCityName, new { @class = "form-control", type = "text", id = "txtFromCityName" })
                @Html.TextBoxFor(model => model.ToCityName, new { @class = "form-control", type = "text", id = "txtToCityName" })

            </div>

            <div class="row">
                <!-- From City -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label>From City:</label>
                    @*@Html.DropDownList("ddlFromCity", new SelectList(ViewBag.City, "SYCITYID", "DESCRIP"), new { @class = "form-control"  })*@
                    @Html.DropDownListFor(model => model.FROMCITY, new SelectList(ViewBag.City, "SYCITYID", "DESCRIP"), new { @class = "form-control", id = "ddlFromCity" })
                    @Html.HiddenFor(model => model.FROMCITYID, new { @class = "form-control", id = "ddlFromCityID" })
                </div>

                <!-- From City (Other) -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3 hidden" id="divFromCityOther">
                    <label>From City (Other):</label>
                    @*<input type="text" class="form-control" id="txtFromCityOther" autocomplete="off" />*@
                    @Html.TextBoxFor(model => model.FROMCITY_OTHER, new { @class = "form-control", type = "text", id = "txtFromCityOther" })
                </div>

                <!-- To City -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label>To City:</label>
                    @*@Html.DropDownList("ddlToCity", new SelectList(ViewBag.City, "SYCITYID", "DESCRIP"), new { @class = "form-control" })*@
                    @Html.DropDownListFor(model => model.TOCITY, new SelectList(ViewBag.City, "SYCITYID", "DESCRIP"), new { @class = "form-control", id = "ddlToCity" })
                    @Html.HiddenFor(model => model.TOCITYID, new { @class = "form-control", id = "ddlToCityID" })
                </div>

                <!-- To City (Other) -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3 hidden" id="divToCityOther">
                    <label>To City (Other):</label>
                    @*<input type="text" class="form-control" id="txtToCityOther" autocomplete="off" />*@
                    @Html.TextBoxFor(model => model.TOCITY_OTHER, new { @class = "form-control", type = "text", id = "txtToCityOther" })
                </div>

                <!-- Time In -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Time In:</label>
                    @Html.TextBoxFor(model => model.TIMEIN, new { @class = "form-control", type = "time", id = "txtTimeIn" })
                </div>

                <!-- Time Out -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Time Out:</label>
                    @Html.TextBoxFor(model => model.TIMEOUT, new { @class = "form-control", type = "time", id = "txtTimeOut" })
                </div>
            </div>

            <div class="row">
                <!-- Purpose -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Purpose:</label>
                    @Html.TextAreaFor(model => model.PURPOSE, new { @class = "form-control", id = "txtPurpose", style = "width: 238px;", autocomplete = "off" })
                </div>
            </div>

            <div class="row">
                <!-- Mode Of Travel -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Mode of Travel:</label>
                    @Html.DropDownListFor(model => model.MODEOFTRAVEL,
                             new SelectList(
                             new List<object>
                    {
                    new { Value = "Taxi", Text = "Taxi" },
                    new { Value = "Bus/Train", Text = "Bus/Train" },
                    new { Value = "Auto", Text = "Auto" },
                    new { Value = "Self Car", Text = "Self Car" },
                    new { Value = "Self Bike/Scooter", Text = "Self Bike/Scooter" },
                    new { Value = "Other", Text = "Other" }
                    },
                             "Value",
                             "Text"
                             ),
                             new { @class = "form-control", id = "ddlModeofTravel" })
                </div>




                <!-- Mode Of Travel (Other) -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2 hidden" id="divModeOfTravelOther">
                    <label>Other:</label>
                    @*<input type="text" class="form-control" id="txtModeOfTravelOther" autocomplete="off" />*@
                    @Html.TextBoxFor(model => model.MODEOFTRAVEL_OTHER, new { @class = "form-control", type = "text", id = "txtModeOfTravelOther" })
                </div>

                <!-- KM Covered -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>KM Covered:</label>
                    @Html.TextBoxFor(model => model.KMCOVERED, new { @class = "form-control", id = "txtKMCovered", autocomplete = "off" })
                </div>

                <!-- Distance from Home -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label for="txtTourstartFromHomeKM">Distance round trip from home to plant :</label>
                    @Html.TextBoxFor(model => model.TOURSTARTFROMHOMEKM, new { @class = "form-control fixed-size", @id = "txtTourstartFromHomeKM", style = "width:64%;", autocomplete = "off" })
                </div>

                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <span style="color: red;"> * Required in case of tour start from home </span>
                </div>
            </div>

            <div class="row">
                <!-- Claim Refreshment Allowance -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Claim Refreshment Allowance?</label>
                    @*@Html.CheckBoxFor(model => model.MEAL_REFRE_ALLW_CLAIM, new { @id = "ChkMealRefreAllow" })*@
                    <input type="checkbox" id="ChkMealRefreAllow">
                </div>


                <!-- Refreshment Allowance Amount -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label>Refreshment Amount:</label>
                    @Html.TextBoxFor(model => model.REFRESHMENTMEALALLOWANCE, new { @class = "form-control", @id = "txtRefre_MealAllow", @readonly = "readonly", autocomplete = "off", pattern = @"\d*" })
                </div>


                <!-- Claim Fuel Allowance -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Claim Fuel Allowance?</label>
                    @*@Html.CheckBoxFor(model => model.FUEL_ALLW_CLAIM, new { @id = "ChkFuelAllow" })*@
                    <input type="checkbox" id="ChkFuelAllow">
                </div>

                <!-- Fuel Reimbursement -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label>Fuel Reimbursement (Litre):</label>
                    @Html.TextBoxFor(model => model.FUEL_REIMBURSMENT, new { @class = "form-control", @id = "txtFuelReimbursement", @readonly = "readonly", autocomplete = "off", pattern = @"\d*" })
                </div>
            </div>

            <div class="row">
                <!-- Claim Lunch Allowance -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Claim Lunch Allowance?</label>
                    @*@Html.CheckBoxFor(model => model.LUNCH_ALLW_CLAIM, new { @id = "ChkLunchAllowClaim" })*@
                    <input type="checkbox" id="ChkLunchAllowClaim">

                </div>

                <!-- Lunch Allowance Amount -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label>Lunch Allowance Amount:</label>
                    @Html.TextBoxFor(model => model.LUNCH_ALLW_AMOUNT, new { @class = "form-control", @id = "txtLunchAllowAmount", @readonly = "readonly", autocomplete = "off", pattern = @"\d*" })
                </div>

                <!-- Claim Dinner Allowance -->
                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                    <label>Claim Dinner Allowance?</label>
                    @*@Html.CheckBoxFor(model => model.DINNER_ALLW_CLAIM, new { @id = "ChkDinnerAllowClaim" })*@
                    <input type="checkbox" id="ChkDinnerAllowClaim">
                </div>

                <!-- Dinner Allowance Amount -->
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                    <label>Dinner Allowance Amount:</label>
                    @Html.TextBoxFor(model => model.DINNER_ALLW_AMOUNT, new { @class = "form-control", @id = "txtDinnerAllowAmount", @readonly = "readonly", autocomplete = "off", pattern = @"\d*" })
                </div>
            </div>

            <div class="row">
                <!-- Summary of bills -->
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Summary of bills</h2>
                    </div>
                    <div class="panel-body">
                        <div class="row hidden" id="btnaddbillsum">
                            <div class="row">
                                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2" style="padding-left: 24px;">
                                    <label>ReceiptNo:</label>
                                    <input type="text" class="form-control" id="txtReceiptNo" autocomplete="off">
                                </div>
                                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                                    <label>Date:</label>
                                    <input type="date" class="form-control" id="txtdate" autocomplete="off" />
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                    <label>Service Provider Name:</label>
                                    <input type="text" class="form-control" id="txtspName" autocomplete="off" />
                                </div>
                                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                                    <label>Amount:</label>
                                    <input type="text" class="form-control" id="txtTollTaxMisAmt" autocomplete="off" />
                                </div>
                                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                                    <label>DocType:</label>
                                    <select id="ddlDocType" class="form-control"></select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3" style="padding-left: 24px;">
                                    <label>Attached Doc</label>
                                    <input type="file" class="form-control" id="Attfile" autocomplete="off" />
                                </div>
                                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                                    <button type="submit" id="btnaddtolltax" style=" margin-top: 17PX; width: 47px;" class="btn btn-block btn-warning">Add</button>
                                </div>
                            </div>
                        </div>
                        <div style="padding-left:inherit">
                            <table id="tbltolltaxDt" class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                                <thead>
                                    <tr class="bg-info">
                                        <th class="text-center">Receipt No</th>
                                        <th class="text-center">Date</th>
                                        <th class="text-center">Service Provider Name</th>
                                        <th class="text-center">Amount</th>
                                        <th class="text-center">DocType</th>
                                        <th class="text-center">Attachment</th>
                                        <th class="text-center">Delete</th>
                                        <th class="text-center hidden">RowID</th>
                                    </tr>
                                </thead>
                                <tbody id="append_tolltaxDtRow">

                                    <tr>
                                        <th colspan="7" class="text-center">No records found</th>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <center>
                    <div id="divbtn">
                        <button type="submit" id="btnsubmit" style="width: 100px; " class="btn btn-block btn-success"><i class="menu-icon fa fa-save"></i> &nbsp; Update</button>
                    </div>

                </center>
            </div>


        </div>
    </div>
</div>

@section Scripts{
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_2"]">
        var Rowid;
        var fileName = "";
        var LoadData;
        var StatusId;
        var FuelReimbursPerLeter;

        var LunchStartTime;
        var LunchEndTime;
        var DinnerStartTime;
        var DinnerEndTime;
        var MealAmount_;
        var FuelReimbur;
        var RefreshAmount;
        var TotalTaxAmount;


        $(document).ready(function () {
            debugger;

            if ('@ViewBag.Status' == '2')
            {
                parent.jQuery.fancybox.close();
            }


            Rowid = @ViewBag.id;

            StatusId = @ViewBag.StatusId;

            LunchStartTime  = '@ViewBag.LunchStartTime';
            LunchEndTime  = '@ViewBag.LunchEndTime';
            DinnerStartTime  = '@ViewBag.DinnerStartTime';
            DinnerEndTime  = '@ViewBag.DinnerEndTime';

            LoadData = JSON.parse(localStorage.getItem("LocalConveyanceDATABEFORE"));

            var currentDate = new Date().toISOString().split('T')[0];

            $('#txtdate').attr('max', currentDate);
            $('#txtdate').change(function() {
                var selectedDate = $(this).val();
                if (selectedDate > currentDate) {
                    alert('Please select a date equal to or before today.');
                    $(this).val(currentDate);
                }
            });


            if (StatusId == 0 || StatusId == 3)
            {
                $("#btnaddtolltax").removeClass('hidden');
                $("#divbtn").removeClass('hidden');
                $("#btnaddbillsum").removeClass('hidden');

            }
            else
            {
                $("#btnaddtolltax").addClass('hidden');
                $("#divbtn").addClass('hidden');
                $("#btnaddbillsum").addClass('hidden');
                disableControls();

            }

            if (LoadData.length != 0)
            {
                if(LoadData[Rowid]["DT"] != null && LoadData[Rowid]["DT"] != "" && LoadData[Rowid]["DT"] !=  "[{}]" && LoadData[Rowid]["DT"] !=  "[]")
                {
                    var TableData =  JSON.parse(LoadData[Rowid]["DT"]);
                    $("#append_tolltaxDtRow").empty();
                    $.each(TableData, function (i, r) {

                        debugger;
                        TotalTaxAmount =  r["DocType"]  == "Toll Tax Bill"  ? (Number(TotalTaxAmount) + Number(r["Amount"] || 0)) : 0;

                        var Attachment = r.Attachement || r.Attachment;

                        var ReceiptNo = r["Receipt No"] || r["ReceiptNo"];

                        var downloadIcon = '';
                        if ( Attachment != "" &&  Attachment != "No files selected.") {
                            downloadIcon = '<a href="#" data-ctrl-id="Download-Attachment" data-attachment="' + Attachment + '"><label style="display:none">' + Attachment + '</label><i class="fa fa-download"></i></a>';
                        }

                        if (StatusId == 0 || StatusId == 3)
                        {
                            $("#tbltolltaxDt").find("th:contains('Delete')").show();
                            $("#append_tolltaxDtRow").append('<tr><td><center>' + ( ReceiptNo  == null ? "" : ReceiptNo)  + ' </center></td><td><center>' + (r["Date"] == null ? "" : r["Date"]) + '</center></td><td><center>' + (r["Service Provider Name"] == null ? "" : r["Service Provider Name"]) + '</center></td><td><center>' + r["Amount"] + '</center></td><td><center> ' + r["DocType"]  +'</center></td><td><center>' + downloadIcon + '</center></td><td><center><a href="#" class="delete-button"><i class="fa fa-trash-o"></i></a></center></td><td class="hidden">' + Rowid + '</td></tr>');
                        }
                        else
                        {
                            $("#tbltolltaxDt").find("th:contains('Delete')").hide();
                            $("#append_tolltaxDtRow").append('<tr><td><center>' + ( ReceiptNo  == null ? "" : ReceiptNo)  + ' </center></td><td><center>' + (r["Date"] == null ? "" : r["Date"]) + '</center></td><td><center>' + (r["Service Provider Name"] == null ? "" : r["Service Provider Name"]) + '</center></td><td><center>' + r["Amount"] + '</center></td><td><center> ' + r["DocType"]  +'</center></td><td><center>' + downloadIcon + '</center></td><td class="hidden">' + Rowid + '</td></tr>');

                        }


                    });

                    // CSP 3.0 Compliant Changes
                    $(document).on("click", '[data-ctrl-id="Download-Attachment"]', function () {
                        const attachment = $(this).data("attachment");
                        return Download(attachment);
                    });

                }

                debugger;
                $("#txtEmpCode").val(LoadData[Rowid]["EmpCode"]);
                $("#txtEmpName").val(LoadData[Rowid]["EmpName"]);
                $("#txtASOFFODID").val(LoadData[Rowid]["ASOFFODID"]);
                $("#txtRatePerKM").val(LoadData[Rowid]["Rate Per Km"]);
                $("#txtTravelReibursement").val(LoadData[Rowid]["Travel Reimburse.(Rs.)"]);
                $("#ddlToCityID").val(LoadData[Rowid]["ToCityId"]);
                $("#ddlFromCityID").val(LoadData[Rowid]["FromCityId"]);

                $("#txtToCityName").val(LoadData[Rowid]["To (City)"]);
                $("#txtFromCityName").val(LoadData[Rowid]["From (City)"]);

                var date_ = formatDate(LoadData[Rowid]["Date Of Expenditure"]);
                $("#txtDateOfExpenditure").val(date_);
                $("#txtNonfHours").val(LoadData[Rowid]["No. Of Hours"]);
                //$("#txtDT").val(LoadData[Rowid]["DT"]);

                $("#txttolltaxAmount").val(TotalTaxAmount);
                var DT = tableToJson("#tbltolltaxDt");
                var JsonStringDt = JSON.stringify(DT);
                $("#txtDT").val(JsonStringDt);



                var Total_ =  (Number(TotalTaxAmount) +  Number(LoadData[Rowid]["Refreshment/Meal Allow."] || 0) + Number(LoadData[Rowid]["Travel Reimburse.(Rs.)"] || 0)) || 0;

                $("#txtTotal").val(Total_);
                $("#lblDateOfExpenditure").text(LoadData[Rowid]["Date Of Expenditure"]);
                $("#txtTimeIn").val(LoadData[Rowid]["Time In"]);
                $("#txtTimeOut").val(LoadData[Rowid]["Time Out"]);
                $("#txtKMCovered").val(LoadData[Rowid]["Km Covered"]);
                $("#txtTourstartFromHomeKM").val(LoadData[Rowid]["TOURSTARTFROMHOMEKM"]);
                $("#txtPurpose").val(LoadData[Rowid]["Purpose"]); // Added by Aumento as on 26-06-2024

                if(LoadData[Rowid]["ModeOfTravel"] == ""){
                    $("#ddlModeofTravel").val($("#ddlModeofTravel option:first").val());
                } else {
                    $("#ddlModeofTravel").val(LoadData[Rowid]["ModeOfTravel"]);
                }


                var selectedValue_ = $("#ddlModeofTravel").val();
                $("#ddlDocType").empty();

                if (selectedValue_ == 'Taxi') {
                    // Add options for Taxi
                    $("#ddlDocType").append('<option value="Taxi Bill">Taxi Bill</option>');
                    $("#ddlDocType").append('<option value="Toll Tax Bill">Toll Tax Bill</option>');
                }
                else if (selectedValue_ == 'Bus/Train') {
                    // Add options for Bus
                    $("#ddlDocType").append('<option value="Bus/Train Ticket">Bus/Train Ticket</option>');
                }
                else if (selectedValue_ == 'Auto' ) {
                    // Add options for Auto, Self Car, or Self Bike/Scooter
                    $("#ddlDocType").append('<option value="Auto Fare">Auto Fare</option>');
                    $("#ddlDocType").append('<option value="Toll Tax Bill">Toll Tax Bill</option>');
                }
                else if (selectedValue_ == "Self Car" || selectedValue_ == "Self Bike/Scooter") {
                    // Add options for Auto, Self Car, or Self Bike/Scooter
                    $("#ddlDocType").append('<option value="Toll Tax Bill">Toll Tax Bill</option>');

                }
                else {
                    // Add options for Other
                    $("#ddlDocType").append('<option value="-">-</option>');
                    $("#ddlDocType").append('<option value="Taxi Bill">Taxi Bill</option>');
                    $("#ddlDocType").append('<option value="Toll Tax Bill">Toll Tax Bill</option>');
                    $("#ddlDocType").append('<option value="Bus/Train Ticket">Bus/Train Ticket</option>');
                    $("#ddlDocType").append('<option value="Auto Fare">Auto Fare</option>');

                }
                $("#ddlDocType").append('<option value="Other Charges">Other Charges</option>'); // Added by Aumento :: SR107643 :: LC Enhancement :: Additional Change

                $("#ddlFromCity").val(LoadData[Rowid]["FromCityId"]);
                $("#ddlToCity").val(LoadData[Rowid]["ToCityId"]);
                $("#txtFromCityOther").val(LoadData[Rowid]["FromCityOther"]);
                $("#txtToCityOther").val(LoadData[Rowid]["ToCityOther"]);
                $("#txtModeOfTravelOther").val(LoadData[Rowid]["ModeOfTravelOther"]);

                if (LoadData[Rowid]["FromCityId"] == '0') {
                    $("#divFromCityOther").removeClass('hidden');
                } else {
                    $("#divFromCityOther").addClass('hidden');
                }

                if (LoadData[Rowid]["ToCityId"] == '0') {
                    $("#divToCityOther").removeClass('hidden');
                } else {
                    $("#divToCityOther").addClass('hidden');
                }


                if ( LoadData[Rowid]["ModeOfTravel"] == 'Other') {
                    $("#divModeOfTravelOther").removeClass('hidden');
                } else {
                    $("#divModeOfTravelOther").addClass('hidden');
                }


                if (LoadData[Rowid]["MealRefreAllowClaim"] != "NO")
                {
                    $("#ChkMealRefreAllow").prop('checked', true);
                    $("#txtRefre_MealAllow").val(LoadData[Rowid]["RefreshmentAmount"]);
                }
                else
                {
                    $("#ChkMealRefreAllow").prop('checked', false);
                    $("#txtRefre_MealAllow").val(0);
                }

                if (LoadData[Rowid]["FuelAllowClaim"] != "NO")
                {
                    $("#ChkFuelAllow").prop('checked', true);
                    $("#txtFuelReimbursement").val(LoadData[Rowid]["Fuel Reimburse."]);
                }
                else
                {
                    $("#ChkFuelAllow").prop('checked', false);
                    $("#txtFuelReimbursement").val(0);
                }

                if (LoadData[Rowid]["DinnerAllowClaim"] != "NO")
                {
                    $("#ChkDinnerAllowClaim").prop('checked', true);
                    $("#txtDinnerAllowAmount").val(LoadData[Rowid]["DinnerAllowAmount"]);
                }
                else
                {
                    $("#ChkDinnerAllowClaim").prop('checked', false);
                    $("#txtDinnerAllowAmount").val(0);
                }

                if (LoadData[Rowid]["LunchAllowClaim"] != "NO")
                {
                    $("#ChkLunchAllowClaim").prop('checked', true);
                    $("#txtLunchAllowAmount").val(LoadData[Rowid]["LunchAllowAmount"]);
                }
                else
                {
                    $("#ChkLunchAllowClaim").prop('checked', false);
                    $("#txtLunchAllowAmount").val(0);
                }

                Getallowcheck();

            }

            $('#txtKMCovered').on('blur', function() {

                var kmCoveredValue = parseFloat($(this).val());


                if (kmCoveredValue <= 250) {

                    Getallowcheck();
                } else {

                    alert("You cannot enter more than 250 KM for Local Conveyance OD");

                    $(this).val(0);
                }
            });

            $('#txtTourstartFromHomeKM').on('blur', function() {

