        function GenerateExcel() {
            var FromDate = $("#txtFromDate").val();
            var ToDate = $("#txtToDate").val();
            var Ecode = $("#txtECode").val() == "" ? 0 : Number($("#txtECode").val());
            var Status = $("#ddlStatus").val();
            $('#loader_new').removeClass('hidden');

            $.ajax({
                type: "GET",                
                data: { Ecode: Ecode, FromDate: FromDate, ToDate: ToDate, Status: Status, Flag: 'FINANCE' }, // { Flag: 'FINANCE' added} SR107643 :: LC ENHANCEMENT ::  AUMENTO
                url: "/LocalConveyance/DownloadExcelData",
                success: function (data) {
                    $('#loader_new').addClass('hidden');
                    debugger;
                    var DATA1 = JSON.parse(data);
                    if (!DATA1 || DATA1.length === 0) {
                        alert("No data available to generate Excel file.");
                        return;
                    }

                    // Clear the table body
                    $("#append_Data_DT").empty();

                    // Populate the table with the received data
                    $.each(DATA1, function (i, r) {
                        debugger;
                        var row = $("<tr>");
                        row.append('<td><center>' + (r.EMPCODE + "-" + r.EMPNAME) + '</center></td>');
                    row.append('<td><center>' + r.LCTRANNO + '</center></td>');
