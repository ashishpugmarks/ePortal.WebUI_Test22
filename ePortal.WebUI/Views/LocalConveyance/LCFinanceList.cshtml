            $.fancybox.open({

                href: URL,
                type: 'iframe',
                padding: 1,
                maxWidth: 1300,
                maxHeight: 1200,
                fitToView: false,
                width: '1300px',
                height: '1200px',
                autoSize: true,
                closeClick: true,
                openEffect: 'elastic',
                openSpeed: 120,
                closeEffect: 'elastic',
