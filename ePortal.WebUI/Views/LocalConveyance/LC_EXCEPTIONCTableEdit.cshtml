@model ePortal.DomainClasses.LC_EXCEPTION_C_TABLE
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";
}

@section Styles {
    <link href="~/css/jquery-ui.css" rel="stylesheet" />

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .homeContent {
            padding: 0.52em 0.3em 0.78em !important;
        }

        label {
            font-weight: normal !important;
            font-size: 17px !important;
        }
    </style>
}


<div class="panel panel-primary top-margin-10" style="height:450px;">
    <div class="panel-heading">
        <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px;">Edit Record</h2>
    </div>
    <div class="panel-body">
        <span id="span-attachmentMsg" style="font-weight:600;"></span>
        <div class="col-lg-2 hidden" style="margin:10px;">
            <input type="hidden" id="SRNO" name="SRNO" value="@Model.SRNO">
        </div>
        <div style="margin-top:25px;">


            <div class="col-lg-2" style="margin:10px;">
                <label style="padding-bottom:5px">Emp Code</label>
                <input type="text" class="form-control" id="txtEmpCode" placeholder="Enter Emp Code" value="@Model.EMPCODE" autocomplete="off" />
                <input type="hidden" id="selectedECode1" name="selectedECode1">

            </div>

            <div class="col-lg-2" style="margin:10px;">
                <label style="padding-bottom:5px">FUEL REIMBUR PER LTR</label>
                <input type="number" class="form-control" id="txtFuelReimbursementPerLtr" placeholder="Enter FUEL REIMBUR PER LTR" value="@Model.FUEL_REIMBUR_PER_LTR" autocomplete="off" pattern="\d*" />
            </div>
            <div class="col-lg-2" style="margin:10px;">
                <label style="padding-bottom:5px">REMARKS</label>
                <textarea class="form-control" id="txtREMARKS" placeholder="Enter REMARKS" autocomplete="off"></textarea>
            </div>
            <div class="col-lg-2" style="margin:10px;">
                <label style="padding-bottom:5px">From Date</label>
                <input type="date" class="form-control" id="txtFromDate" autocomplete="off" />

            </div>
            <div class="col-lg-2" style="margin:10px;">
                <label style="padding-bottom:5px">To Date</label>
                <input type="date" class="form-control" id="txtToDate" autocomplete="off" />

            </div>

            <div class="col-lg-2" style="margin:10px;">
                <button type="submit" id="btnsubmit" class="btn btn-block btn-success"><i class="menu-icon fa fa-save"></i> &nbsp; Update</button>
            </div>

        </div>
    </div>
</div>

