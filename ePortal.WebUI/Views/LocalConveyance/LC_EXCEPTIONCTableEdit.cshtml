                function GetDate(dateStr) {
            debugger;
            var components = dateStr.split(' ');
            var dateComponents = components[0].split('/');
            var month = dateComponents[0].length == 1 ? "0" + dateComponents[0] : dateComponents[0];
            var day = dateComponents[1].length == 1 ? "0" + dateComponents[1] : dateComponents[1];
            var year = dateComponents[2];
            var formattedDate = year + '-' + month + '-' + day;
            return formattedDate
        }

        function Save() {
            debugger;
                var SRNO = $('#SRNO').val();
                var EmpCode = $('#txtEmpCode').val();
                var FuelReimbursementPerLtr = $('#txtFuelReimbursementPerLtr').val();
                var FromDate = $('#txtFromDate').val();
                var ToDate = $('#txtToDate').val();
                var REMARKS = $('#txtREMARKS').val();

                if (EmpCode == "") {

                    return alert("Please Enter Emp. Code.");
                }


                if (FuelReimbursementPerLtr == "") {

                    return alert("Please Enter Fuel Reimbursement Per Ltr");
                }

                if (FromDate == "") {

                    return alert("Please Select From Date ...");
                }
                if (ToDate == "") {

                    return alert("Please Select To Date ...");
                }
                var URL = '/LocalConveyance/LC_EXCEPTIONCTableEdit/?SrNo=' + SRNO + '&EmpCode=' + EmpCode + '&FuelReimbursementPerLtr=' + FuelReimbursementPerLtr + '&FromDate=' + FromDate + '&ToDate=' + ToDate + '&Remarks= ' + REMARKS;

                    $.ajax({
                        type: "POST",
                        url: URL,
                        datatype: "json",
                        contentType: false,
                        processData: false,
                        success: function (data) {
                            debugger;

                            alert(JSON.parse(data).errorMessage);
                                parent.jQuery.fancybox.close();


                        },
                        error: function () {
                            $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                            $("#btnUpload").attr("disabled", false);
                        }
                    });


        }

        function AutoSuggest(ID, Value) {
            ID.autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/LocalConveyance/AutocompleteSuggestions",
                        data: { term: request.term },
                        dataType: "json",
                        method: "GET",
                        success: function (data) {
                            if (data.resultObject && data.resultObject.length > 0) {

                                const suggestions = data.resultObject.map(function (suggestion) {
                                    return {
                                        label: suggestion.ecode + " - " + suggestion.name,
                                        value: suggestion.ecode,
                                    };
                                });
                                response(suggestions);
                            } else {
                                response([]);
                            }
                        },
                        error: function (error) {
                            console.error("Error fetching autocomplete suggestions:", error);
                            response([]);
                        },
                    });
                },
                select: function (event, ui) {
                    Value.val(ui.item.value);
                },
            });
        }


    </script>

    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#btnsubmit').on('click', function () {
                Save();
            });
        });
    </script>
