					}
				//}
				//else {
				//    alert("Request cannot submitted with zero amount.");
				//}
			});

			$('#ddlStatus').change(function () {
				var selectedStatus = $(this).val();
				OnchangesOfStatus();
			});
		});

		// New Function Added by Aumento as on 21-06-2024
		function SetCurrentMonth() {

			var today = new Date();
			var month = (today.getMonth() + 1).toString().padStart(2, '0'); // January is 0!
			var year = today.getFullYear();
			var currentMonthYear = year + '-' + month;
			$('#txtFromDate').val(currentMonthYear);

			return false;
		}

		function OnchangesOfStatus() {
			var selectedStatus = $("#ddlStatus").val();
			var monthCount = '@ViewBag.MonthCount';
			if (selectedStatus === "0") {
				SetCurrentMonth(); // SR107643 :: LC ENHANCEMENT ::  AUMENTO
				var CurrentYYYYMM = $("#txtFromDate").val();
				var minYYYYMM = subtractMonths(CurrentYYYYMM, monthCount);
				var maxYYYYMM = CurrentYYYYMM;

				$("#txtFromDate").attr('min', minYYYYMM);
				$("#txtFromDate").attr('max', maxYYYYMM);
				$("#txtFromDate").val(maxYYYYMM); // SR107643 :: LC ENHANCEMENT ::  AUMENTO
			} else {
				$("#txtFromDate").attr('min', '');
				$("#txtFromDate").attr('max', '');
				SetCurrentMonth();
			}
		}

		// START ::  Added by Aumento :: SR88947
		//function subtractMonths(YYYYMM, months) {
		//    debugger;
		//    var year = parseInt(YYYYMM.substring(0, 4));
		//    var month = parseInt(YYYYMM.substring(5, 7));
		//    month -= months;
		//    if (month <= 0) {
		//        year -= Math.ceil(Math.abs(month) / 12);
		//        month = 12 - (Math.abs(month) % 12);
		//    }
		//    var monthStr = ('0' + month).slice(-2);
		//    return year + '-' + monthStr;
		//}


		function subtractMonths(yyyyMM, monthsToSubtract) {
			debugger;
			var [year, month] = yyyyMM.split('-').map(Number);
			month -= monthsToSubtract;
			while (month <= 0) {
				month += 12;
				year -= 1;
			}
			month = month.toString().padStart(2, '0');
			return `${year}-${month}`;
		}
		// END ::  Added by Aumento :: SR88947

		// New Function Added by Aumento as on 21-06-2024
		function PreLoadData() {
			$('#loader_new').removeClass('hidden');
			var Status = $("#ddlStatus").val();
			var FromDate = $("#txtFromDate").val();

			const colorArray = ["bisque", "gold", "darksalmon", "wheat", "powderblue", "cadetblue", "turquoise", "bisque" ];
			var ReqID = 0;
			var colorIndex = 0;
			var empBgColor = "";

			$.ajax({
				type: "GET",
				url: "/LocalConveyance/GetODDATA",
				data: { FromDate: FromDate, Status: Status },// changed by Aumento as on 21-06-2024
				contentType: "application/json; charset=utf-8",
				datatype: "json",
				success: function (data) {
					if (JSON.parse(data).length != 0) {
						var EMPDATA = JSON.parse(data).EmployeeData;
						var ODDATA = JSON.parse(data).ODData;
						$("#append_Data").empty();

						$("#txtEcode").val(EMPDATA[0].ADEMPCODE);
						$("#txtEname").val(EMPDATA[0].EmpName);
						$("#txtDesignation").val(EMPDATA[0].ADDESIGNATION);
						$("#txtDate").val(formatDate(EMPDATA[0].CurrentDate));
						$("#txtDivision").val(EMPDATA[0].DIVISION);
						$("#txtDepartment").val(EMPDATA[0].DEPARTMENT);
						$("#txtSection").val(EMPDATA[0].SECTION);
						$("#txtMobile").val(EMPDATA[0].TMOBILE);

						if (ODDATA.length != 0) {
							$("#tblData").addClass("tblScroll");
							$("#append_Data").empty();

							$.each(ODDATA, function (i, r) {
								//debugger;
								var _FROMCITY = r.FROMCITY == "Other" ? r.FROMCITY_OTHER : r.FROMCITY;
								var _TOCITY = r.TOCITY == "Other" ? r.TOCITY_OTHER : r.TOCITY;
								var _ModelOfTravel = r.MODEOFTRAVEL == "Other" ? r.MODEOFTRAVEL_OTHER : r.MODEOFTRAVEL
								var _TEMPID = r.TEMPID == null ? 0000 : r.TEMPID;
								var MealAllowance_Refresh = (r.LUNCH_ALLW_AMOUNT == null ? 0 : Number(r.LUNCH_ALLW_AMOUNT))
									 + (r.DINNER_ALLW_AMOUNT == null ? 0 : Number(r.DINNER_ALLW_AMOUNT))
									 + (r.REFRESHMENTMEALALLOWANCE == null ? 0 : Number(r.REFRESHMENTMEALALLOWANCE));


								var TOTAL = Number(r.TOLLTAXMISCAMOUNT) + Number(MealAllowance_Refresh) + Number(r.TRAVELREIMBURSEMENT);

								if (r.ISSUBMITTED == "0" || r.ISSUBMITTED == "3") {

									if (ReqID != _TEMPID)
									{
										colorIndex = colorIndex + 1;
										ReqID = _TEMPID;
										colorIndex = colorArray.Length == colorIndex ? 0 : colorIndex;
