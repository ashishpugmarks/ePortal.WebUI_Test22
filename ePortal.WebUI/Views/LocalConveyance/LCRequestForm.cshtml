		//// Added by Aumento as on 09092024
		function formatDate(inputDateString) {
		   const inputDate = new Date(inputDateString);

			const monthNames = ["Jan", "Feb", "Mar", "Apr",
						"May", "Jun", "Jul", "Aug",
						"Sep", "Oct", "Nov", "Dec"];

			const day = String(inputDate.getDate()).padStart(2, '0');
			//const month = inputDate.toLocaleString('default', { month: 'short' });
			const monthIndex = inputDate.getMonth();
			const month = monthNames[monthIndex];

			const year = inputDate.getFullYear();

			return `${day}-${month}-${year}`;
		}



		function tableToJson(controlID) {
			const table = document.querySelector(controlID);
			const headers = Array.from(table.querySelectorAll("th")).map(header => header.textContent);
			const jsonData = Array.from(table.querySelectorAll("tr"))
			  .slice(1)
			  .map(row => {
				  const columns = row.querySelectorAll("td");
				  const obj = {};
				  columns.forEach((column, index) => {
					  obj[headers[index]] = column.textContent;
				  });
				  return obj;
			  });
			return jsonData;
		}

		var GlobalLastTempID = 0;
		function calculateTotalAmount() {
			var totalAmount = 0;
			var totalKmCovred = 0;
			var totalNoOfHours = 0;
			var totalFuelReimburs = 0;
			var CheckCount = 0;
			// Iterate through checked checkboxes and sum up the total amount
			$("table tbody input[type=checkbox]:checked").each(function () {

				CheckCount = CheckCount + 1;

				var rowIndex = $(this).closest("tr").index();

				var TempID = parseFloat($("#tblData tbody tr:eq(" + rowIndex + ") td:eq(0)").text().replace('|', '').trim() || 0);

				if (GlobalLastTempID != 0 && TempID != GlobalLastTempID) {

					$("#" + this.id).prop('checked', false);
					alert('In case of send back, you can select only those ODs which have same Req ID.');
					return;
				}
				else if (GlobalLastTempID > 0 && TempID == 0)
				{
					$("#" + this.id).prop('checked', false);
					alert('Please select only that OD which is send back from approval/finance authority');
					return;
				}

				if (TempID > 0)
				{
					GlobalLastTempID = TempID;
				}

				totalAmount += parseFloat($("#tblData tbody tr:eq(" + rowIndex + ") td:eq(15)").text());
				totalKmCovred += parseFloat($("#tblData tbody tr:eq(" + rowIndex + ") td:eq(9)").text());
				totalNoOfHours += parseFloat($("#tblData tbody tr:eq(" + rowIndex + ") td:eq(7)").text());
				totalFuelReimburs += parseFloat($("#tblData tbody tr:eq(" + rowIndex + ") td:eq(14)").text());

			});

			// Display the total amount in the first textbox
			$("#txtTotalAmount").val(totalAmount.toFixed(2));

			$("#txtTotalFuelReimburs").val(totalFuelReimburs);
			$("#txtTotalKMCovered").val(totalKmCovred.toFixed(2));
			$("#txtTotalNoOfHours").val(totalNoOfHours.toFixed(2));
			// Convert the total amount to words and display in the second textbox
			var amountInWords = convertNumberToWords(totalAmount);
			$("#txtAmountInWords").val(amountInWords);

			if(CheckCount == 0)
			{
				GlobalLastTempID = 0;
			}
		}






		function convertNumberToWords(amount) {
			var words = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
			var teens = ['Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
			var tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

			function convertLessThanThousand(number) {
				if (number === 0) {
					return '';
				} else if (number <= 10) {
					return words[number] + ' ';
				} else if (number < 20) {
					return teens[number - 11] + ' ';
				} else if (number < 100) {
					return tens[Math.floor(number / 10)] + ' ' + convertLessThanThousand(number % 10);
				} else {
					var hundreds = words[Math.floor(number / 100)] + ' Hundred ';
					var remainder = number % 100;
					if (remainder !== 0) {
						return hundreds + convertLessThanThousand(remainder);
					} else {
						return hundreds;
					}
				}
			}

			if (isNaN(amount) || amount < 0 || amount > 1000000000) {
				return 'Invalid input';
			}

			if (amount === 0) {
				return 'Zero';
			}

			var result = '';
			var crore = Math.floor(amount / 10000000);
			var lakh = Math.floor((amount % 10000000) / 100000);
			var thousand = Math.floor((amount % 100000) / 1000);
			var remainder = amount % 1000;

			if (crore > 0) {
				result += convertLessThanThousand(crore) + 'Crore ';
			}

			if (lakh > 0) {
				result += convertLessThanThousand(lakh) + 'Lakh ';
			}

			if (thousand > 0) {
				result += convertLessThanThousand(thousand) + 'Thousand ';
			}

			if (remainder > 0) {
				result += convertLessThanThousand(remainder);
			}

			return result.trim();
		}

