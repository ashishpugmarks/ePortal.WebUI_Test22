				"RefreshmentAmount": "REFRESHMENTMEALALLOWANCE",
				"TOURSTARTFROMHOMEKM": "TOURSTARTFROMHOMEKM"
			};

			const rowData = {};

			columns.each(function (index) {
				const columnName = headers[index];
				const propertyName = mapping[columnName];
				const cellValue = $(this).text().trim();
				rowData[propertyName] = cellValue !== '' ? cellValue : null;
			});

			return rowData;
		}

		function convertDateFormatForlocalstoreage(dateString) {
			// Parse the date string
			const parts = dateString.split('-');

			// Extract day, month, and year from the parts
			const day = parseInt(parts[0].trim(), 10);
			const monthStr = parts[1].trim();
			const year = parseInt(parts[2].trim(), 10);

			// Convert month string to a numeric month (January is 0, December is 11)
			const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
			const month = monthNames.findIndex(name => name === monthStr);

			// Create a new Date object with the extracted values
			const dateObject = new Date(year, month, day);

			// Format the date as 'YYYY-MM-DD'
			const formattedDate = `${dateObject.getFullYear()}-${(dateObject.getMonth() + 1).toString().padStart(2, '0')}-${dateObject.getDate().toString().padStart(2, '0')}`;

			return formattedDate;
		}

