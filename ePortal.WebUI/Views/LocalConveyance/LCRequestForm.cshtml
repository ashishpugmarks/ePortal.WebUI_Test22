@section Scripts {
	<script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
		$('.homeContent').removeClass('homeContent');
		$(document).ready(function () {
			SetCurrentMonth();  //  Added by Aumento as on 21-06-2024
			OnchangesOfStatus();  // Added by Aumento as on 21-06-2024

			//Function For Searching//
			$("#searchInput").on("keyup", function () {
				var value = $(this).val().toLowerCase();
				$("table tbody tr").filter(function () {
					$(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
				});
			});

			//Function For Sorting//
			$("th").click(function () {
				var table = $(this).parents("table").eq(0)
				var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()))
				this.asc = !this.asc
				if (!this.asc) { rows = rows.reverse() }
				for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
			})

			//Function For Sorting//
			function comparer(index) {
				return function (a, b) {
					var valA = getCellValue(a, index), valB = getCellValue(b, index)
					return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
				}
			}

			//Function For Sorting//
			function getCellValue(row, index) {
				return $(row).children("td").eq(index).html()
			}

			PreLoadData();

			$('#btnSearch').click(function () {
				PreLoadData();
			});

				   // START :: SR107643 :: LC ENHANCEMENT ::  AUMENTO
				  $('#btnAdd').click(function () {
					  Add();
				  });
		// END :: SR107643 :: LC ENHANCEMENT ::  AUMENTO

			$(document).on("change", "#tblData tbody input[type=checkbox]", function () {
				calculateTotalAmount();
				//var anyCheckboxChecked = $('#tblData input[type="checkbox"][id$="_Req"]:checked').length > 0;
				var anyCheckboxChecked = ($('#tblData input[type="checkbox"][id$="_Req"]:checked').length > 0 && $('input[type="checkbox"][id$="chk_Declaration"]:checked').length > 0 ? true : false)
				$('#btnSubmit').prop('disabled', !anyCheckboxChecked);

			});

			$('#btnSubmit').click(function () {
				//var totAmt = Number($('#txtTotalAmount').val());
				//if (totAmt > 0) {
					$("#ddlPPLocation").removeClass('validationError');
					if ($('#ddlPPLocation').val() == "") {
						$("#ddlPPLocation").addClass('validationError');
						sweetAlert("", "Please select payment processing location before submitting", "warning");
						return;
					}
					else {
						var dropdown = document.getElementById("ddlPPLocation");
						var sitevalue = dropdown.options[dropdown.selectedIndex].text;
						swal({
							title: "Are you sure?",
							type: "warning",
							showCancelButton: true,
							confirmButtonColor: '#DD6B55',
							confirmButtonText: 'OK',
							cancelButtonText: "Cancel",
