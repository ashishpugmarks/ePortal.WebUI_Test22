@section Styles {
	<link href="~/css/loading_spinner.css" rel="stylesheet" />

	<style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
		.validationError {
			border: 1px solid #a94442 !important;
		}

		.tableHD {
			padding: 6px 10px;
			text-align: center;
		}

		.tableHDPurpose {
			padding: 6px 10px;
			text-align: center;
			white-space: nowrap;
		}

		.table th i {
			margin-left: 5px;
		}

		.table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
			padding: 3px;
			width: initial;
			line-height: 1.0;
			vertical-align: middle;
			font-family: "Helvetica Neue", Helvetica, Arial;
			border: 1px solid #8ac2de;
			align-content: center;
			font-size: 90% !important;
		}

		.table-bordered {
			border: 1px solid #8ac2de;
		}


		.table > tbody > tr:nth-of-type(even) {
			background: #e9e9e9;
		}

		#tblData tbody td:first-child {
			text-align: center;
		}

		/* Style for the action column */
		#tblData tbody td:last-child {
			text-align: center;
		}

		/* Style for the hidden columns */
		#tblData tbody td.hidden {
			display: none;
		}

		/* Style for the edit button */
		#tblData tbody td:last-child a.btn-primary {
			color: #fff;
			background-color: #428bca;
			border-color: #357ebd;
			padding: 6px 12px;
			margin: 2px;
			font-size: 12px;
			cursor: pointer;
			text-decoration: none;
			border-radius: 3px;
		}

		/* Style for the search input */
		#searchInput {
			width: 100%;
			padding: 8px;
			box-sizing: border-box;
			margin-bottom: 10px;
			border: 1px solid #ccc;
			border-radius: 4px;
		}

		#tblData thead th {
			position: sticky;
			top: 0;
			background-color: inherit; /* Change the background color as needed */
			z-index: 1; /* Ensure the header stays above the content */
		}

		.tblScroll {
			/*height: 296px !important;
											display: block;
											overflow-y: scroll;*/
			max-height: 296px !important;
			display: block;
			overflow-y: auto;
		}

		.btn_disable {
			pointer-events: none;
			opacity: 0.9;
			background: #ccc;
			border-color: rgba(0, 0, 0, 0.4);
			color: black;
		}
	</style>
}

