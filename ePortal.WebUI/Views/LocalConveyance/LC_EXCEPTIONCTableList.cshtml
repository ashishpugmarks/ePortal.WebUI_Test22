        //     const dateString = jsonDateString;
        //     const dateNumber = dateString.match(/\d+/)[0];
        //     const date = new Date(+dateNumber);
        //     const options = {
        //         month: 'short',
        //         day: 'numeric',
        //         year: 'numeric'
        //     };
        //     const formattedDate = date.toLocaleDateString('en-IN', options);
        //     return formattedDate;
        // }

        function parseJsonDate(jsonDateString) {
            const date = new Date(jsonDateString); // Directly parse ISO 8601 string
            const options = {
                day: 'numeric',
                month: 'short',
                year: 'numeric'
            };
            return date.toLocaleDateString('en-IN', options); // e.g., "1 Sept 2022"
        }


    </script>

   
}
