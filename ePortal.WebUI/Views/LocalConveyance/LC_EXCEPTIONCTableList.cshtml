@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        /*table Css*/
        .table > thead > tr > th {
            padding: 6px 10px;
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            /*padding: 10px;*/
            padding: 5px;
            /*line-height: 1.2;*/
            line-height: 0.7;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
            border: 1px solid #8ac2de;
            align-content: center;
            font-size: 70% !important;
            /*font-size:83% !important;*/
        }

        .table-bordered {
            border: 1px solid #8ac2de;
        }

        .table > tbody > tr > td {
            /*padding: 4px 3px;*/
            /*padding: 0px 3px !important;*/
            padding: 8px 3px !important;
        }

        .table > tbody > tr:nth-of-type(even) {
            background: #e9e9e9;
        }

        .validationError {
            border: 1px solid #a94442 !important;
        }

        .validationBackground {
            background-color: #a94442 !important;
            color: white;
        }

        .highlightBackground {
            background-color: #8bb55a !important;
            color: white;
        }
        /*basic reset*/
        * {
            margin: 0;
            padding: 0;
        }

        html {
            height: 100%;
            background: white; /* fallback for old browsers */
            background: -webkit-linear-gradient(to left, #6441A5, #2a0845); /* Chrome 10-25, Safari 5.1-6 */
        }

        body {
            font-family: montserrat, arial, verdana;
            background: transparent;
        }

        /*form styles*/
        #msform {
            text-align: center;
            position: relative;
        }

            #msform fieldset {
                background: white;
                border: 0 none;
                border-radius: 0px;
                box-shadow: 0 0 15px 1px rgba(0, 0, 0, 0.4);
                padding: 8px 0px;
                box-sizing: border-box;
                width: 100%;
                position: relative;
            }

                /*Hide all except first fieldset*/
                #msform fieldset:not(:first-of-type) {
                    display: none;
                }

        /*headings*/
        .fs-title {
            font-size: 18px;
            text-transform: uppercase;
            color: #2C3E50;
            margin-bottom: 10px;
            letter-spacing: 2px;
            font-weight: bold;
        }

        .fs-subtitle {
            font-weight: normal;
            font-size: 13px;
            color: #666;
            margin-bottom: 20px;
        }

        /*progressbar*/
        #progressbar {
            margin-bottom: 20px;
            overflow: hidden;
            /*CSS counters to number the steps*/
            counter-reset: step;
        }

            #progressbar li {
                list-style-type: none;
                color: #6080dc;
                text-transform: uppercase;
                font-size: 9px;
                font-weight: 800;
                /*width: 33.33%;*/
                width: 50%;
                float: left;
                position: relative;
                letter-spacing: 1px;
            }

                #progressbar li:before {
                    content: counter(step);
                    counter-increment: step;
                    width: 40px;
                    height: 24px;
                    line-height: 26px;
                    display: block;
                    font-size: 12px;
                    color: #333;
                    background: #ccc;
                    border-radius: 25px;
                    margin: 0 auto 6px auto;
                }

                /*progressbar connectors*/
                #progressbar li:after {
                    content: '';
                    width: 100%;
                    height: 8px;
                    background: #ccc;
                    position: absolute;
                    left: -50%;
                    top: 8px;
                    z-index: -1; /*put it behind the numbers*/
                }

                #progressbar li:first-child:after {
                    /*connector not needed before the first step*/
                    content: none;
                }

                /*marking active/completed steps green*/
                /*The number of the step and the connector before it = green*/
                #progressbar li.active:before, #progressbar li.active:after {
                    background: #6080dc;
                    color: white;
                }


        /* Not relevant to this form */
        .dme_link {
            margin-top: 30px;
            text-align: center;
        }

            .dme_link a {
                background: #FFF;
                font-weight: bold;
                color: #6080dc;
                border: 0 none;
                border-radius: 25px;
                cursor: pointer;
                padding: 5px 25px;
                font-size: 12px;
            }

                .dme_link a:hover, .dme_link a:focus {
                    background: #C5C5F1;
                    text-decoration: none;
                }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            /*background-image: url('../../images/loading_double.gif');*/
            opacity: .7;
        }

        .panel-heading {
            padding: 8px 15px;
        }

        #pr_div {
            border: 1px solid #ccc;
            padding: 8px; /*15px 0px 15px 0px;*/
            margin-left: 10px;
            border-radius: 5px;
            background-color: #eee;
            overflow: auto;
            min-height: 35px;
            max-height: 92px;
            width: 73.30%;
        }

        .alert-error {
            background-color: antiquewhite;
            margin-left: 15px;
            margin-right: 15px;
        }

        .div_disable {
            pointer-events: none;
            opacity: 0.9;
            background: #eee;
            color: black;
        }

        .required::after {
            content: "*";
            font-weight: 800;
            color: red;
            margin-left: 5px;
        }

        .ui-widget {
            font-family: Verdana,Arial,sans-serif;
            font-size: 0.6em !important;
            overflow: auto;
            max-height: 150px;
        }
    </style>
}


<div class="panel-group" style="padding: 0px 8px 0px 8px;">

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px">Local Conveyance Exception Master</h2>
        </div>

        <div class="panel-body">
            <div style="margin-top:25px;">
                <div class="col-lg-3" style="margin-left: 17px;">

                    <input id="searchInput" name="searchInput" type="text" class="form-control mb-3" placeholder="Type Here for Search..." value="" autocomplete="off" />

                </div>

                <div class="col-lg-2" style="margin-left: 17px;">
                    <a title="Add" id="btnAdd" class="btn btn-success"><i class="fa fa-plus" aria-hidden="true"></i>&nbsp;Add</a>
                </div>
            </div>
        </div><br />
        <div class="panel-body">
            <div class="form-group" style="margin-bottom: 0px;">
                <form id="myform">
                    <table class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                        <thead>
                            <tr class="bg-info">
                                <th class="text-center">SrNo <i class="fa fa-sort"></i></th>
                                <th class="text-center">Emp Code <i class="fa fa-sort"></i></th>
                                <th class="text-center">Emp Name <i class="fa fa-sort"></i></th>
                                <th class="text-center">FUEL REIMBUR PER LTR <i class="fa fa-sort"></i></th>
                                <th class="text-center">REMAKRS <i class="fa fa-sort"></i></th>
                                <th class="text-center">From Date <i class="fa fa-sort"></i></th>
                                <th class="text-center">To Date <i class="fa fa-sort"></i></th>
                                <th class="text-center">Actions <i class="fa fa-sort"></i></th>
                            </tr>
                        </thead>
                        <tbody id="append_Data">
                            <tr><th colspan="7" class="text-center">No record found.</th></tr>
                        </tbody>
                    </table>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

        $(document).ready(function () {
            //Function For Searching//
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("table tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            //Function For Sorting//
            $("th").click(function () {
                var table = $(this).parents("table").eq(0)
                var rows = table.find("tr:gt(0)").toArray().sort(comparer($(this).index()))
                this.asc = !this.asc
                if (!this.asc) { rows = rows.reverse() }
                for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
            })


            //Function For Sorting//
            function comparer(index) {
                return function (a, b) {
                    var valA = getCellValue(a, index), valB = getCellValue(b, index)
                    return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
                }
            }

            //Function For Sorting//
            function getCellValue(row, index) {
                return $(row).children("td").eq(index).html()
            }


            PreLoadData();

             $('#btnAdd').on('click', function () {
                return ADD();
            });
        });


        function PreLoadData() {


            $.ajax({
                async: false,
                type: "GET",
                url: "/LocalConveyance/GetLC_EXCEPTIONCTableDataList",
                contentType: "application/json; charset=utf-8",
                datatype: "json",
                success: function (data) {
                    debugger;
                    if (JSON.parse(data).length != 0) {

                        var Data1 = JSON.parse(data);
                        $("#append_Data").empty();
                        $.each(Data1, function (i, r) {
                            debugger;
                            $("#append_Data").append('<tr><td><center>' + (i + 1) + '</center></td><td><center>' + r.EMPCODE + '</center></td><td><center>' + r.EMPNAME + '</center></td><td><center>' + r.FUEL_REIMBUR_PER_LTR + '</center></td><td><center>' + (r.REMARKS == null ? "" : r.REMARKS) + '</center></td><td><center>' + parseJsonDate(r.FROMDATE) + '</center></td><td><center>' + parseJsonDate(r.TODATE) + '</center></td><td>' + EditorFormatter(r.SRNO, r.ACTIVE) + '</td></tr>');  // {r.ACTIVE added} SR107643 :: LC ENHANCEMENT ::  AUMENTO

                        });
                        // CSP 3.0 Compliant changes
                        $('[data-ctrl-id="Edit-SRNO"]').on('click', function () {
                            Edit($(this).data('srno'));
                        });


                    // CSP 3.0 Compliant changes
                    $('[data-ctrl-id="ActiveDeactivate-SRNO"]').on('click', function () { // SR107643 :: LC ENHANCEMENT ::  AUMENTO
                        ActiveDeactivate($(this).data('srno'), $(this).data('active'));   // SR107643 :: LC ENHANCEMENT ::  AUMENTO
                    });
                    // START :: SR107643 :: LC ENHANCEMENT ::  AUMENTO
                    $('[data-ctrl-id="ViewLog"]').on('click', function () {
                        ViewLog($(this).data('srno'));
                    });
                    // START :: SR107643 :: LC ENHANCEMENT ::  AUMENTO

                    }
                    else {
                        $("#append_Data").empty();
                        $("#append_Data").append("<tr><td colspan='14' class='text-center'>No record found.</td></tr>")
                    }
                },
                complete: function () {
                },
                error: function () {
                    alert("Oops...", "Something went wrong!");
                }
            });



        }

        function ADD() {
            debugger;
            var URL = '/LocalConveyance/LC_EXCEPTIONCTableCreate';

            $.fancybox.open({

                href: URL,
                type: 'iframe',
                padding: 5,
                maxWidth: 300,
                maxHeight: 650,
                fitToView: false,
                width: '300px',
                height: '650px',
                autoSize: true,
                closeClick: true,
                openEffect: 'elastic',
                openSpeed: 120,
                closeEffect: 'elastic',
                closeSpeed: 100,
                helpers:
                {
                    overlay: { closeClick: false }
                },
                afterClose: function () {

                    window.location.reload();
                }

            });


        }


        // function EditorFormatter(SRNO) {
        //     return '<center><a title="Edit" data-ctrl-id="Edit-SRNO" data-srno="' + SRNO + '" class="btn btn-primary btn-xs"><i class="ace-icon fa fa-edit"></i></a> <a title="Delete" data-ctrl-id="Delete-SRNO" data-srno="' + SRNO + '" class="btn btn-danger btn-xs"><i class="ace-icon fa fa-trash"></i></a></center>';
        // }

                // START :: SR107643 :: LC ENHANCEMENT ::  AUMENTO
            function EditorFormatter(SRNO, ACTIVE) {
                /*return '<center><a title="Edit" data-ctrl-id="Edit-SRNO" data-srno="' + SRNO + '" class="btn btn-primary btn-xs"><i class="ace-icon fa fa-edit"></i></a> <a title="Delete" data-ctrl-id="Delete-SRNO" data-srno="' + SRNO + '" class="btn btn-danger btn-xs"><i class="ace-icon fa fa-trash"></i></a></center>';*/

                return '<center><a title="Edit" data-ctrl-id="Edit-SRNO" data-srno="' + SRNO + '" class="btn btn-primary btn-xs"><i class="ace-icon fa fa-edit"></i></a>&nbsp;' +
                (ACTIVE == 1
                    ? '<a title="Deactivate" data-ctrl-id="ActiveDeactivate-SRNO" data-srno="' + SRNO + '" data-active="' + ACTIVE + '" class="btn btn-danger btn-xs"><i class="ace-icon fa fa-ban"></i></a>&nbsp;'
                    : '<a title="Activate"   data-ctrl-id="ActiveDeactivate-SRNO" data-srno="' + SRNO + '" data-active="' + ACTIVE + '" class="btn btn-success btn-xs"><i class="ace-icon fa fa-check"></i></a>&nbsp;') +
                      '<a title="Log"        data-ctrl-id="ViewLog" data-srno="' + SRNO + '" class="btn btn-info btn-xs"><i class="ace-icon fa fa-history"></i></a></center>';
            }
        // END :: SR107643 :: LC ENHANCEMENT ::  AUMENTO

        function Edit(SrNo) {
            debugger;
            var URL = '/LocalConveyance/LC_EXCEPTIONCTableEdit/?id=' + SrNo;

            $.fancybox.open({

                href: URL,
                type: 'iframe',
                padding: 2,
                maxWidth: 300,
                maxHeight: 650,
                fitToView: false,
                width: '300px',
                height: '650px',
                autoSize: true,
                closeClick: true,
                openEffect: 'elastic',
                openSpeed: 120,
                closeEffect: 'elastic',
                closeSpeed: 100,
                helpers:
                {
                    overlay: { closeClick: false }
                },
                afterClose: function () {

                    window.location.reload();
                }



            });


        }


                 // START :: SR107643 :: LC ENHANCEMENT ::  AUMENTO
            function ActiveDeactivate(SrNo, ACTIVE) {
                var URL = '/LocalConveyance/LC_EXCEPTIONCTableDelete/?id=' + SrNo;
                var isConfirm = confirm("Are you sure you want to " + (ACTIVE == 1 ? "DeActive" : "Active") + " this record?");

                if (isConfirm) {
                    $.ajax({
                        type: "POST",
                        url: URL,
                        datatype: "json",
                        contentType: false,
                        processData: false,
                        success: function (data) {
                            if (data == true) {
                                alert("Record " + (ACTIVE == 1 ? "DeActive" : "Active") + " Sucessfully.");
                            }
                            window.location.reload();
                        },
                        error: function () {
                            $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                            $("#btnUpload").attr("disabled", false);
                        }
                    });
                }
            }

            function ViewLog(SRNO) {
                var URL = '/LocalConveyance/ViewLog/?SrNO=' + SRNO + '&TableName=LC_EXCEPTION_C_TABLE';
                $.fancybox.open({
                    href: URL,
                    type: 'iframe',
                    padding: 1,
                    maxWidth: 1500,
                    maxHeight: 600,
                    fitToView: false,
                    width: '1500',
                    height: '600',
                    //autoSize: true,
                    closeClick: true,
                    openEffect: 'elastic',
                    openSpeed: 120,
                    closeEffect: 'elastic',
                    closeSpeed: 100,
                    helpers: {
                        overlay: { closeClick: false }
                    },
                    afterClose: function () {
                        window.location.reload();
                    }
                });
            }


