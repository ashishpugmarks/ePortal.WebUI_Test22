        function calculateFuel() {
            var totalFuelReimburs = 0;


            $("#tblData tbody tr").each(function () {

                var fuelValue = parseFloat($(this).find("td:eq(14)").text());
                totalFuelReimburs += isNaN(fuelValue) ? 0 : fuelValue;
            });


            $("#txtApprovedFuel").val(totalFuelReimburs.toFixed(2));
        }



        $('#txtApprovedFuel').on('blur', function() {
            debugger;
            var totalFuel= Number($('#txtTotalFuel').val(), 10);
            var requiredFuel = Number($(this).val(), 10);

            if (isNaN(requiredFuel)) {
                alert("Please enter a valid input for Approved Fuel.");
                $(this).val("");
                return;
            }

            if (requiredFuel > totalFuel) {
                alert("You cannot enter more than Total fuel.");
                $(this).val(totalFuel);
            }
        });


    </script>


