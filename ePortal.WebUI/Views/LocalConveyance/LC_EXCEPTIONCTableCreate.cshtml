@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout_Plain.cshtml";
}

@section Styles{
    <link href="~/css/jquery-ui.css" rel="stylesheet" />   

    <style type="text/css" nonce="@Context.Items["StyleNonce_0"]">
        .homeContent {
            padding: 0.52em 0.3em 0.78em !important;
        }

        label {
            font-weight: normal !important;
            font-size: 17px !important;
        }
    </style>
}

<div class="panel panel-primary top-margin-10" style="height:450px;">
    <div class="panel-heading">
        <h2 class="panel-title" style="line-height:2.2;font-size:16px;padding-left:10px;">Add Record</h2>
    </div>
    <div class="panel-body">
        <span id="span-attachmentMsg"></span>
        <div style="margin-top:25px;">


            <div class="col-lg-2" style="margin:10px;">
                <label style="padding-bottom:5px">Emp Code</label>
                <input type="text" class="form-control" id="txtEmpCode" placeholder="Enter Emp Code" autocomplete="off" />
                <input type="hidden" id="selectedECode1" name="selectedECode1">

            </div>

            <div class="col-lg-2" style="margin:10px;">
                <label style="padding-bottom:5px">FUEL REIMBUR PER LTR</label>
                <input type="number" class="form-control" id="txtFuelReimbursementPerLtr" placeholder="Enter FUEL REIMBUR PER LTR" autocomplete="off" pattern="\d*" />
            </div>

            <div class="col-lg-2" style="margin:10px;">
                <label style="padding-bottom:5px">REMARKS</label>
                <textarea class="form-control" id="txtREMARKS" placeholder="Enter REMARKS" autocomplete="off"></textarea>
            </div>
            <div class="col-lg-2" style="margin:10px;">
                <label style="padding-bottom:5px">From Date</label>
                <input type="date" class="form-control" id="txtFromDate" autocomplete="off" />
            </div>
            <div class="col-lg-2" style="margin:10px;">
                <label style="padding-bottom:5px">To Date</label>
                <input type="date" class="form-control" id="txtToDate" autocomplete="off" />
            </div>

            <div class="col-lg-2" style="margin:10px;">
                <button type="submit" id="btnsubmit" class="btn btn-block btn-success"><i class="menu-icon fa fa-save"></i> &nbsp; Save</button>
            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/jquery-ui.js"></script>

    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_2"]">

        $(document).ready(function () {



            const searchTermInput1 = $("#txtEmpCode");
            const selectedECodeInput1 = $("#selectedECode1");

            AutoSuggest(searchTermInput1, selectedECodeInput1);

        });

        function Save() {

            var EmpCode = $('#txtEmpCode').val();
            var FuelReimbursementPerLtr = $('#txtFuelReimbursementPerLtr').val();
            var FromDate = $('#txtFromDate').val();
            var ToDate = $('#txtToDate').val();
            var REMARKS = $('#txtREMARKS').val();

            //if (State == "") {

            //     return alert("Please Select State ...");
            // }



            if (EmpCode == "") {

                return alert("Please Enter Emp. Code.");
            }


            if (FuelReimbursementPerLtr == "") {

                return alert("Please Enter Fuel Reimbursement Per Ltr");
            }

            if (FromDate == "") {

                return alert("Please Select From Date ...");
            }
            if (ToDate == "") {

                return alert("Please Select To Date ...");
            }

            var URL = '/LocalConveyance/LC_EXCEPTIONCTableCreate/?EmpCode=' + EmpCode + '&FuelReimbursementPerLtr=' + FuelReimbursementPerLtr + '&FromDate=' + FromDate + '&ToDate=' + ToDate + '&Remarks= ' + REMARKS;

            $.ajax({
                type: "POST",
                url: URL,
                datatype: "json",
                contentType: false,
                processData: false,
                success: function (data) {
                    debugger;

                    alert(JSON.parse(data).errorMessage);
                    parent.jQuery.fancybox.close();


                },
                error: function () {
                    $("#span-attachmentMsg").text('Oops... Something went wrong!. ').css('color', '#a94442').show().delay(5000).fadeOut();
                    $("#btnUpload").attr("disabled", false);
                }
            });


        }

        function AutoSuggest(ID, Value) {
            debugger;



            ID.autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/LocalConveyance/AutocompleteSuggestions",
                        data: { term: request.term },
                        dataType: "json",
                        method: "GET",
                        success: function (data) {
                            if (data.resultObject && data.resultObject.length > 0) {

                                const suggestions = data.resultObject.map(function (suggestion) {
                                    return {
                                        label: suggestion.ecode + " - " + suggestion.name,
                                        value: suggestion.ecode,
                                    };
                                });
                                response(suggestions);
                            } else {
                                response([]);
                            }
                        },
                        error: function (error) {
                            console.error("Error fetching autocomplete suggestions:", error);
                            response([]);
                        },
                    });
                },
                select: function (event, ui) {
                    Value.val(ui.item.value);
                },
            });
        }

    </script>

    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $(document).ready(function () {
            $('#btnsubmit').on('click', function () {
                Save();
            });
        });
    </script>
}
