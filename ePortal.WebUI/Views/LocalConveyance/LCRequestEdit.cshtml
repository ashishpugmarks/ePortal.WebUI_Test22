                            <input type="hidden" id="hfDATEOFEXPENDITURE" name="DATEOFEXPENDITURE" value="" />
                            <input type="hidden" id="hfPURPOSE" name="PURPOSE" value="" />
                            <input type="hidden" id="hfFROMCITY" name="FROMCITY" value="" />
                            <input type="hidden" id="hfTOCITY" name="TOCITY" value="" />
                            <input type="hidden" id="hfFROMCITYID" name="FROMCITYID" value="" />
                            <input type="hidden" id="hfTOCITYID" name="TOCITYID" value="" />
                            <input type="hidden" id="hfTIMEIN" name="TIMEIN" value="" />
                            <input type="hidden" id="hfTIMEOUT" name="TIMEOUT" value="" />
