                                    </div>
                                    <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                                        <label>Amount:</label>
                                        @*<input type="text" class="form-control" id="txtTollTaxMisAmt" autocomplete="off" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />*@
                                        <input type="text" class="form-control" id="txtTollTaxMisAmt" autocomplete="off" />
                                    </div>
                                    <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                                        <label>DocType:</label>
                                        <select id="ddlDocType" class="form-control"></select>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3" style="padding-left: 24px;">
                                        <label>Attached Doc</label>
                                        <input type="file" class="form-control" id="Attfile" autocomplete="off" />
                                    </div>
                                    <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                                        <button type="submit" id="btnaddtolltax" style=" margin-top: 17PX; width: 47px;" class="btn btn-block btn-warning">Add</button>
                                    </div>
                                </div>
                            </div>
                            <div style="padding-left:inherit">
                                <table id="tbltolltaxDt" class="table table-bordered table-responsive" style="margin-bottom: 0px!important;">
                                    <thead>
                                        <tr class="bg-info">
                                            <th class="text-center">ReceiptNo</th>
                                            <th class="text-center">Date</th>
                                            <th class="text-center">Service Provider Name</th>
                                            <th class="text-center">Amount</th>
                                            <th class="text-center">DocType</th>
                                            <th class="text-center">Attachement</th>
                                            <th class="text-center">Delete</th>
                                            <th class="text-center hidden">RowID</th>
                                        </tr>
                                    </thead>
                                    <tbody id="append_tolltaxDtRow">
                                        <tr><th colspan="7" class="text-center">No record found</th></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="row">
                    <center>
                        @using (Html.BeginForm("LCRequestEdit", "LocalConveyance", FormMethod.Post, new { id = "_form" }))
                        {
                            <input type="hidden" id="hfSRNO" name="SRNO" value="0" />
                            <input type="hidden" id="hfEMPCODE" name="EMPCODE" value="" />
