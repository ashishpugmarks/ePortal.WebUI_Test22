                            <input type="hidden" id="hfTRAVELREIMBURSEMENT" name="TRAVELREIMBURSEMENT" value="" />
                            <input type="hidden" id="hfTOLLTAXMISCAMOUNT" name="TOLLTAXMISCAMOUNT" value="0" />

                            <input type="hidden" id="hfTOTAL" name="TOTAL" value="0" />
                            <input type="hidden" id="hfDT" name="DT" value="" />
                            <input type="hidden" id="hfFROMCITY_OTHER" name="FROMCITY_OTHER" value="" />
                            <input type="hidden" id="hfTOCITY_OTHER" name="TOCITY_OTHER" value="" />
                            <input type="hidden" id="hfMODEOFTRAVEL_OTHER" name="MODEOFTRAVEL_OTHER" value="" />

                            <input type="hidden" id="hfMEAL_REFRE_ALLW_CLAIM" name="MEAL_REFRE_ALLW_CLAIM" value="" />
                            <input type="hidden" id="hfREFRESHMENTMEALALLOWANCE" name="REFRESHMENTMEALALLOWANCE" value="" />
                            <input type="hidden" id="hfFUEL_ALLW_CLAIM" name="FUEL_ALLW_CLAIM" value="" />
                            <input type="hidden" id="hfFUEL_REIMBURSMENT" name="FUEL_REIMBURSMENT" value="" />

                            <input type="hidden" id="hfDINNER_ALLW_CLAIM" name="DINNER_ALLW_CLAIM" value="" />
                            <input type="hidden" id="hfDINNER_ALLW_AMOUNT" name="DINNER_ALLW_AMOUNT" value="" />
                            <input type="hidden" id="hfLUNCH_ALLW_CLAIM" name="LUNCH_ALLW_CLAIM" value="" />
                            <input type="hidden" id="hfLUNCH_ALLW_AMOUNT" name="LUNCH_ALLW_AMOUNT" value="" />
                            <input type="hidden" id="hfTOURSTARTFROMHOMEKM" name="TOURSTARTFROMHOMEKM" value="" />
                            <input class="hidden" type="submit" value="Submit" id="btnhfEditReq">
                        }

                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 " id="divbtn">
                            <button class="btn btn-block btn-warning" id="btnSaveDetailWithJsonString">SaveDetail WithJsonString</button>
                            <button class="btn btn-block btn-warning" id="btnSingleParmValue">Single Parm Value</button>
