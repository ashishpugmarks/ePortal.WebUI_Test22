@section Scripts{
    <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        var Rowid;
        var fileName = "";
        var LoadData;
        var StatusId;
        var FuelReimbursPerLeter;

        var LunchStartTime;
        var LunchEndTime;
        var DinnerStartTime;
        var DinnerEndTime;
        var MealAmount_;
        var FuelReimbur;
        var RefreshAmount;



        $(document).ready(function () {
            Rowid = '@ViewBag.id';
            StatusId = '@ViewBag.StatusId';

            LunchStartTime  = '@ViewBag.LunchStartTime';
            LunchEndTime  = '@ViewBag.LunchEndTime';
            DinnerStartTime  = '@ViewBag.DinnerStartTime';
            DinnerEndTime  = '@ViewBag.DinnerEndTime';

            LoadData = JSON.parse(localStorage.getItem("LocalConveyanceDATABEFORE"));

            var currentDate = new Date().toISOString().split('T')[0];

            $('#txtdate').attr('max', currentDate);
            $('#txtdate').change(function() {
                var selectedDate = $(this).val();
                if (selectedDate > currentDate) {
                    alert('Please select a date equal to or before today.');
                    $(this).val(currentDate);
                }
            });

            /// attachement validation for PDF and size is less than or equal to 5 MB
            $('#Attfile').change(function() {
                var fileInput = this;
                var file = fileInput.files[0];
                var fileSize = file.size / (1024 * 1024);

                if (file.type !== 'application/pdf') {
                    alert('Please select a PDF file only.');
                    $(fileInput).val('');
                    return; // Exit the function here
                }

                if (fileSize > 5) {
                    alert('Please select a file less than or equal to 5 MB.');
                    $(fileInput).val('');
                    return; // Exit the function here
                }
            });


            if (StatusId == 0 || StatusId == 3)
            {
                $("#btnaddtolltax").removeClass('hidden');
                $("#divbtn").removeClass('hidden');
                $("#btnaddbillsum").removeClass('hidden');

            }
            else
            {
                $("#btnaddtolltax").addClass('hidden');
                $("#divbtn").addClass('hidden');
                $("#btnaddbillsum").addClass('hidden');
                disableControls();
            }

            if (LoadData.length != 0)
            {
                if(LoadData[Rowid]["DT"] != null && LoadData[Rowid]["DT"] != "" && LoadData[Rowid]["DT"] !=  "[{}]" && LoadData[Rowid]["DT"] !=  "[]")
                {
                    var TableData =  JSON.parse(LoadData[Rowid]["DT"]);
                    $("#append_tolltaxDtRow").empty();
                    $.each(TableData, function (i, r) {
                        var downloadIcon = '';
                        if ( r["Attachement"] != "" &&  r["Attachement"] != "No files selected.") {
                            downloadIcon = '<a href="#" data-ctrl-id="Download-Attachment" data-attachment="' + r["Attachement"] + '"><label style="display:none">' + r["Attachement"] + '</label><i class="fa fa-download"></i></a>';
                        }

                        if (StatusId == 0 || StatusId == 3)
                        {
                            $("#tbltolltaxDt").find("th:contains('Delete')").show();
                            $("#append_tolltaxDtRow").append('<tr><td><center>' + ( r["ReceiptNo"]  == null ? "" : r["ReceiptNo"])  + ' </center></td><td><center>' + (r["Date"] == null ? "" : r["Date"]) + '</center></td><td><center>' + (r["Service Provider Name"] == null ? "" : r["Service Provider Name"]) + '</center></td><td><center>' + r["Amount"] + '</center></td><td><center> ' + r["DocType"]  +'</center></td><td><center>' + downloadIcon + '</center></td><td><center><a href="#" class="delete-button"><i class="fa fa-trash-o"></i></a></center></td><td class="hidden">' + Rowid + '</td></tr>');
                        }
                        else
                        {
                            $("#tbltolltaxDt").find("th:contains('Delete')").hide();
                            $("#append_tolltaxDtRow").append('<tr><td><center>' + ( r["ReceiptNo"]  == null ? "" : r["ReceiptNo"])  + ' </center></td><td><center>' + (r["Date"] == null ? "" : r["Date"]) + '</center></td><td><center>' + (r["Service Provider Name"] == null ? "" : r["Service Provider Name"]) + '</center></td><td><center>' + r["Amount"] + '</center></td><td><center> ' + r["DocType"]  +'</center></td><td><center>' + downloadIcon + '</center></td><td class="hidden">' + Rowid + '</td></tr>');

                        }
                        //  $("#append_tolltaxDtRow").append('<tr><td><center>' + r["Amount"] + '</center></td><td><center>' + r["Remarks"] + '</center></td><td><center><a href="#" onClick="return Download(\''+ r["Attachement"] +'\')"><label style="display:none">'+r["Attachement"]+'</label><i class="fa fa-download"></i></a></center></td><td><center><a href="#" class="delete-button"><i class="fa fa-trash-o"></i></a></center></td><td class="hidden">'+r["RowID"]+'</td></tr>');
                    });

                    // CSP 3.0 Compliant Changes
                    $('[data-ctrl-id="Download-Attachment"]').on("click", function () {
                        const attachment = $(this).data("attachment");
                        return Download(attachment);
                    });

                }

                $("#lblDateOfExpenditure").text(LoadData[Rowid]["Date Of Expenditure"]);
                $("#txtTimeIn").val(LoadData[Rowid]["Time In"]);
                $("#txtTimeOut").val(LoadData[Rowid]["Time Out"]);
                $("#txtKMCovered").val(LoadData[Rowid]["Km Covered"]);
                $("#txtTourstartFromHomeKM").val(LoadData[Rowid]["TOURSTARTFROMHOMEKM"]);
                $("#txtPurpose").val(LoadData[Rowid]["Purpose"]); // Added by Aumento as on 26-06-2024

                if(LoadData[Rowid]["ModeOfTravel"] == ""){
                    $("#ddlModeofTravel").val($("#ddlModeofTravel option:first").val());
                }
                else {
                    $("#ddlModeofTravel").val(LoadData[Rowid]["ModeOfTravel"]);
                }

                var selectedValue_ = $("#ddlModeofTravel").val();
                $("#ddlDocType").empty();

                if (selectedValue_ == 'Taxi') {
                    // Add options for Taxi
                    $("#ddlDocType").append('<option value="Taxi Bill">Taxi Bill</option>');
                    $("#ddlDocType").append('<option value="Toll Tax Bill">Toll Tax Bill</option>');
                }
                else if (selectedValue_ == 'Bus/Train') {
                    // Add options for Bus
                    $("#ddlDocType").append('<option value="Bus/Train Ticket">Bus/Train Ticket</option>');
                }
                else if (selectedValue_ == 'Auto' ) {
                    // Add options for Auto, Self Car, or Self Bike/Scooter
                    $("#ddlDocType").append('<option value="Auto Fare">Auto Fare</option>');
                    $("#ddlDocType").append('<option value="Toll Tax Bill">Toll Tax Bill</option>');
                }
                else if (selectedValue_ == "Self Car" || selectedValue_ == "Self Bike/Scooter") {
                    // Add options for Auto, Self Car, or Self Bike/Scooter
                    $("#ddlDocType").append('<option value="Toll Tax Bill">Toll Tax Bill</option>');

                }
                else {
                    // Add options for Other
                    $("#ddlDocType").append('<option value="-">-</option>');
                    $("#ddlDocType").append('<option value="Taxi Bill">Taxi Bill</option>');
                    $("#ddlDocType").append('<option value="Toll Tax Bill">Toll Tax Bill</option>');
                    $("#ddlDocType").append('<option value="Bus/Train Ticket">Bus/Train Ticket</option>');
                    $("#ddlDocType").append('<option value="Auto Fare">Auto Fare</option>');

                }

                $("#ddlFromCity").val(LoadData[Rowid]["FromCityId"]);
                $("#ddlToCity").val(LoadData[Rowid]["ToCityId"]);

                $("#txtFromCityOther").val(LoadData[Rowid]["FromCityOther"]);
                $("#txtToCityOther").val(LoadData[Rowid]["ToCityOther"]);
                $("#txtModeOfTravelOther").val(LoadData[Rowid]["ModeOfTravelOther"]);

                if (LoadData[Rowid]["FromCityId"] == '0') {
                    $("#divFromCityOther").removeClass('hidden');
                } else {
                    $("#divFromCityOther").addClass('hidden');
                }

                if (LoadData[Rowid]["ToCityId"] == '0') {
                    $("#divToCityOther").removeClass('hidden');
                } else {
                    $("#divToCityOther").addClass('hidden');
                }

                if ( LoadData[Rowid]["ModeOfTravel"] == 'Other') {
                    $("#divModeOfTravelOther").removeClass('hidden');
                } else {
                    $("#divModeOfTravelOther").addClass('hidden');
                }

                if (LoadData[Rowid]["MealRefreAllowClaim"] != "NO")
                {
                    $("#ChkMealRefreAllow").prop('checked', true);
                    $("#txtRefre_MealAllow").val(LoadData[Rowid]["RefreshmentAmount"]);
                }
                else
                {
                    $("#ChkMealRefreAllow").prop('checked', false);
                    $("#txtRefre_MealAllow").val(0);
                }

                if (LoadData[Rowid]["FuelAllowClaim"] != "NO")
                {
                    $("#ChkFuelAllow").prop('checked', true);
                    $("#txtFuelReimbursement").val(LoadData[Rowid]["Fuel Reimburse."]);
                }
                else
                {
                    $("#ChkFuelAllow").prop('checked', false);
                    $("#txtFuelReimbursement").val(0);
                }

                if (LoadData[Rowid]["DinnerAllowClaim"] != "NO")
                {
                    $("#ChkDinnerAllowClaim").prop('checked', true);
                    $("#txtDinnerAllowAmount").val(LoadData[Rowid]["DinnerAllowAmount"]);
                }
                else
                {
                    $("#ChkDinnerAllowClaim").prop('checked', false);
                    $("#txtDinnerAllowAmount").val(0);
                }

                if (LoadData[Rowid]["LunchAllowClaim"] != "NO")
                {
                    $("#ChkLunchAllowClaim").prop('checked', true);
                    $("#txtLunchAllowAmount").val(LoadData[Rowid]["LunchAllowAmount"]);
                }
                else
                {
                    $("#ChkLunchAllowClaim").prop('checked', false);
                    $("#txtLunchAllowAmount").val(0);
                }

                Getallowcheck();

                //  FuelReimbursPerLeter = Math.floor(Number(LoadData[Rowid]["Km Covered"]) / Number(LoadData[Rowid]["Fuel Reimburse."]));

            }


            $('#txtKMCovered').on('blur', function() {

                var kmCoveredValue = parseFloat($(this).val());


                if (kmCoveredValue <= 250) {

                    Getallowcheck();
                } else {

                    alert("You cannot enter more than 250 KM for Local Conveyance OD");

                    $(this).val(0);
                }
            });

            $('#txtTourstartFromHomeKM').on('blur', function() {

                var kmCoveredValue = parseFloat($(this).val());


                if (kmCoveredValue <= 250) {

                    Getallowcheck();
                } else {

                    alert("You cannot enter more than 250 KM for Local Conveyance OD");

                    $(this).val(0);
                }
            });

            $("#ChkMealRefreAllow").change(function(){
                Getallowcheck();
            });

            $("#ChkFuelAllow").change(function(){
                Getallowcheck();

            });

            $("#ChkDinnerAllowClaim").change(function(){
                Getallowcheck();

            });

            $("#ChkLunchAllowClaim").change(function(){
                Getallowcheck();

            });


            $("#ddlFromCity").change(function () {
                var selectedValue = $(this).val();
                if (selectedValue == '0') {
                    $("#divFromCityOther").removeClass('hidden');
                } else {
                    $("#divFromCityOther").addClass('hidden');
                }
            });

            $("#ddlToCity").change(function () {
