                        @Html.DropDownList("ddlToCity", new SelectList(ViewBag.City, "SYCITYID", "DESCRIP"), new { @class = "form-control" })
                    </div>

                    <!-- To City (Other) -->
                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3 hidden" id="divToCityOther">
                        <label>To City (Other):</label>
                        <input type="text" class="form-control" id="txtToCityOther" autocomplete="off" />
                    </div>

                    <!-- Time In -->
