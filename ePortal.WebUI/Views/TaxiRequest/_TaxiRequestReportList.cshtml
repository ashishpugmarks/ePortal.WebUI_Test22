 @model ePortal.ViewModels.TaxiRequestViewModel
@using Microsoft.AspNetCore.Http
@{
    Layout = null;
}
<html>
<head>
    <style nonce="@Context.Items["StyleNonce_1"]">
        div.dataTables_wrapper div.dataTables_paginate{
            font-size: 13px !important
        }
    </style>
    <script nonce="@Context.Items["ScriptNonce_5"]">
         $(document).ready(function () {
                   

                
            $("#tblTaxiList").dataTable({
            "bFilter": false,
            "bLengthChange": false,
            "info": false
        });});
    </script>
</head>
<body>
<div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;" class="table-responsive">
    <table class="table table-bordered table-striped table-hover " id="tblTaxiList">
        <thead>
            <tr>

                <th class="text-left control-label bg-info">
                    @Html.DisplayName("Emp Code")
                </th>
                <th class="text-center control-label  bg-info">
                    @Html.DisplayName("Emp Name")
                </th>
                <th class="text-center control-label  bg-info">
                    @Html.DisplayName("Travel Date")
                </th>
                <th class="text-left control-label  bg-info">
                    @Html.DisplayName("Vehicle No")
                </th>
                <th class="text-left control-label  bg-info">
                    @Html.DisplayName("Vendor Name")
                </th>
                <th class="text-left control-label  bg-info">
                    @Html.DisplayName("KM-used")
                </th>
                <th class="text-left control-label  bg-info">
                    @Html.DisplayName("Released At")
                </th>

            </tr>
        </thead>
        <tbody>

            @if (Model != null)
            {
                foreach (var item in Model.TaxiUsesReportList)
                {
                    <tr>

                        <td class="control-label">
                            @(double.TryParse(item.EMPCODE, out var val) ? (int)val : 0)
                        </td>
                        <td class="control-label">
                            @Html.DisplayFor(modelItem => item.EMPNAME)
                        </td>
                        <td class="control-label">
                            @Html.DisplayFor(modelItem => item.TAXIREQUIREDATE)
                        </td>
                        <td class="control-label">
                            @Html.DisplayFor(modelItem => item.VEHICLENO)
                        </td>
                        <td class="control-label">
                            @Html.DisplayFor(modelItem => item.DESCRIP)
                        </td>
                        <td class="control-label">
                            
                                @(double.TryParse(item.USEKM, out var km) ? (int)km : "")
                        </td>
                        <td class="control-label">
                            @Html.DisplayFor(modelItem => item.RELEASEAT)
                        </td>


                    </tr>
                }
            }

        </tbody>

    </table>
</div>
</body></html>
