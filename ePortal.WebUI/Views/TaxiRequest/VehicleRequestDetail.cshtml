@model ePortal.ViewModels.VehicleRequestModel
@using Microsoft.AspNetCore.Http
@{
    ViewBag.Title = "Employee Portal  :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loginUser = Context.Session.GetString("userId") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userId").ToString());
}
@section Styles{
    <style>
        .table td{
            font-size:13px;
            font-weight:normal !important;
        }

        legend{
            font-size:16px;
        }
    </style>
}
    <form id="form1">
        <table cellspacing="0" cellpadding="0" width="100%" border="0" id="maintable">
            <tbody>
                <tr>
                    <td>
                        <fieldset>
                            <legend><b>Vehicle Request Information</b></legend>
                            <table width="100%" class="table">
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                        <span class="text-info">Request ID:</span></td>
                                    <td width="70%">
                                    <label class="control-label">@Model.RequestId</label>
                                    
                                </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                        <span class="text-info">Employee :</span></td>
                                <td>
                                    <label class="control-label">@Model.Employee</label>
                                </td>
                                </tr>

                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                        <span class="text-info">Department:</span></td>
                                <td>    <label class="control-label">@Model.Department</label></td>
                                </tr>

                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                         <span class="text-info">Reporting Site:</span></td>
                                <td><label class="control-label">@Model.ReportingSite</label></td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                        <span class="text-info">Reporting Place:</span> </td>
                                <td><label class="control-label">@Model.ReportingPlace</label></td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                        <span class="text-info">No. Of Persons:</span></td>
                                <td><label class="control-label">@Model.NumberOfPersons</label></td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                        <span class="text-info">Application Date:</span></td>
                                <td><label class="control-label">@Model.ApplicationDate</label></td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                        <span class="text-info">Date Of Travel:</span></td>
                                <td>
                                    <span class="text-info">From:</span><label class="control-label">@Model.FromDate</label>&nbsp;
                                    <span class="text-info">To:</span><label class="control-label">@Model.ToDate</label>&nbsp;
                                    <span class="text-info">Time:</span><label class="control-label">@Model.Time</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                        <span class="text-info">Purpose of Visit:</span></td>
                                <td>
                                    <label class="control-label">@Model.PurposeOfVisit</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                        <span class="text-info">Place of Visit:</span></td>
                                <td>
                                    <label class="control-label">@Model.PlaceOfVisit</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                        <span class="text-info">Remark:</span></td>
                                <td>
                                    <label class="control-label">@Model.Remark</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" style="width: 224px; text-align: right;">
                                        <span class="text-info">Status:</span></td>
                                <td>
                                    <label class="control-label">@Model.ActiveStatus</label>
                                    </td>
                                </tr>
                            </table>
                        </fieldset>
                        <fieldset>
                            <legend><b>Department Approval History</b></legend>
                            <table width="100%" class="table">
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">
                                        <span class="control-label">@Model.RecAuth</span>
                                        </span></td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.SupervisorName</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">
                                        <span class="control-label">@Model.RecEmail</span>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.SupervisorEmail</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">
                                        <span class="control-label">@Model.RecStatus</span>
                                    </span>
                                </td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.SupervisorStatus</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">
                                        <span class="control-label">@Model.RecRem</span>
                                    </span>
                                </td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.SupervisorRemarks</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">
                                        <span class="control-label">@Model.RecDate</span>
                                    </span>
                                </td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.SupervisorApprovedDate</label>
                                    </td>
                                </tr>
                            @if (Model.IsEnabled)
                            {
                                <tr id="tr_AppAuth">
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">Approval Authority:</span></td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.SupSupervisorName</label>
                                    </td>
                                </tr>
                                <tr id="tr_AppEmail">
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">Approval Authority Email:</span></td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.SupSupervisorEmail</label>
                                    </td>
                                </tr>
                                <tr id="tr_AppStatus">
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">Status:</span></td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.SupSupervisorStatus</label>
                                    </td>
                                </tr>
                                <tr id="tr_AppRem">
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">Remarks:</span></td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.SupSupervisorRemarks</label>
                                    </td>
                                </tr>
                                <tr id="tr_AppDate">
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">Approval Date:</span></td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.SupSupervisorDate</label>
                                    </td>
                                </tr>}
                            </table>
                        </fieldset>
                        <fieldset>
                            <legend><b>Administration Approval History</b></legend>
                            <table width="100%" class="table">
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">Admin Authority:</span></td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.AdminName</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">Status:</span></td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.AdminStatus</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">Taxi No.:</span></td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.TaxiNumber</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">Transpotar Name:</span></td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.VendorName</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">Remarks:</span></td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.AdminRemarks</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="left" valign="middle" class="active" width="30%" style="text-align: right">
                                        <span class="text-info">Approval Date:</span></td>
                                <td width="70%" valign="middle">
                                    <label class="control-label">@Model.AdminApprovalDate</label>
                                    </td>
                                </tr>
                            </table>
                        </fieldset>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

