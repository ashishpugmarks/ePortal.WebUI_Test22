@model ePortal.ViewModels.TaxiRequestViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewBag.Title = "Employee Portal  :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loginUser = Context.Session.GetString("userId") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userId").ToString());
 
}
    @section Styles{
    <link rel="stylesheet" href="../../css/index.css" />
    <style nonce="@Context.Items["StyleNonce_0"]">
        .homeContent{
            padding: 0 !important;
        }

        #tblTaxiList td {
        font-size:12px !important;
    }

        #tblTaxiList th {
            font-size: 16px !important;
        }

        
    </style>
    }
   
<form id="frmStatus">
    <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <span style="padding-left: 10px;">Taxi Usage Report</span>
    </div>
    <div id="div_message" style="margin-left: 5px; margin-right: 5px; margin-top: 5px; margin-bottom: 5px; vertical-align: middle;"></div>
    <div class="panel-group" style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
        <div class="panel panel-primary">
            <div class="panel-heading" style="padding:10px">
                <h2 class="panel-title">Selection Criteria</h2>
            </div>
            <table class="table table-bordered table-condensed" style="width:100%;font-size:13px">
                <tr>
                    <td class="control-label" style="text-align: right; width: 15%;vertical-align:middle">From Date</td>
                    <td>
                        @Html.TextBoxFor(model => model.DATEOFTRAVELFROM, "{0:dd-MMM-yyyy}", new { @class = "form-control dpDate",@id="txtFrom" , @readonly = "readonly" })

                    </td>
                    <td class="control-label" style="text-align: right; width: 15%;vertical-align:middle">To Date</td>
                    <td>
                        @Html.TextBoxFor(model => model.DATEOFTRAVELFROM, "{0:dd-MMM-yyyy}", new { @class = "form-control dpDate", @id = "txtTo", @readonly = "readonly" })

                    </td>
                </tr>
                <tr>
                    <td colspan="4" style="text-align: center;">
                        <a data-ctrl-id="btn-submit" class="btn btn-default" >
                            Search
                        </a>                   </td>
                </tr>
            </table>
        </div>
    </div>
    <div id="div_append"></div>
    
    <div style="margin-left: 0.8em; margin-right: 0.8em; padding:10px;" class="well well-sm">
        <table border="0" style="width: 100%">
            <tr>
                <td style="height: 20px; width:90%;">
                    <table style="width: 100%;">
                        <tbody>
                            <tr>
                                <td style="width: 20px; vertical-align: middle; text-align: center;">
                                    <a title="Back" href="../../Home/Home">
                                        <img src="../../images/icon_back.gif" border="0" alt="" />
                                    </a>
                                </td>
                                <td style="vertical-align: middle; font-size: 15px;">
                                    <span><a title="Back" href="../../Home/Home">Back</a></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
                <td>
                    <a data-ctrl-id="btn-print" class="btn btn-default active">
                        Print
                    </a>
                    @* <asp:Button ID="btnPrint" CssClass="btn btn-default active" runat="server" OnClick="btnPrint_Click" Text="Print" />  *@
                </td>
            </tr>
        </table>
    </div>

</form>
@section Scripts{

    <script src="../../js/alertmessage.js"></script>
    <script src="~/app/js/taxirequest/taxiusesreport.js"></script>
}
   



