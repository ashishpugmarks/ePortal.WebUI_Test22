@model ePortal.ViewModels.TaxiRequestViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewBag.Title = "Employee Portal  :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loginUser = Context.Session.GetString("userId") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userId").ToString());
}
@section Styles{
    <style nonce="@Context.Items["StyleNonce_0"]">
        .table td {
            font-size: 13px;
           
        }

        #alert_div{
            padding:10px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .btn.btn-primary.active {
            width: 80px !important;
        }
    </style>
}

   
    @Html.HiddenFor(model => model.REQUESTID)
    @Html.HiddenFor(model => model.DATEOFTRAVELFROM)
    @Html.HiddenFor(model => model.SUPERVISORADEMPCODE)
    @Html.HiddenFor(model => model.REPORTINGTIME)
        <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <span style="padding-left: 10px;">Cancel Vehicle(Cab) Request</span>
        </div>
        <div id="div_message" style="padding:10px; margin-left: 5px; margin-right: 5px; margin-top: 5px; margin-bottom: 5px; vertical-align: middle;padding:10px;font-size:13px"></div>
        <div class="panel-group" style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
            <div class="panel panel-primary">
                <div class="panel-heading" style="padding:10px">
                    <h2 class="panel-title">Fill all mandatory(*) fields</h2>
                </div>
                <table class="table table-bordered table-condensed table-hover" style="padding-bottom:0px;">
                    <tr class="active">
                        <td class="text-info" style="vertical-align: middle; text-align: right;">Shift<span style="color: #ff0000">*</span>
                        </td>
                        <td style="vertical-align: middle;">
                        <span class="control-label">@Model.SHIFT</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-info" style="vertical-align: middle; text-align: right;">Extension No.:
                        </td>
                        <td style="vertical-align: middle;">
                        <span class="control-label">@Model.EXTENSIONO</span>
                        </td>
                    </tr>
                    <tr class="active">
                        <td class="text-info" style="vertical-align: middle; text-align: right;">Phone No.:
                        </td>
                        <td style="vertical-align: middle;">
                        <span class="control-label">@Model.PHONENO</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-info" style="vertical-align: middle; text-align: right;">Date of Travel:
                        </td>
                        <td style="vertical-align: middle;"><b>From: </b>
                        <span class="control-label">@Model.DATEOFTRAVELFROM</span>
                          &nbsp;<b>To: </b>
                        <span class="control-label">@Model.DATEOFTRAVELTO</span>
                        </td>
                    </tr>
                    <tr class="active">
                        <td class="text-info" style="vertical-align: middle; text-align: right;">Reporting Time:
                        </td>
                        <td style="vertical-align: middle;">
                        <span class="control-label">@Model.REPORTINGTIME</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-info" style="vertical-align: middle; text-align: right;">Reporting Place:
                        </td>
                        <td style="vertical-align: middle;">
                        <span class="control-label">@Model.ADDRESS</span>
                        </td>
                    </tr>
                    <tr class="active">
                        <td class="text-info" style="vertical-align: middle; text-align: right;">Number of Person(s):
                        </td>
                        <td style="vertical-align: middle;">
                        <span class="control-label">@Model.NOOFPERSON</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-info" style="vertical-align: middle; text-align: right;">Purpose of Visit:
                        </td>
                        <td style="vertical-align: middle;">
                        <span class="control-label">@Model.PURPOSEOFVISIT</span>
                        </td>
                    </tr>
                    <tr class="active">
                        <td class="text-info" style="vertical-align: middle; text-align: right;">Place of Visit:
                        </td>
                        <td style="vertical-align: middle;">
                        <span class="control-label">@Model.PLACEOFVISIT</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-info" style="vertical-align: middle; text-align: right;">Remarks:
                        </td>
                        <td style="vertical-align: middle;">
                        <span class="control-label">@Model.REMARKS</span>
                        </td>
                    </tr>
                    <tr class="active">
                        <td class="text-info" style="vertical-align: middle; text-align: right;">Approval Authority:
                        </td>
                        <td style="vertical-align: middle;"><b>
                            <span class="control-label">@Model.SUPERVISORADEMPNAME</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-info" style="vertical-align: middle; text-align: right;">Remarks <span style="color: #ff0000">*</span>
                        </td>
                        <td style="vertical-align: middle;">
                            <div class="col-xs-10 col-sm-5 col-md-6 col-lg-6" style="padding: 0px;">
                                <textarea id="txtCancelRequest" class="form-control" rows="5" cols="5"
                                   ></textarea>
                            </div>
                        </td>
                    </tr>
                </table>
                <div class="panel-footer" style="text-align: center;">
                <a class="btn btn-primary active" id="btnSubmit" style="cursor:pointer" data-ctrl-id="btn-submit">Submit</a>
                <a class="btn btn-default active" href="/TokenBridge/RedirectToOldApp?target =/ASPXView/ManageRequest.aspx" id="cmdReset">Back</a>
                </div>
            </div>
        </div>
        <div style="margin-left: 0.8em; margin-right: 0.8em;" class="well well-sm">
            <table border="0" style="width: 100%;padding:10px">
                <tr>
                    <td style="height: 20px;">
                        <table style="width: 100%;">
                            <tbody>
                                <tr>
                                    <td style="width: 20px; vertical-align: middle; text-align: center;">
                                    <a title="Back" href="/TokenBridge/RedirectToOldApp?target =/ASPXView/ManageRequest.aspx">
                                            <img src="../../images/icon_back.gif" border="0" alt="" />
                                        </a>
                                    </td>
                                    <td style="vertical-align: middle; font-size: 15px;">
                                    <span><a title="Back" href="/TokenBridge/RedirectToOldApp?target =/ASPXView/ManageRequest.aspx">Back</a></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </table>
        </div>


    <div id="ajaxLoader"></div>
   

    @section Scripts{
    <script type="text/javascript" language="Javascript" src="~/js/alertmessage.js"></script>
    <script src="~/app/js/taxirequest/canceltaxirequest.js"></script>
    }

