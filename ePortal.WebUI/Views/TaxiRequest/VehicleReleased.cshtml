@model ePortal.ViewModels.VehicleReleased
@using Microsoft.AspNetCore.Http
@{
    ViewBag.Title = "Employee Portal  :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loginUser = Context.Session.GetString("userId") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userId").ToString());
    var _urlStr = "/TaxiRequest/VehicleReleased?id=" + (int)double.Parse(Model.ADVEHICLEREQUESTID) + "&Did=" + (int)double.Parse(Model.ADVECHICLEDETAILID);

}
@section Styles{
    <style>
        .control-label {
            font-size: 16px;
            font-weight: normal
        }

        .small {
            font-size: 15px !important;
        }

        .checkbox {
            height: 19px !important;
        }

        #alert_div span {
            font-size: 15px !important;
        }

        .panel-heading {
            height: 40px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .panel-title {
            padding: 10px !important;
        }

        #alert_div {
            padding: 10px !important;
        }
        .btn.btn-primary.active {
            width: 80px !important;
        }
    </style>
}
<div class="row">
   
        <div style="height: 2.2em; padding-top: 10px; font-size: medium; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
            <span style="padding-left: 10px;">Update Vehicle(Cab) Release Details</span>
        </div>
        <div id="div_message" style="margin-left: 5px; margin-right: 5px; margin-top: 5px; margin-bottom: 5px; vertical-align: middle;"></div>
        <div class="panel-group" style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h2 class="panel-title">Vehicle Request Details</h2>
                </div>
                @Html.HiddenFor(model => model.ADVECHICLEDETAILID)
                <table class="table  table-bordered table-condensed">
                    <tbody>
                        <tr class="active">
                            <td style="text-align: right;">
                                <span class="control-label text-info">Name</span>
                            </td>
                            <td colspan="3" class="control-label">
                                @Model.Name
                                @* <asp:Literal runat="server" ID="lblName" /> *@
                            </td>
                        </tr>
                        <tr style="display: none;">
                            <td align="left" style="width: 169px; text-align: right;">
                                <span class="fieldname text-info">&nbsp;Designation&nbsp;</span>
                            </td>
                            <td align="left">
                                &nbsp;@Model.Designation
                                @* <asp:Literal runat="server" ID="lblDesignation" /> *@
                            </td>

                            <td align="left" style="width: 169px; height: 24px; text-align: right;">
                                <span class="fieldname text-info">&nbsp;Department&nbsp;</span>
                            </td>
                            <td align="left" style="height: 24px">&nbsp;
                                @Model.Dept
                                @* <asp:Literal runat="server" ID="lblDept" /> *@
                            </td>
                        </tr>
                        <tr style="display: none;">
                            <td align="left" style="width: 169px; text-align: right;">
                                <span class="fieldname text-info">&nbsp;Email&nbsp;</span>
                            </td>
                            <td align="left" colspan="3">&nbsp;
                                @Model.Email
                                @* <asp:Literal runat="server" ID="lblEmail" /> *@
                            </td>
                        </tr>
                        <tr style="display: none;">
                            <td align="left" style="width: 169px; text-align: right;">
                                <span class="fieldname text-info">&nbsp;Phone No.&nbsp;</span>
                            </td>
                            <td align="left">&nbsp;
                                @Model.Phoneno
                                @* <asp:Literal runat="server" ID="lblphoneno" /> *@
                            </td>

                            <td align="left" style="width: 169px; text-align: right;">
                                <span class="fieldname text-info">&nbsp;Extension No.&nbsp;</span>
                            </td>
                            <td align="left">&nbsp;
                                @Model.Ext
                                @* <asp:Literal runat="server" ID="lblExt" /> *@
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right;">
                                <span class="control-label text-info">Date of Travel</span>
                            </td>
                            <td colspan="3" class="control-label ">
                                From :
                                @Model.FromDate
                                @* <asp:Literal runat="server" ID="lblfrmDt" /> *@
                                &nbsp;To :
                                @Model.ToDate
                                @* <asp:Literal runat="server" ID="lbltoDt" /> *@
                            </td>
                        </tr>
                        <tr class="active">
                            <td style="text-align: right;">
                                <span class="control-label text-info">Time of Travel</span>
                            </td>
                            <td class="control-label">
                                @Model.Time
                                @* <asp:Literal runat="server" ID="lblTime" /> *@
                            </td>

                            <td style="text-align: right;">
                                <span class="control-label text-info">No. Of Person</span>
                            </td>
                            <td>
                                @* @Model.ToDate *@
                                @* <asp:Literal runat="server" ID="lblPerson" /> *@
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right;">
                                <span class="control-label text-info">Purpose Of Visit</span>
                            </td>
                            <td colspan="3" class="control-label">
                                @Model.Purpose
                                @* <asp:Literal runat="server" ID="lblPurpose" /> *@
                            </td>
                        </tr>
                        <tr class="active">
                            <td style="text-align: right;">
                                <span class="control-label text-info">Reporting Site</span>
                            </td>
                            <td class ="control-label">
                                @* <asp:Literal runat="server" ID="lblReportingSite" /> *@
                                @Model.ReportingSite
                            </td>
                            <td style="text-align: right;">
                                <span class="control-label text-info">Reporting Place</span>
                            </td>
                            <td class="control-label">
                                @* <asp:Literal runat="server" ID="lblReportingPlace" /> *@
                                @Model.ReportingPlace
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right;">
                                <span class="control-label text-info">Place Of Visit</span>
                            </td>
                            <td colspan="3" class="control-label">
                                @* <asp:Literal runat="server" ID="lblplace" /> *@
                                @Model.Place
                            </td>
                        </tr>
                        <tr class="active">
                            <td style="text-align: right;">
                                <span class="control-label text-info">Associate Remarks</span>
                            </td>
                            <td colspan="3" class="control-label">
                                @* <asp:Literal runat="server" ID="lblRemarks" /> *@
                                @* @Model.REMARKS *@
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="panel-group" style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title">Vehicle Release Details</h2>
                </div>
                <table class="table table-bordered table-condensed table-hover" style="border-bottom: 1px solid #337ab7;">
                    <tr class="active">
                        <td style="text-align: right">
                            <span class="control-label">Slip No.</span>
                        </td>
                        <td colspan="3" class="control-label">
                            @* <asp:Label ID="lblslipno" runat="server"></asp:Label> *@
                            @Model.SLIPNO
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: right; vertical-align: middle;">
                            <span class="control-label">Release Meter Reading</span>
                            @* <asp:HiddenField ID="hdfmeterreading" runat="server" /> *@
                            @Html.HiddenFor(model => model.METERREADING)
                            
                        </td>
                        <td >
                              @if(Model.IsEnabled){
                                @Html.TextBoxFor(model => model.RELEASEMETERREADING, new { @class = "form-control", @id = "txtkmused" })
                            }
                            else
                            {
                                @Html.TextBoxFor(model => model.RELEASEMETERREADING, new { @class = "form-control", @id = "txtkmused", @disabled ="disabled" })

                            }
                            @* <asp:TextBox ID="txtkmused" runat="server" CssClass="form-control"></asp:TextBox> *@
                            @* <ajaxToolkit:FilteredTextBoxExtender ID="ftbekmused" runat="server" TargetControlID="txtkmused"
                                FilterType="Numbers" ValidChars="0123456789" /> *@
                        </td>
                        <td style="text-align: right; vertical-align: middle;">
                            <span class="control-label">Released At</span>
                        </td>
                        <td>
                            @if(Model.IsEnabled){
                                @Html.DropDownListFor(m => m.BUSROUTEID, Model.BUSROUTELIST, new { @class = "form-control", @id = "ddlboardingpoint", })
                            }
                            else
                            {
                                @Html.DropDownListFor(m => m.BUSROUTEID, Model.BUSROUTELIST, new { @class = "form-control", @id = "ddlboardingpoint", @disabled ="disabled" })


                            }

                                </td>
                    </tr>
                    <tr class="active">
                        <td style="text-align: right; vertical-align: middle;">
                            <span class="control-label">Visited Place</span>
                        </td>
                        <td colspan="3">
                            @* <asp:TextBox ID="txtvisitplace" runat="server" CssClass="form-control"></asp:TextBox> *@
                             @if(Model.IsEnabled){
                                @Html.TextBoxFor(model => model.VISITE_PLACE, new { @class = "form-control", @id = "txtvisitplace"})
                            }
                            else
                            {
                                @Html.TextBoxFor(model => model.VISITE_PLACE, new { @class = "form-control", @id = "txtvisitplace", @disabled = "disabled" })

                            }
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: right; vertical-align: middle;">
                            <span class="control-label">Taxi Condition</span>
                        </td>
                        <td colspan="3">
                            @foreach (var item in new[] {
                                                        new { Text = "Very Good", Value = "4" },
                                                        new { Text = "Good", Value = "3" },
                                                        new { Text = "Average", Value = "2" },
                                                        new { Text = "Poor", Value = "1" }
                                                        })
                            {
                                <label class="control-label">
                                    @if (Model.IsEnabled)
                                    {
                                        <input type="radio" name="TaxiCondition" id="TaxiCondition" value="@item.Value"
                                        @(Model.TAXICONDITIONSTATUS == item.Value ? "checked" : "") />
                                    }
                                    else
                                    {

                                        <input type="radio" disabled="disabled" name="TaxiCondition" id="TaxiCondition" value="@item.Value"
                                                @(Model.TAXICONDITIONSTATUS == item.Value ? "checked" : "") />
                                        
                                    }
                                   <b> @item.Text</b>
                                </label>
                            }
                            @* <asp:RequiredFieldValidator ID="rfdtaxicondition" runat="server" BorderStyle="None"
                                ControlToValidate="rdotaxicondtition" Display="Dynamic"
                                ErrorMessage="&lt;b style='color:Red;'&gt;* (Taxi Condition is a required field.)&lt;/b&gt; "
                                Font-Bold="true" Height="25px" ValidationGroup="Group5">
                            </asp:RequiredFieldValidator> *@
                        </td>
                    </tr>
                    <tr class="active">
                        <td style="text-align: right; vertical-align: middle;">
                            <span class="control-label">Remark</span>
                        </td>
                        <td colspan="3">
                            @if(Model.IsEnabled){
                                @Html.TextBoxFor(model => model.REMARKS, new { @class = "form-control", @id = "txtremarks"})
                            }
                            else
                            {
                                @Html.TextBoxFor(model => model.REMARKS, new { @class = "form-control", @id = "txtremarks", @disabled = "disabled"})

                            }
                        </td>
                    </tr>
                </table>
                <div class="panel-footer" style="text-align: center;padding:10px">
                    @if (Model.IsEnabled) {
                        <input class="btn btn-primary active" id="btnSubmit" data-ctrl-id="btn-submit" value="Submit" />
                       
                        <a href="@_urlStr" class="btn btn-default active" target="_self">Cancel</a>
                    }
                    else
                    {
                        <input class="btn btn-primary" id="btnSubmit" disabled="disabled" value="Submit" />
                        <input type="reset" Text="Cancel" id="btnCancel" disabled="disabled"  class="btn btn-default" />
                    }

                </div>
            </div>
        </div>
        <div style="margin-left: 0.8em; margin-right: 0.8em;padding:10px" class="well well-sm">
            <table border="0" style="width: 100%;">
                <tr>
                    <td style="height: 20px;">
                        <table style="width: 100%;">
                            <tbody>
                                <tr>
                                    <td style="width: 20px; vertical-align: middle; text-align: center;">
                                        <a title="Back" href="/TaxiRequest/TaxiRequestList">
                                            <img src="../../images/icon_back.gif" border="0" alt="" />
                                        </a>
                                    </td>
                                    <td style="vertical-align: middle; font-size: 15px;">
                                        <span><a title="Back" href="/TaxiRequest/TaxiRequestList">Back</a></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
       
   
</div>
    <div id="ajaxLoader"></div>
@section Scripts{
    <script type="text/javascript" language="Javascript" src="~/js/alertmessage.js"></script>
<script src="~/app/js/taxirequest/vehiclereleased.js"></script>

}