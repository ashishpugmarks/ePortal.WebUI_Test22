@model ePortal.ViewModels.TaxiRequestViewModel;
@using Microsoft.AspNetCore.Http
@{
    Layout = null;
}
<html>
<head>
    <style nonce="@Context.Items["StyleNonce_1"]">
        div.dataTables_wrapper div.dataTables_paginate{
            font-size: 13px !important
        }

        #tblVechicleList td {
            font-size: 12px !important;
        }

        #tblVechicleList th {
            font-size: 16px !important;
        }
    </style>
  
</head>
<body>
<div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;" class="table-responsive">
  

<table class="table table-condensed" style="width:100%;">
    <tr>
        <td>
                    <table class="table table-bordered table-condensed table-striped table-hover" id="tblVechicleList" style="width:100%;">
                <tr style="background-color: #F7BE81;">
                    <td><b>Emp Name</b></td>
                    <td><b>Travel Date</b></td>
                    <td><b>From Location</b></td>
                    <td><b>To Location</b></td>
                    <td><b>Time</b></td>
                </tr>

                @{
                    string oldSection = string.Empty;
                    string oldEmpName = string.Empty;
                }

                        @for (int i = 0; i < Model.VehicleReport.Count; i++)
                {
                            var section = Model.VehicleReport[i].EMPSECTION;
                            var empName = Model.VehicleReport[i].EMPNAME;
                    var tmpName = empName.Trim() == oldEmpName.Trim() ? "" : empName.Trim();

                    @if (oldSection != section)
                    {
                        <tr style="background-color: #D0F5A9">
                                    <td colspan="5"><strong>@Model.VehicleReport[i].EMPSECTION</strong></td>
                        </tr>
                    }

                    oldSection = section;
                    oldEmpName = empName;

                    <tr>
                        <td>@tmpName</td>
                                <td>@Model.VehicleReport[i].TRAVELDATE</td>
                                <td>@Model.VehicleReport[i].FROLLOC</td>
                                <td>@Model.VehicleReport[i].TOLOC</td>
                                <td>@Model.VehicleReport[i].REPORTINGTIME</td>
                    </tr>
                }
            </table>
        </td>
    </tr>
</table>
</div>
</body></html>
