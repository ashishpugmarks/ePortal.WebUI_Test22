@model ePortal.ViewModels.TaxiRequestViewModel
@using Microsoft.AspNetCore.Http
@{
    Layout = null;
}
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>::Taxi Uses Report::</title>
<style type="text/css">
@@media print
  {
  .noprint {display:none;}
  }

@@page {
    margin: 10%;
    size: landscape;
}

</style>
    <script src="~/bundle/jquery.min.js"></script>
        <script language="javascript" type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">

                   $(document).ready(function () {
                      
                      
                    $("[data-ctrl-id='btn-print']").on('click', function () {
                       window.print();

                       });
                       //--------------------------------------------------------------------------------
                     }
                   );
 </script>

</head>
<body style="font-size:10px; color:Black;font-family:arial,helvetica,clean,sans-serif;">
    
    <div>
    <div style="text-align:right; height:20px; font-size:13px; padding:5px; font-weight:bold"></div>
    <div style="text-align:center; height:20px; font-size:13px; font-weight:bold">Taxi 
        Uses Report</div>
    <table cellpadding="1px" cellspacing="0px" border="0" width="100%">
        <tr>
            <td width="65%">
                <table cellpadding="1px" cellspacing="0px" border="0" width="100%">
                    <tr>
                        <td>
                            <strong> Honda Motorcycle & Scooter India Pvt.Ltd.</strong><br />
                            Plot No. 1&2, Sector-3 ,IMT Manesar,<br />
                            Distt. Gurgaon,(Haryana) - 122050
                        </td>
                    </tr>
                </table>
            </td>
            <td >
                <table cellpadding="1px" cellspacing="0px" border="0" width="100%">
                    <tr>
                        <td align="left" width="35%" >Employee Name :</td>
                                <td>@Model.EMPNAME</td>
                    </tr>
                    <tr>
                        <td align="left">Date From :</td>
                                <td>@Model.DATEOFTRAVELFROM</td>
                    </tr>
                    <tr>
                        <td align="left">Date TO :</td>
                                <td>@Model.DATEOFTRAVELTO </td>
                    </tr>
                   
                </table>
            </td>
        </tr>
    </table>
    <table cellpadding="1px" cellspacing="0px" border="0" width="100%">
    <tr >
        <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-left:solid 1px #000000;border-top:solid 1px #000000;width:4%" valign="top"><strong >Vehicle No</strong></td>
        <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:8%" valign="top"><strong >Vendor</strong></td>
        <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:8%" valign="top"><strong >Taxi used Km.</strong></td>
        <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:5%" valign="top"><strong >Released At</strong></td>
        <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:8%" valign="top"><strong >Taxi used Date</strong></td>
        <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-top:solid 1px #000000;width:6%" valign="top"><strong >Remarks</strong></td>
        
    </tr>
     @if (Model != null)
            {
                foreach (var item in Model.TaxiUsesReportList)
                {
                                <tr>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;border-left:solid 1px #000000;"><strong> @Html.DisplayFor(modelItem => item.VEHICLENO)</strong></td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;"><strong>@Html.DisplayFor(modelItem => item.DESCRIP)</strong></td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;"><strong>@(double.TryParse(item.USEKM, out var km) ? (int)km : "")</strong></td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;"><strong>@Html.DisplayFor(modelItem => item.RELEASEAT)</strong></td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;">  @Html.DisplayFor(modelItem => item.TAXIREQUIREDATE)</td>
                            <td style="border-bottom:solid 1px #000000; border-right:solid 1px #000000;">@Html.DisplayFor(modelItem => item.REMARKS)</td>

                                </tr>
                            }}
                            </table>
    </div>
    <table cellpadding="0" width="100%" cellspacing="0" style="padding-top:100px;"  >
    <tr>
        <td>
                    <input type="button" value="Print Report" class="noprint" data-ctrl-id="btn-print" style="background-color: #fed;" />
        </td>
    </tr>
    </table>

</body>
</html>
