@model ePortal.ViewModels.TaxiRequestViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewBag.Title = "Employee Portal  :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loginUser = Context.Session.GetString("userId") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userId").ToString());
}
@section Styles{
    <link href="~/lib/bootstrap/css/dataTables.bootstrap.min.css" rel="stylesheet" />
 
    <style nonce="@Context.Items["StyleNonce_0"]">
        table.dataTable thead th, table.dataTable thead td {
            padding: 8px 12px;
        }

        div.dataTables_wrapper div.dataTables_paginate {
            font-size: 13px !important
        }
        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            line-height: 1.0;
            vertical-align: middle;
            font-family: "Helvetica Neue", Helvetica, Arial;
        }

        table.dataTable tbody td {
            padding: 4px 3px;
        }

        .table > tbody > tr:nth-of-type(odd) {
            background: #e9e9e9;
        }

        select.input-sm {
            line-height: 10px !important;
        }

        .sweet-alert {
            z-index: 1000000;
            border: 1px solid;
        }
        .control-label {
            font-size: 16px;
            font-weight: normal
        }

        .small {
            font-size: 15px !important;
        }

        .checkbox {
            height: 19px !important;
        }

        #alert_div span {
            font-size: 15px !important;
        }

        .panel-heading {
            height: 40px !important;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }

        .panel-title {
            padding: 10px !important;
        }

        #alert_div {
            padding: 10px !important;
        }
    </style>
}
<div class="row">

    
        <div class="panel-group">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title">
                        <strong>Vehicle(Cab) Released Status</strong>
                    </h2>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                <table class="table table-bordered table-hover " id="tblTaxiList">
                    <thead>
                        <tr>
                            <th class="text-center">
                                
                            </th>
                            <th class="text-left control-label">
                                @Html.DisplayName("Emp Code")
                            </th>
                                <th class="text-center control-label">
                                @Html.DisplayName("Emp Name")
                            </th>
                                <th class="text-center control-label">
                                @Html.DisplayName("From Date")
                            </th>
                                <th class="text-left control-label">
                                @Html.DisplayName("To Date")
                            </th>
                                <th class="text-left control-label">
                                @Html.DisplayName("Application Date")
                            </th>
                                <th class="text-left control-label">
                                @Html.DisplayName("Admin Status")
                            </th>
                                <th class="text-left control-label">
                                @Html.DisplayName("Release Status")
                            </th>
                         
                        </tr>
                    </thead>
                    <tbody>
                       
                        @if (Model != null)
                        {
                            foreach (var item in Model.taxiRequestList)
                            {
                                //var _tId = Server.UrlEncode(Encryption.Encrypt(item.SMHEADERID.ToString())).ToString();
                                //var _tId = item.ADVEHICLEREQUESTID;
                                var _urlStr = "/TaxiRequest/VehicleReleased?id=" + (int)double.Parse(item.ADVEHICLEREQUESTID) + "&Did=" + (int)double.Parse(item.ADVECHICLEDETAILID);
                                //processstts = item.PROCESS_STATUS;
                                <tr>
                                        <td class="text-center  control-label" style="width:7%;">
                                       
                                        <a href="@_urlStr" target="_blank"><img src="../../images/icon_edit.gif" alt="Edit"></a>
                                    </td>
                                        <td class="control-label">
                                        @(double.TryParse(item.empcode, out var val) ? (int)val : 0)
                                    </td>
                                        <td class="control-label">
                                        @Html.DisplayFor(modelItem => item.empname)
                                    </td>
                                        <td class="control-label">
                                        @Html.DisplayFor(modelItem => item.dateoftravelfrom)
                                    </td>
                                        <td class="control-label">
                                        @Html.DisplayFor(modelItem => item.dateoftravelto)
                                    </td>
                                        <td class="control-label">
                                        @Html.DisplayFor(modelItem => item.dateapplied)
                                    </td>
                                        <td class="control-label">
                                        @Html.DisplayFor(modelItem => item.AdminStatus)
                                    </td>
                                        <td class="control-label">
                                        @Html.DisplayFor(modelItem => item.RELEASESTATUS)
                                    </td>
                                   

                                </tr>
                            }
                        }

                    </tbody>

                </table>
               

            </div>
        </div></div></div>
        <div style="margin-left: 0.8em; margin-right: 0.8em;" class="well well-sm">
            <table border="0" style="width: 100%;">
                <tr>
                    <td style="height: 20px;padding: 10px;">
                        <table style="width: 100%;">
                            <tbody>
                                <tr>
                                    <td style="width: 20px; vertical-align: middle; text-align: center;">
                                        <a title="Back" href="../../Home/Home">
                                            <img src="../../images/icon_back.gif" border="0" alt="" />
                                        </a>
                                    </td>
                                    <td style="vertical-align: middle; font-size: 15px;">
                                        <span><a title="Back" href="../../Home/Home">Back</a></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
        
    </div>
@section Scripts{
    <script src="~/lib/bootstrap/js/dataTables.bootstrap.min.js"></script>
    <script src="~/app/js/taxirequest/taxirequestlist.js"></script>
}


