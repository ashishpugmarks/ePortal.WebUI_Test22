                    </tr>
                </table>
            </div>
        </div>
        <div class="panel-group" style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h2 class="panel-title" sty>Terms of Service's</h2>
                </div>
                <table class="table table-bordered table-condensed">
                    <tr>
                        <td colspan="2">
                            <ul class="list-group" style="padding:0px; margin:0px;">
                                <li class="list-group-item small" style="line-height: 1em;">
                                    <strong>1. </strong>As per company policy transport is
                                    to be shared and inconvenience of 30min - 1hour must be accepted.
                                </li>
                                <li class="list-group-item small" style="line-height: 1em;">
                                    <strong>2. </strong>Reporting Km/Time, Releasing Km/Time
                                    Destination must be entered and signed.
                                </li>
                                <li class="list-group-item small" style="line-height: 1em;">
                                    <strong>3.</strong> Request for Taxi from 0600h to 1200h
                                    must reach by 1600h previous day.
                                </li>
                                <li class="list-group-item small" style="line-height: 1em;">
                                    <strong>4.</strong> Request for Taxi from 1200h to 1800h
                                    must reach by 1030h that day.
                                </li>
                                <li class="list-group-item small" style="line-height: 1em;">
                                    <strong>5.</strong> Request for Taxi after 2300h will
                                    be given manually on printed form.
                                </li>
                                <li class="list-group-item small" style="line-height: 1em;">
                                    <strong>6.</strong> Change in request/cancellation is
                                    possible upto 2 hours prior to scheduled departure.
                                </li>
                                <li class="list-group-item small" style="line-height: 1em;">
                                    <strong>7.</strong> Request for Taxi for Over Time in
                                    A,B,& G shift must reach by 1600h.
                                </li>
                                <li class="list-group-item small" style="line-height: 1em;">
                                    <strong>8.</strong> Please note airport pick-up /drop
                                    demand must be placed on the date the ticket is booked. Airport duty is exclusive
                                    and not a norman request.
                                </li>
                                <li class="list-group-item small" style="line-height: 1em;"><strong style="font-weight: bold; color: Red">9.Please tear off 2nd copy of duty slip, if any query please contact transport help line number(95605 66333) .</strong></li>
                            </ul>
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: center;">
                        <input type="CheckBox" class="form-control checkbox" id="chkTerms" />
                        </td>
                        <td class="text-info small">
                            I have read, understood & agree the terms of services.
                        </td>
                    </tr>
                </table>
            </div>
            <div class="panel-footer" style="text-align: center;padding: 10px;">
            @if (Model.IsEnabled)
            {
                <input class="btn btn-primary active" id="btnSubmit" data-ctrl-id="btn-submit" value="Submit"/>
              
            }
            else
            {
                <a class="btn btn-primary" disabled="disabled">Submit</a>
            }
            <input class="btn btn-default active" type="reset" data-ctrl-id="btn-cancel" value="Cancel" id="cmdReset" />
            </div>
        </div>
        <div style="margin-left: 0.8em; margin-right: 0.8em;" class="well well-sm">
            <table border="0" style="width: 100%;">
                <tr>
                    <td style="height: 20px;padding: 10px;">
                        <table style="width: 100%;">
                            <tbody>
                                <tr>
                                    <td style="width: 20px; vertical-align: middle; text-align: center;">
                                        <a title="Back" href="../../Home/Home">
                                            <img src="../../images/icon_back.gif" border="0" alt="" />
                                        </a>
                                    </td>
                                    <td style="vertical-align: middle; font-size: 15px;">
                                        <span><a title="Back" href="../../Home/Home">Back</a></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
       </form>
    
     <div id="ajaxLoader"></div>

</div>
@section Scripts{
    <script type="text/javascript" language="Javascript" src="~/js/alertmessage.js"></script>
    <script src="~/app/js/taxirequest/edittaxirequest.js"></script>
    <script type="text/javascript"   nonce="@Context.Items["ScriptNonce_3"]">
        @if (!Model.IsEnabled)
        {
            <text>
                ShowMessage("As per the Company Transport Policy, Managers and Above are not eligible for Taxi Request", "Error");
            </text>
        }
    </script>
  

}