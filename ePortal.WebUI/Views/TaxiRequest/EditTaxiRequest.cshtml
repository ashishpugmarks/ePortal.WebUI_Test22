                            <div class="col-xs-8 col-sm-5 col-md-6 col-lg-6" style="padding: 0px;">
                                @* <asp:DropDownList ID="drpLstApprovalAuthority" runat="server" CssClass="form-control">
                                </asp:DropDownList> *@
                                @Html.DropDownListFor(m => m.SUPERVISORADEMPCODE, Model.ApproverList, new { @class = "form-control", @id = "drpLstApprovalAuthority" })

                            </div>
