                            </select>

                        </div>
                        </td>
                    </tr>
                    <tr class="active">
                        <td style="vertical-align: middle; text-align: right;" class="text-info">
                            @Html.LabelFor(model => model.ADDRESS, new { @class = "control-label" })<span style="color: #ff0000">*</span>
                        </td>
                        <td style="vertical-align: middle;" colspan="3">
                            <div class="col-xs-8 col-sm-5 col-md-6 col-lg-6" style="padding: 0px;">
                                @Html.TextAreaFor(model => model.ADDRESS, new { @class = "form-control", @id = "txtReportingPlace" })

                                @* <asp:TextBox ID="txtReportingPlace" runat="server" CssClass="form-control" TextMode="multiLine" EnableViewState="False"></asp:TextBox> *@
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="vertical-align: middle; text-align: right;" class="text-info">
                            @Html.LabelFor(model => model.SITE, new { @class = "control-label" })<span style="color: #ff0000">*</span>
                        </td>
                        <td style="vertical-align: middle;" colspan="3">
                            <div class="col-xs-6 col-sm-5 col-md-6 col-lg-3" style="padding: 0px;">
                                @* <asp:DropDownList ID="ddlsite" runat="server" CssClass="form-control">
                                </asp:DropDownList> *@
                                @Html.DropDownListFor(model => model.SITE,Model.SITEList , "Select", new { @id = "ddSite", @class = "form-control" })

                            </div>
                        </td>
                    </tr>
                    <tr class="active">
                        <td style="vertical-align: middle; text-align: right;" class="text-info">
                            @Html.LabelFor(model => model.NOOFPERSON, new { @class = "control-label" })<span style="color: #ff0000">*</span>
                        </td>
                        <td style="vertical-align: middle;" colspan="3">
                            <div class="col-xs-2 col-sm-5 col-md-6 col-lg-1" style="padding: 0px;">
                                @Html.TextBoxFor(model => model.NOOFPERSON, new { @class = "form-control", @id = "noOfPerson", })

                                @* <asp:TextBox ID="noOfPerson" runat="server" CssClass="form-control" EnableViewState="False"
