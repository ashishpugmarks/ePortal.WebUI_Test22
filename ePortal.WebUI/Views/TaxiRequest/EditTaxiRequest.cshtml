@model ePortal.ViewModels.TaxiRequestViewModel
@using Microsoft.AspNetCore.Http

@{
    ViewBag.Title = "Employee Portal  :: Honda Motorcycle & Scooter India Pvt. Ltd.";
    Layout = "~/Views/Shared/_Layout.cshtml";
   var loginUser = Context.Session.GetString("userId") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userId").ToString());
}

@section Styles{
   @* <link href="~/css/NewMasterStyleSheet.css" rel="stylesheet" /> *@
    <style  nonce="@Context.Items["StyleNonce_0"]">
        .control-label {
            font-size:16px;
            font-weight:normal
        }
        .small{
            font-size:15px !important;
        }

        .checkbox{
            height:19px !important;
        }
        #alert_div span{
            font-size:15px !important;
        }
        .panel-heading{
            height:40px !important;
        }
         .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('../../images/loading_double.gif') 50% 50% no-repeat #ffffff;
            opacity: .7;
        }
        .btn.btn-primary.active {
            width:80px !important;
        }.panel-title{
         padding:10px !important;
     }
        #alert_div{
            padding:10px !important;
        }
    </style>
       

}
  <div class="row">
        
