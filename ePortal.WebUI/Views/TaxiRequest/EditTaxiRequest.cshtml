                            @Html.LabelFor(model => model.SUPERVISORADEMPCODE, new { @class = "control-label" })<span style="color: #ff0000">*</span>

                            <asp:Label ID="Label1" runat="server" Text="[ for approval ]"></asp:Label>
                        </td>
