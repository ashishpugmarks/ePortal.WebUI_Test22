@{
    ViewData["Title"] = "Status Code";
    var statusCode = ViewBag.StatusCode as int?;
}

<h1 class="text-warning">Status Code: @statusCode</h1>

@if (statusCode == 404)
{
    <p>The page you're looking for could not be found.</p>
}
else if (statusCode == 500)
{
    <p>Internal server error. Please contact support.</p>
}
else
{
    <p>An unexpected status code was returned: @statusCode</p>
}
