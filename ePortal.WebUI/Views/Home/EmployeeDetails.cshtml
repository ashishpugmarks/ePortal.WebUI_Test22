@model ePortal.ViewModels.EmployeeDetailViewModel
@{
    ViewData["Title"] = "Employee Details";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/NewMasterStyleSheet.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />

    <script nonce="@Context.Items["ScriptNonce_4"]">

        document.addEventListener('DOMContentLoaded', () => {
            const img = document.getElementById('uImage');
            // Example: resize logic or clipboard clear can go here if needed
        });

        document.addEventListener('contextmenu', e => e.preventDefault());
        document.addEventListener('dragstart', e => e.preventDefault());

        document.addEventListener('keydown', (e) => {
            // Disable keys as needed (careful with accessibility)
            // e.preventDefault();
        });
    </script>
</head>

<body>
    <form id="frm_EmployeeDetail" >      
        <div id="div_message"></div>
        <div style="margin-left: 10px; margin-right: 10px; margin-top: 10px;">
            <table style="width:100%;" class="table table-striped table-condensed">
                <tr class="HeaderStyle123">
                    <td colspan="3" style="height:25px;">
                        <h3 style="font-weight: bold;">Employee Detail's</h3>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Employee Code:</span>
                    </td>
                    <td style="width: 220px; color: #2683D4;">
                        <b><strong>@Model.EmpCode</strong></b>
                    </td>
                    <td rowspan="7" align="center" valign="middle">
                        <table border="1" style="border-right: #cccccc thin solid; border-top: #cccccc thin solid; border-left: #cccccc thin solid; border-bottom: #cccccc thin solid">
                            <tr>
                                <td>
                                    <div id="div_Img" runat="server">
                                       @*  <asp:Image ID="uImage" runat="server" Style="padding-right: 0px; padding-top: 0px; vertical-align: top"
                                                   onmousedown="event.preventDefault()"></asp:Image> *@

                                        <img id="uImage" src="@Model.ImageUrl" alt="Employee Image" style="padding-right: 0px;width:100px;height:auto; padding-top: 0px; vertical-align: top" />
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Employee Name:</span>
                    </td>
                    <td style="width: 220px; color: #2683D4;">
                        <b><strong>@Model.EmpName</strong></b>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Designation:</span>
                    </td>
                    <td style="width: 220px; color: #2683D4;">
                        <strong>@Model.Designation</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Job Title:</span>
                    </td>
                    <td style="width: 220px; color: #2683D4;">
                        <strong>@Model.JobTitle</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Birth Day:</span>
                    </td>
                    <td style="color: #2683D4;">
                        <strong>@Model.DOB</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right; height: 24px;">
                        <span>Operation:</span>
                    </td>
                    <td style="width: 220px; height: 24px; color: #2683D4;">
                        <strong>@Model.Operation</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right; height: 24px;">
                        <span>Division:</span>
                    </td>
                    <td style="width: 220px; height: 24px; color: #2683D4;">
                        <strong>@Model.Division</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right; height: 24px;">
                        <span>Department:</span>
                    </td>
                    <td colspan="2" style="height: 24px; color: #2683D4;">
                        <strong>@Model.Department</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Section:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <strong>@Model.Section</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Fnc.Designation:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <strong>@Model.FunctionalDesignation</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Site:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <strong>@Model.Site</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Location:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <strong>@Model.Location</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Mobile No.:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <strong>@Model.Mobile</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Extension No.:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <strong>@Model.Extension</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Direct No:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <strong>@Model.DirectLine</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Blood Group:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <strong>@Model.BloodGroup</strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Email ID:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <strong>@Model.Email</strong>
                    </td>
                </tr>               
                <tr>
                    <td align="left" valign="middle" style="width: 150px; text-align: right;">
                        <span>Seat No:</span>
                    </td>
                    <td colspan="2" style="color: #2683D4;">
                        <strong>@Model.SeatNo</strong>
                    </td>
                </tr>               
            </table>
        </div>
    </form>
</body>
</html>










