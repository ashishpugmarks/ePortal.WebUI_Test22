            margin-right: 0.92em;
            margin-top: 0.92em;
        }

            .staff-announcements .verticalText h4, .staff-toDos .verticalText h4, .staff-emergency .verticalText h4 {
                font-family: 'roboto_slabregular';
                font-size: 1.04em;
                position: absolute;
                bottom: 4em;
                left: -3em;
                -ms-transform: rotate(-90deg);
                -moz-transform: rotate(-90deg);
                -webkit-transform: rotate(-90deg);
                transform: rotate(-90deg);
            }

            .staff-announcements .verticalText {
                background-color: rgba(204,1,2,0.5);
