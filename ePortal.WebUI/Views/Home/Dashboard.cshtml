            /* border: 0.1em solid #3fb3fe; */
            padding: 0.3em 0.3em 2.3em 1.7em;
            padding-bottom: 0.2em;
            min-height: 4.29em;
        }
        /*.requestBg {
                            width: 100%;
                            height: 0;
                            border-bottom: 7.1em solid #fff;
                        }*/
        .staff-toDos .requests {
            margin-top: 1.09em;
            font-size: 1.10em;
            font-family: 'Roboto-Bold';
            text-align: center;
        }

            .staff-toDos .requests .span2 {
                margin-left: 25px;
            }

        .homeContent .staff-emergency {
            margin-top: 0.40em;
            position: relative;
            min-height: 11.2em;
            margin-left: 1.92em;
        }

        .staff-emergency .verticalText {
            background-color: #3fb3fe;
            border: 0.1em solid #3fb3fe;
            color: #ffffff;
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 1.56em;
        }

            .staff-emergency .verticalText h4 {
                bottom: 4.5em;
                left: -4.2em;
            }

        .staff-emergency .dropdownMain {
            border: 0.1em solid #3fb3fe;
            padding: 1.3em 0.3em 2.3em 1.7em;
            padding-bottom: 0.2em;
            min-height: 11.2em;
        }

        .staff-emergency select {
            cursor: pointer;
            outline: 0;
            display: block;
            width: 13.57em;
            color: #006699;
            font-size: 0.72em;
            padding: 0.61em 0.57em;
            border: 1px solid #006699;
            margin: 0 auto;
