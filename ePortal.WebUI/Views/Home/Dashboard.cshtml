            background-image: url(../images/arrow_main_menu.png);
            background-size: 0.8em;
            background-repeat: no-repeat;
            background-position: right 0.8em center;
        }

            .staff-emergency select:last-child {
                margin-top: 0.78em;
            }

        .footer { /*Added By Bhupesh - NTT for CR-4894*/
