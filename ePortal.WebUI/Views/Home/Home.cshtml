<div class="col-sm-9 tableSec">
    <div class="col-xs-12 col-sm-8 section2">
        <div class="col-xs-12 col-sm-12">


            <div class="announcements" style="height: 16.2em; background-image: url('../../ASPXView/images/announcement_bg.jpg'); justify-content: inherit; background-size: 100% 100%;">
                <div class="verticalText">
                    <h4>Announcements</h4>
                </div>
                <div id="announce" class="owl-carousel owl-theme">
                    @{
                        if (Model.Announcement.Count > 0)
                        {
                            foreach (var obj in Model.Announcement)
                            {
                                var imgSrcancbanner = "";
                                if (obj.BANNER != null)
                                {
                                    var base64ancbanner = Convert.ToBase64String(obj.BANNER);
                                    imgSrcancbanner = String.Format("data:" + obj.BANNER_CONTENTTYPE + ";base64,{0}", base64ancbanner);
                                }
                                <div class="announceContent" style="background-size: 100%; background-repeat:no-repeat; color:#003666;">
                                    @* background-color:#e8e8e8; *@
                                    <div class="hasyaKaviLogo" style="display:none;">
                                        @if (imgSrcancbanner != "")
                                        {
                                            <img src=@imgSrcancbanner data-toggle="modal" data-target="#myModal" />
                                        }
                                        @*@if (imgSrcancbanner == "")
                                {
                                    <img src="~/images/announcement_default.jpg" data-toggle="modal" data-target="#myModal" />
                                }*@
                                    </div>

                                    <div class="clear-both"></div>
                                    <div style="margin-bottom:23px">
                                        <h1 style="text-decoration:underline; color: black; font-family:Cambria;">@obj.SUBJECT</h1>
                                        <h3 style="color:#282828;">@obj.START_DATE.ToString("MMM dd, yyyy")</h3>
                                        @if (obj.POPUPHEADER_NAME == "Benevolent")
                                        {
                                            <p class="topMargin" style="white-space:pre-wrap;">@(ePortal.Shared.CommonMethods.HtmlToText(obj.DESCRIPTION.ToString()).Length < 750 ? ePortal.Shared.CommonMethods.HtmlToText(obj.DESCRIPTION.ToString()) : ePortal.Shared.CommonMethods.HtmlToText(obj.DESCRIPTION).Substring(0, 740) + ".....")</p>
                                        }
                                        else
                                        {
                                            <p class="topMargin" style="white-space:pre-wrap;">@(ePortal.Shared.CommonMethods.HtmlToText(obj.DESCRIPTION.ToString()).Length < 250 ? ePortal.Shared.CommonMethods.HtmlToText(obj.DESCRIPTION.ToString()) : ePortal.Shared.CommonMethods.HtmlToText(obj.DESCRIPTION).Substring(0, 240) + ".....")</p>
                                        }
                                        <a href="~/Announcement/ArchiveCommunication" class="readArchive pull-right">Archive</a>
                                        @if (obj.POPUPHEADER_NAME == "Benevolent")
                                        {
                                            <a href="../Benevolent/ContributionBenMSTList" class="contribution">Contribute</a>
                                        }
                                        else if (obj.POPUPHEADER_NAME == "Communication")
                                        {
                                            <a href="#" id="@obj.ATTACHMENTID" class="readCommunication">Read More</a>
                                        }
                                        else
                                        {
                                            <a href="#" id="@obj.ATTACHMENTID" class="readAnnounce">Read More</a>
                                        }
                                    </div>
                                    <div>
                                        <img src="/images/logo_honda_announcement.png" alt="Announcement" title="Announcement" class="announcementImg" />
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="announceContent" style="background-size: 100%; background-repeat:no-repeat; color:#003666;">
                                <div style="margin-bottom:23px">
                                    <a href="~/Announcement/ArchiveCommunication" class="readArchive">Archive</a>
                                </div>
                            </div>
                        }
                    }

                </div>
                <img src="/images/announ_pause.png" data-attr="pause" alt="AnnouncePause" title="AnnouncePause" class="announcePause " />

            </div>
        </div>
