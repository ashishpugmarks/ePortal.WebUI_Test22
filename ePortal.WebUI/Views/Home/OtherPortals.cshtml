@model List<ePortal.ViewModels.ExtPortalViewModel>
@{
    ViewBag.Title = "Other Portals";
}

@section Styles{
    <style nonce="@Context.Items["StyleNonce_0"]">
        .table > tbody > tr:nth-of-type(even) {
        background: #e9e9e9;
        }

        .links a + .tooltip > .tooltip-inner {
        background-color: #f9fff2;
        color: #000000;
        border: 1px solid #3fb3fe;
        padding: 5px;
        font-size: 12px;
        font-weight: bold;
        }
    </style>
}

<div class="row">
    <div style="height: 2.2em; font-size: large; font-weight: bold; font-family: Roboto-Regular; background-color: #8A8A8A; color: #FFF; vertical-align: middle;">
        <div style="padding:8px;">External Portals</div>
    </div>
    <div class="body-content">
        <div class="panel-group">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h2 class="panel-title">
                        <strong>Portals Link</strong>
                    </h2>
                </div>
                <div class="panel-body">
                    <div class="col-md-12">
                        @foreach (var item in Model)
                        {
                            <div class="col-xs-6 col-md-2 col-lg-2" style="text-align: center;margin-left:10px;margin-right:10px">
                                @{
                                    var _icon = "";
                                    if (!string.IsNullOrEmpty(item.PORTALICON_CONTENT_TYPE))
                                    {
                                        if (item.PORTAL_ICON == null)
                                        {
                                        }
                                        else
                                        {
                                            var base64quicklink0 = Convert.ToBase64String(item.PORTAL_ICON);
                                            _icon = String.Format("data:" + item.PORTALICON_CONTENT_TYPE + ";base64,{0}", base64quicklink0);
                                        }
                                    }
                                }
                                <a href="@item.PORTAL_URL" target="_blank" class="thumbnail" style="height: 150px;padding-top: 30px;">
                                    @if (!string.IsNullOrEmpty(item.PORTALICON_CONTENT_TYPE))
                                    {
                                        <img src="@_icon" alt="@item.PORTALNAME" style="border: 1px solid;border-color: lightgray;" />
                                    }
                                    else
                                    {
                                        <img src="~/images/icon1.png" alt="@item.PORTALNAME" />
                                    }
                                    <h3 style="margin-top:5px;">@item.PORTALNAME</h3>
                                </a>
                            </div>

                        }



                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

        @section Scripts{
    <script type="text/javascript" nonce="@Context.Items["ScriptNonce_3"]">
        $('.homeContent').removeClass('homeContent');
        $(document).ready(function () {
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
        }

