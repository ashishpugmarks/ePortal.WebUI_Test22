@section Scripts {
    <script src="~/js/calendarpopup.js"></script>
    <script type="text/javascript"   nonce="@Context.Items["ScriptNonce_3"]">
        function fnOnload() {
            document.getElementById("errorpanel").style.display = "none";
        }
        function fnDisplay() {
            document.getElementById("errorpanel").style.display = "inline";
        }
        function ValidateNumber(value) {
            var flag = 0;
            t1 = new String(value);
            for (x = 0; x < t1.length; ++x) {
                if (t1.charAt(x) < "0" || t1.charAt(x) > "9") {
                    flag = 1;
                    break;
                }
            }
            return flag;
        }
        function fnValidateDetails() {
            var blnReturnVal = true;

            //Validating the Location
            if (document.getElementById("cboLocation").value == "-1") {
                document.getElementById("errorpanel").style.display = "inline";
                document.getElementById("status").innerHTML = "Location is a required field.";

                document.getElementById("cboLocation").focus();
                blnReturnVal = false;
                return false;
            }

            //Validating the Extension No.
            if (document.getElementById("txtExtNo").value == "") {
                document.getElementById("errorpanel").style.display = "inline";
                document.getElementById("status").innerHTML = "Extension No. is a required field.";

                document.getElementById("txtExtNo").focus();
                blnReturnVal = false;
                return false;
            }
            else {
                if (ValidateNumber(document.getElementById("txtExtNo").value) == 1) {
                    document.getElementById("errorpanel").style.display = "inline";
                    document.getElementById("status").innerHTML = "Please enter a valid value for Extension No.";

                    document.getElementById("txtExtNo").focus();
                    returnStatus = false;
                    return false;
                }
            }

            //Validating the Contact No.
            if (document.getElementById("txtPhoneNo").value == "") {
                document.getElementById("errorpanel").style.display = "inline";
                document.getElementById("status").innerHTML = "Contact No. is a required field.";

                document.getElementById("txtPhoneNo").focus();
                blnReturnVal = false;
                return false;
            }

            else {
                if (ValidateNumber(document.getElementById("txtPhoneNo").value) == 1) {
                    document.getElementById("errorpanel").style.display = "inline";
                    document.getElementById("status").innerHTML = "Please enter a valid value for Contact No.";

                    document.getElementById("txtPhoneNo").focus();
                    returnStatus = false;
                    return false;
                }
            }

            //Validating the Line
            if (document.getElementById("cboLocation").value.split('~')[1] == "1") {
                if (document.getElementById("txtLine").value == "") {
                    document.getElementById("errorpanel").style.display = "inline";
                    document.getElementById("status").innerHTML = "Line is a required field for Scooter and Motercycle Plant.";

                    document.getElementById("txtLine").focus();
                    blnReturnVal = false;
                    return false;
                }
            }

            //Validating the Station
            if (document.getElementById("cboLocation").value.split('~')[1] == "1") {
                if (document.getElementById("txtStation").value == "") {
                    document.getElementById("errorpanel").style.display = "inline";
                    document.getElementById("status").innerHTML = "Station is a required field for Scooter and Motercycle Plant.";

                    document.getElementById("txtStation").focus();
                    blnReturnVal = false;
                    return false;
                }
            }

            //Validating the Service Catalog
            if (document.getElementById("cboServiceCatalog").value == "0") {
                document.getElementById("errorpanel").style.display = "inline";
                document.getElementById("status").innerHTML = "Service Catalog is a required field.";

                document.getElementById("cboServiceCatalog").focus();
                blnReturnVal = false;
                return false;
            }

            //Validating the Classification
            if (document.getElementById("cboClassification").value == "0") {
                document.getElementById("errorpanel").style.display = "inline";
                document.getElementById("status").innerHTML = "Classification is a required field.";

                document.getElementById("cboClassification").focus();
                blnReturnVal = false;
                return false;
            }

            //Validating the Budget Head
            if (document.getElementById("txtBudgetHead").value == "") {
                document.getElementById("errorpanel").style.display = "inline";
                document.getElementById("status").innerHTML = "Budget Head is a required field.";

                document.getElementById("txtBudgetHead").focus();
                blnReturnVal = false;
                return false;
            }

            //Validating the Work Title
            if (document.getElementById("txtWorkTitle").value == "") {
                document.getElementById("errorpanel").style.display = "inline";
                document.getElementById("status").innerHTML = "Work Title is a required field.";

                document.getElementById("txtWorkTitle").focus();
                blnReturnVal = false;
                return false;
            }

            //Validating the Scope
            if (document.getElementById("txtScope").value == "") {
                document.getElementById("errorpanel").style.display = "inline";
                document.getElementById("status").innerHTML = "Scope of Work is a required field.";

                document.getElementById("txtScope").focus();
                blnReturnVal = false;
                return false;
            }
            if (document.getElementById("chkTerms").checked == false) {
                document.getElementById("errorpanel").style.display = "inline";
                document.getElementById("status").innerHTML = "Please accept the terms of services.";
                returnStatus = false;
                return false;
            }
            if (blnReturnVal == false) {
                return false;
            }
            else {
                document.getElementById("frmSave").value = "On";
                return true;
            }
        }
    
        $(document).ready(function() {
            fnOnload();
            $('#cmdSubmit').on('click', function() {
                if (fnValidateDetails()){
                    $('#visreq').trigger('submit');
                }
            });
            $('#cmdCancel').on('click', function() {
                $('#visreq').trigger('reset');
            });

            $('#visreq').on('submit', function (e) {
                e.preventDefault();
                $('#errorpanel').hide();
                $('#status').html('');
                
                var formData = new FormData($(this)[0]);
                formData.append("ServiceCatalogDescription", $('#cboServiceCatalog option:selected').html());
                formData.append("ClassificationDescription", $('#cboClassification option:selected').html());
                $.ajax({
                    url: '@Url.Action("UtilityRequest", "Utility")',
                    beforeSend: function () {
                        $("#ajaxLoader").addClass('loader');
                    },
                    type: 'POST',
                    data: formData,
                    contentType: false,   // important: tell jQuery not to set content-type
                    processData: false,   // important: don't transform FormData into a query string
                    success: function (result) {
                        if (result.status == 1){
                            location.href = '/TokenBridge/RedirectToOldApp?target=/ASPXView/ManageRequest.aspx';
                        }
                        else{
                            sweetAlert("", result.message, "warning");
                        }
                    },
                    complete: function () {
                        $("#ajaxLoader").removeClass('loader');
                    },
                    error: function (error) {
                        $('#errorpanel').show();
                        $('#status').html('Something went wrong...');
                        sweetAlert("Oops...", 'Something went wrong...', "error");
                        console.log(error);
                    }
                });
            });

            $('#ddlsite').change(function () {
				var siteId = $(this).val();
                $.getJSON('/Utility/GetLocations', { SiteId: siteId }, function (data) {
					bindDropdown('#cboLocation', data);
				});
			});
            $('#cboServiceCatalog').change(function () {
				var serviceCatalogId = $(this).val();
                $.getJSON('/Utility/GetClassification', { ServiceCatalogId: serviceCatalogId }, function (data) {
                    bindDropdown('#cboClassification', data);
				});
			});
            $('#cboLocation').change(function () {
				var locationId = $(this).val();
				$.getJSON('/Utility/GetResponsibleUserDetails', { Location: locationId }, function (data) {
                    $('#lblResponsibleUser').html(data?.ResponsibleAuthorityCode);
				});
			});
        });
        function bindDropdown(selector, list) {
                var $ddl = $(selector);
                $ddl.empty();
                $.each(list, function (i, item) {
                    $ddl.append($('<option/>').val(item.Value).text(item.Text));
                });
            }
    </script>
}