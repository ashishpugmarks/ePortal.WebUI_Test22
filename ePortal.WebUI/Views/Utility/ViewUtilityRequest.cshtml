@model ePortal.ViewModels.APPX.Utility.UtilityRequestViewModel
@using Microsoft.AspNetCore.Http

@{
    ViewBag.Title = "Employee Portal  :: Honda Motorcycle & Scooter India Pvt. Ltd. | View Utility Request";
    Layout = null;
    var loggedInUserId = Context.Session.GetString("userId") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userId").ToString());
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/css/index.css" rel="stylesheet" />
    <title>@ViewBag.Title</title>
</head>
<body>
    <form id="form1">
        <div>
            <table cellspacing="0" cellpadding="0" width="100%" border="0">
                <tbody>
                    <tr>
                        <td valign="top" align="left" style="width: 780px;">
                            <table cellspacing="0" cellpadding="0" width="100%" border="0" id="maintable">
                                <tbody>
                                    <tr>
                                        <td bgcolor="#ffffff" style="padding-left: 20px">
                                            <fieldset class="swiftfieldset" style="width: 720px">
                                                <legend><b>Utility Request Details</b></legend>
                                                <table width="100%" border="0" cellspacing="1" cellpadding="2">
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Request ID:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 309px">
                                                            &nbsp;
                                                            <span id="ltlReqID">@Model.RequestId</span>
                                                        </td>

                                                        <td valign="middle" class="row2" style="text-align: right; width: 113px;">
                                                            <span class="smalltext">Request Date:</span>&nbsp;
                                                        </td>
                                                        <td>
                                                            &nbsp;
                                                            <span id="ltlLogdate">
                                                                @Model.LogDate
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Name:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 309px">
                                                            &nbsp;
                                                            <span id="ltlEmpName">
                                                                @Model.EmpName
                                                            </span>
                                                        </td>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 113px;">
                                                            <span class="smalltext">Location:</span>&nbsp;
                                                        </td>
                                                        <td>
                                                            &nbsp;
                                                            <span id="ltlLocation">
                                                                @Model.LocationDescription
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Line:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 309px">
                                                            &nbsp;
                                                            <span id="ltlLine">
                                                                @Model.Line
                                                            </span>
                                                        </td>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 113px;">
                                                            <span class="smalltext">Station:</span>&nbsp;
                                                        </td>
                                                        <td>
                                                            &nbsp;
                                                            <span id="ltlStation">
                                                                @Model.Station
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Extension:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 309px">
                                                            &nbsp;
                                                            <span ID="ltlExtension">
                                                                @Model.ExtensionNo
                                                            </span>
                                                        </td>

                                                        <td valign="middle" class="row2" style="text-align: right; width: 113px;">
                                                            <span class="smalltext">Contact No.:</span>&nbsp;
                                                        </td>
                                                        <td>
                                                            &nbsp;
                                                            <span id="ltlPhone">
                                                                @Model.PhoneNo
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Service Catalog:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 309px">
                                                            &nbsp;
                                                            <span id="ltlCatalog">
                                                                @Model.ServiceCatalogDescription
                                                            </span>
                                                        </td>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 113px;">
                                                            <span class="smalltext">Classification:</span>&nbsp;
                                                        </td>
                                                        <td>
                                                            &nbsp;
                                                            <span id="ltlClassification">
                                                                @Model.ClassificationDescription
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Budget Head:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 309px">
                                                            &nbsp;
                                                            <span id="ltlbudget">
                                                                @Model.BudgetHead
                                                            </span>
                                                        </td>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 113px;">
                                                            <span class="smalltext">Attachment:</span>&nbsp;
                                                        </td>
                                                        <td>
                                                            &nbsp;
                                                            <span id="ltlattachment">
                                                                @Model.SavedAttachmentName
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Work Title:</span>&nbsp;
                                                        </td>
                                                        <td>
                                                            &nbsp;
                                                            <span id="ltltitle">
                                                                @Model.WorkTitle
                                                            </span>
                                                        </td>
                                                        <td valign="middle" class="row2" style="text-align: right;">
                                                            <span class="smalltext">Site:</span>&nbsp;
                                                        </td>
                                                        <td>
                                                            &nbsp;
                                                            <span id="ltlSite">
                                                                @Model.SiteDescription
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="top" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Scope Of Work:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 309px">
                                                            &nbsp;
                                                            <span id="ltlscope">
                                                                @Model.ScopeOfWork
                                                            </span>
                                                        </td>
                                                        <td class="row2" style="width: 113px"></td>
                                                        <td></td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="top" class="row1" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Responsible User:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 309px">
                                                            &nbsp;
                                                            <span id="ltlResUser">
                                                                @Model.ResponsibleAuthorityCode
                                                            </span>
                                                        </td>
                                                        <td class="row1" style="width: 113px"></td>
                                                        <td></td>
                                                    </tr>
                                                </table>
                                            </fieldset>
                                            <fieldset class="swiftfieldset" style="width: 720px">
                                                <legend><b>Approval Information</b></legend>
                                                <table width="100%" border="0" cellspacing="0" cellpadding="2">
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">No. of Quotes:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 312px">
                                                            &nbsp;
                                                            <span id="ltlnoofquote">
                                                                @Model.NoOfQuotes
                                                            </span>
                                                        </td>

                                                        <td valign="middle" class="row2" style="text-align: right; width: 113px;">
                                                            <span class="smalltext">Quote Price:</span>&nbsp;
                                                        </td>
                                                        <td>
                                                            &nbsp;Rs.
                                                            <span id="ltlprice">
                                                                @Model.Price
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Quote Submit Date:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 312px">
                                                            &nbsp;
                                                            <span id="ltlsubmitdate">
                                                                @Model.SubmitDate
                                                            </span>
                                                        </td>
                                                        <td class="row2" style="width: 113px"></td>
                                                        <td></td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">PO No.:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 312px">
                                                            &nbsp;
                                                            <span id="ltlpono">
                                                                @Model.PoNo
                                                            </span>
                                                        </td>

                                                        <td valign="middle" class="row2" style="text-align: right; width: 113px;">
                                                            <span class="smalltext">PO Date:</span>&nbsp;
                                                        </td>
                                                        <td>
                                                            &nbsp;
                                                            <span id="ltlpodate">
                                                                @Model.PoDate
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Sect. Mgr. Status:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 312px">
                                                            &nbsp;
                                                            <span id="ltlsctmgrstatus">
                                                                @Model.SectionManagerStatus
                                                            </span>
                                                        </td>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 113px;">
                                                            <span class="smalltext">Dept. Mgr. Status:</span>&nbsp;
                                                        </td>
                                                        <td>
                                                            &nbsp;
                                                            <span id="ltldptmgrstatus">
                                                                @Model.DeptManagerStatus
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Sect. Mgr. Remarks:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 312px">
                                                            &nbsp;
                                                            <span id="ltlsctmgrremark">
                                                                @Model.SectionManagerRemarks
                                                            </span>
                                                        </td>
                                                        <td class="row2" style="width: 113px"></td>
                                                        <td></td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Dept. Mgr. Remarks:</span>&nbsp;
                                                        </td>
                                                        <td style="width: 312px">
                                                            &nbsp;
                                                            <span id="ltldptmgrremark">
                                                                @Model.DeptManagerRemarks
                                                            </span>
                                                        </td>
                                                        <td class="row2" style="width: 113px"></td>
                                                        <td></td>
                                                    </tr>

                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Remarks (Utility):</span>&nbsp;
                                                        </td>
                                                        <td style="width: 312px">
                                                            &nbsp;
                                                            <span id="ltlremark">
                                                                @Model.Remarks
                                                            </span>
                                                        </td>
                                                        <td class="row2" style="width: 113px"></td>
                                                        <td></td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Status (Utility):</span>&nbsp;
                                                        </td>
                                                        <td style="width: 312px">
                                                            &nbsp;
                                                            <span id="ltlstatus">@Model.UtStatus</span>
                                                        </td>
                                                        <td class="row2" style="width: 113px"></td>
                                                        <td></td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="middle" class="row2" style="text-align: right; width: 152px;">
                                                            <span class="smalltext">Closed Remarks (Utility):</span>&nbsp;
                                                        </td>
                                                        <td style="width: 312px">
                                                            &nbsp;
                                                            <span id="ltlcloseremark">@Model.CloseRemarks</span>
                                                        </td>
                                                        <td class="row2" style="width: 113px"></td>
                                                        <td></td>
                                                    </tr>
                                                </table>
                                            </fieldset>
                                            <br />
                                            <br />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </form>
</body>
</html>