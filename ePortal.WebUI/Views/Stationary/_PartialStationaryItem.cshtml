@model StationaryViewModel
@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using ePortal.ViewModels.APPX.Stationary

@{
    Layout = null;
    var loggedInUserId = Context.Session.GetString("userId") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userId").ToString());
    var stationaryList = JsonSerializer.Serialize(Model);
}

<table class="table table-bordered table-hover table-striped" id="tblGvList">
    <thead>
        <tr>
            <th>Stationary</th>
            <th>Qty</th>
            <th>Remark</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.StationaryCart)
        {
            <tr>
                <td>@item.ItemDescription</td>
                <td>@item.Qty</td>
                <td>@item.Remark</td>
                <td>
                    <a data-id="@item.ItemId" data-ctrl="delete-item">
                        <img src="~/images/icon_delete.gif" />
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
<input type="hidden" id="hdnStationaryJsonData" value="@stationaryList" />
