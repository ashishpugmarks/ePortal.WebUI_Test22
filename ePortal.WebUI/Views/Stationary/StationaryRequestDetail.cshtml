@model ePortal.ViewModels.APPX.Stationary.StationaryViewModel
@using Microsoft.AspNetCore.Http

@{
    ViewBag.Title = "Stationary Request Detail : Workflow History";
    Layout = null;
    var loggedInUserId = Context.Session.GetString("userId") == null ? 0 : Convert.ToInt64(Context.Session.GetString("userId").ToString());
}
<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <link href="~/css/index.css" rel="stylesheet" />
</head>
<body>
    <form id="form1">
        <div>
            <table cellspacing="0" cellpadding="0" width="100%" border="0">
                <tbody>
                    <tr>
                        <td valign="top" align="left" style="width: 770px;">
                            <table cellspacing="0" cellpadding="0" width="100%" border="0" id="maintable">
                                <tbody>

                                    <tr>
                                        <td bgcolor="#ffffff" style="padding-left: 20px">
                                            <fieldset class="swiftfieldset" style="width: 700px">
                                                <legend><b>Stationary Request Information</b></legend>
                                                <table width="100%" border="0" cellspacing="1" cellpadding="2">
                                                    <tr>
                                                        <td align="left" valign="middle" class="row2" style="width: 224px; text-align: right;">
                                                            <span class="smalltext">Request ID:</span>&nbsp;
                                                        </td>
                                                        <td width="70%">&nbsp;@Model.RequestId</td>
                                                    </tr>
                                                    <tr>
                                                        <td align="left" valign="middle" class="row2" style="width: 224px; text-align: right;">
                                                            <span class="smalltext">Employee :</span>&nbsp;
                                                        </td>
                                                        <td>&nbsp;@Model.InitiatorName</td>
                                                    </tr>

                                                    <tr>
                                                        <td align="left" valign="middle" class="row2" style="width: 224px; text-align: right;">
                                                            <span class="smalltext">Application Date:</span>&nbsp;
                                                        </td>
                                                        <td>&nbsp;@Model.InitiatedDate</td>
                                                    </tr>
                                                </table>
                                            </fieldset>
                                            <fieldset class="swiftfieldset" style="width: 700px">
                                                <legend><b>Department Approval History</b></legend>
                                                <table width="100%" border="0" cellspacing="0" cellpadding="2">
                                                    <tr id="tr_AppAuth" runat="server">
                                                        <td align="left" valign="middle" class="row2" width="30%" style="text-align: right">
                                                            <span class="smalltext">Approval Authority:</span>&nbsp;
                                                        </td>
                                                        <td width="70%" valign="middle">
                                                            &nbsp;@Model.ApproverName
                                                        </td>
                                                    </tr>
                                                    <tr id="tr_AppEmail" runat="server">
                                                        <td align="left" valign="middle" class="row2" width="30%" style="text-align: right">
                                                            <span class="smalltext">Approval Authority Email:</span>&nbsp;
                                                        </td>
                                                        <td width="70%" valign="middle">
                                                            &nbsp;@Model.ApproverEmail
                                                        </td>
                                                    </tr>
                                                    <tr id="tr_AppStatus" runat="server">
                                                        <td align="left" valign="middle" class="row2" width="30%" style="text-align: right">
                                                            <span class="smalltext">Status:</span>&nbsp;
                                                        </td>
                                                        <td width="70%" valign="middle">
                                                            &nbsp;@Model.ApprovalStatus
                                                        </td>
                                                    </tr>
                                                    <tr id="tr_AppRem" runat="server">
                                                        <td align="left" valign="middle" class="row2" width="30%" style="text-align: right">
                                                            <span class="smalltext">Remarks:</span>&nbsp;
                                                        </td>
                                                        <td width="70%" valign="middle">
                                                            &nbsp;@Model.ApproverRemarks
                                                        </td>
                                                    </tr>
                                                    <tr id="tr_AppDate" runat="server">
                                                        <td align="left" valign="middle" class="row2" width="30%" style="text-align: right">
                                                            <span class="smalltext">Approval Date:</span>&nbsp;
                                                        </td>
                                                        <td width="70%" valign="middle">
                                                            &nbsp;@Model.ApprovalDate
                                                        </td>
                                                    </tr>
                                                </table>
                                            </fieldset>
                                            <fieldset class="swiftfieldset" style="width: 700px;">
                                                <legend><b>Administration Approval History</b></legend>
                                                <table width="100%" border="0" cellspacing="0" cellpadding="2">
                                                    <tr>
                                                        <td align="left" valign="middle" class="row2" width="30%" style="text-align: right">
                                                            <span class="smalltext">Admin Authority:</span>&nbsp;
                                                        </td>
                                                        <td width="70%" valign="middle">
                                                            &nbsp;@Model.AdminApprover
                                                        </td>
                                                    </tr>
                                                    <tr id="tr1" runat="server">
                                                        <td align="left" valign="middle" class="row2" width="30%" style="text-align: right">
                                                            <span class="smalltext">Admin Authority Email:</span>&nbsp;
                                                        </td>
                                                        <td width="70%" valign="middle">
                                                            &nbsp;@Model.AdminApproverEmail
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td align="left" valign="middle" class="row2" width="30%" style="text-align: right">
                                                            <span class="smalltext">Status:</span>&nbsp;
                                                        </td>
                                                        <td width="70%" valign="middle">
                                                            &nbsp;@Model.AdminApprovalStatus
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td align="left" valign="middle" class="row2" width="30%" style="text-align: right">
                                                            <span class="smalltext">Remarks:</span>&nbsp;
                                                        </td>
                                                        <td width="70%" valign="middle">
                                                            &nbsp;@Model.AdminRemarks
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td align="left" valign="middle" class="row2" width="30%" style="text-align: right">
                                                            <span class="smalltext">Approval Date:</span>&nbsp;
                                                        </td>
                                                        <td width="70%" valign="middle">
                                                            &nbsp;@Model.AdminApprovalDate
                                                        </td>
                                                    </tr>
                                                </table>
                                            </fieldset>
                                            <br />
                                            <br />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </form>
</body>
</html>